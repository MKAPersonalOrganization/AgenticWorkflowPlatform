# =============================================================================
# Production Multi-Stage Build
# =============================================================================
# Stage 1: Build — generate templ files, build CSS, compile binary
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache nodejs npm

WORKDIR /app

# Cache Go module downloads
COPY go.mod go.sum ./
RUN go mod download

# Copy all source
COPY . .

# Generate templ files (templ is declared as a `go tool` in go.mod)
RUN go tool templ generate

# Install Tailwind v4 + typography plugin locally so @import "tailwindcss" resolves
RUN npm install tailwindcss @tailwindcss/cli @tailwindcss/typography

# Build and minify Tailwind CSS output
RUN npx @tailwindcss/cli \
    -i ./assets/css/input.css \
    -o ./assets/css/output.css \
    --minify

# Compile binary — inject build tag "production"
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.build=production" \
    -o /bin/school-with-ai .

# =============================================================================
# Stage 2: Runtime — minimal image, no toolchain
# =============================================================================
FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Binary
COPY --from=builder /bin/school-with-ai .

# Static assets (CSS, JS, images, etc.)
COPY --from=builder /app/assets ./assets

# Locale catalogs
COPY --from=builder /app/assets/locales ./assets/locales

# TLS certs are mounted at runtime via a Docker volume:
#   ./tls:/app/tls:ro
# (generated by: cd tls && go run /usr/local/go/src/crypto/tls/generate_cert.go --host=localhost)

EXPOSE 8090

CMD ["./school-with-ai"]
