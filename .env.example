# =============================================================================
# School with AI - Environment Configuration Example
# Copy this file to .env and update with your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Demo Mode
# -----------------------------------------------------------------------------
# When true, the app boots its ENTIRE infrastructure in-process: an embedded
# Postgres, an in-memory Redis (miniredis), and an in-memory S3 (gofakes3).
# No Docker, no external services. ALL DATA IS EPHEMERAL — lost on restart.
# For showcase/demo deployments only.
APP_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Web Server Configuration
# -----------------------------------------------------------------------------
# API host address (where the main application runs)
APP_WEB_API_HOST=localhost:8090

# Debug server address (for pprof, expvar, statsviz endpoints)
APP_WEB_DEBUG_HOST=0.0.0.0:4010

# Serve plain HTTP instead of HTTPS (for TLS-terminating proxies like Fly.io)
APP_WEB_TLS_DISABLED=false

# HTTP server timeouts
APP_WEB_READ_TIMEOUT=15s
APP_WEB_WRITE_TIMEOUT=15s
APP_WEB_IDLE_TIMEOUT=60s
APP_WEB_READ_HEADER_TIMEOUT=10s
APP_WEB_SHUTDOWN_TIMEOUT=20s

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis address for Asynq job queue
APP_REDIS_ADDR=localhost:6379

# -----------------------------------------------------------------------------
# Orchestration Configuration (Asynq Worker Pool)
# -----------------------------------------------------------------------------
# Number of concurrent workers processing jobs
APP_ORCHESTRATION_CONCURRENCY=5

# Time to wait for workers to finish during shutdown
APP_ORCHESTRATION_SHUTDOWN_TIMEOUT=10s

# Interval for Redis health checks
APP_ORCHESTRATION_HEALTH_CHECK_INTERVAL=15s

# -----------------------------------------------------------------------------
# AI/LLM Configuration
# -----------------------------------------------------------------------------
# OpenAI model to use (e.g., gpt-4o-mini, gpt-4o, gpt-4-turbo)
APP_AI_MODEL=gpt-4o-mini

# OpenAI API Key (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Authentication Configuration (Google OAuth)
# -----------------------------------------------------------------------------
# Base URL of your application (used for redirects)
APP_AUTH_APP_URL=https://localhost:8090

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://localhost:8090/auth/callback
APP_AUTH_GOOGLE_CLIENT_ID=
APP_AUTH_GOOGLE_CLIENT_SECRET=

# Session cookie encryption secret (at least 32 characters)
APP_AUTH_SESSION_SECRET=change-me-in-production-32-chars!

# Also set these for docker-compose
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-in-production-32-chars!

# -----------------------------------------------------------------------------
# Dev-Login (integration tests only — LEAVE UNSET IN PRODUCTION)
# -----------------------------------------------------------------------------
# When APP_AUTH_DEV_LOGIN_TOKEN is non-empty, POST /auth/dev-login is mounted
# on the main router. Integration tests present this token in the
# X-Dev-Login-Token header to obtain a real school_session cookie for the
# configured debug user, then drive the app over the public REST API exactly
# like the browser UI. Unset the token in production deployments.
APP_AUTH_DEV_LOGIN_TOKEN=dev-login-local-only
APP_AUTH_DEV_LOGIN_USER_ID=debug-integration-user
APP_AUTH_DEV_LOGIN_EMAIL=debug@local

# =============================================================================
# Optional Services (uncomment and configure if using)
# =============================================================================



# -----------------------------------------------------------------------------
# PostgreSQL Configuration (for Projections - App-Postgres)
# -----------------------------------------------------------------------------
# Projections database connection settings
APP_DB_USER=appuser
APP_DB_PASSWORD=dev-password
APP_DB_HOST=localhost:5435
APP_DB_NAME=projections
APP_DB_MAX_IDLE_CONNS=2
APP_DB_MAX_OPEN_CONNS=0
APP_DB_DISABLE_TLS=true

# =============================================================================
# Artifact Store Configuration (MinIO/S3)
# =============================================================================
APP_ARTIFACTS_S3ENDPOINT=localhost:9100
APP_ARTIFACTS_S3ACCESSKEY=minio
APP_ARTIFACTS_S3SECRETKEY=miniosecret
APP_ARTIFACTS_S3BUCKET=artifacts
APP_ARTIFACTS_S3USESSL=false
APP_ARTIFACTS_S3REGION=us-east-1

# Edgequake Configuration
# Experimental: knowledge-base (RAG) features are hidden unless enabled.
APP_EDGEQUAKE_ENABLED=false
APP_EDGEQUAKE_TENANT_ID=00000000-0000-0000-0000-000000000002
