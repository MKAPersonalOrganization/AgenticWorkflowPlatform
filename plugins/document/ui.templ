package document

import (
	"aicompass/frontend/ui/annotation"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

templ toolIcon() {
	<div
		:class="{
			'text-green-500': message.name === 'create_markdown',
			'text-blue-500': message.name === 'update_markdown',
			'text-red-500': message.name === 'delete_markdown'
		}"
	>
		<template x-if="message.name === 'create_markdown'">
			@icon.Icon("file-plus")(icon.Props{Class: "size-4"})
		</template>
		<template x-if="message.name === 'update_markdown'">
			@icon.Icon("file-pen")(icon.Props{Class: "size-4"})
		</template>
		<template x-if="message.name === 'delete_markdown'">
			@icon.Icon("trash-2")(icon.Props{Class: "size-4"})
		</template>
	</div>
}

templ Container() {
	@annotation.Container(toolIcon(), annotation.Props{
		ContainerAttrs: templ.Attributes{
			":class": "{ 'border-green-500/20': message.name === 'create_markdown', 'border-blue-500/20': message.name === 'update_markdown', 'border-red-500/20': message.name === 'delete_markdown' }",
		},
		IconAttrs: templ.Attributes{
			"class": false, // Disable default text-primary
		},
		LabelAttrs: templ.Attributes{
			"x-text": "message.name === 'create_markdown' ? 'Document Created' : (message.name === 'update_markdown' ? 'Document Updated' : 'Document Deleted')",
			":class": "{ 'text-green-500/40': message.name === 'create_markdown', 'text-blue-500/40': message.name === 'update_markdown', 'text-red-500/40': message.name === 'delete_markdown' }",
		},
		SubtextAttrs: templ.Attributes{
			"x-text": "message.name === 'create_markdown' ? 'Available in Artifacts' : (message.name === 'update_markdown' ? 'Changes saved' : 'Removed from Artifacts')",
		},
		FooterDotAttrs: templ.Attributes{
			":class": "{ 'bg-green-500/40': message.name === 'create_markdown', 'bg-blue-500/40': message.name === 'update_markdown', 'bg-red-500/40': message.name === 'delete_markdown' }",
		},
	}) {
		<div class="flex flex-col gap-4 py-2">
			<!-- Filename Display -->
			<div class="w-full bg-muted/[0.03] border border-border/10 rounded-xl p-4 shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)] transition-colors hover:bg-muted/[0.05] flex items-center gap-3">
				<div class="p-2 rounded-md bg-background/50 border border-border/5">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground/60"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
				</div>
				<div class="flex flex-col min-w-0">
					<span x-text="message.parsedArgs?.filename" class="text-sm font-medium text-foreground truncate"></span>
					<template x-if="message.parsedResult?.bytes_written">
						<span x-text="formatBytes(message.parsedResult?.bytes_written)" class="text-[10px] text-muted-foreground uppercase tracking-wider"></span>
					</template>
				</div>
                <!-- Action Button (View) -->
                 <button 
                    class="ms-auto px-3 py-1.5 text-xs font-medium bg-primary/10 text-primary hover:bg-primary/20 rounded-md transition-colors"
                    @click="$dispatch('open-artifact', { filename: message.parsedArgs?.filename })"
                    x-show="message.name !== 'delete_markdown'"
                 >
                    { i18n.T(ctx, "View") }
                 </button>
			</div>

            <!-- Content Preview (Optional, for Create/Update) -->
            <template x-if="message.parsedArgs?.content && message.name !== 'delete_markdown'">
                <div class="mt-2 ps-4 border-s-2 border-border/10">
                    <p class="text-xs text-muted-foreground line-clamp-3 italic" x-text="message.parsedArgs?.content"></p>
                </div>
            </template>
		</div>
	}
}

templ PluginTemplate() {
	<template x-if="['create_markdown', 'update_markdown', 'delete_markdown'].includes(message.name)">
		@Container()
	</template>
}
