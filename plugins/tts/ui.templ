package tts

import "school-with-ai/components/annotation"

// ──────────────────────────────────────────────────────
// TTS Speak tool: text → spoken audio (MP3)
// Nature: text input → playable audio artifact
// ──────────────────────────────────────────────────────
templ speakIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume-2"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path><path d="M16 9a5 5 0 0 1 0 6"></path><path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path></svg>
}

templ SpeakContainer() {
	@annotation.Container(speakIcon(), annotation.Props{
		Label:   "Speech Generated",
		Subtext: "AI-generated voice · OpenAI TTS",
		FooterDotAttrs: templ.Attributes{
			":class": `(() => {
				if (message.parsedResult?.success) return 'bg-green-500/40';
				if (message.parsedResult?.error) return 'bg-destructive/40';
				return 'bg-primary/30';
			})()`,
		},
	}) {
		<div class="flex flex-col gap-4" x-data="ttsPlayer()">
			<!-- Voice & Model Info -->
			<div class="flex items-center gap-2 text-[12px] text-muted-foreground/60 italic font-serif">
				<span class="font-semibold" x-text="'Voice: ' + (message.parsedResult?.voice || message.parsedArgs?.voice || 'coral')"></span>
				<span class="text-muted-foreground/30">·</span>
				<span x-text="message.parsedResult?.model || 'gpt-4o-mini-tts'"></span>
			</div>
			<!-- Audio Player -->
			<div class="relative w-full bg-muted/[0.03] border border-border/10 rounded-xl p-5 shadow-[inset_0_1px_4px_rgba(0,0,0,0.02)] transition-colors hover:bg-muted/[0.05]">
				<!-- Loading State -->
				<div x-show="!message.parsedResult?.audio_url" class="flex items-center justify-center py-6">
					<div class="flex flex-col items-center gap-3">
						<div class="flex items-center gap-1">
							<span class="inline-block w-1 h-4 bg-primary/30 rounded-full animate-pulse" style="animation-delay: 0ms"></span>
							<span class="inline-block w-1 h-6 bg-primary/40 rounded-full animate-pulse" style="animation-delay: 150ms"></span>
							<span class="inline-block w-1 h-5 bg-primary/35 rounded-full animate-pulse" style="animation-delay: 300ms"></span>
							<span class="inline-block w-1 h-7 bg-primary/45 rounded-full animate-pulse" style="animation-delay: 450ms"></span>
							<span class="inline-block w-1 h-4 bg-primary/30 rounded-full animate-pulse" style="animation-delay: 600ms"></span>
						</div>
						<span class="text-[10px] text-muted-foreground/40 uppercase tracking-[0.2em] font-bold">Generating speech...</span>
					</div>
				</div>
				<!-- Audio Element -->
				<template x-if="message.parsedResult?.audio_url">
					<div class="flex flex-col gap-3">
						<audio
							x-ref="ttsAudio"
							controls
							preload="metadata"
							class="w-full h-10 rounded-lg"
							:src="message.parsedResult?.audio_url"
							@play="startTracking()"
							@pause="stopTracking()"
							@ended="resetPlayer()"
							@seeked="startTracking()"
						>
							Your browser does not support the audio element.
						</audio>
						<!-- AI Disclosure -->
						<div class="flex items-center gap-1.5 text-[10px] text-muted-foreground/40">
							<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
							<span>This audio was generated by AI and is not a human voice.</span>
						</div>
					</div>
				</template>
			</div>
			<!-- Transcript: Markdown rendered + optional word-level highlighting -->
			<template x-if="message.parsedResult?.text || message.parsedArgs?.text">
				<div class="relative bg-muted/[0.03] border border-border/10 rounded-lg px-4 py-3">
					<div class="flex items-center gap-1.5 mb-2 text-[10px] text-muted-foreground/50 uppercase tracking-[0.15em] font-bold">
						<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 6.1H3"></path><path d="M21 12.1H3"></path><path d="M15.1 18H3"></path></svg>
						<span>Transcript</span>
					</div>
					<div
						x-ref="transcriptBox"
						class="prose prose-sm dark:prose-invert max-w-none text-[13px] text-foreground/80 leading-[1.8] max-h-[300px] overflow-y-auto scroll-smooth select-text prose-p:my-1.5 prose-ul:my-1.5 prose-ol:my-1.5 prose-li:my-0.5 prose-headings:my-2 prose-headings:text-foreground/90 prose-pre:my-2 prose-pre:text-[11px] prose-code:text-[11px] prose-code:before:content-none prose-code:after:content-none prose-blockquote:my-2 prose-blockquote:border-primary/30"
						dir="auto"
						x-effect="initTranscript(message.parsedResult?.text || message.parsedArgs?.text, message.parsedResult?.word_timestamps)"
					></div>
				</div>
			</template>
			<!-- Word highlight styles (CSS custom properties from theme) -->
			<style>
				.tts-word {
					cursor: pointer;
					border-radius: 3px;
					padding: 1px 2px;
					transition: all 150ms ease-out;
				}
				.tts-word:hover {
					background: hsl(var(--primary) / 0.1);
				}
				.tts-word-active {
					background: hsl(var(--primary) / 0.25);
					color: hsl(var(--primary));
					font-weight: 600;
					box-shadow: 0 0 0 1px hsl(var(--primary) / 0.15);
				}
				.tts-word-past {
					color: hsl(var(--foreground) / 0.45);
				}
			</style>
			<!-- Metadata Bar -->
			<div class="flex items-center gap-2 flex-wrap text-[10px] text-muted-foreground/40 px-1">
				<!-- Format Badge -->
				<span
					class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 text-[10px] font-bold uppercase tracking-[0.1em]"
					x-text="(message.parsedResult?.format || 'mp3').toUpperCase()"
				></span>
				<!-- Voice Badge -->
				<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-muted/50 text-muted-foreground text-[10px] font-medium border border-border/30">
					<svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" x2="12" y1="19" y2="22"></line></svg>
					<span x-text="message.parsedResult?.voice || message.parsedArgs?.voice || 'coral'"></span>
				</span>
				<!-- Filename -->
				<template x-if="message.parsedResult?.filename">
					<span class="font-mono text-muted-foreground/30" x-text="message.parsedResult.filename"></span>
				</template>
			</div>
		</div>
	}
}

templ PluginTemplate() {
	<template x-if="['speak', 'tts-speak'].includes(message.name)">
		@SpeakContainer()
	</template>
}
