package todos

import "aicompass/frontend/ui/annotation"

templ icon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks">
		<path d="m3 17 2 2 4-4"></path>
		<path d="m3 7 2 2 4-4"></path>
		<path d="M13 6h8"></path>
		<path d="M13 12h8"></path>
		<path d="M13 18h8"></path>
	</svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		ContainerAttrs: templ.Attributes{
			"x-data": `{
				get todos() {
					try {
						const r = typeof message.parsedResult === 'string' ? JSON.parse(message.parsedResult) : message.parsedResult;
						return r?.todos || message.parsedArgs?.todos || [];
					} catch { return message.parsedArgs?.todos || []; }
				},
				get completed() { return this.todos.filter(t => t.status === 'completed').length },
				get total() { return this.todos.length },
				get progress() { return this.total > 0 ? Math.round((this.completed / this.total) * 100) : 0 },
				get inProgress() { return this.todos.find(t => t.status === 'in_progress') },
				statusIcon(status) {
					switch(status) {
						case 'completed':  return '✓';
						case 'in_progress': return '▸';
						case 'cancelled':  return '✗';
						default:           return '○';
					}
				}
			}`,
			":class": `{
				'border-primary/20': progress < 100,
				'border-emerald-500/30': progress === 100
			}`,
		},
		IconAttrs: templ.Attributes{
			":class": `{
				'bg-primary/5 text-primary/70 group-hover:bg-primary/10 group-hover:text-primary': progress < 100,
				'bg-emerald-500/10 text-emerald-500/70 group-hover:bg-emerald-500/15 group-hover:text-emerald-500': progress === 100
			}`,
			"class": false,
		},
		LabelAttrs: templ.Attributes{
			"x-text": `progress === 100 ? 'All Tasks Complete' : (inProgress ? 'Working on: ' + inProgress.description.substring(0, 40) + (inProgress.description.length > 40 ? '…' : '') : 'Task Plan')`,
			":class": `{
				'text-primary/50': progress < 100,
				'text-emerald-500/50': progress === 100
			}`,
		},
		SubtextAttrs: templ.Attributes{
			"x-text": `total > 0 ? completed + ' of ' + total + ' completed' : 'Setting up task plan…'`,
		},
		FooterDotAttrs: templ.Attributes{
			":class": `{
				'bg-primary/40 animate-pulse': progress < 100 && progress > 0,
				'bg-muted-foreground/20': progress === 0,
				'bg-emerald-500/50': progress === 100
			}`,
		},
	}) {
		<div class="flex flex-col gap-3" x-show="todos.length > 0">
			<!-- Progress bar -->
			<div class="relative w-full">
				<div class="flex items-center justify-between mb-2">
					<span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-muted-foreground/30">Progress</span>
					<span
						class="text-[11px] font-bold tabular-nums transition-colors duration-500"
						:class="progress === 100 ? 'text-emerald-500/70' : 'text-primary/50'"
						x-text="progress + '%'"
					></span>
				</div>
				<div class="w-full h-1.5 bg-muted/10 rounded-full overflow-hidden">
					<div
						class="h-full rounded-full transition-all duration-700 ease-out"
						:class="progress === 100 ? 'bg-gradient-to-r from-emerald-500/60 to-emerald-400/60' : 'bg-gradient-to-r from-primary/40 to-primary/60'"
						:style="'width: ' + progress + '%'"
					></div>
				</div>
			</div>
			<!-- Todo items list -->
			<div class="flex flex-col gap-0.5">
				<template x-for="(todo, index) in todos" :key="index">
					<div
						class="group/item flex items-start gap-3 px-3 py-2.5 rounded-xl transition-all duration-300"
						:class="{
							'bg-emerald-500/[0.04] border border-emerald-500/10': todo.status === 'completed',
							'bg-primary/[0.06] border border-primary/15 shadow-[0_0_15px_-3px_rgba(var(--primary-rgb,99,102,241),0.08)]': todo.status === 'in_progress',
							'bg-muted/[0.02] border border-transparent hover:border-border/10 hover:bg-muted/[0.04]': todo.status === 'pending',
							'bg-muted/[0.01] border border-transparent opacity-50': todo.status === 'cancelled'
						}"
					>
						<!-- Status indicator -->
						<div class="flex-shrink-0 mt-0.5">
							<!-- Completed: check circle -->
							<template x-if="todo.status === 'completed'">
								<div class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/15 border border-emerald-500/20">
									<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500/80">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
								</div>
							</template>
							<!-- In progress: animated spinner -->
							<template x-if="todo.status === 'in_progress'">
								<div class="flex items-center justify-center w-5 h-5 rounded-full bg-primary/10 border border-primary/20">
									<div class="w-2.5 h-2.5 rounded-full border-2 border-primary/30 border-t-primary/80 animate-spin"></div>
								</div>
							</template>
							<!-- Pending: empty circle -->
							<template x-if="todo.status === 'pending'">
								<div class="flex items-center justify-center w-5 h-5 rounded-full border border-border/20 bg-muted/5 group-hover/item:border-border/30 transition-colors">
									<div class="w-1.5 h-1.5 rounded-full bg-muted-foreground/10"></div>
								</div>
							</template>
							<!-- Cancelled: x circle -->
							<template x-if="todo.status === 'cancelled'">
								<div class="flex items-center justify-center w-5 h-5 rounded-full bg-muted/10 border border-border/10">
									<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground/30">
										<line x1="18" y1="6" x2="6" y2="18"></line>
										<line x1="6" y1="6" x2="18" y2="18"></line>
									</svg>
								</div>
							</template>
						</div>
						<!-- Task content -->
						<div class="flex-1 min-w-0 flex flex-col gap-0.5">
							<span
								class="text-[13px] leading-snug transition-colors duration-300"
								:class="{
									'text-emerald-500/70 line-through decoration-emerald-500/20': todo.status === 'completed',
									'text-foreground/90 font-medium': todo.status === 'in_progress',
									'text-foreground/60': todo.status === 'pending',
									'text-muted-foreground/40 line-through decoration-muted-foreground/20': todo.status === 'cancelled'
								}"
								x-text="todo.description"
							></span>
							<!-- Active task indicator label -->
							<template x-if="todo.status === 'in_progress'">
								<span class="text-[9px] font-bold uppercase tracking-[0.2em] text-primary/40">In Progress</span>
							</template>
						</div>
						<!-- Step number -->
						<span
							class="flex-shrink-0 text-[10px] font-mono tabular-nums mt-0.5"
							:class="{
								'text-emerald-500/30': todo.status === 'completed',
								'text-primary/40': todo.status === 'in_progress',
								'text-muted-foreground/15': todo.status === 'pending' || todo.status === 'cancelled'
							}"
							x-text="'#' + (index + 1)"
						></span>
					</div>
				</template>
			</div>
			<!-- Summary footer chips -->
			<div class="flex items-center gap-2 mt-1 flex-wrap" x-show="total > 2">
				<template x-if="completed > 0">
					<div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/[0.06] border border-emerald-500/10">
						<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500/60"><polyline points="20 6 9 17 4 12"></polyline></svg>
						<span class="text-[9px] font-semibold text-emerald-500/50 tabular-nums" x-text="completed + ' done'"></span>
					</div>
				</template>
				<template x-if="todos.filter(t => t.status === 'pending').length > 0">
					<div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-muted/5 border border-border/10">
						<div class="w-1.5 h-1.5 rounded-full bg-muted-foreground/20"></div>
						<span class="text-[9px] font-semibold text-muted-foreground/30 tabular-nums" x-text="todos.filter(t => t.status === 'pending').length + ' remaining'"></span>
					</div>
				</template>
				<template x-if="todos.filter(t => t.status === 'cancelled').length > 0">
					<div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-muted/5 border border-border/10">
						<span class="text-[9px] font-semibold text-muted-foreground/25 tabular-nums" x-text="todos.filter(t => t.status === 'cancelled').length + ' skipped'"></span>
					</div>
				</template>
			</div>
		</div>
		<!-- Empty / Cleared state -->
		<div x-show="todos.length === 0" class="flex flex-col items-center justify-center py-4 gap-2">
			<div class="text-muted-foreground/15">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg>
			</div>
			<span class="text-[11px] text-muted-foreground/20 font-medium">Task list cleared</span>
		</div>
		<!-- Streaming state: show pulsing indicator while agent is composing the todo list -->
		<template x-if="message.isStreaming && todos.length === 0">
			<div class="flex flex-col gap-2 py-2 animate-pulse">
				<div class="h-3 bg-muted/10 rounded-full w-3/4"></div>
				<div class="h-3 bg-muted/10 rounded-full w-1/2"></div>
				<div class="h-3 bg-muted/10 rounded-full w-2/3"></div>
			</div>
		</template>
	}
}

templ PluginTemplate() {
	<template x-if="message.name === 'write_todos'">
		@Container()
	</template>
}
