package cognitive

import "school-with-ai/components/annotation"

templ icon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path><path d="M6.002 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M19.938 10.5a4 4 0 0 1 .585.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M19.967 17.484A4 4 0 0 1 18 18"></path></svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		Label:   "Thinking",
		Subtext: "AI is analyzing the task",
	}) {
		<div class="flex flex-col gap-4">
			<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-4 flex flex-col shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)] transition-colors hover:bg-muted/[0.05]">
				<div class="text-[12px] uppercase tracking-[0.2em] font-bold text-muted-foreground/30 mb-2">Thoughts</div>
				<div class="text-sm text-foreground/80 italic break-words whitespace-pre-wrap" x-text="message.parsedArgs?.thoughts"></div>
				<!-- Streaming cursor indicator -->
				<template x-if="message.isStreaming">
					<span class="inline-block w-2 h-4 bg-primary/50 animate-pulse ml-0.5"></span>
				</template>
			</div>
		</div>
	}
}

templ PluginTemplate() {
	<template x-if="message.name === 'think'">
		@Container()
	</template>
}
