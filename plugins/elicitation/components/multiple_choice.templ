package elicitation

import "school-with-ai/components/badge"

// MultipleChoiceProps - no specific props needed as it relies on parent Alpine context
type MultipleChoiceProps struct{}

templ MultipleChoice() {
	<!-- Active State: Clickable Buttons -->
	<template x-if="message.status === 'awaiting_input'">
		<div class="mt-6 flex flex-col w-full gap-3 animate-in fade-in slide-in-from-top-4 duration-500">
			<template x-for="option in message.parsedArgs.schema.enum">
				<button
					@click="sendMessage(option)"
					class="group/opt flex items-center justify-start w-full p-4 rounded-xl border border-border/40 bg-card/5 text-[14px] font-medium text-foreground/70 transition-all duration-300 hover:border-primary/40 hover:bg-primary/[0.03] hover:text-foreground active:scale-[0.99] hover:shadow-sm"
					x-text="option"
				></button>
			</template>
		</div>
	</template>
	<!-- Answered State: Shows selected answer -->
	<template x-if="message.status === 'answered'">
		<div class="mt-4 flex flex-col w-full gap-2">
			<template x-for="option in (message.parsedArgs?.schema?.enum || [])">
				<div
					class="flex items-center gap-3 w-full p-3 rounded-xl border text-[13px] font-medium transition-none"
					:class="option === message.userAnswer
						? 'border-primary/50 bg-primary/[0.08] text-foreground'
						: 'border-border/20 bg-transparent text-muted-foreground/40'"
				>
					<template x-if="option === message.userAnswer">
						<svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
						</svg>
					</template>
					<span x-text="option"></span>
				</div>
			</template>
		</div>
	</template>
	<!-- History State: Static Badges -->
	<template x-if="message.status && message.status !== 'awaiting_input' && message.status !== 'answered'">
		<div class="mt-4 flex flex-wrap gap-2 opacity-50">
			<template x-for="option in (message.parsedArgs?.schema?.enum || [])">
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] uppercase tracking-wider font-bold border-border/40"}) {
					<span x-text="option"></span>
				}
			</template>
		</div>
	</template>
}
