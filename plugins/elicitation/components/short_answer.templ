package elicitation

// ShortAnswerProps - no specific props needed as it relies on parent Alpine context
type ShortAnswerProps struct{}

templ ShortAnswer() {
	<template x-if="message.status === 'awaiting_input'">
		<div
			class="mt-6 pt-6 border-t border-border/10 animate-in fade-in slide-in-from-top-4 duration-500 w-full"
			x-data="{ answer: '' }"
		>
			<form @submit.prevent="sendMessage(answer)" class="flex flex-col gap-4">
				<div class="relative group/input">
					<input
						type="text"
						x-model="answer"
						class="flex h-12 w-full rounded-xl border border-border/40 bg-card/5 px-4 py-2 text-[14px] shadow-[inset_0_1px_4px_rgba(0,0,0,0.02)] placeholder:text-muted-foreground/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/20 focus-visible:border-primary/40 transition-all duration-300"
						placeholder="Synthesize your response here..."
						autofocus
					/>
					<div class="absolute bottom-0 left-4 right-4 h-[1px] bg-gradient-to-r from-transparent via-primary/20 to-transparent scale-x-0 group-focus-within/input:scale-x-100 transition-transform duration-500"></div>
				</div>
				<div class="flex justify-end w-full">
					<button
						type="submit"
						class="group/btn relative overflow-hidden inline-flex items-center justify-center whitespace-nowrap rounded-xl text-[13px] font-bold tracking-widest uppercase transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-40 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8 shadow-lg shadow-primary/20 active:scale-[0.98]"
						:disabled="answer.trim() === ''"
					>
						<span class="relative z-10 flex items-center gap-2">
							Reply
							<svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
							</svg>
						</span>
						<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover/btn:animate-[shimmer_1.5s_infinite]"></div>
					</button>
				</div>
			</form>
		</div>
	</template>
	<!-- Answered State: Shows submitted answer -->
	<template x-if="message.status === 'answered'">
		<div class="mt-4 pt-4 border-t border-border/10 w-full">
			<div class="flex items-start gap-3">
				<svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
				</svg>
				<div class="text-[14px] text-foreground/80 font-medium" x-text="message.userAnswer"></div>
			</div>
		</div>
	</template>
}
