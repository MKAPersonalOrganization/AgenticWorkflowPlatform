package elicitation

import "school-with-ai/components/annotation"

// Props - no specific props, relies on Alpine context `message`
type Props struct{}

templ icon() {
	<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		Label: "Clarification Requested",
		FooterDotAttrs: templ.Attributes{
			"x-show": "message.status === 'awaiting_input'",
			"class":  "bg-primary animate-pulse shadow-[0_0_8px_rgba(var(--primary),0.4)]",
		},
		Subtext: "Input required to synchronize learning trajectory",
	}) {
		<div class="flex flex-col gap-4">
			<!-- Question Text: Academic Typography -->
			<div class="group relative w-full">
				<div
					class="text-[15px] leading-relaxed text-foreground/90 font-medium font-serif italic prose prose-sm max-w-none dark:prose-invert text-center px-4"
					x-html="renderMarkdown(message.parsedResult?.question_text || message.parsedResult?.statement_to_verify || '')"
				></div>
			</div>
			<!-- Children (Input Controls) -->
			<div class="w-full">
				{ children... }
			</div>
		</div>
	}
}
