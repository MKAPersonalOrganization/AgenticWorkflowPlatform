package elicitation

import "school-with-ai/plugins/elicitation/components"

templ PluginTemplate() {
	<template x-if="message.parsedResult?.schema?.type === 'choose_multiple'">
		@elicitation.Container() {
			@elicitation.AskMultipleSelection()
		}
	</template>
	<template x-if="message.parsedResult?.schema?.type === 'multiple_choice'">
		@elicitation.Container() {
			@elicitation.MultipleChoice()
		}
	</template>
	<template x-if="message.parsedResult?.schema?.type === 'true_false'">
		@elicitation.Container() {
			@elicitation.AskTrueFalse()
		}
	</template>
	<template x-if="message.parsedResult?.schema?.type === 'short_answer'">
		@elicitation.Container() {
			@elicitation.ShortAnswer()
		}
	</template>
}
