package lookupsection

import "aicompass/ui/annotation"

templ icon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		Label:   "Context Resolved",
		Subtext: "Relevant knowledge segments retrieved from indexed archives",
	}) {
		<div class="flex flex-col gap-4">
			<!-- Query Info: Academic Typography -->
			<div class="flex items-center gap-2 text-[12px] text-muted-foreground/50 italic font-serif">
				<span class="font-semibold text-muted-foreground/40">Lookup Query:</span>
				<span class="text-primary/70 not-italic font-mono text-[11px] bg-primary/[0.05] px-2 py-0.5 rounded-md border border-primary/10 shadow-sm" x-text="message.parsedArgs?.query || 'context lookup'"></span>
			</div>
			<!-- Content Area: Specialized Surface -->
			<div class="relative w-full">
				<div class="bg-muted/[0.04] border border-border/10 rounded-xl p-5 text-[14px] leading-relaxed text-foreground/90 font-serif shadow-[inset_0_1px_4px_rgba(0,0,0,0.02)] transition-colors hover:bg-muted/[0.06]">
					<span x-text="message.result"></span>
				</div>
			</div>
		</div>
	}
}

