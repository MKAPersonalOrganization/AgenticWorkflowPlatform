package searchtext

import "aicompass/ui/annotation"

templ icon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		Label:   "Pattern Located",
		Subtext: "Search completed across indexed document segments",
	}) {
		<div class="flex flex-col gap-3">
			<!-- Search Spec: Academic Typography -->
			<div class="flex items-center gap-2 text-[12px] text-muted-foreground/50 italic font-serif">
				<span class="font-semibold">Query:</span>
				<span class="text-primary/70 not-italic font-mono text-[11px] bg-primary/[0.05] px-2 py-0.5 rounded-md border border-primary/10 shadow-sm" x-text="message.parsedArgs?.pattern || 'search'"></span>
				<span class="font-semibold ms-2">Context:</span>
				<span class="text-foreground/70 not-italic font-sans font-medium" x-text="(message.parsedArgs?.file_path || '').split('/').pop()"></span>
			</div>
			<!-- Content Area: Specialized Surface -->
			<div class="relative w-full">
				<div class="bg-muted/[0.04] border border-border/10 rounded-xl p-5 text-[13px] font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed text-foreground/90 shadow-[inset_0_1px_4px_rgba(0,0,0,0.02)] transition-colors hover:bg-muted/[0.06]">
					<span x-text="message.result"></span>
				</div>
			</div>
		</div>
	}
}


