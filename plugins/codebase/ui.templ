package codebase

import (
	"aicompass/plugins/codebase/components/lookupsection"
	"aicompass/plugins/codebase/components/searchtext"
)

templ PluginTemplate() {
	<template x-if="message.name === 'lookup_section'">
		@lookupsection.Container()
	</template>
	<template x-if="message.name === 'search_text_in_file'">
		@searchtext.Container()
	</template>
}
