package library

templ Library() {
	<div
		class="block w-full my-8 relative"
	>
		<!-- Ornamental Label/Side Bar -->
		<div
			class="absolute -start-4 top-1 bottom-1 w-[3px] rounded-full bg-primary/30 transition-colors duration-500"
		></div>
		<!-- Content Wrapper -->
		<div class="flex flex-col gap-3 ps-4 w-full">
			<!-- Header / Intent -->
			<div class="flex items-center gap-2">
				<div class="p-0.5 text-primary">
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
					</svg>
				</div>
				<span
					class="text-[10px] font-bold tracking-[0.2em] uppercase text-muted-foreground/50"
				>Collection Indexed</span>
			</div>
			<!-- Breadcrumbs: Specialized Typography -->
			<div class="flex items-center gap-1.5 flex-wrap">
				<span class="text-[11px] font-semibold text-foreground/40 italic font-serif">DeepSearch Path:</span>
				<template x-for="(segment, index) in (message.parsedArgs?.path || '').split('/').filter(Boolean)">
					<div class="flex items-center gap-1.5">
						<svg class="w-2.5 h-2.5 text-muted-foreground/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
						</svg>
						<span class="text-[11px] font-medium text-primary/70 bg-primary/5 px-2 py-0.5 rounded-sm border border-primary/10" x-text="segment"></span>
					</div>
				</template>
			</div>
			<!-- Results Grid/List -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-2 w-full mt-2">
				<template x-for="(node, nIndex) in message.parsedResult?.nodes" :key="nIndex">
					<div
						class="flex items-center gap-3 p-2.5 rounded-md bg-muted/5 border border-transparent hover:border-primary/20 hover:bg-primary/[0.02] transition-all group/node cursor-default"
					>
						<!-- Minimalist Icon -->
						<div class="shrink-0 text-muted-foreground/40 group-hover/node:text-primary/60 transition-colors">
							<template x-if="node.type === 'grade'">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
							</template>
							<template x-if="node.type === 'book'">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
							</template>
							<template x-if="node.type === 'chapter' || node.type.startsWith('heading-')">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
							</template>
							<template x-if="!['grade', 'book', 'chapter'].includes(node.type) && !node.type.startsWith('heading-')">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
							</template>
						</div>
						<div class="flex-1 min-w-0">
							<p class="text-[13px] font-medium text-foreground/80 truncate font-serif italic" x-text="node.name"></p>
							<div class="flex items-center gap-2 mt-0.5">
								<span class="text-[8px] text-muted-foreground/40 uppercase tracking-[0.15em] font-bold" x-text="node.type"></span>
								<div class="h-1 w-1 rounded-full bg-muted/20"></div>
							</div>
						</div>
					</div>
				</template>
			</div>
			<!-- Empty State -->
			<template x-if="!message.parsedResult?.nodes || message.parsedResult.nodes.length === 0">
				<div class="flex items-center gap-3 py-4 border-y border-dashed border-muted/20 w-full justify-center">
					<span class="text-[10px] font-bold tracking-widest text-muted-foreground/30 uppercase italic">No resources matched index query</span>
				</div>
			</template>
			<!-- Footer Acknowledgment -->
			<div class="flex items-center gap-3 mt-2 w-full">
				<div class="h-[1px] flex-1 bg-muted/10"></div>
				<span class="text-[9px] font-medium text-muted-foreground/30 italic">Collection results verified via Knowledge Library</span>
				<div class="size-1.5 rounded-full bg-primary/20"></div>
			</div>
		</div>
	</div>
}
