package skills

import "fmt"

templ PluginTemplate() {
	<!-- Skill Activation: activate_skill -->
	<template x-if="message.name === 'activate_skill'">
		<div class="my-2">
			<div
				x-data="{
					expanded: false,
					get result() {
						try { return JSON.parse(message.result || '{}') } catch { return {} }
					},
					get isActivated() { return this.result.status === 'activated' },
					get skillName() { return this.result.skill_name || message.parsedArgs?.name || 'Unknown' },
					get category() { return this.result.category || '' },
					get description() { return this.result.description || '' },
					get hasError() { return message.error || this.result.status === 'error' }
				}"
			>
				<!-- Activated State -->
				<template x-if="isActivated">
					<div class="rounded-lg border border-violet-200 dark:border-violet-800 bg-violet-50 dark:bg-violet-950/30 overflow-hidden">
						<!-- Header -->
						<div
							class="flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-violet-100 dark:hover:bg-violet-900/30 transition-colors"
							@click="expanded = !expanded"
						>
							<!-- Skill Icon -->
							<div class="flex-shrink-0 w-8 h-8 rounded-full bg-violet-100 dark:bg-violet-900/50 flex items-center justify-center">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-violet-600 dark:text-violet-400">
									<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
								</svg>
							</div>
							<!-- Skill Info -->
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="text-sm font-medium text-violet-900 dark:text-violet-100" x-text={ fmt.Sprintf("`Skill Activated: ${%s}`", "skillName") }></span>
									<span
										x-show="category"
										class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-violet-200 dark:bg-violet-800 text-violet-700 dark:text-violet-300"
										x-text="category"
									></span>
								</div>
								<p x-show="description" class="text-xs text-violet-600 dark:text-violet-400 truncate mt-0.5" x-text="description"></p>
							</div>
							<!-- Expand/Collapse -->
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="w-4 h-4 text-violet-500 transition-transform duration-200"
								:class="expanded ? 'rotate-180' : ''"
							>
								<path d="m6 9 6 6 6-6"></path>
							</svg>
						</div>
						<!-- Expanded Content (skill instructions preview) -->
						<div x-show="expanded" x-collapse class="border-t border-violet-200 dark:border-violet-800">
							<div class="px-4 py-3 max-h-48 overflow-y-auto">
								<p class="text-xs font-medium text-violet-700 dark:text-violet-300 mb-1">Skill Instructions:</p>
								<pre class="text-xs text-violet-600 dark:text-violet-400 whitespace-pre-wrap font-mono" x-text="result.instructions"></pre>
							</div>
						</div>
						<!-- Status Footer -->
						<div class="flex items-center gap-2 px-4 py-2 bg-violet-100/50 dark:bg-violet-900/20 border-t border-violet-200 dark:border-violet-800">
							<div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
							<span class="text-[10px] text-violet-600 dark:text-violet-400">Active this session</span>
						</div>
					</div>
				</template>
				<!-- Error State -->
				<template x-if="hasError">
					<div class="rounded-lg border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/30 px-4 py-3">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-red-500">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="12" x2="12" y1="8" y2="12"></line>
								<line x1="12" x2="12.01" y1="16" y2="16"></line>
							</svg>
							<span class="text-sm text-red-700 dark:text-red-300">
								Failed to activate skill "<span x-text="skillName"></span>"
							</span>
						</div>
					</div>
				</template>
				<!-- Loading State (no result yet) -->
				<template x-if="!isActivated && !hasError && !message.result">
					<div class="rounded-lg border border-violet-200 dark:border-violet-800 bg-violet-50 dark:bg-violet-950/30 px-4 py-3">
						<div class="flex items-center gap-3">
							<div class="w-4 h-4 border-2 border-violet-400 border-t-transparent rounded-full animate-spin"></div>
							<span class="text-sm text-violet-700 dark:text-violet-300">
								Activating skill "<span x-text="skillName"></span>"...
							</span>
						</div>
					</div>
				</template>
			</div>
		</div>
	</template>
}
