package filesystem

import (
	"aicompass/components/badge"
	"aicompass/components/button"
	"aicompass/components/dialog"
	"aicompass/ui/i18n"
	"aicompass/components/icon"
	"aicompass/components/input"
	"aicompass/components/label"
	"aicompass/components/skeleton"
	"aicompass/components/textarea"
)

// ─── Nav Button Trigger ─────────────────────────────────────────────────────
templ FilesystemButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{For: "filesystem-dialog"}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"title":  i18n.T(ctx, "Filesystems"),
				"@click": "$dispatch('open-filesystem-dialog')",
			},
		}) {
			@icon.HardDrive(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Filesystems") }</span>
		}
	}
}

// ─── Main Dialog ────────────────────────────────────────────────────────────
templ FilesystemDialog() {
	<div x-data="{ expanded: false, toggleExpand() { this.expanded = !this.expanded } }">
		@dialog.Dialog(dialog.Props{
			ID: "filesystem-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-6xl max-h-[90vh] flex flex-col p-0 overflow-hidden transition-all duration-300 ease-in-out",
				Attributes: templ.Attributes{
					":class": "expanded ? '!max-w-[calc(100vw-2rem)] !max-h-[calc(100vh-2rem)] !w-[calc(100vw-2rem)] !h-[calc(100vh-2rem)]' : ''",
				},
			}) {
			<div
				x-data="filesystemManager"
				@open-filesystem-dialog.window="init()"
				@contextmenu.prevent=""
				class="flex flex-col h-full max-h-[90vh]"
			>
				<!-- ═══════════════════════════════════════════════════════════ -->
				<!-- HEADER                                                     -->
				<!-- ═══════════════════════════════════════════════════════════ -->
				@dialog.Header(dialog.HeaderProps{Class: "px-6 pt-5 pb-3 border-b shrink-0"}) {
					<div class="flex items-center justify-between">
						<div>
							@dialog.Title() {
								<span x-show="view === 'list'" class="flex items-center gap-2">
									@icon.HardDrive(icon.Props{Class: "size-5"})
									{ i18n.T(ctx, "File Manager") }
								</span>
								<span x-show="view === 'create'" x-cloak class="flex items-center gap-2">
									@icon.FolderPlus(icon.Props{Class: "size-5"})
									{ i18n.T(ctx, "New Filesystem") }
								</span>
								<span x-show="view === 'browse'" x-cloak class="flex items-center gap-2">
									<template x-if="currentFS?.type === 'github'">
										@icon.Github(icon.Props{Class: "size-5"})
									</template>
									<template x-if="currentFS?.type !== 'github'">
										@icon.HardDrive(icon.Props{Class: "size-5"})
									</template>
									<span x-text="currentFS?.name || 'Browse'"></span>
								</span>
								<span x-show="view === 'permissions'" x-cloak class="flex items-center gap-2">
									@icon.Shield(icon.Props{Class: "size-5"})
									{ i18n.T(ctx, "Permissions") }
								</span>
							}
							@dialog.Description() {
								<span x-show="view === 'list'">{ i18n.T(ctx, "Manage your virtual filesystems and control agent access.") }</span>
								<span x-show="view === 'create'" x-cloak>{ i18n.T(ctx, "Set up a new virtual filesystem backed by S3 or GitHub.") }</span>
								<span x-show="view === 'browse'" x-cloak>{ i18n.T(ctx, "Browse and manage files and directories.") }</span>
								<span x-show="view === 'permissions'" x-cloak>{ i18n.T(ctx, "Control which agents can access this filesystem.") }</span>
							}
						</div>
						<div class="flex items-center gap-1">
							<div x-show="view !== 'list'" x-cloak>
								@button.Button(button.Props{
									Variant: button.VariantOutline,
									Size:    button.SizeSm,
									Attributes: templ.Attributes{
										"@click": "goBack()",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4 me-1"})
									{ i18n.T(ctx, "Back") }
								}
							</div>
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-7 text-muted-foreground",
								Attributes: templ.Attributes{
									"@click": "toggleExpand()",
									"title":  i18n.T(ctx, "Toggle fullscreen"),
								},
							}) {
								<span x-show="!expanded">
									@icon.Maximize2(icon.Props{Class: "size-3.5"})
								</span>
								<span x-show="expanded">
									@icon.Minimize2(icon.Props{Class: "size-3.5"})
								</span>
							}
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"title": i18n.T(ctx, "Close"),
									},
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>
					</div>
				}
				<!-- ═══════════════════════════════════════════════════════════ -->
				<!-- BODY                                                       -->
				<!-- ═══════════════════════════════════════════════════════════ -->
				<div class="flex-1 overflow-y-auto">
					<!-- ──────────────────────── LIST VIEW ────────────────── -->
					<div x-show="view === 'list'" class="px-6 py-4">
						<!-- Top Actions -->
						<div class="flex items-center justify-between mb-4">
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Size:    button.SizeSm,
								Attributes: templ.Attributes{
									"@click": "view = 'create'",
								},
							}) {
								@icon.Plus(icon.Props{Class: "size-4 me-1"})
								{ i18n.T(ctx, "New Filesystem") }
							}
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Class:   "size-8",
								Attributes: templ.Attributes{
									"@click": "fetchFilesystems()",
									"title":  i18n.T(ctx, "Refresh"),
								},
							}) {
								@icon.RefreshCw(icon.Props{Class: "size-4"})
							}
						</div>
						<!-- Loading Skeleton -->
						<div x-show="loading" class="space-y-3">
							@skeleton.Skeleton(skeleton.Props{Class: "h-[72px] w-full rounded-lg"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-[72px] w-full rounded-lg"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-[72px] w-full rounded-lg"})
						</div>
						<!-- Empty State -->
						<div x-show="!loading && filesystems.length === 0" x-cloak class="text-center py-16">
							<div class="inline-flex items-center justify-center size-16 rounded-full bg-muted mb-4">
								@icon.HardDrive(icon.Props{Class: "size-8 text-muted-foreground/60"})
							</div>
							<h3 class="text-lg font-medium text-foreground">{ i18n.T(ctx, "No filesystems yet") }</h3>
							<p class="text-sm text-muted-foreground mt-1 max-w-sm mx-auto">{ i18n.T(ctx, "Create a virtual filesystem to give agents file management capabilities.") }</p>
							<div class="mt-4">
								@button.Button(button.Props{
									Variant: button.VariantOutline,
									Size:    button.SizeSm,
									Attributes: templ.Attributes{
										"@click": "view = 'create'",
									},
								}) {
									@icon.Plus(icon.Props{Class: "size-4 me-1"})
									{ i18n.T(ctx, "Create your first filesystem") }
								}
							</div>
						</div>
						<!-- Filesystem Cards (Drive list like Windows "This PC") -->
						<div x-show="!loading && filesystems.length > 0" x-cloak class="grid grid-cols-1 md:grid-cols-2 gap-3">
							<template x-for="fs in filesystems" :key="fs.id">
								<div
									class="group relative flex items-start gap-4 p-4 rounded-xl border bg-card hover:bg-accent/50 hover:border-accent-foreground/20 transition-all cursor-pointer shadow-sm hover:shadow-md"
									@click="browseFS(fs)"
								>
									<!-- Drive Icon -->
									<div class="shrink-0 flex items-center justify-center size-12 rounded-lg bg-muted">
										<template x-if="fs.type === 'local'">
											@icon.HardDrive(icon.Props{Class: "size-6 text-blue-500"})
										</template>
										<template x-if="fs.type === 'github'">
											@icon.Github(icon.Props{Class: "size-6 text-foreground"})
										</template>
									</div>
									<!-- Info -->
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-2">
											<span class="font-semibold text-sm truncate" x-text="fs.name"></span>
											@badge.Badge(badge.Props{
												Variant: badge.VariantSecondary,
												Class:   "text-[10px] px-1.5 py-0 shrink-0",
											}) {
												<span x-text="fs.type === 'local' ? 'S3' : 'GitHub'"></span>
											}
										</div>
										<p class="text-xs text-muted-foreground truncate mt-0.5" x-text="fs.description || 'No description'"></p>
									</div>
									<!-- Action buttons (show on hover) -->
									<div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeIcon,
											Class:   "size-8",
											Attributes: templ.Attributes{
												"@click.stop": "openPermissions(fs)",
												"title":       i18n.T(ctx, "Permissions"),
											},
										}) {
											@icon.Shield(icon.Props{Class: "size-4 text-muted-foreground"})
										}
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeIcon,
											Class:   "size-8",
											Attributes: templ.Attributes{
												"@click.stop": "confirmDelete(fs)",
												"title":       i18n.T(ctx, "Delete"),
											},
										}) {
											@icon.Trash2(icon.Props{Class: "size-4 text-destructive"})
										}
									</div>
								</div>
							</template>
						</div>
					</div>
					<!-- ──────────────────────── CREATE VIEW ──────────────── -->
					<div x-show="view === 'create'" x-cloak class="px-6 py-4">
						<form @submit.prevent="submitCreate()" class="space-y-4">
							<div>
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Name") }
								}
								@input.Input(input.Props{
									Placeholder: "My Workspace Files",
									Attributes: templ.Attributes{
										"x-model":  "form.name",
										"required": "true",
									},
								})
							</div>
							<div>
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Description") }
								}
								@textarea.Textarea(textarea.Props{
									Placeholder: "Optional description...",
									Attributes: templ.Attributes{
										"x-model": "form.description",
										"rows":    "2",
									},
								})
							</div>
							<div>
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Type") }
								}
								<div class="flex gap-3 mt-1">
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Attributes: templ.Attributes{
											"@click": "form.type = 'local'",
											":class": "form.type === 'local' ? 'border-primary bg-primary/10' : ''",
											"type":   "button",
										},
									}) {
										@icon.HardDrive(icon.Props{Class: "size-4 me-1"})
										{ i18n.T(ctx, "S3 / MinIO") }
									}
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Attributes: templ.Attributes{
											"@click": "form.type = 'github'",
											":class": "form.type === 'github' ? 'border-primary bg-primary/10' : ''",
											"type":   "button",
										},
									}) {
										@icon.Github(icon.Props{Class: "size-4 me-1"})
										{ i18n.T(ctx, "GitHub Repository") }
									}
								</div>
							</div>
							<!-- GitHub Config (OAuth-based) -->
							<div x-show="form.type === 'github'" x-cloak class="space-y-3 p-4 rounded-lg border bg-muted/50">
								<!-- Connection Status -->
								<div x-show="!githubStatus.connected" class="text-center py-4">
									@icon.Github(icon.Props{Class: "size-8 mx-auto text-muted-foreground mb-3"})
									<p class="text-sm text-muted-foreground mb-3">{ i18n.T(ctx, "Connect your GitHub account to browse and select a repository.") }</p>
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Attributes: templ.Attributes{
											"@click": "connectGitHub()",
											"type":   "button",
										},
									}) {
										@icon.Github(icon.Props{Class: "size-4 me-2"})
										{ i18n.T(ctx, "Connect GitHub Account") }
									}
								</div>
								<div x-show="githubStatus.connected" x-cloak>
									<!-- Connected Banner -->
									<div class="flex items-center justify-between mb-3 p-2 rounded-md bg-green-500/10 border border-green-500/20">
										<div class="flex items-center gap-2">
											<img x-show="githubStatus.avatar" :src="githubStatus.avatar" class="size-6 rounded-full" alt=""/>
											<span class="text-sm font-medium text-green-700 dark:text-green-400">
												{ i18n.T(ctx, "Connected as") } <span x-text="'@' + githubStatus.username"></span>
											</span>
										</div>
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeSm,
											Class:   "text-destructive hover:text-destructive h-7",
											Attributes: templ.Attributes{
												"@click": "disconnectGitHub()",
												"type":   "button",
											},
										}) {
											{ i18n.T(ctx, "Disconnect") }
										}
									</div>
									<!-- Repository Selector -->
									<div>
										@label.Label(label.Props{}) {
											{ i18n.T(ctx, "Repository") }
										}
										<div class="relative mt-1">
											<select
												x-model="form.github.selectedRepo"
												@change="onRepoSelected()"
												class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 appearance-none cursor-pointer"
											>
												<option value="">{ i18n.T(ctx, "Select a repository...") }</option>
												<template x-for="repo in githubRepos" :key="repo.full_name">
													<option :value="repo.full_name" x-text="repo.full_name + (repo.private ? ' 🔒' : '')"></option>
												</template>
											</select>
											<div x-show="loadingRepos" class="absolute right-3 top-2.5">
												<div class="size-5 border-2 border-muted-foreground/30 border-t-muted-foreground rounded-full animate-spin"></div>
											</div>
										</div>
									</div>
									<!-- Branch -->
									<div class="mt-3">
										@label.Label(label.Props{}) {
											{ i18n.T(ctx, "Branch") }
										}
										@input.Input(input.Props{
											Placeholder: "main",
											Attributes: templ.Attributes{
												"x-model": "form.github.branch",
											},
										})
									</div>
								</div>
							</div>
							<div class="flex justify-end gap-2 pt-2">
								@button.Button(button.Props{
									Variant: button.VariantOutline,
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
										"type":   "button",
									},
								}) {
									{ i18n.T(ctx, "Cancel") }
								}
								@button.Button(button.Props{
									Variant: button.VariantDefault,
									Type:    button.TypeSubmit,
									Attributes: templ.Attributes{
										":disabled": "creating",
									},
								}) {
									<span x-show="!creating">{ i18n.T(ctx, "Create") }</span>
									<span x-show="creating" x-cloak>{ i18n.T(ctx, "Creating...") }</span>
								}
							</div>
						</form>
					</div>
					<!-- ═══════════════════════════════════════════════════════ -->
					<!-- BROWSE VIEW — Windows Explorer / GitHub style          -->
					<!-- ═══════════════════════════════════════════════════════ -->
					<div x-show="view === 'browse'" x-cloak class="flex flex-col h-full">
						<!-- ── Address Bar ─────────────────────────────────── -->
						<div class="flex items-center gap-2 px-4 py-2 border-b bg-muted/30 shrink-0">
							<!-- Navigation Buttons -->
							<div class="flex items-center gap-0.5">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeIcon,
									Class:   "size-7",
									Attributes: templ.Attributes{
										"@click":    "navigateHistoryBack()",
										":disabled": "historyIndex <= 0",
										"title":     i18n.T(ctx, "Back"),
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeIcon,
									Class:   "size-7",
									Attributes: templ.Attributes{
										"@click":    "navigateHistoryForward()",
										":disabled": "historyIndex >= history.length - 1",
										"title":     i18n.T(ctx, "Forward"),
									},
								}) {
									@icon.ArrowRight(icon.Props{Class: "size-4"})
								}
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeIcon,
									Class:   "size-7",
									Attributes: templ.Attributes{
										"@click": "navigateTo('/')",
										"title":  i18n.T(ctx, "Root"),
									},
								}) {
									@icon.House(icon.Props{Class: "size-4"})
								}
							</div>
							<!-- Breadcrumb Path Bar -->
							<div class="flex-1 flex items-center gap-0 min-w-0 bg-background border rounded-md px-3 py-1.5 text-sm overflow-x-auto scrollbar-none">
								<span class="cursor-pointer hover:text-primary hover:underline shrink-0 font-medium" @click="navigateTo('/')">
									<template x-if="currentFS?.type === 'github'">
										@icon.Github(icon.Props{Class: "size-3.5 inline -mt-0.5 me-1"})
									</template>
									<template x-if="currentFS?.type !== 'github'">
										@icon.HardDrive(icon.Props{Class: "size-3.5 inline -mt-0.5 me-1"})
									</template>
									<span x-text="currentFS?.name || 'Root'"></span>
								</span>
								<template x-for="(part, idx) in pathParts" :key="idx">
									<span class="flex items-center shrink-0">
										@icon.ChevronRight(icon.Props{Class: "size-3.5 mx-1 text-muted-foreground/60"})
										<span
											class="cursor-pointer hover:text-primary hover:underline"
											@click="navigateToIndex(idx)"
											x-text="part"
										></span>
									</span>
								</template>
							</div>
							<!-- Refresh -->
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Class:   "size-7",
								Attributes: templ.Attributes{
									"@click": "fetchEntries()",
									"title":  i18n.T(ctx, "Refresh"),
								},
							}) {
								@icon.RefreshCw(icon.Props{Class: "size-4"})
							}
						</div>
						<!-- ── Toolbar ─────────────────────────────────────── -->
						<div class="flex items-center justify-between gap-2 px-4 py-2 border-b bg-muted/10 shrink-0">
							<div class="flex items-center gap-1">
								<!-- New Folder + Upload (local only) -->
								<template x-if="currentFS?.type === 'local'">
									<div class="flex items-center gap-1">
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeSm,
											Class:   "h-7 text-xs",
											Attributes: templ.Attributes{
												"@click": "showMkdir = !showMkdir; $nextTick(() => { if(showMkdir) $refs.mkdirInput?.focus() })",
												"title":  i18n.T(ctx, "New Folder"),
											},
										}) {
											@icon.FolderPlus(icon.Props{Class: "size-4 me-1"})
											{ i18n.T(ctx, "New Folder") }
										}
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeSm,
											Class:   "h-7 text-xs",
											Attributes: templ.Attributes{
												"@click": "$refs.fileInput.click()",
												"title":  i18n.T(ctx, "Upload"),
											},
										}) {
											@icon.Upload(icon.Props{Class: "size-4 me-1"})
											{ i18n.T(ctx, "Upload") }
										}
										<input type="file" x-ref="fileInput" class="hidden" @change="handleFileUpload($event)" multiple/>
									</div>
								</template>
								<!-- Separator -->
								<div class="w-px h-5 bg-border mx-1" x-show="currentFS?.type === 'local'"></div>
								<!-- Sort -->
								<div class="relative" x-data="{ sortOpen: false }">
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Size:    button.SizeSm,
										Class:   "h-7 text-xs",
										Attributes: templ.Attributes{
											"@click": "sortOpen = !sortOpen",
											"title":  i18n.T(ctx, "Sort"),
										},
									}) {
										@icon.ArrowUpDown(icon.Props{Class: "size-3.5 me-1"})
										{ i18n.T(ctx, "Sort") }
									}
									<div
										x-show="sortOpen"
										x-cloak
										@click.away="sortOpen = false"
										class="absolute left-0 top-full mt-1 z-50 min-w-[160px] rounded-md border bg-popover p-1 shadow-md"
									>
										<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="setSortBy('name'); sortOpen = false">
											@icon.ArrowUpAZ(icon.Props{Class: "size-3.5"})
											<span>{ i18n.T(ctx, "Name") }</span>
											<span x-show="sortBy === 'name'" class="ml-auto text-primary">
												<template x-if="sortDir === 'asc'">@icon.ArrowUp(icon.Props{Class: "size-3"})
</template>
												<template x-if="sortDir === 'desc'">@icon.ArrowDown(icon.Props{Class: "size-3"})
</template>
											</span>
										</button>
										<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="setSortBy('size'); sortOpen = false">
											@icon.HardDrive(icon.Props{Class: "size-3.5"})
											<span>{ i18n.T(ctx, "Size") }</span>
											<span x-show="sortBy === 'size'" class="ml-auto text-primary">
												<template x-if="sortDir === 'asc'">@icon.ArrowUp(icon.Props{Class: "size-3"})
</template>
												<template x-if="sortDir === 'desc'">@icon.ArrowDown(icon.Props{Class: "size-3"})
</template>
											</span>
										</button>
										<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="setSortBy('date'); sortOpen = false">
											@icon.Clock(icon.Props{Class: "size-3.5"})
											<span>{ i18n.T(ctx, "Date Modified") }</span>
											<span x-show="sortBy === 'date'" class="ml-auto text-primary">
												<template x-if="sortDir === 'asc'">@icon.ArrowUp(icon.Props{Class: "size-3"})
</template>
												<template x-if="sortDir === 'desc'">@icon.ArrowDown(icon.Props{Class: "size-3"})
</template>
											</span>
										</button>
									</div>
								</div>
							</div>
							<!-- View toggle -->
							<div class="flex items-center gap-0.5 bg-muted rounded-md p-0.5">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeIcon,
									Class:   "size-7",
									Attributes: templ.Attributes{
										"@click": "viewMode = 'list'",
										":class": "viewMode === 'list' ? 'bg-background shadow-sm' : ''",
										"title":  i18n.T(ctx, "List View"),
									},
								}) {
									@icon.LayoutList(icon.Props{Class: "size-4"})
								}
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeIcon,
									Class:   "size-7",
									Attributes: templ.Attributes{
										"@click": "viewMode = 'grid'",
										":class": "viewMode === 'grid' ? 'bg-background shadow-sm' : ''",
										"title":  i18n.T(ctx, "Grid View"),
									},
								}) {
									@icon.LayoutGrid(icon.Props{Class: "size-4"})
								}
							</div>
						</div>
						<!-- ── Inline Mkdir ────────────────────────────────── -->
						<div x-show="showMkdir" x-cloak class="flex items-center gap-2 px-4 py-2 border-b bg-blue-500/5">
							<div class="flex items-center justify-center size-8 rounded bg-blue-500/10">
								@icon.FolderPlus(icon.Props{Class: "size-4 text-blue-500"})
							</div>
							@input.Input(input.Props{
								Placeholder: "New folder name...",
								Class:       "flex-1 h-8 text-sm",
								Attributes: templ.Attributes{
									"x-ref":           "mkdirInput",
									"x-model":         "newDirName",
									"@keydown.enter":  "createDir()",
									"@keydown.escape": "showMkdir = false; newDirName = ''",
								},
							})
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Size:    button.SizeSm,
								Class:   "h-8",
								Attributes: templ.Attributes{
									"@click":    "createDir()",
									":disabled": "!newDirName.trim()",
								},
							}) {
								{ i18n.T(ctx, "Create") }
							}
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Class:   "size-8",
								Attributes: templ.Attributes{
									"@click": "showMkdir = false; newDirName = ''",
								},
							}) {
								@icon.X(icon.Props{Class: "size-4"})
							}
						</div>
						<!-- ── File Area (drop zone for local) ────────────── -->
						<div
							class="flex-1 overflow-y-auto relative"
							x-show="currentFS?.type === 'local'"
							@dragover.prevent="dragOver = true"
							@dragleave.prevent="dragOver = false"
							@drop.prevent="handleDrop($event)"
							@contextmenu.prevent="openContextMenu($event, null)"
							@click="selectedEntry = null"
						>
							<!-- Drop Overlay -->
							<div
								x-show="dragOver"
								x-cloak
								class="absolute inset-0 z-40 bg-primary/5 border-2 border-dashed border-primary/40 rounded-lg m-2 flex items-center justify-center pointer-events-none"
							>
								<div class="text-center">
									@icon.Upload(icon.Props{Class: "size-10 mx-auto text-primary/60 mb-2"})
									<p class="text-sm font-medium text-primary/80">{ i18n.T(ctx, "Drop files here to upload") }</p>
								</div>
							</div>
							@fileBrowseContent()
						</div>
						<!-- Non-local (GitHub) file area -->
						<div
							class="flex-1 overflow-y-auto"
							x-show="currentFS?.type !== 'local'"
							@contextmenu.prevent="openContextMenu($event, null)"
							@click="selectedEntry = null"
						>
							@fileBrowseContent()
						</div>
					</div>
					<!-- ──────────────────── PERMISSIONS VIEW ────────────── -->
					<div x-show="view === 'permissions'" x-cloak class="px-6 py-4">
						<div class="space-y-4">
							<div class="flex items-end gap-2">
								<div class="flex-1">
									@label.Label(label.Props{}) {
										{ i18n.T(ctx, "Agent ID") }
									}
									@input.Input(input.Props{
										Placeholder: "Enter agent ID to grant access...",
										Attributes: templ.Attributes{
											"x-model":        "permAgentId",
											"@keydown.enter": "grantPerm()",
										},
									})
								</div>
								@button.Button(button.Props{
									Variant: button.VariantDefault,
									Size:    button.SizeSm,
									Class:   "mb-0.5",
									Attributes: templ.Attributes{
										"@click": "grantPerm()",
									},
								}) {
									@icon.Plus(icon.Props{Class: "size-4 me-1"})
									{ i18n.T(ctx, "Grant") }
								}
							</div>
							<div x-show="permLoading" class="space-y-2">
								@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-full rounded"})
							</div>
							<div x-show="!permLoading && permissions.length === 0" x-cloak class="text-center py-8">
								<div class="inline-flex items-center justify-center size-12 rounded-full bg-muted mb-3">
									@icon.Shield(icon.Props{Class: "size-6 text-muted-foreground/60"})
								</div>
								<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "No agents have access to this filesystem yet.") }</p>
							</div>
							<div x-show="!permLoading && permissions.length > 0" x-cloak class="space-y-2">
								<template x-for="perm in permissions" :key="perm.id">
									<div class="flex items-center justify-between p-3 rounded-lg border bg-card">
										<div class="flex items-center gap-2">
											@icon.Bot(icon.Props{Class: "size-4 text-muted-foreground"})
											<span class="text-sm font-medium" x-text="perm.agent_id"></span>
										</div>
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeIcon,
											Class:   "size-7 text-destructive hover:text-destructive",
											Attributes: templ.Attributes{
												"@click": "revokePerm(perm.agent_id)",
											},
										}) {
											@icon.X(icon.Props{Class: "size-3.5"})
										}
									</div>
								</template>
							</div>
						</div>
					</div>
				</div>
				<!-- ═══════════════════════════════════════════════════════════ -->
				<!-- FOOTER / STATUS BAR                                        -->
				<!-- ═══════════════════════════════════════════════════════════ -->
				@dialog.Footer(dialog.FooterProps{Class: "px-4 py-2 border-t shrink-0 bg-muted/20"}) {
					<div class="flex items-center justify-between w-full text-xs text-muted-foreground">
						<div class="flex items-center gap-3">
							<span x-show="view === 'list'">
								<span x-text="filesystems.length"></span> { i18n.T(ctx, "filesystem(s)") }
							</span>
							<span x-show="view === 'browse'" x-cloak>
								<span x-text="sortedEntries.length"></span> { i18n.T(ctx, "item(s)") }
								<span x-show="selectedEntry" x-cloak class="ml-2 text-foreground font-medium">
									— <span x-text="selectedEntry?.name"></span>
									<span x-show="selectedEntry && !selectedEntry.is_dir" x-text="' (' + formatSize(selectedEntry?.size) + ')'"></span>
								</span>
							</span>
						</div>
						<div class="flex items-center gap-2">
							<span x-show="view === 'browse'" x-cloak class="font-mono" x-text="currentPath"></span>
							@dialog.Close() {
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "h-6 text-xs",
								}) {
									{ i18n.T(ctx, "Close") }
								}
							}
						</div>
					</div>
				}
				<!-- ═══════════════════════════════════════════════════════════ -->
				<!-- CONTEXT MENU                                               -->
				<!-- ═══════════════════════════════════════════════════════════ -->
				<div
					x-show="contextMenu.show"
					x-cloak
					@click.away="contextMenu.show = false"
					@contextmenu.prevent=""
					:style="'left:' + contextMenu.x + 'px; top:' + contextMenu.y + 'px'"
					class="fixed z-[100] min-w-[180px] rounded-md border bg-popover p-1 shadow-lg animate-in fade-in-0 zoom-in-95"
				>
					<!-- On a specific entry -->
					<template x-if="contextMenu.entry">
						<div>
							<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="clickEntry(contextMenu.entry); contextMenu.show = false">
								<template x-if="contextMenu.entry?.is_dir">
									@icon.FolderOpen(icon.Props{Class: "size-4 text-muted-foreground"})
								</template>
								<template x-if="!contextMenu.entry?.is_dir">
									@icon.ExternalLink(icon.Props{Class: "size-4 text-muted-foreground"})
								</template>
								<span x-text="contextMenu.entry?.is_dir ? 'Open' : 'Download'"></span>
							</button>
							<template x-if="!contextMenu.entry?.is_dir">
								<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="copyPath(contextMenu.entry); contextMenu.show = false">
									@icon.Copy(icon.Props{Class: "size-4 text-muted-foreground"})
									<span>{ i18n.T(ctx, "Copy Path") }</span>
								</button>
							</template>
							<template x-if="currentFS?.type === 'local'">
								<div>
									<div class="h-px bg-border my-1"></div>
									<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm text-destructive hover:bg-destructive/10" @click="deleteEntry(contextMenu.entry); contextMenu.show = false">
										@icon.Trash2(icon.Props{Class: "size-4"})
										<span>{ i18n.T(ctx, "Delete") }</span>
									</button>
								</div>
							</template>
						</div>
					</template>
					<!-- On blank area -->
					<template x-if="!contextMenu.entry">
						<div>
							<template x-if="currentFS?.type === 'local'">
								<div>
									<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="showMkdir = true; contextMenu.show = false; $nextTick(() => $refs.mkdirInput?.focus())">
										@icon.FolderPlus(icon.Props{Class: "size-4 text-muted-foreground"})
										<span>{ i18n.T(ctx, "New Folder") }</span>
									</button>
									<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="$refs.fileInput.click(); contextMenu.show = false">
										@icon.Upload(icon.Props{Class: "size-4 text-muted-foreground"})
										<span>{ i18n.T(ctx, "Upload Files") }</span>
									</button>
									<div class="h-px bg-border my-1"></div>
								</div>
							</template>
							<button class="flex items-center gap-2 w-full rounded-sm px-2 py-1.5 text-sm hover:bg-accent" @click="fetchEntries(); contextMenu.show = false">
								@icon.RefreshCw(icon.Props{Class: "size-4 text-muted-foreground"})
								<span>{ i18n.T(ctx, "Refresh") }</span>
							</button>
						</div>
					</template>
				</div>
			</div>
			}
		}
	</div>
}

// ─── Browse Content (shared between local and github file areas) ─────────────
templ fileBrowseContent() {
	<!-- Loading Skeleton -->
	<div x-show="browseLoading" class="px-4 py-4 space-y-1">
		<template x-for="i in 6" :key="i">
			@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-full rounded"})
		</template>
	</div>
	<!-- Empty Directory -->
	<div x-show="!browseLoading && sortedEntries.length === 0" x-cloak class="text-center py-16">
		<div class="inline-flex items-center justify-center size-14 rounded-full bg-muted mb-3">
			@icon.FolderOpen(icon.Props{Class: "size-7 text-muted-foreground/50"})
		</div>
		<p class="text-sm text-muted-foreground font-medium">{ i18n.T(ctx, "This folder is empty") }</p>
		<p class="text-xs text-muted-foreground mt-1" x-show="currentFS?.type === 'local'">
			{ i18n.T(ctx, "Drag and drop files or use the upload button") }
		</p>
	</div>
	<!-- ── LIST VIEW ──────────────────────────────────────────── -->
	<div x-show="!browseLoading && sortedEntries.length > 0 && viewMode === 'list'" x-cloak>
		<!-- Column Header -->
		<div class="grid grid-cols-[1fr_100px_160px_40px] gap-2 px-4 py-1.5 text-[11px] font-medium text-muted-foreground uppercase tracking-wider border-b bg-muted/20 select-none sticky top-0 z-10">
			<button class="flex items-center gap-1 hover:text-foreground text-left" @click="setSortBy('name')">
				{ i18n.T(ctx, "Name") }
				<span x-show="sortBy === 'name'" class="text-primary">
					<template x-if="sortDir === 'asc'">@icon.ChevronUp(icon.Props{Class: "size-3"})
</template>
					<template x-if="sortDir === 'desc'">@icon.ChevronDown(icon.Props{Class: "size-3"})
</template>
				</span>
			</button>
			<button class="flex items-center gap-1 hover:text-foreground text-right justify-end" @click="setSortBy('size')">
				{ i18n.T(ctx, "Size") }
				<span x-show="sortBy === 'size'" class="text-primary">
					<template x-if="sortDir === 'asc'">@icon.ChevronUp(icon.Props{Class: "size-3"})
</template>
					<template x-if="sortDir === 'desc'">@icon.ChevronDown(icon.Props{Class: "size-3"})
</template>
				</span>
			</button>
			<button class="flex items-center gap-1 hover:text-foreground text-right justify-end" @click="setSortBy('date')">
				{ i18n.T(ctx, "Modified") }
				<span x-show="sortBy === 'date'" class="text-primary">
					<template x-if="sortDir === 'asc'">@icon.ChevronUp(icon.Props{Class: "size-3"})
</template>
					<template x-if="sortDir === 'desc'">@icon.ChevronDown(icon.Props{Class: "size-3"})
</template>
				</span>
			</button>
			<div></div>
		</div>
		<!-- Entries -->
		<div class="divide-y divide-border/30">
			<template x-for="entry in sortedEntries" :key="entry.name">
				<div
					class="grid grid-cols-[1fr_100px_160px_40px] gap-2 items-center px-4 py-2 hover:bg-accent/50 transition-colors cursor-pointer group"
					:class="selectedEntry?.name === entry.name ? 'bg-primary/5 border-l-2 border-l-primary' : 'border-l-2 border-l-transparent'"
					@click.stop="selectedEntry = entry"
					@dblclick="clickEntry(entry)"
					@contextmenu.prevent.stop="openContextMenu($event, entry)"
				>
					<!-- Name + Icon -->
					<div class="flex items-center gap-3 min-w-0">
						<div class="shrink-0 flex items-center justify-center size-7">
							<template x-if="entry.is_dir">
								<span class="text-yellow-500" x-html="getFolderIconSvg()"></span>
							</template>
							<template x-if="!entry.is_dir">
								<span x-html="getFileIcon(entry.name)"></span>
							</template>
						</div>
						<span class="truncate text-sm" x-text="entry.name"></span>
					</div>
					<!-- Size -->
					<div class="text-xs text-muted-foreground text-right tabular-nums">
						<span x-show="!entry.is_dir" x-text="formatSize(entry.size)"></span>
						<span x-show="entry.is_dir" class="text-muted-foreground/40">—</span>
					</div>
					<!-- Modified -->
					<div class="text-xs text-muted-foreground text-right tabular-nums" x-text="formatDate(entry.mod_time)"></div>
					<!-- Actions -->
					<div class="flex items-center justify-end opacity-0 group-hover:opacity-100 transition-opacity">
						<template x-if="currentFS?.type === 'local'">
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Class:   "size-6 text-destructive hover:text-destructive",
								Attributes: templ.Attributes{
									"@click.stop": "deleteEntry(entry)",
									"title":       i18n.T(ctx, "Delete"),
								},
							}) {
								@icon.Trash2(icon.Props{Class: "size-3.5"})
							}
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
	<!-- ── GRID VIEW ──────────────────────────────────────────── -->
	<div x-show="!browseLoading && sortedEntries.length > 0 && viewMode === 'grid'" x-cloak class="p-4">
		<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-2">
			<template x-for="entry in sortedEntries" :key="entry.name">
				<div
					class="flex flex-col items-center p-3 rounded-lg hover:bg-accent/50 transition-colors cursor-pointer group select-none"
					:class="selectedEntry?.name === entry.name ? 'bg-primary/10 ring-1 ring-primary/30' : ''"
					@click.stop="selectedEntry = entry"
					@dblclick="clickEntry(entry)"
					@contextmenu.prevent.stop="openContextMenu($event, entry)"
				>
					<!-- Large Icon -->
					<div class="flex items-center justify-center size-12 mb-2">
						<template x-if="entry.is_dir">
							<span class="text-yellow-500" x-html="getFolderIconSvg(true)"></span>
						</template>
						<template x-if="!entry.is_dir">
							<span x-html="getFileIcon(entry.name, true)"></span>
						</template>
					</div>
					<!-- Name -->
					<span class="text-xs text-center line-clamp-2 w-full leading-tight" x-text="entry.name"></span>
					<!-- Size (files only) -->
					<span x-show="!entry.is_dir" class="text-[10px] text-muted-foreground mt-0.5" x-text="formatSize(entry.size)"></span>
				</div>
			</template>
		</div>
	</div>
}
