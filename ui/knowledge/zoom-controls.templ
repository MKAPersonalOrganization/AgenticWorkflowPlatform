package knowledge

import (
	"aicompass/components/icon"
	"aicompass/components/separator"
	"aicompass/components/tooltip"
)

/**
 * ZoomControls - Zoom in/out/rotate/fit/fullscreen buttons for the graph.
 * Matches EdgeQuake edgequake_webui/src/components/graph/zoom-controls.tsx
 *
 * Positioned absolute top-right of the graph container.
 * Each button wrapped in tooltip with keyboard hint.
 */

templ ZoomControls() {
	<div
		class="absolute top-4 end-4 z-20 flex flex-col gap-1 bg-background/95 backdrop-blur-sm rounded-lg border border-border/50 shadow-lg p-1 hover:shadow-xl transition-shadow duration-200"
		role="toolbar"
		aria-label="Graph controls"
		data-tour="zoom-controls"
	>
		<!-- Zoom In -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				<button
					@click="graphZoomIn()"
					class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
					aria-label="Zoom In"
				>
					@icon.ZoomIn(icon.Props{Class: "size-4"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
				<div class="flex items-center gap-2">
					<span>Zoom In</span>
					<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-background/20 rounded border border-background/10">+</kbd>
				</div>
			}
		}
		<!-- Zoom Out -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				<button
					@click="graphZoomOut()"
					class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
					aria-label="Zoom Out"
				>
					@icon.ZoomOut(icon.Props{Class: "size-4"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
				<div class="flex items-center gap-2">
					<span>Zoom Out</span>
					<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-background/20 rounded border border-background/10">-</kbd>
				</div>
			}
		}
		@separator.Separator(separator.Props{Class: "my-1"})
		<!-- Rotate CW -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				<button
					@click="graphRotateCW()"
					class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
					aria-label="Rotate Clockwise"
				>
					@icon.RotateCw(icon.Props{Class: "size-4"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
				Rotate Clockwise
			}
		}
		<!-- Rotate CCW -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				<button
					@click="graphRotateCCW()"
					class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
					aria-label="Rotate Counter-Clockwise"
				>
					@icon.RotateCcw(icon.Props{Class: "size-4"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
				Rotate Counter-Clockwise
			}
		}
		@separator.Separator(separator.Props{Class: "my-1"})
		<!-- Focus on Node (Only if selected) -->
		<template x-if="selectedNodeId">
			@tooltip.Tooltip() {
				@tooltip.Trigger(tooltip.TriggerProps{}) {
					<button
						@click="graphFocusOnNode()"
						class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
						aria-label="Focus on Selected Node"
					>
						@icon.Focus(icon.Props{Class: "size-4"})
					</button>
				}
				@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
					<div class="flex items-center gap-2">
						<span>Focus on Selected</span>
						<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-background/20 rounded border border-background/10">Enter</kbd>
					</div>
				}
			}
		</template>
		<!-- Reset View -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				<button
					@click="graphResetCamera()"
					class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
					aria-label="Reset View"
				>
					@icon.Maximize(icon.Props{Class: "size-4"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
				<div class="flex items-center gap-2">
					<span>Reset View</span>
					<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-background/20 rounded border border-background/10">0</kbd>
				</div>
			}
		}
		<!-- Fullscreen Toggle -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				<button
					@click="graphToggleFullscreen()"
					class="h-8 w-8 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted text-muted-foreground hover:text-foreground"
					:aria-label="isFullscreen ? 'Exit Fullscreen' : 'Fullscreen'"
				>
					<template x-if="!isFullscreen">
						@icon.Expand(icon.Props{Class: "size-4"})
					</template>
					<template x-if="isFullscreen">
						@icon.Shrink(icon.Props{Class: "size-4"})
					</template>
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft}) {
				<div class="flex items-center gap-2">
					<span x-text="isFullscreen ? 'Exit Fullscreen' : 'Fullscreen'"></span>
					<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-background/20 rounded border border-background/10">F</kbd>
				</div>
			}
		}
	</div>
}
