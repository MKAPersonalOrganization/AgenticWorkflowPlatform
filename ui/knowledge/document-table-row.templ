package knowledge

import "aicompass/ui/i18n"

/**
 * DocumentTableRow - Single document row in the documents table.
 * Matches EdgeQuake edgequake_webui/src/components/documents/document-table-row.tsx
 *
 * Displays Lucide file-type icon with color, title with search highlighting, status badge,
 * entity count, cost, relative date (with "NEW" indicator), error popover for failures,
 * and action buttons.
 */

templ DocumentTableRow() {
	<tr
		class="border-b transition-colors duration-150 cursor-pointer hover:bg-primary/5 dark:hover:bg-primary/10"
		:class="{
			'bg-primary/10 dark:bg-primary/15 ring-1 ring-primary/20': previewDoc?.id === doc.id,
			'bg-background': index % 2 === 0 && previewDoc?.id !== doc.id,
			'bg-muted/20': index % 2 !== 0 && previewDoc?.id !== doc.id,
			'bg-red-50/50 dark:bg-red-950/20 border-s-4 border-s-red-500': doc.status === 'failed',
			'bg-orange-50/50 dark:bg-orange-950/20 border-s-4 border-s-orange-500': doc.status === 'partial_failure',
		}"
		@click="openDocumentPreview(doc)"
		@dblclick="detailDoc = doc; window.tui.dialog.open('document-detail-dialog')"
	>
		<!-- Checkbox -->
		<td class="p-3 align-middle" @click.stop>
			<input
				type="checkbox"
				class="rounded border-input text-primary focus:ring-primary size-3.5"
				:value="doc.id"
				x-model="selectedDocs"
				:disabled="!isTerminalStatus(doc.status)"
				aria-label="Select"
			/>
		</td>
		<!-- Title with file type icon -->
		<td class="p-3 align-middle font-medium">
			<div class="flex flex-col gap-0.5">
				<div class="flex items-center gap-2">
					<span x-html="fileTypeIconSvg(doc.file_name)" class="flex-shrink-0"></span>
					<span class="truncate max-w-xs" x-html="highlightSearch(doc.title || doc.file_name || ('Document ' + doc.id.slice(0, 8)), docSearch)"></span>
					<!-- NEW indicator -->
					<span
						x-show="isNewDocument(doc.created_at)"
						x-cloak
						class="text-xs font-medium text-green-600 dark:text-green-400 animate-pulse"
					>NEW</span>
				</div>
				<!-- Error message popover -->
				<template x-if="(doc.status === 'failed' || doc.status === 'partial_failure') && doc.error_message">
					<div class="relative" x-data="{ showError: false }">
						<button
							@click.stop="showError = !showError"
							class="text-xs text-red-500 truncate max-w-xs cursor-pointer hover:underline flex items-center gap-1"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="size-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
							<span x-text="doc.error_message" class="truncate"></span>
						</button>
						<div
							x-show="showError"
							x-cloak
							@click.outside="showError = false"
							x-transition
							class="absolute start-0 top-full z-50 mt-1 w-72 rounded-lg border bg-popover p-3 shadow-md"
						>
							<p class="text-xs text-popover-foreground mb-2 break-words" x-text="doc.error_message"></p>
							<button
								@click.stop="reprocessDocument(doc.id); showError = false"
								class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium hover:bg-accent transition-colors"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
								{ i18n.T(ctx, "Retry") }
							</button>
						</div>
					</div>
				</template>
			</div>
		</td>
		<!-- Status Badge -->
		<td class="p-3 align-middle">
			<div class="flex flex-col gap-1">
				<span
					class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-xs font-medium cursor-default"
					:class="statusBadgeClass(doc.current_stage || doc.status)"
				>
					<span x-text="stageIcon(doc.current_stage || doc.status)"></span>
					<span x-text="statusLabel(doc.current_stage || doc.status)"></span>
				</span>
				<!-- Stage progress bar -->
				<div x-show="doc.stage_progress > 0 && doc.stage_progress < 100" class="h-1 w-24 bg-secondary rounded-full overflow-hidden">
					<div class="h-full bg-primary transition-all duration-300" :style="`width: ${doc.stage_progress}%`"></div>
				</div>
				<!-- Stage message for conversion progress -->
				<span x-show="doc.stage_message && doc.current_stage === 'converting'" class="text-[10px] text-muted-foreground truncate" x-text="doc.stage_message"></span>
				<!-- Processing duration -->
				<span x-show="doc.processing_duration_seconds > 0 && isTerminalStatus(doc.status)" class="text-[10px] text-muted-foreground" x-text="formatDuration(doc.processing_duration_seconds)"></span>
			</div>
		</td>
		<!-- Entities -->
		<td class="p-3 align-middle text-center text-muted-foreground" x-text="doc.entity_count ?? doc.chunk_count ?? '-'"></td>
		<!-- Cost -->
		<td class="p-3 align-middle text-center">
			<span class="text-muted-foreground font-mono text-xs" x-text="doc.cost_usd ? ('$' + doc.cost_usd.toFixed(4)) : '-'"></span>
		</td>
		<!-- Created -->
		<td class="p-3 align-middle text-muted-foreground">
			<span x-text="timeAgo(doc.created_at)"></span>
		</td>
		<!-- Actions -->
		<td class="p-3 align-middle" @click.stop>
			@DocumentActionsMenu()
		</td>
	</tr>
}
