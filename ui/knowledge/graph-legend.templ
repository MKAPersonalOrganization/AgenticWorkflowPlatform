package knowledge

/**
 * GraphLegend - Entity type legend with visibility toggles.
 * Matches EdgeQuake edgequake_webui/src/components/graph/graph-legend.tsx
 *
 * Positioned absolute bottom-left of graph container.
 * Shows color-coded entity type pills with count badges and visibility toggles.
 */

import (
	"aicompass/components/badge"
	"aicompass/ui/i18n"
	"aicompass/components/icon"
)

templ GraphLegend() {
	<div x-data="{ expanded: false }" class="absolute bottom-4 start-4 z-20">
		<!-- Legend button (when collapsed) -->
		<template x-if="!expanded">
			<button
				@click="expanded = true"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-all duration-200 bg-background/90 backdrop-blur-sm shadow-md hover:shadow-lg border border-border/50 h-10 w-10"
				aria-label={ i18n.T(ctx, "Show entity type legend") }
				title={ i18n.T(ctx, "Show Legend") }
			>
				@icon.Palette(icon.Props{Class: "size-4"})
			</button>
		</template>
		<!-- Legend Card (when expanded) -->
		<div
			x-show="expanded"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			class="w-80 shadow-xl bg-background/95 backdrop-blur-sm border border-border/50 rounded-lg overflow-hidden flex flex-col max-h-[calc(100vh-8rem)]"
			role="region"
			aria-label={ i18n.T(ctx, "Entity Types") }
			x-cloak
		>
			<!-- Header -->
			<div class="py-3 px-4 border-b flex items-center justify-between shrink-0">
				<div class="flex items-center gap-2.5">
					<div class="text-sm font-semibold flex items-center gap-2.5">
						@icon.Palette(icon.Props{Class: "size-4 text-muted-foreground"})
						<span>{ i18n.T(ctx, "Entity Types") }</span>
					</div>
				</div>
				<button
					@click="expanded = false"
					class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-7 w-7 -me-1 shrink-0"
					aria-label={ i18n.T(ctx, "Collapse legend") }
					title={ i18n.T(ctx, "Collapse") }
				>
					@icon.EyeOff(icon.Props{Class: "size-4"})
				</button>
			</div>
			<!-- List content -->
			<div class="flex-1 overflow-y-auto custom-scrollbar min-h-0">
				<div class="p-3 space-y-1" role="list" aria-label={ i18n.T(ctx, "Entity type visibility controls") }>
					<template x-for="stat in graphGetTypeStats()" :key="stat.type">
						<button
							@click="toggleEntityType(stat.type)"
							role="listitem"
							class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all hover:bg-muted/70 active:bg-muted focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
							:class="graphVisibleTypes.includes(stat.type) ? 'opacity-100' : 'opacity-40'"
							:aria-pressed="graphVisibleTypes.includes(stat.type).toString()"
							:aria-label="stat.label + ': ' + stat.count + ' entities. ' + (graphVisibleTypes.includes(stat.type) ? 'Click to hide' : 'Click to show')"
						>
							<div
								class="w-3.5 h-3.5 rounded-full shrink-0 ring-2 ring-background shadow-sm"
								:style="{ backgroundColor: stat.color }"
							></div>
							<span class="flex-1 text-start font-medium leading-tight truncate min-w-0" x-text="stat.label"></span>
							@badge.Badge(badge.Props{
								Variant: badge.VariantSecondary,
								Class:   "h-5 px-2 text-[10px] font-semibold tabular-nums shrink-0",
							}) {
								<span x-text="stat.count"></span>
							}
							<template x-if="graphVisibleTypes.includes(stat.type)">
								@icon.Eye(icon.Props{Class: "size-4 text-primary/70 shrink-0"})
							</template>
							<template x-if="!graphVisibleTypes.includes(stat.type)">
								@icon.EyeOff(icon.Props{Class: "size-4 text-muted-foreground shrink-0"})
							</template>
						</button>
					</template>
				</div>
			</div>
			<!-- Footer / Show All -->
			<template x-if="graphData?.nodes?.some(n => !graphVisibleTypes.includes(n.node_type || 'UNKNOWN'))">
				<div class="p-3 pt-0 shrink-0">
					<button
						@click="showAllEntityTypes()"
						class="w-full h-9 inline-flex items-center justify-center rounded-md border border-input bg-background px-3 py-1 text-xs font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
					>
						<span>{ i18n.T(ctx, "Show All") }</span>
						<span class="ms-1 opacity-80" x-text="'(' + graphGetHiddenTypeCount() + ' hidden)'"></span>
					</button>
				</div>
			</template>
		</div>
	</div>
}
