package knowledge

/**
 * DocumentManager - Ingested documents tab, orchestrates all document sub-components.
 * Matches EdgeQuake edgequake_webui/src/components/documents/document-manager.tsx
 *
 * Composes: DocumentHeader, DocumentToolbarSection, DocumentTableSection,
 * PaginationControls, DocumentDetailDialog, DocumentPreviewPanel.
 */

import (
	"aicompass/ui/i18n"
	"aicompass/components/icon"
)

templ DocumentManager() {
	<div class="flex flex-col h-full overflow-hidden">
		<!-- Fixed header zone -->
		<div class="shrink-0 space-y-4 mt-4">
			<!-- Error alert for failed data loads -->
			<div
				x-show="docsError"
				x-cloak
				class="rounded-lg border border-destructive/50 bg-destructive/10 p-4 flex items-start gap-3"
			>
				@icon.CircleAlert(icon.Props{Class: "size-5 text-destructive flex-shrink-0 mt-0.5"})
				<div class="flex-1 min-w-0">
					<h4 class="text-sm font-medium text-destructive">{ i18n.T(ctx, "Error loading documents") }</h4>
					<p class="text-xs text-destructive/80 mt-1" x-text="docsError"></p>
				</div>
			</div>
			<!-- Document Header: title, count, pipeline status, refresh, retry, clear -->
			@DocumentHeader()
			<!-- Toolbar: search + filters row, pipeline summary, dropzone, batch bar, upload progress -->
			@DocumentToolbarSection()
		</div>
		<!-- Scrollable table area -->
		<div class="flex-1 overflow-auto mt-4">
			<!-- Main table + pagination -->
			@DocumentTableSection()
			<!-- Empty state -->
			<div x-show="!docsLoading && filteredDocuments.length === 0" x-cloak class="flex flex-col items-center justify-center py-20 text-center">
				@icon.FileText(icon.Props{Class: "size-10 text-muted-foreground mb-4"})
				<h3 class="text-lg font-semibold">
					<span x-show="docStatusFilter" x-text="'No ' + docStatusFilter + ' documents'"></span>
					<span x-show="!docStatusFilter">{ i18n.T(ctx, "No ingested content yet") }</span>
				</h3>
				<p class="text-sm text-muted-foreground">
					<span x-show="docStatusFilter">
						<button @click="filterByStatus('')" class="text-primary hover:underline">{ i18n.T(ctx, "View all documents") }</button>
					</span>
					<span x-show="!docStatusFilter">{ i18n.T(ctx, "Content will appear here once your files are processed.") }</span>
				</p>
			</div>
		</div>
	</div>
}
