package knowledge

/**
 * NodeDetails - Right sidebar panel showing selected node details.
 * Matches EdgeQuake edgequake_webui/src/components/graph/node-details.tsx
 *
 * Shows: Color dot + label (with copy), type badge, description, metadata (ID, degree, created_at),
 * expandable properties with copy, relationships list with direction arrows + clickable.
 * Panel is resizable via drag handle.
 */

import (
	"aicompass/components/badge"
	"aicompass/components/icon"
	"aicompass/components/separator"
	"aicompass/components/tooltip"
)

templ NodeDetails() {
	<div
		x-show="selectedNode"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 w-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0 w-0"
		class="border-s bg-background overflow-y-auto flex-shrink-0 relative flex flex-col"
		:style="`width: ${_nodeDetailsPanelWidth || 320}px`"
	>
		<!-- Resize handle -->
		<div
			class="absolute start-0 top-0 bottom-0 w-1 cursor-col-resize hover:bg-primary/30 transition-colors z-20"
			@mousedown.prevent="_startPanelResize($event)"
		></div>
		<!-- Sticky header -->
		<div class="sticky top-0 z-10 bg-background/95 backdrop-blur-sm border-b px-4 py-3 shrink-0">
			<div class="flex items-start justify-between gap-2">
				<div class="space-y-1 flex-1 min-w-0">
					<div class="flex items-center gap-2">
						<div
							class="w-2.5 h-2.5 rounded-full shrink-0 ring-2 ring-background shadow-sm"
							:style="`background-color: ${entityColors[selectedNode?.node_type] || '#6b7280'}`"
						></div>
						<h4 class="text-sm font-semibold truncate" x-text="selectedNode?.label"></h4>
						@tooltip.Tooltip() {
							@tooltip.Trigger(tooltip.TriggerProps{}) {
								<button
									@click="navigator.clipboard.writeText(selectedNode?.label || '')"
									class="h-5 w-5 inline-flex items-center justify-center rounded-md hover:bg-muted/80 transition-colors shrink-0"
								>
									@icon.Copy(icon.Props{Class: "size-3 text-muted-foreground"})
								</button>
							}
							@tooltip.Content(tooltip.ContentProps{}) {
								Copy label
							}
						}
					</div>
					@badge.Badge(badge.Props{
						Variant: badge.VariantOutline,
						Class:   "text-[10px] font-medium px-2 py-0.5",
						Attributes: templ.Attributes{
							":style": "`border-color: ${entityColors[selectedNode?.node_type] || '#6b7280'}; color: ${entityColors[selectedNode?.node_type] || '#6b7280'}; background-color: ${(entityColors[selectedNode?.node_type] || '#6b7280')}10`",
							"x-text": "selectedNode?.node_type || 'ENTITY'",
						},
					})
				</div>
				<button
					@click="selectedNode = null; selectedNodeEdges = []; _highlightSelectedNode(null)"
					class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-6 w-6 shrink-0"
				>
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</div>
		</div>
		<!-- Scrollable content -->
		<div class="flex-1 overflow-y-auto p-4 space-y-4 custom-scrollbar">
			<!-- Description -->
			<div x-show="selectedNode?.description" class="bg-muted/30 rounded-md p-2.5 border border-border/30">
				<div class="flex items-center gap-1.5 mb-1.5">
					@icon.Info(icon.Props{Class: "size-3 text-muted-foreground"})
					<h5 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">
						Description
					</h5>
				</div>
				<p class="text-xs leading-relaxed text-foreground/90 break-words" x-text="selectedNode?.description"></p>
			</div>
			<!-- Properties -->
			<div x-show="getNodeProperties() && Object.keys(getNodeProperties()).length > 0">
				<div class="flex items-center justify-between mb-2">
					<div class="flex items-center gap-1.5">
						@icon.Sparkles(icon.Props{Class: "size-3 text-muted-foreground"})
						<h5 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">
							Properties
						</h5>
					</div>
					<button
						@click="navigator.clipboard.writeText(JSON.stringify(getNodeProperties(), null, 2))"
						class="inline-flex items-center gap-1 text-[9px] px-1.5 py-0.5 rounded-md hover:bg-muted transition-colors text-muted-foreground"
					>
						@icon.Copy(icon.Props{Class: "size-2.5"})
						Copy All
					</button>
				</div>
				<div class="bg-muted/20 rounded-md p-1.5 space-y-0.5 border border-border/20">
					<template x-for="[key, val] in Object.entries(getNodeProperties())" :key="key">
						<div class="flex justify-between text-xs gap-2 group py-1.5 min-w-0 px-1 border-b border-border/10 last:border-0 hover:bg-muted/30 rounded-sm">
							<span class="text-muted-foreground shrink-0 text-[11px] font-mono" x-text="key"></span>
							<div class="flex items-center gap-1 min-w-0 flex-1 justify-end">
								<span
									class="font-mono text-[10px] bg-background/50 px-1.5 py-0.5 rounded transition-all truncate cursor-pointer hover:bg-muted"
									x-text="String(val)"
									@click="$el.classList.toggle('truncate'); $el.classList.toggle('whitespace-pre-wrap')"
									:title="String(val)"
								></span>
								<button
									@click="navigator.clipboard.writeText(String(val))"
									class="h-5 w-5 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity inline-flex items-center justify-center rounded-md hover:bg-muted"
								>
									@icon.Copy(icon.Props{Class: "size-2.5 text-muted-foreground"})
								</button>
							</div>
						</div>
					</template>
				</div>
			</div>
			<!-- Metadata -->
			<div>
				<div class="flex items-center gap-1.5 mb-2">
					@icon.Hash(icon.Props{Class: "size-3 text-muted-foreground"})
					<h5 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">
						Metadata
					</h5>
				</div>
				<div class="bg-muted/20 rounded-md p-2.5 space-y-2 border border-border/20">
					<div class="flex items-center justify-between gap-2 text-xs">
						<span class="text-muted-foreground flex items-center gap-1">
							@icon.Hash(icon.Props{Class: "size-2.5"})
							ID
						</span>
						<div class="flex items-center gap-1">
							<span class="font-mono text-[10px] bg-background/50 px-1.5 py-0.5 rounded" x-text="selectedNode?.id?.substring(0, 10) + '...'"></span>
							<button @click="navigator.clipboard.writeText(selectedNode?.id || '')" class="h-4 w-4 inline-flex items-center justify-center rounded-md hover:bg-muted">
								@icon.Copy(icon.Props{Class: "size-2.5 text-muted-foreground"})
							</button>
						</div>
					</div>
					<div class="flex items-center justify-between text-xs">
						<span class="text-muted-foreground flex items-center gap-1">
							@icon.Link2(icon.Props{Class: "size-2.5"})
							Connections
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "h-4 text-[9px] font-semibold px-1.5"}) {
							<span x-text="selectedNode?.degree || 0"></span>
						}
					</div>
					<div x-show="selectedNode?.created_at" class="flex items-center justify-between text-xs">
						<span class="text-muted-foreground flex items-center gap-1">
							@icon.Calendar(icon.Props{Class: "size-2.5"})
							Created
						</span>
						<span class="text-[10px] font-medium" x-text="selectedNode?.created_at ? new Date(selectedNode.created_at).toLocaleDateString() : ''"></span>
					</div>
				</div>
			</div>
			@separator.Separator(separator.Props{Class: "my-1"})
			<!-- Relationships -->
			<div>
				<div class="flex items-center justify-between mb-2">
					<div class="flex items-center gap-1.5">
						@icon.Link2(icon.Props{Class: "size-3 text-muted-foreground"})
						<h5 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">
							Relationships
						</h5>
					</div>
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "h-4 text-[9px] font-semibold px-1.5"}) {
						<span x-text="selectedNodeEdges.length"></span>
					}
				</div>
				<div class="bg-muted/20 rounded-md border border-border/20 overflow-hidden">
					<div class="max-h-[200px] overflow-y-auto p-1.5 space-y-1 custom-scrollbar">
						<template x-if="selectedNodeEdges.length === 0">
							<p class="text-[10px] text-muted-foreground text-center py-4">No connections found</p>
						</template>
						<template x-for="edge in selectedNodeEdges" :key="(edge.source || '') + '-' + (edge.target || '') + '-' + (edge.edge_type || '')">
							<div
								@click="focusNode(edge.source === selectedNode?.id ? edge.target : edge.source)"
								class="flex items-center gap-2 text-[10px] cursor-pointer hover:bg-muted/70 p-2 rounded-md transition-all group border border-transparent hover:border-border/30 bg-background/50"
							>
								<div class="flex items-center shrink-0">
									<template x-if="edge.source === selectedNode?.id">
										<span class="text-blue-500">@icon.ArrowRight(icon.Props{Class: "size-3"})
</span>
									</template>
									<template x-if="edge.source !== selectedNode?.id">
										<span class="text-green-500">@icon.ArrowLeft(icon.Props{Class: "size-3"})
</span>
									</template>
								</div>
								<div class="inline-flex items-center rounded-md border border-transparent bg-secondary px-1.5 py-0.5 text-[9px] font-semibold transition-colors shrink-0 max-w-[80px] truncate" x-text="edge.edge_type"></div>
								<div class="flex items-center gap-1.5 flex-1 min-w-0">
									<div
										class="w-2 h-2 rounded-full shrink-0"
										:style="`background-color: ${entityColors[getNodeLabel(edge.source === selectedNode?.id ? edge.target : edge.source)] || '#6b7280'}`"
									></div>
									<span class="truncate font-medium group-hover:underline" x-text="getNodeLabel(edge.source === selectedNode?.id ? edge.target : edge.source)"></span>
								</div>
								@icon.ExternalLink(icon.Props{Class: "size-2.5 text-muted-foreground opacity-0 group-hover:opacity-100 shrink-0 transition-opacity"})
							</div>
						</template>
					</div>
				</div>
			</div>
			@separator.Separator(separator.Props{Class: "my-1"})
			<!-- Actions -->
			<div class="flex gap-1.5 pt-1 pb-4">
				@tooltip.Tooltip() {
					@tooltip.Trigger(tooltip.TriggerProps{}) {
						<button class="flex-1 inline-flex items-center justify-center gap-1 rounded-md border border-input bg-background h-7 text-[10px] font-medium shadow-sm transition-colors hover:bg-primary/10 hover:border-primary/50">
							@icon.Pencil(icon.Props{Class: "size-3"})
							Edit
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{}) {
						Edit entity details
					}
				}
				@tooltip.Tooltip() {
					@tooltip.Trigger(tooltip.TriggerProps{}) {
						<button class="flex-1 inline-flex items-center justify-center gap-1 rounded-md border border-input bg-background h-7 text-[10px] font-medium shadow-sm transition-colors hover:bg-purple-500/10 hover:border-purple-500/50">
							@icon.GitMerge(icon.Props{Class: "size-3"})
							Merge
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{}) {
						Merge with another entity
					}
				}
				@tooltip.Tooltip() {
					@tooltip.Trigger(tooltip.TriggerProps{}) {
						<button @click="deleteGraphEntity(selectedNode.id, selectedNode.label)" class="flex-1 inline-flex items-center justify-center gap-1 rounded-md border border-input bg-background h-7 text-[10px] font-medium shadow-sm transition-colors text-destructive hover:bg-destructive/10 hover:border-destructive/50">
							@icon.Trash2(icon.Props{Class: "size-3"})
							Delete
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{}) {
						Delete this entity
					}
				}
			</div>
		</div>
	</div>
}
