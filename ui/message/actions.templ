package message

import "aicompass/components/button"
import "aicompass/components/icon"
import "aicompass/components/utils"
import "aicompass/components/tooltip"
import "aicompass/ui/i18n"

type ActionProps struct {
	MessageID string
	Role      string // "user" or "assistant"
	IsLast    bool   // To conditionally show "Regenerate"
}

// HoverButton - LibreChat style hover button
func getHoverButtonClass(isActive bool, isLast bool, extra string) string {
	base := "hover-button rounded-lg p-1.5 text-muted-foreground hover:text-foreground hover:bg-accent/50 md:group-hover/message:visible md:group-focus-within/message:visible focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
	if !isLast {
		base += " md:opacity-0 md:group-hover/message:opacity-100 md:group-focus-within/message:opacity-100"
	}
	if isActive {
		base += " text-foreground bg-accent/50"
	}
	if extra != "" {
		base += " " + extra
	}
	return base
}

templ HoverButton(props struct {
	ID       string
	OnClick  string
	Title    string
	IsActive bool
	IsLast   bool
	Class    string
}) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getHoverButtonClass(props.IsActive, props.IsLast, props.Class) }
		@click={ props.OnClick }
		type="button"
		title={ props.Title }
	>
		{ children... }
	</button>
}

templ Actions(props ActionProps) {
	<div
		class={ utils.TwMerge(
            "group visible flex justify-center gap-0.5 self-end focus-within:outline-none lg:justify-start",
            // Opacity transitions for non-last messages
            "transition-opacity duration-200",
        ) }
		x-data="{ isCopied: false }"
	>


		if props.Role == "assistant" {
			<!-- Copy Button -->
			@tooltip.Tooltip() {
				@tooltip.Trigger(tooltip.TriggerProps{}) {
					@button.Button(button.Props{
						Size:    button.SizeIcon,
						Variant: button.VariantGhost,
						Class:   "hover-button rounded-lg p-1.5 text-muted-foreground hover:text-foreground hover:bg-accent/50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none transition-all",
						Attributes: templ.Attributes{
							"@click":     "copyMessage(" + props.MessageID + "); isCopied = true; setTimeout(() => isCopied = false, 2000)",
							"aria-label": i18n.T(ctx, "Copy to clipboard"),
						},
					}) {
						<template x-if="!isCopied">
							@icon.Copy(icon.Props{Class: "size-[18px]"})
						</template>
						<template x-if="isCopied">
							@icon.Check(icon.Props{Class: "size-[18px] text-green-500"})
						</template>
					}
				}
				@tooltip.Content(tooltip.ContentProps{Class: "text-xs"}) {
					<span x-text={ "isCopied ? '" + i18n.T(ctx, "Copied!") + "' : '" + i18n.T(ctx, "Copy to clipboard") + "'" }></span>
				}
			}
		}
	</div>
}
