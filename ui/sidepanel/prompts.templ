package sidepanel

import (
	"aicompass/components/button"
	"aicompass/ui/i18n"
	"aicompass/components/icon"
	"aicompass/components/input"
)

templ Prompts() {
	<div class="flex flex-col h-full bg-background text-foreground" x-data="{ promptFilter: '' }">
		<!-- Filter/Search -->
		<div class="px-3 py-2 border-b border-border/40">
			@input.Input(input.Props{
				ID:          "prompts-filter",
				Type:        "text",
				Placeholder: i18n.T(ctx, "Search prompts..."),
				Class:       "h-8 text-xs bg-muted/40 border-transparent focus:border-ring focus:bg-background transition-all",
				Attributes: templ.Attributes{
					"aria-label": i18n.T(ctx, "Search prompts"),
					"x-model":    "promptFilter",
				},
			})
		</div>
		<!-- Prompts List -->
		<div class="flex-1 overflow-y-auto custom-scrollbar p-2">
			<div class="space-y-1">
				<template x-for="(prompt, index) in prompts.filter(p => p.command.includes(promptFilter) || p.description.toLowerCase().includes(promptFilter.toLowerCase()))" :key="index">
					<div class="group flex flex-col gap-2 rounded-lg border border-border/40 bg-background p-3 hover:bg-muted/30 transition-all shadow-sm">
						<div class="flex items-start justify-between gap-2">
							<div class="flex items-center gap-2 min-w-0">
								<div class="p-1.5 rounded-md bg-primary/10 text-primary shrink-0">
									@icon.Command(icon.Props{Class: "size-3.5"})
								</div>
								<span class="font-medium text-sm truncate" x-text="prompt.command"></span>
							</div>
							<!-- Use Button -->
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantGhost,
								Class:   "h-6 px-2 text-[10px] uppercase tracking-wider text-muted-foreground hover:text-primary hover:bg-primary/10",
								Attributes: templ.Attributes{
									"@click": "selectPrompt(prompt)",
								},
							}) {
								<span>{ i18n.T(ctx, "Use") }</span>
							}
						</div>
						<p class="text-xs text-muted-foreground line-clamp-2" x-text="prompt.description"></p>
						<!-- Preview of content logic could go here but might be too verbose -->
					</div>
				</template>
				<div
					x-show="prompts.filter(p => p.command.includes(promptFilter) || p.description.toLowerCase().includes(promptFilter.toLowerCase())).length === 0"
					class="px-4 py-8 text-center text-muted-foreground text-xs"
					style="display: none;"
				>
					{ i18n.T(ctx, "No prompts match your search.") }
				</div>
			</div>
		</div>
	</div>
}
