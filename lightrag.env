# =============================================================================
# LightRAG Environment Configuration
# =============================================================================

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621

###########################
### Storage — PostgreSQL for all backends
###########################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

# PostgreSQL connection (matches lightrag-postgres in docker-compose)
POSTGRES_HOST=lightrag-postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DATABASE=rag
POSTGRES_MAX_CONNECTIONS=12

# Vector index
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

###########################
### LLM Configuration
###########################
LLM_BINDING=openai
LLM_MODEL=gpt-4o
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=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
OPENAI_LLM_MAX_COMPLETION_TOKENS=9000

###########################
### Embedding Configuration
###########################
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_SEND_DIM=false
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=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

###########################
### Query / Indexing
###########################
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
RERANK_BINDING=null
