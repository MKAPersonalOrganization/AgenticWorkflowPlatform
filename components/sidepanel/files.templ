package sidepanel

import (
	"aicompass/components/i18n"
	"aicompass/components/icon"
	"aicompass/components/input"
)

templ Files() {
	<div class="flex flex-col h-full bg-background text-foreground">
		<!-- Filter/Search -->
		<div class="px-3 py-2 border-b border-border/40">
			@input.Input(input.Props{
				ID:          "files-filter",
				Type:        "text",
				Placeholder: i18n.T(ctx, "Filter files..."),
				Class:       "h-8 text-xs bg-muted/40 border-transparent focus:border-ring focus:bg-background transition-all",
				Attributes: templ.Attributes{
					"aria-label": i18n.T(ctx, "Filter files"),
				},
			})
		</div>
		<!-- Files List / Table -->
		<div class="flex-1 overflow-y-auto custom-scrollbar p-2">
			<div class="rounded-lg border border-border/40 overflow-hidden bg-background shadow-sm">
				<table class="w-full text-xs text-start">
					<thead class="bg-muted/40 font-medium text-muted-foreground">
						<tr>
							<th class="px-3 py-2 w-[55%]">{ i18n.T(ctx, "Name") }</th>
							<th class="px-3 py-2 w-[20%]">{ i18n.T(ctx, "Size") }</th>
							<th class="px-3 py-2 w-[25%]">{ i18n.T(ctx, "Date") }</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border/30">
						<!-- Mock File 1 -->
						<tr class="hover:bg-muted/30 transition-colors cursor-pointer group">
							<td class="px-3 py-2.5">
								<div class="flex items-center gap-2">
									<div class="p-1 rounded bg-blue-500/10 text-blue-500">
										@icon.FileText(icon.Props{Class: "size-3"})
									</div>
									<span class="truncate font-medium text-foreground">research_data_2024.csv</span>
								</div>
							</td>
							<td class="px-3 py-2.5 text-muted-foreground">2.4 MB</td>
							<td class="px-3 py-2.5 text-muted-foreground">Oct 24</td>
						</tr>
						<!-- Mock File 2 -->
						<tr class="hover:bg-muted/30 transition-colors cursor-pointer group">
							<td class="px-3 py-2.5">
								<div class="flex items-center gap-2">
									<div class="p-1 rounded bg-red-500/10 text-red-500">
										@icon.FileImage(icon.Props{Class: "size-3"})
									</div>
									<span class="truncate font-medium text-foreground">diagram_v2.png</span>
								</div>
							</td>
							<td class="px-3 py-2.5 text-muted-foreground">1.1 MB</td>
							<td class="px-3 py-2.5 text-muted-foreground">Nov 02</td>
						</tr>
						<!-- Mock File 3 -->
						<tr class="hover:bg-muted/30 transition-colors cursor-pointer group">
							<td class="px-3 py-2.5">
								<div class="flex items-center gap-2">
									<div class="p-1 rounded bg-orange-500/10 text-orange-500">
										@icon.FileKey(icon.Props{Class: "size-3"})
									</div>
									<span class="truncate font-medium text-foreground">notes.md</span>
								</div>
							</td>
							<td class="px-3 py-2.5 text-muted-foreground">12 KB</td>
							<td class="px-3 py-2.5 text-muted-foreground">Yesterday</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="mt-4 text-center">
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Showing 3 of 3 files") }</p>
			</div>
		</div>
	</div>
}
