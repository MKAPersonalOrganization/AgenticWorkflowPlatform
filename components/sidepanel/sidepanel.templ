package sidepanel

import (
	"school-with-ai/components/artifacts"
	"school-with-ai/components/sidebar"
)

templ SidePanel() {
	@sidebar.Sidebar(sidebar.Props{
		ID:          "premium-sidepanel",
		Side:        sidebar.SideRight,
		Variant:     sidebar.VariantSidebar,
		Collapsible: sidebar.CollapsibleOffcanvas,
		Collapsed:   true,
		Class:       "!absolute !right-0 !top-0 !h-full [&>div.relative]:!hidden z-30 !ltr:border-l-0 !rtl:border-r-0 ltr:border-l rtl:border-r border-border",
		Attributes: templ.Attributes{
			"style":            "--sidebar-width: 400px",
			"x-data":           "{ activeView: 'artifacts' }",
			"@open-right-sidebar.window": "$dispatch('sidebar:open', { id: 'premium-sidepanel' })",
		},
	}) {
		@sidebar.Content(sidebar.ContentProps{Class: "flex-1 overflow-hidden bg-background"}) {
			<div class="h-full overflow-y-auto custom-scrollbar" x-show="activeView === 'artifacts'">
				@artifacts.ArtifactsContent()
			</div>
			<div class="h-full overflow-y-auto custom-scrollbar" x-show="activeView === 'bookmarks'">
				@Bookmarks()
			</div>
			<div class="h-full overflow-y-auto custom-scrollbar" x-show="activeView === 'files'">
				@Files()
			</div>
			<div class="h-full overflow-y-auto custom-scrollbar" x-show="activeView === 'prompts'">
				@Prompts()
			</div>
		}
	}
}
