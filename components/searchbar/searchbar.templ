package searchbar

import (
	"school-with-ai/components/icon"
	"school-with-ai/components/icon"
	"school-with-ai/components/utils"
	"school-with-ai/components/button"
)

type Props struct {
	ID          string
	Class       string
	Placeholder string
	Attributes  templ.Attributes
}

templ SearchBar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.Placeholder == "" {
		{{ p.Placeholder = "Search messages..." }}
	}
	<div
		class={ utils.TwMerge(
			"group relative my-1 flex h-10 w-full cursor-text items-center gap-3 rounded-lg border border-transparent bg-base-200/50 px-3 py-2 text-base-content focus-within:border-primary focus-within:bg-base-200 hover:bg-base-200 transition-colors",
			p.Class,
		) }
		x-data="{
			query: '',
			showClear: false,
			clear() {
				this.query = '';
				this.showClear = false;
				$refs.searchInput.focus();
				$dispatch('search-clear');
				// If bound via x-model, query update propagates automatically via x-modelable
			},
			handleInput() {
				this.showClear = this.query.length > 0;
			},
            init() {
                // If query is initialized from x-model (via x-modelable), sync showClear
                this.$watch('query', value => {
                    this.showClear = value.length > 0;
                });
            }
		}"
		x-modelable="query"
		{ p.Attributes... }
	>
		<span class="absolute left-3 text-base-content/60 group-focus-within:text-base-content group-hover:text-base-content transition-colors pointer-events-none">
			@icon.Search(icon.Props{Size: 16})
		</span>
		<input
			x-ref="searchInput"
			type="text"
			id={ p.ID }
			class="m-0 mr-0 w-full border-none bg-transparent p-0 pl-7 text-sm leading-tight placeholder:text-base-content/60 focus:outline-none focus:ring-0"
			placeholder={ p.Placeholder }
			x-model="query"
			@input="handleInput"
			@input.debounce.300ms="$dispatch('search', query)"
			@keydown.escape.prevent="clear()"
			autocomplete="off"
		/>
		@button.Button(button.Props{
			Type:    button.TypeButton,
			Variant: button.VariantGhost,
			Class:   "absolute right-[7px] flex h-5 w-5 items-center justify-center rounded-full text-base-content/60 hover:text-base-content transition-opacity duration-200 p-0 min-h-0",
			Attributes: templ.Attributes{
				":class":    "showClear ? 'opacity-100 cursor-pointer' : 'opacity-0 pointer-events-none'",
				"@click":    "clear()",
				"tabindex":  "-1",
				":disabled": "!showClear",
			},
		}) {
			@icon.X(icon.Props{Size: 14})
		}
	</div>
}
