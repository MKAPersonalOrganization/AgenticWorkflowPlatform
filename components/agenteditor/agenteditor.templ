package agenteditor

import (
	"aicompass/components/badge"
	"aicompass/components/button"
	"aicompass/components/dialog"
	"aicompass/components/i18n"
	"aicompass/components/icon"
	"aicompass/components/input"
	"aicompass/components/label"
	"aicompass/components/textarea"
)

// AgentDesignerDialog is the unified dialog for creating and managing AI agents.
// Supports single agents and multi-agent workflows (sequential, parallel, loop).
templ AgentDesignerDialog() {
	<div
		x-data="agentDesigner"
		x-init="init()"
		@open-agent-designer.window="open()"
		@open-agent-designer-node.window="open(); $nextTick(() => showEditNodeForm($event.detail))"
		@open-agent-designer-pipeline.window="open(); $nextTick(() => showEditPipelineForm($event.detail))"
		@open-agent-designer-with-id.window="open(); $nextTick(() => { fetchAgentById($event.detail.agentId).then(agent => { if (agent.isComposed) showEditPipelineForm(agent); else showEditNodeForm(agent); }) })"
		@agents-updated.window="fetchAgents()"
	>
		@dialog.Dialog(dialog.Props{
			ID: "agent-designer-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-5xl max-h-[90vh] flex flex-col p-0 overflow-hidden transition-all duration-300 ease-in-out",
				Attributes: templ.Attributes{
					":class": "expanded ? '!max-w-[calc(100vw-2rem)] !max-h-[calc(100vh-2rem)] !w-[calc(100vw-2rem)] !h-[calc(100vh-2rem)]' : ''",
				},
			}) {
				@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
					<div class="flex items-center justify-between">
						<div>
							@dialog.Title() {
								<span class="flex items-center gap-2">
									@icon.Workflow(icon.Props{Class: "size-5"})
									{ i18n.T(ctx, "Agent Designer") }
								</span>
							}
							@dialog.Description() {
								{ i18n.T(ctx, "Create and manage AI agents and multi-agent workflows.") }
							}
						</div>
						<div class="flex items-center gap-1">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-7 text-muted-foreground",
								Attributes: templ.Attributes{
									"@click": "toggleExpand()",
									"title":  i18n.T(ctx, "Toggle fullscreen"),
								},
							}) {
								<span x-show="!expanded">
									@icon.Maximize2(icon.Props{Class: "size-3.5"})
								</span>
								<span x-show="expanded">
									@icon.Minimize2(icon.Props{Class: "size-3.5"})
								</span>
							}
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"title": i18n.T(ctx, "Close"),
									},
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>
					</div>
				}
				<!-- ═══════════════════════════════════════════ -->
				<!-- UNIFIED AGENT LIST                         -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'list'">
					<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
						<div class="flex flex-col flex-1 overflow-hidden">
							<div class="px-4 pt-3 pb-2 flex items-center gap-2">
								<div class="flex-1">
									@input.Input(input.Props{
										Type:        input.TypeSearch,
										Placeholder: i18n.T(ctx, "Search agents..."),
										Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
										Attributes: templ.Attributes{
											"x-model.debounce.300ms": "searchQuery",
											"@input":                 "searchAgents()",
										},
									})
								</div>
								@button.Button(button.Props{
									Size:    button.SizeSm,
									Variant: button.VariantDefault,
									Class:   "gap-1.5 shrink-0",
									Attributes: templ.Attributes{
										"@click": "view = 'typeSelect'",
									},
								}) {
									@icon.Plus(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "New Agent") }
								}
							</div>
							<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
								<template x-if="loading">
									<div class="space-y-3">
										<template x-for="i in 3" :key="i">
											<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
												<div class="size-10 rounded-lg bg-muted"></div>
												<div class="flex-1 space-y-2">
													<div class="h-4 bg-muted rounded-md w-1/3"></div>
													<div class="h-3 bg-muted rounded-md w-2/3"></div>
												</div>
											</div>
										</template>
									</div>
								</template>
								<template x-if="!loading">
									<div>
										<template x-if="filteredAgents.length === 0">
											<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
												@icon.Workflow(icon.Props{Class: "size-12 opacity-20"})
												<template x-if="searchQuery">
													<div class="text-center">
														<p class="text-sm font-medium">{ i18n.T(ctx, "No agents found") }</p>
														<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search term.") }</p>
													</div>
												</template>
												<template x-if="!searchQuery">
													<div class="text-center">
														<p class="text-sm font-medium">{ i18n.T(ctx, "No agents yet") }</p>
														<p class="text-xs mt-1">{ i18n.T(ctx, "Create your first agent to get started.") }</p>
													</div>
												</template>
											</div>
										</template>
										<!-- Agent Cards Grid -->
										<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
											<template x-for="ag in filteredAgents" :key="ag.id">
												<div
													class="group relative rounded-xl border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 cursor-pointer overflow-hidden bg-card"
													@click="ag.isComposed ? showEditPipelineForm(ag) : showEditNodeForm(ag)"
												>
													<div class="p-4">
														<div class="flex items-start gap-3">
															<!-- Agent Icon -->
															<div
																class="size-10 rounded-lg flex items-center justify-center shrink-0 [&_svg]:size-5"
																:class="ag.isComposed ? 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400' : 'bg-primary/10 text-primary'"
															>
																<template x-if="ag.isComposed">
																	@icon.GitBranch(icon.Props{Class: "size-5"})
																</template>
																<template x-if="!ag.isComposed">
																	<span x-html="ag.icon"></span>
																</template>
															</div>
															<div class="flex-1 min-w-0">
																<h3 class="text-sm font-semibold text-foreground truncate" x-text="ag.name"></h3>
																<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="ag.description || 'No description'"></p>
															</div>
														</div>
														<!-- Metadata -->
														<div class="flex items-center gap-2 mt-3 pt-2 border-t border-border/50">
															<template x-if="!ag.isComposed">
																@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[9px] px-1.5 py-0 h-4"}) {
																	@icon.Bot(icon.Props{Class: "size-2.5 me-0.5"})
																	{ i18n.T(ctx, "LLM Agent") }
																}
															</template>
															<template x-if="ag.isComposed">
																@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[9px] px-1.5 py-0 h-4 border-indigo-500/30 text-indigo-600 dark:text-indigo-400"}) {
																	@icon.GitBranch(icon.Props{Class: "size-2.5 me-0.5"})
																	{ i18n.T(ctx, "Workflow") }
																}
															</template>
															<template x-if="ag.isComposed && ag.graph">
																<span class="text-[10px] text-muted-foreground">
																	<span x-text="collectAgentIds(ag.graph).length"></span> agents
																</span>
															</template>
															<span class="text-[10px] text-muted-foreground" x-text="formatDate(ag.createdAt || ag.created_at)"></span>
															<div class="flex-1"></div>
															<div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity" @click.stop>
																@button.Button(button.Props{
																	Size:    button.SizeIcon,
																	Variant: button.VariantGhost,
																	Class:   "size-7 text-destructive hover:text-destructive",
																	Attributes: templ.Attributes{
																		"@click.stop": "ag.isComposed ? confirmDeletePipeline(ag) : confirmDeleteNode(ag)",
																		"title":       i18n.T(ctx, "Delete"),
																	},
																}) {
																	@icon.Trash2(icon.Props{Class: "size-3.5"})
																}
															</div>
														</div>
													</div>
												</div>
											</template>
										</div>
									</div>
								</template>
							</div>
						</div>
					</div>
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- TYPE SELECTOR                               -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'typeSelect'">
					<div class="flex flex-col flex-1 overflow-hidden">
						<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-8",
								Attributes: templ.Attributes{
									"@click": "view = 'list'",
								},
							}) {
								@icon.ArrowLeft(icon.Props{Class: "size-4"})
							}
							<h3 class="text-sm font-semibold">{ i18n.T(ctx, "What would you like to create?") }</h3>
						</div>
						<div class="flex-1 flex items-center justify-center p-8">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-lg">
								<!-- Single Agent Card -->
								<button
									type="button"
									@click="showCreateNodeForm()"
									class="group flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-border hover:border-primary/50 hover:shadow-md bg-card transition-all duration-200 text-center cursor-pointer"
								>
									<div class="size-14 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
										@icon.Bot(icon.Props{Class: "size-7"})
									</div>
									<div>
										<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Single Agent") }</h4>
										<p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">{ i18n.T(ctx, "An AI agent with custom instructions, tools, and knowledge bases.") }</p>
									</div>
								</button>
								<!-- Workflow Card -->
								<button
									type="button"
									@click="showCreatePipelineForm()"
									class="group flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-border hover:border-indigo-500/50 hover:shadow-md bg-card transition-all duration-200 text-center cursor-pointer"
								>
									<div class="size-14 rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
										@icon.GitBranch(icon.Props{Class: "size-7"})
									</div>
									<div>
										<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Multi-Agent Workflow") }</h4>
										<p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">{ i18n.T(ctx, "Orchestrate multiple agents working together in sequence, parallel, or loops.") }</p>
									</div>
								</button>
							</div>
						</div>
					</div>
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- AGENT FORM                                  -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'agentForm'">
					<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
						<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-8",
								Attributes: templ.Attributes{
									"@click": "view = 'list'",
								},
							}) {
								@icon.ArrowLeft(icon.Props{Class: "size-4"})
							}
							<h3 class="text-sm font-semibold" x-text="editingAgent ? 'Edit Agent' : 'New Agent'"></h3>
							<span class="text-[10px] text-muted-foreground" x-text="editingAgent ? 'Configure your agent' : 'Set up your new agent'"></span>
						</div>
						<div class="flex-1 overflow-y-auto p-4 scrollbar-thin space-y-4">
							@agentNodeForm()
						</div>
						<!-- Save Footer -->
						<div class="px-4 py-3 border-t bg-muted/50 flex items-center justify-end gap-2">
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Class:   "h-8 px-3 text-xs",
								Attributes: templ.Attributes{
									"@click": "view = 'list'",
								},
							}) {
								{ i18n.T(ctx, "Cancel") }
							}
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Class:   "h-8 px-4 text-xs gap-1.5",
								Attributes: templ.Attributes{
									"@click":    "saveNode()",
									":disabled": "saving || !form.name.trim()",
								},
							}) {
								<span x-show="!saving" x-text="editingAgent ? 'Save Changes' : 'Create Agent'"></span>
								<span x-show="saving" class="flex items-center gap-1.5">
									<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
									{ i18n.T(ctx, "Saving...") }
								</span>
							}
						</div>
					</div>
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- DELETE CONFIRMATION                         -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'delete'">
					@deleteConfirmation("view = 'list'", "deletingAgent?.isComposed ? deletePipeline() : deleteNode()")
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- WORKFLOW AGENT FORM                         -->
				<!-- ═══════════════════════════════════════════ -->
				<!-- ═══════════════════════════════════════════ -->
				<!-- WORKFLOW TREE EDITOR                        -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'flow'">
					<div
							class="relative flex flex-col flex-1 overflow-hidden"
							:class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'"
							@keydown.window="if ($event.key === '?' && $event.target.tagName !== 'INPUT' && $event.target.tagName !== 'TEXTAREA' && $event.target.tagName !== 'SELECT' && view === 'flow') { $event.preventDefault(); $store.flow._showHelp = !$store.flow._showHelp; }"
						>
						<!-- Header -->
						<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50 shrink-0">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-8",
								Attributes: templ.Attributes{
									"@click": "_syncGraphFromStore(); view = 'list'",
									"title":  i18n.T(ctx, "Back to agent list"),
								},
							}) {
								@icon.ArrowLeft(icon.Props{Class: "size-4"})
							}
							<h3 class="text-sm font-semibold" x-text="(editingPipeline ? 'Edit' : 'New') + ' Workflow'"></h3>
							<div class="flex-1"></div>
							<!-- Consumers indicator -->
							<template x-if="editingPipeline && pipelineConsumers.length > 0">
								<div class="flex items-center gap-1.5 text-[10px] text-muted-foreground mr-2">
									<span class="text-[10px] text-muted-foreground" x-text="pipelineConsumers.length + ' workflow' + (pipelineConsumers.length !== 1 ? 's' : '') + ' use this'"></span>
									<template x-for="consumer in pipelineConsumers.slice(0, 3)" :key="consumer.id">
										<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20" x-text="consumer.name"></span>
									</template>
									<template x-if="pipelineConsumers.length > 3">
										<span class="text-[10px] text-muted-foreground">+</span>
									</template>
								</div>
							</template>
							<div class="flex items-center gap-1">
								<template x-if="isPipelineValid">
									<span class="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
										@icon.CircleCheck(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "Valid") }
									</span>
								</template>
								<template x-if="!isPipelineValid">
									<span class="flex items-center gap-1 text-[10px] text-amber-600 dark:text-amber-400">
										@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
										<span x-text="pipelineErrors.length + ' issue' + (pipelineErrors.length !== 1 ? 's' : '')"></span>
									</span>
								</template>
							</div>
							<!-- Test mode toggle (▶) -->
							<button
								@click="toggleTestMode()"
								:title="testModeActive ? 'Stop testing agent' : 'Test agent (▶)'"
								class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
								:class="testModeActive ? 'text-amber-400 bg-amber-500/15 hover:bg-amber-500/25 ring-1 ring-amber-500/30' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
							</button>
							<!-- Property panel toggle -->
							<button
								@click="togglePropertyPanel()"
								:title="propertyPanelVisible ? 'Hide property panel (Ctrl+])' : 'Show property panel (Ctrl+])' "
								class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
								:class="propertyPanelVisible ? 'text-indigo-400 bg-indigo-500/15 hover:bg-indigo-500/25' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
							>
								@icon.PanelRight(icon.Props{Class: "size-3.5"})
							</button>
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Class:   "h-8 px-4 text-xs gap-1.5",
								Attributes: templ.Attributes{
									"@click":    "saveFromFlowView()",
									":disabled": "pipelineSaving || !pipelineName.trim()",
								},
							}) {
								<span x-show="!pipelineSaving" x-text="editingPipeline ? 'Save' : 'Create'"></span>
								<span x-show="pipelineSaving" class="flex items-center gap-1.5">
									<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
								</span>
							}
						</div>
						<!-- Name + description bar -->
						<div class="flex items-center gap-2 px-3 py-1.5 border-b border-border/50 bg-muted/20 shrink-0">
							<span class="text-[10px] text-muted-foreground shrink-0">{ i18n.T(ctx, "Name") }</span>
							<input
								x-model="pipelineName"
								type="text"
								placeholder="Workflow name..."
								class="flex-1 bg-transparent text-xs text-foreground outline-none placeholder:text-muted-foreground"
							/>
							<span class="text-[10px] text-muted-foreground shrink-0 border-l border-border/50 pl-2">{ i18n.T(ctx, "Desc") }</span>
							<input
								x-model="pipelineDescription"
								type="text"
								placeholder="Optional description..."
								class="flex-1 bg-transparent text-xs text-foreground outline-none placeholder:text-muted-foreground"
							/>
						</div>
						<!-- Status Bar -->
						<div class="flex items-center gap-4 px-3 py-1 border-b border-border/30 bg-muted/10 shrink-0">
							<span
								class="text-[10px] font-mono tabular-nums"
								:class="$store.flow.nodeCount() > 40 ? 'text-amber-500' : 'text-muted-foreground'"
								x-text="$store.flow.nodeCount() + ' / 50 nodes'"
							></span>
							<span
								class="text-[10px] font-mono tabular-nums"
								:class="$store.flow.maxDepth() > 4 ? 'text-amber-500' : 'text-muted-foreground'"
								x-text="'depth ' + $store.flow.maxDepth() + ' / 5'"
							></span>
							<span class="flex-1"></span>
							<button
								x-show="$store.flow.canUndo()"
								@click="$store.flow.undo()"
								class="text-[10px] text-muted-foreground hover:text-foreground transition-colors"
								title="Undo (Ctrl+Z)"
							>
								{ i18n.T(ctx, "undo") }
							</button>
							<button
								x-show="$store.flow.canRedo()"
								@click="$store.flow.redo()"
								class="text-[10px] text-muted-foreground hover:text-foreground transition-colors"
								title="Redo (Ctrl+Shift+Z)"
							>
								{ i18n.T(ctx, "redo") }
							</button>
							<span class="text-[10px] text-muted-foreground/50">{ i18n.T(ctx, "? for shortcuts") }</span>
						</div>
						<!-- Tree + Property Panel (resizable) -->
						<div
							class="flex flex-1 overflow-hidden"
							x-data="{ panelW: 288, dragging: false }"
							@mousemove.window="if (dragging) { const r = $el.getBoundingClientRect(); panelW = Math.min(Math.max(r.right - $event.clientX, 200), r.width * 0.6); }"
							@mouseup.window="dragging = false; document.body.style.cursor = ''; document.body.style.userSelect = '';"
						>
							<!-- Tree View -->
							<div
								x-data="editableWorkflowTree()"
								x-init="init()"
								class="flex-1 overflow-auto bg-background"
							>
								<div class="ewt-pipeline-canvas">
									<!-- Tree will be rendered here -->
								</div>
							</div>
							<!-- Resize Handle -->
							<div
								x-show="propertyPanelVisible"
								@mousedown.prevent="dragging = true; document.body.style.cursor = 'col-resize'; document.body.style.userSelect = 'none';"
								class="shrink-0 w-1 cursor-col-resize group relative z-10"
								class="shrink-0 w-1 cursor-col-resize group relative z-10 bg-muted"
							>
								<div
									class="absolute inset-y-0 -left-1 -right-1 group-hover:bg-indigo-500/20 transition-colors duration-150"
									:class="dragging ? 'bg-indigo-500/30' : ''"
								></div>
							</div>
							<!-- Property Panel -->
							<div
								x-data="alpineflowPropertyPanel"
								x-show="propertyPanelVisible"
								x-transition:enter="transition-all duration-200 ease-out"
								x-transition:enter-start="opacity-0 translate-x-full"
								x-transition:enter-end="opacity-100 translate-x-0"
								x-transition:leave="transition-all duration-150 ease-in"
								x-transition:leave-start="opacity-100 translate-x-0"
								x-transition:leave-end="opacity-0 translate-x-full"
								class="shrink-0 overflow-y-auto scrollbar-thin flex flex-col bg-card border-border"
								:style="'width:' + panelW + 'px;'"
							>
								<template x-if="!node">
									<div class="flex flex-col h-full">
										<div class="flex flex-col items-center justify-center flex-1 px-4 py-12 text-center space-y-3">
											<div class="w-9 h-9 rounded-lg flex items-center justify-center bg-muted border-border">
												@icon.MousePointerClick(icon.Props{Class: "size-4 text-muted-foreground"})
											</div>
											<div class="space-y-1">
												<p class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Properties") }</p>
												<p class="text-[10px] text-muted-foreground leading-relaxed">{ i18n.T(ctx, "Select a node to view and edit its settings.") }</p>
											</div>
										</div>
										<div class="border-t p-3 space-y-2 border-border">
											<p class="text-[8px] uppercase tracking-widest text-muted-foreground font-semibold">{ i18n.T(ctx, "Workflow Instructions") }</p>
											<textarea
												x-model="$store.flow.systemPrompt"
												rows="6"
												placeholder="Shared instructions for all agents in this workflow..."
												class="w-full text-[11px] rounded-lg px-2.5 py-2 text-foreground placeholder:text-muted-foreground outline-none resize-none focus:ring-1 focus:ring-primary/40 bg-background border-border"
											></textarea>
										</div>
									</div>
								</template>
								<template x-if="node">
									<div class="flex flex-col h-full">
										<!-- Node Header -->
										<div class="flex items-center gap-2 px-3 py-2 border-b shrink-0 border-border">
											<div
												class="shrink-0 w-6 h-6 rounded flex items-center justify-center text-[10px] font-bold"
												:style="'background:' + nodeTypeColor + '12; color:' + nodeTypeColor + '; border: 1px solid ' + nodeTypeColor + '20'"
												x-text="nodeTypeChar"
											></div>
											<div class="flex-1 min-w-0">
												<span class="text-[10px] font-semibold text-foreground uppercase tracking-wider block truncate" x-text="nodeTypeLabel"></span>
												<span class="text-[9px] text-muted-foreground block truncate" x-text="node.label || 'unlabeled'"></span>
											</div>
											<div class="flex items-center gap-0.5 shrink-0">
												<button @click="moveUp()" :disabled="!canMoveUp" title="Move up" class="w-6 h-6 flex items-center justify-center rounded hover:bg-accent text-muted-foreground hover:text-foreground disabled:opacity-20 disabled:cursor-not-allowed transition-colors">↑</button>
												<button @click="moveDown()" :disabled="!canMoveDown" title="Move down" class="w-6 h-6 flex items-center justify-center rounded hover:bg-accent text-muted-foreground hover:text-foreground disabled:opacity-20 disabled:cursor-not-allowed transition-colors">↓</button>
												<button x-show="!isRoot" @click="deleteNode()" title="Delete node" class="w-6 h-6 flex items-center justify-center rounded hover:bg-red-500/10 text-muted-foreground hover:text-red-400 transition-colors">✕</button>
											</div>
										</div>
										<!-- Scrollable Content -->
										<div class="flex-1 overflow-y-auto p-3 space-y-3 scrollbar-thin">
											<!-- Label Field -->
											<div>
												<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">Label</label>
												<input :value="node.label" @input="set('label', $event.target.value)" type="text" placeholder="Display name..." class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
											</div>

											<!-- Agent Node -->
											<template x-if="node.type === 'agent'">
												<div class="space-y-3">
													<!-- Agent Selector -->
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">LLM Agent <span class="text-rose-500">*</span></label>
														<select :value="node.agent_id" @change="set('agent_id', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border">
															<option value="">— select agent —</option>
															<template x-for="ag in agents" :key="ag.id">
																<option :value="ag.id" x-text="ag.name"></option>
															</template>
														</select>
													</div>

													<!-- Agent Info Card -->
													<template x-if="selectedAgent">
<div class="rounded-lg overflow-hidden bg-muted border-border">
															<!-- Agent name header -->
															<div class="px-2.5 py-2 bg-muted/50 border-b border-border">
																<span class="text-[10px] font-semibold text-foreground truncate" x-text="selectedAgent.name"></span>
															</div>
															<!-- Model -->
																<template x-if="selectedAgent.modelOverride && selectedAgent.modelOverride.modelName">
															<div class="px-2.5 py-1.5 flex items-center gap-2 border-b border-border">
																@icon.Cpu(icon.Props{Class: "size-3 text-muted-foreground"})
																<span class="text-[9px] font-mono rounded px-1.5 py-0.5 text-muted-foreground bg-muted" x-text="(selectedAgent.modelOverride.provider ? selectedAgent.modelOverride.provider + '/' : '') + selectedAgent.modelOverride.modelName"></span>
															</div>
														</template>
															<!-- Description -->
															<template x-if="selectedAgent.description">
																<div class="px-2.5 py-2 border-b border-border">
																	<p class="text-[10px] text-muted-foreground leading-relaxed line-clamp-2" x-text="selectedAgent.description"></p>
																</div>
															</template>
															<!-- Agent Config Summary -->
															<div class="px-2.5 py-2">
																<div class="flex items-center gap-2 text-[9px] text-muted-foreground">
																	<template x-if="selectedAgent.output_key">
																		<span class="flex items-center gap-1">
																			@icon.Key(icon.Props{Class: "size-2.5"})
																			<span class="font-mono text-muted-foreground" x-text="'{'+selectedAgent.output_key+'}'"></span>
																		</span>
																	</template>
																</div>
																<template x-if="!selectedAgent.systemPrompt && !selectedAgent.description && !(selectedAgent.modelOverride && selectedAgent.modelOverride.modelName)">
																	<p class="text-[10px] text-muted-foreground italic">{ i18n.T(ctx, "No configuration yet — edit the agent to set it up.") }</p>
																</template>
															</div>
														</div>
													</template>

													<!-- Output Variable -->
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">
															@icon.Key(icon.Props{Class: "size-3 inline me-0.5"})
															Output Variable
														</label>
														<input :value="node.output_key" @input="set('output_key', $event.target.value)" type="text" placeholder="e.g. research_results" class="w-full text-[11px] font-mono rounded-lg px-2.5 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
														<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "Saves output so other agents can use it via {variable_name}") }</p>
													</div>

													<!-- Conversation History -->
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">
															@icon.MessageSquare(icon.Props{Class: "size-3 inline me-0.5"})
															{ i18n.T(ctx, "History") }
														</label>
														<select :value="node.include_contents||'default'" @change="set('include_contents', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border">
															<option value="default">{ i18n.T(ctx, "Include history") }</option>
															<option value="none">{ i18n.T(ctx, "Fresh context only") }</option>
														</select>
														<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "Fresh = agent sees only the current message") }</p>
													</div>

													<!-- Delegation Control -->
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-2">
															@icon.ArrowRightLeft(icon.Props{Class: "size-3 inline me-0.5"})
															{ i18n.T(ctx, "Delegation") }
														</label>
														<div class="space-y-1.5">
															<label class="flex items-center gap-2 cursor-pointer group">
																<input type="checkbox" :checked="node.disallow_transfer_to_parent" @change="setBool('disallow_transfer_to_parent', $event.target.checked)" class="rounded accent-primary"/>
																<span class="text-[10px] text-muted-foreground group-hover:text-foreground transition-colors">{ i18n.T(ctx, "Prevent escalation to parent") }</span>
															</label>
															<label class="flex items-center gap-2 cursor-pointer group">
																<input type="checkbox" :checked="node.disallow_transfer_to_peers" @change="setBool('disallow_transfer_to_peers', $event.target.checked)" class="rounded accent-primary"/>
																<span class="text-[10px] text-muted-foreground group-hover:text-foreground transition-colors">{ i18n.T(ctx, "Prevent delegation to siblings") }</span>
															</label>
														</div>
													</div>

													<!-- Tools -->
													<div class="border-t pt-2 border-border">
														<div class="flex items-center justify-between">
															<button
																@click="showTools = !showTools"
																class="flex items-center gap-1.5 text-[9px] uppercase tracking-widest text-muted-foreground font-semibold hover:text-foreground transition-colors py-1"
															>
																@icon.Blocks(icon.Props{Class: "size-3"})
																Tools
																<span x-show="toolCount > 0" class="text-[8px] px-1 py-0.5 rounded bg-primary/20 text-primary" x-text="toolCount + ' tool' + (toolCount !== 1 ? 's' : '')"></span>
																<span class="transition-transform text-[6px]" :class="showTools ? 'rotate-180' : ''">▼</span>
															</button>
															<button
																@click="openAddToolDialog()"
																class="text-[9px] text-indigo-400 hover:text-indigo-300 font-medium transition-colors"
															>
																+ Add
															</button>
														</div>
														<div x-show="showTools" x-collapse class="pt-2 space-y-2">
															<!-- Loading state -->
															<template x-if="loadingMetadata">
																<div class="space-y-1.5">
																	<template x-for="i in 2" :key="i">
																		<div class="flex items-center gap-2 p-2 rounded-lg animate-pulse bg-muted">
																		<div class="size-4 rounded bg-muted-foreground"></div>
																		<div class="flex-1 h-3 bg-muted-foreground rounded"></div>
																		</div>
																	</template>
																</div>
															</template>
															<!-- No tools configured -->
															<template x-if="!loadingMetadata && configuredPlugins.length === 0">
<div class="text-[10px] text-muted-foreground italic py-3 text-center">
																No tools attached. Click + Add to attach tools.
															</div>
															</template>
															<!-- Configured tool list -->
															<template x-for="plugin in configuredPlugins" :key="plugin.id">
<div class="rounded-lg overflow-hidden bg-muted border-border">
																		<div class="flex items-center gap-2 px-2 py-1.5">
																			@icon.Blocks(icon.Props{Class: "size-3 text-muted-foreground shrink-0"})
																			<span class="text-[10px] font-medium text-foreground flex-1 truncate" x-text="plugin.name"></span>
																			<span class="text-[8px] text-muted-foreground" x-text="getToolEnabledCount(plugin) + '/' + plugin.tools?.length"></span>
																		<button
																			@click="detachToolSet(plugin)"
																			title="Detach tool"
																			class="shrink-0 w-5 h-5 rounded text-muted-foreground hover:text-red-400 hover:bg-red-500/10 transition-colors text-[10px]"
																		>
																			✕
																		</button>
																	</div>
																	<!-- Individual tools -->
																	<template x-if="plugin.tools && plugin.tools.length > 0">
																		<div class="border-t border-white/5">
																			<template x-for="tool in plugin.tools" :key="tool.id">
																				<div class="flex items-center gap-2 px-2 py-1.5 border-b border-white/5 last:border-0" :class="isToolBlocked(plugin, tool) ? 'opacity-50' : ''">
																					<span class="w-3 shrink-0"></span>
																					<span class="text-[9px] text-muted-foreground flex-1 truncate" :class="isToolBlocked(plugin, tool) ? 'line-through' : ''" x-text="tool.name"></span>
																					<button
																						@click="toggleTool(plugin, tool)"
																						type="button"
																						role="switch"
																						:aria-checked="!isToolBlocked(plugin, tool)"
																						class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
																						:class="isToolBlocked(plugin, tool) ? 'bg-gray-600' : 'bg-indigo-500'"
																					>
																						<span class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200" :class="isToolBlocked(plugin, tool) ? 'translate-x-0' : 'translate-x-3'"></span>
																					</button>
																				</div>
																			</template>
																		</div>
																	</template>
																</div>
															</template>
														</div>
													</div>

													<!-- Add Tool Dialog -->
													<div
														x-show="showAddToolDialog"
														x-transition:enter="transition ease-out duration-200"
														x-transition:enter-start="opacity-0"
														x-transition:enter-end="opacity-100"
														x-transition:leave="transition ease-in duration-150"
														x-transition:leave-start="opacity-100"
														x-transition:leave-end="opacity-0"
														@click.self="closeAddToolDialog()"
														class="fixed inset-0 z-50 bg-black/40 backdrop-blur-[3px]"
													></div>
													<div
														x-show="showAddToolDialog"
														x-transition:enter="transition ease-out duration-200"
														x-transition:enter-start="opacity-0 scale-[0.97]"
														x-transition:enter-end="opacity-100 scale-100"
														x-transition:leave="transition ease-in duration-150"
														x-transition:leave-start="opacity-100 scale-100"
														x-transition:leave-end="opacity-0 scale-[0.97]"
														@keydown.escape.window="closeAddToolDialog()"
														class="fixed z-50 left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] bg-background rounded-2xl border border-border/60 shadow-modern-xl w-full max-w-md"
													>
														<!-- Header -->
														<div class="flex items-center justify-between px-5 pt-5 pb-0">
															<div class="flex items-center gap-2.5">
																<div class="size-8 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
																	@icon.Blocks(icon.Props{Class: "size-4"})
																</div>
																<div>
																	<h3 class="text-sm font-semibold text-foreground">Add Tools</h3>
																</div>
															</div>
															<button
																type="button"
																@click="closeAddToolDialog()"
																class="size-8 rounded-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
															>
																@icon.X(icon.Props{Class: "size-4"})
															</button>
														</div>
														<!-- Body -->
														<div class="px-5 py-4 max-h-80 overflow-y-auto">
															<template x-if="loadingAvailableTools">
																<div class="space-y-2">
																	<template x-for="i in 3" :key="i">
																		<div class="h-12 rounded-lg animate-pulse bg-muted"></div>
																	</template>
																</div>
															</template>
															<template x-if="!loadingAvailableTools && availableTools.length === 0">
																<div class="text-sm text-muted-foreground py-6 text-center">No tools available</div>
															</template>
															<div x-show="!loadingAvailableTools" class="space-y-2">
																<template x-for="plugin in availableTools" :key="plugin.id">
																	<div
																		class="flex items-center gap-3 p-3 rounded-lg border border-border transition-colors cursor-pointer hover:border-primary/50"
																		:class="isToolAttached(plugin.id) ? 'opacity-50' : ''"
																		@click="!isToolAttached(plugin.id) && attachToolSet(plugin)"
																	>
																		@icon.Blocks(icon.Props{Class: "size-4 text-muted-foreground shrink-0"})
																		<div class="flex-1 min-w-0">
																			<p class="text-sm font-medium text-foreground truncate" x-text="plugin.name"></p>
																			<p class="text-xs text-muted-foreground truncate" x-text="plugin.tools?.length + ' tool' + (plugin.tools?.length !== 1 ? 's' : '')"></p>
																		</div>
																		<template x-if="isToolAttached(plugin.id)">
																			<span class="shrink-0 text-xs text-emerald-500 font-medium">Attached</span>
																		</template>
																		<template x-if="!isToolAttached(plugin.id)">
																			<span class="shrink-0 text-xs text-primary font-medium">+ Add</span>
																		</template>
																	</div>
																</template>
															</div>
														</div>
													</div>

													<!-- Advanced Section -->
													<div class="border-t pt-2 border-border">
														<button
															@click="showAdvanced = !showAdvanced"
															class="flex items-center justify-between w-full text-[9px] uppercase tracking-widest text-muted-foreground font-semibold hover:text-foreground transition-colors py-1"
														>
															<span>Advanced (Schema)</span>
															<span class="transition-transform" :class="showAdvanced ? 'rotate-180' : ''">▼</span>
														</button>
														<div x-show="showAdvanced" x-collapse class="space-y-2 pt-2">
															<!-- Input Schema -->
															<div>
																<div class="flex items-center justify-between mb-1">
																	<label class="text-[8px] text-muted-foreground font-semibold">Input Schema</label>
																	<span x-show="hasInputSchema()" class="text-[8px] px-1 py-0.5 rounded bg-green-500/15 text-green-400" x-text="getInputSchemaPreview()"></span>
																</div>
																<textarea
																	:value="node.input_schema || ''"
																	@input="set('input_schema', $event.target.value)"
																	rows="3"
																	placeholder='{"type":"object","properties":{"topic":...}}'
																	class="w-full text-[10px] font-mono rounded-lg px-2 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 resize-none bg-background border-border"
																></textarea>
																<p class="text-[8px] text-muted-foreground mt-0.5">{ i18n.T(ctx, "Defines the input format when another agent calls this one") }</p>
															</div>
															<!-- Output Schema -->
															<div>
																<div class="flex items-center justify-between mb-1">
																	<label class="text-[8px] text-muted-foreground font-semibold">Output Schema</label>
																	<span x-show="hasOutputSchema()" class="text-[8px] px-1 py-0.5 rounded bg-green-500/15 text-green-400" x-text="getOutputSchemaPreview()"></span>
																</div>
																<textarea
																	:value="node.output_schema || ''"
																	@input="set('output_schema', $event.target.value)"
																	rows="3"
																	placeholder='{"type":"object","properties":{"summary":...}}'
																	class="w-full text-[10px] font-mono rounded-lg px-2 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 resize-none bg-background border-border"
																></textarea>
																<p class="text-[8px] text-muted-foreground mt-0.5">{ i18n.T(ctx, "Forces the agent to respond in a specific JSON format") }</p>
															</div>
														</div>
													</div>
												</div>
											</template>

											<!-- Remote Node -->
											<template x-if="node.type === 'remote'">
												<div class="space-y-3">
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">A2A Connector <span class="text-rose-500">*</span></label>
														<select :value="node.a2a_connector_id" @change="set('a2a_connector_id', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border">
															<option value="">— select connector —</option>
															<template x-for="conn in connectors" :key="conn.id">
																<option :value="conn.id" x-text="conn.name || conn.id"></option>
															</template>
														</select>
													</div>
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">{ i18n.T(ctx, "Output Variable") }</label>
														<input :value="node.output_key" @input="set('output_key', $event.target.value)" type="text" placeholder="e.g. remote_result" class="w-full text-[11px] font-mono rounded-lg px-2.5 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
													</div>
												</div>
											</template>

											<!-- Loop Node -->
											<template x-if="node.type === 'loop'">
												<div class="space-y-3">
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">Max Iterations</label>
														<input :value="node.max_iterations||3" @input="set('max_iterations', parseInt($event.target.value)||1)" type="number" min="1" max="100" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
														<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "How many times the agents in this loop will repeat.") }</p>
													</div>
													<label class="flex items-center gap-2 cursor-pointer group">
														<input type="checkbox" :checked="node.allow_early_exit" @change="setBool('allow_early_exit', $event.target.checked)" class="rounded accent-primary"/>
														<span class="text-[10px] text-muted-foreground group-hover:text-foreground transition-colors">{ i18n.T(ctx, "Allow the agent to exit the loop early when done") }</span>
													</label>
												</div>
											</template>

											<!-- Sequential/Parallel Node -->
											<template x-if="node.type === 'sequential' || node.type === 'parallel'">
												<div class="rounded-lg p-3 text-center bg-muted border-border">
													<p class="text-[10px] text-muted-foreground">
														<template x-if="node.type === 'sequential'">{ i18n.T(ctx, "Runs agents one after another, in order.") }</template>
														<template x-if="node.type === 'parallel'">{ i18n.T(ctx, "Runs all agents at the same time, then collects results.") }</template>
													</p>
													<p class="text-[9px] text-muted-foreground mt-1">
														<template x-if="node.children && node.children.length" x-text="node.children.length + ' sub-agent(s)'"></template>
														<template x-if="!node.children || node.children.length === 0">No sub-agents yet</template>
													</p>
												</div>
											</template>
										</div>
										<!-- Footer -->
										<div class="px-3 py-1.5 border-t shrink-0 border-border">
											<p class="text-[8px] text-muted-foreground font-mono truncate tracking-wide" x-text="node.id"></p>
										</div>
									</div>
								</template>
							</div>
							</div>
							<!-- Validation errors footer -->
							<template x-if="pipelineErrors.length > 0">
								<div class="shrink-0 px-4 py-2 border-t border-amber-500/20 bg-amber-500/5 flex items-start gap-2">
									@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-amber-500 shrink-0 mt-0.5"})
									<div class="flex-1 min-w-0">
										<template x-for="(err, idx) in pipelineErrors.slice(0,3)" :key="idx">
											<p class="text-[10px] text-amber-600 dark:text-amber-400 truncate" x-text="err"></p>
										</template>
										<template x-if="pipelineErrors.length > 3">
											<p class="text-[10px] text-amber-500/70" x-text="'+ ' + (pipelineErrors.length - 3) + ' more'"></p>
										</template>
									</div>
								</div>
							</template>

					<!-- ═══════════════════════════════════════════ -->
					<!-- TEST PANEL (Steps 7-9)                      -->
					<!-- ═══════════════════════════════════════════ -->
					<template x-if="testModeActive">
						<!-- Outer wrapper: height animates between 280px and 40px -->
						<div
							class="shrink-0 flex flex-col border-t border-primary/20 overflow-hidden transition-all duration-200 ease-in-out"
							:style="testPanelCollapsed ? 'height:40px' : 'height:280px'"
							class="bg-background"
						>
							<!-- ── Panel header bar (always visible, 40px) ── -->
							<div class="flex items-center gap-2 px-3 shrink-0 border-b border-border" style="height:40px;" class="bg-muted/50">
								<!-- Play icon + label -->
								<span class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-widest text-primary">
									<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
									Test Panel
								</span>
								<!-- Agent name badge -->
								<span
									class="text-[9px] px-1.5 py-0.5 rounded font-mono"
									style="background:oklch(from var(--primary) l c h / 10%); color:var(--primary);"
									x-text="editingPipeline?.name || editingAgent?.name || 'Agent'"
								></span>
								<!-- Thread indicator -->
								<span
									x-show="testPanelThreadId"
									class="text-[8px] font-mono text-muted-foreground hidden sm:block"
									x-text="'thread: ' + (testPanelThreadId ? testPanelThreadId.slice(0,8) + '…' : '')"
								></span>
								<span class="flex-1"></span>
								<!-- Event log toggle -->
								<button
									@click="toggleTestEventLog()"
									title="Toggle event log"
									class="flex items-center justify-center w-6 h-6 rounded text-[10px] transition-colors hover:bg-muted"
									:class="testPanelShowEventLog ? 'text-primary' : 'text-muted-foreground'"
								>
									@icon.Terminal(icon.Props{Class: "size-3"})
								</button>
								<!-- Clear session -->
								<button
									@click="clearTestSession()"
									title="Clear test session"
									class="flex items-center justify-center w-6 h-6 rounded text-[10px] text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
								>
									@icon.Trash2(icon.Props{Class: "size-3"})
								</button>
								<!-- Collapse / expand -->
								<button
									@click="toggleTestPanel()"
									:title="testPanelCollapsed ? 'Expand test panel' : 'Collapse test panel'"
									class="flex items-center justify-center w-6 h-6 rounded text-[10px] text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
								>
									<span class="transition-transform duration-200 inline-flex" :class="testPanelCollapsed ? '' : 'rotate-180'">
										@icon.ChevronDown(icon.Props{Class: "size-3"})
									</span>
								</button>
							</div>

							<!-- ── Content area (hidden when collapsed) ── -->
							<div x-show="!testPanelCollapsed" class="flex flex-1 overflow-hidden min-h-0">

								<!-- ── Input column only (responses show in workflow nodes) ── -->
								<div class="flex flex-col flex-1 overflow-hidden min-h-0">

									<!-- Empty state -->
									<div class="flex-1 flex flex-col items-center justify-center py-8 gap-3 text-muted-foreground">
										<svg xmlns="http://www.w3.org/2000/svg" class="size-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
											<path d="M12 20h9"/>
											<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
										</svg>
										<span class="text-xs">Responses appear in workflow nodes</span>
									</div>

									<!-- ── Input bar ── -->
									<div class="shrink-0 px-3 pb-2 pt-1.5 border-t border-border">
										<div class="flex items-center gap-2">
											<input
												x-model="testPanelInput"
												@keydown="handleTestKeydown($event)"
												:disabled="testPanelStreaming"
												placeholder="Message the agent... (Enter to send)"
												class="flex-1 rounded px-2.5 py-1.5 text-xs bg-background text-foreground outline-none disabled:opacity-50 transition-colors border border-input"
												@focus="$el.classList.add('border-primary', 'ring-1', 'ring-primary')"
												@blur="$el.classList.remove('border-primary', 'ring-1', 'ring-primary')"
											/>
											<!-- Send / Stop button -->
											<button
												@click="testPanelStreaming ? abortTestMessage() : sendTestMessage()"
												:disabled="!testPanelStreaming && !testPanelInput.trim()"
												:title="testPanelStreaming ? 'Stop (Escape)' : 'Send (Enter)'"
												class="flex items-center justify-center w-8 h-8 rounded-md transition-all hover:scale-105 active:scale-95"
												:class="testPanelStreaming 
													? 'bg-destructive/10 text-destructive hover:bg-destructive/20' 
													: (testPanelInput.trim() 
														? 'bg-primary text-primary-foreground hover:bg-primary/90' 
														: 'bg-muted text-muted-foreground cursor-not-allowed opacity-50')"
											>
												<template x-if="testPanelStreaming">
													@icon.CircleStop(icon.Props{Class: "size-4"})
												</template>
												<template x-if="!testPanelStreaming">
													@icon.SendHorizontal(icon.Props{Class: "size-4"})
												</template>
											</button>
										</div>
									</div><!-- /input bar -->

								</div><!-- /input column -->

								<!-- ── Event log side pane ── -->
								<template x-if="testPanelShowEventLog">
									<div
										class="w-56 shrink-0 overflow-y-auto scrollbar-thin flex flex-col bg-muted/20"
										style="font-family:'JetBrains Mono','Fira Code',monospace;"
									>
										<div class="px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground border-b border-border">
											SSE Events
										</div>
										<!-- Empty state -->
										<template x-if="testPanelEvents.length === 0">
											<div class="flex-1 flex items-center justify-center text-muted-foreground text-xs py-8">No events yet</div>
										</template>
										<!-- Event rows -->
										<div class="flex-1 overflow-y-auto px-3 py-2 space-y-1">
											<template x-for="(ev, idx) in testPanelEvents" :key="idx">
												<div class="flex items-center gap-2 py-0.5 text-[11px]">
													<span x-text="ev.type" class="text-primary font-medium flex-shrink-0;"></span>
													<template x-if="ev.name">
														<span x-text="'· ' + ev.name" class="text-muted-foreground truncate;"></span>
													</template>
												</div>
											</template>
										</div>
									</div><!-- /event log -->
								</template>

							</div><!-- /content area -->
						</div><!-- /panel wrapper -->
					</template>
					<!-- Blinking cursor keyframe -->
					<style>@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}</style>
					<!-- Keyboard Shortcuts Overlay -->
					<div
						x-show="$store.flow?._showHelp"
						x-transition:enter="transition ease-out duration-150"
						x-transition:enter-start="opacity-0"
						x-transition:enter-end="opacity-100"
						x-transition:leave="transition ease-in duration-100"
						x-transition:leave-start="opacity-100"
						x-transition:leave-end="opacity-0"
						@click="$store.flow._showHelp = false"
						@keydown.escape.window="if ($store.flow?._showHelp) $store.flow._showHelp = false"
						class="absolute inset-0 z-50 flex items-center justify-center"
						style="background:rgba(0,0,0,0.5); backdrop-filter:blur(2px);"
					>
						<div @click.stop class="rounded-xl border border-border shadow-2xl max-w-md w-full bg-background">
							<div class="px-5 pt-5 pb-3">
								<h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.Keyboard(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "Workflow Editor Shortcuts") }
								</h3>
								<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "Navigate and edit your workflow faster.") }</p>
							</div>
							<div class="px-5 pb-4 space-y-4">
								<!-- Editing -->
								<div>
									<h4 class="text-xs font-semibold text-muted-foreground mb-2">{ i18n.T(ctx, "Editing") }</h4>
									<div class="space-y-1">
										@shortcutRow(i18n.T(ctx, "Delete selected node"), "Delete")
										@shortcutRow(i18n.T(ctx, "Duplicate selected node"), "Ctrl+D")
										@shortcutRow(i18n.T(ctx, "Undo"), "Ctrl+Z")
										@shortcutRow(i18n.T(ctx, "Redo"), "Ctrl+Shift+Z")
									</div>
								</div>
								<!-- Navigation -->
								<div>
									<h4 class="text-xs font-semibold text-muted-foreground mb-2">{ i18n.T(ctx, "Navigation") }</h4>
									<div class="space-y-1">
										@shortcutRow(i18n.T(ctx, "Move node up"), "Ctrl+↑")
										@shortcutRow(i18n.T(ctx, "Move node down"), "Ctrl+↓")
										@shortcutRow(i18n.T(ctx, "Collapse node"), "←")
										@shortcutRow(i18n.T(ctx, "Expand node"), "→")
									</div>
								</div>
								<!-- General -->
								<div>
									<h4 class="text-xs font-semibold text-muted-foreground mb-2">{ i18n.T(ctx, "General") }</h4>
									<div class="space-y-1">
										@shortcutRow(i18n.T(ctx, "Toggle property panel"), "Ctrl+]")
										@shortcutRow(i18n.T(ctx, "Show this help"), "?")
									</div>
								</div>
								<!-- Tip -->
								<div class="flex items-start gap-2 p-2.5 bg-muted/30 rounded-lg">
									@icon.Info(icon.Props{Class: "size-3.5 text-primary shrink-0 mt-0.5"})
									<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "On macOS, use ⌘ instead of Ctrl") }</p>
								</div>
							</div>
						</div>
					</div>
					</div>
				</template>
				<!-- Footer (only on list view) -->
				<template x-if="view === 'list'">
					@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
						<div class="flex items-center justify-between w-full">
							<span class="text-xs text-muted-foreground" x-text="`${filteredAgents.length} agent${filteredAgents.length !== 1 ? 's' : ''}`"></span>
							@dialog.Close() {
								@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
									{ i18n.T(ctx, "Close") }
								}
							}
						</div>
					}
				</template>
			}
		}
		<!-- Toast Notifications -->
		<div class="fixed bottom-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none">
			<template x-for="t in toasts" :key="t.id">
				<div
					class="pointer-events-auto max-w-xs px-4 py-2.5 rounded-lg shadow-lg text-xs font-medium transition-all duration-200 flex items-center gap-2"
					:class="{
						'bg-emerald-600 text-white': t.type === 'success',
						'bg-red-600 text-white': t.type === 'error',
						'bg-sky-600 text-white': t.type === 'info',
						'bg-amber-600 text-white': t.type === 'warning',
						'opacity-0 translate-y-2': t.leaving,
						'opacity-100 translate-y-0': !t.leaving,
					}"
				>
					<span x-text="t.message"></span>
					<button @click="dismissToast(t.id)" class="ml-1 opacity-70 hover:opacity-100 shrink-0">&times;</button>
				</div>
			</template>
		</div>
	</div>
}

// agentNodeForm renders the form fields for creating/editing a single agent.
templ agentNodeForm() {
	<!-- Identity Section -->
	<div class="space-y-3">
		<div class="flex items-center gap-2 pb-1">
			@icon.Bot(icon.Props{Class: "size-3.5 text-muted-foreground"})
			<span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "Identity") }</span>
		</div>
		<div class="space-y-1.5">
			@label.Label(label.Props{Class: "text-xs"}) {
				{ i18n.T(ctx, "Name") }
				<span class="text-destructive">*</span>
			}
			@input.Input(input.Props{
				Placeholder: i18n.T(ctx, "e.g., Writing Coach, Code Reviewer..."),
				Class:       "h-8 text-sm",
				Attributes: templ.Attributes{
					"x-model":   "form.name",
					"maxlength": "100",
				},
			})
		</div>
		<div class="space-y-1.5">
			@label.Label(label.Props{Class: "text-xs"}) {
				{ i18n.T(ctx, "Description") }
			}
			@input.Input(input.Props{
				Placeholder: i18n.T(ctx, "Brief description of what this agent does..."),
				Class:       "h-8 text-sm",
				Attributes: templ.Attributes{
					"x-model":   "form.description",
					"maxlength": "500",
				},
			})
		</div>
	</div>
	<!-- Instructions Section -->
	<div class="space-y-3 pt-2 border-t border-border/50">
		<div class="flex items-center gap-2 pb-1">
			@icon.FileText(icon.Props{Class: "size-3.5 text-muted-foreground"})
			<span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "Instructions") }</span>
		</div>
		<div class="space-y-1.5">
			@textarea.Textarea(textarea.Props{
				Placeholder: i18n.T(ctx, "Define this agent's role, expertise, and behavior..."),
				Class:       "min-h-[120px] resize-y text-sm",
				Rows:        5,
				Attributes: templ.Attributes{
					"x-model": "form.systemPrompt",
				},
			})
			<p class="text-[10px] text-muted-foreground">
				{ i18n.T(ctx, "Describe the agent's role, expertise, and behavior. Use {variable_name} to reference data from other agents in a workflow.") }
			</p>
		</div>
	</div>
	<!-- Multi-Agent Orchestration Section -->
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showOrchestration = !showOrchestration"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.GitBranch(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Advanced Settings") }
				<span class="text-[10px] text-muted-foreground" x-text="orchestrationSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showOrchestration ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showOrchestration" x-collapse class="px-3 pb-3 border-t border-border pt-3 space-y-4">
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "These settings control how this agent behaves when used as part of a multi-agent workflow.") }
			</p>
			@orchestrationFields()
		</div>
	</div>
	<!-- Model Override -->
	@modelOverrideSection()
	<!-- Model Settings -->
	@modelSettingsSection()
	<!-- Tools, KBs, Filesystems (edit mode only) -->
	<template x-if="editingAgent">
		<div class="space-y-4">
			@toolsSection()
			@knowledgeBasesSection()
			@filesystemsSection()
		</div>
	</template>
	<!-- Info notice (create mode) -->
	<template x-if="!editingAgent">
		<div class="border border-border rounded-lg p-3 flex items-start gap-2 bg-muted/30">
			@icon.Info(icon.Props{Class: "size-4 text-muted-foreground shrink-0 mt-0.5"})
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "After creating the agent, you can add tools and knowledge bases by editing it.") }
			</p>
		</div>
	</template>
}

// orchestrationFields renders the transfer policy, output key, history, etc.
templ orchestrationFields() {
	<!-- Delegation Control -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.ArrowRightLeft(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Delegation Control") }
		</span>
		<p class="text-[11px] text-muted-foreground">
			{ i18n.T(ctx, "Control whether this agent can hand off work to other agents in a workflow.") }
		</p>
		<div class="space-y-2 ps-1">
			@toggleSwitch("form.disallowTransferToParent", i18n.T(ctx, "Prevent escalation to parent"), i18n.T(ctx, "This agent cannot hand work back to its parent agent."))
			@toggleSwitch("form.disallowTransferToPeers", i18n.T(ctx, "Prevent delegation to siblings"), i18n.T(ctx, "This agent cannot pass work to other agents at the same level."))
		</div>
	</div>
	<!-- Output Variable -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Key(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Output Variable") }
		</span>
		@input.Input(input.Props{
			Placeholder: i18n.T(ctx, "e.g., research_results, draft_content..."),
			Class:       "h-8 text-xs",
			Attributes: templ.Attributes{
				"x-model":   "form.outputKey",
				"maxlength": "100",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "Saves this agent's output so other agents in the workflow can reference it via {variable_name} in their instructions.") }
		</p>
	</div>
	<!-- Conversation History -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.MessageSquare(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Conversation History") }
		</span>
		<div class="flex gap-2">
			<button
				type="button"
				@click="form.includeContents = ''"
				class="flex-1 px-3 py-1.5 rounded-md border text-xs font-medium transition-colors"
				:class="!form.includeContents || form.includeContents === 'default' ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent'"
			>
				{ i18n.T(ctx, "Include History") }
			</button>
			<button
				type="button"
				@click="form.includeContents = 'none'"
				class="flex-1 px-3 py-1.5 rounded-md border text-xs font-medium transition-colors"
				:class="form.includeContents === 'none' ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent'"
			>
				{ i18n.T(ctx, "Fresh Context") }
			</button>
		</div>
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "Choose whether this agent sees the full conversation or only the current message.") }
		</p>
	</div>
	<!-- Shared Instructions -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Globe(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Shared Instructions") }
		</span>
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, "Instructions shared with all agents in the workflow..."),
			Class:       "min-h-[60px] resize-y text-xs",
			Rows:        2,
			Attributes: templ.Attributes{
				"x-model": "form.globalInstruction",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "Applied to every agent in the workflow. Only takes effect when this agent is the root orchestrator.") }
		</p>
	</div>
	<!-- Input Schema -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Braces(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Input Schema (JSON)") }
		</span>
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, `{"type": "object", "properties": {"topic": {"type": "string"}}, "required": ["topic"]}`),
			Class:       "min-h-[60px] resize-y font-mono text-[11px]",
			Rows:        2,
			Attributes: templ.Attributes{
				"x-model": "form.inputSchema",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "Defines the expected input format when another agent calls this one. JSON Schema format.") }
		</p>
	</div>
	<!-- Output Schema -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Braces(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Output Schema (JSON)") }
		</span>
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, `{"type": "object", "properties": {"summary": {"type": "string"}}, "required": ["summary"]}`),
			Class:       "min-h-[60px] resize-y font-mono text-[11px]",
			Rows:        2,
			Attributes: templ.Attributes{
				"x-model": "form.outputSchema",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "Forces the agent to respond in a specific JSON format. When set, tool use is disabled.") }
		</p>
	</div>
}

// toggleSwitch renders a labeled toggle switch for boolean form fields.
templ toggleSwitch(model string, labelText string, helpText string) {
	<label class="flex items-center justify-between gap-2 py-1.5 cursor-pointer">
		<div class="flex-1 min-w-0">
			<span class="text-xs font-medium text-foreground">{ labelText }</span>
			<p class="text-[10px] text-muted-foreground mt-0.5">{ helpText }</p>
		</div>
		<button
			type="button"
			x-on:click={ model + " = !" + model }
			class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
			x-bind:class={ model + " ? 'bg-primary' : 'bg-input'" }
			role="switch"
			x-bind:aria-checked={ model }
		>
			<span
				class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
				x-bind:class={ model + " ? 'translate-x-4' : 'translate-x-0'" }
			></span>
		</button>
	</label>
}

// shortcutRow renders a single keyboard shortcut row for the help overlay.
templ shortcutRow(label string, keys string) {
	<div class="flex items-center justify-between py-1.5 px-2.5 rounded-md hover:bg-muted/50 transition-colors">
		<span class="text-xs text-foreground">{ label }</span>
		<div class="flex items-center gap-1">
			<kbd class="kbd">{ keys }</kbd>
		</div>
	</div>
}

// modelOverrideSection renders a collapsible panel for selecting a specific
// provider + model for this agent, overriding the user's global AI settings.
templ modelOverrideSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showModelOverride = !showModelOverride"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Cpu(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Model") }
				<span
					class="text-[10px] text-muted-foreground"
					x-show="form.modelOverride.provider && form.modelOverride.modelName"
					x-text="form.modelOverride.provider + ' / ' + form.modelOverride.modelName"
				></span>
			</span>
			<span class="transition-transform duration-200" :class="showModelOverride ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showModelOverride" x-collapse class="px-3 pb-3 border-t border-border pt-3 space-y-3">
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "Use a specific AI model for this agent instead of your default. The API key must be configured in Settings.") }
			</p>
			<!-- Provider -->
			<div class="space-y-1.5">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Provider") }</span>
				<select
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
					x-model="form.modelOverride.provider"
					@change="form.modelOverride.modelName = ''; fetchModelsForProvider($event.target.value)"
				>
					<option value="">{ i18n.T(ctx, "— use global default —") }</option>
					<option value="gemini">Gemini (Google)</option>
					<option value="openai">OpenAI</option>
					<option value="anthropic">Anthropic</option>
				</select>
			</div>
			<!-- Model -->
			<div class="space-y-1.5" x-show="form.modelOverride.provider">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Model") }</span>
				<div x-show="providerModelsLoading" class="text-xs text-muted-foreground py-2">{ i18n.T(ctx, "Loading models…") }</div>
				<div x-show="providerModelsError && !providerModelsLoading" class="text-xs text-destructive py-1" x-text="providerModelsError"></div>
				<select
					x-show="!providerModelsLoading"
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
					x-model="form.modelOverride.modelName"
				>
					<option value="">{ i18n.T(ctx, "— select a model —") }</option>
					<template x-for="m in providerModelOptions" :key="m.id">
						<option :value="m.id" x-text="m.displayName"></option>
					</template>
				</select>
			</div>
			<!-- Clear -->
			<button
				type="button"
				x-show="form.modelOverride.provider || form.modelOverride.modelName"
				@click="form.modelOverride = { provider: '', modelName: '' }; providerModelOptions = []; providerModelsError = ''"
				class="text-[11px] text-muted-foreground hover:text-destructive transition-colors"
			>
				{ i18n.T(ctx, "Clear override (use global default)") }
			</button>
		</div>
	</div>
}

// modelSettingsSection renders a collapsible panel for per-agent model generation overrides.
// All fields are optional; when blank they fall back to the user's global AI settings.
templ modelSettingsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showModelSettings = !showModelSettings"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.SlidersHorizontal(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Generation Settings") }
				<span class="text-[10px] text-muted-foreground" x-show="form.modelConfig.temperature !== null || form.modelConfig.topP !== null || form.modelConfig.topK !== null || form.modelConfig.maxOutputTokens !== null || form.modelConfig.stopSequences.length > 0">
					{ i18n.T(ctx, "overrides set") }
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showModelSettings ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showModelSettings" x-collapse class="px-3 pb-3 border-t border-border pt-3 space-y-4">
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "Fine-tune how this agent generates responses. Leave blank to use your defaults.") }
			</p>
			<!-- Temperature -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between">
					<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Temperature") }</span>
					<span class="text-[11px] text-muted-foreground font-mono" x-text="form.modelConfig.temperature !== null && form.modelConfig.temperature !== '' ? form.modelConfig.temperature : '—'"></span>
				</div>
				<input
					type="range"
					min="0"
					max="2"
					step="0.05"
					class="w-full accent-primary"
					x-model.number="form.modelConfig.temperature"
				/>
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Lower values give more focused responses, higher values give more creative ones.") }</p>
			</div>
			<!-- Max Output Tokens -->
			<div class="space-y-1.5">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Max Output Tokens") }</span>
				@input.Input(input.Props{
					Type:        "number",
					Placeholder: i18n.T(ctx, "e.g. 4096 (blank = global default)"),
					Attributes: templ.Attributes{
						"x-model.number": "form.modelConfig.maxOutputTokens",
						"min":            "1",
						"max":            "65536",
					},
				})
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Maximum length of the agent's response (1–65,536 tokens).") }</p>
			</div>
			<!-- Advanced: TopP / TopK -->
			<details class="group">
				<summary class="text-[11px] text-muted-foreground cursor-pointer select-none list-none flex items-center gap-1 hover:text-foreground transition-colors">
					<span class="transition-transform group-open:rotate-90">▶</span>
					{ i18n.T(ctx, "Advanced sampling (TopP / TopK)") }
				</summary>
				<div class="mt-3 space-y-3">
					<!-- TopP -->
					<div class="space-y-1.5">
						<div class="flex items-center justify-between">
							<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Top-P (nucleus sampling)") }</span>
							<span class="text-[11px] text-muted-foreground font-mono" x-text="form.modelConfig.topP !== null && form.modelConfig.topP !== '' ? form.modelConfig.topP : '—'"></span>
						</div>
						<input
							type="range"
							min="0"
							max="1"
							step="0.01"
							class="w-full accent-primary"
							x-model.number="form.modelConfig.topP"
						/>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Controls diversity. 0.9 means the model considers the top 90% most likely words.") }</p>
					</div>
					<!-- TopK -->
					<div class="space-y-1.5">
						<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Top-K") }</span>
						@input.Input(input.Props{
							Type:        "number",
							Placeholder: i18n.T(ctx, "e.g. 40 (blank = model default)"),
							Attributes: templ.Attributes{
								"x-model.number": "form.modelConfig.topK",
								"min":            "1",
							},
						})
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Limits the model to choosing from the top K most likely words.") }</p>
					</div>
				</div>
			</details>
			<!-- Stop Sequences -->
			<div class="space-y-1.5">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Stop Sequences") }</span>
				<div class="flex flex-wrap gap-1 min-h-7 p-1.5 rounded-md border border-input bg-background">
					<template x-for="(seq, idx) in form.modelConfig.stopSequences" :key="idx">
						<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-muted text-[11px] font-mono">
							<span x-text="seq"></span>
							<button type="button" @click="form.modelConfig.stopSequences.splice(idx, 1)" class="text-muted-foreground hover:text-foreground leading-none">&times;</button>
						</span>
					</template>
					<input
						type="text"
						class="flex-1 min-w-[120px] bg-transparent text-[11px] font-mono outline-none placeholder:text-muted-foreground"
						placeholder={ i18n.T(ctx, "Type and press Enter…") }
						@keydown.enter.prevent="
							const v = $event.target.value.trim();
							if (v && !form.modelConfig.stopSequences.includes(v)) {
								form.modelConfig.stopSequences.push(v);
							}
							$event.target.value = '';
						"
					/>
				</div>
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "The agent will stop generating when it encounters any of these strings. Press Enter to add.") }</p>
			</div>
			<!-- Reset button -->
			<button
				type="button"
				@click="form.modelConfig = { temperature: null, topP: null, topK: null, maxOutputTokens: null, stopSequences: [] }"
				class="text-[11px] text-muted-foreground hover:text-destructive transition-colors"
			>
				{ i18n.T(ctx, "Reset to global defaults") }
			</button>
		</div>
	</div>
}

// toolsSection renders the collapsible tools section for an agent in edit mode.
//
// Each plugin and tool row has two independent controls:
//   1. Enable toggle (right side) — allow ↔ block. Binary. Saves immediately.
//   2. "Confirm" mini-toggle — shown only when enabled. Sets require_confirmation.
//      Orthogonal to the enable state: a tool can be enabled with or without confirmation.
//
// A gear (⚙) icon appears next to the confirm toggle when confirmation is on,
// opening a small settings panel for the hint text and per-turn invocation limit.
// Additional future requirements (rate limits, cost budgets, etc.) can be added
// as further independent mini-toggles in the same row without restructuring.
templ toolsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showTools = !showTools"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Blocks(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Tools") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="toolsSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showTools ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showTools" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingTools">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingTools">
				<div>
					<template x-if="agentPlugins.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No plugins available. Add plugins from the Tools sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="plugin in agentPlugins" :key="plugin.id">
							<div class="rounded-md border border-border overflow-hidden">
								<!-- Plugin header row -->
								<div
									class="flex items-center gap-2 p-2 transition-colors"
									:class="plugin.requirement_config?.action === 'block' ? 'bg-muted/30' : ''"
								>
									<!-- Icon -->
									<div
										class="size-7 rounded-md flex items-center justify-center shrink-0 transition-colors"
										:class="plugin.requirement_config?.action === 'block' ? 'bg-muted text-muted-foreground' : 'bg-primary/10 text-primary'"
									>
										@icon.Blocks(icon.Props{Class: "size-3.5"})
									</div>
									<!-- Name + tool count -->
									<div class="flex-1 min-w-0">
										<div
											class="text-xs font-medium truncate transition-colors"
											:class="plugin.requirement_config?.action === 'block' ? 'line-through text-muted-foreground' : 'text-foreground'"
											x-text="plugin.name"
										></div>
										<div class="text-[10px] text-muted-foreground tabular-nums" x-text="plugin.tools.length + ' tools'"></div>
									</div>
									<!-- Confirm mini-toggle — only visible when plugin is enabled.
									     Orthogonal to the enable toggle: pauses before each run and asks user. -->
									<template x-if="plugin.requirement_config?.action !== 'block'">
										<div class="flex items-center gap-1.5 shrink-0">
											<label
												class="flex items-center gap-1 cursor-pointer select-none"
												:title="plugin.requirement_config?.action === 'require_confirmation' ? 'Confirmation required before each run — click to turn off' : 'Click to require user confirmation before each run'"
											>
												<span
													class="text-[10px] transition-colors"
													:class="plugin.requirement_config?.action === 'require_confirmation' ? 'text-amber-600 dark:text-amber-400 font-medium' : 'text-muted-foreground'"
												>{ i18n.T(ctx, "Confirm") }</span>
												<!-- Mini toggle switch -->
												<button
													type="button"
													@click.stop="setToolSetAction(plugin, plugin.requirement_config?.action === 'require_confirmation' ? 'allow' : 'require_confirmation')"
													role="switch"
													:aria-checked="plugin.requirement_config?.action === 'require_confirmation'"
													class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
													:class="plugin.requirement_config?.action === 'require_confirmation' ? 'bg-amber-500' : 'bg-input'"
												>
													<span
														class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200"
														:class="plugin.requirement_config?.action === 'require_confirmation' ? 'translate-x-3' : 'translate-x-0'"
													></span>
												</button>
											</label>
											<!-- Gear icon for confirmation hint + invocation limit -->
											<template x-if="plugin.requirement_config?.action === 'require_confirmation'">
												<button
													type="button"
													@click.stop="openToolSetRequirements(plugin)"
													title="Set confirmation prompt and invocation limits"
													class="p-1 rounded text-amber-500/70 hover:text-amber-600 hover:bg-amber-500/10 transition-colors"
												>
													@icon.SlidersHorizontal(icon.Props{Class: "size-3"})
												</button>
											</template>
										</div>
									</template>
									<!-- Enable/disable toggle — allow ↔ block -->
									<button
										type="button"
										@click.stop="setToolSetAction(plugin, plugin.requirement_config?.action === 'block' ? 'allow' : 'block')"
										role="switch"
										:aria-checked="plugin.requirement_config?.action !== 'block'"
										:title="plugin.requirement_config?.action === 'block' ? 'Enable plugin' : 'Disable plugin'"
										class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
										:class="plugin.requirement_config?.action !== 'block' ? 'bg-primary' : 'bg-input'"
									>
										<span
											class="pointer-events-none inline-block size-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200"
											:class="plugin.requirement_config?.action !== 'block' ? 'translate-x-4' : 'translate-x-0'"
										></span>
									</button>
								</div>
								<!-- Individual tools — shown when plugin is enabled and has multiple tools -->
								<template x-if="plugin.requirement_config?.action !== 'block' && plugin.tools.length > 1">
									<div class="border-t border-border/50 divide-y divide-border/30 bg-background/40">
										<template x-for="tool in plugin.tools" :key="tool.id">
											<div
												class="flex items-center gap-2 px-2 py-1.5 transition-colors"
												:class="tool.requirement_config?.action === 'block' ? 'bg-muted/20' : ''"
											>
												<!-- Indent marker + name -->
												<span class="w-3 shrink-0"></span>
												<span
													class="text-[11px] flex-1 min-w-0 truncate transition-colors"
													:class="tool.requirement_config?.action === 'block' ? 'line-through text-muted-foreground/50' : 'text-muted-foreground'"
													x-text="tool.name"
												></span>
												<!-- Confirm mini-toggle (only when tool is enabled) -->
												<template x-if="tool.requirement_config?.action !== 'block'">
													<div class="flex items-center gap-1 shrink-0">
														<label
															class="flex items-center gap-1 cursor-pointer select-none"
															:title="tool.requirement_config?.action === 'require_confirmation' ? 'Confirmation required — click to turn off' : 'Require confirmation before this tool runs'"
														>
															<span
																class="text-[9px] transition-colors"
																:class="tool.requirement_config?.action === 'require_confirmation' ? 'text-amber-600 dark:text-amber-400 font-medium' : 'text-muted-foreground'"
															>{ i18n.T(ctx, "Confirm") }</span>
															<button
																type="button"
																@click.stop="setToolAction(plugin, tool, tool.requirement_config?.action === 'require_confirmation' ? 'allow' : 'require_confirmation')"
																role="switch"
																:aria-checked="tool.requirement_config?.action === 'require_confirmation'"
																class="relative inline-flex h-3.5 w-6 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
																:class="tool.requirement_config?.action === 'require_confirmation' ? 'bg-amber-500' : 'bg-input'"
															>
																<span
																	class="pointer-events-none inline-block size-2.5 rounded-full bg-background shadow ring-0 transition-transform duration-200"
																	:class="tool.requirement_config?.action === 'require_confirmation' ? 'translate-x-2.5' : 'translate-x-0'"
																></span>
															</button>
														</label>
														<!-- Gear for tool-level confirmation hint/limits -->
														<template x-if="tool.requirement_config?.action === 'require_confirmation'">
															<button
																type="button"
																@click.stop="openToolRequirements(plugin, tool)"
																title="Set confirmation prompt and invocation limits"
																class="p-0.5 rounded text-amber-500/70 hover:text-amber-600 hover:bg-amber-500/10 transition-colors"
															>
																@icon.SlidersHorizontal(icon.Props{Class: "size-2.5"})
															</button>
														</template>
													</div>
												</template>
												<!-- Enable/disable toggle for individual tool -->
												<button
													type="button"
													@click.stop="setToolAction(plugin, tool, tool.requirement_config?.action === 'block' ? 'allow' : 'block')"
													role="switch"
													:aria-checked="tool.requirement_config?.action !== 'block'"
													:title="tool.requirement_config?.action === 'block' ? 'Enable tool' : 'Disable tool'"
													class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
													:class="tool.requirement_config?.action !== 'block' ? 'bg-primary' : 'bg-input'"
												>
													<span
														class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200"
														:class="tool.requirement_config?.action !== 'block' ? 'translate-x-3' : 'translate-x-0'"
													></span>
												</button>
											</div>
										</template>
									</div>
								</template>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
	<!-- Confirmation settings panel — opens via the gear icon when confirm is on.
	     Contains only the hint text and invocation limit; the enable/confirm toggles
	     are inline in the row and do not appear here. -->
	@toolRequirementsDialog()
}

// toolRequirementsDialog renders the confirmation settings panel for a tool or tool set.
// Reached only via the gear (⚙) icon that appears next to the Confirm toggle.
// Contains only the hint text and per-turn invocation limit.
// The enable/disable toggle and the confirm toggle live inline in the tool list rows.
templ toolRequirementsDialog() {
	<!-- Backdrop overlay -->
	<div
		x-show="showRequirementsPanel"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@click.self="closeRequirementsPanel()"
		class="fixed inset-0 z-60 bg-black/40 backdrop-blur-[3px]"
	></div>
	<!-- Dialog content -->
	<div
		x-show="showRequirementsPanel"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 scale-[0.97]"
		x-transition:enter-end="opacity-100 scale-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 scale-100"
		x-transition:leave-end="opacity-0 scale-[0.97]"
		@keydown.escape.window="closeRequirementsPanel()"
		class="fixed z-60 left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] bg-background rounded-2xl border border-border/60 shadow-modern-xl w-full max-w-[calc(100%-2rem)] sm:max-w-md"
	>
		<!-- Header -->
		<div class="flex items-center justify-between px-5 pt-5 pb-0">
			<div class="flex items-center gap-2.5">
				<div class="size-8 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-600 dark:text-amber-400">
					@icon.SlidersHorizontal(icon.Props{Class: "size-4"})
				</div>
				<div>
					<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Confirmation Settings") }</h3>
					<p class="text-xs text-muted-foreground" x-text="reqConfigTarget?.name || ''"></p>
				</div>
			</div>
			<button
				type="button"
				@click="closeRequirementsPanel()"
				class="size-8 rounded-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
			>
				@icon.X(icon.Props{Class: "size-4"})
			</button>
		</div>
		<!-- Body -->
		<div class="px-5 py-4 space-y-4">
			<!-- Confirmation hint -->
			<div class="space-y-2">
				<label class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Confirmation Prompt") }</label>
				@textarea.Textarea(textarea.Props{
					Placeholder: i18n.T(ctx, "e.g., This tool will modify files. Are you sure?"),
					Class:       "min-h-[56px] resize-y text-xs",
					Rows:        2,
					Attributes: templ.Attributes{
						"x-model": "reqConfig.confirmation_hint",
					},
				})
				<p class="text-[11px] text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "Shown to the user before the tool runs. Leave blank to use a default prompt.") }
				</p>
			</div>
			<!-- Max invocations -->
			<div class="space-y-2">
				<label class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Max Invocations per Turn") }</label>
				<input
					type="number"
					min="0"
					x-model.number="reqConfig.max_invocations"
					placeholder="0"
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
				/>
				<p class="text-[11px] text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "Maximum times this tool can run in a single agent turn. 0 means unlimited.") }
				</p>
			</div>
		</div>
		<!-- Footer -->
		<div class="flex items-center justify-end gap-2 px-5 pb-5 pt-0">
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": "closeRequirementsPanel()",
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    "saveRequirementConfig()",
					":disabled": "savingReqConfig",
				},
			}) {
				<span x-show="!savingReqConfig" class="flex items-center gap-1.5">
					@icon.Check(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "Save") }
				</span>
				<span x-show="savingReqConfig" class="flex items-center gap-1.5">
					<span class="animate-spin size-3.5 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Saving...") }
				</span>
			}
		</div>
	</div>
}

// knowledgeBasesSection renders the collapsible KB section for an agent in edit mode.
templ knowledgeBasesSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showKnowledgeBases = !showKnowledgeBases"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Library(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Knowledge Bases") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="kbSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showKnowledgeBases ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showKnowledgeBases" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingKBs">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingKBs">
				<div>
					<template x-if="agentWorkspaces.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No knowledge bases available. Create one from the Resources sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="ws in agentWorkspaces" :key="ws.id">
							<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
								<div class="flex items-center gap-2 flex-1 min-w-0">
									<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
										@icon.Library(icon.Props{Class: "size-3.5"})
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-xs font-medium text-foreground truncate" x-text="ws.name"></div>
										<div class="text-[10px] text-muted-foreground truncate" x-text="ws.description || ws.slug"></div>
									</div>
								</div>
								<button
									@click="toggleAgentWorkspace(ws)"
									class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
									:class="ws.enabled ? 'bg-primary' : 'bg-input'"
									role="switch"
									:aria-checked="ws.enabled"
								>
									<span class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200" :class="ws.enabled ? 'translate-x-4' : 'translate-x-0'"></span>
								</button>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// filesystemsSection renders the collapsible filesystem section for an agent in edit mode.
templ filesystemsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showFilesystems = !showFilesystems"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Folder(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Filesystems") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="fsSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showFilesystems ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showFilesystems" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingFilesystems">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingFilesystems">
				<div>
					<template x-if="agentFilesystems.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No filesystems available. Create one from the Files sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="fs in agentFilesystems" :key="fs.id">
							<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
								<div class="flex items-center gap-2 flex-1 min-w-0">
									<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
										@icon.Folder(icon.Props{Class: "size-3.5"})
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-xs font-medium text-foreground truncate" x-text="fs.name"></div>
										<div class="text-[10px] text-muted-foreground truncate" x-text="fs.description || fs.type"></div>
									</div>
								</div>
								<button
									@click="toggleAgentFilesystem(fs)"
									class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
									:class="fs.enabled ? 'bg-primary' : 'bg-input'"
									role="switch"
									:aria-checked="fs.enabled"
								>
									<span class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200" :class="fs.enabled ? 'translate-x-4' : 'translate-x-0'"></span>
								</button>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// deleteConfirmation renders a reusable delete confirmation view.
templ deleteConfirmation(cancelAction string, deleteAction string) {
	<div class="flex flex-col h-full">
		<div class="p-4 pb-3 border-b border-border">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "Delete Agent") }</h2>
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "This action cannot be undone.") }</p>
		</div>
		<div class="p-6 flex flex-col items-center gap-4">
			<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
				@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
			</div>
			<p class="text-sm text-center text-foreground">
				{ i18n.T(ctx, "Are you sure you want to delete") }
				<span class="font-semibold" x-text="deletingAgent?.name"></span>?
			</p>
		</div>
		<div class="px-4 py-3 border-t mt-auto bg-muted/50 flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": cancelAction,
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    deleteAction,
					":disabled": "saving || pipelineSaving",
				},
			}) {
				<span x-show="!saving && !pipelineSaving">{ i18n.T(ctx, "Delete") }</span>
				<span x-show="saving || pipelineSaving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Deleting...") }
				</span>
			}
		</div>
	</div>
}

// AgentDesignerNavButtonTrigger renders a workflow icon button for the navbar.
templ AgentDesignerNavButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agent-designer-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agent-designer')",
				"title":  i18n.T(ctx, "Agent Designer"),
			},
		}) {
			@icon.Workflow(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Agent Designer") }</span>
		}
	}
}
