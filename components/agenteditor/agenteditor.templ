package agenteditor

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
	"school-with-ai/components/label"
	"school-with-ai/components/textarea"
)

// AgentDesignerDialog is the main dialog for designing agents.
// Two modes: Node Design (single agent) and Pipeline Compose (workflow).
templ AgentDesignerDialog() {
	<div
		x-data="agentDesigner"
		@open-agent-designer.window="open($event.detail?.mode)"
		@open-agent-designer-node.window="open('node'); $nextTick(() => showEditNodeForm($event.detail))"
		@open-agent-designer-pipeline.window="open('pipeline'); $nextTick(() => showEditPipelineForm($event.detail))"
		@agents-updated.window="fetchAgents()"
	>
		@dialog.Dialog(dialog.Props{
			ID: "agent-designer-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-5xl max-h-[90vh] flex flex-col p-0 overflow-hidden transition-all duration-300 ease-in-out",
				Attributes: templ.Attributes{
					":class": "expanded ? '!max-w-[calc(100vw-2rem)] !max-h-[calc(100vh-2rem)] !w-[calc(100vw-2rem)] !h-[calc(100vh-2rem)]' : ''",
				},
			}) {
				<!-- Header with mode tabs -->
				@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
					<div class="flex items-center justify-between mb-3">
						<div>
							@dialog.Title() {
								<span class="flex items-center gap-2">
									@icon.Workflow(icon.Props{Class: "size-5"})
									{ i18n.T(ctx, "Agent Designer") }
								</span>
							}
							@dialog.Description() {
								{ i18n.T(ctx, "Build LLM Agents or compose them into Workflow Agents — Sequential, Parallel, and Loop — powered by ADK-Go.") }
							}
						</div>
						<div class="flex items-center gap-1">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-7 text-muted-foreground",
								Attributes: templ.Attributes{
									"@click": "toggleExpand()",
									"title":  i18n.T(ctx, "Toggle fullscreen"),
								},
							}) {
								<span x-show="!expanded">
									@icon.Maximize2(icon.Props{Class: "size-3.5"})
								</span>
								<span x-show="expanded">
									@icon.Minimize2(icon.Props{Class: "size-3.5"})
								</span>
							}
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"title": i18n.T(ctx, "Close"),
									},
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>
					</div>
					<!-- Mode Tab Bar -->
					<div class="flex gap-0 -mb-px">
						<button
							type="button"
							@click="switchMode('node')"
							class="px-4 py-2 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5"
							:class="mode === 'node' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
						>
							@icon.Bot(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "LLM Agent") }
						</button>
						<button
							type="button"
							@click="switchMode('pipeline')"
							class="px-4 py-2 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5"
							:class="mode === 'pipeline' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
						>
							@icon.GitBranch(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "Workflow Agent") }
						</button>
					</div>
				}
				<!-- ═══════════════════════════════════════════ -->
				<!-- NODE DESIGN MODE                           -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="mode === 'node'">
					<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
						<!-- Node List View -->
						<template x-if="nodeView === 'list'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<div class="px-4 pt-3 pb-2 flex items-center gap-2">
									<div class="flex-1">
										@input.Input(input.Props{
											Type:        input.TypeSearch,
											Placeholder: i18n.T(ctx, "Search LLM agents..."),
											Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
											Attributes: templ.Attributes{
												"x-model.debounce.300ms": "searchQuery",
												"@input":                 "searchAgents()",
											},
										})
									</div>
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantDefault,
										Class:   "gap-1.5 shrink-0",
										Attributes: templ.Attributes{
											"@click": "showCreateNodeForm()",
										},
									}) {
										@icon.Plus(icon.Props{Class: "size-4"})
										{ i18n.T(ctx, "New LLM Agent") }
									}
								</div>
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<template x-if="loading">
										<div class="space-y-3">
											<template x-for="i in 3" :key="i">
												<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
													<div class="size-10 rounded-lg bg-muted"></div>
													<div class="flex-1 space-y-2">
														<div class="h-4 bg-muted rounded-md w-1/3"></div>
														<div class="h-3 bg-muted rounded-md w-2/3"></div>
													</div>
												</div>
											</template>
										</div>
									</template>
									<template x-if="!loading">
										<div>
											<template x-if="filteredAgents.length === 0">
												<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
													@icon.Bot(icon.Props{Class: "size-12 opacity-20"})
													<template x-if="searchQuery">
														<div class="text-center">
															<p class="text-sm font-medium">{ i18n.T(ctx, "No LLM agents found") }</p>
															<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search term.") }</p>
														</div>
													</template>
													<template x-if="!searchQuery">
														<div class="text-center">
															<p class="text-sm font-medium">{ i18n.T(ctx, "No LLM agents yet") }</p>
															<p class="text-xs mt-1">{ i18n.T(ctx, "Create your first LLM agent to get started.") }</p>
															@button.Button(button.Props{
																Size:    button.SizeSm,
																Variant: button.VariantOutline,
																Class:   "mt-3 gap-1.5",
																Attributes: templ.Attributes{
																	"@click": "showCreateNodeForm()",
																},
															}) {
																@icon.Plus(icon.Props{Class: "size-3.5"})
																{ i18n.T(ctx, "Create LLM Agent") }
															}
														</div>
													</template>
												</div>
											</template>
											<!-- Agent Node Cards Grid -->
											<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
												<template x-for="ag in filteredAgents" :key="ag.id">
													<div
														class="group relative rounded-xl border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 cursor-pointer overflow-hidden bg-card"
														@click="showEditNodeForm(ag)"
													>
														<div class="p-4">
															<div class="flex items-start gap-3">
																<!-- Agent Icon -->
																<div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0 [&_svg]:size-5">
																	<span x-html="ag.icon"></span>
																</div>
																<div class="flex-1 min-w-0">
																	<h3 class="text-sm font-semibold text-foreground truncate" x-text="ag.name"></h3>
																	<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="ag.description || 'No description'"></p>
																</div>
															</div>
															<!-- Node metadata -->
															<div class="flex items-center gap-2 mt-3 pt-2 border-t border-border/50">
																@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[9px] px-1.5 py-0 h-4"}) {
																	@icon.Bot(icon.Props{Class: "size-2.5 me-0.5"})
																	{ i18n.T(ctx, "LLM Agent") }
																}
																<span class="text-[10px] text-muted-foreground" x-text="formatDate(ag.createdAt || ag.created_at)"></span>
																<div class="flex-1"></div>
																<div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity" @click.stop>
																	@button.Button(button.Props{
																		Size:    button.SizeIcon,
																		Variant: button.VariantGhost,
																		Class:   "size-7 text-destructive hover:text-destructive",
																		Attributes: templ.Attributes{
																			"@click.stop": "confirmDeleteNode(ag)",
																			"title":       i18n.T(ctx, "Delete"),
																		},
																	}) {
																		@icon.Trash2(icon.Props{Class: "size-3.5"})
																	}
																</div>
															</div>
														</div>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>
						<!-- Node Create/Edit Form View -->
						<template x-if="nodeView === 'form'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50">
									@button.Button(button.Props{
										Size:    button.SizeIcon,
										Variant: button.VariantGhost,
										Class:   "size-8",
										Attributes: templ.Attributes{
											"@click": "nodeView = 'list'",
										},
									}) {
										@icon.ArrowLeft(icon.Props{Class: "size-4"})
									}
									<h3 class="text-sm font-semibold" x-text="editingAgent ? 'Edit LLM Agent' : 'Create LLM Agent'"></h3>
									<span class="text-[10px] text-muted-foreground" x-text="editingAgent ? 'Modify agent instruction &amp; settings' : 'Define the agent\'s role and instruction'"></span>
								</div>
								<div class="flex-1 overflow-y-auto p-4 scrollbar-thin space-y-4">
									@agentNodeForm()
								</div>
								<!-- Save Footer -->
								<div class="px-4 py-3 border-t bg-muted/50 flex items-center justify-end gap-2">
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Class:   "h-8 px-3 text-xs",
										Attributes: templ.Attributes{
											"@click": "nodeView = 'list'",
										},
									}) {
										{ i18n.T(ctx, "Cancel") }
									}
									@button.Button(button.Props{
										Variant: button.VariantDefault,
										Class:   "h-8 px-4 text-xs gap-1.5",
										Attributes: templ.Attributes{
											"@click":    "saveNode()",
											":disabled": "saving || !form.name.trim()",
										},
									}) {
										<span x-show="!saving" x-text="editingAgent ? 'Save Changes' : 'Create LLM Agent'"></span>
										<span x-show="saving" class="flex items-center gap-1.5">
											<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
											{ i18n.T(ctx, "Saving...") }
										</span>
									}
								</div>
							</div>
						</template>
						<!-- Node Delete Confirmation -->
						<template x-if="nodeView === 'delete'">
							@deleteConfirmation("nodeView = 'list'", "deleteNode()")
						</template>
					</div>
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- PIPELINE COMPOSE MODE                      -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="mode === 'pipeline'">
					<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
						<!-- Pipeline Canvas (list) View -->
						<template x-if="pipelineView === 'canvas'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<div class="px-4 pt-3 pb-2 flex items-center gap-2">
									<div class="flex-1">
										@input.Input(input.Props{
											Type:        input.TypeSearch,
											Placeholder: i18n.T(ctx, "Search workflow agents..."),
											Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
											Attributes: templ.Attributes{
												"x-model.debounce.300ms": "pipelineSearchQuery",
												"@input":                 "filterPipelines()",
											},
										})
									</div>
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantDefault,
										Class:   "gap-1.5 shrink-0",
										Attributes: templ.Attributes{
											"@click": "showCreatePipelineForm()",
										},
									}) {
										@icon.Plus(icon.Props{Class: "size-4"})
										{ i18n.T(ctx, "New Workflow Agent") }
									}
								</div>
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<template x-if="loading">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
											<template x-for="i in 4" :key="i">
												<div class="p-4 rounded-lg border border-border animate-pulse">
													<div class="flex items-center gap-3 mb-3">
														<div class="size-10 rounded-lg bg-muted"></div>
														<div class="flex-1 space-y-2">
															<div class="h-4 bg-muted rounded w-2/3"></div>
															<div class="h-3 bg-muted rounded w-1/3"></div>
														</div>
													</div>
												</div>
											</template>
										</div>
									</template>
									<template x-if="!loading">
										<div>
											<template x-if="filteredPipelines.length === 0">
												<div class="flex flex-col items-center justify-center py-12 gap-4 text-muted-foreground">
													@icon.GitBranch(icon.Props{Class: "size-12 opacity-20"})
													<div class="text-center">
														<p class="text-sm font-medium">{ i18n.T(ctx, "No Workflow Agents yet") }</p>
														<p class="text-xs mt-1 max-w-sm">
															{ i18n.T(ctx, "Compose LLM Agents into Workflow Agents using Sequential, Parallel, and Loop patterns — mapping directly to ADK-Go's sequentialagent, parallelagent, and loopagent.") }
														</p>
													</div>
													@button.Button(button.Props{
														Size:    button.SizeSm,
														Variant: button.VariantOutline,
														Class:   "gap-1.5",
														Attributes: templ.Attributes{
															"@click": "showCreatePipelineForm()",
														},
													}) {
														@icon.Plus(icon.Props{Class: "size-3.5"})
														{ i18n.T(ctx, "Create Workflow Agent") }
													}
													<!-- Quick explanation cards -->
													<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-4 w-full max-w-2xl">
														@pipelineTypeCard("sequential", "↓ Sequential", "Runs sub-agents one after another. Each agent completes before the next starts. Use OutputKey + {var} to pass results downstream.", "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20")
														@pipelineTypeCard("parallel", "∥ Parallel", "Runs sub-agents concurrently in isolated branches. Each branch gets its own conversation context. Results are collected and merged.", "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20")
														@pipelineTypeCard("loop", "↻ Loop", "Repeatedly runs sub-agents up to MaxIterations or until a sub-agent signals Escalate. Ideal for iterative refinement cycles.", "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20")
														@pipelineTypeCard("agent", "● LLM Agent", "A leaf node backed by an LLM Agent you created. Set OutputKey to save its output to session state for downstream agents.", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20")
													</div>
												</div>
											</template>
											<!-- Pipeline Cards -->
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
												<template x-for="pipeline in filteredPipelines" :key="pipeline.id">
													<div
														class="group relative rounded-xl border border-border hover:border-indigo-500/30 hover:shadow-md transition-all duration-200 cursor-pointer overflow-hidden bg-card"
														@click="showEditPipelineForm(pipeline)"
													>
														<div class="p-4">
															<div class="flex items-start gap-3">
																<div class="size-10 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-600 dark:text-indigo-400 shrink-0">
																	@icon.GitBranch(icon.Props{Class: "size-5"})
																</div>
																<div class="flex-1 min-w-0">
																	<div class="flex items-center gap-2">
																		<h3 class="text-sm font-semibold text-foreground truncate" x-text="pipeline.name"></h3>
																		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[9px] px-1.5 py-0 h-4 shrink-0 border-indigo-500/30 text-indigo-600 dark:text-indigo-400"}) {
																			@icon.GitBranch(icon.Props{Class: "size-2.5 me-0.5"})
																			{ i18n.T(ctx, "Workflow Agent") }
																		}
																	</div>
																	<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="pipeline.description || 'No description'"></p>
																</div>
															</div>
															<!-- Pipeline stats -->
															<div class="flex items-center gap-3 mt-3 pt-2 border-t border-border/50">
																<template x-if="pipeline.graph">
																	<span class="text-[10px] text-muted-foreground">
																		<span x-text="collectAgentIds(pipeline.graph).length"></span> agents ·
																		<span x-text="countNodes(pipeline.graph)"></span> nodes
																	</span>
																</template>
																<span class="text-[10px] text-muted-foreground" x-text="formatDate(pipeline.createdAt || pipeline.created_at)"></span>
																<div class="flex-1"></div>
																<div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity" @click.stop>
																	@button.Button(button.Props{
																		Size:    button.SizeIcon,
																		Variant: button.VariantGhost,
																		Class:   "size-7 text-destructive hover:text-destructive",
																		Attributes: templ.Attributes{
																			"@click.stop": "confirmDeletePipeline(pipeline)",
																			"title":       i18n.T(ctx, "Delete"),
																		},
																	}) {
																		@icon.Trash2(icon.Props{Class: "size-3.5"})
																	}
																</div>
															</div>
														</div>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>
						<!-- Pipeline Form View (editor with tree builder) -->
						<template x-if="pipelineView === 'form'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50">
									@button.Button(button.Props{
										Size:    button.SizeIcon,
										Variant: button.VariantGhost,
										Class:   "size-8",
										Attributes: templ.Attributes{
											"@click": "pipelineView = 'canvas'",
										},
									}) {
										@icon.ArrowLeft(icon.Props{Class: "size-4"})
									}
									<h3 class="text-sm font-semibold" x-text="editingPipeline ? 'Edit Workflow Agent' : 'Create Workflow Agent'"></h3>
									<div class="flex-1"></div>
									<!-- Validation indicator -->
									<div class="flex items-center gap-1.5">
										<template x-if="isPipelineValid">
											<span class="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
												@icon.CircleCheck(icon.Props{Class: "size-3.5"})
												{ i18n.T(ctx, "Valid") }
											</span>
										</template>
										<template x-if="!isPipelineValid">
											<span class="flex items-center gap-1 text-[10px] text-amber-600 dark:text-amber-400">
												@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
												<span x-text="pipelineErrors.length + ' issue' + (pipelineErrors.length !== 1 ? 's' : '')"></span>
											</span>
										</template>
									</div>
									<!-- Open visual canvas -->
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantOutline,
										Class:   "h-7 px-2.5 text-xs gap-1.5",
										Attributes: templ.Attributes{
											"@click": "openFlowView()",
											"title":  i18n.T(ctx, "Open visual canvas editor"),
										},
									}) {
										@icon.Workflow(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "Canvas") }
									}
								</div>
								<!-- Split panel: left = config, right = tree -->
								<div class="flex-1 overflow-hidden flex" :class="expanded ? '' : ''">
									<!-- Left: Pipeline Config -->
									<div class="w-[320px] shrink-0 border-e border-border overflow-y-auto scrollbar-thin p-4 space-y-4">
										@pipelineConfigForm()
									</div>
									<!-- Right: Tree Builder / Visual -->
									<div class="flex-1 overflow-y-auto scrollbar-thin p-4">
										<div class="space-y-3">
											<!-- Pipeline graph tree builder -->
											<template x-if="pipelineGraph">
												<div>
													<div class="space-y-2" x-data="workflowTreeBuilder()" x-init="init()">
														<div x-html="renderPipelineNode(pipelineGraph, 'graph', 0, false)"></div>
													</div>
													<!-- Stats bar -->
													<div class="flex items-center gap-4 p-2 mt-3 rounded-lg bg-muted/30 border border-border">
														<span class="text-[11px] text-muted-foreground" x-text="countNodes(pipelineGraph) + ' nodes'"></span>
														<span class="text-[11px] text-muted-foreground" x-text="'depth ' + nodeDepth(pipelineGraph)"></span>
														<span class="text-[11px] text-muted-foreground" x-text="collectAgentIds(pipelineGraph).length + ' agents'"></span>
														<template x-if="countNodes(pipelineGraph) >= 50">
															<span class="text-[11px] text-amber-600 dark:text-amber-400 font-medium">{ i18n.T(ctx, "Node limit reached") }</span>
														</template>
													</div>
													<!-- Validation errors -->
													<template x-if="pipelineErrors.length > 0">
														<div class="mt-3 rounded-lg border border-amber-500/30 bg-amber-500/5 p-3 space-y-1">
															<h4 class="text-xs font-medium text-amber-600 dark:text-amber-400 flex items-center gap-1.5">
																@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
																{ i18n.T(ctx, "Validation Issues") }
															</h4>
															<template x-for="err in pipelineErrors" :key="err">
																<p class="text-[11px] text-amber-600/80 dark:text-amber-400/80" x-text="'• ' + err"></p>
															</template>
														</div>
													</template>
												</div>
											</template>
										</div>
									</div>
								</div>
								<!-- Save Footer -->
								<div class="px-4 py-3 border-t bg-muted/50 flex items-center justify-between">
									<span class="text-[10px] text-muted-foreground">
										{ i18n.T(ctx, "Workflow Agents compose LLM Agents via Sequential → Parallel → Loop. Set OutputKey on each agent node and reference it as {key} in downstream Instructions.") }
									</span>
									<div class="flex items-center gap-2">
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Class:   "h-8 px-3 text-xs",
											Attributes: templ.Attributes{
												"@click": "pipelineView = 'canvas'",
											},
										}) {
											{ i18n.T(ctx, "Cancel") }
										}
										@button.Button(button.Props{
											Variant: button.VariantDefault,
											Class:   "h-8 px-4 text-xs gap-1.5",
											Attributes: templ.Attributes{
												"@click":    "savePipeline()",
												":disabled": "pipelineSaving || !pipelineName.trim() || !isPipelineValid",
											},
										}) {
											<span x-show="!pipelineSaving" x-text="editingPipeline ? 'Save Workflow Agent' : 'Create Workflow Agent'"></span>
											<span x-show="pipelineSaving" class="flex items-center gap-1.5">
												<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
												{ i18n.T(ctx, "Saving...") }
											</span>
										}
									</div>
								</div>
							</div>
						</template>
					<!-- ═══════════════════════════════════════════ -->
					<!-- ALPINEFLOW CANVAS VIEW                      -->
					<!-- ═══════════════════════════════════════════ -->
					<template x-if="pipelineView === 'flow'">
						<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
							<!-- Flow Header -->
							<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50 shrink-0">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-8",
									Attributes: templ.Attributes{
										"@click": "closeFlowView()",
										"title":  i18n.T(ctx, "Back to tree editor"),
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								<h3 class="text-sm font-semibold" x-text="(editingPipeline ? 'Edit' : 'New') + ' — ' + (pipelineName || 'Workflow Agent')"></h3>
								<div class="flex-1"></div>
								<button
									@click="$store.flow.undo()"
									:disabled="!$store.flow.canUndo()"
									title="Undo (Ctrl+Z)"
									class="flex items-center gap-1 px-2 py-1 rounded text-xs text-muted-foreground hover:text-foreground hover:bg-muted/60 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
								>
									@icon.Undo2(icon.Props{Class: "size-3.5"})
								</button>
								<button
									@click="$store.flow.autoLayout()"
									title="Auto-arrange layout"
									class="flex items-center gap-1 px-2 py-1 rounded text-xs text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
								>
									@icon.LayoutGrid(icon.Props{Class: "size-3.5"})
									{ i18n.T(ctx, "Auto") }
								</button>
							<div class="flex items-center gap-1">
								<template x-if="isPipelineValid">
									<span class="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
										@icon.CircleCheck(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "Valid") }
									</span>
								</template>
								<template x-if="!isPipelineValid">
									<span class="flex items-center gap-1 text-[10px] text-amber-600 dark:text-amber-400">
										@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
										<span x-text="pipelineErrors.length + ' issue' + (pipelineErrors.length !== 1 ? 's' : '')"></span>
									</span>
								</template>
							</div>
							<!-- Sidebar toggles -->
							<div class="flex items-center gap-1 border-l border-border/30 pl-2 ml-2">
								<button
									@click="toggleFlowViewMode()"
									:title="flowViewMode === 'canvas' ? 'Switch to tree view' : 'Switch to canvas view'"
									class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
									:class="flowViewMode === 'tree' ? 'text-indigo-400 bg-indigo-500/15 hover:bg-indigo-500/25' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
								>
									<template x-if="flowViewMode === 'tree'">
										@icon.GitBranch(icon.Props{Class: "size-3.5"})
									</template>
									<template x-if="flowViewMode === 'canvas'">
										@icon.Workflow(icon.Props{Class: "size-3.5"})
									</template>
								</button>
								<button
									@click="togglePalette()"
									:title="paletteVisible ? 'Hide component palette (Ctrl+[)' : 'Show component palette (Ctrl+[)'"
									class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
									:class="paletteVisible ? 'text-indigo-400 bg-indigo-500/15 hover:bg-indigo-500/25' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
								>
									@icon.PanelLeft(icon.Props{Class: "size-3.5"})
								</button>
								<button
									@click="togglePropertyPanel()"
									:title="propertyPanelVisible ? 'Hide property panel (Ctrl+])' : 'Show property panel (Ctrl+])'"
									class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
									:class="propertyPanelVisible ? 'text-indigo-400 bg-indigo-500/15 hover:bg-indigo-500/25' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
								>
									@icon.PanelRight(icon.Props{Class: "size-3.5"})
								</button>
								<template x-if="!paletteVisible || !propertyPanelVisible">
									<button
										@click="paletteVisible = true; propertyPanelVisible = true"
										title="Show all panels"
										class="flex items-center justify-center w-7 h-7 rounded text-xs text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-all duration-150"
									>
										@icon.LayoutPanelLeft(icon.Props{Class: "size-3.5"})
									</button>
								</template>
							</div>
								@button.Button(button.Props{
									Variant: button.VariantDefault,
									Class:   "h-8 px-4 text-xs gap-1.5",
									Attributes: templ.Attributes{
										"@click":    "saveFromFlowView()",
										":disabled": "pipelineSaving || !pipelineName.trim()",
									},
								}) {
									<span x-show="!pipelineSaving" x-text="editingPipeline ? 'Save' : 'Create'"></span>
									<span x-show="pipelineSaving" class="flex items-center gap-1.5">
										<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
									</span>
								}
							</div>
							<!-- Pipeline name + description bar -->
							<div class="flex items-center gap-2 px-3 py-1.5 border-b border-border/50 bg-muted/20 shrink-0">
								<span class="text-[10px] text-muted-foreground shrink-0">{ i18n.T(ctx, "Name") }</span>
								<input
									x-model="pipelineName"
									type="text"
									placeholder="Workflow Agent name..."
									class="flex-1 bg-transparent text-xs text-foreground outline-none placeholder:text-muted-foreground"
								/>
								<span class="text-[10px] text-muted-foreground shrink-0 border-l border-border/50 pl-2">{ i18n.T(ctx, "Desc") }</span>
								<input
									x-model="pipelineDescription"
									type="text"
									placeholder="Optional description..."
									class="flex-1 bg-transparent text-xs text-foreground outline-none placeholder:text-muted-foreground"
								/>
							</div>
							<!-- Three-panel layout: Palette | Canvas | Property Panel -->
							<div class="flex flex-1 overflow-hidden">
								<!-- LEFT: Palette -->
								<div
									x-data="alpineflowPalette"
									x-show="paletteVisible"
									x-transition:enter="transition-all duration-200 ease-out"
									x-transition:enter-start="opacity-0 -translate-x-full"
									x-transition:enter-end="opacity-100 translate-x-0"
									x-transition:leave="transition-all duration-150 ease-in"
									x-transition:leave-start="opacity-100 translate-x-0"
									x-transition:leave-end="opacity-0 -translate-x-full"
									class="w-52 shrink-0 border-r border-border/60 flex flex-col overflow-hidden"
									style="background:#0f1117;"
								>
									<!-- Search -->
									<div class="p-2.5 border-b border-border/40">
										<input
											x-model="search"
											type="search"
											placeholder="Search agents..."
											class="w-full text-xs rounded-lg px-2.5 py-1.5 text-gray-200 placeholder:text-gray-600 outline-none focus:ring-1 focus:ring-indigo-500/50"
											style="background:#1a1f2e; border:1px solid rgba(255,255,255,0.07);"
										/>
									</div>
									<!-- Container types -->
									<div class="p-2.5 border-b border-border/40 space-y-0.5">
										<p class="text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-2 px-1">{ i18n.T(ctx, "Containers") }</p>
										<template x-for="t in compositeTypes" :key="t.type">
											<div
												draggable="true"
												@dragstart="onDragStartType($event, t.type)"
												class="flex items-center gap-2.5 px-2 py-2 rounded-lg cursor-grab active:cursor-grabbing select-none transition-colors"
												style="&amp;:hover { background:rgba(255,255,255,0.04); }"
												:style="`&amp;:hover { background:rgba(255,255,255,0.04); }`"
												onmouseenter="this.style.background='rgba(255,255,255,0.04)'"
												onmouseleave="this.style.background='transparent'"
											>
												<div class="shrink-0 w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-bold" :style="`background:${t.color}18; color:${t.color}`" x-text="t.char"></div>
												<div class="min-w-0">
													<div class="text-[11px] font-medium text-gray-200" x-text="t.label"></div>
													<div class="text-[9px] text-gray-600 truncate" x-text="t.desc"></div>
												</div>
											</div>
										</template>
									</div>
									<!-- LLM Agents -->
									<div class="flex-1 overflow-y-auto p-2.5 space-y-0.5 scrollbar-thin">
										<p class="text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-2 px-1">{ i18n.T(ctx, "LLM Agents") }</p>
										<template x-if="filteredAgents.length === 0">
											<p class="text-[10px] text-gray-600 px-1 italic py-2">{ i18n.T(ctx, "No agents") }</p>
										</template>
										<template x-for="agent in filteredAgents" :key="agent.id">
											<div
												draggable="true"
												@dragstart="onDragStartAgent($event, agent)"
												class="flex items-center gap-2.5 px-2 py-2 rounded-lg cursor-grab active:cursor-grabbing select-none transition-colors"
												onmouseenter="this.style.background='rgba(5,150,105,0.08)'"
												onmouseleave="this.style.background='transparent'"
											>
												<div class="shrink-0 w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-bold" style="background:#05966918; color:#059669;">A</div>
												<div class="min-w-0">
													<div class="text-[11px] font-medium text-gray-200 truncate" x-text="agent.name"></div>
													<div class="text-[9px] text-gray-600 truncate" x-text="agent.description || 'LLM Agent'"></div>
												</div>
											</div>
										</template>
										<!-- Remote connectors -->
										<template x-if="connectors.length > 0">
											<div class="mt-3 space-y-0.5">
												<p class="text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-2 px-1">{ i18n.T(ctx, "Remote A2A") }</p>
												<template x-for="conn in connectors" :key="conn.id">
													<div
														draggable="true"
														@dragstart="onDragStartConnector($event, conn)"
														class="flex items-center gap-2.5 px-2 py-2 rounded-lg cursor-grab active:cursor-grabbing select-none transition-colors"
														onmouseenter="this.style.background='rgba(190,18,60,0.08)'"
														onmouseleave="this.style.background='transparent'"
													>
														<div class="shrink-0 w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-bold" style="background:#be123c18; color:#be123c;">R</div>
														<div class="min-w-0">
															<div class="text-[11px] font-medium text-gray-200 truncate" x-text="conn.name || conn.id"></div>
															<div class="text-[9px] text-gray-600">Remote A2A</div>
														</div>
													</div>
												</template>
											</div>
										</template>
									</div>
									<div class="p-2.5 border-t border-border/40">
										<p class="text-[8px] text-gray-700 leading-relaxed font-mono">{ i18n.T(ctx, "Drag items onto the canvas to add them") }</p>
									</div>
								</div>
								<!-- CENTER: Canvas or Tree View -->
								<!-- Tree View (default) -->
								<template x-if="flowViewMode === 'tree'">
									<div
										x-data="editableWorkflowTree()"
										x-init="init()"
										class="flex-1 overflow-auto"
										style="background:#0d1117;"
									>
										<div class="ewt-pipeline-canvas">
											<!-- Tree will be rendered here -->
										</div>
									</div>
								</template>
								<!-- Canvas View -->
								<template x-if="flowViewMode === 'canvas'">
									<div
										x-data="alpineflowCanvas"
										data-flow-canvas
										class="flex-1 relative overflow-hidden select-none"
										:style="'background-color:#0d1117;' + gridBg"
										@wheel.prevent="onWheel"
										@mousedown="onMouseDown"
										@dragover.prevent="onDragOver"
										@drop="onDrop"
										x-effect="Alpine.store('flow').canvasEl = $el"
									>
									<!-- Dot-grid overlay -->
									<div
										class="pointer-events-none absolute inset-0"
										style="background-image:radial-gradient(circle,rgba(255,255,255,.07) 1px,transparent 1px);background-size:28px 28px;"
										:style="'background-position:' + (($store.flow.panX % 28 + 28) % 28) + 'px ' + (($store.flow.panY % 28 + 28) % 28) + 'px'"
									></div>
									<!-- Transform group -->
									<div
										class="absolute top-0 left-0 pointer-events-none"
										style="width:6000px;height:6000px;transform-origin:0 0;"
										:style="'transform:' + transform"
									>
										<!-- SVG edge layer — rendered via x-html to avoid <template> inside SVG namespace -->
										<svg
											class="absolute inset-0 overflow-visible"
											style="width:6000px;height:6000px;pointer-events:none;"
											x-html="edgesSvgContent"
										></svg>
										<!-- Node layer -->
										<template x-for="flatNode in $store.flow.flatNodes" :key="flatNode.id">
											<div
												x-data="alpineflowNode(flatNode.id)"
												:style="nodeStyle"
												class="absolute pointer-events-auto"
											>
												<!-- Input port (hidden for root) -->
												<div
													class="absolute left-1/2 -translate-x-1/2 -top-3.5 z-20 w-7 h-7 flex items-center justify-center"
													x-show="!isRoot"
												>
													<div
														class="w-3.5 h-3.5 rounded-full border-2 cursor-crosshair transition-all duration-200 hover:scale-125"
														:style="`background:#0d1117; border-color:${$store.flow.connecting ? '#818cf8' : typeColor};` + ($store.flow.connecting ? 'box-shadow:0 0 0 3px ' + typeColor + '30;' : '')"
														@mouseup.stop="onInputPortMouseUp"
													></div>
												</div>
												<!-- Node card -->
												<div
													class="rounded-2xl overflow-hidden cursor-pointer transition-all duration-150 hover:brightness-110"
													:style="'background:#13171f;' + cardStyle"
													@mousedown.stop="onHeaderMouseDown"
												>
													<!-- Top colour accent bar -->
													<div class="h-[3px] w-full" :style="'background:' + typeColor + ';' + (isSelected ? 'opacity:1;' : 'opacity:0.6;')"></div>
													<!-- Header row -->
													<div class="flex items-center gap-2 px-3 pt-2.5 pb-2 cursor-grab active:cursor-grabbing">
														<!-- Type icon badge -->
														<div
															class="shrink-0 w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-bold select-none"
															:style="'background:' + typeColor + '1a; color:' + typeColor"
															x-text="typeChar"
														></div>
														<!-- Node name -->
														<span class="text-[11px] font-semibold text-gray-100 truncate flex-1 leading-tight" x-text="displayLabel"></span>
														<!-- Type chip -->
														<span
															class="shrink-0 text-[8px] uppercase tracking-widest font-semibold px-1.5 py-0.5 rounded-full"
															:style="'background:' + typeColor + '18; color:' + typeColor"
															x-text="typeLabel"
														></span>
														<!-- Collapse toggle (composite only) -->
														<button
															x-show="isComposite"
															@click.stop="toggleCollapse()"
															:title="n.collapsed ? 'Expand' : 'Collapse'"
															class="ml-1 opacity-30 hover:opacity-80 transition-opacity text-gray-400"
														>
															<svg class="size-3" viewBox="0 0 10 10" fill="currentColor">
																<path x-show="!n.collapsed" d="M5 7L1 3h8z"/>
																<path x-show="n.collapsed" d="M7 5L3 1v8z"/>
															</svg>
														</button>
													</div>
													<!-- Body -->
													<div class="px-3 pb-3 space-y-1">
														<!-- Unconfigured warning -->
														<div x-show="isUnconfigured" class="flex items-center gap-1.5 text-amber-400/80">
															<span class="text-[9px]">⚠</span>
															<span class="text-[10px]">Not configured</span>
														</div>
														<!-- Body text -->
														<p x-show="!isUnconfigured && bodyText" class="text-[11px] text-gray-400 truncate leading-snug" x-text="bodyText"></p>
														<!-- Output key badge -->
														<p x-show="outputKeyBadge" class="font-mono text-[9px] text-indigo-400/60 truncate" x-text="outputKeyBadge"></p>
													</div>
													<!-- Quick-add strip (composite, not collapsed) -->
													<template x-if="isComposite && !n.collapsed">
														<div class="flex gap-1 flex-wrap px-2.5 py-2 border-t border-white/[0.05] bg-white/[0.02]">
															<button @click.stop="addChildNode('agent')"      class="text-[8px] px-2 py-0.5 rounded-full bg-emerald-500/10 hover:bg-emerald-500/25 text-emerald-400/70 hover:text-emerald-300 transition-colors font-medium">+ Agent</button>
															<button @click.stop="addChildNode('sequential')" class="text-[8px] px-2 py-0.5 rounded-full bg-violet-500/10  hover:bg-violet-500/25  text-violet-400/70  hover:text-violet-300  transition-colors font-medium">+ Seq</button>
															<button @click.stop="addChildNode('parallel')"   class="text-[8px] px-2 py-0.5 rounded-full bg-sky-500/10    hover:bg-sky-500/25    text-sky-400/70    hover:text-sky-300    transition-colors font-medium">+ Par</button>
															<button @click.stop="addChildNode('loop')"       class="text-[8px] px-2 py-0.5 rounded-full bg-amber-500/10  hover:bg-amber-500/25  text-amber-400/70  hover:text-amber-300  transition-colors font-medium">+ Loop</button>
														</div>
													</template>
												</div>
												<!-- Output port -->
												<div class="absolute left-1/2 -translate-x-1/2 -bottom-3.5 z-20 w-7 h-7 flex items-center justify-center">
													<div
														class="w-3.5 h-3.5 rounded-full border-2 cursor-crosshair transition-all duration-200 hover:scale-125"
														:style="`border-color:${typeColor}; background:${$store.flow.connecting?.sourceId===nodeId ? typeColor : '#0d1117'};` + ($store.flow.connecting?.sourceId===nodeId ? 'box-shadow:0 0 8px ' + typeColor + '80;' : '')"
														@mousedown.stop="onOutputPortMouseDown"
													></div>
												</div>
											</div>
										</template>
									</div>
								<!-- Zoom + fit controls -->
								<div class="absolute bottom-4 right-4 flex items-center gap-1 z-20">
									<button @click="zoomOut()" title="Zoom out" class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#1e2533]/90 border border-white/10 text-gray-300 text-sm hover:bg-[#252d3d] hover:text-white transition-colors backdrop-blur-sm">−</button>
									<button @click="zoomReset()" title="Reset zoom" class="h-7 px-2 min-w-[3rem] flex items-center justify-center rounded-lg bg-[#1e2533]/90 border border-white/10 text-gray-300 text-[10px] font-mono hover:bg-[#252d3d] hover:text-white transition-colors backdrop-blur-sm" x-text="zoomLabel"></button>
									<button @click="zoomIn()" title="Zoom in" class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#1e2533]/90 border border-white/10 text-gray-300 text-sm hover:bg-[#252d3d] hover:text-white transition-colors backdrop-blur-sm">+</button>
									<div class="w-px h-5 bg-white/10 mx-0.5"></div>
									<button @click="centerGraph()" title="Center graph" class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#1e2533]/90 border border-white/10 text-gray-300 text-sm hover:bg-[#252d3d] hover:text-white transition-colors backdrop-blur-sm">⊕</button>
									<button @click="fitToView()" title="Fit to view" class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#1e2533]/90 border border-white/10 text-gray-300 text-sm hover:bg-[#252d3d] hover:text-white transition-colors backdrop-blur-sm">⊡</button>
									<button @click="fitAll()" title="Auto-layout &amp; fit" class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#1e2533]/90 border border-white/10 text-gray-300 text-sm hover:bg-[#252d3d] hover:text-white transition-colors backdrop-blur-sm">⊞</button>
								</div>
								<!-- Keyboard hint -->
								<div class="absolute bottom-4 left-4 text-[9px] text-gray-700 z-20 select-none pointer-events-none font-mono tracking-wide">
									{ i18n.T(ctx, "Click to select · Drag to move · Pull port to connect · Scroll = zoom · Space+drag = pan · Del = delete · F = fit · C = center") }
								</div>
								</div>
								</template>
								<!-- RIGHT: Property Panel -->
								<div
									x-data="alpineflowPropertyPanel"
									x-show="propertyPanelVisible"
									x-transition:enter="transition-all duration-200 ease-out"
									x-transition:enter-start="opacity-0 translate-x-full"
									x-transition:enter-end="opacity-100 translate-x-0"
									x-transition:leave="transition-all duration-150 ease-in"
									x-transition:leave-start="opacity-100 translate-x-0"
									x-transition:leave-end="opacity-0 translate-x-full"
									class="w-64 shrink-0 border-l overflow-y-auto scrollbar-thin flex flex-col"
									style="background:#0c0f16; border-color:rgba(255,255,255,0.07);"
								>
									<template x-if="!node">
										<div class="flex flex-col h-full">
											<div class="flex flex-col items-center justify-center flex-1 px-4 py-10 text-center space-y-2">
												<div class="w-10 h-10 rounded-full flex items-center justify-center mb-1" style="background:rgba(255,255,255,0.04);">
													<svg class="size-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
												</div>
												<p class="text-[11px] text-gray-600 leading-relaxed">{ i18n.T(ctx, "Click a node to inspect and edit its properties.") }</p>
											</div>
											<div class="border-t p-3 space-y-2" style="border-color:rgba(255,255,255,0.06);">
												<p class="text-[8px] uppercase tracking-widest text-gray-600 font-semibold">{ i18n.T(ctx, "Pipeline System Prompt") }</p>
												<textarea
													x-model="$store.flow.systemPrompt"
													rows="6"
													placeholder="Global instruction for the root orchestrator..."
													class="w-full text-[11px] rounded-lg px-2.5 py-2 text-gray-300 placeholder:text-gray-700 outline-none resize-none focus:ring-1 focus:ring-indigo-500/40"
													style="background:#131720; border:1px solid rgba(255,255,255,0.07);"
												></textarea>
											</div>
										</div>
									</template>
									<template x-if="node">
										<div class="flex flex-col h-full">
											<div class="flex items-center gap-2 px-3 py-2.5 border-b shrink-0" style="border-color:rgba(255,255,255,0.07);">
												<div
													class="shrink-0 w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-bold"
													:style="'background:' + nodeTypeColor + '18; color:' + nodeTypeColor"
													x-text="nodeTypeChar"
												></div>
												<span class="text-[11px] font-semibold text-gray-200 capitalize flex-1 truncate" x-text="node.type"></span>
												<div class="flex items-center gap-0.5">
													<button @click="moveUp()" :disabled="!canMoveUp" title="Move up" class="w-6 h-6 flex items-center justify-center rounded hover:bg-white/5 text-gray-600 hover:text-gray-300 disabled:opacity-20 disabled:cursor-not-allowed transition-colors text-sm">↑</button>
													<button @click="moveDown()" :disabled="!canMoveDown" title="Move down" class="w-6 h-6 flex items-center justify-center rounded hover:bg-white/5 text-gray-600 hover:text-gray-300 disabled:opacity-20 disabled:cursor-not-allowed transition-colors text-sm">↓</button>
													<button x-show="!isRoot" @click="deleteNode()" title="Delete node" class="w-6 h-6 flex items-center justify-center rounded hover:bg-red-500/10 text-gray-600 hover:text-red-400 transition-colors text-sm">✕</button>
												</div>
											</div>
											<div class="flex-1 overflow-y-auto p-3 space-y-3 scrollbar-thin">
												<div>
													<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "Label") }</label>
													<input :value="node.label" @input="set('label', $event.target.value)" type="text" placeholder="Display name..." class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-gray-200 placeholder:text-gray-700 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);"/>
												</div>
												<template x-if="node.type === 'agent'">
													<div class="space-y-3">
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "LLM Agent") } <span class="text-rose-500">*</span></label>
															<select :value="node.agent_id" @change="set('agent_id', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-gray-200 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);">
																<option value="">— select agent —</option>
																<template x-for="ag in agents" :key="ag.id">
																	<option :value="ag.id" x-text="ag.name"></option>
																</template>
															</select>
														</div>
														<template x-if="selectedAgent">
															<div class="rounded-lg overflow-hidden" style="background:#131720; border:1px solid rgba(255,255,255,0.08);">
																<div class="flex items-center justify-between px-2.5 py-2" style="background:rgba(255,255,255,0.03); border-bottom:1px solid rgba(255,255,255,0.06);">
																	<span class="text-[10px] font-semibold text-gray-200 truncate" x-text="selectedAgent.name"></span>
																	<button @click="editAgent()" title="Edit agent" class="shrink-0 ml-2 px-2 py-0.5 text-[9px] rounded-md font-medium transition-colors" style="background:rgba(99,102,241,0.15); color:#818cf8;" onmouseenter="this.style.background='rgba(99,102,241,0.25)'" onmouseleave="this.style.background='rgba(99,102,241,0.15)'">Edit ↗</button>
																</div>
																<template x-if="selectedAgent.modelOverride && selectedAgent.modelOverride.modelName">
																	<div class="px-2.5 py-1.5" style="border-bottom:1px solid rgba(255,255,255,0.05);">
																		<span class="text-[9px] font-mono rounded px-1.5 py-0.5 text-gray-500" style="background:rgba(255,255,255,0.05);" x-text="(selectedAgent.modelOverride.provider ? selectedAgent.modelOverride.provider + '/' : '') + selectedAgent.modelOverride.modelName"></span>
																	</div>
																</template>
																<template x-if="selectedAgent.description">
																	<div class="px-2.5 py-2" style="border-bottom:1px solid rgba(255,255,255,0.05);">
																		<p class="text-[10px] text-gray-500 leading-relaxed line-clamp-3" x-text="selectedAgent.description"></p>
																	</div>
																</template>
																<template x-if="selectedAgent.systemPrompt">
																	<div class="px-2.5 py-2">
																		<p class="text-[8px] uppercase tracking-widest text-gray-700 font-semibold mb-1.5">System Prompt</p>
																		<p class="text-[10px] text-gray-500 font-mono leading-relaxed line-clamp-5 whitespace-pre-wrap break-words" x-text="selectedAgent.systemPrompt"></p>
																	</div>
																</template>
																<template x-if="!selectedAgent.systemPrompt && !selectedAgent.description && !(selectedAgent.modelOverride && selectedAgent.modelOverride.modelName)">
																	<div class="px-2.5 py-2">
																		<p class="text-[10px] text-gray-700 italic">No configuration — click Edit ↗ to configure.</p>
																	</div>
																</template>
															</div>
														</template>
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "Output Key") }</label>
															<input :value="node.output_key" @input="set('output_key', $event.target.value)" type="text" placeholder="e.g. result" class="w-full text-[11px] font-mono rounded-lg px-2.5 py-1.5 text-gray-200 placeholder:text-gray-700 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);"/>
														</div>
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "Context Forwarding") }</label>
															<select :value="node.include_contents||'default'" @change="set('include_contents', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-gray-200 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);">
																<option value="default">default</option>
																<option value="none">none (fresh context)</option>
															</select>
														</div>
														<div class="space-y-2 pt-1">
															<label class="flex items-center gap-2.5 cursor-pointer group">
																<input type="checkbox" :checked="node.disallow_transfer_to_parent" @change="set('disallow_transfer_to_parent', $event.target.checked)" class="rounded accent-indigo-500"/>
																<span class="text-[10px] text-gray-500 group-hover:text-gray-400 transition-colors">{ i18n.T(ctx, "Block transfer to parent") }</span>
															</label>
															<label class="flex items-center gap-2.5 cursor-pointer group">
																<input type="checkbox" :checked="node.disallow_transfer_to_peers" @change="set('disallow_transfer_to_peers', $event.target.checked)" class="rounded accent-indigo-500"/>
																<span class="text-[10px] text-gray-500 group-hover:text-gray-400 transition-colors">{ i18n.T(ctx, "Block transfer to peers") }</span>
															</label>
														</div>
													</div>
												</template>
												<template x-if="node.type === 'remote'">
													<div class="space-y-3">
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "A2A Connector") } <span class="text-rose-500">*</span></label>
															<select :value="node.a2a_connector_id" @change="set('a2a_connector_id', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-gray-200 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);">
																<option value="">— select connector —</option>
																<template x-for="conn in connectors" :key="conn.id">
																	<option :value="conn.id" x-text="conn.name || conn.id"></option>
																</template>
															</select>
														</div>
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "Output Key") }</label>
															<input :value="node.output_key" @input="set('output_key', $event.target.value)" type="text" placeholder="e.g. result" class="w-full text-[11px] font-mono rounded-lg px-2.5 py-1.5 text-gray-200 placeholder:text-gray-700 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);"/>
														</div>
													</div>
												</template>
												<template x-if="node.type === 'loop'">
													<div class="space-y-3">
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-gray-600 font-semibold mb-1.5">{ i18n.T(ctx, "Max Iterations") }</label>
															<input :value="node.max_iterations||3" @input="set('max_iterations', parseInt($event.target.value)||1)" type="number" min="1" max="100" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-gray-200 outline-none focus:ring-1 focus:ring-indigo-500/40" style="background:#131720; border:1px solid rgba(255,255,255,0.07);"/>
														</div>
														<label class="flex items-center gap-2.5 cursor-pointer group">
															<input type="checkbox" :checked="node.allow_early_exit" @change="set('allow_early_exit', $event.target.checked)" class="rounded accent-indigo-500"/>
															<span class="text-[10px] text-gray-500 group-hover:text-gray-400 transition-colors">{ i18n.T(ctx, "Allow early exit") }</span>
														</label>
													</div>
												</template>
											</div>
											<div class="px-3 py-2 border-t shrink-0" style="border-color:rgba(255,255,255,0.06);">
												<p class="text-[9px] text-gray-700 font-mono truncate" x-text="'id: ' + node.id"></p>
											</div>
										</div>
									</template>
								</div>
							</div>
							<!-- Validation errors footer -->
							<template x-if="pipelineErrors.length > 0">
								<div class="shrink-0 px-4 py-2 border-t border-amber-500/20 bg-amber-500/5 flex items-start gap-2">
									@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-amber-500 shrink-0 mt-0.5"})
									<div class="flex-1 min-w-0">
										<template x-for="(err, idx) in pipelineErrors.slice(0,3)" :key="idx">
											<p class="text-[10px] text-amber-600 dark:text-amber-400 truncate" x-text="err"></p>
										</template>
										<template x-if="pipelineErrors.length > 3">
											<p class="text-[10px] text-amber-500/70" x-text="'+ ' + (pipelineErrors.length - 3) + ' more'"></p>
										</template>
									</div>
								</div>
							</template>
						</div>
					</template>
						<!-- Pipeline Delete Confirmation -->
						<template x-if="pipelineView === 'delete'">
							@deleteConfirmation("pipelineView = 'canvas'", "deletePipeline()")
						</template>
					</div>
				</template>
				<!-- Footer (only on list views) -->
				<template x-if="(mode === 'node' && nodeView === 'list') || (mode === 'pipeline' && pipelineView === 'canvas')">
					@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
						<div class="flex items-center justify-between w-full">
							<span class="text-xs text-muted-foreground">
								<template x-if="mode === 'node'">
									<span x-text="`${filteredAgents.length} LLM agent${filteredAgents.length !== 1 ? 's' : ''}`"></span>
								</template>
								<template x-if="mode === 'pipeline'">
									<span x-text="`${filteredPipelines.length} workflow agent${filteredPipelines.length !== 1 ? 's' : ''}`"></span>
								</template>
							</span>
							@dialog.Close() {
								@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
									{ i18n.T(ctx, "Close") }
								}
							}
						</div>
					}
				</template>
			}
		}
	</div>
}

// agentNodeForm renders the form fields for designing a single agent node.
// Maps to ADK-Go llmagent.Config: Name, Description, Instruction, Tools, etc.
templ agentNodeForm() {
	<!-- Agent Name -->
	<div class="space-y-2">
		@label.Label(label.Props{}) {
			{ i18n.T(ctx, "Agent Name") }
			<span class="text-destructive">*</span>
		}
		@input.Input(input.Props{
			Placeholder: i18n.T(ctx, "e.g., Writing Coach, Code Reviewer..."),
			Attributes: templ.Attributes{
				"x-model":   "form.name",
				"maxlength": "100",
			},
		})
	</div>
	<!-- Description -->
	<div class="space-y-2">
		@label.Label(label.Props{}) {
			{ i18n.T(ctx, "Description") }
		}
		@input.Input(input.Props{
			Placeholder: i18n.T(ctx, "Brief description of what this agent does..."),
			Attributes: templ.Attributes{
				"x-model":   "form.description",
				"maxlength": "500",
			},
		})
	</div>
	<!-- System Prompt (maps to llmagent Instruction) -->
	<div class="space-y-2">
		@label.Label(label.Props{}) {
			{ i18n.T(ctx, "Instruction") }
			<span class="text-destructive">*</span>
		}
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, "Define this agent's role, expertise, and behavior. Use {output_key} syntax to reference results from upstream agents in a workflow."),
			Class:       "min-h-[120px] resize-y",
			Rows:        5,
			Attributes: templ.Attributes{
				"x-model": "form.systemPrompt",
			},
		})
		<p class="text-[11px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.Instruction. Supports {key} template syntax to inject session state (e.g., {research_data}). Append ? for optional keys: {var?}.") }
		</p>
	</div>
	<!-- Multi-Agent Orchestration Section -->
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showOrchestration = !showOrchestration"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.GitBranch(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Multi-Agent & Schema Settings") }
				<span class="text-[10px] text-muted-foreground" x-text="orchestrationSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showOrchestration ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showOrchestration" x-collapse class="px-3 pb-3 border-t border-border pt-3 space-y-4">
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "These fields map directly to llmagent.Config in ADK-Go. They control how this agent behaves when composed in a Workflow Agent.") }
			</p>
			@orchestrationFields()
		</div>
	</div>
	<!-- Model Override -->
	@modelOverrideSection()
	<!-- Model Settings -->
	@modelSettingsSection()
	<!-- Tools, KBs, Filesystems (edit mode only) -->
	<template x-if="editingAgent">
		<div class="space-y-4">
			@toolsSection()
			@knowledgeBasesSection()
			@filesystemsSection()
		</div>
	</template>
	<!-- Info notice (create mode) -->
	<template x-if="!editingAgent">
		<div class="border border-border rounded-lg p-3 flex items-start gap-2 bg-muted/30">
			@icon.Info(icon.Props{Class: "size-4 text-muted-foreground shrink-0 mt-0.5"})
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "After creating the agent, you can configure its tools and knowledge bases by editing it.") }
			</p>
		</div>
	</template>
}

// orchestrationFields renders the transfer policy, output key, history, etc.
templ orchestrationFields() {
	<!-- Transfer Policy -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.ArrowRightLeft(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Transfer Policy") }
		</span>
		<p class="text-[11px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.DisallowTransferToParent / DisallowTransferToPeers") }
		</p>
		<div class="space-y-2 ps-1">
			@toggleSwitch("form.disallowTransferToParent", i18n.T(ctx, "Block transfer to parent"), i18n.T(ctx, "Prevents this agent from escalating back to its parent."))
			@toggleSwitch("form.disallowTransferToPeers", i18n.T(ctx, "Block transfer to peers"), i18n.T(ctx, "Prevents this agent from delegating to sibling agents."))
		</div>
	</div>
	<!-- Output Key -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Key(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Output Key") }
		</span>
		@input.Input(input.Props{
			Placeholder: i18n.T(ctx, "e.g., research_results, draft_content..."),
			Class:       "h-8 text-xs",
			Attributes: templ.Attributes{
				"x-model":   "form.outputKey",
				"maxlength": "100",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.OutputKey — stores this agent's final text output in session state. Downstream agents reference it as {key} in their Instruction.") }
		</p>
	</div>
	<!-- Include Contents / History Forwarding -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.MessageSquare(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "History Forwarding") }
		</span>
		<div class="flex gap-2">
			<button
				type="button"
				@click="form.includeContents = ''"
				class="flex-1 px-3 py-1.5 rounded-md border text-xs font-medium transition-colors"
				:class="!form.includeContents || form.includeContents === 'default' ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent'"
			>
				{ i18n.T(ctx, "Include History") }
			</button>
			<button
				type="button"
				@click="form.includeContents = 'none'"
				class="flex-1 px-3 py-1.5 rounded-md border text-xs font-medium transition-colors"
				:class="form.includeContents === 'none' ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent'"
			>
				{ i18n.T(ctx, "Fresh Context") }
			</button>
		</div>
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.IncludeContents. 'Fresh Context' = IncludeContentsNone (agent sees only current turn).") }
		</p>
	</div>
	<!-- Global Instruction -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Globe(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Global Instruction") }
		</span>
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, "Shared instruction applied to all agents in the workflow tree..."),
			Class:       "min-h-[60px] resize-y text-xs",
			Rows:        2,
			Attributes: templ.Attributes{
				"x-model": "form.globalInstruction",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.GlobalInstruction. Propagated to ALL agents in the tree. Only effective when this agent is the root.") }
		</p>
	</div>
	<!-- Input Schema -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Braces(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Input Schema (JSON)") }
		</span>
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, `{"type": "object", "properties": {"topic": {"type": "string"}}, "required": ["topic"]}`),
			Class:       "min-h-[60px] resize-y font-mono text-[11px]",
			Rows:        2,
			Attributes: templ.Attributes{
				"x-model": "form.inputSchema",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.InputSchema. Defines expected input when this agent is invoked as a tool (via agent transfer).") }
		</p>
	</div>
	<!-- Output Schema -->
	<div class="space-y-2">
		<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
			@icon.Braces(icon.Props{Class: "size-3.5 text-muted-foreground"})
			{ i18n.T(ctx, "Output Schema (JSON)") }
		</span>
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, `{"type": "object", "properties": {"summary": {"type": "string"}}, "required": ["summary"]}`),
			Class:       "min-h-[60px] resize-y font-mono text-[11px]",
			Rows:        2,
			Attributes: templ.Attributes{
				"x-model": "form.outputSchema",
			},
		})
		<p class="text-[10px] text-muted-foreground">
			{ i18n.T(ctx, "→ llmagent.Config.OutputSchema (via GenerateContentConfig.ResponseSchema). Forces structured JSON output. When set, tool use is disabled.") }
		</p>
	</div>
}

// toggleSwitch renders a labeled toggle switch for boolean form fields.
templ toggleSwitch(model string, labelText string, helpText string) {
	<label class="flex items-center justify-between gap-2 py-1.5 cursor-pointer">
		<div class="flex-1 min-w-0">
			<span class="text-xs font-medium text-foreground">{ labelText }</span>
			<p class="text-[10px] text-muted-foreground mt-0.5">{ helpText }</p>
		</div>
		<button
			type="button"
			x-on:click={ model + " = !" + model }
			class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
			x-bind:class={ model + " ? 'bg-primary' : 'bg-input'" }
			role="switch"
			x-bind:aria-checked={ model }
		>
			<span
				class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
				x-bind:class={ model + " ? 'translate-x-4' : 'translate-x-0'" }
			></span>
		</button>
	</label>
}

// modelOverrideSection renders a collapsible panel for selecting a specific
// provider + model for this agent, overriding the user's global AI settings.
templ modelOverrideSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showModelOverride = !showModelOverride"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Cpu(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Model Override") }
				<span
					class="text-[10px] text-muted-foreground"
					x-show="form.modelOverride.provider && form.modelOverride.modelName"
					x-text="form.modelOverride.provider + ' / ' + form.modelOverride.modelName"
				></span>
			</span>
			<span class="transition-transform duration-200" :class="showModelOverride ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showModelOverride" x-collapse class="px-3 pb-3 border-t border-border pt-3 space-y-3">
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "Use a specific provider and model for this agent instead of your global default. The API key must already be configured in Settings › AI.") }
			</p>
			<!-- Provider -->
			<div class="space-y-1.5">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Provider") }</span>
				<select
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
					x-model="form.modelOverride.provider"
					@change="form.modelOverride.modelName = ''; fetchModelsForProvider($event.target.value)"
				>
					<option value="">{ i18n.T(ctx, "— use global default —") }</option>
					<option value="gemini">Gemini (Google)</option>
					<option value="openai">OpenAI</option>
					<option value="anthropic">Anthropic</option>
				</select>
			</div>
			<!-- Model -->
			<div class="space-y-1.5" x-show="form.modelOverride.provider">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Model") }</span>
				<div x-show="providerModelsLoading" class="text-xs text-muted-foreground py-2">{ i18n.T(ctx, "Loading models…") }</div>
				<div x-show="providerModelsError && !providerModelsLoading" class="text-xs text-destructive py-1" x-text="providerModelsError"></div>
				<select
					x-show="!providerModelsLoading"
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
					x-model="form.modelOverride.modelName"
				>
					<option value="">{ i18n.T(ctx, "— select a model —") }</option>
					<template x-for="m in providerModelOptions" :key="m.id">
						<option :value="m.id" x-text="m.displayName"></option>
					</template>
				</select>
			</div>
			<!-- Clear -->
			<button
				type="button"
				x-show="form.modelOverride.provider || form.modelOverride.modelName"
				@click="form.modelOverride = { provider: '', modelName: '' }; providerModelOptions = []; providerModelsError = ''"
				class="text-[11px] text-muted-foreground hover:text-destructive transition-colors"
			>
				{ i18n.T(ctx, "Clear override (use global default)") }
			</button>
		</div>
	</div>
}

// modelSettingsSection renders a collapsible panel for per-agent model generation overrides.
// All fields are optional; when blank they fall back to the user's global AI settings.
templ modelSettingsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showModelSettings = !showModelSettings"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.SlidersHorizontal(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Model Settings") }
				<span class="text-[10px] text-muted-foreground" x-show="form.modelConfig.temperature !== null || form.modelConfig.topP !== null || form.modelConfig.topK !== null || form.modelConfig.maxOutputTokens !== null || form.modelConfig.stopSequences.length > 0">
					{ i18n.T(ctx, "overrides set") }
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showModelSettings ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showModelSettings" x-collapse class="px-3 pb-3 border-t border-border pt-3 space-y-4">
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "Override model generation parameters for this agent. Leave blank to inherit from your global AI settings.") }
			</p>
			<!-- Temperature -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between">
					<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Temperature") }</span>
					<span class="text-[11px] text-muted-foreground font-mono" x-text="form.modelConfig.temperature !== null && form.modelConfig.temperature !== '' ? form.modelConfig.temperature : '—'"></span>
				</div>
				<input
					type="range"
					min="0"
					max="2"
					step="0.05"
					class="w-full accent-primary"
					x-model.number="form.modelConfig.temperature"
				/>
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "0 = deterministic, 2 = creative. Controls output randomness. → GenerateContentConfig.Temperature") }</p>
			</div>
			<!-- Max Output Tokens -->
			<div class="space-y-1.5">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Max Output Tokens") }</span>
				@input.Input(input.Props{
					Type:        "number",
					Placeholder: i18n.T(ctx, "e.g. 4096 (blank = global default)"),
					Attributes: templ.Attributes{
						"x-model.number": "form.modelConfig.maxOutputTokens",
						"min":            "1",
						"max":            "65536",
					},
				})
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Maximum tokens in the response. Range 1–65536. → GenerateContentConfig.MaxOutputTokens") }</p>
			</div>
			<!-- Advanced: TopP / TopK -->
			<details class="group">
				<summary class="text-[11px] text-muted-foreground cursor-pointer select-none list-none flex items-center gap-1 hover:text-foreground transition-colors">
					<span class="transition-transform group-open:rotate-90">▶</span>
					{ i18n.T(ctx, "Advanced sampling (TopP / TopK)") }
				</summary>
				<div class="mt-3 space-y-3">
					<!-- TopP -->
					<div class="space-y-1.5">
						<div class="flex items-center justify-between">
							<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Top-P (nucleus sampling)") }</span>
							<span class="text-[11px] text-muted-foreground font-mono" x-text="form.modelConfig.topP !== null && form.modelConfig.topP !== '' ? form.modelConfig.topP : '—'"></span>
						</div>
						<input
							type="range"
							min="0"
							max="1"
							step="0.01"
							class="w-full accent-primary"
							x-model.number="form.modelConfig.topP"
						/>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Cumulative probability threshold. 0.9 = top 90% of tokens considered. → GenerateContentConfig.TopP") }</p>
					</div>
					<!-- TopK -->
					<div class="space-y-1.5">
						<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Top-K") }</span>
						@input.Input(input.Props{
							Type:        "number",
							Placeholder: i18n.T(ctx, "e.g. 40 (blank = model default)"),
							Attributes: templ.Attributes{
								"x-model.number": "form.modelConfig.topK",
								"min":            "1",
							},
						})
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Limit sampling to the top K most likely tokens. → GenerateContentConfig.TopK") }</p>
					</div>
				</div>
			</details>
			<!-- Stop Sequences -->
			<div class="space-y-1.5">
				<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Stop Sequences") }</span>
				<div class="flex flex-wrap gap-1 min-h-[28px] p-1.5 rounded-md border border-input bg-background">
					<template x-for="(seq, idx) in form.modelConfig.stopSequences" :key="idx">
						<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-muted text-[11px] font-mono">
							<span x-text="seq"></span>
							<button type="button" @click="form.modelConfig.stopSequences.splice(idx, 1)" class="text-muted-foreground hover:text-foreground leading-none">&times;</button>
						</span>
					</template>
					<input
						type="text"
						class="flex-1 min-w-[120px] bg-transparent text-[11px] font-mono outline-none placeholder:text-muted-foreground"
						placeholder={ i18n.T(ctx, "Type and press Enter…") }
						@keydown.enter.prevent="
							const v = $event.target.value.trim();
							if (v && !form.modelConfig.stopSequences.includes(v)) {
								form.modelConfig.stopSequences.push(v);
							}
							$event.target.value = '';
						"
					/>
				</div>
				<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Sequences that stop generation when encountered. Press Enter to add each one. → GenerateContentConfig.StopSequences") }</p>
			</div>
			<!-- Reset button -->
			<button
				type="button"
				@click="form.modelConfig = { temperature: null, topP: null, topK: null, maxOutputTokens: null, stopSequences: [] }"
				class="text-[11px] text-muted-foreground hover:text-destructive transition-colors"
			>
				{ i18n.T(ctx, "Reset to global defaults") }
			</button>
		</div>
	</div>
}

// toolsSection renders the collapsible tools section for an agent in edit mode.
//
// Each plugin and tool row has two independent controls:
//   1. Enable toggle (right side) — allow ↔ block. Binary. Saves immediately.
//   2. "Confirm" mini-toggle — shown only when enabled. Sets require_confirmation.
//      Orthogonal to the enable state: a tool can be enabled with or without confirmation.
//
// A gear (⚙) icon appears next to the confirm toggle when confirmation is on,
// opening a small settings panel for the hint text and per-turn invocation limit.
// Additional future requirements (rate limits, cost budgets, etc.) can be added
// as further independent mini-toggles in the same row without restructuring.
templ toolsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showTools = !showTools"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Blocks(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Tools") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="toolsSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showTools ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showTools" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingTools">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingTools">
				<div>
					<template x-if="agentPlugins.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No plugins available. Add plugins from the Tools sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="plugin in agentPlugins" :key="plugin.id">
							<div class="rounded-md border border-border overflow-hidden">
								<!-- Plugin header row -->
								<div
									class="flex items-center gap-2 p-2 transition-colors"
									:class="plugin.requirement_config?.action === 'block' ? 'bg-muted/30' : ''"
								>
									<!-- Icon -->
									<div
										class="size-7 rounded-md flex items-center justify-center shrink-0 transition-colors"
										:class="plugin.requirement_config?.action === 'block' ? 'bg-muted text-muted-foreground' : 'bg-primary/10 text-primary'"
									>
										@icon.Blocks(icon.Props{Class: "size-3.5"})
									</div>
									<!-- Name + tool count -->
									<div class="flex-1 min-w-0">
										<div
											class="text-xs font-medium truncate transition-colors"
											:class="plugin.requirement_config?.action === 'block' ? 'line-through text-muted-foreground' : 'text-foreground'"
											x-text="plugin.name"
										></div>
										<div class="text-[10px] text-muted-foreground tabular-nums" x-text="plugin.tools.length + ' tools'"></div>
									</div>
									<!-- Confirm mini-toggle — only visible when plugin is enabled.
									     Orthogonal to the enable toggle: pauses before each run and asks user. -->
									<template x-if="plugin.requirement_config?.action !== 'block'">
										<div class="flex items-center gap-1.5 shrink-0">
											<label
												class="flex items-center gap-1 cursor-pointer select-none"
												:title="plugin.requirement_config?.action === 'require_confirmation' ? 'Confirmation required before each run — click to turn off' : 'Click to require user confirmation before each run'"
											>
												<span
													class="text-[10px] transition-colors"
													:class="plugin.requirement_config?.action === 'require_confirmation' ? 'text-amber-600 dark:text-amber-400 font-medium' : 'text-muted-foreground'"
												>{ i18n.T(ctx, "Confirm") }</span>
												<!-- Mini toggle switch -->
												<button
													type="button"
													@click.stop="setToolSetAction(plugin, plugin.requirement_config?.action === 'require_confirmation' ? 'allow' : 'require_confirmation')"
													role="switch"
													:aria-checked="plugin.requirement_config?.action === 'require_confirmation'"
													class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
													:class="plugin.requirement_config?.action === 'require_confirmation' ? 'bg-amber-500' : 'bg-input'"
												>
													<span
														class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200"
														:class="plugin.requirement_config?.action === 'require_confirmation' ? 'translate-x-3' : 'translate-x-0'"
													></span>
												</button>
											</label>
											<!-- Gear icon for confirmation hint + invocation limit -->
											<template x-if="plugin.requirement_config?.action === 'require_confirmation'">
												<button
													type="button"
													@click.stop="openToolSetRequirements(plugin)"
													title="Set confirmation prompt and invocation limits"
													class="p-1 rounded text-amber-500/70 hover:text-amber-600 hover:bg-amber-500/10 transition-colors"
												>
													@icon.SlidersHorizontal(icon.Props{Class: "size-3"})
												</button>
											</template>
										</div>
									</template>
									<!-- Enable/disable toggle — allow ↔ block -->
									<button
										type="button"
										@click.stop="setToolSetAction(plugin, plugin.requirement_config?.action === 'block' ? 'allow' : 'block')"
										role="switch"
										:aria-checked="plugin.requirement_config?.action !== 'block'"
										:title="plugin.requirement_config?.action === 'block' ? 'Enable plugin' : 'Disable plugin'"
										class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
										:class="plugin.requirement_config?.action !== 'block' ? 'bg-primary' : 'bg-input'"
									>
										<span
											class="pointer-events-none inline-block size-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200"
											:class="plugin.requirement_config?.action !== 'block' ? 'translate-x-4' : 'translate-x-0'"
										></span>
									</button>
								</div>
								<!-- Individual tools — shown when plugin is enabled and has multiple tools -->
								<template x-if="plugin.requirement_config?.action !== 'block' && plugin.tools.length > 1">
									<div class="border-t border-border/50 divide-y divide-border/30 bg-background/40">
										<template x-for="tool in plugin.tools" :key="tool.id">
											<div
												class="flex items-center gap-2 px-2 py-1.5 transition-colors"
												:class="tool.requirement_config?.action === 'block' ? 'bg-muted/20' : ''"
											>
												<!-- Indent marker + name -->
												<span class="w-3 shrink-0"></span>
												<span
													class="text-[11px] flex-1 min-w-0 truncate transition-colors"
													:class="tool.requirement_config?.action === 'block' ? 'line-through text-muted-foreground/50' : 'text-muted-foreground'"
													x-text="tool.name"
												></span>
												<!-- Confirm mini-toggle (only when tool is enabled) -->
												<template x-if="tool.requirement_config?.action !== 'block'">
													<div class="flex items-center gap-1 shrink-0">
														<label
															class="flex items-center gap-1 cursor-pointer select-none"
															:title="tool.requirement_config?.action === 'require_confirmation' ? 'Confirmation required — click to turn off' : 'Require confirmation before this tool runs'"
														>
															<span
																class="text-[9px] transition-colors"
																:class="tool.requirement_config?.action === 'require_confirmation' ? 'text-amber-600 dark:text-amber-400 font-medium' : 'text-muted-foreground'"
															>{ i18n.T(ctx, "Confirm") }</span>
															<button
																type="button"
																@click.stop="setToolAction(plugin, tool, tool.requirement_config?.action === 'require_confirmation' ? 'allow' : 'require_confirmation')"
																role="switch"
																:aria-checked="tool.requirement_config?.action === 'require_confirmation'"
																class="relative inline-flex h-3.5 w-6 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
																:class="tool.requirement_config?.action === 'require_confirmation' ? 'bg-amber-500' : 'bg-input'"
															>
																<span
																	class="pointer-events-none inline-block size-2.5 rounded-full bg-background shadow ring-0 transition-transform duration-200"
																	:class="tool.requirement_config?.action === 'require_confirmation' ? 'translate-x-2.5' : 'translate-x-0'"
																></span>
															</button>
														</label>
														<!-- Gear for tool-level confirmation hint/limits -->
														<template x-if="tool.requirement_config?.action === 'require_confirmation'">
															<button
																type="button"
																@click.stop="openToolRequirements(plugin, tool)"
																title="Set confirmation prompt and invocation limits"
																class="p-0.5 rounded text-amber-500/70 hover:text-amber-600 hover:bg-amber-500/10 transition-colors"
															>
																@icon.SlidersHorizontal(icon.Props{Class: "size-2.5"})
															</button>
														</template>
													</div>
												</template>
												<!-- Enable/disable toggle for individual tool -->
												<button
													type="button"
													@click.stop="setToolAction(plugin, tool, tool.requirement_config?.action === 'block' ? 'allow' : 'block')"
													role="switch"
													:aria-checked="tool.requirement_config?.action !== 'block'"
													:title="tool.requirement_config?.action === 'block' ? 'Enable tool' : 'Disable tool'"
													class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
													:class="tool.requirement_config?.action !== 'block' ? 'bg-primary' : 'bg-input'"
												>
													<span
														class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200"
														:class="tool.requirement_config?.action !== 'block' ? 'translate-x-3' : 'translate-x-0'"
													></span>
												</button>
											</div>
										</template>
									</div>
								</template>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
	<!-- Confirmation settings panel — opens via the gear icon when confirm is on.
	     Contains only the hint text and invocation limit; the enable/confirm toggles
	     are inline in the row and do not appear here. -->
	@toolRequirementsDialog()
}

// toolRequirementsDialog renders the confirmation settings panel for a tool or tool set.
// Reached only via the gear (⚙) icon that appears next to the Confirm toggle.
// Contains only the hint text and per-turn invocation limit.
// The enable/disable toggle and the confirm toggle live inline in the tool list rows.
templ toolRequirementsDialog() {
	<!-- Backdrop overlay -->
	<div
		x-show="showRequirementsPanel"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@click.self="closeRequirementsPanel()"
		class="fixed inset-0 z-60 bg-black/40 backdrop-blur-[3px]"
	></div>
	<!-- Dialog content -->
	<div
		x-show="showRequirementsPanel"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 scale-[0.97]"
		x-transition:enter-end="opacity-100 scale-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 scale-100"
		x-transition:leave-end="opacity-0 scale-[0.97]"
		@keydown.escape.window="closeRequirementsPanel()"
		class="fixed z-60 left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] bg-background rounded-2xl border border-border/60 shadow-modern-xl w-full max-w-[calc(100%-2rem)] sm:max-w-md"
	>
		<!-- Header -->
		<div class="flex items-center justify-between px-5 pt-5 pb-0">
			<div class="flex items-center gap-2.5">
				<div class="size-8 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-600 dark:text-amber-400">
					@icon.SlidersHorizontal(icon.Props{Class: "size-4"})
				</div>
				<div>
					<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Confirmation Settings") }</h3>
					<p class="text-xs text-muted-foreground" x-text="reqConfigTarget?.name || ''"></p>
				</div>
			</div>
			<button
				type="button"
				@click="closeRequirementsPanel()"
				class="size-8 rounded-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
			>
				@icon.X(icon.Props{Class: "size-4"})
			</button>
		</div>
		<!-- Body -->
		<div class="px-5 py-4 space-y-4">
			<!-- Confirmation hint -->
			<div class="space-y-2">
				<label class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Confirmation Prompt") }</label>
				@textarea.Textarea(textarea.Props{
					Placeholder: i18n.T(ctx, "e.g., This tool will modify files. Are you sure?"),
					Class:       "min-h-[56px] resize-y text-xs",
					Rows:        2,
					Attributes: templ.Attributes{
						"x-model": "reqConfig.confirmation_hint",
					},
				})
				<p class="text-[11px] text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "Shown to the user before the tool runs. Leave blank to use a default prompt.") }
				</p>
			</div>
			<!-- Max invocations -->
			<div class="space-y-2">
				<label class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Max Invocations per Turn") }</label>
				<input
					type="number"
					min="0"
					x-model.number="reqConfig.max_invocations"
					placeholder="0"
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
				/>
				<p class="text-[11px] text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "Maximum times this tool can run in a single agent turn. 0 means unlimited.") }
				</p>
			</div>
		</div>
		<!-- Footer -->
		<div class="flex items-center justify-end gap-2 px-5 pb-5 pt-0">
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": "closeRequirementsPanel()",
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    "saveRequirementConfig()",
					":disabled": "savingReqConfig",
				},
			}) {
				<span x-show="!savingReqConfig" class="flex items-center gap-1.5">
					@icon.Check(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "Save") }
				</span>
				<span x-show="savingReqConfig" class="flex items-center gap-1.5">
					<span class="animate-spin size-3.5 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Saving...") }
				</span>
			}
		</div>
	</div>
}

// knowledgeBasesSection renders the collapsible KB section for an agent in edit mode.
templ knowledgeBasesSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showKnowledgeBases = !showKnowledgeBases"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Library(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Knowledge Bases") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="kbSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showKnowledgeBases ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showKnowledgeBases" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingKBs">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingKBs">
				<div>
					<template x-if="agentWorkspaces.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No knowledge bases available. Create one from the Resources sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="ws in agentWorkspaces" :key="ws.id">
							<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
								<div class="flex items-center gap-2 flex-1 min-w-0">
									<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
										@icon.Library(icon.Props{Class: "size-3.5"})
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-xs font-medium text-foreground truncate" x-text="ws.name"></div>
										<div class="text-[10px] text-muted-foreground truncate" x-text="ws.description || ws.slug"></div>
									</div>
								</div>
								<button
									@click="toggleAgentWorkspace(ws)"
									class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
									:class="ws.enabled ? 'bg-primary' : 'bg-input'"
									role="switch"
									:aria-checked="ws.enabled"
								>
									<span class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200" :class="ws.enabled ? 'translate-x-4' : 'translate-x-0'"></span>
								</button>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// filesystemsSection renders the collapsible filesystem section for an agent in edit mode.
templ filesystemsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showFilesystems = !showFilesystems"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Folder(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Filesystems") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="fsSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showFilesystems ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showFilesystems" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingFilesystems">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingFilesystems">
				<div>
					<template x-if="agentFilesystems.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No filesystems available. Create one from the Files sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="fs in agentFilesystems" :key="fs.id">
							<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
								<div class="flex items-center gap-2 flex-1 min-w-0">
									<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
										@icon.Folder(icon.Props{Class: "size-3.5"})
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-xs font-medium text-foreground truncate" x-text="fs.name"></div>
										<div class="text-[10px] text-muted-foreground truncate" x-text="fs.description || fs.type"></div>
									</div>
								</div>
								<button
									@click="toggleAgentFilesystem(fs)"
									class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
									:class="fs.enabled ? 'bg-primary' : 'bg-input'"
									role="switch"
									:aria-checked="fs.enabled"
								>
									<span class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200" :class="fs.enabled ? 'translate-x-4' : 'translate-x-0'"></span>
								</button>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// pipelineConfigForm renders the left panel of the pipeline editor with name, description, etc.
templ pipelineConfigForm() {
	<!-- Pipeline Name -->
	<div class="space-y-2">
		@label.Label(label.Props{}) {
			{ i18n.T(ctx, "Workflow Agent Name") }
			<span class="text-destructive">*</span>
		}
		@input.Input(input.Props{
			Placeholder: i18n.T(ctx, "e.g., Code Review Pipeline, Research & Report..."),
			Attributes: templ.Attributes{
				"x-model":   "pipelineName",
				"maxlength": "100",
			},
		})
	</div>
	<!-- Description -->
	<div class="space-y-2">
		@label.Label(label.Props{}) {
			{ i18n.T(ctx, "Description") }
		}
		@input.Input(input.Props{
			Placeholder: i18n.T(ctx, "What does this workflow agent do?"),
			Attributes: templ.Attributes{
				"x-model":   "pipelineDescription",
				"maxlength": "500",
			},
		})
	</div>
	<!-- System Prompt (for the root orchestrator) -->
	<div class="space-y-2">
		@label.Label(label.Props{}) {
			{ i18n.T(ctx, "Root Instruction (optional)") }
		}
		@textarea.Textarea(textarea.Props{
			Placeholder: i18n.T(ctx, "Shared instruction for the root orchestrator (Sequential/Parallel/Loop agents rarely need this)."),
			Class:       "min-h-[80px] resize-y text-xs",
			Rows:        3,
			Attributes: templ.Attributes{
				"x-model": "pipelineSystemPrompt",
			},
		})
	</div>
	<!-- Orchestration (root-level) -->
	<div class="border border-border rounded-lg">
		<details class="group">
			<summary class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors cursor-pointer select-none">
				<span class="flex items-center gap-2">
					@icon.Settings2(icon.Props{Class: "size-4 text-muted-foreground"})
					{ i18n.T(ctx, "Workflow Settings") }
				</span>
				<span class="transition-transform duration-200 group-open:rotate-180">
					@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
				</span>
			</summary>
			<div class="px-3 pb-3 border-t border-border pt-3 space-y-3">
				<!-- Global Instruction -->
				<div class="space-y-1.5">
					<span class="text-xs font-medium flex items-center gap-1.5">
						@icon.Globe(icon.Props{Class: "size-3.5 text-muted-foreground"})
						{ i18n.T(ctx, "Global Instruction") }
					</span>
					@textarea.Textarea(textarea.Props{
						Placeholder: i18n.T(ctx, "Applied to every agent in this workflow tree. Use for cross-cutting rules like language or tone."),
						Class:       "min-h-[48px] resize-y text-[11px]",
						Rows:        2,
						Attributes: templ.Attributes{
							"x-model": "pipelineOrchestration.globalInstruction",
						},
					})
				</div>
				<!-- Output Key -->
				<div class="space-y-1.5">
					<span class="text-xs font-medium flex items-center gap-1.5">
						@icon.Key(icon.Props{Class: "size-3.5 text-muted-foreground"})
						{ i18n.T(ctx, "Output Key") }
					</span>
					@input.Input(input.Props{
						Placeholder: i18n.T(ctx, "Save this workflow's final output under this key..."),
						Class:       "h-7 text-[11px]",
						Attributes: templ.Attributes{
							"x-model": "pipelineOrchestration.outputKey",
						},
					})
				</div>
				<!-- Output Schema -->
				<div class="space-y-1.5">
					<span class="text-xs font-medium flex items-center gap-1.5">
						@icon.Braces(icon.Props{Class: "size-3.5 text-muted-foreground"})
						{ i18n.T(ctx, "Output Schema") }
					</span>
					@textarea.Textarea(textarea.Props{
						Placeholder: i18n.T(ctx, `{"type": "object", ...}`),
						Class:       "min-h-[48px] resize-y font-mono text-[10px]",
						Rows:        2,
						Attributes: templ.Attributes{
							"x-model": "pipelineOrchestration.outputSchema",
						},
					})
				</div>
			</div>
		</details>
	</div>
	<!-- Legend / ADK-Go mapping -->
	<div class="rounded-lg bg-muted/30 border border-border p-3 space-y-2">
		<h4 class="text-[11px] font-semibold text-foreground flex items-center gap-1.5">
			@icon.Info(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "ADK-Go Node Types") }
		</h4>
		<div class="grid grid-cols-2 gap-1.5">
			<div class="flex items-center gap-1.5">
				<span class="size-2 rounded-full bg-blue-500"></span>
				<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Sequential → sequentialagent.New") }</span>
			</div>
			<div class="flex items-center gap-1.5">
				<span class="size-2 rounded-full bg-amber-500"></span>
				<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Parallel → parallelagent.New") }</span>
			</div>
			<div class="flex items-center gap-1.5">
				<span class="size-2 rounded-full bg-purple-500"></span>
				<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Loop → loopagent.New (exit_loop on last child)") }</span>
			</div>
			<div class="flex items-center gap-1.5">
				<span class="size-2 rounded-full bg-emerald-500"></span>
				<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Agent → llmagent.New (leaf node)") }</span>
			</div>
			<div class="col-span-2 flex items-start gap-1.5 mt-0.5">
				<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "💡 Set OutputKey on each agent, reference as {key} in downstream Instructions. Loop's last child auto-receives exit_loop tool.") }</span>
			</div>
		</div>
	</div>
}

// pipelineTypeCard renders an explanatory card for a pipeline node type (used in the empty state).
templ pipelineTypeCard(nodeType string, label string, desc string, badgeClass string) {
	<div class="rounded-lg border border-border p-3 text-start">
		<span class={ "inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold mb-2 border", badgeClass }>
			{ label }
		</span>
		<p class="text-[11px] text-muted-foreground">{ desc }</p>
	</div>
}

// deleteConfirmation renders a reusable delete confirmation view.
templ deleteConfirmation(cancelAction string, deleteAction string) {
	<div class="flex flex-col h-full">
		<div class="p-4 pb-3 border-b border-border">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "Delete Agent") }</h2>
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "This action cannot be undone.") }</p>
		</div>
		<div class="p-6 flex flex-col items-center gap-4">
			<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
				@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
			</div>
			<p class="text-sm text-center text-foreground">
				{ i18n.T(ctx, "Are you sure you want to delete") }
				<span class="font-semibold" x-text="deletingAgent?.name"></span>?
			</p>
		</div>
		<div class="px-4 py-3 border-t mt-auto bg-muted/50 flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": cancelAction,
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    deleteAction,
					":disabled": "saving || pipelineSaving",
				},
			}) {
				<span x-show="!saving && !pipelineSaving">{ i18n.T(ctx, "Delete") }</span>
				<span x-show="saving || pipelineSaving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Deleting...") }
				</span>
			}
		</div>
	</div>
}

// AgentDesignerNavButtonTrigger renders a workflow icon button for the navbar.
templ AgentDesignerNavButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agent-designer-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agent-designer')",
				"title":  i18n.T(ctx, "Agent Designer"),
			},
		}) {
			@icon.Workflow(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Agent Designer") }</span>
		}
	}
}
