package chatinput

import "school-with-ai/components/button"
import "school-with-ai/components/textarea"

templ ChatInput() {
	<div
		class="relative z-10 mx-auto w-full max-w-3xl rounded-lg border border-border bg-muted shadow-sm transition-all duration-300"
		:class="awaitingHumanInput ? 'ring-2 ring-ring/50 border-primary/50 shadow-primary/10' : ''"
		role="region"
		aria-label="Message input area"
	>
		<form @submit.prevent="sendMessage" class="mx-auto grid max-w-3xl grid-rows-[1fr_auto] gap-2 p-2">
			<!-- Generic Options (Enum) -->
			<template x-if="awaitingHumanInput && humanInputSchema?.enum && humanInputSchema?.type !== 'array'">
				<div class="flex flex-wrap gap-2 mb-2 justify-center animate-in fade-in slide-in-from-bottom-2 duration-300">
					<template x-for="option in humanInputSchema.enum" :key="option">
						<button
							type="button"
							@click="currentMessage = option; sendMessage()"
							class="px-3 py-1.5 bg-primary/10 text-primary hover:bg-primary/20 border border-primary/20 rounded-full text-sm font-medium transition-colors"
							x-text="option"
						></button>
					</template>
				</div>
			</template>

			<!-- Boolean (Yes/No) -->
			<template x-if="awaitingHumanInput && humanInputSchema?.type === 'boolean'">
				<div class="flex flex-wrap gap-2 mb-2 justify-center animate-in fade-in slide-in-from-bottom-2 duration-300">
					<button
						type="button"
						@click="currentMessage = 'Yes'; sendMessage()"
						class="px-4 py-2 bg-primary/10 text-primary hover:bg-primary/20 border border-primary/20 rounded-md text-sm font-medium transition-colors"
					>Yes</button>
					<button
						type="button"
						@click="currentMessage = 'No'; sendMessage()"
						class="px-4 py-2 bg-destructive/10 text-destructive hover:bg-destructive/20 border border-destructive/20 rounded-md text-sm font-medium transition-colors"
					>No</button>
				</div>
			</template>

			<!-- Multiple Select (Array of Enums) -->
			<template x-if="awaitingHumanInput && humanInputSchema?.type === 'array' && humanInputSchema?.items?.enum">
				<div class="w-full mb-3 p-3 bg-muted/50 rounded-lg animate-in fade-in slide-in-from-bottom-2 duration-300" x-data="{ selected: [] }" x-effect="if (!awaitingHumanInput) selected = []">
					<div class="flex flex-wrap gap-2 mb-3">
						<template x-for="option in humanInputSchema.items.enum" :key="option">
							<button
								type="button"
								@click="selected.includes(option) ? selected = selected.filter(i => i !== option) : selected.push(option)"
								:class="selected.includes(option) ? 'bg-primary text-primary-foreground' : 'bg-background hover:bg-accent'"
								class="px-3 py-1.5 border rounded-full text-xs font-medium transition-colors"
								x-text="option"
							></button>
						</template>
					</div>
					<button
						type="button"
						x-show="selected.length > 0"
						@click="currentMessage = selected.join(', '); sendMessage()"
						class="w-full py-1.5 bg-primary text-primary-foreground rounded-md text-xs font-bold"
					>Submit Selections</button>
				</div>
			</template>

			<!-- Number Range -->
			<template x-if="awaitingHumanInput && humanInputSchema?.type === 'number' && (humanInputSchema?.minimum !== undefined || humanInputSchema?.maximum !== undefined)">
				<div class="w-full mb-3 px-4 py-2 animate-in fade-in slide-in-from-bottom-2" x-data="{ val: 0 }" x-effect="val = humanInputSchema?.minimum || 0">
					<div class="flex items-center gap-4">
						<span class="text-xs font-mono" x-text="humanInputSchema.minimum"></span>
						<input
							type="range"
							:min="humanInputSchema.minimum"
							:max="humanInputSchema.maximum"
							x-model="val"
							class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
						>
						<span class="text-xs font-mono" x-text="humanInputSchema.maximum"></span>
					</div>
					<div class="text-center mt-2">
						<button
							type="button"
							@click="currentMessage = val.toString(); sendMessage()"
							class="px-3 py-1 bg-primary text-primary-foreground rounded text-xs font-bold"
						>
							Submit: <span x-text="val"></span>
						</button>
					</div>
				</div>
			</template>

			<!-- Helper Text (Description) -->
			<template x-if="awaitingHumanInput && humanInputSchema?.description">
				<p
					x-text="humanInputSchema.description"
					class="text-xs text-muted-foreground text-center mb-2 animate-in fade-in duration-300"
				></p>
			</template>

			@textarea.Textarea(textarea.Props{
				Attributes: templ.Attributes{
					"x-model":           "currentMessage",
					":disabled":         "isStreaming",
					"@keydown":          "handleKeydown($event)",
					":placeholder":      "awaitingHumanInput ? (humanInputQuestion || 'Awaiting your input...') : 'Type your message...'",
					"rows":              "1",
					"style":             "field-sizing: content;",
					"aria-label":        "Type your message",
					":aria-disabled":    "isStreaming",
					":aria-describedby": "errorMessage ? 'error-message' : null",
					"x-ref":             "messageInput",
				},
				Class: "resize-none border-none bg-transparent shadow-none text-sm min-h-[40px]",
			})
			<div class="flex items-center justify-between pt-2">
				<!-- Left: Controls -->
				<div class="flex items-center gap-3">
					<!-- Help Button -->
					<button
						@click="toggleKeyboardShortcuts()"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-8 w-8 touch-target"
						type="button"
						aria-label="Show keyboard shortcuts"
						title="Keyboard shortcuts (?)"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</button>

					<!-- Waiting Prompt -->
					<div x-show="awaitingHumanInput" class="flex items-center gap-2 px-2 py-1 rounded-full bg-primary/10 text-[10px] sm:text-xs font-semibold text-primary animate-in fade-in zoom-in duration-300">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/75 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
						</span>
						<span class="tracking-tight uppercase">Action Required: Specialist is waiting for you</span>
					</div>
				</div>
				<!-- Send/Cancel Button -->
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeIcon,
					Class:   "rounded-full",
					Attributes: templ.Attributes{
						"@click.prevent": "isStreaming ? cancelJob() : sendMessage()",
						"type":           "button",
						":disabled":      "!canSendMessage && !isStreaming",
						":class":         "(canSendMessage || isStreaming) ? '' : 'opacity-50'",
						":aria-busy":     "isStreaming",
						":aria-label":    "isStreaming ? 'Cancel message' : 'Send message'",
					},
				}) {
					<!-- Send Icon -->
					<svg x-show="!isStreaming" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m22 2-7 20-4-9-9-4Z"></path>
						<path d="M22 2 11 13"></path>
					</svg>
					<!-- Cancel/Stop Icon -->
					<svg x-show="isStreaming" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
					</svg>
				}
			</div>
		</form>
	</div>
}
