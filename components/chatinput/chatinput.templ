package chatinput

import "school-with-ai/components/button"
import "school-with-ai/components/textarea"
import "school-with-ai/components/icon"

templ ChatInput() {
	<div
		class="relative z-10 mx-auto w-full max-w-3xl rounded-3xl border border-transparent bg-background shadow-xl transition-all duration-300 focus-within:shadow-2xl focus-within:border-border/50"
		:class="awaitingHumanInput ? 'opacity-50 pointer-events-none grayscale' : ''"
		role="region"
		aria-label="Message input area"
	>
		<form @submit.prevent="sendMessage" class="mx-auto flex flex-col w-full p-3">
            <!-- Textarea Area -->
			<div class="relative w-full">
                @textarea.Textarea(textarea.Props{
                    Attributes: templ.Attributes{
                        "x-model":           "currentMessage",
                        ":disabled":         "isStreaming",
                        "@keydown":          "handleKeydown($event)",
                        "placeholder":      "Message SchoolWithAI...",
                        "rows":              "1",
                        "style":             "field-sizing: content; max-height: 200px;",
                        "aria-label":        "Type your message",
                        ":aria-disabled":    "isStreaming",
                        ":aria-describedby": "errorMessage ? 'error-message' : null",
                        "x-ref":             "messageInput",
                    },
                    Class: "w-full resize-none border-none bg-transparent shadow-none text-base min-h-[44px] py-3 px-2 focus:ring-0 focus:outline-none placeholder:text-muted-foreground/50",
                })
            </div>

            <!-- Footer Area -->
			<div class="flex items-center justify-between pl-1 pr-1 pb-1">
				<!-- Left: Agents & Attachments (Future) -->
				<div class="flex items-center gap-2">
                    <!-- Agent Selector (Styled as a pill/badge) -->
					<div class="relative" x-data="{ open: false }">
						<select
							x-model="selectedAgent"
							class="h-8 rounded-full border border-input/50 bg-muted/50 px-3 py-1 text-xs font-medium shadow-sm transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring cursor-pointer appearance-none pl-3 pr-8"
							aria-label="Select Agent"
							:disabled="isStreaming"
                            style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23666%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 0.7em top 50%; background-size: 0.65em auto;"
						>
							<template x-for="agent in AVAILABLE_AGENTS" :key="agent.id">
								<option :value="agent.id" x-text="agent.name"></option>
							</template>
						</select>
					</div>

                    <!-- Attachment Icon (Visual Placeholder for now) -->
                     <button type="button" class="p-1.5 text-muted-foreground hover:text-foreground transition-colors rounded-full hover:bg-muted/50">
                        @icon.Plus(icon.Props{Class: "size-5"})
                    </button>
				</div>

				<!-- Right: Send Button -->
                <div class="flex items-center gap-2">
                    <!-- Help/Shortcuts (Moved slightly to avoid clutter, kept near send) -->
                    <button
                        @click="toggleKeyboardShortcuts()"
                        class="text-muted-foreground hover:text-foreground transition-colors p-2"
                        type="button"
                        aria-label="Show keyboard shortcuts"
                    >
                        <span class="text-xs font-medium">?</span>
                    </button>

                    @button.Button(button.Props{
                        Variant: button.VariantDefault,
                        Size:    button.SizeIcon,
                        Class:   "rounded-full size-10 bg-foreground text-background hover:opacity-90 transition-opacity shadow-sm",
                        Attributes: templ.Attributes{
                            "@click.prevent": "isStreaming ? cancelJob() : sendMessage()",
                            "type":           "button",
                            ":disabled":      "!canSendMessage && !isStreaming",
                            ":class":         "(canSendMessage || isStreaming) ? '' : 'opacity-10 cursor-not-allowed'",
                            ":aria-busy":     "isStreaming",
                            ":aria-label":    "isStreaming ? 'Cancel message' : 'Send message'",
                        },
                    }) {
                        <!-- Send Icon -->
                        <div x-show="!isStreaming">
                           @icon.ArrowUp(icon.Props{Class: "size-5"})
                        </div>
                        <!-- Cancel/Stop Icon -->
                        <div x-show="isStreaming">
                           <div class="size-3 bg-current rounded-[2px]"></div>
                        </div>
                    }
                </div>
			</div>
		</form>
	</div>
    <!-- Disclaimer Footer -->
    <div class="text-center text-xs text-muted-foreground mt-2 pb-2">
        SchoolWithAI can make mistakes. Check important info.
    </div>
}
