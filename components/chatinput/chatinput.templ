package chatinput

import "school-with-ai/components/button"
import "school-with-ai/components/textarea"
import switchComp "school-with-ai/components/switch"

templ ChatInput() {
	<div class="relative z-10 mx-auto w-full max-w-3xl rounded-2xl border border-border bg-muted shadow-sm transition-all">
		<form @submit.prevent="sendMessage" class="mx-auto grid max-w-3xl grid-rows-[1fr_auto] gap-2 p-2">
			@textarea.Textarea(textarea.Props{
				Attributes: templ.Attributes{
					"x-model":                       "currentMessage",
					":disabled":                     "isStreaming",
					"@keydown.enter.prevent":        "if (!$event.shiftKey && currentMessage.trim()) sendMessage()",
					"placeholder":                   "Type your message...",
					"rows":                          "1",
					"style":                         "field-sizing: content;",
				},
				Class: "resize-none border-none bg-transparent shadow-none text-sm min-h-[40px]",
			})
			<div class="flex items-center justify-between pt-2">
				<!-- Lifecycle Events Toggle -->
				<div class="flex items-center gap-2">
					@switchComp.Switch(switchComp.Props{
						Attributes: templ.Attributes{
							"x-model": "hideLifecycleEvents",
						},
					})
					<span class="text-xs text-muted-foreground">Hide Events</span>
				</div>
				<!-- Send Button -->
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeIcon,
					Class:   "rounded-full",
					Attributes: templ.Attributes{
						"type":      "submit",
						":disabled": "isStreaming || !currentMessage.trim()",
						":class":    "currentMessage.trim() && !isStreaming ? '' : 'opacity-50'",
					},
				}) {
					<svg x-show="!isStreaming" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m22 2-7 20-4-9-9-4Z"></path>
						<path d="M22 2 11 13"></path>
					</svg>
					<svg x-show="isStreaming" class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
					</svg>
				}
			</div>
		</form>
	</div>
}
