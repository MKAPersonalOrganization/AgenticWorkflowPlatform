package chatinput

import "school-with-ai/components/button"
import "school-with-ai/components/textarea"
import "school-with-ai/components/icon"
import "school-with-ai/components/tooltip"
import "school-with-ai/components/i18n"
import "school-with-ai/components/tokenusage"
import "school-with-ai/components/agents"

templ ChatInput() {
	<div
		class="relative flex w-full flex-grow flex-col overflow-hidden rounded-t-3xl border border-border bg-background shadow-md transition-all duration-200 focus-within:shadow-lg sm:rounded-3xl"
		:class="isTextAreaFocused ? 'shadow-lg border-border' : 'shadow-md'"
		x-data="{ isTextAreaFocused: false }"
		@click="$refs.messageInput.focus()"
		role="region"
		aria-label="Message input area"
	>
		<form @submit.prevent="sendMessage" class="mx-auto flex flex-col w-full p-1.5">
			<!-- File Previews -->
			@FileRow()
			<!-- Textarea Area -->
			<div class="relative w-full">
				@textarea.Textarea(textarea.Props{
					AutoResize: true,
					Attributes: templ.Attributes{
						"x-model": "currentMessage",
				
						"@keydown":     "handleSlashKeydown($event) || handleKeydown($event)",
						"@input":       "handleInput($event)",
						"@paste":       "handlePaste($event)",
						"@drop":        "handleDrop($event)",
						"@dragover":    "handleDragOver($event)",
						"@focus":       "isTextAreaFocused = true",
						"@blur":        "isTextAreaFocused = false",
						"placeholder":  i18n.T(ctx, "Message compass.AI..."),
						":placeholder": "AVAILABLE_AGENTS.find(a => a.id === selectedAgent)?.name ? '" + i18n.T(ctx, "Message") + " ' + AVAILABLE_AGENTS.find(a => a.id === selectedAgent).name + '...' : '" + i18n.T(ctx, "Message compass.AI...") + "'",
						"rows":         "1",
						"style":        "max-height: 45vh;",
						"aria-label":   "Type your message",
				
						":aria-describedby": "errorMessage ? 'error-message' : null",
						"x-ref":             "messageInput",
						"dir":               "auto",
					},
					Class: "md:py-3.5 m-0 w-full resize-none py-[13px] placeholder-muted-foreground/50 bg-transparent border-none shadow-none text-base min-h-[44px] px-5 focus:ring-0 focus:outline-none",
				})
				<!-- Slash Command Menu -->
				@SlashMenu()
			</div>
			<!-- Footer Area -->
			<div class="flex items-center gap-2 pb-2">
				<!-- Left: Agents & Attachments -->
				<div class="ml-2 flex items-center gap-1">
					<!-- Agents Selector -->
					@agents.AgentsButtonTrigger()
				</div>
				<!-- Center: Token Counter -->
				<div class="flex-1 flex justify-center">
					@tokenusage.TokenCounter()
				</div>
				<!-- Right: Send Button -->
				<div class="mr-2 flex items-center gap-1">
					<!-- Help/Shortcuts -->
					@tooltip.Tooltip() {
						@tooltip.Trigger(tooltip.TriggerProps{}) {
							@button.Button(button.Props{
								Type:    button.TypeButton,
								Variant: button.VariantGhost,
								Size:    button.SizeIcon,
								Class:   "text-muted-foreground hover:text-foreground transition-colors p-2 rounded-xl hover:bg-muted/50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
								Attributes: templ.Attributes{
									"@click":     "toggleKeyboardShortcuts()",
									"aria-label": i18n.T(ctx, "Show keyboard shortcuts"),
								},
							}) {
								<!-- Use a small keyboard icon or question mark -->
								<div class="size-5 flex items-center justify-center border border-current rounded text-[10px] font-medium opacity-70">?</div>
							}
						}
						@tooltip.Content(tooltip.ContentProps{Class: "text-xs"}) {
							{ i18n.T(ctx, "Keyboard shortcuts") }
						}
					}
					@tooltip.Tooltip() {
						@tooltip.Trigger(tooltip.TriggerProps{}) {
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Size:    button.SizeIcon,
								Class:   "rounded-full bg-foreground p-1.5 text-background transition-all duration-200 disabled:cursor-not-allowed disabled:opacity-10 hover:bg-foreground/90",
								Attributes: templ.Attributes{
									"@click.prevent": "isStreaming ? cancelJob() : sendMessage()",
									"type":           "button",
									":disabled":      "!canSendMessage && !isStreaming",
									":class":         "(canSendMessage || isStreaming) ? '' : 'opacity-20 cursor-not-allowed'",
									":aria-busy":     "isStreaming",
									":aria-label":    "isStreaming ? 'Cancel message' : '" + i18n.T(ctx, "Send message") + "'",
								},
							}) {
								<!-- Send Icon -->
								<div x-show="!isStreaming" x-cloak>
									@icon.ArrowUp(icon.Props{Class: "size-5"})
								</div>
								<!-- Cancel/Stop Icon -->
								<div x-show="isStreaming" x-cloak>
									<div class="size-3 bg-current rounded-[2px]"></div>
								</div>
							}
						}
						@tooltip.Content(tooltip.ContentProps{Class: "text-xs"}) {
							<span x-text={ "isStreaming ? '" + i18n.T(ctx, "Stop generating") + "' : '" + i18n.T(ctx, "Send message") + "'" }></span>
						}
					}
				</div>
			</div>
		</form>
	</div>
}
