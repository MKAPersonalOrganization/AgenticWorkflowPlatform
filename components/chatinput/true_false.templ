package chatinput

templ TrueFalse() {
	<template x-if="awaitingHumanInput && humanInputSchema?.type === 'boolean'">
		<div class="flex flex-wrap gap-4 mb-4 justify-center animate-in fade-in slide-in-from-bottom-3 duration-500">
			<button
				type="button"
				@click="currentMessage = 'True'; sendMessage()"
				class="px-8 py-2.5 bg-primary/10 text-primary hover:bg-primary/20 border border-primary/30 rounded-full text-sm font-bold transition-all duration-200 transform hover:scale-105 active:scale-95 shadow-sm"
			>True</button>
			<button
				type="button"
				@click="currentMessage = 'False'; sendMessage()"
				class="px-8 py-2.5 bg-destructive/10 text-destructive hover:bg-destructive/20 border border-destructive/30 rounded-full text-sm font-bold transition-all duration-200 transform hover:scale-105 active:scale-95 shadow-sm"
			>False</button>
		</div>
	</template>
}
