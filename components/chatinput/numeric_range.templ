package chatinput

templ NumericRange() {
	<template x-if="awaitingHumanInput && humanInputSchema?.type === 'number' && (humanInputSchema?.minimum !== undefined || humanInputSchema?.maximum !== undefined)">
		<div class="w-full mb-4 px-6 py-4 bg-background/50 backdrop-blur-sm border border-border/50 rounded-2xl animate-in fade-in slide-in-from-bottom-3 duration-500" x-data="{ val: 0 }" x-effect="val = humanInputSchema?.minimum || 0">
			<div class="flex items-center gap-6">
				<span class="text-xs font-bold text-muted-foreground/80 w-8" x-text="humanInputSchema.minimum"></span>
				<input
					type="range"
					:min="humanInputSchema.minimum"
					:max="humanInputSchema.maximum"
					x-model="val"
					class="w-full h-1.5 bg-secondary rounded-full appearance-none cursor-pointer accent-primary"
				>
				<span class="text-xs font-bold text-muted-foreground/80 w-8 text-right" x-text="humanInputSchema.maximum"></span>
			</div>
			<div class="text-center mt-4">
				<button
					type="button"
					@click="currentMessage = val.toString(); sendMessage()"
					class="px-6 py-2 bg-primary text-primary-foreground rounded-full text-xs font-black shadow-lg shadow-primary/20 hover:shadow-primary/30 transition-all active:scale-95"
				>
					Confirm Value: <span x-text="val" class="ml-1"></span>
				</button>
			</div>
		</div>
	</template>
}
