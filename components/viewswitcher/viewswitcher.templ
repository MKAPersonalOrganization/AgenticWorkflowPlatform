package viewswitcher

// ViewSwitcher is a segmented control for switching between Chat, Split, and Whiteboard views
templ ViewSwitcher() {
	<!-- View Mode Switcher (Segmented Control) - Always visible at top right -->
	<div
		x-show="hasMessages || isStreaming"
		class="absolute top-4 right-4 z-50"
		x-transition
	>
		<div class="inline-flex items-center gap-1 p-1 rounded-lg bg-primary text-primary-foreground shadow-lg border border-primary">
			<!-- Chat Only Button -->
			<button
				@click="showThread = true; showWhiteboard = false"
				:class="(showThread && !showWhiteboard) ? 'bg-primary-foreground text-primary shadow-sm' : 'text-primary-foreground/60 hover:text-primary-foreground'"
				class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md text-xs font-medium transition-all duration-150 h-7 px-2.5"
				type="button"
				aria-label="Chat view"
				title="Chat only"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
				</svg>
				<span>Chat</span>
			</button>
			<!-- Split View Button -->
			<button
				@click="showThread = true; showWhiteboard = true"
				:class="(showThread && showWhiteboard) ? 'bg-primary-foreground text-primary shadow-sm' : 'text-primary-foreground/60 hover:text-primary-foreground'"
				class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md text-xs font-medium transition-all duration-150 h-7 px-2.5"
				type="button"
				aria-label="Split view"
				title="Chat + Whiteboard"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 4H5a2 2 0 00-2 2v14a2 2 0 002 2h4m0-18v18m0-18l6-2m-6 2l6 2m0 16V6m0 12l6 2m-6-2l6-2m0 0V4m0 2l-6-2"></path>
				</svg>
				<span>Split</span>
			</button>
			<!-- Whiteboard Only Button -->
			<button
				@click="showThread = false; showWhiteboard = true"
				:class="(!showThread && showWhiteboard) ? 'bg-primary-foreground text-primary shadow-sm' : 'text-primary-foreground/60 hover:text-primary-foreground'"
				class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md text-xs font-medium transition-all duration-150 h-7 px-2.5"
				type="button"
				aria-label="Whiteboard view"
				title="Whiteboard only"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
				</svg>
				<span>Board</span>
			</button>
		</div>
	</div>
}
