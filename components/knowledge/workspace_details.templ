package knowledge

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/separator"
	"school-with-ai/components/tabs"
	"school-with-ai/domain"
	"school-with-ai/services/rag/workspaces"
)

type WorkspaceDetailsPageProps struct {
	User      *domain.User
	Workspace *workspaces.WorkspaceResponse
}

templ WorkspaceDetailsPage(props WorkspaceDetailsPageProps) {
	@knowledgeLayout(knowledgeLayoutProps{
		Title: props.Workspace.Name + " - Documents",
		User:  props.User,
	}) {
		@workspaceDetailsScript()
		@StatusBadgeScript()
		<div
			class="flex-1 overflow-y-auto p-6 md:p-8 space-y-8 max-w-7xl mx-auto"
			x-data={ "workspaceDetails('" + props.Workspace.ID.String() + "')" }
		>
			<!-- Header -->
			@WorkspaceHeader(WorkspaceHeaderProps{Workspace: props.Workspace})
			@separator.Separator(separator.Props{})
			<!-- Content Tabs -->
			<div class="space-y-4">
				@tabs.Tabs(tabs.Props{ID: "workspace-content-tabs"}) {
					@tabs.List(tabs.ListProps{}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "files", IsActive: true}) {
							@icon.File(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Files") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "ingested"}) {
							@icon.FileText(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Ingested") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "graph"}) {
							@icon.Network(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Graph") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "settings"}) {
							@icon.Settings(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Settings") }
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "files"}) {
						@FilesTab()
					}
					@tabs.Content(tabs.ContentProps{Value: "ingested"}) {
						@DocumentManager()
					}
					@tabs.Content(tabs.ContentProps{Value: "graph"}) {
						@GraphViewer()
					}
					@tabs.Content(tabs.ContentProps{Value: "settings"}) {
						@WorkspaceSettings()
					}
				}
			</div>
			<!-- Bulk Actions Floating Bar - Files -->
			<div
				x-show="selectedFiles.length > 0"
				x-transition:enter="transition ease-out duration-300 transform"
				x-transition:enter-start="translate-y-full"
				x-transition:enter-end="translate-y-0"
				x-transition:leave="transition ease-in duration-200 transform"
				x-transition:leave-start="translate-y-0"
				x-transition:leave-end="translate-y-full"
				class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 bg-foreground text-background rounded-full px-6 py-3 shadow-2xl flex items-center gap-6"
			>
				<span class="text-sm font-medium" x-text="`${selectedFiles.length} files selected`"></span>
				<div class="h-4 w-px bg-background/20"></div>
				<div class="flex items-center gap-2">
					<button @click="bulkDelete()" class="inline-flex items-center gap-1.5 hover:text-red-400 transition-colors text-sm font-medium">
						@icon.Trash2(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "Delete") }
					</button>
					<button @click="bulkReprocess()" class="inline-flex items-center gap-1.5 hover:text-primary-foreground/80 transition-colors text-sm font-medium px-4">
						@icon.RefreshCw(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "Reprocess") }
					</button>
				</div>
				<button @click="selectedFiles = []" class="p-1 hover:bg-background/10 rounded-full transition-colors">
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</div>
			<!-- Document Preview Panel -->
			@DocumentPreviewPanel()
			<!-- Document Detail Dialog -->
			@DocumentDetailDialog()
			<!-- Upload Dialog -->
			@workspaceUploadDocumentDialog()
		</div>
	}
}

templ workspaceUploadDocumentDialog() {
	@dialog.Dialog(dialog.Props{ID: "upload-document-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			<div x-data="uploadDocumentForm()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Upload Document") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Upload a file to this workspace. Supported formats: PDF, TXT, MD.") }
					}
				}
				<div class="space-y-4 py-4">
					<div class="grid w-full max-w-sm items-center gap-1.5">
						<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="document-file">{ i18n.T(ctx, "File") }</label>
						<input id="document-file" type="file" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @change="fileSelected($event)"/>
					</div>
					<div x-show="uploading" class="space-y-2">
						<div class="flex items-center justify-between text-xs">
							<span>{ i18n.T(ctx, "Uploading...") }</span>
							<span x-text="Math.round(progress) + '%'"></span>
						</div>
						<div class="h-2 w-full overflow-hidden rounded-full bg-secondary">
							<div class="h-full bg-primary transition-all duration-300 ease-in-out" :style="`width: ${progress}%`"></div>
						</div>
					</div>
					<div x-show="error" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="error"></p>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "upload()",
							":disabled": "!file || uploading",
						},
					}) {
						<span x-show="!uploading">{ i18n.T(ctx, "Upload") }</span>
						<span x-show="uploading" class="flex items-center gap-2">
							<span class="animate-spin size-4 border-2 border-white border-t-transparent rounded-full"></span>
							{ i18n.T(ctx, "Processing...") }
						</span>
					}
				}
			</div>
		}
	}
}

templ workspaceDetailsScript() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('workspaceDetails', (workspaceId) => ({
				workspaceId: workspaceId,
				
				// Files (PDFs)
				filesLoading: true,
				files: [],
				fileSearch: '',
				filePage: 1,
				filePageSize: 10,
				fileTotal: 0,
				fileTotalPages: 0,
				
				// Ingested Documents
				docsLoading: true,
				documents: [],       // All documents from API (unfiltered)
				docSearch: '',
				docPage: 1,
				docPageSize: 100,    // Fetch all for client-side filtering
				docTotal: 0,
				docTotalPages: 0,
				docStatusFilter: '', // '', 'pending', 'processing', 'completed', 'failed', 'cancelled'
				statusCounts: { pending: 0, processing: 0, completed: 0, partial_failure: 0, failed: 0, cancelled: 0 },

				// Pipeline Status
				pipelineStatus: null,
				pipelineLoading: false,
				pipelineExpanded: false,
				pipelineTasks: [],
				queueMetrics: null,
				pipelinePollingInterval: null,
				isRefreshing: false,

				// Sorting
				sortField: 'created_at',
				sortDirection: 'desc',

				// Selection
				selectedFiles: [],
				selectedDocs: [],

				// Document Preview
				previewDoc: null,
				previewContent: null,
				previewLoading: false,

				// Document Detail Dialog
				detailDoc: null,

				// Upload progress
				uploadingFiles: [],

				// Knowledge Graph
				graphData: null,
				graphLoading: false,
				graphSearch: '',
				graphMaxNodes: '100',
				graphLayout: 'force-atlas',
				selectedNode: null,
				selectedNodeEdges: [],
				graphShowLabels: true,
				graphShowEdgeLabels: false,
				graphVisibleTypes: [],
				_graphNodes: [],
				_graphEdges: [],
				_graphNodeMap: {},
				_graphTransform: { x: 0, y: 0, k: 1 },
				_graphDragging: null,
				_graphPanning: false,
				_graphPanStart: { x: 0, y: 0 },
				_graphHoveredNode: null,
				_graphAnimFrame: null,
				_graphCanvas: null,
				_graphCtx: null,
				_graphW: 0,
				_graphH: 0,
				_graphDpr: 1,
				_graphResizeObs: null,
				_graphContextMenu: { visible: false, x: 0, y: 0, node: null },
				_graphSelectionPulse: 0,
				_graphSelectionAnimFrame: null,
				_graphSearchMatches: new Set(),
				entityColors: {
					'PERSON': '#3b82f6',
					'ORGANIZATION': '#10b981',
					'LOCATION': '#f59e0b',
					'EVENT': '#ef4444',
					'CONCEPT': '#8b5cf6',
					'DOCUMENT': '#6366f1',
					'TECHNOLOGY': '#06b6d4',
					'CATEGORY': '#d946ef',
					'GEO': '#f59e0b',
					'DATE': '#f97316',
					'PRODUCT': '#14b8a6',
					'METRIC': '#ec4899',
					'PROCESS': '#a855f7',
					'REGULATION': '#64748b',
					'UNKNOWN': '#6b7280',
				},

				// Rebuild/Reprocess states
				rebuildingGraph: false,
				rebuildGraphForce: false,
				rebuildingEmbeddings: false,
				rebuildEmbeddingsForce: false,
				reprocessingAll: false,
				reprocessingFailed: false,
				scanningDocuments: false,
				deletingAllDocs: false,

				// Client-side filtered documents
				get filteredDocuments() {
					if (!this.docStatusFilter) return this.documents;
					return this.documents.filter(doc => {
						const status = doc.status || doc.current_stage || 'completed';
						if (this.docStatusFilter === 'failed') {
							return status === 'failed' || status === 'partial_failure';
						}
						return status === this.docStatusFilter;
					});
				},

				get totalCount() {
					return this.docTotal || this.documents.length;
				},

				init() {
					this.loadFiles();
					this.loadDocuments();
					this.loadPipelineStatus();
					this.loadQueueMetrics();
					
					// Start polling for pipeline status
					this.pipelinePollingInterval = setInterval(() => {
						this.loadPipelineStatus();
						this.loadQueueMetrics();
						// Auto-refresh docs if pipeline is busy
						if (this.pipelineStatus && this.pipelineStatus.is_busy) {
							this.loadDocuments();
						}
					}, 5000);
					
					window.addEventListener('document-uploaded', () => {
						this.filePage = 1;
						this.refreshAll();
					});
				},

				destroy() {
					if (this.pipelinePollingInterval) {
						clearInterval(this.pipelinePollingInterval);
					}
					if (this._graphAnimFrame) {
						cancelAnimationFrame(this._graphAnimFrame);
					}
					if (this._graphSelectionAnimFrame) {
						cancelAnimationFrame(this._graphSelectionAnimFrame);
					}
					if (this._graphResizeObs) {
						this._graphResizeObs.disconnect();
					}
				},

				async refreshAll() {
					if (this.isRefreshing) return;
					this.isRefreshing = true;
					try {
						await Promise.all([
							this.loadFiles(),
							this.loadDocuments(),
							this.loadPipelineStatus(),
							this.loadQueueMetrics()
						]);
					} finally {
						setTimeout(() => { this.isRefreshing = false; }, 600);
					}
				},

				// === Pipeline Status ===
				async loadPipelineStatus() {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/enhanced-status?workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							this.pipelineStatus = await resp.json();
						}
					} catch (e) {
						console.error('Failed to load pipeline status:', e);
					}
				},

				async loadQueueMetrics() {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/queue-metrics?workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							this.queueMetrics = await resp.json();
						}
					} catch (e) {
						console.error('Failed to load queue metrics:', e);
					}
				},

				// === Selection ===
				toggleSelectAllFiles(checked) {
					if (checked) {
						this.selectedFiles = this.files.map(f => f.pdf_id);
					} else {
						this.selectedFiles = [];
					}
				},

				toggleSelectAllDocs(checked) {
					if (checked) {
						this.selectedDocs = this.filteredDocuments.filter(d => this.isTerminalStatus(d.status)).map(d => d.id);
					} else {
						this.selectedDocs = [];
					}
				},

				// === Bulk Operations ===
				async bulkDelete() {
					if (!confirm(`Are you sure you want to delete ${this.selectedFiles.length} files?`)) return;
					
					for (const id of this.selectedFiles) {
						await fetch(`/api/knowledge/pdfs/${id}?workspace_id=${this.workspaceId}`, { method: 'DELETE' });
					}
					this.selectedFiles = [];
					this.loadFiles();
					this.loadDocuments();
				},

				async bulkReprocess() {
					for (const pdfId of this.selectedFiles) {
						await this.reprocessFile(pdfId);
					}
					this.selectedFiles = [];
					this.refreshAll();
				},

				async bulkDeleteDocs() {
					if (!confirm(`Are you sure you want to delete ${this.selectedDocs.length} documents?`)) return;
					
					for (const id of this.selectedDocs) {
						await fetch(`/api/knowledge/documents/${id}?workspace_id=${this.workspaceId}`, { method: 'DELETE' });
					}
					this.selectedDocs = [];
					this.loadDocuments();
				},

				async bulkReprocessDocs() {
					for (const docId of this.selectedDocs) {
						await this.reprocessDocument(docId);
					}
					this.selectedDocs = [];
					this.refreshAll();
				},

				// === Rebuild/Reprocess ===
				async rebuildGraph() {
					this.rebuildingGraph = true;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${this.workspaceId}/rebuild`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ type: 'graph', force: this.rebuildGraphForce })
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} finally {
						setTimeout(() => { this.rebuildingGraph = false; }, 2000);
					}
				},

				async rebuildEmbeddings() {
					this.rebuildingEmbeddings = true;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${this.workspaceId}/rebuild`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ type: 'embeddings', force: this.rebuildEmbeddingsForce })
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} finally {
						setTimeout(() => { this.rebuildingEmbeddings = false; }, 2000);
					}
				},

				async reprocessAll() {
					if (!confirm('This will trigger reprocessing for ALL documents in this workspace. Continue?')) return;
					this.reprocessingAll = true;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/reprocess?workspace_id=${this.workspaceId}`, {
							method: 'POST'
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} finally {
						setTimeout(() => { this.reprocessingAll = false; }, 2000);
					}
				},

				async reprocessFailed() {
					this.reprocessingFailed = true;
					try {
						const resp = await fetch(`/api/knowledge/documents/reprocess-failed?workspace_id=${this.workspaceId}`, {
							method: 'POST'
						});
						if (resp.ok) {
							const data = await resp.json();
							if (data.requeued === 0) {
								alert('No failed documents found to reprocess.');
							}
							this.refreshAll();
						}
					} catch (e) {
						console.error('Failed to reprocess failed documents:', e);
					} finally {
						setTimeout(() => { this.reprocessingFailed = false; }, 2000);
					}
				},

				async scanDocuments() {
					this.scanningDocuments = true;
					try {
						const resp = await fetch(`/api/knowledge/documents/scan?workspace_id=${this.workspaceId}`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ path: './inputs' })
						});
						if (resp.ok) {
							this.refreshAll();
						} else {
							const data = await resp.json();
							alert(data.error || 'Failed to scan documents');
						}
					} catch (e) {
						console.error('Failed to scan documents:', e);
					} finally {
						setTimeout(() => { this.scanningDocuments = false; }, 2000);
					}
				},

				async deleteAllDocuments() {
					if (!confirm('Are you sure you want to DELETE ALL documents in this workspace? This action cannot be undone.')) return;
					if (!confirm('This is a destructive operation. Type "delete" to confirm.')) return;
					
					this.deletingAllDocs = true;
					try {
						const resp = await fetch(`/api/knowledge/documents?workspace_id=${this.workspaceId}`, {
							method: 'DELETE'
						});
						if (resp.ok) {
							const data = await resp.json();
							alert(`Deleted ${data.deleted_count} documents.`);
							this.refreshAll();
						}
					} catch (e) {
						console.error('Failed to delete all documents:', e);
					} finally {
						setTimeout(() => { this.deletingAllDocs = false; }, 2000);
					}
				},

				// === File Operations ===
				async loadFiles() {
					this.filesLoading = true;
					try {
						let url = `/api/knowledge/pdfs?workspace_id=${this.workspaceId}&page=${this.filePage}&page_size=${this.filePageSize}`;
						if (this.fileSearch) {
							url += `&search=${encodeURIComponent(this.fileSearch)}`;
						}
						
						const resp = await fetch(url);
						if (resp.ok) {
							const data = await resp.json();
							this.files = data.items || [];
							this.fileTotal = data.pagination?.total_count || 0;
							this.fileTotalPages = data.pagination?.total_pages || 0;
						}
					} catch (e) {
						console.error('Failed to load files:', e);
					} finally {
						setTimeout(() => { this.filesLoading = false; }, 300);
					}
				},

				// === Document Operations ===
				async loadDocuments() {
					this.docsLoading = true;
					try {
						let url = `/api/knowledge/documents?workspace_id=${this.workspaceId}&page=1&page_size=500`;
						
						const resp = await fetch(url);
						if (resp.ok) {
							const data = await resp.json();
							this.documents = data.documents || [];
							this.docTotal = data.total || this.documents.length;
							this.docTotalPages = 1;
							// Use server status_counts if available, otherwise compute client-side
							if (data.status_counts && Object.values(data.status_counts).some(v => v > 0)) {
								this.statusCounts = data.status_counts;
							} else {
								this.computeStatusCounts();
							}
						}
					} catch (e) {
						console.error('Failed to load documents:', e);
					} finally {
						setTimeout(() => { this.docsLoading = false; }, 300);
					}
				},

				computeStatusCounts() {
					const counts = { pending: 0, processing: 0, completed: 0, partial_failure: 0, failed: 0, cancelled: 0 };
					for (const doc of this.documents) {
						const status = doc.status || doc.current_stage || 'completed';
						if (status in counts) {
							counts[status]++;
						} else if (['uploading', 'converting', 'preprocessing', 'chunking', 'extracting', 'gleaning', 'merging', 'summarizing', 'embedding', 'storing', 'indexing'].includes(status)) {
							counts.processing++;
						} else if (status === 'indexed' || status === 'partial_success') {
							counts.completed++;
						} else {
							counts.completed++;
						}
					}
					this.statusCounts = counts;
				},

				filterByStatus(status) {
					this.docStatusFilter = status;
					this.selectedDocs = [];
				},

				async deleteFile(id, name) {
					if (!confirm(`Are you sure you want to delete file "${name}"? This action cannot be undone.`)) {
						return;
					}
					
					try {
						const resp = await fetch(`/api/knowledge/pdfs/${id}?workspace_id=${this.workspaceId}`, {
							method: 'DELETE',
						});
						
						if (resp.ok) {
							this.loadFiles();
							this.loadDocuments();
						} else {
							alert('Failed to delete file');
						}
					} catch (e) {
						console.error('Failed to delete file:', e);
						alert('An error occurred while deleting the file');
					}
				},

				async retryPdf(pdfId) {
					try {
						const resp = await fetch(`/api/knowledge/pdfs/${pdfId}/retry`, {
							method: 'POST'
						});
						if (resp.ok) {
							this.refreshAll();
						} else {
							const data = await resp.json();
							alert(data.error || 'Failed to retry PDF processing');
						}
					} catch (e) {
						console.error('Failed to retry PDF:', e);
					}
				},

				async reprocessDocument(id) {
					try {
						const resp = await fetch(`/api/knowledge/documents/reprocess?workspace_id=${this.workspaceId}`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ document_id: id })
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} catch (e) {
						console.error('Failed to reprocess document:', e);
					}
				},

				async cancelTask(taskId) {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/cancel`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ task_id: taskId })
						});
						if (resp.ok || resp.status === 409) {
							this.loadDocuments();
							this.loadPipelineStatus();
						}
					} catch (e) {
						console.error('Failed to cancel task:', e);
					}
				},

				async retryTask(trackId) {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/retry`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ task_id: trackId })
						});
						if (resp.ok) {
							this.refreshAll();
						} else {
							const data = await resp.json();
							alert(data.error || 'Failed to retry task');
						}
					} catch (e) {
						console.error('Failed to retry task:', e);
					}
				},

				async deleteDocument(id, title) {
					if (!confirm(`Are you sure you want to delete "${title}"?`)) return;
					try {
						const resp = await fetch(`/api/knowledge/documents/${id}?workspace_id=${this.workspaceId}`, {
							method: 'DELETE'
						});
						if (resp.ok) {
							this.loadDocuments();
						} else {
							alert('Failed to delete document');
						}
					} catch (e) {
						console.error('Failed to delete document:', e);
					}
				},

				async cancelDocumentTask(docId, trackId) {
					const finalTrackId = trackId || 
						this.pipelineTasks.find(t => t.document_id === docId)?.track_id ||
						this.documents.find(d => d.id === docId)?.track_id;

					if (finalTrackId) {
						await this.cancelTask(finalTrackId);
					} else {
						console.warn('Could not find track_id for document cancellation:', docId);
					}
				},

				async reprocessFile(pdfId) {
					const doc = this.documents.find(d => d.pdf_id === pdfId);
					if (doc) {
						await this.reprocessDocument(doc.id);
					} else {
						// Try retrying PDF processing directly
						await this.retryPdf(pdfId);
					}
				},

				// === Utilities ===
				formatBytes(bytes, decimals = 2) {
					if (!+bytes) return '0 Bytes';
					const k = 1024;
					const dm = decimals < 0 ? 0 : decimals;
					const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
				},

				formatDate(dateString) {
					if (!dateString) return '';
					return new Date(dateString).toLocaleDateString(undefined, {
						year: 'numeric',
						month: 'short',
						day: 'numeric',
						hour: '2-digit',
						minute: '2-digit'
					});
				},

				formatDuration(seconds) {
					if (!seconds || seconds <= 0) return '-';
					if (seconds < 60) return `${Math.round(seconds)}s`;
					if (seconds < 3600) return `${Math.round(seconds / 60)}m`;
					return `${Math.round(seconds / 3600)}h ${Math.round((seconds % 3600) / 60)}m`;
				},

				isProcessingStatus(status) {
					if (!status) return false;
					return [
						'processing', 'pending', 'uploading', 'converting', 
						'preprocessing', 'chunking', 'extracting', 'gleaning', 
						'merging', 'summarizing', 'embedding', 'storing', 'indexing'
					].includes(status.toLowerCase());
				},

				isTerminalStatus(status) {
					if (!status) return false;
					return [
						'completed', 'indexed', 'failed', 'partial_failure', 'partial_success', 'cancelled'
					].includes(status.toLowerCase());
				},

				stageIcon(stage) {
					const icons = {
						'uploading': '📤', 'converting': '🔄', 'preprocessing': '⚙️',
						'chunking': '✂️', 'extracting': '🔍', 'gleaning': '🔬',
						'merging': '🔗', 'summarizing': '📝', 'embedding': '📊',
						'storing': '💾', 'completed': '✅', 'failed': '❌',
						'pending': '⏳', 'indexing': '📁', 'cancelled': '🚫'
					};
					return icons[stage] || '⏳';
				},

				timeAgo(dateString) {
					if (!dateString) return '';
					const d = new Date(dateString);
					const now = new Date();
					const seconds = Math.floor((now - d) / 1000);
					if (seconds < 60) return 'just now';
					const minutes = Math.floor(seconds / 60);
					if (minutes < 60) return minutes + 'm ago';
					const hours = Math.floor(minutes / 60);
					if (hours < 24) return hours + 'h ago';
					const days = Math.floor(hours / 24);
					if (days < 30) return days + 'd ago';
					return this.formatDate(dateString);
				},

				highlightSearch(text) {
					if (!text || !this.docSearch) return text;
					const q = this.docSearch.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
					return text.replace(new RegExp(`(${q})`, 'gi'), '<mark class="bg-yellow-200 dark:bg-yellow-800 rounded px-0.5">$1</mark>');
				},

				fileTypeIcon(fileName) {
					if (!fileName) return '<span class="text-muted-foreground">📄</span>';
					const ext = fileName.split('.').pop()?.toLowerCase() || '';
					const icons = {
						'pdf': '📕', 'txt': '📄', 'md': '📝', 'markdown': '📝',
						'doc': '📘', 'docx': '📘', 'csv': '📊', 'json': '📋',
						'html': '🌐', 'htm': '🌐', 'xml': '📰', 'rtf': '📄',
						'epub': '📚', 'pptx': '📙', 'ppt': '📙', 'xlsx': '📊', 'xls': '📊',
					};
					return `<span class="text-base">${icons[ext] || '📄'}</span>`;
				},

				isNewDocument(doc) {
					if (!doc?.created_at) return false;
					const created = new Date(doc.created_at);
					const now = new Date();
					return (now - created) < 5 * 60 * 1000; // 5 minutes
				},

				toggleSort(field) {
					if (this.sortField === field) {
						this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
					} else {
						this.sortField = field;
						this.sortDirection = 'desc';
					}
				},

				handleSearch() {
					this.docPage = 1;
				},

				viewInGraph(doc) {
					// Switch to graph tab and search for document-related entities
					const tabEl = document.querySelector('[data-tab-value="graph"]');
					if (tabEl) tabEl.click();
					this.$nextTick(() => {
						if (doc.title || doc.file_name) {
							this.graphSearch = doc.title || doc.file_name;
							this.searchGraph();
						}
					});
				},

				statusBadgeClass(status) {
					if (!status) return 'bg-muted text-muted-foreground';
					const s = status.toLowerCase();
					if (s === 'completed' || s === 'indexed' || s === 'partial_success') return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 border-green-200 dark:border-green-800';
					if (this.isProcessingStatus(s)) return 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400 border-blue-200 dark:border-blue-800';
					if (s === 'pending') return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400 border-yellow-200 dark:border-yellow-800';
					if (s === 'failed') return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400 border-red-200 dark:border-red-800';
					if (s === 'cancelled' || s === 'partial_failure') return 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400 border-orange-200 dark:border-orange-800';
					return 'bg-muted text-muted-foreground';
				},

				statusLabel(status) {
					if (!status) return 'Unknown';
					return status.charAt(0).toUpperCase() + status.slice(1).replace(/_/g, ' ');
				},

				// === Document Preview ===
				async openDocumentPreview(doc) {
					this.previewDoc = doc;
					this.previewContent = null;
					
					// Try to load full document detail
					try {
						const resp = await fetch(`/api/knowledge/documents/${doc.id}?workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							const detail = await resp.json();
							this.previewDoc = { ...doc, ...detail };
							if (detail.content) {
								this.previewContent = detail.content;
							}
						}
					} catch (e) {
						console.error('Failed to load document detail:', e);
					}

					// If document has a PDF, try to load PDF content
					if (doc.pdf_id && !this.previewContent) {
						try {
							const resp = await fetch(`/api/knowledge/pdfs/${doc.pdf_id}/content?workspace_id=${this.workspaceId}`);
							if (resp.ok) {
								const pdfContent = await resp.json();
								if (pdfContent.markdown_content) {
									this.previewContent = pdfContent.markdown_content;
								}
							}
						} catch (e) {
							console.error('Failed to load PDF content:', e);
						}
					}
				},

				closePreview() {
					this.previewDoc = null;
					this.previewContent = null;
				},

				// === Knowledge Graph ===
				async loadGraph() {
					this.graphLoading = true;
					this.selectedNode = null;
					this.selectedNodeEdges = [];
					try {
						const resp = await fetch(`/api/knowledge/graph?workspace_id=${this.workspaceId}&max_nodes=${this.graphMaxNodes}`);
						if (resp.ok) {
							this.graphData = await resp.json();
							// Initialize visible types from data
							const types = new Set();
							(this.graphData.nodes || []).forEach(n => types.add(n.node_type || 'UNKNOWN'));
							this.graphVisibleTypes = [...types];
							this.$nextTick(() => this.initGraph());
						} else {
							this.graphData = null;
						}
					} catch (e) {
						console.error('Failed to load graph:', e);
						this.graphData = null;
					} finally {
						this.graphLoading = false;
					}
				},

				async searchGraph() {
					if (!this.graphSearch.trim()) {
						this._graphSearchMatches = new Set();
						this.loadGraph();
						return;
					}
					this.graphLoading = true;
					try {
						const resp = await fetch(`/api/knowledge/graph/nodes/search?workspace_id=${this.workspaceId}&q=${encodeURIComponent(this.graphSearch)}&limit=50`);
						if (resp.ok) {
							const data = await resp.json();
							this.graphData = {
								nodes: data.nodes || [],
								edges: data.edges || [],
								total_nodes: data.total_matches || 0,
								total_edges: (data.edges || []).length,
								is_truncated: data.is_truncated || false,
							};
							const types = new Set();
							(this.graphData.nodes || []).forEach(n => types.add(n.node_type || 'UNKNOWN'));
							this.graphVisibleTypes = [...types];
							// Mark search matches for highlighting
							this._graphSearchMatches = new Set((data.nodes || []).map(n => n.id));
							this.$nextTick(() => this.initGraph());
						}
					} catch (e) {
						console.error('Failed to search graph:', e);
					} finally {
						this.graphLoading = false;
					}
				},

				getNodeLabel(nodeId) {
					if (!nodeId) return '';
					const node = this._graphNodeMap[nodeId];
					return node ? node.label : nodeId.substring(0, 8);
				},

				// Safe properties accessor: handles json.RawMessage (already object) or JSON string
				getNodeProperties() {
					const props = this.selectedNode?.properties;
					if (!props) return {};
					if (typeof props === 'object') return props;
					try { return JSON.parse(props); } catch { return {}; }
				},

				// Context menu actions
				contextMenuAction(action) {
					const node = this._graphContextMenu?.node;
					this._graphContextMenu = { visible: false };
					if (!node) return;
					switch (action) {
						case 'details':
							this.selectedNode = node;
							this.selectedNodeEdges = this._graphEdges.filter(
								e => e.source === node.id || e.target === node.id
							);
							this.graphDraw();
							break;
						case 'focus':
							this.focusNode(node.id);
							break;
						case 'neighbors':
							this.selectedNode = node;
							this.selectedNodeEdges = this._graphEdges.filter(
								e => e.source === node.id || e.target === node.id
							);
							this.graphDraw();
							break;
						case 'copyId':
							navigator.clipboard.writeText(node.id).catch(() => {});
							break;
						case 'copyLabel':
							navigator.clipboard.writeText(node.label).catch(() => {});
							break;
					}
				},

				// Selection pulsing animation (like Edgequake: border oscillates 3.5-4.5px at 20fps)
				_startSelectionPulse() {
					if (this._graphSelectionAnimFrame) return;
					const animate = () => {
						this._graphSelectionPulse = (this._graphSelectionPulse + 0.1) % (Math.PI * 2);
						this.graphDraw();
						if (this.selectedNode) {
							this._graphSelectionAnimFrame = setTimeout(() => {
								requestAnimationFrame(animate);
							}, 50); // ~20fps
						} else {
							this._graphSelectionAnimFrame = null;
						}
					};
					requestAnimationFrame(animate);
				},

				_stopSelectionPulse() {
					if (this._graphSelectionAnimFrame) {
						clearTimeout(this._graphSelectionAnimFrame);
						this._graphSelectionAnimFrame = null;
					}
					this._graphSelectionPulse = 0;
				},

				toggleEntityType(type) {
					const idx = this.graphVisibleTypes.indexOf(type);
					if (idx >= 0) {
						this.graphVisibleTypes.splice(idx, 1);
					} else {
						this.graphVisibleTypes.push(type);
					}
					this.graphDraw();
				},

				focusNode(nodeId) {
					const node = this._graphNodeMap[nodeId];
					if (!node) return;
					// Select the node
					this.selectedNode = node;
					this.selectedNodeEdges = this._graphEdges.filter(
						e => e.source === node.id || e.target === node.id
					);
					this._startSelectionPulse();
					// Animate camera to center on node
					const t = this._graphTransform;
					const targetX = this._graphW / 2 - node.x * t.k;
					const targetY = this._graphH / 2 - node.y * t.k;
					const startX = t.x, startY = t.y;
					const duration = 400;
					const start = performance.now();
					const animate = (now) => {
						const elapsed = Math.min(1, (now - start) / duration);
						// Ease out cubic for smoother deceleration
						const ease = 1 - Math.pow(1 - elapsed, 3);
						t.x = startX + (targetX - startX) * ease;
						t.y = startY + (targetY - startY) * ease;
						this.graphDraw();
						if (elapsed < 1) requestAnimationFrame(animate);
					};
					requestAnimationFrame(animate);
				},

				// Graph initialization
				initGraph() {
					const canvas = document.getElementById('graph-canvas');
					if (!canvas || !this.graphData || !this.graphData.nodes?.length) return;

					// Cleanup previous
					if (this._graphAnimFrame) cancelAnimationFrame(this._graphAnimFrame);
					if (this._graphResizeObs) this._graphResizeObs.disconnect();

					const ctx = canvas.getContext('2d');
					this._graphCanvas = canvas;
					this._graphCtx = ctx;

					const setupSize = () => {
						const container = canvas.parentElement;
						const rect = container.getBoundingClientRect();
						this._graphDpr = window.devicePixelRatio || 1;
						canvas.width = rect.width * this._graphDpr;
						canvas.height = rect.height * this._graphDpr;
						canvas.style.width = rect.width + 'px';
						canvas.style.height = rect.height + 'px';
						this._graphW = rect.width;
						this._graphH = rect.height;
					};
					setupSize();

					// ResizeObserver for responsive canvas
					this._graphResizeObs = new ResizeObserver(() => {
						setupSize();
						this.graphDraw();
					});
					this._graphResizeObs.observe(canvas.parentElement);

					// Compute max degree for node sizing
					const maxDegree = Math.max(1, ...this.graphData.nodes.map(n => n.degree || 1));

					// Build positioned nodes
					const W = this._graphW;
					const H = this._graphH;
					const nodes = this.graphData.nodes.map((n) => ({
						...n,
						x: W / 2 + (Math.random() - 0.5) * W * 0.6,
						y: H / 2 + (Math.random() - 0.5) * H * 0.6,
						vx: 0, vy: 0,
						// Logarithmic sizing like Sigma.js: base + log scale
						radius: Math.max(4, Math.min(24, 6 + Math.log2(1 + (n.degree || 1)) * (14 / Math.log2(1 + maxDegree)))),
					}));

					const nodeMap = {};
					nodes.forEach(n => { nodeMap[n.id] = n; });

					const edges = (this.graphData.edges || []).filter(e => nodeMap[e.source] && nodeMap[e.target]);

					this._graphNodes = nodes;
					this._graphEdges = edges;
					this._graphNodeMap = nodeMap;
					this._graphTransform = { x: 0, y: 0, k: 1 };
					this._graphHoveredNode = null;
					this._graphDragging = null;

					// Apply layout
					this.applyLayout();

					// Setup mouse events
					this._setupGraphInteraction(canvas);
				},

				applyLayout() {
					const nodes = this._graphNodes;
					const edges = this._graphEdges;
					const nodeMap = this._graphNodeMap;
					const W = this._graphW;
					const H = this._graphH;
					if (!nodes.length) return;

					if (this._graphAnimFrame) cancelAnimationFrame(this._graphAnimFrame);

					const layout = this.graphLayout;

					if (layout === 'circular') {
						// Circular layout
						const cx = W / 2, cy = H / 2;
						const radius = Math.min(W, H) * 0.35;
						nodes.forEach((n, i) => {
							const angle = (2 * Math.PI * i) / nodes.length;
							n.x = cx + Math.cos(angle) * radius;
							n.y = cy + Math.sin(angle) * radius;
							n.vx = 0; n.vy = 0;
						});
						this._graphTransform = { x: 0, y: 0, k: 1 };
						this.graphDraw();
						return;
					}

					if (layout === 'hierarchical') {
						// Group by type, arrange in rows
						const groups = {};
						nodes.forEach(n => {
							const t = n.node_type || 'UNKNOWN';
							if (!groups[t]) groups[t] = [];
							groups[t].push(n);
						});
						const typeKeys = Object.keys(groups);
						const rowHeight = H / (typeKeys.length + 1);
						typeKeys.forEach((type, rowIdx) => {
							const row = groups[type];
							const colWidth = W / (row.length + 1);
							row.forEach((n, colIdx) => {
								n.x = colWidth * (colIdx + 1);
								n.y = rowHeight * (rowIdx + 1);
								n.vx = 0; n.vy = 0;
							});
						});
						this._graphTransform = { x: 0, y: 0, k: 1 };
						this.graphDraw();
						return;
					}

					// Force-based layouts (ForceAtlas2 / Force Directed)
					const isFA2 = layout === 'force-atlas';
					const gravity = isFA2 ? 1.0 : 0.5;
					const scalingRatio = isFA2 ? 2.0 : 5.0;
					const useBarnesHut = nodes.length > 100;
					const maxIterations = isFA2 ? 100 : 150;
					let iterations = 0;

					// Build adjacency for degree computation
					const adjacency = {};
					nodes.forEach(n => { adjacency[n.id] = []; });
					edges.forEach(e => {
						if (adjacency[e.source]) adjacency[e.source].push(e.target);
						if (adjacency[e.target]) adjacency[e.target].push(e.source);
					});

					const simulate = () => {
						iterations++;
						const alpha = Math.max(0.001, 1 - iterations / maxIterations);
						const repulsionK = scalingRatio * 100;

						if (useBarnesHut) {
							// Barnes-Hut approximation using quadtree
							const qt = this._buildQuadTree(nodes, W, H);
							for (const n of nodes) {
								if (n === this._graphDragging) continue;
								const force = this._queryQuadTree(qt, n, repulsionK, 0.5);
								n.vx += force.fx * alpha;
								n.vy += force.fy * alpha;
							}
						} else {
							// Direct N-body repulsion
							for (let i = 0; i < nodes.length; i++) {
								if (nodes[i] === this._graphDragging) continue;
								for (let j = i + 1; j < nodes.length; j++) {
									const ni = nodes[i], nj = nodes[j];
									let dx = nj.x - ni.x;
									let dy = nj.y - ni.y;
									let dist = Math.sqrt(dx * dx + dy * dy) || 1;
									// ForceAtlas2 repulsion: k * (deg+1) * (deg+1) / dist
									const degI = (adjacency[ni.id]?.length || 0) + 1;
									const degJ = (adjacency[nj.id]?.length || 0) + 1;
									let force;
									if (isFA2) {
										force = -repulsionK * degI * degJ / (dist * dist);
									} else {
										force = -repulsionK / (dist * dist);
									}
									const fx = (dx / dist) * force * alpha;
									const fy = (dy / dist) * force * alpha;
									ni.vx -= fx;
									ni.vy -= fy;
									nj.vx += fx;
									nj.vy += fy;
								}
							}
						}

						// Edge attraction
						for (const e of edges) {
							const s = nodeMap[e.source];
							const t = nodeMap[e.target];
							if (!s || !t) continue;
							let dx = t.x - s.x;
							let dy = t.y - s.y;
							let dist = Math.sqrt(dx * dx + dy * dy) || 1;
							let force;
							if (isFA2) {
								// ForceAtlas2: linear attraction
								force = dist * 0.01 * alpha;
							} else {
								// Spring force
								force = (dist - 100) * 0.02 * alpha;
							}
							const weight = e.weight || 1;
							const fx = (dx / dist) * force * weight;
							const fy = (dy / dist) * force * weight;
							if (s !== this._graphDragging) { s.vx += fx; s.vy += fy; }
							if (t !== this._graphDragging) { t.vx -= fx; t.vy -= fy; }
						}

						// Center gravity (strong gravity mode for FA2)
						for (const n of nodes) {
							if (n === this._graphDragging) continue;
							const dx = W / 2 - n.x;
							const dy = H / 2 - n.y;
							const dist = Math.sqrt(dx * dx + dy * dy) || 1;
							if (isFA2) {
								// Strong gravity
								const deg = (adjacency[n.id]?.length || 0) + 1;
								n.vx += (dx / dist) * gravity * deg * alpha;
								n.vy += (dy / dist) * gravity * deg * alpha;
							} else {
								n.vx += dx * 0.01 * gravity * alpha;
								n.vy += dy * 0.01 * gravity * alpha;
							}
						}

						// Apply velocities with damping
						const damping = isFA2 ? 0.5 : 0.6;
						const speed = isFA2 ? 1.0 : 0.8;
						for (const n of nodes) {
							if (n === this._graphDragging) continue;
							n.vx *= damping;
							n.vy *= damping;
							// Speed limit
							const vmag = Math.sqrt(n.vx * n.vx + n.vy * n.vy);
							const maxSpeed = 10 * speed;
							if (vmag > maxSpeed) {
								n.vx = (n.vx / vmag) * maxSpeed;
								n.vy = (n.vy / vmag) * maxSpeed;
							}
							n.x += n.vx;
							n.y += n.vy;
						}

						this.graphDraw();
						if (iterations < maxIterations) {
							this._graphAnimFrame = requestAnimationFrame(simulate);
						}
					};

					simulate();
				},

				// Simple quadtree for Barnes-Hut
				_buildQuadTree(nodes, W, H) {
					const root = { x: 0, y: 0, w: W, h: H, mass: 0, cx: 0, cy: 0, children: null, node: null };
					for (const n of nodes) {
						this._insertQuadTree(root, n, 0);
					}
					return root;
				},

				_insertQuadTree(cell, node, depth) {
					if (depth > 20) return;
					if (cell.mass === 0 && !cell.node) {
						cell.node = node;
						cell.mass = 1;
						cell.cx = node.x;
						cell.cy = node.y;
						return;
					}
					if (!cell.children) {
						cell.children = [];
						const hw = cell.w / 2, hh = cell.h / 2;
						cell.children.push({ x: cell.x, y: cell.y, w: hw, h: hh, mass: 0, cx: 0, cy: 0, children: null, node: null });
						cell.children.push({ x: cell.x + hw, y: cell.y, w: hw, h: hh, mass: 0, cx: 0, cy: 0, children: null, node: null });
						cell.children.push({ x: cell.x, y: cell.y + hh, w: hw, h: hh, mass: 0, cx: 0, cy: 0, children: null, node: null });
						cell.children.push({ x: cell.x + hw, y: cell.y + hh, w: hw, h: hh, mass: 0, cx: 0, cy: 0, children: null, node: null });
						if (cell.node) {
							this._insertQuadTree(this._getQuadrant(cell, cell.node), cell.node, depth + 1);
							cell.node = null;
						}
					}
					cell.cx = (cell.cx * cell.mass + node.x) / (cell.mass + 1);
					cell.cy = (cell.cy * cell.mass + node.y) / (cell.mass + 1);
					cell.mass++;
					this._insertQuadTree(this._getQuadrant(cell, node), node, depth + 1);
				},

				_getQuadrant(cell, node) {
					const mx = cell.x + cell.w / 2;
					const my = cell.y + cell.h / 2;
					const idx = (node.x >= mx ? 1 : 0) + (node.y >= my ? 2 : 0);
					return cell.children[idx];
				},

				_queryQuadTree(cell, node, k, theta) {
					let fx = 0, fy = 0;
					if (cell.mass === 0) return { fx, fy };
					const dx = cell.cx - node.x;
					const dy = cell.cy - node.y;
					const dist = Math.sqrt(dx * dx + dy * dy) || 1;
					
					if (cell.children === null || (cell.w / dist) < theta) {
						if (cell.node === node) return { fx: 0, fy: 0 };
						const force = -k * cell.mass / (dist * dist);
						return { fx: (dx / dist) * force, fy: (dy / dist) * force };
					}
					
					for (const child of cell.children) {
						const f = this._queryQuadTree(child, node, k, theta);
						fx += f.fx;
						fy += f.fy;
					}
					return { fx, fy };
				},

				// Graph rendering - Professional quality matching Edgequake UI
				graphDraw() {
					const ctx = this._graphCtx;
					const canvas = this._graphCanvas;
					if (!ctx || !canvas) return;

					const dpr = this._graphDpr;
					const W = this._graphW;
					const H = this._graphH;
					const t = this._graphTransform;
					const nodes = this._graphNodes;
					const edges = this._graphEdges;
					const nodeMap = this._graphNodeMap;
					const isDark = document.documentElement.classList.contains('dark');

					ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					ctx.clearRect(0, 0, W, H);

					// Background with subtle grid pattern
					ctx.fillStyle = isDark ? '#0f1117' : '#fafbfc';
					ctx.fillRect(0, 0, W, H);
					if (t.k > 0.3) {
						const gridSize = 40 * t.k;
						ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.03)';
						ctx.lineWidth = 1;
						const offsetX = t.x % gridSize;
						const offsetY = t.y % gridSize;
						for (let x = offsetX; x < W; x += gridSize) {
							ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
						}
						for (let y = offsetY; y < H; y += gridSize) {
							ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
						}
					}

					ctx.save();
					ctx.translate(t.x, t.y);
					ctx.scale(t.k, t.k);

					// Determine visible nodes
					const visibleTypes = new Set(this.graphVisibleTypes);
					const visibleNodes = new Set();
					nodes.forEach(n => {
						if (visibleTypes.has(n.node_type || 'UNKNOWN')) visibleNodes.add(n.id);
					});

					// Neighbor highlighting
					const highlightedNodes = new Set();
					const highlightedEdges = new Set();
					const selectedId = this.selectedNode?.id;
					const hoveredId = this._graphHoveredNode?.id;
					const focusId = selectedId || hoveredId;
					
					if (focusId) {
						highlightedNodes.add(focusId);
						edges.forEach((e, i) => {
							if (e.source === focusId || e.target === focusId) {
								highlightedEdges.add(i);
								highlightedNodes.add(e.source);
								highlightedNodes.add(e.target);
							}
						});
					}

					// Search match highlighting
					const searchMatches = this._graphSearchMatches;
					const hasSearchMatches = searchMatches && searchMatches.size > 0;

					// Build parallel edge map for offset curves
					const edgePairCount = {};
					const edgePairIndex = {};
					edges.forEach((e, idx) => {
						const key = [e.source, e.target].sort().join('|');
						edgePairCount[key] = (edgePairCount[key] || 0) + 1;
						edgePairIndex[idx] = edgePairCount[key] - 1;
					});

					// Draw edges
					edges.forEach((e, idx) => {
						const s = nodeMap[e.source];
						const tgt = nodeMap[e.target];
						if (!s || !tgt) return;
						if (!visibleNodes.has(e.source) || !visibleNodes.has(e.target)) return;

						const isHighlighted = highlightedEdges.has(idx);
						const dimmed = focusId && !isHighlighted;

						// Skip completely hidden edges (Edgequake-style: hide non-connected on hover)
						if (dimmed && hoveredId) return;

						// Curved edge with Edgequake curvature=0.25 and parallel edge offset
						const dx = tgt.x - s.x;
						const dy = tgt.y - s.y;
						const dist = Math.sqrt(dx * dx + dy * dy) || 1;
						const pairKey = [e.source, e.target].sort().join('|');
						const pairTotal = edgePairCount[pairKey] || 1;
						const pairIdx = edgePairIndex[idx] || 0;
						// Base curvature + offset for parallel edges
						const curvature = 0.25 + (pairTotal > 1 ? (pairIdx - (pairTotal - 1) / 2) * 0.15 : 0);
						const cx = (s.x + tgt.x) / 2 + dy * curvature;
						const cy = (s.y + tgt.y) / 2 - dx * curvature;

						ctx.beginPath();
						ctx.moveTo(s.x, s.y);
						ctx.quadraticCurveTo(cx, cy, tgt.x, tgt.y);
						
						const weight = Math.max(0.5, Math.min(4, (e.weight || 1)));
						ctx.lineWidth = isHighlighted ? weight * 2.5 : weight * 0.8;
						
						if (isHighlighted) {
							ctx.strokeStyle = isDark ? '#60a5fa' : '#3b82f6';
							ctx.globalAlpha = 0.9;
						} else if (dimmed) {
							ctx.strokeStyle = isDark ? '#1f2937' : '#e5e7eb';
							ctx.globalAlpha = 0.08;
						} else {
							ctx.strokeStyle = isDark ? '#374151' : '#94a3b8';
							ctx.globalAlpha = 0.35;
						}
						ctx.stroke();
						ctx.globalAlpha = 1;

						// Arrow head (refined)
						if (t.k > 0.25) {
							const arrowSize = isHighlighted ? 9 : 6;
							const targetR = tgt.radius || 6;
							// Point on curve near target
							const at = 0.88;
							const ax = (1-at)*(1-at)*s.x + 2*(1-at)*at*cx + at*at*tgt.x;
							const ay = (1-at)*(1-at)*s.y + 2*(1-at)*at*cy + at*at*tgt.y;
							const angle = Math.atan2(tgt.y - ay, tgt.x - ax);
							
							const tipX = tgt.x - Math.cos(angle) * (targetR + 1);
							const tipY = tgt.y - Math.sin(angle) * (targetR + 1);
							
							ctx.beginPath();
							ctx.moveTo(tipX, tipY);
							ctx.lineTo(
								tipX - Math.cos(angle) * arrowSize + Math.sin(angle) * arrowSize * 0.4,
								tipY - Math.sin(angle) * arrowSize - Math.cos(angle) * arrowSize * 0.4
							);
							ctx.lineTo(
								tipX - Math.cos(angle) * arrowSize - Math.sin(angle) * arrowSize * 0.4,
								tipY - Math.sin(angle) * arrowSize + Math.cos(angle) * arrowSize * 0.4
							);
							ctx.closePath();
							if (isHighlighted) {
								ctx.fillStyle = isDark ? '#60a5fa' : '#3b82f6';
								ctx.globalAlpha = 0.9;
							} else if (dimmed) {
								ctx.fillStyle = isDark ? '#1f2937' : '#e5e7eb';
								ctx.globalAlpha = 0.08;
							} else {
								ctx.fillStyle = isDark ? '#374151' : '#94a3b8';
								ctx.globalAlpha = 0.35;
							}
							ctx.fill();
							ctx.globalAlpha = 1;
						}

						// Edge labels
						if (this.graphShowEdgeLabels && t.k > 0.5 && (isHighlighted || (!focusId && t.k > 0.8))) {
							const labelX = cx;
							const labelY = cy;
							const fontSize = Math.max(8, 10 / t.k);
							ctx.font = `500 ${Math.min(fontSize, 11)}px Inter, system-ui, sans-serif`;
							const label = e.edge_type || '';
							// Background pill
							const metrics = ctx.measureText(label);
							const pw = metrics.width + 8;
							const ph = fontSize + 6;
							ctx.fillStyle = isDark ? 'rgba(15,17,23,0.85)' : 'rgba(255,255,255,0.9)';
							ctx.beginPath();
							ctx.roundRect(labelX - pw/2, labelY - ph/2, pw, ph, 4);
							ctx.fill();
							if (isHighlighted) {
								ctx.strokeStyle = isDark ? '#60a5fa44' : '#3b82f644';
								ctx.lineWidth = 1;
								ctx.stroke();
							}
							ctx.fillStyle = isHighlighted ? (isDark ? '#93c5fd' : '#2563eb') : (isDark ? '#6b7280' : '#9ca3af');
							ctx.textAlign = 'center';
							ctx.textBaseline = 'middle';
							ctx.fillText(label, labelX, labelY);
						}
					});

					// Draw nodes (sorted: dimmed first, then normal, then highlighted/selected on top)
					const sortedNodes = [...nodes].sort((a, b) => {
						const aScore = (a.id === selectedId ? 100 : 0) + (a.id === hoveredId ? 50 : 0) + (highlightedNodes.has(a.id) ? 10 : 0);
						const bScore = (b.id === selectedId ? 100 : 0) + (b.id === hoveredId ? 50 : 0) + (highlightedNodes.has(b.id) ? 10 : 0);
						return aScore - bScore;
					});

					for (const n of sortedNodes) {
						if (!visibleNodes.has(n.id)) continue;

						const color = this.entityColors[n.node_type] || this.entityColors['UNKNOWN'];
						const isSelected = selectedId === n.id;
						const isHovered = hoveredId === n.id;
						const isNeighbor = highlightedNodes.has(n.id);
						const dimmed = focusId && !isNeighbor;
						const isSearchMatch = hasSearchMatches && searchMatches.has(n.id);

						// Edgequake-style: completely hide non-connected nodes on hover
						if (dimmed && hoveredId) continue;

						// Edgequake sizing: selected=2x, hovered=1.3x
						const r = n.radius * (isSelected ? 2.0 : isHovered ? 1.3 : 1);

						// Outer glow for selected node (pulsing)
						if (isSelected) {
							const pulseSize = 3.5 + Math.sin(this._graphSelectionPulse) * 1.0;
							ctx.beginPath();
							ctx.arc(n.x, n.y, r + pulseSize + 4, 0, 2 * Math.PI);
							const glowGrad = ctx.createRadialGradient(n.x, n.y, r, n.x, n.y, r + pulseSize + 4);
							glowGrad.addColorStop(0, isDark ? 'rgba(96,165,250,0.3)' : 'rgba(37,99,235,0.25)');
							glowGrad.addColorStop(1, 'rgba(96,165,250,0)');
							ctx.fillStyle = glowGrad;
							ctx.fill();
						}

						// Search match glow ring
						if (isSearchMatch && !isSelected) {
							ctx.beginPath();
							ctx.arc(n.x, n.y, r + 6, 0, 2 * Math.PI);
							const searchGrad = ctx.createRadialGradient(n.x, n.y, r, n.x, n.y, r + 6);
							searchGrad.addColorStop(0, 'rgba(234,179,8,0.4)');
							searchGrad.addColorStop(1, 'rgba(234,179,8,0)');
							ctx.fillStyle = searchGrad;
							ctx.fill();
						}

						// Hover glow
						if (isHovered && !isSelected) {
							ctx.beginPath();
							ctx.arc(n.x, n.y, r + 5, 0, 2 * Math.PI);
							const hoverGrad = ctx.createRadialGradient(n.x, n.y, r, n.x, n.y, r + 5);
							hoverGrad.addColorStop(0, isDark ? 'rgba(96,165,250,0.2)' : 'rgba(37,99,235,0.15)');
							hoverGrad.addColorStop(1, 'rgba(96,165,250,0)');
							ctx.fillStyle = hoverGrad;
							ctx.fill();
						}

						// Border ring (Edgequake NodeBorderProgram style)
						if (isSelected || isHovered) {
							const borderWidth = isSelected ? (3.5 + Math.sin(this._graphSelectionPulse) * 1.0) : 2.5;
							ctx.beginPath();
							ctx.arc(n.x, n.y, r + borderWidth, 0, 2 * Math.PI);
							ctx.fillStyle = isSelected ? (isDark ? '#60a5fa' : '#2563eb') : (isDark ? '#60a5fa99' : '#3b82f699');
							ctx.fill();
						}

						// Node fill with subtle gradient for depth
						ctx.beginPath();
						ctx.arc(n.x, n.y, r, 0, 2 * Math.PI);
						const grad = ctx.createRadialGradient(n.x - r * 0.3, n.y - r * 0.3, r * 0.1, n.x, n.y, r);
						const baseColor = color;
						grad.addColorStop(0, this._lightenColor(baseColor, 30));
						grad.addColorStop(0.7, baseColor);
						grad.addColorStop(1, this._darkenColor(baseColor, 15));
						ctx.fillStyle = grad;
						ctx.globalAlpha = dimmed ? 0.12 : (isSelected || isHovered ? 1 : 0.9);
						ctx.fill();

						// Inner white highlight for 3D effect
						if (!dimmed && r * t.k > 4) {
							ctx.beginPath();
							ctx.arc(n.x - r * 0.25, n.y - r * 0.25, r * 0.35, 0, 2 * Math.PI);
							ctx.fillStyle = 'rgba(255,255,255,0.15)';
							ctx.fill();
						}
						
						// Crisp border ring
						ctx.beginPath();
						ctx.arc(n.x, n.y, r, 0, 2 * Math.PI);
						ctx.lineWidth = isSelected ? 2.5 : 1.5;
						ctx.strokeStyle = isDark ? 'rgba(17,24,39,0.6)' : 'rgba(255,255,255,0.7)';
						ctx.globalAlpha = dimmed ? 0.08 : 0.9;
						ctx.stroke();
						ctx.globalAlpha = 1;

						// Labels
						if (this.graphShowLabels && !dimmed) {
							const showLabel = r * t.k > 4 || isHovered || isSelected || n.radius > 8;
							if (showLabel) {
								const fontSize = Math.max(9, Math.min(13, n.radius * 0.9));
								ctx.font = `${isSelected ? '600' : '500'} ${fontSize}px Inter, system-ui, sans-serif`;
								ctx.textAlign = 'center';
								ctx.textBaseline = 'top';
								const label = n.label.length > 25 ? n.label.substring(0, 23) + '…' : n.label;
								const textY = n.y + r + 5;
								
								// Text shadow/background for readability
								const metrics = ctx.measureText(label);
								const bgW = metrics.width + 8;
								const bgH = fontSize + 5;
								ctx.fillStyle = isDark ? 'rgba(15,17,23,0.8)' : 'rgba(255,255,255,0.85)';
								ctx.beginPath();
								ctx.roundRect(n.x - bgW/2, textY - 2, bgW, bgH, 3);
								ctx.fill();
								
								// Subtle border on label background
								if (isSelected || isHovered) {
									ctx.strokeStyle = isDark ? 'rgba(96,165,250,0.3)' : 'rgba(37,99,235,0.2)';
									ctx.lineWidth = 0.5;
									ctx.stroke();
								}
								
								ctx.fillStyle = isSelected ? (isDark ? '#93c5fd' : '#1e40af') : 
									isHovered ? (isDark ? '#bfdbfe' : '#1e3a8a') :
									(isDark ? '#d1d5db' : '#374151');
								ctx.globalAlpha = isHovered || isSelected ? 1 : 0.85;
								ctx.fillText(label, n.x, textY);
								ctx.globalAlpha = 1;
							}
						}
					}

					ctx.restore();

					// Draw minimap
					this._drawMinimap();
				},

				// Color utility helpers
				_lightenColor(hex, percent) {
					const num = parseInt(hex.replace('#', ''), 16);
					const r = Math.min(255, (num >> 16) + Math.round(2.55 * percent));
					const g = Math.min(255, ((num >> 8) & 0x00FF) + Math.round(2.55 * percent));
					const b = Math.min(255, (num & 0x0000FF) + Math.round(2.55 * percent));
					return `rgb(${r},${g},${b})`;
				},

				_darkenColor(hex, percent) {
					const num = parseInt(hex.replace('#', ''), 16);
					const r = Math.max(0, (num >> 16) - Math.round(2.55 * percent));
					const g = Math.max(0, ((num >> 8) & 0x00FF) - Math.round(2.55 * percent));
					const b = Math.max(0, (num & 0x0000FF) - Math.round(2.55 * percent));
					return `rgb(${r},${g},${b})`;
				},

				_drawMinimap() {
					const minimapCanvas = document.getElementById('graph-minimap');
					if (!minimapCanvas) return;
					const mctx = minimapCanvas.getContext('2d');
					const mr = minimapCanvas.parentElement.getBoundingClientRect();
					const dpr = this._graphDpr;
					minimapCanvas.width = mr.width * dpr;
					minimapCanvas.height = mr.height * dpr;
					mctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					const mw = mr.width, mh = mr.height;
					const isDark = document.documentElement.classList.contains('dark');

					mctx.clearRect(0, 0, mw, mh);
					mctx.fillStyle = isDark ? '#111827' : '#f8fafc';
					mctx.fillRect(0, 0, mw, mh);

					const nodes = this._graphNodes;
					if (!nodes.length) return;

					// Compute bounds
					let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
					nodes.forEach(n => {
						minX = Math.min(minX, n.x);
						minY = Math.min(minY, n.y);
						maxX = Math.max(maxX, n.x);
						maxY = Math.max(maxY, n.y);
					});
					const padding = 20;
					minX -= padding; minY -= padding; maxX += padding; maxY += padding;
					const gw = maxX - minX || 1;
					const gh = maxY - minY || 1;
					const scale = Math.min(mw / gw, mh / gh);
					const ox = (mw - gw * scale) / 2;
					const oy = (mh - gh * scale) / 2;

					// Draw edges
					mctx.strokeStyle = isDark ? '#374151' : '#d1d5db';
					mctx.lineWidth = 0.5;
					mctx.globalAlpha = 0.3;
					this._graphEdges.forEach(e => {
						const s = this._graphNodeMap[e.source];
						const t = this._graphNodeMap[e.target];
						if (!s || !t) return;
						mctx.beginPath();
						mctx.moveTo(ox + (s.x - minX) * scale, oy + (s.y - minY) * scale);
						mctx.lineTo(ox + (t.x - minX) * scale, oy + (t.y - minY) * scale);
						mctx.stroke();
					});
					mctx.globalAlpha = 1;

					// Draw nodes
					nodes.forEach(n => {
						const color = this.entityColors[n.node_type] || '#6b7280';
						mctx.beginPath();
						mctx.arc(ox + (n.x - minX) * scale, oy + (n.y - minY) * scale, Math.max(1.5, n.radius * scale * 0.3), 0, 2 * Math.PI);
						mctx.fillStyle = color;
						mctx.fill();
					});

					// Draw viewport rectangle
					const t = this._graphTransform;
					const vx1 = (-t.x / t.k);
					const vy1 = (-t.y / t.k);
					const vx2 = vx1 + this._graphW / t.k;
					const vy2 = vy1 + this._graphH / t.k;
					mctx.strokeStyle = isDark ? '#60a5fa' : '#2563eb';
					mctx.lineWidth = 1.5;
					mctx.strokeRect(
						ox + (vx1 - minX) * scale,
						oy + (vy1 - minY) * scale,
						(vx2 - vx1) * scale,
						(vy2 - vy1) * scale
					);
				},

				// Mouse/touch interaction setup
				_setupGraphInteraction(canvas) {
					const self = this;
					let isPanning = false;
					let panStart = { x: 0, y: 0 };
					let dragStartPos = null;

					const getMousePos = (e) => {
						const r = canvas.getBoundingClientRect();
						const t = self._graphTransform;
						return {
							x: (e.clientX - r.left - t.x) / t.k,
							y: (e.clientY - r.top - t.y) / t.k,
							screenX: e.clientX - r.left,
							screenY: e.clientY - r.top,
						};
					};

					const findNode = (mx, my) => {
						const visibleTypes = new Set(self.graphVisibleTypes);
						for (let i = self._graphNodes.length - 1; i >= 0; i--) {
							const n = self._graphNodes[i];
							if (!visibleTypes.has(n.node_type || 'UNKNOWN')) continue;
							const dx = n.x - mx;
							const dy = n.y - my;
							const hitRadius = n.radius + 5;
							if (dx * dx + dy * dy < hitRadius * hitRadius) return n;
						}
						return null;
					};

					canvas.onmousedown = (e) => {
						e.preventDefault();
						// Close context menu on any click
						self._graphContextMenu = { visible: false };
						
						if (e.button === 2) return; // Right click handled in contextmenu event
						
						const pos = getMousePos(e);
						const node = findNode(pos.x, pos.y);
						if (node) {
							self._graphDragging = node;
							dragStartPos = { x: node.x, y: node.y };
							canvas.style.cursor = 'grabbing';
						} else {
							isPanning = true;
							panStart = { x: e.clientX, y: e.clientY };
							canvas.style.cursor = 'grabbing';
						}
					};

					canvas.onmousemove = (e) => {
						const pos = getMousePos(e);
						if (self._graphDragging) {
							self._graphDragging.x = pos.x;
							self._graphDragging.y = pos.y;
							self._graphDragging.vx = 0;
							self._graphDragging.vy = 0;
							self.graphDraw();
						} else if (isPanning) {
							const dx = e.clientX - panStart.x;
							const dy = e.clientY - panStart.y;
							self._graphTransform.x += dx;
							self._graphTransform.y += dy;
							panStart = { x: e.clientX, y: e.clientY };
							self.graphDraw();
						} else {
							const node = findNode(pos.x, pos.y);
							if (node !== self._graphHoveredNode) {
								self._graphHoveredNode = node;
								canvas.style.cursor = node ? 'pointer' : 'default';
								self.graphDraw();
							}
						}
					};

					canvas.onmouseup = (e) => {
						if (self._graphDragging) {
							// Check if it was a click (minimal drag)
							const moved = dragStartPos ? 
								Math.abs(self._graphDragging.x - dragStartPos.x) + Math.abs(self._graphDragging.y - dragStartPos.y) : 999;
							if (moved < 5) {
								// Click - select node
								self.selectedNode = self._graphDragging;
								self.selectedNodeEdges = self._graphEdges.filter(
									e => e.source === self._graphDragging.id || e.target === self._graphDragging.id
								);
								self._startSelectionPulse();
							}
							self._graphDragging = null;
							dragStartPos = null;
							self.graphDraw();
						}
						if (isPanning) {
							isPanning = false;
						}
						canvas.style.cursor = 'default';
					};

					canvas.onmouseleave = () => {
						if (self._graphHoveredNode) {
							self._graphHoveredNode = null;
							self.graphDraw();
						}
						isPanning = false;
						if (self._graphDragging) {
							self._graphDragging = null;
							dragStartPos = null;
						}
						canvas.style.cursor = 'default';
					};

					// Right-click context menu
					canvas.oncontextmenu = (e) => {
						e.preventDefault();
						const pos = getMousePos(e);
						const node = findNode(pos.x, pos.y);
						if (node) {
							const r = canvas.getBoundingClientRect();
							self._graphContextMenu = {
								visible: true,
								x: e.clientX - r.left,
								y: e.clientY - r.top,
								node: node,
							};
						} else {
							self._graphContextMenu = { visible: false };
						}
					};

					canvas.onwheel = (e) => {
						e.preventDefault();
						const r = canvas.getBoundingClientRect();
						const mx = e.clientX - r.left;
						const my = e.clientY - r.top;
						const factor = e.deltaY < 0 ? 1.12 : 0.89;
						const t = self._graphTransform;
						const newK = Math.max(0.1, Math.min(10, t.k * factor));
						t.x = mx - (mx - t.x) * (newK / t.k);
						t.y = my - (my - t.y) * (newK / t.k);
						t.k = newK;
						self.graphDraw();
					};

					// Double-click to focus
					canvas.ondblclick = (e) => {
						const pos = getMousePos(e);
						const node = findNode(pos.x, pos.y);
						if (node) {
							self.focusNode(node.id);
						} else {
							// Double-click empty space to deselect
							self.selectedNode = null;
							self.selectedNodeEdges = [];
							self._stopSelectionPulse();
							self.graphDraw();
						}
					};

					// Minimap click-to-navigate
					const minimap = document.getElementById('graph-minimap');
					if (minimap) {
						this._setupMinimapInteraction(minimap);
					}

					// Keyboard shortcuts
					canvas.tabIndex = 0;
					canvas.style.outline = 'none';
					canvas.onkeydown = (e) => {
						if (e.key === 'Escape') {
							self.selectedNode = null;
							self.selectedNodeEdges = [];
							self._graphContextMenu = { visible: false };
							self._stopSelectionPulse();
							self.graphDraw();
						} else if (e.key === '+' || e.key === '=') {
							self.graphZoomIn();
						} else if (e.key === '-') {
							self.graphZoomOut();
						} else if (e.key === '0') {
							self.graphResetCamera();
						} else if (e.key === 'f' || e.key === 'F') {
							self.graphToggleFullscreen();
						}
					};
				},

				// Minimap click/drag to navigate viewport
				_setupMinimapInteraction(minimap) {
					const self = this;
					let isDragging = false;

					const navigateToMinimapPos = (e) => {
						const nodes = self._graphNodes;
						if (!nodes.length) return;

						const rect = minimap.getBoundingClientRect();
						const mx = e.clientX - rect.left;
						const my = e.clientY - rect.top;
						const mw = rect.width;
						const mh = rect.height;

						// Calculate graph bounds (same as minimap drawing)
						let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
						nodes.forEach(n => {
							minX = Math.min(minX, n.x);
							minY = Math.min(minY, n.y);
							maxX = Math.max(maxX, n.x);
							maxY = Math.max(maxY, n.y);
						});
						const padding = 20;
						minX -= padding; minY -= padding; maxX += padding; maxY += padding;
						const gw = maxX - minX || 1;
						const gh = maxY - minY || 1;
						const scale = Math.min(mw / gw, mh / gh);
						const ox = (mw - gw * scale) / 2;
						const oy = (mh - gh * scale) / 2;

						// Convert minimap coords to graph coords
						const graphX = (mx - ox) / scale + minX;
						const graphY = (my - oy) / scale + minY;

						// Center viewport on this point
						const t = self._graphTransform;
						t.x = self._graphW / 2 - graphX * t.k;
						t.y = self._graphH / 2 - graphY * t.k;
						self.graphDraw();
					};

					minimap.onmousedown = (e) => {
						e.preventDefault();
						e.stopPropagation();
						isDragging = true;
						navigateToMinimapPos(e);
					};

					minimap.onmousemove = (e) => {
						if (isDragging) {
							navigateToMinimapPos(e);
						}
					};

					minimap.onmouseup = () => { isDragging = false; };
					minimap.onmouseleave = () => { isDragging = false; };
				},

				graphZoomIn() {
					const t = this._graphTransform;
					const cx = this._graphW / 2;
					const cy = this._graphH / 2;
					const factor = 1.5;
					const newK = Math.min(10, t.k * factor);
					t.x = cx - (cx - t.x) * (newK / t.k);
					t.y = cy - (cy - t.y) * (newK / t.k);
					t.k = newK;
					this.graphDraw();
				},

				graphZoomOut() {
					const t = this._graphTransform;
					const cx = this._graphW / 2;
					const cy = this._graphH / 2;
					const factor = 1 / 1.5;
					const newK = Math.max(0.1, t.k * factor);
					t.x = cx - (cx - t.x) * (newK / t.k);
					t.y = cy - (cy - t.y) * (newK / t.k);
					t.k = newK;
					this.graphDraw();
				},

				graphResetCamera() {
					// Fit all nodes in view
					const nodes = this._graphNodes;
					if (!nodes.length) return;
					let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
					nodes.forEach(n => {
						minX = Math.min(minX, n.x - n.radius);
						minY = Math.min(minY, n.y - n.radius);
						maxX = Math.max(maxX, n.x + n.radius);
						maxY = Math.max(maxY, n.y + n.radius);
					});
					const gw = maxX - minX || 1;
					const gh = maxY - minY || 1;
					const pad = 60;
					const k = Math.min((this._graphW - pad * 2) / gw, (this._graphH - pad * 2) / gh);
					this._graphTransform = {
						x: (this._graphW - gw * k) / 2 - minX * k,
						y: (this._graphH - gh * k) / 2 - minY * k,
						k: Math.max(0.1, Math.min(10, k)),
					};
					this.graphDraw();
				},

				graphToggleFullscreen() {
					const container = document.getElementById('graph-container');
					if (!container) return;
					if (document.fullscreenElement) {
						document.exitFullscreen();
					} else {
						container.requestFullscreen().catch(() => {});
					}
				},
			}));

			Alpine.data('uploadDocumentForm', () => ({
				file: null,
				uploading: false,
				progress: 0,
				error: '',

				fileSelected(event) {
					this.file = event.target.files[0];
					this.error = '';
				},

				async upload() {
					if (!this.file) return;
					
					this.uploading = true;
					this.progress = 0;
					this.error = '';
					
					const formData = new FormData();
					formData.append('file', this.file);
					
					const workspaceId = this.$data.workspaceId || document.querySelector('[x-data^="workspaceDetails"]').__x.$data.workspaceId;
					
					try {
						const xhr = new XMLHttpRequest();
						
						xhr.upload.addEventListener('progress', (e) => {
							if (e.lengthComputable) {
								this.progress = (e.loaded / e.total) * 100;
							}
						});
						
						const promise = new Promise((resolve, reject) => {
							xhr.onreadystatechange = () => {
								if (xhr.readyState === 4) {
									if (xhr.status >= 200 && xhr.status < 300) {
										resolve(JSON.parse(xhr.responseText));
									} else {
										try {
											const resp = JSON.parse(xhr.responseText);
											reject(new Error(resp.error || 'Upload failed'));
										} catch (e) {
											reject(new Error('Upload failed'));
										}
									}
								}
							};
							
							xhr.onerror = () => reject(new Error('Network error'));
						});
						
						xhr.open('POST', `/api/knowledge/documents/upload?workspace_id=${workspaceId}`);
						xhr.send(formData);
						
						await promise;
						
						this.file = null;
						document.getElementById('document-file').value = '';
						
						window.dispatchEvent(new CustomEvent('document-uploaded'));
						this.$el.closest('[role="dialog"]')?.querySelector('[data-dialog-close]')?.click();
						
					} catch (e) {
						this.error = e.message;
						console.error(e);
					} finally {
						this.uploading = false;
					}
				}
			}));
		});
	</script>
}
