package knowledge

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/separator"
	"school-with-ai/components/tabs"
	"school-with-ai/domain"
	"school-with-ai/services/rag/workspaces"
)

type WorkspaceDetailsPageProps struct {
	User      *domain.User
	Workspace *workspaces.WorkspaceResponse
}

templ WorkspaceDetailsPage(props WorkspaceDetailsPageProps) {
	@knowledgeLayout(knowledgeLayoutProps{
		Title: props.Workspace.Name + " - Documents",
		User:  props.User,
	}) {
		@workspaceDetailsScript()
		@StatusBadgeScript()
		<div
			class="flex-1 overflow-y-auto p-6 md:p-8 space-y-8 max-w-7xl mx-auto"
			x-data={ "workspaceDetails('" + props.Workspace.ID.String() + "')" }
		>
			<!-- Header -->
			@WorkspaceHeader(WorkspaceHeaderProps{Workspace: props.Workspace})
			@separator.Separator(separator.Props{})
			<!-- Content Tabs -->
			<div class="space-y-4">
				@tabs.Tabs(tabs.Props{ID: "workspace-content-tabs", Attributes: templ.Attributes{"x-model": "activeTab"}}) {
					@tabs.List(tabs.ListProps{}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "files", IsActive: true}) {
							@icon.File(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Files") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "ingested"}) {
							@icon.FileText(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Ingested") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "graph", Attributes: templ.Attributes{"@click": "activeTab = 'graph'; $nextTick(() => initGraph())"}}) {
							@icon.Network(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Graph") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "settings"}) {
							@icon.Settings(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Settings") }
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "files"}) {
						@FilesTab()
					}
					@tabs.Content(tabs.ContentProps{Value: "ingested"}) {
						@DocumentManager()
					}
					@tabs.Content(tabs.ContentProps{Value: "graph", Class: "h-[calc(100vh-300px)] min-h-[500px] flex flex-col border rounded-lg overflow-hidden bg-card"}) {
						@GraphViewer()
					}
					@tabs.Content(tabs.ContentProps{Value: "settings"}) {
						@WorkspaceSettings()
					}
				}
			</div>
			<!-- Bulk Actions Floating Bar - Files -->
			<div
				x-show="selectedFiles.length > 0"
				x-transition:enter="transition ease-out duration-300 transform"
				x-transition:enter-start="translate-y-full"
				x-transition:enter-end="translate-y-0"
				x-transition:leave="transition ease-in duration-200 transform"
				x-transition:leave-start="translate-y-0"
				x-transition:leave-end="translate-y-full"
				class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 bg-foreground text-background rounded-full px-6 py-3 shadow-2xl flex items-center gap-6"
			>
				<span class="text-sm font-medium" x-text="`${selectedFiles.length} files selected`"></span>
				<div class="h-4 w-px bg-background/20"></div>
				<div class="flex items-center gap-2">
					<button @click="bulkDelete()" class="inline-flex items-center gap-1.5 hover:text-red-400 transition-colors text-sm font-medium">
						@icon.Trash2(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "Delete") }
					</button>
					<button @click="bulkReprocess()" class="inline-flex items-center gap-1.5 hover:text-primary-foreground/80 transition-colors text-sm font-medium px-4">
						@icon.RefreshCw(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "Reprocess") }
					</button>
				</div>
				<button @click="selectedFiles = []" class="p-1 hover:bg-background/10 rounded-full transition-colors">
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</div>
			<!-- Document Preview Panel -->
			@DocumentPreviewPanel()
			<!-- Document Detail Dialog -->
			@DocumentDetailDialog()
			<!-- Upload Dialog -->
			@workspaceUploadDocumentDialog()
		</div>
	}
}

templ workspaceUploadDocumentDialog() {
	@dialog.Dialog(dialog.Props{ID: "upload-document-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			<div x-data="uploadDocumentForm()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Upload Document") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Upload a file to this workspace. Supported formats: PDF, TXT, MD.") }
					}
				}
				<div class="space-y-4 py-4">
					<div class="grid w-full max-w-sm items-center gap-1.5">
						<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="document-file">{ i18n.T(ctx, "File") }</label>
						<input id="document-file" type="file" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @change="fileSelected($event)"/>
					</div>
					<div x-show="uploading" class="space-y-2">
						<div class="flex items-center justify-between text-xs">
							<span>{ i18n.T(ctx, "Uploading...") }</span>
							<span x-text="Math.round(progress) + '%'"></span>
						</div>
						<div class="h-2 w-full overflow-hidden rounded-full bg-secondary">
							<div class="h-full bg-primary transition-all duration-300 ease-in-out" :style="`width: ${progress}%`"></div>
						</div>
					</div>
					<div x-show="error" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="error"></p>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "upload()",
							":disabled": "!file || uploading",
						},
					}) {
						<span x-show="!uploading">{ i18n.T(ctx, "Upload") }</span>
						<span x-show="uploading" class="flex items-center gap-2">
							<span class="animate-spin size-4 border-2 border-white border-t-transparent rounded-full"></span>
							{ i18n.T(ctx, "Processing...") }
						</span>
					}
				}
			</div>
		}
	}
}

templ workspaceDetailsScript() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('workspaceDetails', (workspaceId) => ({
				workspaceId: workspaceId,
				activeTab: 'files',
				isFullscreen: false,
				graphColorBy: 'type',
				selectedNodeId: null,
				graphLoading: false,
				graphData: null,
				
				// Files (PDFs)
				filesLoading: true,
				files: [],
				fileSearch: '',
				filePage: 1,
				filePageSize: 10,
				fileTotal: 0,
				fileTotalPages: 0,
				
				// Ingested Documents
				docsLoading: true,
				documents: [],       // All documents from API (unfiltered)
				docSearch: '',
				docPage: 1,
				docPageSize: 100,    // Fetch all for client-side filtering
				docTotal: 0,
				docTotalPages: 0,
				docStatusFilter: '', // '', 'pending', 'processing', 'completed', 'failed', 'cancelled'
				docsError: null,
				docStatusCounts: { pending: 0, processing: 0, completed: 0, partial_failure: 0, failed: 0, cancelled: 0 },

				// Pipeline Status
				pipelineStatus: null,
				pipelineLoading: false,
				pipelineExpanded: false,
				pipelineTasks: [],
				queueMetrics: null,
				pipelinePollingInterval: null,
				pipelineCancelling: false,
				isRefreshing: false,

				// Sorting
				sortField: 'created_at',
				sortDirection: 'desc',

				// Selection
				selectedFiles: [],
				selectedDocs: [],

				// Document Preview
				previewDoc: null,
				previewContent: null,
				previewLoading: false,

				// Entity Browser state (persisted)
				entityBrowserCollapsed: false,
				entityBrowserViewMode: 'grouped', // 'grouped' or 'list'
				entityBrowserSortBy: 'name',     // 'name', 'degree', 'type'
				entityBrowserSortAsc: true,
				entityBrowserSearchQuery: '',

				// Document Detail Dialog
				detailDoc: null,

				// Upload progress
				uploadingFiles: [],

				// Knowledge Graph state
				graphSearch: '',
				graphMaxNodes: '200',
				graphDepth: 2,
				graphStartNode: null,
				graphStartNodeInput: '',
				graphIncludeOrphans: false,
				graphLabelMatches: [],
				graphLayout: 'force-atlas',
				selectedNode: null,
				selectedNodeEdges: [],
				graphShowLabels: true,
				graphShowEdgeLabels: false,
				graphVisibleTypes: [],
				graphVisibleRelTypes: [],
				graphNodeSize: 'medium',
				graphEnableDrag: true,
				graphHighlightNeighbors: true,
				graphHideUnselectedEdges: false,
				_graphNodes: [],
				_graphEdges: [],
				_graphNodeMap: {},
				_graphRelTypes: [],
				_sigmaInstance: null,
				_graphologyInstance: null,
				_graphSearchMatches: new Set(),
				_previousSelectedNodeId: null,
				_draggedNode: null,
				_nodeDetailsPanelWidth: 320,
				_selectionPulseInterval: null,
				_graphNodeCycleIndex: -1,
				entityColors: {
					'PERSON': '#3b82f6',
					'ORGANIZATION': '#10b981',
					'LOCATION': '#f59e0b',
					'EVENT': '#ef4444',
					'CONCEPT': '#8b5cf6',
					'DOCUMENT': '#6366f1',
					'TECHNOLOGY': '#06b6d4',
					'CATEGORY': '#d946ef',
					'GEO': '#f59e0b',
					'DATE': '#f97316',
					'PRODUCT': '#14b8a6',
					'METRIC': '#ec4899',
					'PROCESS': '#a855f7',
					'REGULATION': '#64748b',
					'UNKNOWN': '#6b7280',
				},

				// Rebuild/Reprocess states
				rebuildingGraph: false,
				rebuildGraphForce: false,
				rebuildingEmbeddings: false,
				rebuildEmbeddingsForce: false,
				reprocessingAll: false,
				reprocessingFailed: false,
				scanningDocuments: false,
				deletingAllDocs: false,
				recoveringStuck: false,

				// Client-side filtered documents
				get filteredDocuments() {
					if (!this.docStatusFilter) return this.documents;
					return this.documents.filter(doc => {
						const status = doc.status || doc.current_stage || 'completed';
						if (this.docStatusFilter === 'failed') {
							return status === 'failed' || status === 'partial_failure';
						}
						return status === this.docStatusFilter;
					});
				},

				get totalCount() {
					return this.docTotal || this.documents.length;
				},

				get sortedNodes() {
					if (!this._graphNodes || this._graphNodes.length === 0) return [];
					
					const query = this.entityBrowserSearchQuery.toLowerCase().trim();
					let filtered = [...this._graphNodes];
					
					if (query) {
						filtered = filtered.filter(node => 
							(node.label || '').toLowerCase().includes(query) ||
							(node.node_type || '').toLowerCase().includes(query)
						);
					}

					return filtered.sort((a, b) => {
						let comparison = 0;
						switch (this.entityBrowserSortBy) {
							case 'name':
								comparison = (a.label || '').localeCompare(b.label || '');
								break;
							case 'degree':
								comparison = (b.degree || 0) - (a.degree || 0);
								break;
							case 'type':
								comparison = (a.node_type || '').localeCompare(b.node_type || '');
								break;
						}
						return this.entityBrowserSortAsc ? comparison : -comparison;
					});
				},

				get groupedNodes() {
					const sorted = this.sortedNodes;
					const groups = {};
					for (const node of sorted) {
						const type = node.node_type || 'UNKNOWN';
						if (!groups[type]) groups[type] = [];
						groups[type].push(node);
					}
					// Sort groups by type name
					return Object.entries(groups).sort((a, b) => a[0].localeCompare(b[0]));
				},

				init() {
					this.loadFiles();
					this.loadDocuments();
					this.loadPipelineStatus();
					this.loadQueueMetrics();
					this.restoreGraphSettings();
					this.restoreEntityBrowserSettings();
					
					// Initial graph load
					this.loadGraph();
					
					// Start polling for pipeline status
					this.pipelinePollingInterval = setInterval(() => {
						this.loadPipelineStatus();
						this.loadQueueMetrics();
						// Auto-refresh docs if pipeline is busy
						if (this.pipelineStatus && this.pipelineStatus.is_busy) {
							this.loadDocuments();
						}
					}, 5000);
					
					window.addEventListener('document-uploaded', () => {
						this.filePage = 1;
						this.refreshAll();
					});

					// Global Ctrl+K / Cmd+K shortcut for graph search
					this._keydownHandler = (e) => {
						if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
							e.preventDefault();
							const searchInput = document.getElementById('graph-search-input');
							if (searchInput) searchInput.focus();
						}
					};
					window.addEventListener('keydown', this._keydownHandler);

					// Watch for tab changes to init graph
					this.$watch('activeTab', (value) => {
						if (value === 'graph') {
							setTimeout(() => this.initGraph(), 100);
						}
					});

					// Update selectedNodeId property when selectedNode changes
					this.$watch('selectedNode', (node) => {
						this.selectedNodeId = node ? node.id : null;
					});

					this.$watch('entityBrowserCollapsed', () => this.saveEntityBrowserSettings());
					this.$watch('entityBrowserViewMode', () => this.saveEntityBrowserSettings());
					this.$watch('entityBrowserSortBy', () => this.saveEntityBrowserSettings());
					this.$watch('entityBrowserSortAsc', () => this.saveEntityBrowserSettings());
				},

				destroy() {
					if (this.pipelinePollingInterval) {
						clearInterval(this.pipelinePollingInterval);
					}
					if (this._selectionPulseInterval) {
						clearInterval(this._selectionPulseInterval);
						this._selectionPulseInterval = null;
					}
					if (this._sigmaInstance) {
						this._sigmaInstance.kill();
						this._sigmaInstance = null;
					}
					this._graphologyInstance = null;
					if (this._keydownHandler) {
						window.removeEventListener('keydown', this._keydownHandler);
					}
				},

				async refreshAll() {
					if (this.isRefreshing) return;
					this.isRefreshing = true;
					try {
						await Promise.all([
							this.loadFiles(),
							this.loadDocuments(),
							this.loadPipelineStatus(),
							this.loadQueueMetrics()
						]);
					} finally {
						setTimeout(() => { this.isRefreshing = false; }, 600);
					}
				},

				// === Pipeline Status ===
				async loadPipelineStatus() {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/enhanced-status?workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							const data = await resp.json();
							// Normalize field names for template usage
							data.pending = data.pending_tasks || 0;
							data.processing = data.processing_tasks || 0;
							data.completed = data.completed_tasks || 0;
							data.failed = data.failed_tasks || 0;
							this.pipelineStatus = data;
						}
					} catch (e) {
						console.error('Failed to load pipeline status:', e);
					}
				},

				async loadQueueMetrics() {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/queue-metrics?workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							this.queueMetrics = await resp.json();
						}
					} catch (e) {
						console.error('Failed to load queue metrics:', e);
					}
				},

				// === Selection ===
				toggleSelectAllFiles(checked) {
					if (checked) {
						this.selectedFiles = this.files.map(f => f.pdf_id);
					} else {
						this.selectedFiles = [];
					}
				},

				toggleSelectAllDocs(checked) {
					if (checked) {
						this.selectedDocs = this.filteredDocuments.filter(d => this.isTerminalStatus(d.status)).map(d => d.id);
					} else {
						this.selectedDocs = [];
					}
				},

				// === Bulk Operations ===
				async bulkDelete() {
					if (!confirm(`Are you sure you want to delete ${this.selectedFiles.length} files?`)) return;
					
					for (const id of this.selectedFiles) {
						await fetch(`/api/knowledge/pdfs/${id}?workspace_id=${this.workspaceId}`, { method: 'DELETE' });
					}
					this.selectedFiles = [];
					this.loadFiles();
					this.loadDocuments();
				},

				async bulkReprocess() {
					for (const pdfId of this.selectedFiles) {
						await this.reprocessFile(pdfId);
					}
					this.selectedFiles = [];
					this.refreshAll();
				},

				async bulkDeleteDocs() {
					if (!confirm(`Are you sure you want to delete ${this.selectedDocs.length} documents?`)) return;
					
					for (const id of this.selectedDocs) {
						await fetch(`/api/knowledge/documents/${id}?workspace_id=${this.workspaceId}`, { method: 'DELETE' });
					}
					this.selectedDocs = [];
					this.loadDocuments();
				},

				async bulkReprocessDocs() {
					for (const docId of this.selectedDocs) {
						await this.reprocessDocument(docId);
					}
					this.selectedDocs = [];
					this.refreshAll();
				},

				// === Rebuild/Reprocess ===
				async rebuildGraph() {
					this.rebuildingGraph = true;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${this.workspaceId}/rebuild`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ type: 'graph', force: this.rebuildGraphForce })
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} finally {
						setTimeout(() => { this.rebuildingGraph = false; }, 2000);
					}
				},

				async rebuildEmbeddings() {
					this.rebuildingEmbeddings = true;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${this.workspaceId}/rebuild`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ type: 'embeddings', force: this.rebuildEmbeddingsForce })
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} finally {
						setTimeout(() => { this.rebuildingEmbeddings = false; }, 2000);
					}
				},

				async reprocessAll() {
					if (!confirm('This will trigger reprocessing for ALL documents in this workspace. Continue?')) return;
					this.reprocessingAll = true;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/reprocess?workspace_id=${this.workspaceId}`, {
							method: 'POST'
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} finally {
						setTimeout(() => { this.reprocessingAll = false; }, 2000);
					}
				},

				async reprocessFailed() {
					this.reprocessingFailed = true;
					try {
						const resp = await fetch(`/api/knowledge/documents/reprocess-failed?workspace_id=${this.workspaceId}`, {
							method: 'POST'
						});
						if (resp.ok) {
							const data = await resp.json();
							if (data.requeued === 0) {
								alert('No failed documents found to reprocess.');
							}
							this.refreshAll();
						}
					} catch (e) {
						console.error('Failed to reprocess failed documents:', e);
					} finally {
						setTimeout(() => { this.reprocessingFailed = false; }, 2000);
					}
				},

				async scanDocuments() {
					this.scanningDocuments = true;
					try {
						const resp = await fetch(`/api/knowledge/documents/scan?workspace_id=${this.workspaceId}`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ path: './inputs' })
						});
						if (resp.ok) {
							this.refreshAll();
						} else {
							const data = await resp.json();
							alert(data.error || 'Failed to scan documents');
						}
					} catch (e) {
						console.error('Failed to scan documents:', e);
					} finally {
						setTimeout(() => { this.scanningDocuments = false; }, 2000);
					}
				},

				async deleteAllDocuments() {
					this.deletingAllDocs = true;
					try {
						const resp = await fetch(`/api/knowledge/documents?workspace_id=${this.workspaceId}`, {
							method: 'DELETE'
						});
						if (resp.ok) {
							const data = await resp.json();
							const count = data.deleted_count ?? data.count ?? 'all';
							alert(`Deleted ${count} document(s).`);
							this.refreshAll();
						} else {
							const data = await resp.json().catch(() => ({}));
							alert(data.error || 'Failed to delete documents');
						}
					} catch (e) {
						console.error('Failed to delete all documents:', e);
						alert('Network error while deleting documents');
					} finally {
						setTimeout(() => { this.deletingAllDocs = false; }, 2000);
					}
				},

				// === Recover Stuck Documents ===
				async recoverStuck() {
					this.recoveringStuck = true;
					try {
						const resp = await fetch(`/api/knowledge/documents/recover-stuck?workspace_id=${this.workspaceId}`, {
							method: 'POST'
						});
						if (resp.ok) {
							const data = await resp.json();
							const count = data.recovered || 0;
							if (count === 0) {
								alert('No stuck documents found.');
							} else {
								alert(`Recovered ${count} stuck document(s).`);
								this.refreshAll();
							}
						} else {
							alert('Failed to recover stuck documents');
						}
					} catch (e) {
						console.error('Failed to recover stuck documents:', e);
					} finally {
						setTimeout(() => { this.recoveringStuck = false; }, 2000);
					}
				},

				// === Update Workspace (rename / description) ===
				async updateWorkspace(name, description) {
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${this.workspaceId}`, {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ name, description })
						});
						if (resp.ok) {
							return await resp.json();
						}
					} catch (e) {
						console.error('Failed to update workspace:', e);
					}
					return null;
				},

				// === File Operations ===
				async loadFiles() {
					this.filesLoading = true;
					try {
						let url = `/api/knowledge/pdfs?workspace_id=${this.workspaceId}&page=${this.filePage}&page_size=${this.filePageSize}`;
						if (this.fileSearch) {
							url += `&search=${encodeURIComponent(this.fileSearch)}`;
						}
						
						const resp = await fetch(url);
						if (resp.ok) {
							const data = await resp.json();
							this.files = data.items || [];
							this.fileTotal = data.pagination?.total_count || 0;
							this.fileTotalPages = data.pagination?.total_pages || 0;
						}
					} catch (e) {
						console.error('Failed to load files:', e);
					} finally {
						setTimeout(() => { this.filesLoading = false; }, 300);
					}
				},

				// === Document Operations ===
				async loadDocuments() {
					this.docsLoading = true;
					try {
						let url = `/api/knowledge/documents?workspace_id=${this.workspaceId}&page=1&page_size=500`;
						
						const resp = await fetch(url);
						if (resp.ok) {
							const data = await resp.json();
							this.documents = data.documents || [];
							this.docTotal = data.total || this.documents.length;
							this.docTotalPages = 1;
							if (data.status_counts && Object.values(data.status_counts).some(v => v > 0)) {
								this.docStatusCounts = data.status_counts;
							} else {
								this.computeStatusCounts();
							}
						}
						setTimeout(() => { this.docsLoading = false; }, 300);
					} catch (e) {
						console.error('Failed to load documents:', e);
						this.docsError = e.message || 'Unknown error';
					} finally {
					}
				},

				computeStatusCounts() {
					const counts = { pending: 0, processing: 0, completed: 0, partial_failure: 0, failed: 0, cancelled: 0 };
					for (const doc of this.documents) {
						const status = doc.status || doc.current_stage || 'completed';
						if (status in counts) {
							counts[status]++;
						} else if (['uploading', 'converting', 'preprocessing', 'chunking', 'extracting', 'gleaning', 'merging', 'summarizing', 'embedding', 'storing', 'indexing'].includes(status)) {
							counts.processing++;
						} else if (status === 'indexed' || status === 'partial_success') {
							counts.completed++;
						} else {
							counts.completed++;
						}
					}
					this.docStatusCounts = counts;
				},

				filterByStatus(status) {
					this.docStatusFilter = status;
					this.selectedDocs = [];
				},

				async deleteFile(id, name) {
					if (!confirm(`Are you sure you want to delete file "${name}"? This action cannot be undone.`)) {
						return;
					}
					
					try {
						const resp = await fetch(`/api/knowledge/pdfs/${id}?workspace_id=${this.workspaceId}`, {
							method: 'DELETE',
						});
						
						if (resp.ok) {
							this.loadFiles();
							this.loadDocuments();
						} else {
							alert('Failed to delete file');
						}
					} catch (e) {
						console.error('Failed to delete file:', e);
						alert('An error occurred while deleting the file');
					}
				},

				async retryPdf(pdfId) {
					try {
						const resp = await fetch(`/api/knowledge/pdfs/${pdfId}/retry`, {
							method: 'POST'
						});
						if (resp.ok) {
							this.refreshAll();
						} else {
							const data = await resp.json();
							alert(data.error || 'Failed to retry PDF processing');
						}
					} catch (e) {
						console.error('Failed to retry PDF:', e);
					}
				},

				async reprocessDocument(id) {
					try {
						const resp = await fetch(`/api/knowledge/documents/reprocess?workspace_id=${this.workspaceId}`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ document_id: id })
						});
						if (resp.ok) {
							this.refreshAll();
						}
					} catch (e) {
						console.error('Failed to reprocess document:', e);
					}
				},

				async cancelTask(taskId) {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/cancel`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ task_id: taskId })
						});
						if (resp.ok || resp.status === 409) {
							this.loadDocuments();
							this.loadPipelineStatus();
						}
					} catch (e) {
						console.error('Failed to cancel task:', e);
					}
				},

				async cancelPipeline() {
					if (this.pipelineCancelling) return;
					this.pipelineCancelling = true;
					try {
						const resp = await fetch(`/api/knowledge/pipeline/cancel-all`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' }
						});
						if (resp.ok) {
							await this.refreshAll();
						} else {
							const data = await resp.json().catch(() => ({}));
							console.error('Failed to cancel pipeline:', data.error || resp.statusText);
						}
					} catch (e) {
						console.error('Failed to cancel pipeline:', e);
					} finally {
						this.pipelineCancelling = false;
					}
				},

				async retryTask(trackId) {
					try {
						const resp = await fetch(`/api/knowledge/pipeline/retry`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ task_id: trackId })
						});
						if (resp.ok) {
							this.refreshAll();
						} else {
							const data = await resp.json();
							alert(data.error || 'Failed to retry task');
						}
					} catch (e) {
						console.error('Failed to retry task:', e);
					}
				},

				async deleteDocument(id, title) {
					if (!confirm(`Are you sure you want to delete "${title}"?`)) return;
					try {
						const resp = await fetch(`/api/knowledge/documents/${id}?workspace_id=${this.workspaceId}`, {
							method: 'DELETE'
						});
						if (resp.ok) {
							this.loadDocuments();
						} else {
							alert('Failed to delete document');
						}
					} catch (e) {
						console.error('Failed to delete document:', e);
					}
				},

				async cancelDocumentTask(docId, trackId) {
					const finalTrackId = trackId || 
						this.pipelineTasks.find(t => t.document_id === docId)?.track_id ||
						this.documents.find(d => d.id === docId)?.track_id;

					if (finalTrackId) {
						await this.cancelTask(finalTrackId);
					} else {
						console.warn('Could not find track_id for document cancellation:', docId);
					}
				},

				async reprocessFile(pdfId) {
					const doc = this.documents.find(d => d.pdf_id === pdfId);
					if (doc) {
						await this.reprocessDocument(doc.id);
					} else {
						// Try retrying PDF processing directly
						await this.retryPdf(pdfId);
					}
				},

				// === Utilities ===
				formatBytes(bytes, decimals = 2) {
					if (!+bytes) return '0 Bytes';
					const k = 1024;
					const dm = decimals < 0 ? 0 : decimals;
					const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
				},

				formatDate(dateString) {
					if (!dateString) return '';
					return new Date(dateString).toLocaleDateString(undefined, {
						year: 'numeric',
						month: 'short',
						day: 'numeric',
						hour: '2-digit',
						minute: '2-digit'
					});
				},

				formatDuration(seconds) {
					if (!seconds || seconds <= 0) return '-';
					if (seconds < 60) return `${Math.round(seconds)}s`;
					if (seconds < 3600) return `${Math.round(seconds / 60)}m`;
					return `${Math.round(seconds / 3600)}h ${Math.round((seconds % 3600) / 60)}m`;
				},

				isProcessingStatus(status) {
					if (!status) return false;
					return [
						'processing', 'pending', 'uploading', 'converting', 
						'preprocessing', 'chunking', 'extracting', 'gleaning', 
						'merging', 'summarizing', 'embedding', 'storing', 'indexing'
					].includes(status.toLowerCase());
				},

				isTerminalStatus(status) {
					if (!status) return false;
					return [
						'completed', 'indexed', 'failed', 'partial_failure', 'partial_success', 'cancelled'
					].includes(status.toLowerCase());
				},

				stageIcon(stage) {
					const icons = {
						'uploading': '📤', 'converting': '🔄', 'preprocessing': '⚙️',
						'chunking': '✂️', 'extracting': '🔍', 'gleaning': '🔬',
						'merging': '🔗', 'summarizing': '📝', 'embedding': '📊',
						'storing': '💾', 'completed': '✅', 'failed': '❌',
						'pending': '⏳', 'indexing': '📁', 'cancelled': '🚫'
					};
					return icons[stage] || '⏳';
				},

				timeAgo(dateString) {
					if (!dateString) return '';
					const d = new Date(dateString);
					const now = new Date();
					const seconds = Math.floor((now - d) / 1000);
					if (seconds < 60) return 'just now';
					const minutes = Math.floor(seconds / 60);
					if (minutes < 60) return minutes + 'm ago';
					const hours = Math.floor(minutes / 60);
					if (hours < 24) return hours + 'h ago';
					const days = Math.floor(hours / 24);
					if (days < 30) return days + 'd ago';
					return this.formatDate(dateString);
				},

				highlightSearch(text) {
					if (!text || !this.docSearch) return text;
					const q = this.docSearch.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
					return text.replace(new RegExp(`(${q})`, 'gi'), '<mark class="bg-yellow-200 dark:bg-yellow-800 rounded px-0.5">$1</mark>');
				},

				fileTypeIcon(fileName) {
					if (!fileName) return '<span class="text-muted-foreground">📄</span>';
					const ext = fileName.split('.').pop()?.toLowerCase() || '';
					const icons = {
						'pdf': '📕', 'txt': '📄', 'md': '📝', 'markdown': '📝',
						'doc': '📘', 'docx': '📘', 'csv': '📊', 'json': '📋',
						'html': '🌐', 'htm': '🌐', 'xml': '📰', 'rtf': '📄',
						'epub': '📚', 'pptx': '📙', 'ppt': '📙', 'xlsx': '📊', 'xls': '📊',
					};
					return `<span class="text-base">${icons[ext] || '📄'}</span>`;
				},

				fileTypeIconSvg(fileName) {
					const svgBase = 'xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
					const fileText = `<svg ${svgBase}><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13H8"/><path d="M16 17H8"/><path d="M16 13h-2"/></svg>`;
					const fileCode = `<svg ${svgBase}><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13-2 2 2 2"/><path d="m14 17 2-2-2-2"/></svg>`;
					const fileSheet = `<svg ${svgBase}><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/></svg>`;
					const fileImg = `<svg ${svgBase}><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><circle cx="10" cy="12" r="2"/><path d="m20 17-1.296-1.296a2.41 2.41 0 0 0-3.408 0L9 22"/></svg>`;
					const fileGeneric = `<svg ${svgBase}><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>`;

					if (!fileName) return `<span class="text-muted-foreground">${fileGeneric}</span>`;
					const ext = fileName.split('.').pop()?.toLowerCase() || '';
					const config = {
						'pdf': { svg: fileText, color: 'text-red-500' },
						'doc': { svg: fileText, color: 'text-blue-500' },
						'docx': { svg: fileText, color: 'text-blue-500' },
						'xls': { svg: fileSheet, color: 'text-green-500' },
						'xlsx': { svg: fileSheet, color: 'text-green-500' },
						'csv': { svg: fileSheet, color: 'text-green-500' },
						'md': { svg: fileCode, color: 'text-purple-500' },
						'markdown': { svg: fileCode, color: 'text-purple-500' },
						'txt': { svg: fileText, color: 'text-gray-500' },
						'html': { svg: fileCode, color: 'text-orange-500' },
						'htm': { svg: fileCode, color: 'text-orange-500' },
						'json': { svg: fileCode, color: 'text-orange-500' },
						'xml': { svg: fileCode, color: 'text-orange-500' },
						'jpg': { svg: fileImg, color: 'text-pink-500' },
						'jpeg': { svg: fileImg, color: 'text-pink-500' },
						'png': { svg: fileImg, color: 'text-pink-500' },
						'gif': { svg: fileImg, color: 'text-pink-500' },
						'webp': { svg: fileImg, color: 'text-pink-500' },
					};
					const c = config[ext] || { svg: fileGeneric, color: 'text-muted-foreground' };
					return `<span class="${c.color}">${c.svg}</span>`;
				},

				isNewDocument(doc) {
					if (!doc?.created_at) return false;
					const created = new Date(doc.created_at);
					const now = new Date();
					return (now - created) < 5 * 60 * 1000; // 5 minutes
				},

				toggleSort(field) {
					if (this.sortField === field) {
						this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
					} else {
						this.sortField = field;
						this.sortDirection = 'desc';
					}
				},

				handleSearch() {
					this.docPage = 1;
				},

				viewInGraph(doc) {
					// Switch to graph tab and search for document-related entities
					const tabEl = document.querySelector('[data-tab-value="graph"]');
					if (tabEl) tabEl.click();
					this.$nextTick(() => {
						if (doc.title || doc.file_name) {
							this.graphSearch = doc.title || doc.file_name;
							this.searchGraph();
						}
					});
				},

				statusBadgeClass(status) {
					if (!status) return 'bg-muted text-muted-foreground';
					const s = status.toLowerCase();
					if (s === 'completed' || s === 'indexed' || s === 'partial_success') return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 border-green-200 dark:border-green-800';
					if (this.isProcessingStatus(s)) return 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400 border-blue-200 dark:border-blue-800';
					if (s === 'pending') return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400 border-yellow-200 dark:border-yellow-800';
					if (s === 'failed') return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400 border-red-200 dark:border-red-800';
					if (s === 'cancelled' || s === 'partial_failure') return 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400 border-orange-200 dark:border-orange-800';
					return 'bg-muted text-muted-foreground';
				},

				statusLabel(status) {
					if (!status) return 'Unknown';
					return status.charAt(0).toUpperCase() + status.slice(1).replace(/_/g, ' ');
				},

				// === Document Preview ===
				async openDocumentPreview(doc) {
					this.previewDoc = doc;
					this.previewContent = null;
					
					// Try to load full document detail
					try {
						const resp = await fetch(`/api/knowledge/documents/${doc.id}?workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							const detail = await resp.json();
							this.previewDoc = { ...doc, ...detail };
							if (detail.content) {
								this.previewContent = detail.content;
							}
						}
					} catch (e) {
						console.error('Failed to load document detail:', e);
					}

					// If document has a PDF, try to load PDF content
					if (doc.pdf_id && !this.previewContent) {
						try {
							const resp = await fetch(`/api/knowledge/pdfs/${doc.pdf_id}/content?workspace_id=${this.workspaceId}`);
							if (resp.ok) {
								const pdfContent = await resp.json();
								if (pdfContent.markdown_content) {
									this.previewContent = pdfContent.markdown_content;
								}
							}
						} catch (e) {
							console.error('Failed to load PDF content:', e);
						}
					}
				},

				closePreview() {
					this.previewDoc = null;
					this.previewContent = null;
				},

				// === Knowledge Graph (Sigma.js + Graphology — matching EdgeQuake graph-renderer.tsx) ===

				// Dynamic node sizing: base + log2(degree+1) * 2, capped at base*3
				// Matches EdgeQuake calculateNodeSize()
				_calcNodeSize(degree, base) {
					if (!degree) return base;
					const scale = Math.log2(degree + 1) * 2;
					return Math.min(base + scale, base * 3);
				},

				_getNodeColor(typeOrNode) {
					const colorBy = this.graphColorBy || 'type';
					let type = typeof typeOrNode === 'string' ? typeOrNode : typeOrNode?.node_type;
					
					if (typeof typeOrNode === 'object' && typeOrNode !== null) {
						if (colorBy === 'community' && typeOrNode.community !== undefined) {
							const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#d946ef', '#f97316'];
							return colors[typeOrNode.community % colors.length];
						} else if (colorBy === 'degree') {
							const degree = typeOrNode.degree || 0;
							if (degree > 20) return '#ef4444';
							if (degree > 10) return '#f97316';
							if (degree > 5) return '#f59e0b';
							if (degree > 2) return '#3b82f6';
							return '#94a3b8';
						}
					}

					if (!type) return this.entityColors['UNKNOWN'];
					return this.entityColors[type.toUpperCase()] || this.entityColors['UNKNOWN'];
				},

				async loadGraph() {
					this.graphLoading = true;
					this.selectedNode = null;
					this.selectedNodeEdges = [];
					try {
						let url = `/api/knowledge/graph?workspace_id=${this.workspaceId}&max_nodes=${this.graphMaxNodes}&depth=${this.graphDepth}`;
						if (this.graphStartNode) {
							url += `&start_node=${encodeURIComponent(this.graphStartNode)}`;
						}
						if (this.graphIncludeOrphans) {
							url += `&include_orphans=true`;
						}
						
						const resp = await fetch(url);
						if (resp.ok) {
							this.graphData = await resp.json();
							const types = new Set();
							(this.graphData.nodes || []).forEach(n => types.add(n.node_type || 'UNKNOWN'));
							this.graphVisibleTypes = [...types];
							// Extract relationship types
							const relTypes = new Set();
							(this.graphData.edges || []).forEach(e => { if (e.edge_type) relTypes.add(e.edge_type); });
							this._graphRelTypes = [...relTypes].sort();
							this.graphVisibleRelTypes = [...this._graphRelTypes];
							// Set loading false BEFORE scheduling initGraph so the
							// x-show container becomes visible when $nextTick fires.
							this.graphLoading = false;
							this.$nextTick(() => {
								// Extra rAF ensures the browser has painted the visible container
								// so sigma-container has real dimensions for WebGL.
								requestAnimationFrame(() => this.initGraph());
							});
						} else {
							this.graphData = null;
							this.graphLoading = false;
						}
					} finally {
						this.graphLoading = false;
					}
				},

				// === Graph Settings Methods ===
				async searchGraphLabels() {
					if (this.graphStartNodeInput.length < 2) {
						this.graphLabelMatches = [];
						return;
					}
					try {
						const resp = await fetch(`/api/knowledge/graph/labels/search?q=${encodeURIComponent(this.graphStartNodeInput)}&limit=5&workspace_id=${this.workspaceId}`);
						if (resp.ok) {
							const data = await resp.json();
							this.graphLabelMatches = data.labels || [];
						}
					} catch (e) {
						console.error('Failed to search labels:', e);
					}
				},

				selectGraphFocus(label) {
					this.graphStartNode = label;
					this.graphStartNodeInput = label;
					this.graphLabelMatches = [];
					this.loadGraph();
				},

				clearGraphFocus() {
					this.graphStartNode = null;
					this.graphStartNodeInput = '';
					this.graphLabelMatches = [];
					this.loadGraph();
				},

				applyGraphPreset(maxNodes, depth) {
					this.graphMaxNodes = String(maxNodes);
					this.graphDepth = depth;
					this.loadGraph();
				},

				async searchGraph() {
					if (!this.graphSearch.trim()) {
						this._graphSearchMatches = new Set();
						this.loadGraph();
						return;
					}
					this.graphLoading = true;
					try {
						const resp = await fetch(`/api/knowledge/graph/nodes/search?workspace_id=${this.workspaceId}&q=${encodeURIComponent(this.graphSearch)}&limit=50`);
						if (resp.ok) {
							const data = await resp.json();
							this.graphData = {
								nodes: data.nodes || [],
								edges: data.edges || [],
								total_nodes: data.total_matches || 0,
								total_edges: (data.edges || []).length,
								is_truncated: data.is_truncated || false,
							};
							const types = new Set();
							(this.graphData.nodes || []).forEach(n => types.add(n.node_type || 'UNKNOWN'));
							this.graphVisibleTypes = [...types];
							const relTypes = new Set();
							(this.graphData.edges || []).forEach(e => { if (e.edge_type) relTypes.add(e.edge_type); });
							this._graphRelTypes = [...relTypes].sort();
							this.graphVisibleRelTypes = [...this._graphRelTypes];
							this._graphSearchMatches = new Set((data.nodes || []).map(n => n.id));
							this.graphLoading = false;
							this.$nextTick(() => {
								requestAnimationFrame(() => this.initGraph());
							});
						} else {
							this.graphLoading = false;
						}
					} catch (e) {
						console.error('Failed to search graph:', e);
						this.graphLoading = false;
					}
				},

				getNodeLabel(nodeId) {
					if (!nodeId) return '';
					const node = this._graphNodeMap[nodeId];
					return node ? node.label : nodeId.substring(0, 8);
				},

				getNodeProperties() {
					const props = this.selectedNode?.properties;
					if (!props) return {};
					if (typeof props === 'object') return props;
					try { return JSON.parse(props); } catch { return {}; }
				},


				// _highlightSelectedNode is defined below with pulsing animation support

				toggleEntityType(type) {
					const idx = this.graphVisibleTypes.indexOf(type);
					if (idx >= 0) {
						this.graphVisibleTypes.splice(idx, 1);
					} else {
						this.graphVisibleTypes.push(type);
					}
					this._applyVisibilityFilter();
				},

				graphGetTypeStats() {
					if (!this.graphData || !this.graphData.nodes) return [];
					const stats = {};
					this.graphData.nodes.forEach(node => {
						const t = node.node_type || 'UNKNOWN';
						stats[t] = (stats[t] || 0) + 1;
					});
					return Object.entries(stats)
						.sort((a, b) => b[1] - a[1])
						.map(([type, count]) => ({
							type,
							count,
							color: this._getNodeColor(type),
							label: type.charAt(0).toUpperCase() + type.slice(1).toLowerCase().replace('_', ' ')
						}));
				},

				showAllEntityTypes() {
					if (!this.graphData || !this.graphData.nodes) return;
					const types = new Set();
					this.graphData.nodes.forEach(n => types.add(n.node_type || 'UNKNOWN'));
					this.graphVisibleTypes = [...types];
					this._applyVisibilityFilter();
				},

				// Apply entity type + relationship type visibility filter to Sigma graph
				_applyVisibilityFilter() {
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (!graph || !sigma) return;
					const visibleTypes = new Set(this.graphVisibleTypes);
					const visibleRelTypes = new Set(this.graphVisibleRelTypes);
					const visibleNodeIds = new Set();
					graph.forEachNode((nodeId, attrs) => {
						const nodeType = attrs.entityType || 'UNKNOWN';
						const visible = visibleTypes.has(nodeType);
						graph.setNodeAttribute(nodeId, 'hidden', !visible);
						if (visible) visibleNodeIds.add(nodeId);
					});
					graph.forEachEdge((edgeId, attrs, source, target) => {
						const relType = attrs.label || '';
						const nodesVisible = visibleNodeIds.has(source) && visibleNodeIds.has(target);
						const relVisible = !relType || visibleRelTypes.has(relType);
						graph.setEdgeAttribute(edgeId, 'hidden', !nodesVisible || !relVisible);
					});
					sigma.refresh();
				},

				focusNode(nodeId) {
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (!graph || !sigma || !graph.hasNode(nodeId)) return;
					const node = this._graphNodeMap[nodeId];
					if (!node) return;
					this.selectedNode = node;
					this.selectedNodeEdges = this._graphEdges.filter(
						e => e.source === node.id || e.target === node.id
					);
					this._highlightSelectedNode(nodeId);
					// Animate camera to focus on node with zoom (matching EdgeQuake behavior)
					const nodePosition = { 
						x: graph.getNodeAttribute(nodeId, 'x'), 
						y: graph.getNodeAttribute(nodeId, 'y'),
						ratio: 0.5  // Zoom level: smaller = more zoomed in
					};
					sigma.getCamera().animate(nodePosition, { duration: 500 });
				},

				// === Sigma.js Graph initialization ===
				initGraph() {
					const container = document.getElementById('sigma-container');
					if (!container) return;
					
					// Force dimensions check if tab is graph
					if (this.activeTab === 'graph') {
						const rect = container.getBoundingClientRect();
						console.log('initGraph check:', { 
							width: rect.width, 
							height: rect.height, 
							activeTab: this.activeTab,
							hasData: !!this.graphData?.nodes?.length 
						});
						
						if (rect.width === 0 || rect.height === 0) {
							if (!this._initGraphRetries) this._initGraphRetries = 0;
							if (this._initGraphRetries < 20) {
								this._initGraphRetries++;
								setTimeout(() => this.initGraph(), 100);
								return;
							}
							console.warn('sigma-container still has 0 dimensions after 20 retries');
						}
					} else {
						return; // Not on graph tab
					}
					
					if (!this.graphData || !this.graphData.nodes?.length) return;
					this._initGraphRetries = 0;

					// Kill previous Sigma instance + pulse animation
					if (this._selectionPulseInterval) {
						clearInterval(this._selectionPulseInterval);
						this._selectionPulseInterval = null;
					}
					if (this._sigmaInstance) {
						this._sigmaInstance.kill();
						this._sigmaInstance = null;
					}
					this._previousSelectedNodeId = null;
					this._graphNodeCycleIndex = -1;

					// Node size map matching EdgeQuake
					const NODE_SIZES = { small: 6, medium: 10, large: 14 };
					const baseNodeSize = NODE_SIZES[this.graphNodeSize] || 10;

					// Create Graphology graph (directed, multi-edge)
					const graph = new graphology.Graph({ multi: true, type: 'directed' });
					this._graphologyInstance = graph;

					const isDark = document.documentElement.classList.contains('dark');
					const nodes = this.graphData.nodes || [];
					const edges = this.graphData.edges || [];

					// Add nodes with initial circular positions
					nodes.forEach((node, index) => {
						if (!node.id || graph.hasNode(node.id)) return;
						const angle = (2 * Math.PI * index) / nodes.length;
						const radius = 100;
						const nodeDegree = node.degree || 0;
						const dynamicSize = this._calcNodeSize(nodeDegree, baseNodeSize);
						graph.addNode(node.id, {
							label: node.label,
							x: Math.cos(angle) * radius,
							y: Math.sin(angle) * radius,
							size: dynamicSize,
							color: this._getNodeColor(node.node_type),
							entityType: node.node_type,
							description: node.description,
							degree: nodeDegree,
							zIndex: 0,
						});
					});

					// Add edges
					edges.forEach((edge) => {
						if (!edge.source || !edge.target) return;
						if (!graph.hasNode(edge.source) || !graph.hasNode(edge.target)) return;
						const edgeId = `${edge.source}-${edge.target}-${edge.edge_type || ''}`;
						if (graph.hasEdge(edgeId)) return;
						try {
							graph.addEdgeWithKey(edgeId, edge.source, edge.target, {
								label: edge.edge_type || '',
								size: Math.max(1, Math.min((edge.weight || 1) * 2, 5)),
								color: isDark ? '#4b5563' : '#94a3b8',
								type: 'arrow',
								forceLabel: false,
							});
						} catch (e) { /* duplicate edge or invalid */ }
					});

					// Build internal lookups
					const nodeMap = {};
					nodes.forEach(n => { nodeMap[n.id] = n; });
					this._graphNodes = nodes;
					this._graphEdges = edges;
					this._graphNodeMap = nodeMap;

					// Apply layout before creating Sigma
					this._applyLayoutToGraph(graph);

					// Adaptive LOD settings
					const nodeCount = graph.order;
					const edgeCount = graph.size;
					const isLargeGraph = nodeCount > 200 || edgeCount > 400;
					const isVeryLargeGraph = nodeCount > 500 || edgeCount > 1000;
					const adaptiveLabelGridCellSize = isVeryLargeGraph ? 150 : (isLargeGraph ? 100 : 80);
					const adaptiveLabelDensity = isVeryLargeGraph ? 0.6 : (isLargeGraph ? 0.7 : 0.8);
					const adaptiveLabelThreshold = isVeryLargeGraph ? 4 : (isLargeGraph ? 3 : 2);

					// Create Sigma instance
					const SigmaClass = (typeof Sigma !== 'undefined') ? (Sigma.Sigma || Sigma.default || Sigma) : null;
					if (!SigmaClass) {
						console.error('Sigma.js not loaded');
						return;
					}
					const sigma = new SigmaClass(graph, container, {
						renderLabels: this.graphShowLabels,
						renderEdgeLabels: this.graphShowEdgeLabels && !isVeryLargeGraph,
						labelSize: 13,
						labelWeight: '500',
						labelColor: { color: isDark ? '#e2e8f0' : '#374151' },
						labelFont: 'Inter, ui-sans-serif, system-ui, sans-serif',
						labelGridCellSize: adaptiveLabelGridCellSize,
						labelRenderedSizeThreshold: adaptiveLabelThreshold,
						labelDensity: adaptiveLabelDensity,
						defaultNodeColor: '#64748b',
						defaultEdgeColor: isDark ? '#4b5563' : '#94a3b8',
						defaultEdgeType: 'arrow',
						minCameraRatio: 0.1,
						maxCameraRatio: 10,
						enableEdgeClickEvents: !isVeryLargeGraph,
						enableEdgeHoverEvents: !isVeryLargeGraph,
						enableEdgeWheelEvents: false,
						stagePadding: 50,
						zIndex: true,
						allowInvalidContainer: true,
					});

					this._sigmaInstance = sigma;

					// Block browser's native context menu everywhere in the container
					container.addEventListener('contextmenu', (e) => e.preventDefault());

					// === Event handlers ===
					const self = this;

					// Node click → select and focus camera
					sigma.on('clickNode', ({ node }) => {
						const nodeData = self._graphNodeMap[node];
						if (nodeData) {
							self.focusNode(node);
						}
					});

					// Click on stage → deselect
					sigma.on('clickStage', () => {
						self.selectedNode = null;
						self.selectedNodeEdges = [];
						self._highlightSelectedNode(null);
					});


					// Node drag — only if enabled
					if (this.graphEnableDrag) {
						sigma.on('downNode', (e) => {
							self._draggedNode = e.node;
							graph.setNodeAttribute(e.node, 'highlighted', true);
						});

						sigma.getMouseCaptor().on('mousemovebody', (e) => {
							if (!self._draggedNode) return;
							const pos = sigma.viewportToGraph(e);
							graph.setNodeAttribute(self._draggedNode, 'x', pos.x);
							graph.setNodeAttribute(self._draggedNode, 'y', pos.y);
							e.preventSigmaDefault();
							e.original.preventDefault();
							e.original.stopPropagation();
						});

						sigma.getMouseCaptor().on('mouseup', () => {
							if (self._draggedNode) {
								graph.removeNodeAttribute(self._draggedNode, 'highlighted');
								self._draggedNode = null;
							}
						});
					}

					// Node hover → neighbor highlighting (if enabled)
					sigma.on('enterNode', ({ node }) => {
						if (!self.graphHighlightNeighbors) return;
						const connectedNodes = new Set();
						graph.forEachNeighbor(node, (neighbor) => connectedNodes.add(neighbor));
						graph.forEachNode((n) => {
							if (n === node) {
								graph.setNodeAttribute(n, 'highlighted', true);
							} else if (connectedNodes.has(n)) {
								graph.setNodeAttribute(n, 'highlighted', true);
							} else {
								graph.setNodeAttribute(n, 'hidden', true);
							}
						});
						// Hide unselected edges if setting is on, otherwise just hide non-connected edges
						graph.forEachEdge((edge, attrs, source, target) => {
							const isConnected = source === node || target === node;
							if (!isConnected) {
								graph.setEdgeAttribute(edge, 'hidden', true);
							} else if (self.graphHideUnselectedEdges) {
								// keep connected visible
							}
						});
						sigma.refresh();
					});

					sigma.on('leaveNode', () => {
						if (!self.graphHighlightNeighbors) return;
						graph.forEachNode((n) => {
							graph.removeNodeAttribute(n, 'hidden');
							graph.removeNodeAttribute(n, 'highlighted');
						});
						graph.forEachEdge((edge) => {
							graph.removeEdgeAttribute(edge, 'hidden');
						});
						// Re-apply entity type + relationship type filter
						self._applyVisibilityFilter();
					});

					// Edge hover → highlight
					if (!isVeryLargeGraph) {
						sigma.on('enterEdge', ({ edge }) => {
							const source = graph.source(edge);
							const target = graph.target(edge);
							const origSize = graph.getEdgeAttribute(edge, 'size') || 2;
							const origColor = graph.getEdgeAttribute(edge, 'color');
							graph.setEdgeAttribute(edge, 'size', origSize * 2);
							graph.setEdgeAttribute(edge, 'color', isDark ? '#60a5fa' : '#3b82f6');
							graph.setEdgeAttribute(edge, '_origSize', origSize);
							graph.setEdgeAttribute(edge, '_origColor', origColor);
							graph.setNodeAttribute(source, 'highlighted', true);
							graph.setNodeAttribute(target, 'highlighted', true);
							sigma.refresh();
						});
						sigma.on('leaveEdge', ({ edge }) => {
							const origSize = graph.getEdgeAttribute(edge, '_origSize');
							const origColor = graph.getEdgeAttribute(edge, '_origColor');
							if (origSize !== undefined) graph.setEdgeAttribute(edge, 'size', origSize);
							if (origColor !== undefined) graph.setEdgeAttribute(edge, 'color', origColor);
							const source = graph.source(edge);
							const target = graph.target(edge);
							graph.removeNodeAttribute(source, 'highlighted');
							graph.removeNodeAttribute(target, 'highlighted');
							sigma.refresh();
						});
					}

					// Keyboard shortcuts on the sigma container
					container.tabIndex = 0;
					container.style.outline = 'none';
					container.addEventListener('keydown', (e) => {
						if (e.key === 'Escape') {
							self.selectedNode = null;
							self.selectedNodeEdges = [];
							self._highlightSelectedNode(null);
						} else if (e.key === '+' || e.key === '=') {
							self.graphZoomIn();
						} else if (e.key === '-') {
							self.graphZoomOut();
						} else if (e.key === '0') {
							self.graphResetCamera();
						} else if (e.key === 'f' || e.key === 'F') {
							if (!e.ctrlKey && !e.metaKey) self.graphToggleFullscreen();
						} else if (e.key === 'Tab') {
							e.preventDefault();
							self._cycleNodes(e.shiftKey ? -1 : 1);
						} else if (e.key === 'Enter') {
							if (self.selectedNode) self.focusNode(self.selectedNode.id);
						} else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
							e.preventDefault();
							self._cycleNodes(1);
						} else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
							e.preventDefault();
							self._cycleNodes(-1);
						}
					});

					// Double-click to focus
					sigma.on('doubleClickNode', ({ node }) => {
						self.focusNode(node);
					});
					sigma.on('doubleClickStage', () => {
						self.selectedNode = null;
						self.selectedNodeEdges = [];
						self._highlightSelectedNode(null);
					});

					// Setup minimap
					this._setupMinimap();
				},

				// Apply layout algorithm to Graphology graph (all 7 EdgeQuake layouts)
				_applyLayoutToGraph(graph) {
					if (!graph || graph.order === 0) return;
					const layout = this.graphLayout;
					const nodeCount = graph.order;

					if (layout === 'circular') {
						let i = 0;
						graph.forEachNode((nodeId) => {
							const angle = (2 * Math.PI * i) / nodeCount;
							const radius = Math.max(100, nodeCount * 3);
							graph.setNodeAttribute(nodeId, 'x', Math.cos(angle) * radius);
							graph.setNodeAttribute(nodeId, 'y', Math.sin(angle) * radius);
							i++;
						});
						return;
					}

					if (layout === 'circlepack') {
						// Circle-pack layout: group by entity type, concentric rings
						const groups = {};
						graph.forEachNode((nodeId, attrs) => {
							const t = attrs.entityType || 'UNKNOWN';
							if (!groups[t]) groups[t] = [];
							groups[t].push(nodeId);
						});
						const typeKeys = Object.keys(groups);
						let globalIdx = 0;
						typeKeys.forEach((type, ringIdx) => {
							const ring = groups[type];
							const ringRadius = (ringIdx + 1) * Math.max(50, nodeCount * 2);
							ring.forEach((nodeId, i) => {
								const angle = (2 * Math.PI * i) / ring.length;
								graph.setNodeAttribute(nodeId, 'x', Math.cos(angle) * ringRadius);
								graph.setNodeAttribute(nodeId, 'y', Math.sin(angle) * ringRadius);
								globalIdx++;
							});
						});
						return;
					}

					if (layout === 'random') {
						// Random positions + ForceAtlas2 settle (like EdgeQuake random+FA2)
						graph.forEachNode((nodeId) => {
							graph.setNodeAttribute(nodeId, 'x', (Math.random() - 0.5) * 300);
							graph.setNodeAttribute(nodeId, 'y', (Math.random() - 0.5) * 300);
						});
						// Settle with FA2 if available
						if (typeof graphologyLayoutForceAtlas2 !== 'undefined' && graphologyLayoutForceAtlas2) {
							try {
								graphologyLayoutForceAtlas2.assign(graph, {
									iterations: Math.min(30, nodeCount > 200 ? 15 : 30),
									settings: {
										gravity: 1,
										scalingRatio: 2,
										strongGravityMode: true,
										barnesHutOptimize: nodeCount > 50,
									},
								});
							} catch (e) { /* FA2 failed */ }
						}
						return;
					}

					if (layout === 'noverlap') {
						// First apply circular, then resolve overlaps manually
						let i = 0;
						graph.forEachNode((nodeId) => {
							const angle = (2 * Math.PI * i) / nodeCount;
							const radius = Math.max(100, nodeCount * 3);
							graph.setNodeAttribute(nodeId, 'x', Math.cos(angle) * radius);
							graph.setNodeAttribute(nodeId, 'y', Math.sin(angle) * radius);
							i++;
						});
						// Simple overlap resolution: push overlapping nodes apart
						for (let iter = 0; iter < 50; iter++) {
							const positions = [];
							graph.forEachNode((nodeId, attrs) => {
								positions.push({ id: nodeId, x: attrs.x, y: attrs.y, size: attrs.size || 8 });
							});
							let moved = false;
							for (let a = 0; a < positions.length; a++) {
								for (let b = a + 1; b < positions.length; b++) {
									const dx = positions[b].x - positions[a].x;
									const dy = positions[b].y - positions[a].y;
									const dist = Math.sqrt(dx * dx + dy * dy) || 0.1;
									const minDist = (positions[a].size + positions[b].size) * 2.5;
									if (dist < minDist) {
										const push = (minDist - dist) / 2;
										const nx = (dx / dist) * push;
										const ny = (dy / dist) * push;
										positions[a].x -= nx; positions[a].y -= ny;
										positions[b].x += nx; positions[b].y += ny;
										moved = true;
									}
								}
							}
							if (!moved) break;
							positions.forEach(p => {
								graph.setNodeAttribute(p.id, 'x', p.x);
								graph.setNodeAttribute(p.id, 'y', p.y);
							});
						}
						return;
					}

					if (layout === 'hierarchical') {
						const groups = {};
						graph.forEachNode((nodeId, attrs) => {
							const t = attrs.entityType || 'UNKNOWN';
							if (!groups[t]) groups[t] = [];
							groups[t].push(nodeId);
						});
						const typeKeys = Object.keys(groups);
						typeKeys.forEach((type, rowIdx) => {
							const row = groups[type];
							row.forEach((nodeId, colIdx) => {
								graph.setNodeAttribute(nodeId, 'x', (colIdx - row.length / 2) * 30);
								graph.setNodeAttribute(nodeId, 'y', rowIdx * 60);
							});
						});
						return;
					}

					// Force-based layouts: ForceAtlas2 (default) or Force Directed
					// graphologyLayoutForceAtlas2 is loaded via ESM import in layout.templ
					if (typeof graphologyLayoutForceAtlas2 !== 'undefined' && graphologyLayoutForceAtlas2) {
						try {
							const isFA2 = layout === 'force-atlas';
							const iterations = nodeCount > 500 ? 15 : (nodeCount > 100 ? 30 : 50);
							graphologyLayoutForceAtlas2.assign(graph, {
								iterations: iterations,
								settings: {
									gravity: isFA2 ? 1 : 0.5,
									scalingRatio: isFA2 ? 2 : 5,
									strongGravityMode: isFA2,
									barnesHutOptimize: nodeCount > 50,
									barnesHutTheta: 0.6,
									slowDown: 2,
									edgeWeightInfluence: 0.5,
								},
							});
							return;
						} catch (e) {
							console.warn('ForceAtlas2 layout failed, falling back to manual:', e);
						}
					}

					// Fallback: Simple force-directed layout in JS
					this._manualForceLayout(graph);
				},

				// Fallback force-directed layout
				_manualForceLayout(graph) {
					const nodeCount = graph.order;
					const maxIterations = 80;
					const nodes = [];
					const posMap = {};
					graph.forEachNode((nodeId, attrs) => {
						posMap[nodeId] = { x: attrs.x || (Math.random() - 0.5) * 200, y: attrs.y || (Math.random() - 0.5) * 200, vx: 0, vy: 0 };
						nodes.push(nodeId);
					});
					for (let iter = 0; iter < maxIterations; iter++) {
						const alpha = Math.max(0.001, 1 - iter / maxIterations);
						const repK = 200;
						// Repulsion
						for (let i = 0; i < nodes.length; i++) {
							for (let j = i + 1; j < nodes.length; j++) {
								const a = posMap[nodes[i]], b = posMap[nodes[j]];
								let dx = b.x - a.x, dy = b.y - a.y;
								let dist = Math.sqrt(dx * dx + dy * dy) || 1;
								let force = -repK / (dist * dist);
								let fx = (dx / dist) * force * alpha;
								let fy = (dy / dist) * force * alpha;
								a.vx -= fx; a.vy -= fy;
								b.vx += fx; b.vy += fy;
							}
						}
						// Attraction
						graph.forEachEdge((edgeId, attrs, source, target) => {
							const s = posMap[source], t = posMap[target];
							if (!s || !t) return;
							let dx = t.x - s.x, dy = t.y - s.y;
							let dist = Math.sqrt(dx * dx + dy * dy) || 1;
							let force = (dist - 100) * 0.02 * alpha;
							let fx = (dx / dist) * force, fy = (dy / dist) * force;
							s.vx += fx; s.vy += fy;
							t.vx -= fx; t.vy -= fy;
						});
						// Gravity
						for (const id of nodes) {
							const p = posMap[id];
							const dist = Math.sqrt(p.x * p.x + p.y * p.y) || 1;
							p.vx -= (p.x / dist) * 0.5 * alpha;
							p.vy -= (p.y / dist) * 0.5 * alpha;
						}
						// Apply with damping
						for (const id of nodes) {
							const p = posMap[id];
							p.vx *= 0.6; p.vy *= 0.6;
							const vmag = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
							if (vmag > 10) { p.vx = (p.vx / vmag) * 10; p.vy = (p.vy / vmag) * 10; }
							p.x += p.vx; p.y += p.vy;
						}
					}
					// Apply positions back to graph
					for (const id of nodes) {
						graph.setNodeAttribute(id, 'x', posMap[id].x);
						graph.setNodeAttribute(id, 'y', posMap[id].y);
					}
				},

				// Apply layout change with animated transition (matching EdgeQuake 500ms animateNodes)
				applyLayout() {
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (!graph || !sigma || graph.order === 0) return;

					// Capture old positions for animation
					const oldPositions = {};
					graph.forEachNode((nodeId, attrs) => {
						oldPositions[nodeId] = { x: attrs.x, y: attrs.y };
					});

					// Calculate new layout positions on a temp copy
					const tempGraph = graph.copy();
					const savedLayout = this.graphLayout;
					this._applyLayoutToGraph(tempGraph);

					// Extract new positions
					const newPositions = {};
					tempGraph.forEachNode((nodeId) => {
						newPositions[nodeId] = {
							x: tempGraph.getNodeAttribute(nodeId, 'x'),
							y: tempGraph.getNodeAttribute(nodeId, 'y'),
						};
					});

					// Animate from old to new positions (500ms, ease-in-out)
					const duration = 500;
					const startTime = performance.now();
					const easeInOut = (t) => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;

					const animate = () => {
						const elapsed = performance.now() - startTime;
						const progress = Math.min(elapsed / duration, 1);
						const eased = easeInOut(progress);

						graph.forEachNode((nodeId) => {
							const oldPos = oldPositions[nodeId];
							const newPos = newPositions[nodeId];
							if (oldPos && newPos) {
								graph.setNodeAttribute(nodeId, 'x', oldPos.x + (newPos.x - oldPos.x) * eased);
								graph.setNodeAttribute(nodeId, 'y', oldPos.y + (newPos.y - oldPos.y) * eased);
							}
						});
						sigma.refresh();

						if (progress < 1) {
							requestAnimationFrame(animate);
						} else {
							this.graphResetCamera();
						}
					};
					requestAnimationFrame(animate);
					this.saveGraphSettings();
				},

				// Minimap: draw a scaled overview of the graph on the minimap canvas
				_setupMinimap() {
					const minimap = document.getElementById('graph-minimap');
					if (!minimap || !this._sigmaInstance || !this._graphologyInstance) return;
					const self = this;
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					const mctx = minimap.getContext('2d');

					const drawMinimap = () => {
						const mr = minimap.parentElement.getBoundingClientRect();
						const dpr = window.devicePixelRatio || 1;
						minimap.width = mr.width * dpr;
						minimap.height = mr.height * dpr;
						mctx.setTransform(dpr, 0, 0, dpr, 0, 0);
						const mw = mr.width, mh = mr.height;
						const isDark = document.documentElement.classList.contains('dark');
						mctx.clearRect(0, 0, mw, mh);
						mctx.fillStyle = isDark ? '#111827' : '#f8fafc';
						mctx.fillRect(0, 0, mw, mh);

						// Compute bounds from graph attributes
						let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
						graph.forEachNode((nodeId, attrs) => {
							if (attrs.hidden) return;
							minX = Math.min(minX, attrs.x);
							minY = Math.min(minY, attrs.y);
							maxX = Math.max(maxX, attrs.x);
							maxY = Math.max(maxY, attrs.y);
						});
						if (!isFinite(minX)) return;
						const pad = 20;
						minX -= pad; minY -= pad; maxX += pad; maxY += pad;
						const gw = maxX - minX || 1;
						const gh = maxY - minY || 1;
						const scale = Math.min(mw / gw, mh / gh);
						const ox = (mw - gw * scale) / 2;
						const oy = (mh - gh * scale) / 2;

						// Draw edges
						mctx.strokeStyle = isDark ? '#374151' : '#d1d5db';
						mctx.lineWidth = 0.5;
						mctx.globalAlpha = 0.3;
						graph.forEachEdge((edgeId, attrs, source, target) => {
							if (attrs.hidden) return;
							const sAttrs = graph.getNodeAttributes(source);
							const tAttrs = graph.getNodeAttributes(target);
							if (sAttrs.hidden || tAttrs.hidden) return;
							mctx.beginPath();
							mctx.moveTo(ox + (sAttrs.x - minX) * scale, oy + (sAttrs.y - minY) * scale);
							mctx.lineTo(ox + (tAttrs.x - minX) * scale, oy + (tAttrs.y - minY) * scale);
							mctx.stroke();
						});
						mctx.globalAlpha = 1;

						// Draw nodes
						graph.forEachNode((nodeId, attrs) => {
							if (attrs.hidden) return;
							mctx.beginPath();
							mctx.arc(
								ox + (attrs.x - minX) * scale,
								oy + (attrs.y - minY) * scale,
								Math.max(1.5, (attrs.size || 4) * scale * 0.15),
								0, 2 * Math.PI
							);
							mctx.fillStyle = attrs.color || '#6b7280';
							mctx.fill();
						});

						// Draw viewport rectangle from Sigma camera
						const camera = sigma.getCamera();
						const state = camera.getState();
						const vw = mw / (state.ratio || 1);
						const vh = mh / (state.ratio || 1);
						const camX = ox + (gw * scale / 2) + (state.x || 0) * scale - vw / 2;
						const camY = oy + (gh * scale / 2) + (state.y || 0) * scale - vh / 2;
						mctx.strokeStyle = isDark ? '#60a5fa' : '#2563eb';
						mctx.lineWidth = 1.5;
						mctx.strokeRect(camX, camY, vw, vh);
					};

					// Redraw minimap on sigma afterRender
					sigma.on('afterRender', drawMinimap);
					drawMinimap();

					// Minimap click-to-navigate
					let isDragging = false;
					const navigateToMinimapPos = (e) => {
						let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
						graph.forEachNode((nodeId, attrs) => {
							if (attrs.hidden) return;
							minX = Math.min(minX, attrs.x);
							minY = Math.min(minY, attrs.y);
							maxX = Math.max(maxX, attrs.x);
							maxY = Math.max(maxY, attrs.y);
						});
						if (!isFinite(minX)) return;
						const pad = 20;
						minX -= pad; minY -= pad; maxX += pad; maxY += pad;
						const rect = minimap.getBoundingClientRect();
						const mx = e.clientX - rect.left;
						const my = e.clientY - rect.top;
						const mw = rect.width, mh = rect.height;
						const gw = maxX - minX || 1;
						const gh = maxY - minY || 1;
						const sc = Math.min(mw / gw, mh / gh);
						const oox = (mw - gw * sc) / 2;
						const ooy = (mh - gh * sc) / 2;
						const graphX = (mx - oox) / sc + minX;
						const graphY = (my - ooy) / sc + minY;
						sigma.getCamera().animate({ x: graphX - (maxX + minX) / 2, y: graphY - (maxY + minY) / 2 }, { duration: 150 });
					};
					minimap.onmousedown = (e) => { e.preventDefault(); e.stopPropagation(); isDragging = true; navigateToMinimapPos(e); };
					minimap.onmousemove = (e) => { if (isDragging) navigateToMinimapPos(e); };
					minimap.onmouseup = () => { isDragging = false; };
					minimap.onmouseleave = () => { isDragging = false; };
				},

				// Zoom controls (using Sigma camera API)
				graphZoomIn() {
					if (this._sigmaInstance) {
						this._sigmaInstance.getCamera().animatedZoom({ factor: 1.5 });
					}
				},

				graphZoomOut() {
					if (this._sigmaInstance) {
						this._sigmaInstance.getCamera().animatedUnzoom({ factor: 1.5 });
					}
				},

				graphResetCamera() {
					if (this._sigmaInstance) {
						this._sigmaInstance.getCamera().animatedReset();
					}
				},

				// Refresh Sigma renderer settings (called by controls toggles)
				graphRefresh() {
					const sigma = this._sigmaInstance;
					if (!sigma) return;
					sigma.setSetting('renderLabels', this.graphShowLabels);
					sigma.setSetting('renderEdgeLabels', this.graphShowEdgeLabels);
					sigma.refresh();
					this.saveGraphSettings();
				},

				graphToggleFullscreen() {
					const container = document.getElementById('graph-container');
					if (!container) return;
					if (document.fullscreenElement) {
						document.exitFullscreen().then(() => { this.isFullscreen = false; });
					} else {
						container.requestFullscreen().then(() => { this.isFullscreen = true; }).catch(() => {});
					}
				},

				graphFocusOnNode() {
					if (this.selectedNode) {
						this.focusNode(this.selectedNode.id);
					}
				},

				// === Camera rotation (matching EdgeQuake zoom-controls.tsx) ===
				graphRotateCW() {
					if (!this._sigmaInstance) return;
					const camera = this._sigmaInstance.getCamera();
					const state = camera.getState();
					camera.animate({ angle: (state.angle || 0) + Math.PI / 12 }, { duration: 200 });
				},

				graphRotateCCW() {
					if (!this._sigmaInstance) return;
					const camera = this._sigmaInstance.getCamera();
					const state = camera.getState();
					camera.animate({ angle: (state.angle || 0) - Math.PI / 12 }, { duration: 200 });
				},

				// === Export (matching EdgeQuake graph-export.tsx) ===
				graphExportPNG() {
					const sigma = this._sigmaInstance;
					if (!sigma) return;
					// Capture the sigma canvas
					const container = document.getElementById('sigma-container');
					if (!container) return;
					const canvases = container.querySelectorAll('canvas');
					if (canvases.length === 0) return;
					
					// Create a combined canvas
					const mainCanvas = canvases[0];
					const exportCanvas = document.createElement('canvas');
					exportCanvas.width = mainCanvas.width;
					exportCanvas.height = mainCanvas.height;
					const ctx = exportCanvas.getContext('2d');
					
					// Draw all sigma canvases (nodes, edges, labels layers)
					canvases.forEach(c => {
						ctx.drawImage(c, 0, 0);
					});
					
					// Download
					exportCanvas.toBlob((blob) => {
						if (!blob) return;
						const url = URL.createObjectURL(blob);
						const a = document.createElement('a');
						a.href = url;
						a.download = `knowledge-graph-${new Date().toISOString().slice(0,10)}.png`;
						a.click();
						URL.revokeObjectURL(url);
					}, 'image/png');
				},

				graphExportJSON() {
					if (!this.graphData) return;
					const exportData = {
						metadata: {
							exportedAt: new Date().toISOString(),
							nodeCount: (this.graphData.nodes || []).length,
							edgeCount: (this.graphData.edges || []).length,
							totalNodes: this.graphData.total_nodes || 0,
							isTruncated: this.graphData.is_truncated || false,
						},
						nodes: this.graphData.nodes || [],
						edges: this.graphData.edges || [],
					};
					const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = `knowledge-graph-${new Date().toISOString().slice(0,10)}.json`;
					a.click();
					URL.revokeObjectURL(url);
				},

				// === Node cycling (Tab/Shift+Tab, arrows — matching EdgeQuake) ===
				_cycleNodes(direction) {
					if (!this._graphNodes || this._graphNodes.length === 0) return;
					const visibleNodes = this._graphNodes.filter(n => 
						this.graphVisibleTypes.includes(n.node_type || 'UNKNOWN')
					);
					if (visibleNodes.length === 0) return;
					
					this._graphNodeCycleIndex += direction;
					if (this._graphNodeCycleIndex >= visibleNodes.length) this._graphNodeCycleIndex = 0;
					if (this._graphNodeCycleIndex < 0) this._graphNodeCycleIndex = visibleNodes.length - 1;
					
					const node = visibleNodes[this._graphNodeCycleIndex];
					this.selectedNode = node;
					this.selectedNodeEdges = this._graphEdges.filter(
						e => e.source === node.id || e.target === node.id
					);
					this._highlightSelectedNode(node.id);
					
					// Animate camera to the node
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (graph && sigma && graph.hasNode(node.id)) {
						const pos = {
							x: graph.getNodeAttribute(node.id, 'x'),
							y: graph.getNodeAttribute(node.id, 'y'),
						};
						sigma.getCamera().animate(pos, { duration: 200 });
					}
				},

				// === Expand neighborhood (fetch 1-hop neighbors via entity API + add to graph) ===
				async expandNeighborhood(nodeId) {
					try {
						// Use the entity neighborhood endpoint; nodeId doubles as entity name label
						const resp = await fetch(`/api/knowledge/graph/entities/${encodeURIComponent(nodeId)}/neighborhood?depth=1&workspace_id=${this.workspaceId}`);
						if (!resp.ok) return;
						const data = await resp.json();
						// Normalise: entity neighborhood returns { nodes: [...], edges: [...] }
						const rawNodes = data.nodes || data.Nodes || [];
						const rawEdges = data.edges || data.Edges || [];
						// Remap to the graph data shape expected below
						const remapped = {
							nodes: rawNodes.map(n => ({ id: n.id, label: n.id, node_type: n.entityType || n.entity_type || 'UNKNOWN', description: n.description, degree: n.degree || 0 })),
							edges: rawEdges.map(e => ({ source: e.source || e.Source, target: e.target || e.Target, edge_type: e.relationType || e.relation_type || e.edge_type || e.label || '', weight: e.weight || e.Weight || 1 })),
						};
						const mappedData = remapped;
						const graph = this._graphologyInstance;
						const sigma = this._sigmaInstance;
						if (!graph || !sigma) return;

						const isDark = document.documentElement.classList.contains('dark');
						const NODE_SIZES = { small: 6, medium: 10, large: 14 };
						const baseNodeSize = NODE_SIZES[this.graphNodeSize] || 10;
						let addedNodes = 0;
						let addedEdges = 0;

						// Add new nodes
						(mappedData.nodes || []).forEach((node) => {
							if (!node.id || graph.hasNode(node.id)) return;
							// Position near the expanded node
							const parentX = graph.getNodeAttribute(nodeId, 'x') || 0;
							const parentY = graph.getNodeAttribute(nodeId, 'y') || 0;
							const angle = Math.random() * 2 * Math.PI;
							const dist = 30 + Math.random() * 40;
							const degree = node.degree || 0;
							graph.addNode(node.id, {
								label: node.label,
								x: parentX + Math.cos(angle) * dist,
								y: parentY + Math.sin(angle) * dist,
								size: this._calcNodeSize(degree, baseNodeSize),
								color: this._getNodeColor(node.node_type),
								entityType: node.node_type,
								description: node.description,
								degree: degree,
								zIndex: 0,
							});
							this._graphNodeMap[node.id] = node;
							this._graphNodes.push(node);
							addedNodes++;
						});

						// Add new edges
						(mappedData.edges || []).forEach((edge) => {
							if (!edge.source || !edge.target) return;
							if (!graph.hasNode(edge.source) || !graph.hasNode(edge.target)) return;
							const edgeId = `${edge.source}-${edge.target}-${edge.edge_type || ''}`;
							if (graph.hasEdge(edgeId)) return;
							try {
								graph.addEdgeWithKey(edgeId, edge.source, edge.target, {
									label: edge.edge_type || '',
									size: Math.max(1, Math.min((edge.weight || 1) * 2, 5)),
									color: isDark ? '#4b5563' : '#94a3b8',
									type: 'arrow',
									forceLabel: false,
								});
								this._graphEdges.push(edge);
								addedEdges++;
							} catch (e) { /* duplicate */ }
						});

						// Quick FA2 settle for the new nodes
						if (addedNodes > 0 && typeof graphologyLayoutForceAtlas2 !== 'undefined') {
							try {
								graphologyLayoutForceAtlas2.assign(graph, {
									iterations: 20,
									settings: {
										gravity: 1,
										scalingRatio: 2,
										strongGravityMode: true,
										barnesHutOptimize: true,
									},
								});
							} catch (e) { /* settle failed */ }
						}

						sigma.refresh();
						this._setupMinimap();
					} catch (e) {
						console.error('Failed to expand neighborhood:', e);
					}
				},

				// === Prune node (remove + orphaned neighbors) ===
				pruneNode(nodeId) {
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (!graph || !sigma || !graph.hasNode(nodeId)) return;

					// Find neighbors that would become orphaned
					const neighbors = [];
					graph.forEachNeighbor(nodeId, (neighbor) => neighbors.push(neighbor));

					// Remove the node
					graph.dropNode(nodeId);
					delete this._graphNodeMap[nodeId];
					this._graphNodes = this._graphNodes.filter(n => n.id !== nodeId);
					this._graphEdges = this._graphEdges.filter(e => e.source !== nodeId && e.target !== nodeId);

					// Remove orphaned neighbors (degree 0 after removal)
					neighbors.forEach((nId) => {
						if (graph.hasNode(nId) && graph.degree(nId) === 0) {
							graph.dropNode(nId);
							delete this._graphNodeMap[nId];
							this._graphNodes = this._graphNodes.filter(n => n.id !== nId);
						}
					});

					// Deselect if pruned node was selected
					if (this.selectedNode?.id === nodeId) {
						this.selectedNode = null;
						this.selectedNodeEdges = [];
						this._highlightSelectedNode(null);
					}

					sigma.refresh();
					this._setupMinimap();
				},

				// === Delete graph entity via API (uses entity CRUD endpoint) ===
				async deleteGraphEntity(nodeId, label) {
					if (!confirm(`Delete entity "${label}"? This cannot be undone.`)) return;
					try {
						const resp = await fetch(`/api/knowledge/graph/entities/${encodeURIComponent(nodeId)}?confirm=true&workspace_id=${this.workspaceId}`, {
							method: 'DELETE',
						});
						if (resp.ok) {
							this.pruneNode(nodeId);
						}
					} catch (e) {
						console.error('Failed to delete entity:', e);
					}
				},

				// === Relationship type toggle ===
				toggleRelType(rt) {
					const idx = this.graphVisibleRelTypes.indexOf(rt);
					if (idx >= 0) {
						this.graphVisibleRelTypes.splice(idx, 1);
					} else {
						this.graphVisibleRelTypes.push(rt);
					}
					this._applyVisibilityFilter();
				},

				// === Node size change ===
				applyNodeSize() {
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (!graph || !sigma) return;
					const NODE_SIZES = { small: 6, medium: 10, large: 14 };
					const baseNodeSize = NODE_SIZES[this.graphNodeSize] || 10;
					graph.forEachNode((nodeId, attrs) => {
						const degree = attrs.degree || 0;
						graph.setNodeAttribute(nodeId, 'size', this._calcNodeSize(degree, baseNodeSize));
					});
					sigma.refresh();
					this.saveGraphSettings();
				},

				// === Resizable node details panel ===
				_startPanelResize(e) {
					const startX = e.clientX;
					const startWidth = this._nodeDetailsPanelWidth || 320;
					const onMove = (e) => {
						const diff = startX - e.clientX;
						this._nodeDetailsPanelWidth = Math.max(280, Math.min(480, startWidth + diff));
					};
					const onUp = () => {
						document.removeEventListener('mousemove', onMove);
						document.removeEventListener('mouseup', onUp);
						this.saveGraphSettings();
					};
					document.addEventListener('mousemove', onMove);
					document.addEventListener('mouseup', onUp);
				},

				// === Load More (truncation) ===
				graphLoadMore() {
					const current = parseInt(this.graphMaxNodes) || 100;
					const next = Math.min(Math.round(current * 1.5), 500);
					this.graphMaxNodes = String(next);
					this.loadGraph();
				},

				// === Selected node pulsing animation (matching EdgeQuake) ===
				_highlightSelectedNode(nodeId) {
					const graph = this._graphologyInstance;
					const sigma = this._sigmaInstance;
					if (!graph || !sigma) return;

					// Stop previous pulse
					if (this._selectionPulseInterval) {
						clearInterval(this._selectionPulseInterval);
						this._selectionPulseInterval = null;
					}

					// Restore previous selected node
					if (this._previousSelectedNodeId && graph.hasNode(this._previousSelectedNodeId)) {
						const prevId = this._previousSelectedNodeId;
						const NODE_SIZES = { small: 6, medium: 10, large: 14 };
						const baseNodeSize = NODE_SIZES[this.graphNodeSize] || 10;
						const prevDegree = graph.getNodeAttribute(prevId, 'degree') || 0;
						const origSize = this._calcNodeSize(prevDegree, baseNodeSize);
						graph.setNodeAttribute(prevId, 'size', origSize);
						graph.setNodeAttribute(prevId, 'highlighted', false);
						graph.setNodeAttribute(prevId, 'zIndex', 0);
					}

					if (nodeId && graph.hasNode(nodeId)) {
						const currentSize = graph.getNodeAttribute(nodeId, 'size') || 10;
						graph.setNodeAttribute(nodeId, 'size', currentSize * 2);
						graph.setNodeAttribute(nodeId, 'highlighted', true);
						graph.setNodeAttribute(nodeId, 'zIndex', 999);
						this._previousSelectedNodeId = nodeId;

						// Pulsing animation at 20fps (matching EdgeQuake 3.5↔4.5 border concept via size)
						let phase = 0;
						this._selectionPulseInterval = setInterval(() => {
							if (!graph.hasNode(nodeId)) {
								clearInterval(this._selectionPulseInterval);
								this._selectionPulseInterval = null;
								return;
							}
							phase = (phase + 0.15) % (Math.PI * 2);
							const basePulseSize = currentSize * 2;
							const pulseSize = basePulseSize + Math.sin(phase) * (currentSize * 0.2);
							graph.setNodeAttribute(nodeId, 'size', pulseSize);
							sigma.refresh();
						}, 50);
					} else {
						this._previousSelectedNodeId = null;
					}
					sigma.refresh();
				},

				// === Settings persistence (localStorage) ===
				saveGraphSettings() {
					try {
						const settings = {
							graphLayout: this.graphLayout,
							graphMaxNodes: this.graphMaxNodes,
							graphShowLabels: this.graphShowLabels,
							graphShowEdgeLabels: this.graphShowEdgeLabels,
							graphNodeSize: this.graphNodeSize,
							graphEnableDrag: this.graphEnableDrag,
							graphHighlightNeighbors: this.graphHighlightNeighbors,
							graphHideUnselectedEdges: this.graphHideUnselectedEdges,
							_nodeDetailsPanelWidth: this._nodeDetailsPanelWidth,
						};
						localStorage.setItem('graph-settings', JSON.stringify(settings));
					} catch (e) { /* localStorage unavailable */ }
				},

				restoreGraphSettings() {
					try {
						const saved = localStorage.getItem('graph-settings');
						if (!saved) return;
						const settings = JSON.parse(saved);
						if (settings.graphLayout) this.graphLayout = settings.graphLayout;
						if (settings.graphMaxNodes) this.graphMaxNodes = settings.graphMaxNodes;
						if (settings.graphShowLabels !== undefined) this.graphShowLabels = settings.graphShowLabels;
						if (settings.graphShowEdgeLabels !== undefined) this.graphShowEdgeLabels = settings.graphShowEdgeLabels;
						if (settings.graphNodeSize) this.graphNodeSize = settings.graphNodeSize;
						if (settings.graphEnableDrag !== undefined) this.graphEnableDrag = settings.graphEnableDrag;
						if (settings.graphHighlightNeighbors !== undefined) this.graphHighlightNeighbors = settings.graphHighlightNeighbors;
						if (settings.graphHideUnselectedEdges !== undefined) this.graphHideUnselectedEdges = settings.graphHideUnselectedEdges;
						if (settings._nodeDetailsPanelWidth) this._nodeDetailsPanelWidth = settings._nodeDetailsPanelWidth;
					} catch (e) { /* parse error or localStorage unavailable */ }
				},

				saveEntityBrowserSettings() {
					try {
						const settings = {
							entityBrowserCollapsed: this.entityBrowserCollapsed,
							entityBrowserViewMode: this.entityBrowserViewMode,
							entityBrowserSortBy: this.entityBrowserSortBy,
							entityBrowserSortAsc: this.entityBrowserSortAsc,
						};
						localStorage.setItem('entity-browser-settings', JSON.stringify(settings));
					} catch (e) { /* localStorage unavailable */ }
				},

				restoreEntityBrowserSettings() {
					try {
						const saved = localStorage.getItem('entity-browser-settings');
						if (!saved) return;
						const settings = JSON.parse(saved);
						if (settings.entityBrowserCollapsed !== undefined) this.entityBrowserCollapsed = settings.entityBrowserCollapsed;
						if (settings.entityBrowserViewMode) this.entityBrowserViewMode = settings.entityBrowserViewMode;
						if (settings.entityBrowserSortBy) this.entityBrowserSortBy = settings.entityBrowserSortBy;
						if (settings.entityBrowserSortAsc !== undefined) this.entityBrowserSortAsc = settings.entityBrowserSortAsc;
					} catch (e) { /* parse error or localStorage unavailable */ }
				},
			}));

			Alpine.data('uploadDocumentForm', () => ({
				file: null,
				uploading: false,
				progress: 0,
				error: '',

				fileSelected(event) {
					this.file = event.target.files[0];
					this.error = '';
				},

				async upload() {
					if (!this.file) return;
					
					this.uploading = true;
					this.progress = 0;
					this.error = '';
					
					const formData = new FormData();
					formData.append('file', this.file);
					
					const workspaceId = this.$data.workspaceId || document.querySelector('[x-data^="workspaceDetails"]').__x.$data.workspaceId;
					
					try {
						const xhr = new XMLHttpRequest();
						
						xhr.upload.addEventListener('progress', (e) => {
							if (e.lengthComputable) {
								this.progress = (e.loaded / e.total) * 100;
							}
						});
						
						const promise = new Promise((resolve, reject) => {
							xhr.onreadystatechange = () => {
								if (xhr.readyState === 4) {
									if (xhr.status >= 200 && xhr.status < 300) {
										resolve(JSON.parse(xhr.responseText));
									} else {
										try {
											const resp = JSON.parse(xhr.responseText);
											reject(new Error(resp.error || 'Upload failed'));
										} catch (e) {
											reject(new Error('Upload failed'));
										}
									}
								}
							};
							
							xhr.onerror = () => reject(new Error('Network error'));
						});
						
						xhr.open('POST', `/api/knowledge/documents/upload?workspace_id=${workspaceId}`);
						xhr.send(formData);
						
						await promise;
						
						this.file = null;
						document.getElementById('document-file').value = '';
						
						window.dispatchEvent(new CustomEvent('document-uploaded'));
					window.tui.dialog.close('upload-document-dialog');
						
					} catch (e) {
						this.error = e.message;
						console.error(e);
					} finally {
						this.uploading = false;
					}
				}
			}));
		});
	</script>
}
