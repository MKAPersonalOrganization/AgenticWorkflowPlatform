package knowledge

/**
 * DocumentTableSection - Document table with header, states, rows, and pagination.
 * Matches EdgeQuake edgequake_webui/src/components/documents/document-table-section.tsx
 *
 * Scrollable table with sticky header, loading skeleton, empty state, filter info text,
 * pagination footer, select-all checkbox, and rows.
 */

import (
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ DocumentTableSection() {
	<div class="flex-1 min-h-0 overflow-auto">
		<div class="px-4 py-3">
			<div class="flex items-center gap-2 mb-3">
				@icon.FileText(icon.Props{Class: "size-4 text-muted-foreground"})
				<span class="text-sm font-medium">
					Documents (<span x-text="filteredDocuments.length"></span>)
				</span>
			</div>
			<!-- Loading State -->
			<div x-show="docsLoading" class="flex items-center justify-center py-20">
				<div class="flex flex-col items-center gap-3">
					<span class="animate-spin size-8 border-2 border-primary border-t-transparent rounded-full"></span>
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "Loading documents...") }</p>
				</div>
			</div>
			<!-- Empty State -->
			<div x-show="!docsLoading && filteredDocuments.length === 0" x-cloak class="flex flex-col items-center justify-center py-20 text-center border-2 border-dashed rounded-xl bg-muted/20">
				<div class="bg-background p-4 rounded-full shadow-sm mb-4">
					@icon.FileText(icon.Props{Class: "size-10 text-muted-foreground"})
				</div>
				<h3 class="text-xl font-semibold">
					<span x-show="docStatusFilter" x-text="'No ' + docStatusFilter + ' documents'"></span>
					<span x-show="!docStatusFilter">{ i18n.T(ctx, "No documents yet") }</span>
				</h3>
				<p class="text-sm text-muted-foreground mt-2">
					<span x-show="docStatusFilter">
						<button @click="filterByStatus('')" class="text-primary hover:underline">{ i18n.T(ctx, "View all documents") }</button>
					</span>
					<span x-show="!docStatusFilter">{ i18n.T(ctx, "Upload files to start building your knowledge base.") }</span>
				</p>
				<button
					x-show="!docStatusFilter"
					@click="$refs.fileInput && $refs.fileInput.click()"
					class="inline-flex items-center gap-2 mt-4 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
				>
					@icon.Upload(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "Upload Document") }
				</button>
			</div>
			<!-- Documents Table -->
			<div x-show="!docsLoading && filteredDocuments.length > 0" x-cloak class="border rounded-lg overflow-hidden shadow-sm">
				<table class="w-full caption-bottom text-sm text-left">
					<thead class="bg-muted/50 sticky top-0 z-10">
						<tr class="border-b hover:bg-transparent">
							<th class="h-10 px-3 align-middle w-10">
								<input
									type="checkbox"
									class="rounded border-input text-primary focus:ring-primary size-3.5"
									@change="toggleSelectAllDocs($event.target.checked)"
									:checked="selectedDocs.length > 0 && selectedDocs.length === filteredDocuments.filter(d => isTerminalStatus(d.status)).length"
								/>
							</th>
							<th class="h-10 px-3 align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Title") }</th>
							<th class="h-10 px-3 align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Status") }</th>
							<th class="h-10 px-3 align-middle font-medium text-muted-foreground text-center">{ i18n.T(ctx, "Entities") }</th>
							<th class="h-10 px-3 align-middle font-medium text-muted-foreground text-center">{ i18n.T(ctx, "Cost") }</th>
							<th class="h-10 px-3 align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Created") }</th>
							<th class="h-10 px-3 align-middle font-medium text-muted-foreground w-25"></th>
						</tr>
					</thead>
					<tbody class="[&_tr:last-child]:border-0">
						<template x-for="(doc, index) in filteredDocuments" :key="doc.id">
							@DocumentTableRow()
						</template>
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<!-- Pagination Footer -->
	<div x-show="filteredDocuments.length > 0" x-cloak class="shrink-0 px-4 py-3 border-t bg-background">
		<p
			x-show="docSearch || docStatusFilter"
			class="text-xs text-muted-foreground mb-2 text-center"
		>
			Showing <span x-text="filteredDocuments.length"></span> of <span x-text="totalCount"></span> documents
			<span x-show="docStatusFilter" x-text="'(' + docStatusFilter + ')'"></span>
			<span x-show="docSearch">matching "<span x-text="docSearch"></span>"</span>
		</p>
		@PaginationControls()
	</div>
}
