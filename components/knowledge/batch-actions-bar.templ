package knowledge

/**
 * BatchActionsBar - Contextual actions for selected documents.
 * Matches EdgeQuake edgequake_webui/src/components/documents/batch-actions-bar.tsx
 *
 * Shows: Selected count, Reprocess Selected, Delete Selected, Clear Selection.
 * Appears only when one or more documents are selected.
 */

import (
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/separator"
)

templ BatchActionsBar() {
	<div
		x-show="selectedDocs.length > 0"
		x-cloak
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
		class="flex items-center gap-3 rounded-lg border bg-primary/5 border-primary/20 px-4 py-2.5"
	>
		<!-- Selection count -->
		<div class="flex items-center gap-2 text-sm font-medium">
			@icon.SquareCheck(icon.Props{Class: "size-4 text-primary"})
			<span x-text="selectedDocs.length + ' selected'"></span>
		</div>
		@separator.Separator(separator.Props{
			Orientation: separator.OrientationVertical,
			Class:       "h-6",
		})
		<!-- Reprocess Selected -->
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Size:    button.SizeSm,
			Attributes: templ.Attributes{
				"@click":    "bulkReprocessDocs()",
				":disabled": "selectedDocs.length === 0",
			},
		}) {
			@icon.RotateCcw(icon.Props{Class: "size-3.5 me-1.5"})
			{ i18n.T(ctx, "Reprocess") }
		}
		<!-- Delete Selected -->
		@button.Button(button.Props{
			Variant: button.VariantDestructive,
			Size:    button.SizeSm,
			Attributes: templ.Attributes{
				"@click":    "bulkDeleteDocs()",
				":disabled": "selectedDocs.length === 0",
			},
		}) {
			@icon.Trash2(icon.Props{Class: "size-3.5 me-1.5"})
			{ i18n.T(ctx, "Delete") }
		}
		<div class="flex-1"></div>
		<!-- Clear Selection -->
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Attributes: templ.Attributes{
				"@click": "selectedDocs = []",
			},
		}) {
			@icon.X(icon.Props{Class: "size-3.5 me-1.5"})
			{ i18n.T(ctx, "Clear") }
		}
	</div>
}
