package knowledge

import "school-with-ai/components/icon"

type MarkdownViewerProps struct {
	Content     string // x-text binding string, e.g. "previewContent"
	Height      string // e.g. "400px"
	ShowToolbar bool
	Title       string
}

templ MarkdownViewer(props MarkdownViewerProps) {
	<div
		x-data="{ 
			copied: false,
			async copyContent() {
				const content = this.$root.getAttribute('data-content');
				if (!content) return;
				try {
					await navigator.clipboard.writeText(content);
					this.copied = true;
					setTimeout(() => this.copied = false, 2000);
				} catch (err) {
					console.error('Failed to copy document content:', err);
				}
			}
		}"
		:data-content={ props.Content }
		class="flex flex-col rounded-lg border bg-background overflow-hidden"
	>
		<!-- Toolbar -->
		if props.ShowToolbar {
			<div class="flex items-center justify-between gap-2 p-2 border-b bg-muted/30">
				<div class="flex items-center gap-2">
					@icon.FileText(icon.Props{Class: "size-3.5 text-muted-foreground"})
					<span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">{ props.Title }</span>
				</div>
				<button
					@click="copyContent()"
					class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[10px] font-medium transition-all hover:bg-muted"
					:class="copied ? 'text-green-600' : 'text-muted-foreground hover:text-foreground'"
				>
					<template x-if="!copied">
						@icon.Copy(icon.Props{Class: "size-3"})
					</template>
					<template x-if="copied">
						@icon.Check(icon.Props{Class: "size-3"})
					</template>
					<span x-text="copied ? 'Copied' : 'Copy'"></span>
				</button>
			</div>
		}
		<!-- Content -->
		<div
			class="flex-1 overflow-y-auto p-4 md:p-6 bg-background custom-scrollbar"
			style={ "min-height: " + props.Height + ";" }
		>
			<!-- Empty state -->
			<div
				x-show={ "!" + props.Content }
				class="flex flex-col items-center justify-center py-12 text-center"
			>
				@icon.FileText(icon.Props{Class: "size-8 text-muted-foreground/50 mb-3"})
				<p class="text-sm text-muted-foreground">No content available</p>
			</div>
			<div
				x-show={ props.Content }
				class="prose prose-sm dark:prose-invert max-w-none prose-headings:scroll-mt-4 prose-pre:bg-muted/50 prose-code:before:content-none prose-code:after:content-none prose-table:text-sm"
				x-html={ "marked.parse(" + props.Content + " || '')" }
			></div>
		</div>
	</div>
}
