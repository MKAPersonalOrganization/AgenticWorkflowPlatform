package knowledge

/**
 * PipelineStatusSummary - Pipeline status indicator and metrics.
 * Matches EdgeQuake edgequake_webui/src/components/pipeline/ components.
 *
 * Shows: Stage breakdown (pending, processing, completed, failed counts),
 * queue metrics, processing rate, estimated completion time.
 * Expandable via a collapsible card.
 */

import (
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ PipelineStatusSummary() {
	<!-- Compact summary bar - always visible when pipeline has activity -->
	<div
		x-show="pipelineStatus && ((pipelineStatus.pending || 0) > 0 || (pipelineStatus.processing || 0) > 0)"
		x-cloak
		class="rounded-lg border bg-card"
	>
		<!-- Header row -->
		<div class="flex items-center justify-between px-4 py-3">
			<!-- Left side: clickable to expand -->
			<button
				@click="pipelineExpanded = !pipelineExpanded"
				class="flex items-center gap-3 hover:bg-muted/50 transition-colors rounded-md px-2 py-1 -ms-2"
			>
				<!-- Animated processing indicator -->
				<div class="relative flex items-center justify-center" x-show="!pipelineStatus?.cancellation_requested">
					<div class="h-2.5 w-2.5 rounded-full bg-blue-500 animate-pulse"></div>
					<div class="absolute h-5 w-5 rounded-full border-2 border-blue-500/30 animate-ping"></div>
				</div>
				<!-- Cancelling indicator -->
				<div class="relative flex items-center justify-center" x-show="pipelineStatus?.cancellation_requested" x-cloak>
					<div class="h-2.5 w-2.5 rounded-full bg-orange-500 animate-pulse"></div>
				</div>
				<span class="text-sm font-medium" x-show="!pipelineStatus?.cancellation_requested">{ i18n.T(ctx, "Pipeline Active") }</span>
				<span class="text-sm font-medium text-orange-600 dark:text-orange-400" x-show="pipelineStatus?.cancellation_requested" x-cloak>{ i18n.T(ctx, "Cancelling...") }</span>
				<!-- Quick stage counts -->
				<div class="flex items-center gap-2 text-xs text-muted-foreground">
					<span class="flex items-center gap-1" x-show="pipelineStatus?.pending > 0">
						@icon.Clock(icon.Props{Class: "size-3"})
						<span x-text="pipelineStatus?.pending"></span>
					</span>
					<span class="flex items-center gap-1 text-blue-500" x-show="pipelineStatus?.processing > 0">
						@icon.LoaderCircle(icon.Props{Class: "size-3 animate-spin"})
						<span x-text="pipelineStatus?.processing"></span>
					</span>
					<span class="flex items-center gap-1 text-green-500" x-show="pipelineStatus?.completed > 0">
						@icon.CircleCheck(icon.Props{Class: "size-3"})
						<span x-text="pipelineStatus?.completed"></span>
					</span>
					<span class="flex items-center gap-1 text-destructive" x-show="pipelineStatus?.failed > 0">
						@icon.CircleX(icon.Props{Class: "size-3"})
						<span x-text="pipelineStatus?.failed"></span>
					</span>
				</div>
				<!-- Expand chevron -->
				<div :class="pipelineExpanded ? 'rotate-180' : ''" class="transition-transform duration-200">
					@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
				</div>
			</button>
			<!-- Cancel Pipeline button -->
			<button
				@click.stop="cancelPipeline()"
				:disabled="pipelineCancelling || pipelineStatus?.cancellation_requested"
				class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border transition-colors
					bg-destructive/10 text-destructive border-destructive/20
					hover:bg-destructive/20 hover:border-destructive/40
					disabled:opacity-50 disabled:cursor-not-allowed"
			>
				<template x-if="pipelineCancelling">
					<span class="flex items-center gap-1.5">
						@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin"})
						<span>{ i18n.T(ctx, "Cancelling...") }</span>
					</span>
				</template>
				<template x-if="!pipelineCancelling && pipelineStatus?.cancellation_requested">
					<span class="flex items-center gap-1.5">
						@icon.Ban(icon.Props{Class: "size-3.5"})
						<span>{ i18n.T(ctx, "Cancelling...") }</span>
					</span>
				</template>
				<template x-if="!pipelineCancelling && !pipelineStatus?.cancellation_requested">
					<span class="flex items-center gap-1.5">
						@icon.CircleStop(icon.Props{Class: "size-3.5"})
						<span>{ i18n.T(ctx, "Cancel Pipeline") }</span>
					</span>
				</template>
			</button>
		</div>
		<!-- Expanded details -->
		<div x-show="pipelineExpanded" x-cloak x-transition class="border-t">
			<div class="px-4 py-3 space-y-3">
				<!-- Progress bar -->
				<div class="space-y-1">
					<div class="flex justify-between text-xs text-muted-foreground">
						<span>{ i18n.T(ctx, "Overall Progress") }</span>
						<span x-text="Math.round(((pipelineStatus?.completed || 0) / Math.max(1, (pipelineStatus?.pending || 0) + (pipelineStatus?.processing || 0) + (pipelineStatus?.completed || 0) + (pipelineStatus?.failed || 0))) * 100) + '%'"></span>
					</div>
					<div class="h-2 rounded-full bg-muted overflow-hidden">
						<div
							class="h-full rounded-full bg-primary transition-all duration-500"
							:style="'width: ' + Math.round(((pipelineStatus?.completed || 0) / Math.max(1, (pipelineStatus?.pending || 0) + (pipelineStatus?.processing || 0) + (pipelineStatus?.completed || 0) + (pipelineStatus?.failed || 0))) * 100) + '%'"
						></div>
					</div>
				</div>
				<!-- Stage cards grid -->
				<div class="grid grid-cols-4 gap-2">
					<div class="rounded-md border p-2 text-center">
						@icon.Clock(icon.Props{Class: "size-4 mx-auto mb-1 text-muted-foreground"})
						<p class="text-lg font-bold" x-text="pipelineStatus?.pending || 0"></p>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Pending") }</p>
					</div>
					<div class="rounded-md border border-blue-500/20 bg-blue-500/5 p-2 text-center">
						@icon.LoaderCircle(icon.Props{Class: "size-4 mx-auto mb-1 text-blue-500 animate-spin"})
						<p class="text-lg font-bold text-blue-600 dark:text-blue-400" x-text="pipelineStatus?.processing || 0"></p>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Processing") }</p>
					</div>
					<div class="rounded-md border border-green-500/20 bg-green-500/5 p-2 text-center">
						@icon.CircleCheck(icon.Props{Class: "size-4 mx-auto mb-1 text-green-500"})
						<p class="text-lg font-bold text-green-600 dark:text-green-400" x-text="pipelineStatus?.completed || 0"></p>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Completed") }</p>
					</div>
					<div class="rounded-md border border-red-500/20 bg-red-500/5 p-2 text-center">
						@icon.CircleX(icon.Props{Class: "size-4 mx-auto mb-1 text-destructive"})
						<p class="text-lg font-bold text-destructive" x-text="pipelineStatus?.failed || 0"></p>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Failed") }</p>
					</div>
				</div>
				<!-- Queue metrics (if available) -->
				<template x-if="queueMetrics">
					<div class="flex items-center gap-4 pt-1 text-xs text-muted-foreground">
						<div class="flex items-center gap-1" x-show="queueMetrics.processing_rate">
							@icon.Zap(icon.Props{Class: "size-3"})
							<span x-text="(queueMetrics.processing_rate || 0).toFixed(1) + ' docs/min'"></span>
						</div>
						<div class="flex items-center gap-1" x-show="queueMetrics.estimated_completion">
							@icon.Timer(icon.Props{Class: "size-3"})
							<span>{ i18n.T(ctx, "ETA") }:</span>
							<span x-text="formatDuration(queueMetrics.estimated_completion)"></span>
						</div>
					</div>
				</template>
			</div>
		</div>
	</div>
}
