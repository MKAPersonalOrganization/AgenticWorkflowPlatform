package knowledge

/**
 * StatusBadge - Status badge component for documents with icons and colors.
 * Matches EdgeQuake edgequake_webui/src/components/documents/status-badge.tsx
 *
 * Maps 18+ statuses (unified pipeline stages + legacy) to distinct icon/color configs.
 * For processing statuses, shows stage-specific styling with pulse animation.
 * Includes tooltip with stage progress for processing states (OODA-11).
 */

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/tooltip"
)

templ StatusBadge() {
	<!-- Rendered via Alpine.js - badge with icon + label, tooltip for processing states -->
	<template x-if="statusStageProgress(doc.current_stage || doc.status)">
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				@badge.Badge(badge.Props{
					Variant: badge.VariantOutline,
					Class:   "gap-1 border-current cursor-default",
					Attributes: templ.Attributes{
						":class":      "statusBadgeClass(doc.current_stage || doc.status)",
						"data-testid": "status-badge",
					},
				}) {
					<span x-html="statusIcon(doc.current_stage || doc.status)"></span>
					<span x-text="statusLabel(doc.current_stage || doc.status)"></span>
				}
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop}) {
				<div class="space-y-2 max-w-xs" data-testid="status-badge-tooltip">
					<!-- Stage progress header -->
					<div class="flex items-center justify-between gap-4">
						<span class="font-medium" x-text="statusLabel(doc.current_stage || doc.status)"></span>
						<span class="text-xs text-muted-foreground" x-text="'Step ' + statusStageProgress(doc.current_stage || doc.status).current + '/' + statusStageProgress(doc.current_stage || doc.status).total"></span>
					</div>
					<!-- Stage message or description -->
					<template x-if="doc.stage_message">
						<p class="text-xs font-medium text-foreground" x-text="doc.stage_message"></p>
					</template>
					<template x-if="!doc.stage_message">
						<p class="text-xs text-muted-foreground" x-text="statusStageProgress(doc.current_stage || doc.status).description"></p>
					</template>
					<!-- Progress percentage bar -->
					<template x-if="typeof doc.stage_progress === 'number'">
						<div class="space-y-1">
							<div class="flex justify-between text-[10px] text-muted-foreground">
								<span>Progress</span>
								<span x-text="Math.round(doc.stage_progress * 100) + '%'"></span>
							</div>
							<div class="h-2 bg-muted rounded-full overflow-hidden">
								<div class="h-full bg-primary transition-all duration-300" :style="'width: ' + (doc.stage_progress * 100) + '%'"></div>
							</div>
						</div>
					</template>
					<!-- Visual stage progress dots -->
					<div class="flex gap-1" x-html="statusStageDotsHtml(doc.current_stage || doc.status)"></div>
				</div>
			}
		}
	</template>
	<template x-if="!statusStageProgress(doc.current_stage || doc.status)">
		@badge.Badge(badge.Props{
			Variant: badge.VariantOutline,
			Class:   "gap-1 border-current cursor-default",
			Attributes: templ.Attributes{
				":class":      "statusBadgeClass(doc.current_stage || doc.status)",
				"data-testid": "status-badge",
			},
		}) {
			<span x-html="statusIcon(doc.current_stage || doc.status)"></span>
			<span x-text="statusLabel(doc.current_stage || doc.status)"></span>
		}
	</template>
}

// statusBadgeScript provides the JavaScript functions for status badge rendering.
// This matches the EdgeQuake StatusBadge component's statusConfig mapping.
templ StatusBadgeScript() {
	<script>
		// Status configuration matching EdgeQuake's statusConfig
		window._statusConfig = {
			// Unified stages (SPEC-002)
			uploading:    { textColor: 'text-blue-500 dark:text-blue-300', bg: 'bg-blue-400', label: 'Uploading', animate: true },
			converting:   { textColor: 'text-indigo-600 dark:text-indigo-400', bg: 'bg-indigo-500', label: 'Converting PDF', animate: true },
			preprocessing:{ textColor: 'text-blue-600 dark:text-blue-400', bg: 'bg-blue-500', label: 'Preprocessing', animate: true },
			chunking:     { textColor: 'text-blue-500 dark:text-blue-300', bg: 'bg-blue-400', label: 'Chunking', animate: true },
			extracting:   { textColor: 'text-purple-600 dark:text-purple-400', bg: 'bg-purple-500', label: 'Extracting', animate: true },
			gleaning:     { textColor: 'text-purple-500 dark:text-purple-300', bg: 'bg-purple-400', label: 'Gleaning', animate: true },
			merging:      { textColor: 'text-amber-600 dark:text-amber-400', bg: 'bg-amber-500', label: 'Merging', animate: true },
			summarizing:  { textColor: 'text-orange-600 dark:text-orange-400', bg: 'bg-orange-500', label: 'Summarizing', animate: true },
			embedding:    { textColor: 'text-cyan-600 dark:text-cyan-400', bg: 'bg-cyan-500', label: 'Embedding', animate: true },
			storing:      { textColor: 'text-teal-600 dark:text-teal-400', bg: 'bg-teal-500', label: 'Storing', animate: true },
			// Terminal states
			completed:      { textColor: 'text-green-600 dark:text-green-400', bg: 'bg-green-500', label: 'Completed', animate: false },
			failed:         { textColor: 'text-red-600 dark:text-red-400', bg: 'bg-red-500', label: 'Failed', animate: false },
			partial_failure:{ textColor: 'text-orange-600 dark:text-orange-400', bg: 'bg-orange-500', label: 'Partial Failure', animate: false },
			partial_success:{ textColor: 'text-amber-600 dark:text-amber-400', bg: 'bg-amber-500', label: 'Partial', animate: false },
			// Legacy
			pending:   { textColor: 'text-yellow-600 dark:text-yellow-400', bg: 'bg-yellow-500', label: 'Pending', animate: false },
			processing:{ textColor: 'text-blue-600 dark:text-blue-400', bg: 'bg-blue-500', label: 'Processing', animate: true },
			indexing:  { textColor: 'text-teal-600 dark:text-teal-400', bg: 'bg-teal-500', label: 'Indexing', animate: true },
			indexed:   { textColor: 'text-green-600 dark:text-green-400', bg: 'bg-green-500', label: 'Indexed', animate: false },
			cancelled: { textColor: 'text-orange-600 dark:text-orange-400', bg: 'bg-orange-500', label: 'Cancelled', animate: false },
		};

		// SPEC-002: Processing stages in order with descriptions
		window._processingStages = [
			{ key: 'uploading', label: 'Uploading', description: 'Uploading file to server' },
			{ key: 'converting', label: 'Converting', description: 'Converting PDF to Markdown' },
			{ key: 'preprocessing', label: 'Preprocessing', description: 'Validating and preparing document' },
			{ key: 'chunking', label: 'Chunking', description: 'Splitting document into chunks' },
			{ key: 'extracting', label: 'Extracting', description: 'Running LLM entity extraction' },
			{ key: 'gleaning', label: 'Gleaning', description: 'Second pass for missed entities' },
			{ key: 'merging', label: 'Merging', description: 'Merging into knowledge graph' },
			{ key: 'summarizing', label: 'Summarizing', description: 'Generating descriptions' },
			{ key: 'embedding', label: 'Embedding', description: 'Generating vector embeddings' },
			{ key: 'storing', label: 'Storing', description: 'Storing in graph & vector databases' },
		];

		// SVG icon markup for each status (h-3 w-3, matching Lucide icon style)
		window._statusIcons = {
			uploading:      '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>',
			converting:     '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>',
			preprocessing:  '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>',
			chunking:       '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/></svg>',
			extracting:     '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="10" ry="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
			gleaning:       '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
			merging:        '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>',
			summarizing:    '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>',
			embedding:      '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>',
			storing:        '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>',
			completed:      '<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>',
			failed:         '<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>',
			partial_failure:'<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>',
			partial_success:'<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>',
			pending:        '<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
			processing:     '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>',
			indexing:       '<svg class="h-3 w-3 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>',
			indexed:        '<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>',
			cancelled:      '<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 8 8 8"/></svg>',
		};

		function statusBadgeClass(status) {
			const config = window._statusConfig[status] || window._statusConfig.pending;
			return config.textColor + (config.animate ? ' animate-pulse' : '');
		}

		function statusLabel(status) {
			const config = window._statusConfig[status] || window._statusConfig.pending;
			return config.label;
		}

		function statusIcon(status) {
			return window._statusIcons[status] || window._statusIcons.pending;
		}

		// Get stage progress info for processing states (OODA-11)
		function statusStageProgress(status) {
			const idx = window._processingStages.findIndex(s => s.key === status);
			if (idx >= 0) {
				return { current: idx + 1, total: window._processingStages.length, description: window._processingStages[idx].description };
			}
			if (status === 'processing') {
				return { current: 1, total: window._processingStages.length, description: 'Starting processing...' };
			}
			return null;
		}

		// Generate stage dots HTML for tooltip
		function statusStageDotsHtml(status) {
			const progress = statusStageProgress(status);
			if (!progress) return '';
			return window._processingStages.map((stage, i) =>
				'<div class="h-1 flex-1 rounded-full ' + (i < progress.current ? 'bg-primary' : 'bg-muted') + '" title="' + stage.label + '"></div>'
			).join('');
		}

		function isProcessingStatus(status) {
			return ['processing', 'chunking', 'extracting', 'embedding', 'indexing', 'uploading', 'converting', 'preprocessing', 'gleaning', 'merging', 'summarizing', 'storing'].includes(status);
		}

		function isTerminalStatus(status) {
			return ['completed', 'indexed', 'failed', 'partial_failure', 'partial_success', 'cancelled'].includes(status);
		}

		function normalizeStatus(status) {
			if (!status) return 'pending';
			const normalized = status.toLowerCase();
			if (window._statusConfig[normalized]) return normalized;
			if (normalized.includes('process')) return 'processing';
			return 'pending';
		}

		function getDocumentDisplayStatus(doc) {
			if (doc.current_stage) return normalizeStatus(doc.current_stage);
			return normalizeStatus(doc.status);
		}
	</script>
}
