package knowledge

/**
 * GraphLegend - Entity type + relationship type legend with visibility toggles.
 * Matches EdgeQuake entity and relationship type filters.
 *
 * Positioned absolute bottom of graph container.
 * Shows color-coded entity type pills and relationship type pills.
 */

import (
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ GraphLegend() {
	<div x-data="{ expanded: false }" class="absolute bottom-4 left-4 z-20">
		<!-- Legend button (when collapsed) -->
		<template x-if="!expanded">
			<button
				@click="expanded = true"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-all duration-200 bg-background/95 backdrop-blur-sm shadow-lg border border-border/50 hover:bg-accent hover:border-primary/30 hover:shadow-xl h-10 w-10"
				title="Show Legend"
			>
				@icon.Palette(icon.Props{Class: "size-4"})
			</button>
		</template>
		<!-- Legend Card (when expanded) -->
		<div
			x-show="expanded"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			class="w-64 shadow-xl bg-background/95 backdrop-blur-sm border rounded-lg overflow-hidden flex flex-col max-h-[400px]"
			x-cloak
		>
			<!-- Header -->
			<div class="py-2 px-3 border-b flex items-center justify-between shrink-0">
				<div class="text-xs font-semibold flex items-center gap-1.5">
					@icon.Palette(icon.Props{Class: "size-3.5 text-muted-foreground"})
					{ i18n.T(ctx, "Entity Types") }
				</div>
				<button
					@click="expanded = false"
					class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-6 w-6"
				>
					@icon.EyeOff(icon.Props{Class: "size-3.5 text-muted-foreground"})
				</button>
			</div>
			<!-- List content -->
			<div class="flex-1 overflow-y-auto p-1.5 space-y-0.5 custom-scrollbar min-h-0">
				<template x-for="stat in graphGetTypeStats()" :key="stat.type">
					<button
						@click="toggleEntityType(stat.type)"
						class="w-full flex items-center gap-2.5 px-2.5 py-2 rounded-md transition-all hover:bg-muted/70 active:bg-muted focus:outline-none text-xs text-left group"
						:class="graphVisibleTypes.includes(stat.type) ? 'opacity-100' : 'opacity-40'"
					>
						<div
							class="w-3 h-3 rounded-full shrink-0 ring-1 ring-black/5 shadow-sm"
							:style="{ backgroundColor: stat.color }"
						></div>
						<span class="flex-1 font-medium leading-tight truncate min-w-0" x-text="stat.label"></span>
						<span class="inline-flex items-center justify-center bg-muted/80 px-1.5 py-0.5 rounded text-[10px] font-semibold tabular-nums text-muted-foreground group-hover:text-foreground" x-text="stat.count"></span>
						<template x-if="graphVisibleTypes.includes(stat.type)">
							@icon.Eye(icon.Props{Class: "size-3.5 text-primary/70 shrink-0"})
						</template>
						<template x-if="!graphVisibleTypes.includes(stat.type)">
							@icon.EyeOff(icon.Props{Class: "size-3.5 text-muted-foreground shrink-0"})
						</template>
					</button>
				</template>
			</div>
			<!-- Footer / Show All -->
			<template x-if="graphData?.nodes?.some(n => !graphVisibleTypes.includes(n.node_type || 'UNKNOWN'))">
				<div class="p-2 pt-0 shrink-0">
					<button
						@click="showAllEntityTypes()"
						class="w-full h-8 inline-flex items-center justify-center rounded-md border border-input bg-background px-3 py-1 text-[11px] font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
					>
						Show All
					</button>
				</div>
			</template>
		</div>
	</div>
}
