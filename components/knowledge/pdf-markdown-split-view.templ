package knowledge

import (
	"fmt"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

type PDFMarkdownSplitViewProps struct {
	PDFURL   string
	Markdown string // JS expression for markdown content
	Height   int
}

templ PDFMarkdownSplitView(props PDFMarkdownSplitViewProps) {
	<div
		x-data="{ viewMode: 'split' }"
		class="flex flex-col border rounded-lg bg-background overflow-hidden"
	>
		<!-- View Mode Toolbar -->
		<div class="flex items-center justify-between gap-2 p-2 border-b bg-muted/30 shrink-0">
			<div class="flex items-center gap-1">
				<span class="text-[11px] font-medium text-muted-foreground mr-2 tabular-nums uppercase tracking-wider">
					{ i18n.T(ctx, "View:") }
				</span>
				
				<button
					@click="viewMode = 'pdf'"
					class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium transition-all"
					:class="viewMode === 'pdf' ? 'bg-primary text-primary-foreground shadow-sm' : 'hover:bg-muted text-muted-foreground'"
				>
					@icon.FileType(icon.Props{Class: "size-3.5"})
					<span>PDF</span>
				</button>

				<button
					@click="viewMode = 'split'"
					class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium transition-all"
					:class="viewMode === 'split' ? 'bg-primary text-primary-foreground shadow-sm' : 'hover:bg-muted text-muted-foreground'"
				>
					@icon.Columns2(icon.Props{Class: "size-3.5"})
					<span>{ i18n.T(ctx, "Split") }</span>
				</button>

				<button
					@click="viewMode = 'markdown'"
					class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium transition-all"
					:class="viewMode === 'markdown' ? 'bg-primary text-primary-foreground shadow-sm' : 'hover:bg-muted text-muted-foreground'"
				>
					@icon.FileText(icon.Props{Class: "size-3.5"})
					<span>{ i18n.T(ctx, "Markdown") }</span>
				</button>
			</div>
		</div>

		<div
			class="flex-1 overflow-hidden"
			:class="viewMode === 'split' ? 'flex flex-col lg:flex-row' : 'flex'"
			style={ fmt.Sprintf("height: %dpx;", props.Height) }
		>
			<!-- PDF Panel -->
			<div
				x-show="viewMode === 'pdf' || viewMode === 'split'"
				class="overflow-hidden bg-muted/5 transition-all duration-300"
				:class="viewMode === 'split' ? 'h-1/2 lg:h-full lg:w-1/2 lg:border-r' : 'w-full h-full'"
			>
				@PDFViewer(PDFViewerProps{
					URL:    props.PDFURL,
					Height: props.Height,
				})
			</div>

			<!-- Markdown Panel -->
			<div
				x-show="viewMode === 'markdown' || viewMode === 'split'"
				class="overflow-hidden transition-all duration-300"
				:class="viewMode === 'split' ? 'h-1/2 lg:h-full lg:w-1/2 overflow-y-auto' : 'w-full h-full'"
			>
				@MarkdownViewer(MarkdownViewerProps{
					Content:     props.Markdown,
					Height:      fmt.Sprintf("%dpx", props.Height),
					ShowToolbar: true,
					Title:       "Extracted Markdown",
				})
			</div>
		</div>
	</div>
}
