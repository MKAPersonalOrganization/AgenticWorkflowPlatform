package knowledge

import (
	"fmt"
	"aicompass/components/button"
	"aicompass/components/i18n"
	"aicompass/components/icon"
)

type PDFMarkdownSplitViewProps struct {
	PDFURL   string
	Markdown string // JS expression for markdown content
	Height   int
}

templ PDFMarkdownSplitView(props PDFMarkdownSplitViewProps) {
	<div
		x-data="{ viewMode: 'split' }"
		class="flex flex-col border rounded-lg bg-background overflow-hidden"
	>
		<!-- View Mode Toolbar -->
		<div class="flex items-center justify-between gap-2 p-2 border-b bg-muted/30 shrink-0">
			<div class="flex items-center gap-1">
				<span class="text-sm font-medium text-muted-foreground me-2">
					{ i18n.T(ctx, "View:") }
				</span>
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "h-8",
					Attributes: templ.Attributes{
						"@click": "viewMode = 'pdf'",
						":class": "viewMode === 'pdf' ? '' : 'bg-transparent shadow-none hover:bg-accent hover:text-accent-foreground'",
					},
				}) {
					@icon.FileType(icon.Props{Class: "size-4 me-1.5"})
					<span class="hidden sm:inline">PDF</span>
				}
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "h-8",
					Attributes: templ.Attributes{
						"@click": "viewMode = 'split'",
						":class": "viewMode === 'split' ? '' : 'bg-transparent shadow-none hover:bg-accent hover:text-accent-foreground'",
					},
				}) {
					@icon.Columns2(icon.Props{Class: "size-4 me-1.5"})
					<span class="hidden sm:inline">{ i18n.T(ctx, "Split") }</span>
				}
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "h-8",
					Attributes: templ.Attributes{
						"@click": "viewMode = 'markdown'",
						":class": "viewMode === 'markdown' ? '' : 'bg-transparent shadow-none hover:bg-accent hover:text-accent-foreground'",
					},
				}) {
					@icon.FileText(icon.Props{Class: "size-4 me-1.5"})
					<span class="hidden sm:inline">{ i18n.T(ctx, "Markdown") }</span>
				}
			</div>
		</div>
		<div
			class="flex-1 overflow-hidden"
			:class="viewMode === 'split' ? 'flex flex-col lg:grid lg:grid-cols-2' : 'flex'"
			style={ fmt.Sprintf("height: %dpx;", props.Height) }
		>
			<!-- PDF Panel -->
			<div
				x-show="viewMode === 'pdf' || viewMode === 'split'"
				class="overflow-hidden bg-muted/5 transition-all duration-300"
				:class="viewMode === 'split' ? 'h-1/2 lg:h-full lg:border-e border-border' : 'w-full h-full'"
			>
				@PDFViewer(PDFViewerProps{
					URL:    props.PDFURL,
					Height: props.Height,
				})
			</div>
			<!-- Markdown Panel -->
			<div
				x-show="viewMode === 'markdown' || viewMode === 'split'"
				class="overflow-hidden transition-all duration-300"
				:class="viewMode === 'split' ? 'h-1/2 lg:h-full overflow-y-auto' : 'w-full h-full'"
			>
				@MarkdownViewer(MarkdownViewerProps{
					Content:     props.Markdown,
					Height:      fmt.Sprintf("%dpx", props.Height),
					ShowToolbar: true,
					Title:       "Extracted Markdown",
				})
			</div>
		</div>
	</div>
}
