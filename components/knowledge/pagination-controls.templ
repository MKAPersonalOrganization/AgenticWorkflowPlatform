package knowledge

/**
 * PaginationControls - Page navigation for document table.
 * Matches EdgeQuake edgequake_webui/src/components/documents/pagination-controls.tsx
 *
 * Shows: Page size selector, page info, First/Prev/Next/Last buttons.
 */

import (
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ PaginationControls() {
	<div class="flex items-center justify-between border-t px-4 py-3 bg-muted/30" x-show="filteredDocuments.length > 0">
		<!-- Left: Page size selector -->
		<div class="flex items-center gap-2">
			<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "Rows per page") }</span>
			<select
				x-model.number="docPageSize"
				@change="docPage = 1"
				class="h-8 w-16 rounded-md border bg-background px-2 text-xs focus:outline-none focus:ring-2 focus:ring-ring"
			>
				<option value="10">10</option>
				<option value="25">25</option>
				<option value="50">50</option>
				<option value="100">100</option>
			</select>
		</div>
		<!-- Center: Page info -->
		<div class="text-xs text-muted-foreground">
			<span x-text="'Page ' + docPage + ' of ' + docTotalPages + ' (' + filteredDocuments.length + ' items)'"></span>
		</div>
		<!-- Right: Navigation buttons -->
		<div class="flex items-center gap-1">
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Class:   "h-8 w-8",
				Attributes: templ.Attributes{
					"@click":    "docPage = 1",
					":disabled": "docPage <= 1",
				},
			}) {
				@icon.ChevronsLeft(icon.Props{Class: "size-4"})
			}
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Class:   "h-8 w-8",
				Attributes: templ.Attributes{
					"@click":    "docPage = Math.max(1, docPage - 1)",
					":disabled": "docPage <= 1",
				},
			}) {
				@icon.ChevronLeft(icon.Props{Class: "size-4"})
			}
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Class:   "h-8 w-8",
				Attributes: templ.Attributes{
					"@click":    "docPage = Math.min(docTotalPages, docPage + 1)",
					":disabled": "docPage >= docTotalPages",
				},
			}) {
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			}
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Class:   "h-8 w-8",
				Attributes: templ.Attributes{
					"@click":    "docPage = docTotalPages",
					":disabled": "docPage >= docTotalPages",
				},
			}) {
				@icon.ChevronsRight(icon.Props{Class: "size-4"})
			}
		</div>
	</div>
}
