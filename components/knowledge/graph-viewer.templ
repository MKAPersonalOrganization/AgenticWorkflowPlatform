package knowledge

/**
 * GraphViewer - Main graph container with all overlays.
 * Matches EdgeQuake edgequake_webui/src/components/graph/graph-viewer.tsx
 *
 * Contains: Sigma.js WebGL container, overlays (zoom, controls, legend, minimap, context menu),
 * loading state, empty state, and the node details side panel.
 */

import (
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ GraphViewer() {
	<div class="flex flex-col h-full overflow-hidden">
		<!-- Graph Toolbar -->
		@GraphToolbar()
		<!-- Main Content Area -->
		<div class="flex-1 relative overflow-hidden bg-background text-foreground" data-graph-container>
			<!-- Loading state overlays -->
			<div x-show="graphLoading" class="absolute inset-0 z-50 flex items-center justify-center bg-background/50 backdrop-blur-sm">
				@GraphLoadingOverlay()
			</div>
			<!-- Empty state -->
			<div x-show="!graphLoading && (!graphData || !graphData.nodes || graphData.nodes.length === 0)" x-cloak class="absolute inset-0 flex items-center justify-center">
				<div class="text-center max-w-md px-4">
					<div class="bg-background p-6 rounded-full shadow-lg border mb-6 inline-block">
						@icon.Network(icon.Props{Class: "size-12 text-muted-foreground opacity-50"})
					</div>
					<h3 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "No knowledge graph yet") }</h3>
					<p class="text-sm text-muted-foreground mt-2 mb-6">
						{ i18n.T(ctx, "Your knowledge graph is empty. Upload documents to automatically extract entities and relationships.") }
					</p>
					<button
						@click="window.location.href = '/documents'"
						class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
					>
						@icon.Upload(icon.Props{Class: "size-4 mr-2"})
						{ i18n.T(ctx, "Upload Documents") }
					</button>
				</div>
			</div>
			<!-- Graph Area (Nodes > 0) -->
			<div x-show="!graphLoading && graphData && graphData.nodes && graphData.nodes.length > 0" x-cloak class="flex h-full overflow-hidden">
				@EntityBrowserPanel()
				<!-- Sigma.js WebGL Graph Container -->
				<div class="flex-1 relative overflow-hidden" id="graph-container">
					<div id="sigma-container" class="w-full h-full" style="display: block; position: relative; min-height: 400px;"></div>
					<!-- Overlays -->
					<div class="absolute inset-0 pointer-events-none z-20">
						<div class="pointer-events-auto">
							@ZoomControls()
							@GraphControls()
							@GraphLegend()
							@GraphMinimap()
						</div>
					</div>
					<!-- Truncation banner -->
					<div class="absolute top-4 left-1/2 -translate-x-1/2 z-30">
						@TruncationBanner()
					</div>
				</div>
				<!-- Right Side Panel - Node Details -->
				@NodeDetails()
			</div>
		</div>
	</div>
}

templ GraphToolbar() {
	<header class="flex items-center justify-between border-b px-4 py-2 shrink-0 bg-card/50 backdrop-blur-sm">
		<div class="flex items-center gap-2.5">
			<h2 class="text-base font-semibold tracking-tight">{ i18n.T(ctx, "Knowledge Graph") }</h2>
			<!-- Loading pulse -->
			<div x-show="graphLoading" class="size-2 rounded-full bg-primary animate-pulse"></div>
			<!-- Node/Edge counts -->
			<div x-show="graphData" x-cloak class="flex items-center gap-1.5 text-[11px] text-muted-foreground bg-muted/50 px-2 py-0.5 rounded-md border border-border/30">
				<span x-text="(graphData?.nodes?.length || 0).toLocaleString() + ' nodes'"></span>
				<span class="opacity-30">•</span>
				<span x-text="(graphData?.edges?.length || 0).toLocaleString() + ' edges'"></span>
			</div>
		</div>
		<div class="flex items-center gap-1.5">
			@GraphSearch()
			@TruncationIndicator()
			<div class="w-px h-5 bg-border mx-1"></div>
			<!-- Layout Selector -->
			<div class="relative group">
				<div class="absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground group-hover:text-primary transition-colors">
					@icon.GitBranch(icon.Props{Class: "size-3"})
				</div>
				<select
					class="h-8 rounded-md border border-input bg-background pl-8 pr-8 text-[11px] font-medium shadow-sm transition-all hover:bg-accent hover:border-primary/30 focus:outline-none focus:ring-1 focus:ring-ring appearance-none min-w-[120px]"
					x-model="graphLayout"
					@change="applyLayout()"
				>
					<option value="force-atlas">Force Atlas (FA2)</option>
					<option value="force-directed">Force-Directed</option>
					<option value="circular">Circular</option>
					<option value="circlepack">Circle Pack</option>
					<option value="random">Random</option>
					<option value="noverlap">No Overlap</option>
					<option value="hierarchical">Hierarchical</option>
				</select>
				<div class="absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground opacity-50">
					@icon.ChevronDown(icon.Props{Class: "size-3"})
				</div>
			</div>
			<div class="w-px h-5 bg-border mx-1"></div>
			<!-- New Advanced Settings Panel -->
			@GraphSettingsPanel()
			<div class="w-px h-5 bg-border mx-1"></div>
			<!-- Help Button -->
			<button
				@click="$dispatch('open-dialog', 'graph-shortcuts-help')"
				class="flex items-center justify-center h-8 w-8 rounded-md border bg-background hover:bg-accent hover:text-accent-foreground transition-all duration-200"
				title={ i18n.T(ctx, "Show keyboard shortcuts") }
			>
				@icon.Info(icon.Props{Class: "size-4"})
			</button>
			<!-- Keyboard Shortcuts Dialog -->
			@KeyboardShortcutsHelp()
			<!-- Toolbar Buttons -->
			<div class="flex items-center bg-muted/30 rounded-md p-0.5 border">
				<button
					@click="graphExportPNG()"
					class="inline-flex items-center justify-center rounded-sm text-sm font-medium transition-colors hover:bg-background hover:shadow-sm h-7 w-7"
					title="Export PNG"
				>
					@icon.Image(icon.Props{Class: "size-3.5"})
				</button>
				<button
					@click="graphExportJSON()"
					class="inline-flex items-center justify-center rounded-sm text-sm font-medium transition-colors hover:bg-background hover:shadow-sm h-7 w-7"
					title="Export JSON"
				>
					@icon.Download(icon.Props{Class: "size-3.5"})
				</button>
				<div class="w-px h-4 bg-border mx-0.5"></div>
				<button
					@click="loadGraph()"
					class="inline-flex items-center justify-center rounded-sm text-sm font-medium transition-colors hover:bg-background hover:shadow-sm h-7 w-7"
					:class="{ 'animate-spin': graphLoading }"
					title="Reload Graph"
				>
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
				</button>
			</div>
		</div>
	</header>
}

templ GraphLoadingOverlay() {
	<div class="flex flex-col items-center gap-3">
		<span class="animate-spin size-8 border-2 border-primary border-t-transparent rounded-full"></span>
		<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "Loading knowledge graph...") }</p>
	</div>
}
