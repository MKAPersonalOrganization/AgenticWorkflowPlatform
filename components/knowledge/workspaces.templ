package knowledge

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
	"school-with-ai/components/separator"
	"school-with-ai/domain"
)

type WorkspacesPageProps struct {
	User *domain.User
}

templ WorkspacesPage(props WorkspacesPageProps) {
	@knowledgeLayout(knowledgeLayoutProps{
		Title: "Workspaces",
		User:  props.User,
	}) {
		@workspacesScript()
		<div
			class="flex-1 overflow-y-auto p-6 md:p-8 space-y-8 max-w-7xl mx-auto"
			x-data="workspacesOverview"
		>
			<!-- Header -->
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-3xl font-bold tracking-tight">{ i18n.T(ctx, "Workspaces") }</h1>
					<p class="text-muted-foreground mt-2 text-lg">{ i18n.T(ctx, "Manage your knowledge bases. Each workspace is an isolated environment for your documents.") }</p>
				</div>
				<div>
					@dialog.Trigger(dialog.TriggerProps{For: "create-workspace-dialog"}) {
						@button.Button(button.Props{
							Size:  button.SizeLg,
							Class: "shadow-sm",
						}) {
							@icon.Plus(icon.Props{Class: "size-5 me-2"})
							{ i18n.T(ctx, "New Workspace") }
						}
					}
				</div>
			</div>
			<!-- Content -->
			<div>
				<!-- Loading State -->
				<div x-show="loading" class="flex items-center justify-center py-20">
					<span class="animate-spin size-8 border-2 border-primary border-t-transparent rounded-full"></span>
				</div>
				<!-- Empty State -->
				<div x-show="!loading && workspaces.length === 0" x-cloak class="flex flex-col items-center justify-center py-20 text-center border-2 border-dashed rounded-xl bg-muted/20">
					<div class="bg-background p-4 rounded-full shadow-sm mb-4">
						@icon.FolderOpen(icon.Props{Class: "size-10 text-muted-foreground"})
					</div>
					<h3 class="text-xl font-semibold">{ i18n.T(ctx, "No workspaces yet") }</h3>
					<p class="text-muted-foreground mt-2 max-w-md mx-auto">{ i18n.T(ctx, "Create your first workspace to start organizing and querying your documents.") }</p>
					<div class="mt-6">
						@dialog.Trigger(dialog.TriggerProps{For: "create-workspace-dialog"}) {
							@button.Button(button.Props{}) {
								@icon.Plus(icon.Props{Class: "size-4 me-2"})
								{ i18n.T(ctx, "Create Workspace") }
							}
						}
					</div>
				</div>
				<!-- Workspaces Grid -->
				<div x-show="!loading && workspaces.length > 0" x-cloak class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
					<template x-for="ws in workspaces" :key="ws.id">
						<div class="group relative flex flex-col justify-between rounded-xl border bg-card p-6 shadow-sm hover:shadow-md hover:border-primary/50 transition-all duration-200">
							<div>
								<div class="flex items-start justify-between mb-4">
									<div class="p-2 bg-primary/10 rounded-lg text-primary">
										@icon.Folder(icon.Props{Class: "size-6"})
									</div>
									<div class="relative" x-data="{ open: false }">
										<button @click="open = !open" @click.outside="open = false" class="text-muted-foreground hover:text-foreground p-1 rounded-md hover:bg-muted transition-colors">
											@icon.EllipsisVertical(icon.Props{Class: "size-4"})
										</button>
										<div x-show="open" x-cloak class="absolute right-0 top-6 z-10 w-48 rounded-md border bg-popover p-1 shadow-md">
											<button
												@click="deleteWorkspace(ws.id, ws.name); open = false"
												class="w-full text-left flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm text-destructive hover:bg-destructive/10 cursor-pointer"
											>
												@icon.Trash2(icon.Props{Class: "size-4"})
												{ i18n.T(ctx, "Delete") }
											</button>
										</div>
									</div>
								</div>
								<h3 class="font-semibold text-lg truncate" x-text="ws.name"></h3>
								<p class="text-sm text-muted-foreground mt-1 line-clamp-2 min-h-[2.5em]" x-text="ws.description || 'No description provided.'"></p>
								@separator.Separator(separator.Props{Class: "my-4"})
								<div class="grid grid-cols-2 gap-y-2 text-xs text-muted-foreground">
									<div class="flex items-center gap-1.5">
										@icon.Calendar(icon.Props{Class: "size-3.5"})
										<span x-text="formatDate(ws.created_at)"></span>
									</div>
									<div class="flex items-center gap-1.5 justify-end">
										@icon.Database(icon.Props{Class: "size-3.5"})
										<span x-text="ws.embedding_model"></span>
									</div>
								</div>
							</div>
							<div class="mt-6 pt-2">
								<a :href="`/knowledge/workspaces/${ws.id}`" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 w-full">
									{ i18n.T(ctx, "Open Workspace") }
									@icon.ArrowRight(icon.Props{Class: "size-4 ms-2"})
								</a>
							</div>
						</div>
					</template>
				</div>
			</div>
			<!-- Create Workspace Dialog -->
			@createWorkspaceDialogSimple()
		</div>
	}
}

templ createWorkspaceDialogSimple() {
	@dialog.Dialog(dialog.Props{ID: "create-workspace-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			<div x-data="createWsSimpleForm()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Create New Workspace") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Workspaces contain your documents and knowledge graph.") }
					}
				}
				<div class="space-y-4 py-4">
					<div>
						<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="ws-name">{ i18n.T(ctx, "Name") }</label>
						@input.Input(input.Props{
							ID:          "ws-name",
							Placeholder: i18n.T(ctx, "e.g., Engineering Handbook"),
							Class:       "mt-2",
							Attributes: templ.Attributes{
								"x-model":   "wsName",
								"autofocus": "autofocus",
							},
						})
					</div>
					<div>
						<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="ws-desc">{ i18n.T(ctx, "Description") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "Optional") })</span></label>
						@input.Input(input.Props{
							ID:          "ws-desc",
							Placeholder: i18n.T(ctx, "Optional description"),
							Class:       "mt-2",
							Attributes: templ.Attributes{
								"x-model": "wsDescription",
							},
						})
					</div>
					<div>
						<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="ws-slug">{ i18n.T(ctx, "Slug") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "Optional") })</span></label>
						@input.Input(input.Props{
							ID:          "ws-slug",
							Placeholder: i18n.T(ctx, "Optional URL-friendly identifier"),
							Class:       "mt-2",
							Attributes: templ.Attributes{
								"x-model": "wsSlug",
							},
						})
						<p class="text-[0.8rem] text-muted-foreground mt-1">{ i18n.T(ctx, "A unique identifier used in URLs. Will be auto-generated from name if left blank.") }</p>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="ws-llm">{ i18n.T(ctx, "LLM Model") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "Optional") })</span></label>
							<select
								id="ws-llm"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 mt-2"
								x-model="wsLlmFullId"
							>
								<option value="">{ i18n.T(ctx, "Server Default") }</option>
								<template x-for="model in llmModels" :key="model.provider + '/' + model.name">
									<option :value="model.provider + '/' + model.name" x-text="model.display_name + ' (' + model.provider + ')'"></option>
								</template>
							</select>
							<p class="text-[0.8rem] text-muted-foreground mt-1 flex items-center gap-1">
								@icon.Sparkles(icon.Props{Class: "size-3"})
								{ i18n.T(ctx, "Used for ingestion & extraction") }
							</p>
						</div>
						<div>
							<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="ws-embedding">{ i18n.T(ctx, "Embedding Model") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "Optional") })</span></label>
							<select
								id="ws-embedding"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 mt-2"
								x-model="wsEmbeddingFullId"
							>
								<option value="">{ i18n.T(ctx, "Server Default") }</option>
								<template x-for="model in embeddingModels" :key="model.provider + ':' + model.name">
									<option :value="model.provider + ':' + model.name" x-text="model.display_name + ' (' + model.provider + ', ' + model.dimension + 'd)'"></option>
								</template>
							</select>
							<p class="text-[0.8rem] text-muted-foreground mt-1">{ i18n.T(ctx, "Used for vector search.") }</p>
						</div>
					</div>
					<div x-show="createError" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="createError"></p>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "createWorkspace()",
							":disabled": "!wsName || creating",
						},
					}) {
						<span x-show="!creating">{ i18n.T(ctx, "Create Workspace") }</span>
						<span x-show="creating" class="flex items-center gap-2">
							<span class="animate-spin size-4 border-2 border-white border-t-transparent rounded-full"></span>
							{ i18n.T(ctx, "Creating...") }
						</span>
					}
				}
			</div>
		}
	}
}

templ workspacesScript() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('workspacesOverview', () => ({
				loading: true,
				workspaces: [],

				init() {
					this.loadWorkspaces();
					
					// Listen for workspace created event to refresh list
					window.addEventListener('workspace-created', () => {
						this.loadWorkspaces();
					});
				},

				async loadWorkspaces() {
					this.loading = true;
					try {
						const resp = await fetch('/api/knowledge/workspaces?page_size=100', {
							credentials: 'same-origin',
						});
						if (resp.ok) {
							const data = await resp.json();
							this.workspaces = data.items || [];
						}
					} catch (e) {
						console.error('Failed to load workspaces:', e);
					} finally {
						// Small delay to prevent flicker if it loads too fast
						setTimeout(() => { this.loading = false; }, 300);
					}
				},

				async deleteWorkspace(id, name) {
					if (!confirm(`Are you sure you want to delete workspace "${name}"? This action cannot be undone.`)) {
						return;
					}
					
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${id}`, {
							method: 'DELETE',
							headers: {
								'Content-Type': 'application/json',
							},
						});
						
						if (resp.ok) {
							this.loadWorkspaces();
						} else {
							alert('Failed to delete workspace');
						}
					} catch (e) {
						console.error('Failed to delete workspace:', e);
						alert('An error occurred while deleting the workspace');
					}
				},
				
				formatDate(dateString) {
					if (!dateString) return '';
					return new Date(dateString).toLocaleDateString(undefined, {
						year: 'numeric',
						month: 'short',
						day: 'numeric'
					});
				}
			}));

			Alpine.data('createWsSimpleForm', () => ({
				wsName: '',
				wsDescription: '',
				wsSlug: '',
				wsLlmFullId: '', // provider/model
				wsEmbeddingFullId: '', // provider:model
				
				// Model lists
				llmModels: [],
				embeddingModels: [],
				
				creating: false,
				createError: '',

				init() {
					this.fetchModels();
				},

				async fetchModels() {
					try {
						const [llmResp, embResp] = await Promise.all([
							fetch('/api/knowledge/models/llm'),
							fetch('/api/knowledge/models/embedding')
						]);
						
						if (llmResp.ok) {
							const data = await llmResp.json();
							// Flatten models from providers
							this.llmModels = data.models || [];
						}
						
						if (embResp.ok) {
							const data = await embResp.json();
							this.embeddingModels = data.models || [];
						}
					} catch (e) {
						console.error('Failed to load models:', e);
					}
				},

				async createWorkspace() {
					if (!this.wsName) return;
					
					this.creating = true;
					this.createError = '';
					
					// Parse LLM selection
					let llmModel = '';
					let llmProvider = '';
					if (this.wsLlmFullId) {
						const parts = this.wsLlmFullId.split('/');
						if (parts.length >= 2) {
							llmProvider = parts[0];
							llmModel = parts.slice(1).join('/');
						} else {
							// Fallback if no provider prefix
							llmModel = this.wsLlmFullId;
						}
					}

					// Parse Embedding selection
					let embeddingModel = '';
					let embeddingProvider = '';
					let embeddingDimension = 0;
					
					if (this.wsEmbeddingFullId) {
						// Format is provider:model
						const parts = this.wsEmbeddingFullId.split(':');
						if (parts.length >= 2) {
							embeddingProvider = parts[0];
							embeddingModel = parts.slice(1).join(':');
							
							// Find model to get dimension
							const modelInfo = this.embeddingModels.find(
								m => m.provider === embeddingProvider && m.name === embeddingModel
							);
							if (modelInfo) {
								embeddingDimension = modelInfo.dimension;
							}
						}
					}

					try {
						const resp = await fetch('/api/knowledge/workspaces', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({
								name: this.wsName,
								description: this.wsDescription,
								slug: this.wsSlug,
								llm_model: llmModel,
								llm_provider: llmProvider,
								embedding_model: embeddingModel,
								embedding_provider: embeddingProvider,
								embedding_dimension: embeddingDimension
							}),
						});
						
						if (resp.ok) {
							// Reset form
							this.wsName = '';
							this.wsDescription = '';
							this.wsSlug = '';
							this.wsLlmFullId = '';
							this.wsEmbeddingFullId = '';
							
							// Close dialog
							window.dispatchEvent(new CustomEvent('workspace-created'));
							this.$el.closest('[role="dialog"]')?.querySelector('[data-dialog-close]')?.click();
						} else {
							const data = await resp.json();
							this.createError = data.error || 'Failed to create workspace';
						}
					} catch (e) {
						this.createError = 'An unexpected error occurred';
						console.error(e);
					} finally {
						this.creating = false;
					}
				}
			}));
		});
	</script>
}
