package knowledge

/**
 * TruncationBanner - Visual feedback when graph data is truncated.
 * Matches EdgeQuake edgequake_webui/src/components/graph/truncation-banner.tsx
 *
 * Shows:
 * - Current visible node count
 * - Total node count in storage
 * - Percentage of data shown
 * - "Load More" action
 */

import "school-with-ai/components/icon"

templ TruncationBanner() {
	<div
		x-show="graphData && graphData.is_truncated"
		x-cloak
		class="bg-amber-500/90 dark:bg-amber-600/90 text-white px-4 py-2 rounded-full shadow-lg backdrop-blur-sm flex items-center gap-3 animate-in fade-in slide-in-from-bottom-4 duration-300"
	>
		@icon.TriangleAlert(icon.Props{Class: "size-4 shrink-0 shadow-sm"})
		
		<div class="flex items-center gap-2 text-sm font-medium">
			<span class="tabular-nums" x-text="(graphData?.nodes?.length || 0).toLocaleString()"></span>
			<span class="opacity-80">of</span>
			<span class="tabular-nums" x-text="(graphData?.total_nodes || 0).toLocaleString()"></span>
			<span class="opacity-80">nodes</span>
			<span class="text-xs opacity-70 ml-1" x-text="'(' + Math.round(((graphData?.nodes?.length || 0) / (graphData?.total_nodes || 1)) * 100) + '%)'"></span>
		</div>

		<button
			@click="graphMaxNodes = Math.min(graphMaxNodes * 2, 500); loadGraph()"
			class="h-6 inline-flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 px-3 text-xs font-semibold text-white transition-colors border shadow-sm border-white/20"
			:disabled="graphLoading"
		>
			<template x-if="!graphLoading">
				<span class="flex items-center gap-1">
					Load More
					@icon.ChevronRight(icon.Props{Class: "size-3"})
				</span>
			</template>
			<template x-if="graphLoading">
				@icon.Loader(icon.Props{Class: "size-3 animate-spin"})
			</template>
		</button>
	</div>
}

templ TruncationIndicator() {
	<div
		x-show="graphData && graphData.is_truncated"
		x-cloak
		class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 text-xs font-medium border border-amber-200/50 dark:border-amber-800/50"
	>
		@icon.Database(icon.Props{Class: "size-3"})
		<span class="tabular-nums">
			<span x-text="(graphData?.nodes?.length || 0).toLocaleString()"></span>
			/
			<span x-text="(graphData?.total_nodes || 0).toLocaleString()"></span>
		</span>
		<span class="opacity-70" x-text="'(' + Math.round(((graphData?.nodes?.length || 0) / (graphData?.total_nodes || 1)) * 100) + '%)'"></span>
	</div>
}
