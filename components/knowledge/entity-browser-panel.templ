package knowledge

import (
	"aicompass/components/badge"
	"aicompass/components/i18n"
	"aicompass/components/icon"
)

templ EntityBrowserPanel() {
	<!-- Persistent drawer container -->
	<aside
		class="flex flex-col border-e bg-card/95 backdrop-blur-sm shrink-0 overflow-hidden transition-all duration-300 relative group"
		:class="entityBrowserCollapsed ? 'w-10' : 'w-64'"
		aria-label="Entity browser"
		data-tour="entity-browser"
	>
		<!-- Collapsed state content -->
		<div
			x-show="entityBrowserCollapsed"
			class="flex flex-col items-center justify-start py-2 gap-1.5"
		>
			<button
				@click="entityBrowserCollapsed = false"
				class="h-7 w-7 inline-flex items-center justify-center rounded-md hover:bg-muted transition-colors"
				aria-label={ i18n.T(ctx, "Expand entity browser") }
			>
				@icon.ChevronRight(icon.Props{Class: "size-3.5"})
			</button>
			<div class="mt-3 flex flex-col items-center gap-1.5">
				@icon.Network(icon.Props{Class: "size-3.5 text-muted-foreground"})
				<span
					class="text-[10px] text-muted-foreground font-medium whitespace-nowrap"
					style="writing-mode: vertical-rl; text-orientation: mixed"
				>
					{ i18n.T(ctx, "Entities") }
				</span>
				@badge.Badge(badge.Props{
					Variant: badge.VariantSecondary,
					Class:   "text-[9px] h-4 px-1",
				}) {
					<span x-text="_graphNodes.length || 0"></span>
				}
			</div>
		</div>
		<!-- Expanded state content -->
		<div
			x-show="!entityBrowserCollapsed"
			class="flex flex-col h-full w-64"
			x-cloak
		>
			<!-- Header -->
			<div class="flex items-center justify-between px-3 py-2 border-b shrink-0 bg-muted/20">
				<div class="flex items-center gap-1.5">
					@icon.Network(icon.Props{Class: "size-3.5 text-muted-foreground"})
					<h2 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
						{ i18n.T(ctx, "Entities") }
					</h2>
					@badge.Badge(badge.Props{
						Variant: badge.VariantSecondary,
						Class:   "text-[9px] h-4 px-1.5",
					}) {
						<span x-text="sortedNodes.length"></span>
						<template x-if="sortedNodes.length !== _graphNodes.length">
							<span x-text="'/' + _graphNodes.length"></span>
						</template>
					}
				</div>
				<button
					@click="entityBrowserCollapsed = true"
					class="h-6 w-6 inline-flex items-center justify-center rounded-md hover:bg-muted transition-colors text-muted-foreground"
					aria-label={ i18n.T(ctx, "Collapse entity browser") }
				>
					@icon.ChevronLeft(icon.Props{Class: "size-3.5"})
				</button>
			</div>
			<!-- Search -->
			<div class="p-2 border-b shrink-0">
				<div class="relative">
					@icon.Search(icon.Props{Class: "absolute start-2 top-1/2 -translate-y-1/2 size-3 text-muted-foreground"})
					<input
						type="text"
						x-model="entityBrowserSearchQuery"
						placeholder={ i18n.T(ctx, "Search entities...") }
						class="w-full h-7 ps-7 pe-3 text-xs bg-muted/30 border-muted rounded-md border focus:bg-background focus:ring-1 focus:ring-ring transition-colors"
						aria-label={ i18n.T(ctx, "Search entities by name, type, or description") }
					/>
				</div>
			</div>
			<!-- Sort Controls -->
			<div class="flex items-center gap-0.5 px-2 py-1.5 border-b shrink-0" role="group" aria-label={ i18n.T(ctx, "Sort controls") }>
				<span class="text-[10px] text-muted-foreground me-1">
					{ i18n.T(ctx, "Sort:") }
				</span>
				<button
					@click="entityBrowserSortBy = 'name'"
					class="h-5 px-1.5 text-[10px] rounded transition-colors font-medium"
					:class="entityBrowserSortBy === 'name' ? 'bg-secondary text-secondary-foreground' : 'hover:bg-muted text-muted-foreground'"
					aria-pressed="entityBrowserSortBy === 'name'"
				>
					{ i18n.T(ctx, "Name") }
				</button>
				<button
					@click="entityBrowserSortBy = 'degree'"
					class="h-5 px-1.5 text-[10px] rounded transition-colors font-medium"
					:class="entityBrowserSortBy === 'degree' ? 'bg-secondary text-secondary-foreground' : 'hover:bg-muted text-muted-foreground'"
					aria-pressed="entityBrowserSortBy === 'degree'"
				>
					{ i18n.T(ctx, "Degree") }
				</button>
				<button
					@click="entityBrowserSortAsc = !entityBrowserSortAsc"
					class="h-5 w-5 ms-auto inline-flex items-center justify-center rounded hover:bg-muted text-muted-foreground transition-colors"
					:aria-label="entityBrowserSortAsc ? 'Sort ascending, click to sort descending' : 'Sort descending, click to sort ascending'"
				>
					<template x-if="entityBrowserSortAsc">
						@icon.ArrowUpNarrowWide(icon.Props{Class: "size-2.5"})
					</template>
					<template x-if="!entityBrowserSortAsc">
						@icon.ArrowDownWideNarrow(icon.Props{Class: "size-2.5"})
					</template>
				</button>
			</div>
			<!-- View Toggles -->
			<div class="flex items-center gap-0.5 p-1.5 border-b shrink-0" role="tablist" aria-label={ i18n.T(ctx, "View mode") }>
				<button
					@click="entityBrowserViewMode = 'grouped'"
					class="flex-1 h-6 text-[10px] font-medium rounded transition-all"
					:class="entityBrowserViewMode === 'grouped' ? 'bg-secondary text-secondary-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'"
					role="tab"
					:aria-selected="entityBrowserViewMode === 'grouped'"
				>
					{ i18n.T(ctx, "Grouped") }
				</button>
				<button
					@click="entityBrowserViewMode = 'list'"
					class="flex-1 h-6 text-[10px] font-medium rounded transition-all"
					:class="entityBrowserViewMode === 'list' ? 'bg-secondary text-secondary-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'"
					role="tab"
					:aria-selected="entityBrowserViewMode === 'list'"
				>
					{ i18n.T(ctx, "List") }
				</button>
			</div>
			<!-- List Content -->
			<div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar" role="tabpanel">
				<!-- Grouped View -->
				<template x-if="entityBrowserViewMode === 'grouped'">
					<div class="py-2 px-1.5 space-y-0.5">
						<template x-for="[type, nodes] in groupedNodes" :key="type">
							<div class="space-y-1">
								<button
									@click="$el.nextElementSibling.classList.toggle('hidden')"
									class="w-full flex items-center justify-between px-3 py-2 rounded-md hover:bg-muted/50 transition-colors"
								>
									<div class="flex items-center gap-2">
										<div class="w-3 h-3 rounded-full" :style="`background-color: ${entityColors[type] || '#94a3b8'}`"></div>
										<span class="text-sm font-medium" x-text="type"></span>
									</div>
									<div class="flex items-center gap-2">
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs"}) {
											<span x-text="nodes.length"></span>
										}
										@icon.ChevronDown(icon.Props{Class: "size-4"})
									</div>
								</button>
								<div class="ps-2 space-y-0.5" role="group" :aria-label="type + ' entities'">
									<template x-for="node in nodes" :key="node.id">
										@EntityItem()
									</template>
								</div>
							</div>
						</template>
					</div>
				</template>
				<!-- List View -->
				<template x-if="entityBrowserViewMode === 'list'">
					<div class="p-1.5 space-y-0.5">
						<template x-for="node in sortedNodes" :key="node.id">
							@EntityItem()
						</template>
					</div>
				</template>
				<!-- Empty State -->
				<template x-if="sortedNodes.length === 0">
					<div class="py-6 text-center" role="status" aria-live="polite">
						@icon.Network(icon.Props{Class: "size-6 mx-auto text-muted-foreground/50 mb-1.5"})
						<p class="text-xs text-muted-foreground">
							<span x-show="entityBrowserSearchQuery">{ i18n.T(ctx, "No entities found") }</span>
							<span x-show="!entityBrowserSearchQuery">{ i18n.T(ctx, "No entities yet") }</span>
						</p>
					</div>
				</template>
			</div>
			<!-- Footer with stats -->
			<div class="p-3 border-t shrink-0 bg-muted/20">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] px-2 py-0.5"}) {
							<span x-text="groupedNodes.length + ' types'"></span>
						}
					</div>
					<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
						@icon.Link2(icon.Props{Class: "size-3"})
						<span class="font-medium" x-text="Math.floor(sortedNodes.reduce((acc, n) => acc + (n.degree || 0), 0) / 2)"></span>
						<span>{ i18n.T(ctx, "connections") }</span>
					</div>
				</div>
			</div>
		</div>
	</aside>
}

templ EntityItem() {
	<button
		@click="focusNode(node.id)"
		class="w-full text-start px-2.5 py-1.5 rounded-md transition-all duration-150 group flex items-center gap-2 outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
		:class="selectedNodeId === node.id ? 'bg-primary text-primary-foreground shadow-sm' : 'hover:bg-muted/60'"
		role="option"
		:aria-selected="selectedNodeId === node.id"
	>
		<div
			class="w-2 h-2 rounded-full shrink-0 ring-1.5 transition-transform"
			:class="selectedNodeId === node.id ? 'ring-primary-foreground/30 scale-110' : 'ring-white dark:ring-gray-800'"
			:style="`background-color: ${entityColors[node.node_type] || '#94a3b8'}`"
		></div>
		<div class="flex-1 min-w-0">
			<p class="text-xs font-medium truncate leading-tight" :class="selectedNodeId === node.id && 'font-semibold'" x-text="node.label || node.id || 'Unknown'"></p>
			<div class="flex items-center gap-1.5 mt-0.5">
				<span
					class="text-[9px] uppercase tracking-wider"
					:class="selectedNodeId === node.id ? 'text-primary-foreground/70' : 'text-muted-foreground'"
					x-text="node.node_type || 'unknown'"
				></span>
				<template x-if="node.degree && node.degree > 0">
					<span class="flex items-center gap-0.5">
						<span :class="selectedNodeId === node.id ? 'text-primary-foreground/50' : 'text-muted-foreground/50'" class="text-[9px]">·</span>
						<div class="w-8 h-0.5 bg-muted/50 rounded-full overflow-hidden">
							<div
								class="h-full rounded-full transition-all"
								:class="selectedNodeId === node.id ? 'bg-primary-foreground/60' : 'bg-primary/60'"
								:style="`width: ${Math.min((node.degree || 0) / 10, 1) * 100}%`"
							></div>
						</div>
						<span
							class="text-[9px] font-medium tabular-nums"
							:class="selectedNodeId === node.id ? 'text-primary-foreground/70' : 'text-muted-foreground'"
							x-text="node.degree"
						></span>
					</span>
				</template>
			</div>
		</div>
	</button>
}
