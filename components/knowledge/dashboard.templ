package knowledge

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/card"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
	"school-with-ai/components/progress"
	"school-with-ai/components/separator"
	"school-with-ai/components/table"
	"school-with-ai/components/tabs"
	"school-with-ai/components/tooltip"
	"school-with-ai/domain"
)

type DashboardPageProps struct {
	User *domain.User
}

templ knowledgeExtraHead() {
	@input.Script()
	@dialog.Script()
	@tabs.Script()
	@progress.Script()
}

templ DashboardPage(props DashboardPageProps) {
	@knowledgeLayout(knowledgeLayoutProps{
		Title: "Knowledge Base",
		User:  props.User,
	}) {
		@knowledgeScript()
		<div
			class="flex-1 overflow-y-auto p-6 md:p-8 space-y-6"
			x-data="knowledgeDashboard"
		>
			<!-- Page Header -->
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-2xl font-bold tracking-tight">{ i18n.T(ctx, "Knowledge Base") }</h1>
					<p class="text-muted-foreground text-sm mt-1">{ i18n.T(ctx, "Manage your documents, PDFs, and knowledge graph workspace") }</p>
				</div>
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: templ.Attributes{
							"@click":    "refreshDashboard()",
							":disabled": "loading",
						},
					}) {
						<span :class="loading && 'animate-spin'">
							@icon.RefreshCw(icon.Props{Class: "size-4 me-2"})
						</span>
						{ i18n.T(ctx, "Refresh") }
					}
					@dialog.Trigger(dialog.TriggerProps{For: "upload-document-dialog"}) {
						@button.Button(button.Props{
							Size: button.SizeSm,
						}) {
							@icon.Upload(icon.Props{Class: "size-4 me-2"})
							{ i18n.T(ctx, "Upload Document") }
						}
					}
				</div>
			</div>
			<!-- Stats Cards -->
			<div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
				@statsCard("Documents", "documents", "FileText")
				@statsCard("Entities", "entities", "Network")
				@statsCard("Relationships", "relationships", "GitBranch")
				@statsCard("Chunks", "chunks", "Layers")
			</div>
			<!-- Main Content Tabs -->
			@tabs.Tabs(tabs.Props{ID: "knowledge-tabs"}) {
				@tabs.List(tabs.ListProps{Class: "w-full sm:w-auto"}) {
					@tabs.Trigger(tabs.TriggerProps{Value: "documents", IsActive: true}) {
						@icon.FileText(icon.Props{Class: "size-4 me-2"})
						{ i18n.T(ctx, "Documents") }
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "pdfs"}) {
						@icon.File(icon.Props{Class: "size-4 me-2"})
						{ i18n.T(ctx, "PDFs") }
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "workspaces"}) {
						@icon.FolderOpen(icon.Props{Class: "size-4 me-2"})
						{ i18n.T(ctx, "Workspaces") }
					}
				}
				<!-- Documents Tab -->
				@tabs.Content(tabs.ContentProps{Value: "documents"}) {
					@card.Card(card.Props{Class: "mt-4"}) {
						@card.Header(card.HeaderProps{}) {
							<div class="flex items-center justify-between">
								@card.Title(card.TitleProps{}) {
									{ i18n.T(ctx, "Ingested Documents") }
								}
								<div class="flex items-center gap-2">
									@badge.Badge(badge.Props{
										Variant: badge.VariantSecondary,
										Attributes: templ.Attributes{
											"x-text": "`${dashData.documents?.total || 0} total`",
										},
									})
								</div>
							</div>
							@card.Description(card.DescriptionProps{}) {
								{ i18n.T(ctx, "Documents that have been processed into your knowledge graph") }
							}
						}
						@card.Content(card.ContentProps{}) {
							<!-- Loading State -->
							<div x-show="loading" class="flex items-center justify-center py-12">
								<span class="animate-spin size-6 border-2 border-primary border-t-transparent rounded-full"></span>
								<span class="ms-3 text-muted-foreground text-sm">{ i18n.T(ctx, "Loading documents...") }</span>
							</div>
							<!-- Empty State -->
							<div x-show="!loading && (!dashData.documents?.documents || dashData.documents.documents.length === 0)" x-cloak class="flex flex-col items-center justify-center py-12 text-center">
								@icon.FileText(icon.Props{Class: "size-12 text-muted-foreground/50 mb-4"})
								<h3 class="text-lg font-medium">{ i18n.T(ctx, "No documents yet") }</h3>
								<p class="text-muted-foreground text-sm mt-1 max-w-sm">{ i18n.T(ctx, "Upload your first document to start building your knowledge base") }</p>
								<div class="mt-4">
									@dialog.Trigger(dialog.TriggerProps{For: "upload-document-dialog"}) {
										@button.Button(button.Props{Size: button.SizeSm}) {
											@icon.Upload(icon.Props{Class: "size-4 me-2"})
											{ i18n.T(ctx, "Upload Document") }
										}
									}
								</div>
							</div>
							<!-- Documents Table -->
							<div x-show="!loading && dashData.documents?.documents?.length > 0" x-cloak>
								@table.Table(table.Props{}) {
									@table.Header(table.HeaderProps{}) {
										@table.Row(table.RowProps{}) {
											@table.Head(table.HeadProps{}) {
												{ i18n.T(ctx, "Title") }
											}
											@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
												{ i18n.T(ctx, "Status") }
											}
											@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
												{ i18n.T(ctx, "Chunks") }
											}
											@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
												{ i18n.T(ctx, "Created") }
											}
											@table.Head(table.HeadProps{Class: "text-end"}) {
												{ i18n.T(ctx, "Actions") }
											}
										}
									}
									@table.Body(table.BodyProps{}) {
										<template x-for="doc in dashData.documents.documents" :key="doc.id">
											@table.Row(table.RowProps{}) {
												@table.Cell(table.CellProps{}) {
													<div class="flex items-center gap-2">
														@icon.FileText(icon.Props{Class: "size-4 text-muted-foreground shrink-0"})
														<div class="min-w-0">
															<p class="font-medium text-sm truncate" x-text="doc.title || doc.file_name || 'Untitled'"></p>
															<p class="text-xs text-muted-foreground truncate" x-show="doc.content_summary" x-text="doc.content_summary"></p>
														</div>
													</div>
												}
												@table.Cell(table.CellProps{Class: "hidden sm:table-cell"}) {
													<span
														class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium"
														:class="{
															'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400': doc.status === 'completed' || doc.current_stage === 'completed',
															'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400': doc.status === 'processing' || doc.current_stage === 'processing',
															'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400': doc.status === 'failed',
															'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400': !doc.status && !doc.current_stage,
														}"
														x-text="doc.current_stage || doc.status || 'unknown'"
													></span>
												}
												@table.Cell(table.CellProps{Class: "hidden md:table-cell"}) {
													<span class="text-sm text-muted-foreground" x-text="doc.chunk_count || 0"></span>
												}
												@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
													<span class="text-sm text-muted-foreground" x-text="formatDate(doc.created_at)"></span>
												}
												@table.Cell(table.CellProps{Class: "text-end"}) {
													@tooltip.Trigger(tooltip.TriggerProps{}) {
														@button.Button(button.Props{
															Size:    button.SizeIcon,
															Variant: button.VariantGhost,
															Class:   "size-8",
															Attributes: templ.Attributes{
																"@click": "viewDocument(doc)",
															},
														}) {
															@icon.Eye(icon.Props{Class: "size-4"})
														}
													}
												}
											}
										</template>
									}
								}
								<!-- Pagination -->
								<div class="flex items-center justify-between pt-4" x-show="dashData.documents?.total_pages > 1">
									<span class="text-sm text-muted-foreground" x-text="`Page ${docPage} of ${dashData.documents.total_pages}`"></span>
									<div class="flex gap-2">
										@button.Button(button.Props{
											Size:    button.SizeSm,
											Variant: button.VariantOutline,
											Attributes: templ.Attributes{
												"@click":    "docPage > 1 && loadDocuments(--docPage)",
												":disabled": "docPage <= 1",
											},
										}) {
											{ i18n.T(ctx, "Previous") }
										}
										@button.Button(button.Props{
											Size:    button.SizeSm,
											Variant: button.VariantOutline,
											Attributes: templ.Attributes{
												"@click":    "docPage < dashData.documents.total_pages && loadDocuments(++docPage)",
												":disabled": "docPage >= dashData.documents.total_pages",
											},
										}) {
											{ i18n.T(ctx, "Next") }
										}
									</div>
								</div>
							</div>
						}
					}
				}
				<!-- PDFs Tab -->
				@tabs.Content(tabs.ContentProps{Value: "pdfs"}) {
					@card.Card(card.Props{Class: "mt-4"}) {
						@card.Header(card.HeaderProps{}) {
							<div class="flex items-center justify-between">
								@card.Title(card.TitleProps{}) {
									{ i18n.T(ctx, "PDF Documents") }
								}
								@dialog.Trigger(dialog.TriggerProps{For: "upload-pdf-dialog"}) {
									@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline}) {
										@icon.Upload(icon.Props{Class: "size-4 me-2"})
										{ i18n.T(ctx, "Upload PDF") }
									}
								}
							</div>
							@card.Description(card.DescriptionProps{}) {
								{ i18n.T(ctx, "PDF files uploaded for processing and extraction") }
							}
						}
						@card.Content(card.ContentProps{}) {
							<div x-show="loading" class="flex items-center justify-center py-12">
								<span class="animate-spin size-6 border-2 border-primary border-t-transparent rounded-full"></span>
							</div>
							<div x-show="!loading && (!dashData.pdfs?.items || dashData.pdfs.items.length === 0)" x-cloak class="flex flex-col items-center justify-center py-12 text-center">
								@icon.File(icon.Props{Class: "size-12 text-muted-foreground/50 mb-4"})
								<h3 class="text-lg font-medium">{ i18n.T(ctx, "No PDFs yet") }</h3>
								<p class="text-muted-foreground text-sm mt-1">{ i18n.T(ctx, "Upload PDF files to extract knowledge automatically") }</p>
							</div>
							<div x-show="!loading && dashData.pdfs?.items?.length > 0" x-cloak>
								@table.Table(table.Props{}) {
									@table.Header(table.HeaderProps{}) {
										@table.Row(table.RowProps{}) {
											@table.Head(table.HeadProps{}) {
												{ i18n.T(ctx, "Filename") }
											}
											@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
												{ i18n.T(ctx, "Status") }
											}
											@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
												{ i18n.T(ctx, "Size") }
											}
											@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
												{ i18n.T(ctx, "Pages") }
											}
											@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
												{ i18n.T(ctx, "Created") }
											}
											@table.Head(table.HeadProps{Class: "text-end"}) {
												{ i18n.T(ctx, "Actions") }
											}
										}
									}
									@table.Body(table.BodyProps{}) {
										<template x-for="pdf in dashData.pdfs.items" :key="pdf.pdf_id">
											@table.Row(table.RowProps{}) {
												@table.Cell(table.CellProps{}) {
													<div class="flex items-center gap-2">
														@icon.File(icon.Props{Class: "size-4 text-red-500 shrink-0"})
														<span class="font-medium text-sm truncate" x-text="pdf.filename"></span>
													</div>
												}
												@table.Cell(table.CellProps{Class: "hidden sm:table-cell"}) {
													<span
														class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium"
														:class="{
															'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400': pdf.status === 'completed',
															'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400': pdf.status === 'processing' || pdf.status === 'pending',
															'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400': pdf.status === 'failed',
														}"
														x-text="pdf.status"
													></span>
												}
												@table.Cell(table.CellProps{Class: "hidden md:table-cell"}) {
													<span class="text-sm text-muted-foreground" x-text="formatBytes(pdf.file_size_bytes)"></span>
												}
												@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
													<span class="text-sm text-muted-foreground" x-text="pdf.page_count || '—'"></span>
												}
												@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
													<span class="text-sm text-muted-foreground" x-text="formatDate(pdf.created_at)"></span>
												}
												@table.Cell(table.CellProps{Class: "text-end"}) {
													@button.Button(button.Props{
														Size:    button.SizeIcon,
														Variant: button.VariantGhost,
														Class:   "size-8 text-destructive hover:text-destructive",
														Attributes: templ.Attributes{
															"@click": "deletePdf(pdf.pdf_id)",
														},
													}) {
														@icon.Trash2(icon.Props{Class: "size-4"})
													}
												}
											}
										</template>
									}
								}
							</div>
						}
					}
				}
				<!-- Workspaces Tab -->
				@tabs.Content(tabs.ContentProps{Value: "workspaces"}) {
					@card.Card(card.Props{Class: "mt-4"}) {
						@card.Header(card.HeaderProps{}) {
							<div class="flex items-center justify-between">
								@card.Title(card.TitleProps{}) {
									{ i18n.T(ctx, "Workspaces") }
								}
								@dialog.Trigger(dialog.TriggerProps{For: "create-workspace-dialog"}) {
									@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline}) {
										@icon.Plus(icon.Props{Class: "size-4 me-2"})
										{ i18n.T(ctx, "New Workspace") }
									}
								}
							</div>
							@card.Description(card.DescriptionProps{}) {
								{ i18n.T(ctx, "Isolated knowledge environments for different topics or projects") }
							}
						}
						@card.Content(card.ContentProps{}) {
							<div x-show="wsLoading" class="flex items-center justify-center py-12">
								<span class="animate-spin size-6 border-2 border-primary border-t-transparent rounded-full"></span>
							</div>
							<div x-show="!wsLoading && workspacesList.length === 0" x-cloak class="flex flex-col items-center justify-center py-12 text-center">
								@icon.FolderOpen(icon.Props{Class: "size-12 text-muted-foreground/50 mb-4"})
								<h3 class="text-lg font-medium">{ i18n.T(ctx, "No workspaces") }</h3>
								<p class="text-muted-foreground text-sm mt-1">{ i18n.T(ctx, "Create a workspace to organize your knowledge") }</p>
							</div>
							<div x-show="!wsLoading && workspacesList.length > 0" x-cloak class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
								<template x-for="ws in workspacesList" :key="ws.id">
									<div class="rounded-lg border bg-card p-4 hover:shadow-md transition-shadow">
										<div class="flex items-start justify-between">
											<div class="min-w-0 flex-1">
												<h3 class="font-semibold text-sm truncate" x-text="ws.name"></h3>
												<p class="text-xs text-muted-foreground mt-1 truncate" x-text="ws.description || ws.slug"></p>
											</div>
											<div class="flex items-center gap-1 ms-2 shrink-0">
												<span
													class="inline-flex size-2 rounded-full"
													:class="ws.is_active ? 'bg-green-500' : 'bg-gray-400'"
												></span>
											</div>
										</div>
										@separator.Separator(separator.Props{Class: "my-3"})
										<div class="grid grid-cols-2 gap-2 text-xs text-muted-foreground">
											<div class="flex items-center gap-1">
												@icon.Cpu(icon.Props{Class: "size-3"})
												<span x-text="ws.llm_model"></span>
											</div>
											<div class="flex items-center gap-1">
												@icon.Layers(icon.Props{Class: "size-3"})
												<span x-text="ws.embedding_model"></span>
											</div>
										</div>
										<div class="flex items-center justify-between mt-3">
											<span class="text-xs text-muted-foreground" x-text="formatDate(ws.created_at)"></span>
											<div class="flex items-center gap-1">
												@button.Button(button.Props{
													Size:    button.SizeIcon,
													Variant: button.VariantGhost,
													Class:   "size-7",
													Attributes: templ.Attributes{
														"@click": "viewWorkspaceStats(ws.id)",
													},
												}) {
													@icon.ChartBar(icon.Props{Class: "size-3.5"})
												}
												@button.Button(button.Props{
													Size:    button.SizeIcon,
													Variant: button.VariantGhost,
													Class:   "size-7 text-destructive hover:text-destructive",
													Attributes: templ.Attributes{
														"@click": "deleteWorkspace(ws.id, ws.name)",
													},
												}) {
													@icon.Trash2(icon.Props{Class: "size-3.5"})
												}
											</div>
										</div>
									</div>
								</template>
							</div>
						}
					}
				}
			}
			<!-- Upload Document Dialog -->
			@uploadDocumentDialog()
			<!-- Upload PDF Dialog -->
			@uploadPdfDialog()
			<!-- Create Workspace Dialog -->
			@createWorkspaceDialog()
			<!-- Workspace Stats Dialog -->
			@workspaceStatsDialog()
		</div>
		@knowledgeScript()
	}
}

templ statsCard(label, key, iconName string) {
	@card.Card(card.Props{}) {
		@card.Content(card.ContentProps{Class: "p-4"}) {
			<div class="flex items-center justify-between">
				<div>
					<p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, label) }</p>
					<p class="text-2xl font-bold mt-1" x-text={ "formatNumber(dashData.stats?." + key + " || 0)" }></p>
				</div>
				<div class="rounded-lg bg-primary/10 p-2.5">
					if iconName == "FileText" {
						@icon.FileText(icon.Props{Class: "size-5 text-primary"})
					} else if iconName == "Network" {
						@icon.Network(icon.Props{Class: "size-5 text-primary"})
					} else if iconName == "GitBranch" {
						@icon.GitBranch(icon.Props{Class: "size-5 text-primary"})
					} else if iconName == "Layers" {
						@icon.Layers(icon.Props{Class: "size-5 text-primary"})
					}
				</div>
			</div>
		}
	}
}

templ uploadDocumentDialog() {
	@dialog.Dialog(dialog.Props{ID: "upload-document-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			<div x-data="uploadDocForm()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Upload Document") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Upload a text document to be processed into your knowledge graph") }
					}
				}
				<div class="space-y-4 py-4">
					<div
						class="border-2 border-dashed rounded-lg p-8 text-center transition-colors cursor-pointer"
						:class="dragOver ? 'border-primary bg-primary/5' : 'border-muted-foreground/25 hover:border-primary/50'"
						@dragover.prevent="dragOver = true"
						@dragleave.prevent="dragOver = false"
						@drop.prevent="handleDocDrop($event)"
						@click="$refs.docFileInput.click()"
					>
						@icon.Upload(icon.Props{Class: "size-8 text-muted-foreground mx-auto mb-3"})
						<p class="text-sm font-medium">{ i18n.T(ctx, "Drop your file here or click to browse") }</p>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "Supports .txt, .md, .json, .csv files") }</p>
						<input
							type="file"
							x-ref="docFileInput"
							@change="handleDocFileSelect($event)"
							accept=".txt,.md,.json,.csv,.html,.xml"
							class="hidden"
						/>
					</div>
					<div x-show="selectedFile" x-cloak class="flex items-center gap-3 rounded-lg border p-3">
						@icon.FileText(icon.Props{Class: "size-5 text-primary shrink-0"})
						<div class="min-w-0 flex-1">
							<p class="text-sm font-medium truncate" x-text="selectedFile?.name"></p>
							<p class="text-xs text-muted-foreground" x-text="formatBytes(selectedFile?.size)"></p>
						</div>
						@button.Button(button.Props{
							Size:    button.SizeIcon,
							Variant: button.VariantGhost,
							Class:   "size-7",
							Attributes: templ.Attributes{
								"@click": "selectedFile = null",
							},
						}) {
							@icon.X(icon.Props{Class: "size-4"})
						}
					</div>
					<div x-show="uploadProgress > 0 && uploadProgress < 100" x-cloak>
						@progress.Progress(progress.Props{})
					</div>
					<div x-show="uploadError" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="uploadError"></p>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "uploadDocument()",
							":disabled": "!selectedFile || uploading",
						},
					}) {
						<span x-show="!uploading">{ i18n.T(ctx, "Upload") }</span>
						<span x-show="uploading" class="flex items-center gap-2">
							<span class="animate-spin size-4 border-2 border-white border-t-transparent rounded-full"></span>
							{ i18n.T(ctx, "Uploading...") }
						</span>
					}
				}
			</div>
		}
	}
}

templ uploadPdfDialog() {
	@dialog.Dialog(dialog.Props{ID: "upload-pdf-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			<div x-data="uploadPdfForm()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Upload PDF") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Upload a PDF file for intelligent extraction and processing") }
					}
				}
				<div class="space-y-4 py-4">
					<div
						class="border-2 border-dashed rounded-lg p-8 text-center transition-colors cursor-pointer"
						:class="dragOver ? 'border-primary bg-primary/5' : 'border-muted-foreground/25 hover:border-primary/50'"
						@dragover.prevent="dragOver = true"
						@dragleave.prevent="dragOver = false"
						@drop.prevent="handlePdfDrop($event)"
						@click="$refs.pdfFileInput.click()"
					>
						@icon.File(icon.Props{Class: "size-8 text-red-500 mx-auto mb-3"})
						<p class="text-sm font-medium">{ i18n.T(ctx, "Drop your PDF here or click to browse") }</p>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "Max file size: 64MB") }</p>
						<input
							type="file"
							x-ref="pdfFileInput"
							@change="handlePdfFileSelect($event)"
							accept=".pdf"
							class="hidden"
						/>
					</div>
					<div x-show="selectedFile" x-cloak class="flex items-center gap-3 rounded-lg border p-3">
						@icon.File(icon.Props{Class: "size-5 text-red-500 shrink-0"})
						<div class="min-w-0 flex-1">
							<p class="text-sm font-medium truncate" x-text="selectedFile?.name"></p>
							<p class="text-xs text-muted-foreground" x-text="formatBytes(selectedFile?.size)"></p>
						</div>
						@button.Button(button.Props{
							Size:    button.SizeIcon,
							Variant: button.VariantGhost,
							Class:   "size-7",
							Attributes: templ.Attributes{
								"@click": "selectedFile = null",
							},
						}) {
							@icon.X(icon.Props{Class: "size-4"})
						}
					</div>
					<div x-show="uploadError" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="uploadError"></p>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "uploadPdf()",
							":disabled": "!selectedFile || uploading",
						},
					}) {
						<span x-show="!uploading">{ i18n.T(ctx, "Upload PDF") }</span>
						<span x-show="uploading" class="flex items-center gap-2">
							<span class="animate-spin size-4 border-2 border-white border-t-transparent rounded-full"></span>
							{ i18n.T(ctx, "Uploading...") }
						</span>
					}
				}
			</div>
		}
	}
}

templ createWorkspaceDialog() {
	@dialog.Dialog(dialog.Props{ID: "create-workspace-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			<div x-data="createWsForm()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Create Workspace") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Create a new isolated workspace for organizing knowledge") }
					}
				}
				<div class="space-y-4 py-4">
					<div>
						<label class="text-sm font-medium" for="ws-name">{ i18n.T(ctx, "Name") }</label>
						@input.Input(input.Props{
							ID:          "ws-name",
							Placeholder: i18n.T(ctx, "e.g., Physics Research"),
							Class:       "mt-1",
							Attributes: templ.Attributes{
								"x-model": "wsName",
							},
						})
					</div>
					<div>
						<label class="text-sm font-medium" for="ws-desc">{ i18n.T(ctx, "Description") }</label>
						@input.Input(input.Props{
							ID:          "ws-desc",
							Placeholder: i18n.T(ctx, "Optional description"),
							Class:       "mt-1",
							Attributes: templ.Attributes{
								"x-model": "wsDescription",
							},
						})
					</div>
					<div x-show="createError" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="createError"></p>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "createWorkspace()",
							":disabled": "!wsName || creating",
						},
					}) {
						<span x-show="!creating">{ i18n.T(ctx, "Create") }</span>
						<span x-show="creating" class="flex items-center gap-2">
							<span class="animate-spin size-4 border-2 border-white border-t-transparent rounded-full"></span>
							{ i18n.T(ctx, "Creating...") }
						</span>
					}
				}
			</div>
		}
	}
}

templ workspaceStatsDialog() {
	@dialog.Dialog(dialog.Props{ID: "workspace-stats-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			<div x-data="wsStatsView()">
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Workspace Statistics") }
					}
				}
				<div class="py-4">
					<div x-show="statsLoading" class="flex items-center justify-center py-8">
						<span class="animate-spin size-6 border-2 border-primary border-t-transparent rounded-full"></span>
					</div>
					<div x-show="!statsLoading && wsStats" x-cloak class="grid grid-cols-2 gap-4">
						<div class="rounded-lg border p-3 text-center">
							@icon.FileText(icon.Props{Class: "size-5 text-primary mx-auto mb-1"})
							<p class="text-xl font-bold" x-text="wsStats?.document_count || 0"></p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Documents") }</p>
						</div>
						<div class="rounded-lg border p-3 text-center">
							@icon.Network(icon.Props{Class: "size-5 text-primary mx-auto mb-1"})
							<p class="text-xl font-bold" x-text="wsStats?.entity_count || 0"></p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Entities") }</p>
						</div>
						<div class="rounded-lg border p-3 text-center">
							@icon.GitBranch(icon.Props{Class: "size-5 text-primary mx-auto mb-1"})
							<p class="text-xl font-bold" x-text="wsStats?.relationship_count || 0"></p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Relationships") }</p>
						</div>
						<div class="rounded-lg border p-3 text-center">
							@icon.Layers(icon.Props{Class: "size-5 text-primary mx-auto mb-1"})
							<p class="text-xl font-bold" x-text="wsStats?.chunk_count || 0"></p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Chunks") }</p>
						</div>
						<div class="rounded-lg border p-3 text-center">
							@icon.Database(icon.Props{Class: "size-5 text-primary mx-auto mb-1"})
							<p class="text-xl font-bold" x-text="wsStats?.embedding_count || 0"></p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Embeddings") }</p>
						</div>
						<div class="rounded-lg border p-3 text-center">
							@icon.HardDrive(icon.Props{Class: "size-5 text-primary mx-auto mb-1"})
							<p class="text-xl font-bold" x-text="formatBytes(wsStats?.storage_bytes || 0)"></p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Storage") }</p>
						</div>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "Close") }
						}
					}
				}
			</div>
		}
	}
}

templ knowledgeScript() {
	<script>
		document.addEventListener('alpine:init', () => {
			// Main dashboard data store
			Alpine.data('knowledgeDashboard', () => ({
				loading: true,
				dashData: { 
					documents: { documents: [], total_pages: 1 }, 
					pdfs: { items: [] }, 
					stats: { documents: 0, entities: 0, relationships: 0, chunks: 0 } 
				},
				docPage: 1,
				workspacesList: [],
				wsLoading: false,

				init() {
					this.refreshDashboard();
				},

				async refreshDashboard() {
					this.loading = true;
					try {
						const resp = await fetch('/api/knowledge/dashboard', {
						credentials: 'same-origin',
					});
						if (resp.ok) {
							this.dashData = await resp.json();
							// Map stats fields for stat cards
							if (this.dashData.stats) {
								this.dashData.stats.documents = this.dashData.stats.document_count || 0;
								this.dashData.stats.entities = this.dashData.stats.entity_count || 0;
								this.dashData.stats.relationships = this.dashData.stats.relationship_count || 0;
								this.dashData.stats.chunks = this.dashData.stats.chunk_count || 0;
							}
						}
					} catch (e) {
						console.error('Failed to load dashboard data:', e);
					} finally {
						this.loading = false;
					}
					this.loadWorkspaces();
				},

				async loadDocuments(page) {
					try {
						const resp = await fetch(`/api/knowledge/documents?page=${page}&page_size=10`, {
						credentials: 'same-origin',
					});
						if (resp.ok) {
							this.dashData.documents = await resp.json();
						}
					} catch (e) {
						console.error('Failed to load documents:', e);
					}
				},

				async loadWorkspaces() {
					this.wsLoading = true;
					try {
						const resp = await fetch('/api/knowledge/workspaces', {
						credentials: 'same-origin',
					});
						if (resp.ok) {
							const data = await resp.json();
							this.workspacesList = data.items || [];
						}
					} catch (e) {
						console.error('Failed to load workspaces:', e);
					} finally {
						this.wsLoading = false;
					}
				},

				async deletePdf(pdfId) {
					if (!confirm('Are you sure you want to delete this PDF?')) return;
					try {
						const resp = await fetch(`/api/knowledge/pdfs/${pdfId}`, { 
						method: 'DELETE',
						credentials: 'same-origin',
					});
						if (resp.ok) {
							this.refreshDashboard();
						}
					} catch (e) {
						console.error('Failed to delete PDF:', e);
					}
				},

				async deleteWorkspace(wsId, wsName) {
					if (!confirm(`Are you sure you want to delete workspace "${wsName}"? This action cannot be undone.`)) return;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${wsId}`, { 
						method: 'DELETE',
						credentials: 'same-origin',
					});
						if (resp.ok) {
							this.loadWorkspaces();
						}
					} catch (e) {
						console.error('Failed to delete workspace:', e);
					}
				},

				async viewWorkspaceStats(wsId) {
					// Dispatch event to open stats dialog
					window.dispatchEvent(new CustomEvent('show-workspace-stats', { detail: { id: wsId } }));
					// Open the dialog
					const dialog = document.querySelector('[data-tui-dialog="workspace-stats-dialog"]');
					if (dialog) {
						dialog.dispatchEvent(new Event('open'));
					}
					// Click the trigger to open
					const trigger = document.querySelector('[data-tui-dialog-trigger][data-tui-dialog-for="workspace-stats-dialog"]');
					if (trigger) trigger.click();
				},

				viewDocument(doc) {
					// Could open a detail view - for now just log
					console.log('View document:', doc);
				},

				formatDate(dateStr) {
					if (!dateStr) return '—';
					try {
						return new Date(dateStr).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
					} catch (e) {
						return dateStr;
					}
				},

				formatBytes(bytes) {
					if (!bytes || bytes === 0) return '0 B';
					const k = 1024;
					const sizes = ['B', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
				},

				formatNumber(num) {
					if (!num) return '0';
					return num.toLocaleString();
				},
			}));

			// Upload document form
			Alpine.data('uploadDocForm', () => ({
				selectedFile: null,
				uploading: false,
				uploadProgress: 0,
				uploadError: null,
				dragOver: false,

				handleDocDrop(e) {
					this.dragOver = false;
					const files = e.dataTransfer.files;
					if (files.length > 0) this.selectedFile = files[0];
				},

				handleDocFileSelect(e) {
					const files = e.target.files;
					if (files.length > 0) this.selectedFile = files[0];
				},

				formatBytes(bytes) {
					if (!bytes || bytes === 0) return '0 B';
					const k = 1024;
					const sizes = ['B', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
				},

				async uploadDocument() {
					if (!this.selectedFile) return;
					this.uploading = true;
					this.uploadError = null;

					const formData = new FormData();
					formData.append('file', this.selectedFile);

					try {
						const resp = await fetch('/api/knowledge/documents/upload', {
							method: 'POST',
							body: formData,
							credentials: 'same-origin',
						});
						const data = await resp.json();
						if (!resp.ok) {
							this.uploadError = data.error || 'Upload failed';
							return;
						}
						// Close dialog and refresh
						this.selectedFile = null;
						const closeBtn = document.querySelector('[data-tui-dialog="upload-document-dialog"] [data-tui-dialog-close]');
						if (closeBtn) closeBtn.click();
						// Trigger refresh on parent
						const dashboard = document.querySelector('[x-data="knowledgeDashboard"]');
						if (dashboard && dashboard.__x) {
							dashboard.__x.$data.refreshDashboard();
						}
					} catch (e) {
						this.uploadError = 'Network error: ' + e.message;
					} finally {
						this.uploading = false;
					}
				},
			}));

			// Upload PDF form
			Alpine.data('uploadPdfForm', () => ({
				selectedFile: null,
				uploading: false,
				uploadError: null,
				dragOver: false,

				handlePdfDrop(e) {
					this.dragOver = false;
					const files = e.dataTransfer.files;
					if (files.length > 0 && files[0].type === 'application/pdf') {
						this.selectedFile = files[0];
					}
				},

				handlePdfFileSelect(e) {
					const files = e.target.files;
					if (files.length > 0) this.selectedFile = files[0];
				},

				formatBytes(bytes) {
					if (!bytes || bytes === 0) return '0 B';
					const k = 1024;
					const sizes = ['B', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
				},

				async uploadPdf() {
					if (!this.selectedFile) return;
					this.uploading = true;
					this.uploadError = null;

					const formData = new FormData();
					formData.append('file', this.selectedFile);

					try {
						const resp = await fetch('/api/knowledge/pdfs/upload', {
							method: 'POST',
							body: formData,
							credentials: 'same-origin',
						});
						const data = await resp.json();
						if (!resp.ok) {
							this.uploadError = data.error || 'Upload failed';
							return;
						}
						this.selectedFile = null;
						const closeBtn = document.querySelector('[data-tui-dialog="upload-pdf-dialog"] [data-tui-dialog-close]');
						if (closeBtn) closeBtn.click();
						const dashboard = document.querySelector('[x-data="knowledgeDashboard"]');
						if (dashboard && dashboard.__x) {
							dashboard.__x.$data.refreshDashboard();
						}
					} catch (e) {
						this.uploadError = 'Network error: ' + e.message;
					} finally {
						this.uploading = false;
					}
				},
			}));

			// Create workspace form
			Alpine.data('createWsForm', () => ({
				wsName: '',
				wsDescription: '',
				creating: false,
				createError: null,

				async createWorkspace() {
					if (!this.wsName) return;
					this.creating = true;
					this.createError = null;

					try {
						const resp = await fetch('/api/knowledge/workspaces', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ name: this.wsName, description: this.wsDescription }),
							credentials: 'same-origin',
						});
						const data = await resp.json();
						if (!resp.ok) {
							this.createError = data.error || 'Creation failed';
							return;
						}
						this.wsName = '';
						this.wsDescription = '';
						const closeBtn = document.querySelector('[data-tui-dialog="create-workspace-dialog"] [data-tui-dialog-close]');
						if (closeBtn) closeBtn.click();
						const dashboard = document.querySelector('[x-data="knowledgeDashboard"]');
						if (dashboard && dashboard.__x) {
							dashboard.__x.$data.loadWorkspaces();
						}
					} catch (e) {
						this.createError = 'Network error: ' + e.message;
					} finally {
						this.creating = false;
					}
				},
			}));

			// Workspace stats viewer
			Alpine.data('wsStatsView', () => ({
				wsStats: null,
				statsLoading: false,
				statsWorkspaceId: null,

				init() {
					window.addEventListener('show-workspace-stats', (e) => {
						this.loadStats(e.detail.id);
					});
				},

				async loadStats(wsId) {
					this.statsLoading = true;
					this.statsWorkspaceId = wsId;
					try {
						const resp = await fetch(`/api/knowledge/workspaces/${wsId}/stats`, {
						credentials: 'same-origin',
					});
						if (resp.ok) {
							this.wsStats = await resp.json();
						}
					} catch (e) {
						console.error('Failed to load workspace stats:', e);
					} finally {
						this.statsLoading = false;
					}
				},
			}));
		});
	</script>
}
