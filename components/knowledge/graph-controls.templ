package knowledge
 
import "school-with-ai/components/icon"
 
/**
 * GraphControls - Graph display setting toggles.
 * Matches EdgeQuake edgequake_webui/src/components/graph/graph-controls.tsx
 *
 * Includes: labels, edge labels, node size, drag, neighbor highlight, hide edges toggles.
 * Positioned absolute top-left of the graph container.
 */
 
templ GraphControls() {
	<div x-data="{ expanded: false }" class="absolute top-4 left-4 z-20">
		<!-- Gear Button (Collapsed) -->
		<template x-if="!expanded">
			<button
				@click="expanded = true"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-all duration-200 bg-background/95 backdrop-blur-sm shadow-lg border border-border/50 hover:bg-accent hover:border-primary/30 hover:shadow-xl h-10 w-10"
				title="Graph Settings"
			>
				@icon.Settings2(icon.Props{Class: "size-4"})
			</button>
		</template>
		<!-- Settings Card (Expanded) -->
		<div
			x-show="expanded"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			class="w-56 shadow-lg bg-background/95 backdrop-blur-sm border rounded-lg overflow-hidden"
			x-cloak
		>
			<!-- Card Header -->
			<div class="py-2 px-3 border-b flex items-center justify-between">
				<div class="text-xs font-medium flex items-center gap-1.5">
					@icon.Settings2(icon.Props{Class: "size-3.5"})
					Graph Settings
				</div>
				<button
					@click="expanded = false"
					class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-5 w-5"
				>
					@icon.X(icon.Props{Class: "size-3"})
				</button>
			</div>
			<!-- Card Content -->
			<div class="p-3 space-y-4">
				<!-- Layout Section -->
				<div class="space-y-2">
					<div class="flex items-center gap-1.5">
						@icon.GitBranch(icon.Props{Class: "size-3.5 text-muted-foreground"})
						<label class="text-xs font-medium">Layout</label>
					</div>
					@LayoutControl()
				</div>
				<div class="h-px bg-border my-1"></div>
				<!-- Appearance Section -->
				<div class="space-y-3">
					<div class="flex items-center gap-1.5">
						@icon.Circle(icon.Props{Class: "size-3.5 text-muted-foreground"})
						<label class="text-xs font-medium">Appearance</label>
					</div>
					<!-- Node Size -->
					<div class="space-y-1.5">
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Node Size</span>
							<span class="text-[10px] font-medium bg-muted px-1.5 py-0.5 rounded" x-text="graphNodeSize || 'medium'"></span>
						</div>
						<select
							x-model="graphNodeSize"
							@change="applyNodeSize()"
							class="w-full h-7 text-xs rounded border border-input bg-transparent px-2 py-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						>
							<option value="small">Small</option>
							<option value="medium">Medium</option>
							<option value="large">Large</option>
						</select>
					</div>
					<!-- Color By -->
					<div class="space-y-1.5">
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Color By</span>
						</div>
						<select
							x-model="graphColorBy"
							@change="graphRefresh()"
							class="w-full h-7 text-xs rounded border border-input bg-transparent px-2 py-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						>
							<option value="type">Entity Type</option>
							<option value="community">Community</option>
							<option value="degree">Connections</option>
						</select>
					</div>
				</div>
				<div class="h-px bg-border my-1"></div>
				<!-- Display Options -->
				<div class="space-y-3">
					<div class="flex items-center gap-1.5">
						@icon.Type(icon.Props{Class: "size-3.5 text-muted-foreground"})
						<label class="text-xs font-medium">Display</label>
					</div>
					<div class="space-y-2">
						<!-- Toggle labels -->
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Show Labels</span>
							<button 
								@click="graphShowLabels = !graphShowLabels; graphRefresh()"
								class="relative inline-flex h-4 w-7 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
								:class="graphShowLabels ? 'bg-primary' : 'bg-input'"
							>
								<span 
									class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-background shadow ring-0 transition duration-200 ease-in-out"
									:class="graphShowLabels ? 'translate-x-3' : 'translate-x-0'"
								></span>
							</button>
						</div>
						<!-- Toggle edge labels -->
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Show Edge Labels</span>
							<button 
								@click="graphShowEdgeLabels = !graphShowEdgeLabels; graphRefresh()"
								class="relative inline-flex h-4 w-7 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
								:class="graphShowEdgeLabels ? 'bg-primary' : 'bg-input'"
							>
								<span 
									class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-background shadow ring-0 transition duration-200 ease-in-out"
									:class="graphShowEdgeLabels ? 'translate-x-3' : 'translate-x-0'"
								></span>
							</button>
						</div>
						<!-- Toggle node drag -->
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Enable Node Drag</span>
							<button 
								@click="graphEnableDrag = !graphEnableDrag; saveGraphSettings()"
								class="relative inline-flex h-4 w-7 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
								:class="graphEnableDrag ? 'bg-primary' : 'bg-input'"
							>
								<span 
									class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-background shadow ring-0 transition duration-200 ease-in-out"
									:class="graphEnableDrag ? 'translate-x-3' : 'translate-x-0'"
								></span>
							</button>
						</div>
						<!-- Toggle neighbor highlighting -->
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Highlight Neighbors</span>
							<button 
								@click="graphHighlightNeighbors = !graphHighlightNeighbors; saveGraphSettings()"
								class="relative inline-flex h-4 w-7 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
								:class="graphHighlightNeighbors ? 'bg-primary' : 'bg-input'"
							>
								<span 
									class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-background shadow ring-0 transition duration-200 ease-in-out"
									:class="graphHighlightNeighbors ? 'translate-x-3' : 'translate-x-0'"
								></span>
							</button>
						</div>
						<!-- Toggle hide unselected edges -->
						<div class="flex items-center justify-between">
							<span class="text-[11px] text-muted-foreground">Dim Edges</span>
							<button 
								@click="graphHideUnselectedEdges = !graphHideUnselectedEdges; saveGraphSettings()"
								class="relative inline-flex h-4 w-7 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
								:class="graphHideUnselectedEdges ? 'bg-primary' : 'bg-input'"
							>
								<span 
									class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-background shadow ring-0 transition duration-200 ease-in-out"
									:class="graphHideUnselectedEdges ? 'translate-x-3' : 'translate-x-0'"
								></span>
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
