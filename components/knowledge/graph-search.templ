package knowledge

/**
 * GraphSearch - Entity search input for the graph.
 * Matches EdgeQuake graph-search.tsx — debounced, with ⌘K / Ctrl+K shortcut.
 */

import (
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ GraphSearch() {
	<div class="relative w-48 sm:w-64 group">
		@icon.Search(icon.Props{Class: "absolute left-2.5 top-1/2 -translate-y-1/2 size-3.5 text-muted-foreground group-focus-within:text-primary transition-colors"})
		<input
			type="search"
			id="graph-search-input"
			placeholder={ i18n.T(ctx, "Search entities...") }
			class="flex h-8 w-full rounded-md border border-input bg-background/50 pl-8 pr-10 py-1 text-[11px] font-medium shadow-sm transition-all placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring focus-visible:bg-background"
			x-model.debounce.300ms="graphSearch"
			@input="searchGraph()"
			@keydown.window.prevent.ctrl.k="document.getElementById('graph-search-input').focus()"
			@keydown.window.prevent.meta.k="document.getElementById('graph-search-input').focus()"
		/>
		<kbd class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 hidden h-4 select-none items-center gap-0.5 rounded border bg-muted px-1.5 font-mono text-[9px] font-medium opacity-60 group-focus-within:opacity-100 sm:flex">
			<span class="text-[10px]">⌘</span>K
		</kbd>
	</div>
}
