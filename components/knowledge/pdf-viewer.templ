package knowledge

import (
	"fmt"
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

type PDFViewerProps struct {
	URL    string
	Height int
}

templ PDFViewer(props PDFViewerProps) {
	<div
		x-data={ "pdfViewer('" + props.URL + "')" }
		class="flex flex-col h-full bg-muted/10 rounded-lg overflow-hidden border"
	>
		<!-- Toolbar -->
		<div class="flex items-center justify-between gap-2 p-2 border-b bg-muted/30 shrink-0">
			<!-- Page Navigation -->
			<div class="flex items-center gap-1">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "prevPage()",
						":disabled": "pageNum <= 1 || isLoading",
					},
				}) {
					@icon.ChevronLeft(icon.Props{Class: "size-4"})
				}
				<span class="text-sm text-muted-foreground min-w-[80px] text-center font-medium tabular-nums">
					<template x-if="isLoading">
						<span>...</span>
					</template>
					<template x-if="!isLoading">
						<span x-text="`${pageNum} / ${numPages}`"></span>
					</template>
				</span>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "nextPage()",
						":disabled": "pageNum >= numPages || isLoading",
					},
				}) {
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				}
			</div>
			<!-- Zoom Controls -->
			<div class="flex items-center gap-1">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "zoomOut()",
						":disabled": "scale <= 0.5 || isLoading",
					},
				}) {
					@icon.ZoomOut(icon.Props{Class: "size-4"})
				}
				<span class="text-sm text-muted-foreground min-w-[50px] text-center font-medium tabular-nums" x-text="`${Math.round(scale * 100)}%`"></span>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "zoomIn()",
						":disabled": "scale >= 3.0 || isLoading",
					},
				}) {
					@icon.ZoomIn(icon.Props{Class: "size-4"})
				}
				<div class="w-px h-4 bg-border mx-1"></div>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click": "resetZoom()",
					},
				}) {
					@icon.Maximize(icon.Props{Class: "size-4"})
				}
			</div>
		</div>
		<!-- Scroll Area -->
		<div
			class="flex-1 overflow-auto bg-muted/10 flex flex-col items-center py-4 relative custom-scrollbar scroll-smooth"
			style={ fmt.Sprintf("height: %dpx; -webkit-overflow-scrolling: touch;", props.Height) }
		>
			<!-- Loading state -->
			<template x-if="isLoading">
				<div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-background/50 backdrop-blur-sm z-10">
					<div class="animate-spin size-8 border-2 border-primary border-t-transparent rounded-full"></div>
					<p class="text-sm text-muted-foreground tracking-wide font-medium">{ i18n.T(ctx, "Loading PDF...") }</p>
				</div>
			</template>
			<!-- Error state -->
			<template x-if="error">
				<div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center bg-background/80 z-20">
					<div class="bg-red-50 text-red-500 p-3 rounded-full mb-4">
						@icon.TriangleAlert(icon.Props{Class: "size-8"})
					</div>
					<h3 class="font-semibold text-red-900 border-none mb-1">{ i18n.T(ctx, "Failed to load PDF") }</h3>
					<p class="text-xs text-red-600 mb-6 max-w-xs" x-text="error"></p>
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: templ.Attributes{
							"@click": "init()",
						},
					}) {
						@icon.RefreshCw(icon.Props{Class: "size-3 me-1.5"})
						{ i18n.T(ctx, "Retry") }
					}
				</div>
			</template>
			<!-- Canvas Container -->
			<div
				class="bg-white shadow-2xl ring-1 ring-black/5 relative"
				:class="{ 'opacity-0': isLoading || error }"
			>
				<canvas x-ref="pdfCanvas" class="max-w-full h-auto block"></canvas>
			</div>
		</div>
		@pdfViewerScript()
	</div>
}

templ pdfViewerScript() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('pdfViewer', (url) => ({
				pdfDoc: null,
				pageNum: 1,
				numPages: 0,
				scale: 1.0,
				isLoading: true,
				error: null,
				renderTask: null,

				async init() {
					if (!url) {
						this.error = "No PDF URL provided";
						this.isLoading = false;
						return;
					}

					try {
						const pdfjsLib = window['pdfjs-dist/build/pdf'];
						if (!pdfjsLib) throw new Error("PDF.js library not found");

						const loadingTask = pdfjsLib.getDocument(url);
						this.pdfDoc = await loadingTask.promise;
						this.numPages = this.pdfDoc.numPages;
						this.isLoading = false;
						
						// Use nextTick to ensure canvas ref is available
						this.$nextTick(() => this.renderPage());
					} catch (err) {
						console.error("PDF load error:", err);
						this.error = err.message || "Failed to load document";
						this.isLoading = false;
					}
				},

				async renderPage() {
					if (!this.pdfDoc || !this.$refs.pdfCanvas) return;

					// Cancel existing render task if any
					if (this.renderTask) {
						this.renderTask.cancel();
					}

					try {
						const page = await this.pdfDoc.getPage(this.pageNum);
						const canvas = this.$refs.pdfCanvas;
						const context = canvas.getContext('2d');
						
						// DRP handling for high resolution screens
						const dpr = window.devicePixelRatio || 1;
						const viewport = page.getViewport({ scale: this.scale * dpr });
						
						canvas.height = viewport.height;
						canvas.width = viewport.width;
						
						// Scaling for CSS
						canvas.style.width = (viewport.width / dpr) + "px";
						canvas.style.height = (viewport.height / dpr) + "px";

						const renderContext = {
							canvasContext: context,
							viewport: viewport
						};
						
						this.renderTask = page.render(renderContext);
						await this.renderTask.promise;
					} catch (err) {
						if (err.name !== 'RenderingCancelledException') {
							console.error("Canvas render error:", err);
						}
					}
				},

				nextPage() {
					if (this.pageNum < this.numPages) {
						this.pageNum++;
						this.renderPage();
					}
				},

				prevPage() {
					if (this.pageNum > 1) {
						this.pageNum--;
						this.renderPage();
					}
				},

				zoomIn() {
					this.scale = Math.min(3.0, this.scale + 0.25);
					this.renderPage();
				},

				zoomOut() {
					this.scale = Math.max(0.5, this.scale - 0.25);
					this.renderPage();
				},

				resetZoom() {
					this.scale = 1.0;
					this.renderPage();
				}
			}));
		});
	</script>
}
