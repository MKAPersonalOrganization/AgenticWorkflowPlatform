package knowledge

import (
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ KeyboardShortcutsHelp() {
	@dialog.Dialog(dialog.Props{
		ID:    "graph-shortcuts-help",
		Class: "max-w-md",
	}) {
		@dialog.Content(dialog.ContentProps{}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					{ i18n.T(ctx, "Graph Shortcuts") }
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ i18n.T(ctx, "Navigate and control the graph interface faster with these shortcuts") }
				}
			}
			<div class="space-y-6 pt-4">
				<!-- Navigation -->
				<div class="space-y-3">
					<h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/70 px-1">
						{ i18n.T(ctx, "Navigation") }
					</h4>
					<div class="space-y-2">
						@ShortcutRow(i18n.T(ctx, "Pan Graph"), "Left Click + Drag")
						@ShortcutRow(i18n.T(ctx, "Zoom In/Out"), "Scroll Wheel")
						@ShortcutRow(i18n.T(ctx, "Fit to Screen"), "F")
						@ShortcutRow(i18n.T(ctx, "Reset Zoom"), "Esc")
					</div>
				</div>
				<!-- Selection -->
				<div class="space-y-3">
					<h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/70 px-1">
						{ i18n.T(ctx, "Selection") }
					</h4>
					<div class="space-y-2">
						@ShortcutRow(i18n.T(ctx, "Select Node"), "Click Node")
						@ShortcutRow(i18n.T(ctx, "Clear Selection"), "Click Empty Space")
						@ShortcutRow(i18n.T(ctx, "Multiple Selection"), "Shift + Drag")
					</div>
				</div>
				<!-- View Controls -->
				<div class="space-y-3">
					<h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/70 px-1">
						{ i18n.T(ctx, "View Controls") }
					</h4>
					<div class="space-y-2">
						@ShortcutRow(i18n.T(ctx, "Toggle Minimap"), "M")
						@ShortcutRow(i18n.T(ctx, "Toggle Legend"), "L")
						@ShortcutRow(i18n.T(ctx, "Toggle Sidebar"), "B")
						@ShortcutRow(i18n.T(ctx, "Show help dialog"), "?")
					</div>
				</div>
			</div>
			@dialog.Footer(dialog.FooterProps{}) {
				<div class="flex items-center gap-2 p-3 bg-muted/30 rounded-lg border border-dashed text-[11px] text-muted-foreground">
					@icon.Info(icon.Props{Class: "size-3.5"})
					<p>{ i18n.T(ctx, "On macOS, use ⌘ instead of Ctrl") }</p>
				</div>
				@dialog.Close(dialog.CloseProps{}) {
					{ i18n.T(ctx, "Got it!") }
				}
			}
		}
	}
}

templ ShortcutRow(label string, shortcut string) {
	<div class="flex items-center justify-between group">
		<span class="text-xs font-medium text-foreground/80">{ label }</span>
		<div class="flex items-center gap-1">
			for _, key := range splitKeys(shortcut) {
				<kbd class="pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground opacity-100 shadow-sm border-b-2 active:border-b-0 transition-all">
					{ key }
				</kbd>
			}
		</div>
	</div>
}

func splitKeys(s string) []string {
	// Simple split by '+' for now, can be sophisticated later
	var keys []string
	current := ""
	for i := 0; i < len(s); i++ {
		if s[i] == '+' {
			keys = append(keys, current)
			current = ""
			continue
		}
		if s[i] == ' ' {
			continue
		}
		current += string(s[i])
	}
	if current != "" {
		keys = append(keys, current)
	}
	// Special case: "Left Click" -> "LeftClick" but let's just return what we have
	return keys
}
