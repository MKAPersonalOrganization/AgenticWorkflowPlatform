package knowledge

/**
 * GraphMinimap - Overview minimap canvas for the graph.
 * Matches EdgeQuake edgequake_webui/src/components/graph/graph-minimap.tsx
 *
 * Positioned absolute bottom-right of the graph container.
 * Shows a bird's-eye view with viewport rectangle. Click to navigate.
 */

templ GraphMinimap() {
	<div
		class="absolute bottom-4 right-4 z-20 bg-background/95 backdrop-blur-sm border border-border/50 rounded-lg shadow-xl overflow-hidden cursor-crosshair transition-all duration-200 hover:shadow-2xl"
		style="width: 140px; height: 110px;"
		title="Click to navigate"
	>
		<canvas id="graph-minimap" class="w-full h-full" style="display: block;"></canvas>
	</div>
}
