package knowledge

/**
 * GraphMinimap - Overview minimap canvas for the graph.
 * Matches EdgeQuake edgequake_webui/src/components/graph/graph-minimap.tsx
 *
 * Positioned absolute bottom-right of the graph container.
 * Shows a bird's-eye view with viewport rectangle. Click/drag to navigate.
 * Dimensions: 120x100 matching React defaults.
 */

templ GraphMinimap() {
	<div
		class="absolute bottom-4 end-4 z-10"
		style="width: 120px; height: 100px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); border-radius: 6px; overflow: hidden;"
		title="Click to navigate"
	>
		<canvas id="graph-minimap" style="display: block; width: 120px; height: 100px; cursor: crosshair;"></canvas>
	</div>
}
