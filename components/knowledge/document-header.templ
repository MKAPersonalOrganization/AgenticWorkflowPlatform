package knowledge

/**
 * DocumentHeader - Header section for document management page.
 * Matches EdgeQuake edgequake_webui/src/components/documents/document-header.tsx
 *
 * Shows: title, document count badge, pipeline busy indicator, refresh button,
 * reprocess-failed button, and clear-all dialog trigger.
 */

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ DocumentHeader() {
	<header class="flex items-center justify-between gap-3 flex-wrap">
		<div class="space-y-0.5">
			<div class="flex items-center gap-2">
				<h1 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "Documents") }</h1>
				<span
					x-show="totalCount > 0"
					x-cloak
				>
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs font-normal"}) {
						<span x-text="totalCount"></span>
					}
				</span>
				<!-- Connection Status Dot -->
				<span
					class="relative flex h-2 w-2"
					x-show="pipelineStatus"
					x-cloak
				>
					<span
						class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
						:class="pipelineStatus?.is_busy ? 'bg-blue-400' : 'bg-green-400'"
					></span>
					<span
						class="relative inline-flex rounded-full h-2 w-2"
						:class="pipelineStatus?.is_busy ? 'bg-blue-500' : 'bg-green-500'"
					></span>
				</span>
			</div>
			<p class="text-sm text-muted-foreground">
				{ i18n.T(ctx, "Upload, manage and track your documents through the ingestion pipeline.") }
			</p>
		</div>
		<div class="flex items-center gap-2 flex-wrap">
			<!-- Pipeline Busy Button -->
			<template x-if="pipelineStatus?.is_busy">
				<button
					@click="pipelineDialogOpen = true"
					class="inline-flex items-center gap-1 rounded-md border px-3 h-9 text-sm font-medium text-orange-500 hover:bg-orange-50 dark:hover:bg-orange-950/30 transition-colors"
				>
					<span class="animate-spin size-4 border-2 border-orange-500 border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Pipeline Busy") }
				</button>
			</template>
			<!-- Reprocess Failed -->
			<template x-if="statusCounts.failed > 0 || statusCounts.partial_failure > 0">
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"@click":    "reprocessFailed()",
						":disabled": "reprocessingFailed",
					},
				}) {
					<template x-if="reprocessingFailed">
						<span class="animate-spin size-3.5 border-2 border-primary border-t-transparent rounded-full me-1"></span>
					</template>
					@icon.RefreshCw(icon.Props{Class: "size-4 me-1"})
					{ i18n.T(ctx, "Retry Failed") }
				}
			</template>
			<!-- Refresh -->
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"@click": "refreshAll()",
				},
			}) {
				<span :class="isRefreshing && 'animate-spin'">
					@icon.RefreshCw(icon.Props{Class: "size-4 me-1"})
				</span>
				{ i18n.T(ctx, "Refresh") }
			}
			<!-- Clear All Documents -->
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "text-destructive border-destructive/50 hover:bg-destructive/10",
				Attributes: templ.Attributes{
					"@click":    "deleteAllDocuments()",
					":disabled": "deletingAllDocs",
					"x-show":    "totalCount > 0",
				},
			}) {
				@icon.Trash2(icon.Props{Class: "size-4 me-1"})
				{ i18n.T(ctx, "Clear All") }
			}
		</div>
	</header>
}
