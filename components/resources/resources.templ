package resources

import (
"school-with-ai/components/button"
"school-with-ai/components/dialog"
"school-with-ai/components/i18n"
"school-with-ai/components/icon"
)

templ ResourcesDialog() {
<script>
document.addEventListener('alpine:init', () => {
Alpine.data('resourcesDialog', () => ({
workspaces: [],
agents: [],
loading: false,
loadingAgents: false,
search: '',
selectedAgent: '',
async init() {
const chatEl = document.querySelector('[x-data="chat"]');
if (chatEl) {
try {
const chatData = Alpine.$data(chatEl);
if (chatData) {
this.selectedAgent = chatData.selectedAgent || '';
}
} catch (e) { /* ignore */ }
}
await this.fetchAgents();
await this.fetchWorkspaces();
},
async fetchAgents() {
this.loadingAgents = true;
try {
const response = await fetch('/v1/agents');
if (response.ok) {
const data = await response.json();
if (data.agents && Array.isArray(data.agents)) {
this.agents = data.agents;
if (!this.selectedAgent && this.agents.length > 0) {
this.selectedAgent = this.agents[0].id;
}
}
}
} catch (err) {
console.error('Failed to fetch agents:', err);
} finally {
this.loadingAgents = false;
}
},
async fetchWorkspaces() {
if (!this.selectedAgent) {
this.workspaces = [];
return;
}
this.loading = true;
try {
const response = await fetch('/v1/agents/' + this.selectedAgent + '/workspaces');
if (response.ok) {
const data = await response.json();
if (data.workspaces && Array.isArray(data.workspaces)) {
this.workspaces = data.workspaces;
}
} else {
this.workspaces = [];
}
} catch (err) {
console.error('Failed to fetch workspaces:', err);
this.workspaces = [];
} finally {
this.loading = false;
}
},
async onAgentChange() {
this.workspaces = [];
await this.fetchWorkspaces();
},
get filteredWorkspaces() {
let filtered = this.workspaces;
if (this.search) {
const q = this.search.toLowerCase();
filtered = filtered.filter(w =>
w.name.toLowerCase().includes(q) ||
(w.description && w.description.toLowerCase().includes(q)) ||
w.slug.toLowerCase().includes(q)
);
}
return filtered;
},
get enabledSummary() {
const enabled = this.workspaces.filter(w => w.enabled).length;
return { enabled, total: this.workspaces.length };
},
async toggleWorkspace(workspace) {
const newState = !workspace.enabled;
try {
const response = await fetch('/v1/agents/' + this.selectedAgent + '/workspaces/' + workspace.id, {
method: 'PUT',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify({ enabled: newState })
});
if (response.ok) {
workspace.enabled = newState;
}
} catch (err) {
console.error('Failed to toggle workspace:', err);
}
}
}));
});
</script>
<div
x-data="resourcesDialog"
@open-resources-dialog.window="init()"
>
@dialog.Dialog(dialog.Props{
ID: "resources-manager-dialog",
}) {
@dialog.Content(dialog.ContentProps{
Class: "sm:max-w-3xl max-h-[90vh] flex flex-col p-0 overflow-hidden",
}) {
@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
<div class="flex items-center justify-between">
<div>
@dialog.Title() {
{ i18n.T(ctx, "Knowledge Workspaces") }
}
@dialog.Description() {
{ i18n.T(ctx, "Attach knowledge base workspaces to an agent. Attached workspaces are available via the Query Knowledge Base tool.") }
}
</div>
@button.Button(button.Props{
Variant: button.VariantOutline,
Size:    button.SizeSm,
Href:    "/knowledge",
Class:   "gap-2 shrink-0",
}) {
@icon.Settings(icon.Props{Class: "size-4"})
{ i18n.T(ctx, "Management") }
}
</div>
}
<!-- Top Controls -->
<div class="p-4 border-b border-border bg-muted/50">
<div class="flex gap-4">
<!-- Agent Selection -->
<div class="flex-1">
<label class="block text-xs font-medium text-muted-foreground mb-1.5 uppercase tracking-wide">{ i18n.T(ctx, "Agent") }</label>
<div class="relative">
<select
x-model="selectedAgent"
@change="onAgentChange()"
class="w-full rounded-lg border border-input bg-background px-3 py-2 pr-8 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring appearance-none transition-colors"
:disabled="loadingAgents"
>
<template x-for="agent in agents" :key="agent.id">
<option :value="agent.id" x-text="agent.name"></option>
</template>
</select>
<div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none">
<template x-if="loadingAgents">
<div class="animate-spin rounded-full h-4 w-4 border-2 border-primary border-t-transparent"></div>
</template>
<template x-if="!loadingAgents">
@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
</template>
</div>
</div>
</div>
<!-- Search -->
<div class="flex-1">
<label class="block text-xs font-medium text-muted-foreground mb-1.5 uppercase tracking-wide">{ i18n.T(ctx, "Search") }</label>
<div class="relative">
<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
@icon.Search(icon.Props{Class: "size-4 text-muted-foreground"})
</div>
<input
type="text"
x-model="search"
placeholder={ i18n.T(ctx, "Search workspaces...") }
class="w-full rounded-lg border border-input bg-background pl-9 pr-9 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring transition-colors"
/>
<button
x-show="search.length > 0"
x-transition:enter="transition-opacity duration-100"
x-transition:enter-start="opacity-0"
x-transition:enter-end="opacity-100"
@click="search = ''"
class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted-foreground hover:text-foreground transition-colors"
>
@icon.X(icon.Props{Class: "size-3.5"})
</button>
</div>
</div>
</div>
</div>
<!-- Workspaces Content -->
<div class="flex-1 overflow-auto scrollbar-thin p-4">
<!-- Skeleton Loading -->
<template x-if="loading && workspaces.length === 0">
<div class="space-y-3">
<template x-for="i in 4" :key="i">
<div class="border border-border rounded-lg p-4 animate-pulse">
<div class="flex items-start justify-between">
<div class="space-y-2 flex-1">
<div class="h-4 bg-muted rounded-md w-1/3"></div>
<div class="h-3 bg-muted rounded-md w-2/3"></div>
</div>
<div class="h-5 w-9 bg-muted rounded-full"></div>
</div>
</div>
</template>
</div>
</template>
<!-- No Agent Selected -->
<template x-if="!loading && !selectedAgent">
<div class="flex flex-col items-center justify-center py-20 gap-3 text-muted-foreground">
@icon.Database(icon.Props{Class: "size-12 opacity-20"})
<span class="text-sm font-medium">{ i18n.T(ctx, "Select an agent to manage workspaces") }</span>
<span class="text-xs">{ i18n.T(ctx, "Choose an agent from the dropdown above to get started.") }</span>
</div>
</template>
<!-- No Workspaces Available -->
<template x-if="!loading && selectedAgent && workspaces.length === 0">
<div class="flex flex-col items-center justify-center py-20 gap-3 text-muted-foreground">
@icon.PackageOpen(icon.Props{Class: "size-12 opacity-20"})
<span class="text-sm font-medium">{ i18n.T(ctx, "No workspaces available") }</span>
<span class="text-xs">{ i18n.T(ctx, "Create workspaces in the Knowledge Base section first.") }</span>
</div>
</template>
<!-- No Search Results -->
<template x-if="!loading && filteredWorkspaces.length === 0 && workspaces.length > 0">
<div class="flex flex-col items-center justify-center py-20 gap-3 text-muted-foreground">
@icon.SearchX(icon.Props{Class: "size-12 opacity-20"})
<span class="text-sm font-medium">{ i18n.T(ctx, "No results found") }</span>
<span class="text-xs">{ i18n.T(ctx, "Try adjusting your search.") }</span>
</div>
</template>
<!-- Workspaces List -->
<template x-if="filteredWorkspaces.length > 0">
<div>
<!-- Info Banner -->
<div class="flex items-start gap-2 p-3 rounded-lg bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800 mb-4">
@icon.Info(icon.Props{Class: "size-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5"})
<p class="text-xs text-blue-700 dark:text-blue-300">
{ i18n.T(ctx, "Attach workspaces to give this agent access to their knowledge base. You must also enable the Knowledge Base tool set in the Tools dialog for the agent to query these workspaces.") }
</p>
</div>
<!-- Stats Header -->
<div class="flex items-center justify-between mb-4">
<p class="text-sm text-muted-foreground">
<span class="font-medium text-foreground" x-text="filteredWorkspaces.length"></span> { i18n.T(ctx, "workspaces") }
<template x-if="search">
<span> &middot; { i18n.T(ctx, "matching") } &ldquo;<span class="font-medium text-foreground" x-text="search"></span>&rdquo;</span>
</template>
</p>
</div>
<!-- Workspace Cards -->
<div class="space-y-2">
<template x-for="workspace in filteredWorkspaces" :key="workspace.id">
<div
class="group border rounded-lg overflow-hidden transition-all duration-200 border-l-[3px] hover:shadow-md"
:class="workspace.enabled ? 'border-border border-l-primary bg-card' : 'border-border border-l-border opacity-70'"
>
<div class="flex items-center justify-between gap-4 p-4">
<div class="flex items-start gap-3 flex-1 min-w-0">
<div
class="size-9 rounded-lg flex items-center justify-center shrink-0"
:class="workspace.enabled ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'"
>
@icon.Database(icon.Props{Class: "size-4"})
</div>
<div class="flex flex-col gap-0.5 flex-1 min-w-0">
<div class="flex items-center gap-2">
<span x-text="workspace.name" class="text-sm font-semibold text-foreground truncate"></span>
<template x-if="workspace.is_active">
<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">active</span>
</template>
</div>
<template x-if="workspace.description">
<p x-text="workspace.description" class="text-xs text-muted-foreground line-clamp-1"></p>
</template>
<div class="flex items-center gap-2 mt-0.5">
<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300" x-text="workspace.slug"></span>
<span class="text-[10px] text-muted-foreground font-mono" x-text="workspace.id.substring(0, 8) + '...'"></span>
</div>
</div>
</div>
<div class="flex items-center gap-2 shrink-0">
<button
@click="toggleWorkspace(workspace)"
class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
:class="workspace.enabled ? 'bg-primary' : 'bg-input'"
role="switch"
:aria-checked="workspace.enabled"
:aria-label="workspace.name"
>
<span
class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
:class="workspace.enabled ? 'translate-x-4' : 'translate-x-0'"
></span>
</button>
</div>
</div>
</div>
</template>
</div>
</div>
</template>
</div>
@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
<div class="flex items-center justify-between w-full">
<div class="flex items-center gap-3 text-xs text-muted-foreground" x-show="workspaces.length > 0">
<span class="flex items-center gap-1.5">
<span class="size-1.5 rounded-full bg-primary"></span>
<span x-text="enabledSummary.enabled"></span>/<span x-text="enabledSummary.total"></span> { i18n.T(ctx, "workspaces attached") }
</span>
</div>
<div x-show="workspaces.length === 0"></div>
@dialog.Close() {
@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
{ i18n.T(ctx, "Close") }
}
}
</div>
}
}
}
</div>
}

templ ResourcesButtonTrigger() {
@dialog.Trigger(dialog.TriggerProps{
For: "resources-manager-dialog",
}) {
@button.Button(button.Props{
Size:    button.SizeIcon,
Variant: button.VariantGhost,
Class:   "size-9",
Attributes: templ.Attributes{
"@click": "$dispatch('open-resources-dialog')",
"title":  i18n.T(ctx, "Knowledge Workspaces"),
},
}) {
@icon.Database(icon.Props{Class: "size-5"})
<span class="sr-only">{ i18n.T(ctx, "Knowledge Workspaces") }</span>
}
}
}
