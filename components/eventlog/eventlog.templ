package eventlog

templ EventLog() {
	<!-- Event Log Toggle Button (Fixed Position) -->
	<button
		@click="toggleEventLog()"
		class="fixed bottom-4 right-4 p-3 rounded-full shadow-lg hover:shadow-xl transition-all z-50 bg-primary text-primary-foreground hover:bg-primary/90"
		title="Toggle Event Log"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 6h16M4 12h16M4 18h16"></path>
		</svg>
	</button>
	<!-- Event Log Panel (Collapsible Overlay) -->
	<div
		x-show="showEventLog"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 translate-y-4"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-4"
		class="fixed bottom-20 right-4 w-96 max-h-[600px] bg-card border rounded-lg shadow-2xl z-40 flex flex-col"
		@click.outside="showEventLog = false"
	>
		<!-- Header -->
		<div class="flex items-center justify-between p-3 border-b bg-muted/30">
			<div class="flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
					<path d="M3 3v18h18"></path>
					<path d="m19 9-5 5-4-4-3 3"></path>
				</svg>
				<h3 class="font-semibold text-sm">Event Log</h3>
				<span class="text-xs text-muted-foreground" x-text="`(${events.length})`"></span>
			</div>
			<div class="flex items-center gap-2">
				<button
					@click="copy()"
					class="p-1 hover:bg-muted rounded text-xs transition-all"
					:class="eventLogCopied ? 'text-primary' : 'text-muted-foreground hover:text-foreground'"
					title="Copy log"
				>
					<svg x-show="!eventLogCopied" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
						<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
					</svg>
					<svg x-show="eventLogCopied" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 6 9 17l-5-5"></path>
					</svg>
				</button>
				<button
					@click="clear()"
					class="p-1 hover:bg-muted rounded text-xs text-muted-foreground hover:text-foreground transition-colors"
					title="Clear log"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3 6h18"></path>
						<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
						<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
					</svg>
				</button>
				<button
					@click="showEventLog = false"
					class="p-1 hover:bg-muted rounded text-muted-foreground hover:text-foreground transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 6 6 18"></path>
						<path d="m6 6 12 12"></path>
					</svg>
				</button>
			</div>
		</div>
		<!-- Event List -->
		<div class="flex-1 overflow-y-auto p-3 space-y-2 font-mono text-xs" x-ref="eventLogContainer">
			<template x-for="event in events" :key="event.id">
				<div class="p-3 bg-muted/30 hover:bg-muted/50 rounded-lg border border-border/50 hover:border-border transition-all">
					<div class="flex items-start justify-between gap-2 mb-2">
						<div class="flex items-center gap-2">
							<span class="text-muted-foreground/80 whitespace-nowrap text-[10px]" x-text="event.time"></span>
							<span class="font-bold px-2 py-0.5 rounded" :class="getEventTypeColor(event.type)" x-text="event.type"></span>
						</div>
						<span class="text-[10px] text-muted-foreground/60" x-text="`ID: ${event.id.slice(-6)}`"></span>
					</div>
					<div class="space-y-1.5 text-[11px]" x-show="Object.keys(event.data).length > 0">
						<template x-for="(value, key) in event.data" :key="key">
							<div class="flex gap-2 items-start">
								<span class="text-primary/80 font-semibold min-w-[80px]" x-text="key + ':'"></span>
								<template x-if="typeof value === 'string' && value.length > 100">
									<div class="flex-1">
										<div class="text-muted-foreground break-all" x-text="value.substring(0, 100) + '...'"></div>
										<button
											@click="navigator.clipboard.writeText(value); alert('Copied to clipboard!')"
											class="text-primary/60 hover:text-primary text-[10px] mt-1 underline"
										>
											Copy full value
										</button>
									</div>
								</template>
								<template x-if="typeof value === 'object'">
									<div class="flex-1">
										<pre class="text-muted-foreground bg-background/50 p-1.5 rounded text-[10px] overflow-x-auto" x-text="JSON.stringify(value, null, 2)"></pre>
									</div>
								</template>
								<template x-if="typeof value !== 'object' && (typeof value !== 'string' || value.length <= 100)">
									<span class="text-muted-foreground break-all flex-1" x-text="value"></span>
								</template>
							</div>
						</template>
					</div>
				</div>
			</template>
			<div x-show="!hasEvents" class="text-center text-muted-foreground py-8">
				No events yet
			</div>
		</div>
	</div>
}
