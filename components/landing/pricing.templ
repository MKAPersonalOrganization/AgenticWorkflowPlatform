package landing

import (
	"school-with-ai/components/button"
	"school-with-ai/domain"
)

// ─── Pricing Section ─────────────────────────────────────────────────────────
templ pricingSection(user *domain.User) {
	<section id="pricing" class="border-t border-border bg-muted/20 py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					Simple, transparent pricing
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					One plan. Full access. No hidden fees.
				</p>
			</div>
			<div class="mx-auto mt-12 max-w-md">
				<div class="rounded-2xl border-2 border-primary bg-card p-8 shadow-xl shadow-primary/5">
					<div class="text-center">
						<h3 class="text-xl font-bold">Full Access</h3>
						<div class="mt-4 flex items-baseline justify-center gap-2">
							<span class="text-5xl font-bold tracking-tight">$5</span>
							<span class="text-base text-muted-foreground">/month</span>
						</div>
						<p class="mt-3 text-sm text-muted-foreground">Everything you need, nothing you don't.</p>
					</div>
					<ul class="mt-8 space-y-4">
						@checkListItem("All AI models — GPT-4o, Claude Sonnet 4, Gemini 2.0 and more")
						@checkListItem("All Agent Store access — browse, fork, create unlimited agents")
						@checkListItem("All built-in plugins with per-agent configuration")
						@checkListItem("Full MCP connector support for external tool integrations")
						@checkListItem("Knowledge base with multi-workspace RAG & knowledge graphs")
						@checkListItem("Lifelike AI voices with word-synchronized Text-to-Speech")
						@checkListItem("Personalized profile with adaptive communication")
						@checkListItem("Long-term memory and artifact generation")
						@checkListItem("Priority support — cancel anytime")
					</ul>
					<div class="mt-8">
						if user != nil {
							@button.Button(button.Props{
								Href:      "/pricing",
								FullWidth: true,
								Size:      button.SizeLg,
							}) {
								@iconRocket
								<span>Activate Now</span>
							}
						} else {
							@button.Button(button.Props{
								Href:      "/auth/login",
								FullWidth: true,
								Size:      button.SizeLg,
							}) {
								@iconRocket
								<span>Get Started</span>
							}
						}
					</div>
					<p class="mt-4 text-center text-xs text-muted-foreground">
						Secure payment powered by Stripe. Your card details never touch our servers.
					</p>
				</div>
			</div>
		</div>
	</section>
}
