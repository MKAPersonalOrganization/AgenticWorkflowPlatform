package landing

import (
	"school-with-ai/components/button"
	"school-with-ai/components/icon"
	"school-with-ai/domain"
)

// Nav renders the sticky navigation bar shared between landing and docs pages.
templ Nav(user *domain.User) {
	<nav class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-xl">
		<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
			<!-- Logo -->
			<a href="/" class="flex items-center gap-2.5 group">
				<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
					@icon.CompassLogoAnimated("size-5", "")
				</div>
				<span class="text-xl font-bold tracking-tight">Compass.AI</span>
			</a>
			<!-- Links -->
			<div class="hidden items-center gap-8 md:flex">
				<a href="/#features" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Features</a>
				<a href="/#agents" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Agent Store</a>
				<a href="/#models" class="text-sm text-muted-foreground transition-colors hover:text-foreground">AI Models</a>
				<a href="/#integrations" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Integrations</a>
				<a href="/#pricing" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Pricing</a>
				<a href="/docs" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Docs</a>
			</div>
			<!-- CTA -->
			<div class="flex items-center gap-3">
				<!-- Theme Toggle -->
				<button
					@click="toggleTheme()"
					class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
					type="button"
					title="Toggle theme"
				>
					<!-- Sun icon (light) -->
					<svg x-show="theme === 'light'" x-cloak class="size-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
					</svg>
					<!-- Moon icon (dark) -->
					<svg x-show="theme === 'dark'" x-cloak class="size-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
					</svg>
					<!-- Monitor icon (system) -->
					<svg x-show="theme === 'system'" x-cloak class="size-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
					</svg>
				</button>
				if user != nil {
					@button.Button(button.Props{
						Href:    "/chat",
						Variant: button.VariantDefault,
						Size:    button.SizeDefault,
					}) {
						<span>Go to App</span>
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					}
				} else {
					@button.Button(button.Props{
						Href:    "/auth/login",
						Variant: button.VariantGhost,
						Size:    button.SizeDefault,
					}) {
						<span>Sign In</span>
					}
					@button.Button(button.Props{
						Href:    "/auth/login",
						Variant: button.VariantDefault,
						Size:    button.SizeDefault,
					}) {
						<span>Get Started Free</span>
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					}
				}
			</div>
		</div>
	</nav>
}
