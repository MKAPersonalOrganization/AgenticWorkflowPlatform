package landing

import (
	"school-with-ai/components/button"
	"school-with-ai/components/icon"
	"school-with-ai/domain"
)

// Nav renders the sticky navigation bar shared between landing and docs pages.
templ Nav(user *domain.User) {
	<nav class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-xl">
		<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
			<!-- Logo -->
			<a href="/" class="flex items-center gap-2.5">
				<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
					@iconCompass
				</div>
				<span class="text-xl font-bold tracking-tight">Compass</span>
			</a>
			<!-- Links -->
			<div class="hidden items-center gap-8 md:flex">
				<a href="/#features" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Features</a>
				<a href="/#agents" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Agent Store</a>
				<a href="/#models" class="text-sm text-muted-foreground transition-colors hover:text-foreground">AI Models</a>
				<a href="/#integrations" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Integrations</a>
				<a href="/#pricing" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Pricing</a>
				<a href="/docs" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Docs</a>
			</div>
			<!-- CTA -->
			<div class="flex items-center gap-3">
				if user != nil {
					@button.Button(button.Props{
						Href:    "/chat",
						Variant: button.VariantDefault,
						Size:    button.SizeDefault,
					}) {
						<span>Go to App</span>
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					}
				} else {
					@button.Button(button.Props{
						Href:    "/auth/login",
						Variant: button.VariantGhost,
						Size:    button.SizeDefault,
					}) {
						<span>Sign In</span>
					}
					@button.Button(button.Props{
						Href:    "/auth/login",
						Variant: button.VariantDefault,
						Size:    button.SizeDefault,
					}) {
						<span>Get Started Free</span>
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					}
				}
			</div>
		</div>
	</nav>
}
