package landing

import (
	"school-with-ai/components"
	"school-with-ai/components/button"
	"school-with-ai/components/icon"
	"school-with-ai/domain"
)

type LandingPageProps struct {
	User *domain.User
}

templ LandingPage(props LandingPageProps) {
	@components.BaseLayout(components.LayoutProps{
		Title:      "Your AI-Powered Learning Platform",
		User:       props.User,
		HideNavbar: true,
	}) {
		<div class="h-full overflow-y-auto scroll-smooth" id="landing-root">
			<!-- Sticky Navbar -->
			@landingNav(props.User)
			<!-- Hero Section -->
			@heroSection(props.User)
			<!-- Trusted By / Social Proof -->
			@socialProofBar()
			<!-- Features Grid -->
			@featuresSection()
			<!-- Agent Store Showcase -->
			@agentStoreSection()
			<!-- MCP Integration Section -->
			@mcpSection()
			<!-- Plugin System Section -->
			@pluginSection()
			<!-- Knowledge Base Section -->
			@knowledgeBaseSection()
			<!-- Pricing Section -->
			@pricingSection(props.User)
			<!-- CTA Section -->
			@ctaSection(props.User)
			<!-- Footer -->
			@landingFooter()
		</div>
	}
}

// ─── Navbar ──────────────────────────────────────────────────────────────────
templ landingNav(user *domain.User) {
	<nav class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-xl">
		<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
			<!-- Logo -->
			<a href="/" class="flex items-center gap-2.5">
				<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
					@iconCompass
				</div>
				<span class="text-xl font-bold tracking-tight">Compass</span>
			</a>
			<!-- Links -->
			<div class="hidden items-center gap-8 md:flex">
				<a href="#features" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Features</a>
				<a href="#agents" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Agent Store</a>
				<a href="#integrations" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Integrations</a>
				<a href="#pricing" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Pricing</a>
				<a href="/docs" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Docs</a>
			</div>
			<!-- CTA -->
			<div class="flex items-center gap-3">
				if user != nil {
					@button.Button(button.Props{
						Href:    "/chat",
						Variant: button.VariantDefault,
						Size:    button.SizeDefault,
					}) {
						<span>Go to App</span>
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					}
				} else {
					@button.Button(button.Props{
						Href:    "/auth/login",
						Variant: button.VariantGhost,
						Size:    button.SizeDefault,
					}) {
						<span>Sign In</span>
					}
					@button.Button(button.Props{
						Href:    "/auth/login",
						Variant: button.VariantDefault,
						Size:    button.SizeDefault,
					}) {
						<span>Get Started Free</span>
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					}
				}
			</div>
		</div>
	</nav>
}

// ─── Hero Section ────────────────────────────────────────────────────────────
templ heroSection(user *domain.User) {
	<section class="relative overflow-hidden">
		<!-- Background gradient -->
		<div class="pointer-events-none absolute inset-0 -z-10">
			<div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent"></div>
			<div class="absolute left-1/2 top-0 -translate-x-1/2 h-[600px] w-[900px] rounded-full bg-primary/5 blur-3xl"></div>
		</div>
		<div class="mx-auto max-w-7xl px-4 pb-20 pt-24 sm:px-6 sm:pt-32 lg:px-8 lg:pt-40">
			<div class="mx-auto max-w-3xl text-center">
				<!-- Badge -->
				<div class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
					@icon.Sparkles(icon.Props{Class: "size-4 text-primary"})
					<span>Powered by cutting-edge AI models</span>
				</div>
				<!-- Heading -->
				<h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
					Your Intelligent
					<span class="bg-linear-to-r from-primary to-primary/60 bg-clip-text text-transparent">Learning Companion</span>
				</h1>
				<!-- Subheading -->
				<p class="mt-6 text-lg leading-relaxed text-muted-foreground sm:text-xl">
					Compass brings together AI agents, a powerful plugin system, knowledge bases, and MCP integrations — all in one beautiful platform designed to supercharge your learning and productivity.
				</p>
				<!-- CTA Buttons -->
				<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
					if user != nil {
						@button.Button(button.Props{
							Href: "/chat",
							Size: button.SizeLg,
						}) {
							<span>Open Compass</span>
							@icon.ArrowRight(icon.Props{Class: "size-5"})
						}
					} else {
						@button.Button(button.Props{
							Href: "/auth/login",
							Size: button.SizeLg,
						}) {
							<span>Start for Free</span>
							@icon.ArrowRight(icon.Props{Class: "size-5"})
						}
					}
					@button.Button(button.Props{
						Href:    "/docs",
						Variant: button.VariantOutline,
						Size:    button.SizeLg,
					}) {
						@icon.BookOpen(icon.Props{Class: "size-5"})
						<span>Read the Docs</span>
					}
				</div>
			</div>
			<!-- Hero visual — Compass illustration -->
			<div class="mx-auto mt-20 max-w-4xl">
				<div class="relative rounded-xl border border-border bg-card p-1 shadow-2xl shadow-primary/5">
					<div class="overflow-hidden rounded-lg bg-background">
						<!-- Mock app screenshot -->
						<div class="flex h-[400px] flex-col sm:h-[500px]">
							<!-- Mock top bar -->
							<div class="flex items-center gap-2 border-b border-border px-4 py-3">
								<div class="flex gap-1.5">
									<div class="h-3 w-3 rounded-full bg-red-400/60"></div>
									<div class="h-3 w-3 rounded-full bg-yellow-400/60"></div>
									<div class="h-3 w-3 rounded-full bg-green-400/60"></div>
								</div>
								<div class="ml-4 flex-1">
									<div class="mx-auto h-6 w-60 rounded-md bg-muted/50"></div>
								</div>
							</div>
							<!-- Mock sidebar + chat -->
							<div class="flex flex-1">
								<!-- Sidebar -->
								<div class="hidden w-12 flex-col items-center gap-4 border-r border-border py-4 sm:flex">
									<div class="h-6 w-6 rounded bg-primary/20"></div>
									<div class="h-6 w-6 rounded bg-muted"></div>
									<div class="h-6 w-6 rounded bg-muted"></div>
									<div class="h-6 w-6 rounded bg-muted"></div>
								</div>
								<!-- Chat area -->
								<div class="flex flex-1 flex-col justify-between p-6">
									<div class="space-y-4">
										<!-- User message -->
										<div class="flex justify-end">
											<div class="max-w-xs rounded-xl bg-primary px-4 py-2.5 text-sm text-primary-foreground">
												Explain quantum entanglement simply
											</div>
										</div>
										<!-- AI response -->
										<div class="flex justify-start">
											<div class="max-w-sm rounded-xl bg-muted px-4 py-2.5 text-sm">
												<div class="flex items-center gap-2 mb-2">
													@icon.Bot(icon.Props{Class: "size-4 text-primary"})
													<span class="font-medium text-xs text-muted-foreground">Physics Tutor</span>
												</div>
												Imagine two coins that are magically linked — no matter how far apart they are, when you flip one to heads, the other instantly becomes tails...
											</div>
										</div>
										<!-- Another user message -->
										<div class="flex justify-end">
											<div class="max-w-xs rounded-xl bg-primary px-4 py-2.5 text-sm text-primary-foreground">
												Can you visualize that with a diagram?
											</div>
										</div>
										<!-- AI with tool usage -->
										<div class="flex justify-start">
											<div class="max-w-sm rounded-xl bg-muted px-4 py-2.5 text-sm">
												<div class="flex items-center gap-2 text-xs text-muted-foreground mb-1">
													@icon.Wand(icon.Props{Class: "size-3 text-primary"})
													<span>Using visualization tool...</span>
												</div>
												<div class="h-24 w-full rounded-md bg-primary/10 border border-primary/20 flex items-center justify-center">
													<span class="text-xs text-muted-foreground">📊 Interactive Diagram</span>
												</div>
											</div>
										</div>
									</div>
									<!-- Input bar mock -->
									<div class="mt-4 flex items-center gap-2 rounded-xl border border-border bg-background px-4 py-3">
										<div class="flex-1 text-sm text-muted-foreground/50">Ask anything...</div>
										<div class="h-8 w-8 rounded-lg bg-primary flex items-center justify-center">
											@icon.ArrowRight(icon.Props{Class: "size-4 text-primary-foreground"})
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// ─── Social Proof ────────────────────────────────────────────────────────────
templ socialProofBar() {
	<section class="border-y border-border bg-muted/30 py-10">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 gap-8 md:grid-cols-4">
				@statItem("10+", "Built-in Plugins")
				@statItem("100+", "Agent Templates")
				@statItem("MCP", "Protocol Support")
				@statItem("∞", "Custom Agents")
			</div>
		</div>
	</section>
}

templ statItem(value, label string) {
	<div class="text-center">
		<div class="text-3xl font-bold tracking-tight text-foreground">{ value }</div>
		<div class="mt-1 text-sm text-muted-foreground">{ label }</div>
	</div>
}

// ─── Features Section ────────────────────────────────────────────────────────
templ featuresSection() {
	<section id="features" class="py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
					@icon.Zap(icon.Props{Class: "size-4 text-primary"})
					<span>Core Capabilities</span>
				</div>
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					Everything you need, in one platform
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					From AI-powered conversations to knowledge management, Compass delivers a complete learning ecosystem.
				</p>
			</div>
			<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				@featureCard(
					"Multi-Agent AI Chat",
					"Converse with specialized AI agents powered by the latest models. Stream responses in real-time with full tool execution support.",
					"text-blue-500",
					iconMessageSq,
				)
				@featureCard(
					"Agent Store",
					"Browse, search, and fork from 100+ pre-built agent templates. Create your own custom agents with tailored system prompts and tool configurations.",
					"text-purple-500",
					iconStore,
				)
				@featureCard(
					"Plugin System",
					"10 built-in plugins including Calculator, Codebase, Visualization, TTS, and more. Each agent gets its own tool configuration.",
					"text-green-500",
					iconPuzzle,
				)
				@featureCard(
					"MCP Protocol",
					"Connect to external MCP servers with full OAuth 2.1 support. Auto-discover and use remote tools seamlessly.",
					"text-orange-500",
					iconPlug,
				)
				@featureCard(
					"Knowledge Base (RAG)",
					"Upload documents, build knowledge graphs, and let AI query your personal knowledge base with multi-workspace support.",
					"text-pink-500",
					iconDatabase,
				)
				@featureCard(
					"Event-Sourced Architecture",
					"Every action is an event. Full audit trail, time-travel debugging, and reliable state reconstruction built into the core.",
					"text-cyan-500",
					iconLayers,
				)
				@featureCard(
					"Artifacts & Memory",
					"Generate downloadable artifacts per thread. Long-term memory persists across conversations for continuity.",
					"text-amber-500",
					iconBrain,
				)
				@featureCard(
					"Internationalization",
					"Full multi-language support with RTL layouts. Arabic, English, and more — your language, your direction.",
					"text-teal-500",
					iconLanguages,
				)
				@featureCard(
					"Enterprise Security",
					"TLS encryption, per-IP rate limiting, SSRF protection, encrypted OAuth tokens at rest, and PCI SAQ-A compliant payments.",
					"text-red-500",
					iconShieldCheck,
				)
			</div>
		</div>
	</section>
}

templ featureCard(title, description, colorClass string, iconComp templ.Component) {
	<div class="group relative rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5">
		<div class={ "mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-muted", colorClass }>
			@iconComp
		</div>
		<h3 class="text-lg font-semibold">{ title }</h3>
		<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{ description }</p>
	</div>
}

// ─── Agent Store ─────────────────────────────────────────────────────────────
templ agentStoreSection() {
	<section id="agents" class="border-t border-border bg-muted/20 py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<!-- Text content -->
				<div>
					<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-1.5 text-sm text-muted-foreground">
						@icon.Bot(icon.Props{Class: "size-4 text-purple-500"})
						<span>Agent Store</span>
					</div>
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
						Discover and create
						<span class="text-primary">AI agents</span>
					</h2>
					<p class="mt-4 text-lg text-muted-foreground">
						Browse our curated catalog of specialized agents, or build your own from scratch. Each agent can have its own model, tools, knowledge base access, and personality.
					</p>
					<ul class="mt-8 space-y-4">
						@checkListItem("Browse 100+ pre-built agent templates by category")
						@checkListItem("Fork and customize any catalog agent to make it yours")
						@checkListItem("Configure system prompts, models, and temperature per agent")
						@checkListItem("Assign specific tool sets and knowledge workspaces per agent")
						@checkListItem("Share your creations with the community")
					</ul>
				</div>
				<!-- Visual card grid -->
				<div class="grid grid-cols-2 gap-4">
					@agentPreviewCard("🧮", "Math Tutor", "Expert in algebra, calculus, and problem solving", "text-blue-500")
					@agentPreviewCard("🔬", "Science Guide", "Physics, chemistry, and biology companion", "text-green-500")
					@agentPreviewCard("✍️", "Writing Coach", "Improve your essays, stories, and reports", "text-purple-500")
					@agentPreviewCard("💻", "Code Mentor", "Debug, explain, and write code together", "text-orange-500")
					@agentPreviewCard("🌍", "History Explorer", "Journey through civilizations and events", "text-amber-500")
					@agentPreviewCard("🎨", "Creative Studio", "Art, design, and creative thinking", "text-pink-500")
				</div>
			</div>
		</div>
	</section>
}

templ checkListItem(text string) {
	<li class="flex items-start gap-3">
		<div class="mt-1">
			@icon.Check(icon.Props{Class: "size-5 text-primary shrink-0"})
		</div>
		<span class="text-sm leading-relaxed text-muted-foreground">{ text }</span>
	</li>
}

templ agentPreviewCard(emoji, name, desc, borderColor string) {
	<div class={ "rounded-xl border border-border bg-card p-4 transition-all hover:border-primary/30 hover:shadow-md" }>
		<div class="text-2xl mb-2">{ emoji }</div>
		<h4 class="font-semibold text-sm">{ name }</h4>
		<p class="mt-1 text-xs text-muted-foreground line-clamp-2">{ desc }</p>
	</div>
}

// ─── MCP Integration ─────────────────────────────────────────────────────────
templ mcpSection() {
	<section id="integrations" class="py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<!-- Visual -->
				<div class="order-2 lg:order-1">
					<div class="rounded-xl border border-border bg-card p-6">
						<div class="space-y-4">
							@mcpConnectorRow("GitHub Copilot MCP", "connected", "github.com")
							@mcpConnectorRow("Notion Workspace", "connected", "notion.so")
							@mcpConnectorRow("Slack Integration", "auth_required", "slack.com")
							@mcpConnectorRow("Custom API Server", "connecting", "api.example.com")
						</div>
						<div class="mt-6 rounded-lg border border-dashed border-border bg-muted/30 p-4 text-center">
							<div class="flex items-center justify-center gap-2 text-sm text-muted-foreground">
								@icon.Plug(icon.Props{Class: "size-4"})
								<span>Add MCP Connector...</span>
							</div>
						</div>
					</div>
				</div>
				<!-- Text content -->
				<div class="order-1 lg:order-2">
					<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
						@icon.Network(icon.Props{Class: "size-4 text-orange-500"})
						<span>Model Context Protocol</span>
					</div>
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
						Connect to any
						<span class="text-primary">MCP server</span>
					</h2>
					<p class="mt-4 text-lg text-muted-foreground">
						The Model Context Protocol lets you extend Compass with external tools and data sources. Connect to GitHub, Notion, Slack, or your own custom servers.
					</p>
					<ul class="mt-8 space-y-4">
						@checkListItem("Full OAuth 2.1 Authorization Code + PKCE flow")
						@checkListItem("Automatic tool discovery from remote servers")
						@checkListItem("Authenticated reverse proxy for secure communication")
						@checkListItem("Preset catalog of popular MCP connectors")
						@checkListItem("SSRF protection and encrypted tokens at rest")
					</ul>
				</div>
			</div>
		</div>
	</section>
}

templ mcpConnectorRow(name, status, url string) {
	<div class="flex items-center justify-between rounded-lg border border-border bg-background px-4 py-3">
		<div class="flex items-center gap-3">
			@icon.Server(icon.Props{Class: "size-4 text-muted-foreground"})
			<div>
				<div class="text-sm font-medium">{ name }</div>
				<div class="text-xs text-muted-foreground">{ url }</div>
			</div>
		</div>
		<div class="flex items-center gap-2">
			switch status {
				case "connected":
					<div class="h-2 w-2 rounded-full bg-green-500"></div>
					<span class="text-xs text-green-600 dark:text-green-400">Connected</span>
				case "auth_required":
					<div class="h-2 w-2 rounded-full bg-yellow-500"></div>
					<span class="text-xs text-yellow-600 dark:text-yellow-400">Auth Required</span>
				case "connecting":
					<div class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></div>
					<span class="text-xs text-blue-600 dark:text-blue-400">Connecting</span>
			}
		</div>
	</div>
}

// ─── Plugin System ───────────────────────────────────────────────────────────
templ pluginSection() {
	<section class="border-t border-border bg-muted/20 py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-1.5 text-sm text-muted-foreground">
					@icon.Puzzle(icon.Props{Class: "size-4 text-green-500"})
					<span>Plugin Ecosystem</span>
				</div>
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					10 built-in plugins, infinite possibilities
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					Each plugin adds specialized tools that your agents can use. Toggle them per-agent for fine-grained control.
				</p>
			</div>
			<div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
				@pluginPill("🧮", "Calculator", "Math & computation")
				@pluginPill("💻", "Codebase", "Code analysis")
				@pluginPill("🧠", "Cognitive", "Reasoning tools")
				@pluginPill("📄", "Document", "File processing")
				@pluginPill("❓", "Elicitation", "Smart follow-ups")
				@pluginPill("📚", "Knowledge Base", "RAG queries")
				@pluginPill("📖", "Library", "Reference materials")
				@pluginPill("💾", "Memory", "Long-term recall")
				@pluginPill("🔊", "Text-to-Speech", "Voice output")
				@pluginPill("📊", "Visualization", "Charts & diagrams")
			</div>
		</div>
	</section>
}

templ pluginPill(emoji, name, desc string) {
	<div class="flex items-center gap-3 rounded-xl border border-border bg-card p-4 transition-all hover:border-primary/30 hover:shadow-md">
		<div class="text-xl shrink-0">{ emoji }</div>
		<div class="min-w-0">
			<div class="text-sm font-semibold truncate">{ name }</div>
			<div class="text-xs text-muted-foreground truncate">{ desc }</div>
		</div>
	</div>
}

// ─── Knowledge Base ──────────────────────────────────────────────────────────
templ knowledgeBaseSection() {
	<section class="py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<!-- Text -->
				<div>
					<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
						@icon.Database(icon.Props{Class: "size-4 text-pink-500"})
						<span>Knowledge Base</span>
					</div>
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
						Your documents, your
						<span class="text-primary">knowledge graph</span>
					</h2>
					<p class="mt-4 text-lg text-muted-foreground">
						Upload PDFs, documents, and text files. Compass builds a searchable knowledge graph with vector embeddings, so your AI agents can give answers grounded in your own data.
					</p>
					<ul class="mt-8 space-y-4">
						@checkListItem("Multi-workspace document management")
						@checkListItem("Automatic PDF processing and indexing")
						@checkListItem("Interactive knowledge graph visualization")
						@checkListItem("Per-agent workspace access controls")
						@checkListItem("Pipeline monitoring and queue management")
					</ul>
				</div>
				<!-- Visual -->
				<div class="rounded-xl border border-border bg-card p-6">
					<div class="mb-4 flex items-center justify-between">
						<h4 class="text-sm font-semibold">Knowledge Workspaces</h4>
						<span class="text-xs text-muted-foreground">3 workspaces</span>
					</div>
					<div class="space-y-3">
						@workspaceRow("Physics Notes", "42 documents", "2.1 GB", "bg-blue-500")
						@workspaceRow("History Research", "128 documents", "5.4 GB", "bg-amber-500")
						@workspaceRow("Programming Guides", "67 documents", "1.8 GB", "bg-green-500")
					</div>
					<div class="mt-4 rounded-lg border border-border bg-muted/30 p-4">
						<div class="flex items-center gap-2 text-xs text-muted-foreground mb-3">
							@icon.Network(icon.Props{Class: "size-3"})
							<span>Knowledge Graph Preview</span>
						</div>
						<div class="h-32 rounded-md bg-linear-to-br from-primary/5 to-primary/10 flex items-center justify-center">
							<div class="flex items-center gap-6 text-muted-foreground/50">
								<div class="h-4 w-4 rounded-full bg-primary/40"></div>
								<div class="h-1 w-12 bg-primary/20 rounded"></div>
								<div class="h-3 w-3 rounded-full bg-primary/30"></div>
								<div class="h-1 w-8 bg-primary/20 rounded"></div>
								<div class="h-5 w-5 rounded-full bg-primary/50"></div>
								<div class="h-1 w-10 bg-primary/20 rounded"></div>
								<div class="h-3 w-3 rounded-full bg-primary/20"></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ workspaceRow(name, docs, size, dotColor string) {
	<div class="flex items-center justify-between rounded-lg border border-border bg-background px-4 py-3">
		<div class="flex items-center gap-3">
			<div class={ "h-2.5 w-2.5 rounded-full", dotColor }></div>
			<div>
				<div class="text-sm font-medium">{ name }</div>
				<div class="text-xs text-muted-foreground">{ docs }</div>
			</div>
		</div>
		<span class="text-xs text-muted-foreground">{ size }</span>
	</div>
}

// ─── Pricing Section ─────────────────────────────────────────────────────────
templ pricingSection(user *domain.User) {
	<section id="pricing" class="border-t border-border bg-muted/20 py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					Simple, transparent pricing
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					One plan. Full access. No hidden fees.
				</p>
			</div>
			<div class="mx-auto mt-12 max-w-md">
				<div class="rounded-2xl border-2 border-primary bg-card p-8 shadow-xl shadow-primary/5">
					<div class="text-center">
						<h3 class="text-xl font-bold">Full Access</h3>
						<div class="mt-4 flex items-baseline justify-center gap-2">
							<span class="text-5xl font-bold tracking-tight">$5</span>
							<span class="text-base text-muted-foreground">/month</span>
						</div>
						<p class="mt-3 text-sm text-muted-foreground">Everything you need, nothing you don't.</p>
					</div>
					<ul class="mt-8 space-y-4">
						@checkListItem("Unlimited conversations with all AI models")
						@checkListItem("Full Agent Store access — browse, fork, create")
						@checkListItem("All 10 built-in plugins enabled")
						@checkListItem("MCP connector support (up to 10 servers)")
						@checkListItem("Knowledge base with multi-workspace RAG")
						@checkListItem("Long-term memory across sessions")
						@checkListItem("Artifact generation and downloads")
						@checkListItem("Priority support and cancel anytime")
					</ul>
					<div class="mt-8">
						if user != nil {
							@button.Button(button.Props{
								Href:      "/pricing",
								FullWidth: true,
								Size:      button.SizeLg,
							}) {
								@iconRocket
								<span>Activate Now</span>
							}
						} else {
							@button.Button(button.Props{
								Href:      "/auth/login",
								FullWidth: true,
								Size:      button.SizeLg,
							}) {
								@iconRocket
								<span>Get Started</span>
							}
						}
					</div>
					<p class="mt-4 text-center text-xs text-muted-foreground">
						Secure payment powered by Stripe. Your card details never touch our servers.
					</p>
				</div>
			</div>
		</div>
	</section>
}

// ─── CTA Section ─────────────────────────────────────────────────────────────
templ ctaSection(user *domain.User) {
	<section class="py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="relative overflow-hidden rounded-2xl bg-primary px-8 py-16 text-center sm:px-16">
				<!-- Decorative elements -->
				<div class="pointer-events-none absolute inset-0 z-0">
					<div class="absolute -left-20 -top-20 h-60 w-60 rounded-full bg-white/10 blur-3xl"></div>
					<div class="absolute -bottom-20 -right-20 h-60 w-60 rounded-full bg-white/10 blur-3xl"></div>
				</div>
				<div class="relative z-10">
					<h2 class="text-3xl font-bold tracking-tight text-primary-foreground sm:text-4xl">
						Ready to transform your learning?
					</h2>
					<p class="mx-auto mt-4 max-w-xl text-lg text-primary-foreground/80">
						Join thousands of learners who use Compass to study smarter, work faster, and achieve more with AI.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						if user != nil {
							@button.Button(button.Props{
								Href:    "/chat",
								Variant: button.VariantSecondary,
								Size:    button.SizeLg,
							}) {
								<span>Open Compass</span>
								@icon.ArrowRight(icon.Props{Class: "size-5"})
							}
						} else {
							@button.Button(button.Props{
								Href:    "/auth/login",
								Variant: button.VariantSecondary,
								Size:    button.SizeLg,
							}) {
								<span>Start for Free</span>
								@icon.ArrowRight(icon.Props{Class: "size-5"})
							}
						}
						@button.Button(button.Props{
							Href:    "/docs",
							Variant: button.VariantOutline,
							Size:    button.SizeLg,
							Class:   "border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/10",
						}) {
							<span>Read Documentation</span>
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}

// ─── Footer ──────────────────────────────────────────────────────────────────
templ landingFooter() {
	<footer class="border-t border-border bg-background py-12">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-8 md:grid-cols-4">
				<!-- Brand -->
				<div class="md:col-span-1">
					<div class="flex items-center gap-2.5">
						<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
							@icon.Compass(icon.Props{Class: "size-4"})
						</div>
						<span class="text-lg font-bold">Compass</span>
					</div>
					<p class="mt-3 text-sm text-muted-foreground">
						Your intelligent learning companion powered by AI.
					</p>
				</div>
				<!-- Product -->
				<div>
					<h4 class="text-sm font-semibold">Product</h4>
					<ul class="mt-3 space-y-2">
						<li><a href="#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Features</a></li>
						<li><a href="#agents" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Agent Store</a></li>
						<li><a href="#integrations" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Integrations</a></li>
						<li><a href="#pricing" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Pricing</a></li>
					</ul>
				</div>
				<!-- Resources -->
				<div>
					<h4 class="text-sm font-semibold">Resources</h4>
					<ul class="mt-3 space-y-2">
						<li><a href="/docs" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Documentation</a></li>
						<li><a href="/docs#agent-store" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Agent Store Guide</a></li>
						<li><a href="/docs#mcp" class="text-sm text-muted-foreground hover:text-foreground transition-colors">MCP Integration</a></li>
						<li><a href="/docs#plugins" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Plugin System</a></li>
					</ul>
				</div>
				<!-- Legal -->
				<div>
					<h4 class="text-sm font-semibold">Company</h4>
					<ul class="mt-3 space-y-2">
						<li><a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy Policy</a></li>
						<li><a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Service</a></li>
						<li><a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Contact</a></li>
					</ul>
				</div>
			</div>
			<div class="mt-10 border-t border-border pt-6 text-center text-sm text-muted-foreground">
				<p>&copy; 2026 Compass. All rights reserved.</p>
			</div>
		</div>
	</footer>
}
