package landing

import "aicompass/components/icon"

// ─── Voice ───────────────────────────────────────────────────
templ voiceVisualizationSection() {
	<section class="py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
					@icon.AudioWaveform(icon.Props{Class: "size-4 text-indigo-500"})
					<span>Voice Capabilities</span>
				</div>
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					Hear and Understand it.
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					Work isn't just text. Compass.AI generates lifelike voice narration to bring responses to life.
				</p>
			</div>
			<div class="mx-auto mt-16 max-w-3xl">
				<!-- Voice card -->
				<div class="rounded-xl border border-border bg-card p-6">
					<div class="flex items-center gap-3 mb-4">
						<div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-500">
							@icon.Headphones(icon.Props{Class: "size-5"})
						</div>
						<h3 class="text-lg font-semibold">AI Text-to-Speech</h3>
					</div>
					<p class="text-sm text-muted-foreground leading-relaxed mb-4">
						Convert any AI response to spoken audio with a selection of lifelike voices. Perfect for accessibility, reviewing reports, and working on the go.
					</p>
					<!-- Voice selector mock -->
					<div class="grid grid-cols-4 gap-2 mb-4">
						@voiceChip("alloy", true)
						@voiceChip("nova", false)
						@voiceChip("echo", false)
						@voiceChip("sage", false)
						@voiceChip("coral", false)
						@voiceChip("shimmer", false)
						@voiceChip("onyx", false)
						@voiceChip("fable", false)
					</div>
					<!-- Feature pills -->
					<div class="flex flex-wrap gap-2">
						<span class="inline-flex items-center gap-1 rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">
							@icon.Sparkles(icon.Props{Class: "size-3"})
							<span>Word-level timestamps</span>
						</span>
						<span class="inline-flex items-center gap-1 rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">
							@icon.Mic(icon.Props{Class: "size-3"})
							<span>Custom voice instructions</span>
						</span>
						<span class="inline-flex items-center gap-1 rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">
							@icon.Download(icon.Props{Class: "size-3"})
							<span>MP3 download</span>
						</span>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ voiceChip(name string, active bool) {
	if active {
		<div class="rounded-lg border-2 border-primary bg-primary/10 px-2 py-1.5 text-center text-xs font-medium text-primary">
			{ name }
		</div>
	} else {
		<div class="rounded-lg border border-border bg-background px-2 py-1.5 text-center text-xs text-muted-foreground">
			{ name }
		</div>
	}
}
