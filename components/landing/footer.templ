package landing

import "school-with-ai/components/icon"

// Footer renders the site footer shared between landing and docs pages.
templ Footer() {
	<footer class="border-t border-border bg-background py-12">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-8 md:grid-cols-4">
				<!-- Brand -->
				<div class="md:col-span-1">
					<div class="flex items-center gap-2.5">
						<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
							@icon.Compass(icon.Props{Class: "size-4"})
						</div>
						<span class="text-lg font-bold">Compass</span>
					</div>
					<p class="mt-3 text-sm text-muted-foreground">
						Your intelligent AI companion.
					</p>
				</div>
				<!-- Product -->
				<div>
					<h4 class="text-sm font-semibold">Product</h4>
					<ul class="mt-3 space-y-2">
						<li><a href="/#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Features</a></li>
						<li><a href="/#agents" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Agent Store</a></li>
						<li><a href="/#models" class="text-sm text-muted-foreground hover:text-foreground transition-colors">AI Models</a></li>
						<li><a href="/#integrations" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Integrations</a></li>
						<li><a href="/#learning" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Personalized Profile</a></li>
						<li><a href="/#pricing" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Pricing</a></li>
					</ul>
				</div>
				<!-- Resources -->
				<div>
					<h4 class="text-sm font-semibold">Resources</h4>
					<ul class="mt-3 space-y-2">
						<li><a href="/docs" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Documentation</a></li>
						<li><a href="/docs#ai-models" class="text-sm text-muted-foreground hover:text-foreground transition-colors">AI Models Guide</a></li>
						<li><a href="/docs#agent-store" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Agent Store Guide</a></li>
						<li><a href="/docs#mcp" class="text-sm text-muted-foreground hover:text-foreground transition-colors">MCP Integration</a></li>
						<li><a href="/docs#plugins" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Plugin System</a></li>
						<li><a href="/docs#api" class="text-sm text-muted-foreground hover:text-foreground transition-colors">API Reference</a></li>
					</ul>
				</div>
				<!-- Legal -->
				<div>
					<h4 class="text-sm font-semibold">Company</h4>
					<ul class="mt-3 space-y-2">
						<li><a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy Policy</a></li>
						<li><a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Service</a></li>
						<li><a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Contact</a></li>
					</ul>
				</div>
			</div>
			<div class="mt-10 border-t border-border pt-6 text-center text-sm text-muted-foreground">
				<p>&copy; 2026 Compass. All rights reserved.</p>
			</div>
		</div>
	</footer>
}
