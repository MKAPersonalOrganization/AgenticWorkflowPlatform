package landing

import (
	"school-with-ai/components"
	"school-with-ai/components/icon"
	"school-with-ai/domain"
)

type LandingPageProps struct {
	User *domain.User
}

templ LandingPage(props LandingPageProps) {
	@components.BaseLayout(components.LayoutProps{
		Title:      "Your Intelligent AI Companion",
		User:       props.User,
		HideNavbar: true,
	}) {
		@icon.CompassLogoCSS()
		<div class="h-full overflow-y-auto scroll-smooth" id="landing-root">
			<!-- Sticky Navbar -->
			@Nav(props.User)
			<!-- Hero Section -->
			@heroSection(props.User)
			<!-- Features Grid (Core Value Props) -->
			@featuresSection()
			<!-- Agent Store -->
			@agentStoreSection()
			<!-- AI Models -->
			@aiModelsSection()
			<!-- Integrations (MCP) -->
			@mcpSection()
			<!-- Pricing Section -->
			@pricingSection(props.User)
			<!-- CTA Section -->
			@ctaSection(props.User)
			<!-- Footer -->
			@Footer()
		</div>
	}
}
