package landing

import (
	"aicompass/components"
	"aicompass/components/icon"
	"aicompass/shared"
)

type LandingPageProps struct {
	User *shared.User
}

templ LandingPage(props LandingPageProps) {
	@components.BaseLayout(components.LayoutProps{
		Title:      "Your Intelligent AI Companion",
		User:       props.User,
		HideNavbar: true,
	}) {
		@icon.CompassLogoCSS()
		<div class="h-full overflow-y-auto scroll-smooth" id="landing-root">
			<!-- Sticky Navbar -->
			@Nav(props.User)
			<!-- Hero Section -->
			@heroSection(props.User)
			<!-- Features Grid (Core Value Props) -->
			@featuresSection()
			<!-- Agent Templates -->
			@agentStoreSection()
			<!-- Multi-Agent Orchestration -->
			@multiAgentSection()
			<!-- AI Models -->
			@aiModelsSection()
			<!-- Integrations (MCP) -->
			@mcpSection()
			<!-- Agent-to-Agent Protocol -->
			@a2aSection()
			<!-- Pricing Section -->
			@pricingSection(props.User)
			<!-- CTA Section -->
			@ctaSection(props.User)
			<!-- Footer -->
			@Footer()
		</div>
	}
}
