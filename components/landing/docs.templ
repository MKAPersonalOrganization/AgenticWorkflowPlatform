package landing

import (
	"school-with-ai/components"
	"school-with-ai/components/icon"
	"school-with-ai/domain"
)

type DocsPageProps struct {
	User *domain.User
}

templ DocsPage(props DocsPageProps) {
	@components.BaseLayout(components.LayoutProps{
		Title:      "Documentation",
		User:       props.User,
		HideNavbar: true,
	}) {
		<div class="h-full overflow-y-auto scroll-smooth" id="docs-root">
			<!-- Navbar (reuse landing nav) -->
			@landingNav(props.User)
			<!-- Docs Layout -->
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
				<div class="lg:grid lg:grid-cols-[240px_1fr] lg:gap-12">
					<!-- Sidebar Navigation -->
					@docsSidebar()
					<!-- Main Content -->
					<main class="min-w-0">
						@docsHero()
						@docsOverview()
						@docsGettingStarted()
						@docsAgentStore()
						@docsCustomAgents()
						@docsMCP()
						@docsPlugins()
						@docsKnowledgeBase()
						@docsMemoryArtifacts()
						@docsArchitecture()
						@docsSecurity()
						@docsI18n()
						@docsBilling()
						@docsAPI()
					</main>
				</div>
			</div>
			<!-- Footer -->
			@landingFooter()
		</div>
	}
}

// ─── Sidebar ─────────────────────────────────────────────────────────────────
templ docsSidebar() {
	<aside class="hidden lg:block">
		<nav class="sticky top-24 space-y-1">
			<p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">On this page</p>
			@sidebarLink("#overview", "Overview")
			@sidebarLink("#getting-started", "Getting Started")
			@sidebarLink("#agent-store", "Agent Store")
			@sidebarLink("#custom-agents", "Custom Agents")
			@sidebarLink("#mcp", "MCP Integration")
			@sidebarLink("#plugins", "Plugin System")
			@sidebarLink("#knowledge-base", "Knowledge Base")
			@sidebarLink("#memory", "Memory & Artifacts")
			@sidebarLink("#architecture", "Architecture")
			@sidebarLink("#security", "Security")
			@sidebarLink("#i18n", "Internationalization")
			@sidebarLink("#billing", "Billing")
			@sidebarLink("#api", "API Reference")
		</nav>
	</aside>
}

templ sidebarLink(href, text string) {
	<a
		href={ templ.SafeURL(href) }
		class="block rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground hover:bg-muted"
	>
		{ text }
	</a>
}

// ─── Hero ────────────────────────────────────────────────────────────────────
templ docsHero() {
	<div class="mb-12">
		<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
			@icon.BookOpen(icon.Props{Class: "size-4 text-primary"})
			<span>Documentation</span>
		</div>
		<h1 class="text-4xl font-bold tracking-tight">Compass Documentation</h1>
		<p class="mt-4 text-lg text-muted-foreground max-w-2xl">
			Everything you need to know about using Compass — from getting started to advanced features like MCP integration and custom agent creation.
		</p>
	</div>
}

// ─── Sections ────────────────────────────────────────────────────────────────
templ docsOverview() {
	@docsSection("overview", "Overview", iconCompass, "text-primary") {
		<p>
			<strong>Compass</strong> is an AI-powered learning and productivity platform that brings together
			conversational AI, a rich plugin ecosystem, knowledge management, and external service integration
			into a single, beautiful web application.
		</p>
		<p>
			At its core, Compass is built around the concept of <strong>AI agents</strong> — specialized assistants
			that can be configured with unique personalities, tool sets, and knowledge base access. Whether you're
			a student studying for exams, a researcher organizing papers, or a developer exploring new technologies,
			Compass adapts to your workflow.
		</p>
		@docsInfoBox("Key Concepts") {
			<ul class="space-y-2 mt-2">
				<li><strong>Agents</strong> — AI personalities with custom prompts, models, and tools</li>
				<li><strong>Plugins</strong> — Tool sets that extend what agents can do (calculator, visualization, TTS, etc.)</li>
				<li><strong>MCP Connectors</strong> — Bridge to external services via the Model Context Protocol</li>
				<li><strong>Knowledge Base</strong> — Document-backed RAG (Retrieval Augmented Generation) system</li>
				<li><strong>Threads</strong> — Persistent conversations with full history and artifacts</li>
				<li><strong>Memory</strong> — Long-term context that persists across conversations</li>
			</ul>
		}
	}
}

templ docsGettingStarted() {
	@docsSection("getting-started", "Getting Started", iconRocket, "text-green-500") {
		<h3>1. Sign In</h3>
		<p>
			Compass uses Google OAuth for authentication. Click <strong>"Get Started"</strong> on the home page and sign in with your Google account. Your account is created automatically on first login.
		</p>
		<h3>2. Start a Conversation</h3>
		<p>
			Once signed in, you'll see the chat interface. Type any message to start a conversation with the default <strong>Assistant</strong> agent. The assistant is a general-purpose AI that can help with a wide range of tasks.
		</p>
		<h3>3. Choose an Agent</h3>
		<p>
			Click the agent selector at the top of the chat to switch between your agents. You can also visit the <strong>Agent Store</strong> (via the sidebar) to browse and add specialized agents.
		</p>
		<h3>4. Explore Features</h3>
		<p>
			Use the sidebar to access threads (conversation history), resources (file uploads), tools (plugin management), and the agent store. Each agent can be configured with different tools and knowledge base access.
		</p>
		@docsInfoBox("Quick Tip") {
			<p>Press <kbd class="px-1.5 py-0.5 rounded border border-border bg-muted text-xs font-mono">?</kbd> anywhere in the app to view all keyboard shortcuts.</p>
		}
	}
}

templ docsAgentStore() {
	@docsSection("agent-store", "Agent Store", iconStore, "text-purple-500") {
		<p>
			The Agent Store is a curated catalog of pre-built AI agents designed for specific tasks.
			Each agent comes with a carefully crafted system prompt, recommended model, and tool configuration.
		</p>
		<h3>Browsing the Catalog</h3>
		<p>
			Open the Agent Store from the sidebar navigation. Agents are organized by category and can be searched
			by name, description, or tags. Featured agents appear at the top of the catalog.
		</p>
		<h3>Agent Categories</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Category</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Examples</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Education", "Tutors and learning assistants", "Math Tutor, Science Guide, Language Coach")
				@docsTableRow("Writing", "Content creation and editing", "Writing Coach, Essay Reviewer, Creative Writer")
				@docsTableRow("Development", "Programming and technical help", "Code Mentor, Debug Assistant, API Designer")
				@docsTableRow("Research", "Analysis and information synthesis", "Research Analyst, Paper Reviewer, Fact Checker")
				@docsTableRow("Creative", "Art, design, and creative thinking", "Creative Studio, Brainstorm Partner, Story Teller")
				@docsTableRow("Productivity", "Task management and workflows", "Project Planner, Meeting Summarizer, Daily Organizer")
			</tbody>
		}
		<h3>Forking Agents</h3>
		<p>
			When you find an agent you like, click <strong>"Add to My Agents"</strong> to fork it into your personal
			collection. Forked agents are fully editable — you can customize the system prompt, switch models,
			add or remove tools, and change the temperature settings.
		</p>
		@docsInfoBox("Agent Properties") {
			<ul class="space-y-2 mt-2">
				<li><strong>Name</strong> — Display name for the agent</li>
				<li><strong>Description</strong> — Short description of the agent's purpose</li>
				<li><strong>System Prompt</strong> — Instructions that define the agent's behavior and personality</li>
				<li><strong>Model</strong> — Which AI model the agent uses (GPT-4o, Claude, etc.)</li>
				<li><strong>Temperature</strong> — Controls randomness (0 = deterministic, 1 = creative)</li>
				<li><strong>Max Iterations</strong> — Maximum tool-use cycles per response</li>
				<li><strong>Icon</strong> — Emoji label for visual identification</li>
				<li><strong>Tool Sets</strong> — Which plugins and individual tools are enabled</li>
				<li><strong>Workspace Access</strong> — Which knowledge base workspaces the agent can query</li>
			</ul>
		}
	}
}

templ docsCustomAgents() {
	@docsSection("custom-agents", "Custom Agents", iconWand, "text-amber-500") {
		<p>
			Beyond the catalog, you can create agents entirely from scratch. Custom agents give you full
			control over every aspect of the AI's behavior.
		</p>
		<h3>Creating a Custom Agent</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Open the Agent Store from the sidebar</li>
			<li>Click <strong>"Create Agent"</strong> at the top</li>
			<li>Fill in the agent's name, description, and icon</li>
			<li>Write a detailed system prompt that defines the agent's role and instructions</li>
			<li>Select the AI model and adjust temperature/iteration settings</li>
			<li>Configure which tool sets and individual tools are available to the agent</li>
			<li>Assign knowledge base workspaces the agent can access</li>
		</ol>
		<h3>System Prompt Best Practices</h3>
		<p>
			The system prompt is the most important part of an agent. It defines who the agent is, how it should
			behave, and what it should focus on. Here are some tips:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Be specific</strong> — Define the agent's role, expertise, and boundaries clearly</li>
			<li>• <strong>Set the tone</strong> — Specify whether the agent should be formal, friendly, technical, etc.</li>
			<li>• <strong>Include examples</strong> — Show the agent what good responses look like</li>
			<li>• <strong>Define constraints</strong> — Tell the agent what it should NOT do</li>
			<li>• <strong>Reference tools</strong> — Mention when the agent should use specific tools</li>
		</ul>
		<h3>Per-Agent Tool Configuration</h3>
		<p>
			Each agent can have a unique set of enabled tools. This lets you create specialized agents that only
			use relevant capabilities:
		</p>
		<ul class="space-y-2 my-4">
			<li>• A <strong>Math Tutor</strong> might only need Calculator and Visualization</li>
			<li>• A <strong>Research Assistant</strong> might need Knowledge Base and Document tools</li>
			<li>• A <strong>Code Mentor</strong> might need Codebase and Cognitive tools</li>
		</ul>
		<h3>Workspace Permissions</h3>
		<p>
			Control which knowledge base workspaces each agent can access. This is useful when you have
			multiple knowledge bases (e.g., "Physics Notes" and "History Research") and want specific
			agents to only query relevant workspaces.
		</p>
	}
}

templ docsMCP() {
	@docsSection("mcp", "MCP Integration", iconNetwork, "text-orange-500") {
		<p>
			The <strong>Model Context Protocol (MCP)</strong> is an open standard that allows AI applications to connect
			with external tools and data sources. Compass implements full MCP client support, enabling your agents to
			interact with remote services seamlessly.
		</p>
		<h3>How MCP Works</h3>
		<p>
			MCP connectors act as bridges between Compass and external servers. When you connect to an MCP server,
			Compass automatically discovers the available tools and makes them accessible to your agents.
		</p>
		@docsInfoBox("Connector Lifecycle") {
			<div class="flex flex-wrap items-center gap-2 mt-2 text-sm">
				@statusBadge("Created", "bg-gray-500")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Connecting", "bg-blue-500")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Connected", "bg-green-500")
				<span class="text-muted-foreground">or</span>
				@statusBadge("Auth Required", "bg-yellow-500")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Authorizing", "bg-purple-500")
			</div>
		}
		<h3>Setting Up an MCP Connector</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Navigate to the <strong>Tools</strong> section in the sidebar</li>
			<li>Click <strong>"Add MCP Connector"</strong></li>
			<li>Enter the MCP server URL (e.g., <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">https://mcp.github.com</code>)</li>
			<li>If the server requires OAuth, you'll be redirected to authenticate</li>
			<li>Once connected, available tools are automatically discovered</li>
			<li>Assign the connector's tools to specific agents</li>
		</ol>
		<h3>OAuth 2.1 Support</h3>
		<p>
			Compass supports the full OAuth 2.1 Authorization Code + PKCE flow for secure authentication
			with MCP servers. This means you can safely connect to services like GitHub, Notion, and Slack
			without exposing your credentials.
		</p>
		<h3>MCP Proxy</h3>
		<p>
			Compass includes an authenticated reverse proxy to MCP servers. This means your agents can
			communicate with external services through Compass's secure infrastructure, with SSRF protection
			and encrypted OAuth tokens at rest.
		</p>
		<h3>Preset Connectors</h3>
		<p>
			Compass ships with a catalog of preset MCP connectors for popular services. These presets
			come pre-configured with the correct server URLs and OAuth settings, so you can connect
			with a single click.
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Feature</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Details</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Protocol", "Model Context Protocol (MCP)")
				@docsTableRow2("Auth Flow", "OAuth 2.1 Authorization Code + PKCE")
				@docsTableRow2("Max Connectors", "10 per user")
				@docsTableRow2("Tool Discovery", "Automatic — refreshable on demand")
				@docsTableRow2("Security", "SSRF protection, encrypted tokens at rest")
				@docsTableRow2("Proxy", "Authenticated reverse proxy to MCP servers")
			</tbody>
		}
	}
}

templ docsPlugins() {
	@docsSection("plugins", "Plugin System", iconPuzzle, "text-green-500") {
		<p>
			Compass's plugin system provides a powerful extension mechanism that gives agents specialized
			capabilities. Plugins are registered at startup and managed through a central registry, with
			per-agent toggle control for fine-grained configuration.
		</p>
		<h3>Built-in Plugins</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Plugin</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Use Cases</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Calculator", "Mathematical computations and expressions", "Solving equations, unit conversions, statistics")
				@docsTableRow("Codebase", "Source code analysis and generation", "Code review, refactoring, debugging")
				@docsTableRow("Cognitive", "Advanced reasoning and analysis tools", "Logic puzzles, step-by-step problem solving")
				@docsTableRow("Document", "File processing and text extraction", "PDF parsing, document summarization")
				@docsTableRow("Elicitation", "Interactive clarification and follow-ups", "Gathering requirements, interviews")
				@docsTableRow("Knowledge Base", "RAG queries against uploaded documents", "Research, fact-checking, document Q&A")
				@docsTableRow("Library", "Access to reference materials and resources", "Looking up definitions, formulas, references")
				@docsTableRow("Memory", "Long-term recall across conversations", "Remembering preferences, tracking progress")
				@docsTableRow("Text-to-Speech", "Convert AI responses to spoken audio", "Language learning, accessibility, narration")
				@docsTableRow("Visualization", "Chart and diagram generation", "Data analysis, concept mapping, flowcharts")
			</tbody>
		}
		<h3>How Plugins Work</h3>
		<p>
			Each plugin implements a <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">Provider</code> interface and registers its tool sets at application startup. The tool registry stores the state of each plugin (enabled/disabled) in PostgreSQL, ensuring consistency across restarts.
		</p>
		<h3>Per-Agent Tool Management</h3>
		<p>
			Plugins expose <strong>tool sets</strong>, and each tool set contains one or more <strong>individual tools</strong>.
			You can control availability at both levels:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Toggle a full tool set</strong> — Enable or disable all tools in a plugin for a specific agent</li>
			<li>• <strong>Toggle individual tools</strong> — Fine-tune by enabling/disabling specific tools within a set</li>
		</ul>
		<p>
			This flexibility lets you create highly specialized agents. For example, a "Data Analyst" agent might
			have the Visualization plugin fully enabled, but only the <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">evaluate</code> tool from the Calculator plugin.
		</p>
		<h3>MCP Tools Integration</h3>
		<p>
			MCP connectors are also registered as dynamic plugins in the tool registry. This means tools
			discovered from remote MCP servers appear alongside built-in plugins in the agent's tool configuration
			panel, providing a unified management experience.
		</p>
	}
}

templ docsKnowledgeBase() {
	@docsSection("knowledge-base", "Knowledge Base", iconDatabase, "text-pink-500") {
		<p>
			The Knowledge Base feature turns Compass into a powerful RAG (Retrieval Augmented Generation)
			platform. Upload your documents, and your AI agents can answer questions grounded in your own data.
		</p>
		<h3>Workspaces</h3>
		<p>
			Documents are organized into <strong>workspaces</strong>. Each workspace is an independent collection
			with its own vector index and knowledge graph. You can create workspaces for different subjects,
			projects, or topics.
		</p>
		<h3>Document Pipeline</h3>
		<p>
			When you upload a document, it goes through an automated processing pipeline:
		</p>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li><strong>Upload</strong> — File is received and stored</li>
			<li><strong>Extraction</strong> — Text is extracted from PDFs, documents, and files</li>
			<li><strong>Chunking</strong> — Text is split into optimally-sized chunks</li>
			<li><strong>Embedding</strong> — Chunks are converted to vector embeddings</li>
			<li><strong>Indexing</strong> — Vectors are stored in the search index</li>
			<li><strong>Graph Building</strong> — Entities and relationships are extracted into a knowledge graph</li>
		</ol>
		<h3>Knowledge Graph</h3>
		<p>
			Beyond simple vector search, Compass builds a <strong>knowledge graph</strong> from your documents.
			You can visually explore entities, relationships, and concepts through an interactive graph view.
			Search by node labels, browse popular concepts, and see how your documents connect.
		</p>
		<h3>Per-Agent Access Control</h3>
		<p>
			Each agent can be granted access to specific workspaces. This means a "Physics Tutor" agent will
			only search your physics workspace, while a "History Explorer" agent queries your history workspace.
			This keeps responses focused and relevant.
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Feature</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Details</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Document Types", "PDF, text files, and more")
				@docsTableRow2("Processing", "Automatic pipeline with progress tracking")
				@docsTableRow2("Search", "Hybrid vector + knowledge graph retrieval")
				@docsTableRow2("Graph", "Interactive visualization with node search")
				@docsTableRow2("Access Control", "Per-agent workspace permissions")
				@docsTableRow2("Operations", "Rebuild, reprocess, scan, and retry failed documents")
			</tbody>
		}
	}
}

templ docsMemoryArtifacts() {
	@docsSection("memory", "Memory & Artifacts", iconBrain, "text-cyan-500") {
		<h3>Long-Term Memory</h3>
		<p>
			Compass supports <strong>long-term memory</strong> that persists across conversations. When enabled,
			the Memory plugin stores important context — your preferences, ongoing projects, learning progress —
			and makes it available to agents in future conversations.
		</p>
		<p>
			Memory is stored as artifacts in S3-compatible object storage, ensuring durability and scalability.
			Each user has their own private memory space that is never shared.
		</p>
		<h3>Artifacts</h3>
		<p>
			Agents can generate <strong>artifacts</strong> during conversations — downloadable files such as:
		</p>
		<ul class="space-y-2 my-4">
			<li>• Code files and scripts</li>
			<li>• Diagrams and visualizations</li>
			<li>• Analysis reports</li>
			<li>• Study materials and summaries</li>
		</ul>
		<p>
			Artifacts are stored per-thread and can be listed and downloaded at any time. They're backed by
			S3-compatible storage for reliable access.
		</p>
		<h3>Thread Management</h3>
		<p>
			All conversations are organized into <strong>threads</strong>. You can:
		</p>
		<ul class="space-y-2 my-4">
			<li>• Create new threads for different topics</li>
			<li>• Rename threads for easy identification</li>
			<li>• Search across all conversations</li>
			<li>• Delete threads when no longer needed</li>
			<li>• View full message history with tool usage details</li>
		</ul>
	}
}

templ docsArchitecture() {
	@docsSection("architecture", "Architecture", iconLayers, "text-indigo-500") {
		<p>
			Compass is built on a modern, event-sourced architecture designed for reliability, scalability,
			and observability.
		</p>
		<h3>Event Sourcing & CQRS</h3>
		<p>
			Every state change in Compass is recorded as an immutable <strong>event</strong> in PostgreSQL.
			This event-sourced approach provides:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Full audit trail</strong> — Every action is recorded and can be replayed</li>
			<li>• <strong>Time-travel debugging</strong> — Reconstruct state at any point in time</li>
			<li>• <strong>Reliable projections</strong> — Read models are derived from events, ensuring consistency</li>
			<li>• <strong>CQRS separation</strong> — Write side (commands) and read side (queries) are decoupled</li>
		</ul>
		<h3>AG-UI Protocol</h3>
		<p>
			The chat interface uses the <strong>AG-UI protocol</strong> with Server-Sent Events (SSE) for
			real-time streaming. This enables instant token-by-token response delivery, live tool execution
			feedback, and smooth UI updates.
		</p>
		<h3>Background Processing</h3>
		<p>
			Long-running tasks (AI agent execution, document processing) are handled by
			<strong>Asynq</strong> — a Redis-backed task queue that supports concurrent workers,
			retry policies, and graceful shutdown.
		</p>
		<h3>Multi-Pod Scalability</h3>
		<p>
			Compass is designed for horizontal scaling. Events are broadcast across pods via
			<strong>Redis Pub/Sub</strong>, ensuring all instances stay synchronized. The projection
			updater runs independently, keeping read models up to date across the cluster.
		</p>
		@docsInfoBox("Tech Stack") {
			<div class="grid grid-cols-2 gap-2 mt-2 text-sm">
				<div><strong>Language:</strong> Go</div>
				<div><strong>Templates:</strong> Templ</div>
				<div><strong>Frontend:</strong> Alpine.js + HTMX patterns</div>
				<div><strong>CSS:</strong> Tailwind CSS v4</div>
				<div><strong>Database:</strong> PostgreSQL</div>
				<div><strong>Queue:</strong> Redis + Asynq</div>
				<div><strong>Storage:</strong> S3 (MinIO compatible)</div>
				<div><strong>Payments:</strong> Stripe</div>
			</div>
		}
	}
}
