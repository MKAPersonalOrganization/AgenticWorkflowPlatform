package components

import "school-with-ai/components/input"
import "school-with-ai/components/chatinput"
import "school-with-ai/components/threadhistory"
import "school-with-ai/components/messagelist"
import "school-with-ai/components/eventlog"
import "school-with-ai/components/collapsible"
import "school-with-ai/components/popover"
import "school-with-ai/components/textarea"
import "school-with-ai/components/sidebar"
import "school-with-ai/components/code"
import "school-with-ai/components/whiteboard"
import "school-with-ai/components/dialog"
import "school-with-ai/components/keyboardshortcuts"

templ ChatInputScreen() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Chat</title>
			<link rel="icon" type="image/svg+xml" href="/assets/images/logo.svg"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="https://cdn.jsdelivr.net/npm/markdown-it@14/dist/markdown-it.min.js"></script>
			<script>
			let script = document.createElement('script');
			script.src = "https://cdn.jsdelivr.net/npm/mathpix-markdown-it@1.3.6/es5/bundle.js";
			document.head.append(script);

			script.onload = function() {
				const isLoaded = window.loadMathJax();
				if (isLoaded) {
					console.log('Mathpix styles loaded successfully');
				} else {
					console.error('Failed to load Mathpix styles');
				}
			}
		</script>
			<script type="module" src="/assets/js/chat.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			@input.Script()
			@collapsible.Script()
			@popover.Script()
			@textarea.Script()
			@sidebar.Script()
			@code.Script()
		</head>
		<body class="flex min-h-screen bg-background text-foreground antialiased">
			<div class="w-full h-screen" x-data="chat">
				@sidebar.Layout() {
					<!-- Left Sidebar - Chat History -->
					@threadhistory.ThreadHistory()
					<!-- Main Content Area - Split Layout -->
					<div class="flex-1 flex h-screen overflow-hidden" x-ref="splitContainer">
						<!-- Left Panel - Chat/Thread -->
						<main
							class="flex flex-col relative overflow-hidden transition-all duration-200"
							x-show="showThread"
							x-transition:enter="transition ease-out duration-200"
							x-transition:enter-start="opacity-0 -translate-x-4"
							x-transition:enter-end="opacity-100 translate-x-0"
							x-transition:leave="transition ease-in duration-150"
							x-transition:leave-start="opacity-100 translate-x-0"
							x-transition:leave-end="opacity-0 -translate-x-4"
							:style="(showWhiteboard && showThread && (hasMessages || isStreaming)) ? `width: ${splitPosition}%` : 'width: 100%'"
						>
							<!-- Sidebar Toggle -->
							<div class="absolute top-4 left-4 z-10">
								@sidebar.Trigger()
							</div>
							<!-- Top-right buttons -->
							<div class="absolute top-4 right-4 z-10 flex gap-2">
								<!-- Theme Toggle Button -->
								<button
									@click="toggleTheme()"
									class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-9 w-9"
									type="button"
									:aria-label="`Switch to ${theme === 'light' ? 'dark' : theme === 'dark' ? 'system' : 'light'} theme`"
									:title="`Theme: ${theme}`"
								>
									<!-- Sun icon (light mode) -->
									<svg x-show="theme === 'light'" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
									</svg>
									<!-- Moon icon (dark mode) -->
									<svg x-show="theme === 'dark'" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
									</svg>
									<!-- System icon (auto mode) -->
									<svg x-show="theme === 'system'" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
									</svg>
								</button>
								<!-- Panel Toggle Buttons (shown when one panel is hidden) -->
								<div
									x-show="(!showWhiteboard || !showThread) && (hasMessages || isStreaming)"
									class="flex gap-2"
									x-transition
								>
									<!-- Thread Toggle Button (shown when thread is visible but whiteboard is hidden) -->
									<button
										x-show="!showWhiteboard"
										@click="toggleWhiteboard()"
										class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-3 shadow-md"
										type="button"
										aria-label="Show whiteboard"
									>
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
										</svg>
										<span>Whiteboard</span>
									</button>
								</div>
							</div>
							<!-- Messages Container -->
							<div
								class="flex-1 overflow-y-auto scrollbar-thin"
								style="overflow-anchor: none;"
								x-ref="messageList"
								role="log"
								aria-live="polite"
								aria-relevant="additions"
								aria-label="Chat conversation"
							>
								<div x-show="!hasMessages && !isStreaming" class="h-full flex flex-col items-center justify-center">
									<div class="flex flex-col items-center gap-8 w-full max-w-3xl mx-auto px-4 py-12">
										<div class="flex flex-col items-center gap-4 text-center">
											<img src="/assets/images/logo.svg" alt="Logo" class="w-48 h-48 object-contain"/>
											<h1 class="text-3xl font-bold tracking-tight">Welcome to School with AI</h1>
											<p class="text-muted-foreground max-w-md">
												Get help with math problems from specialized AI agents. Ask anything about algebra, calculus, geometry, statistics, or trigonometry.
											</p>
										</div>
										<!-- Sample Prompts -->
										<div class="w-full space-y-3">
											<p class="text-sm font-medium text-muted-foreground">Try asking:</p>
											<div class="grid gap-2 md:grid-cols-2">
												<button
													@click="currentMessage = 'Solve the quadratic equation: x² + 5x + 6 = 0'; sendMessage()"
													class="text-left p-4 rounded-lg border border-border bg-card hover:bg-accent hover:border-primary transition-all group"
												>
													<div class="flex items-start gap-3">
														<div class="shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
															<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
																<path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
															</svg>
														</div>
														<div class="flex-1">
															<p class="text-sm font-medium">Solve quadratic equation</p>
															<p class="text-xs text-muted-foreground mt-1">x² + 5x + 6 = 0</p>
														</div>
													</div>
												</button>
												<button
													@click="currentMessage = 'What is the derivative of sin(x) * cos(x)?'; sendMessage()"
													class="text-left p-4 rounded-lg border border-border bg-card hover:bg-accent hover:border-primary transition-all group"
												>
													<div class="flex items-start gap-3">
														<div class="shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
															<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
																<path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z" clip-rule="evenodd"></path>
															</svg>
														</div>
														<div class="flex-1">
															<p class="text-sm font-medium">Calculate derivative</p>
															<p class="text-xs text-muted-foreground mt-1">d/dx [sin(x) · cos(x)]</p>
														</div>
													</div>
												</button>
												<button
													@click="currentMessage = 'Calculate the area of a circle with radius 5'; sendMessage()"
													class="text-left p-4 rounded-lg border border-border bg-card hover:bg-accent hover:border-primary transition-all group"
												>
													<div class="flex items-start gap-3">
														<div class="shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
															<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
																<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
															</svg>
														</div>
														<div class="flex-1">
															<p class="text-sm font-medium">Geometry problem</p>
															<p class="text-xs text-muted-foreground mt-1">Area of circle, r = 5</p>
														</div>
													</div>
												</button>
												<button
													@click="currentMessage = 'Calculate mean and standard deviation of: 4, 8, 6, 5, 3, 7'; sendMessage()"
													class="text-left p-4 rounded-lg border border-border bg-card hover:bg-accent hover:border-primary transition-all group"
												>
													<div class="flex items-start gap-3">
														<div class="shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
															<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
																<path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
															</svg>
														</div>
														<div class="flex-1">
															<p class="text-sm font-medium">Statistics analysis</p>
															<p class="text-xs text-muted-foreground mt-1">Mean & std deviation</p>
														</div>
													</div>
												</button>
											</div>
										</div>
										<!-- Keyboard shortcut hint -->
										<div class="flex items-center gap-2 text-xs text-muted-foreground mt-4">
											<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
											</svg>
											<span>Press <kbd class="kbd text-xs">?</kbd> to see all keyboard shortcuts</span>
										</div> <!-- Centered Input Area -->
										<div class="w-full">
											@chatinput.ChatInput()
										</div>
									</div>
								</div>
								<!-- When messages exist: regular message list -->
								<div x-show="hasMessages || isStreaming" class="max-w-3xl mx-auto px-4 py-6">
									<!-- Messages -->
									@messagelist.MessageList()
								</div>
							</div>
							<!-- Input Area - Agent Chat UI Style (only show when messages exist) -->
							<div x-show="hasMessages || isStreaming" class="sticky bottom-0 flex flex-col items-center gap-8 bg-background">
								<div class="mb-8 w-full">
									@chatinput.ChatInput()
								</div>
							</div>
							@eventlog.EventLog()
						</main>
						<!-- Resizable Divider -->
						<div
							x-show="showWhiteboard && showThread && (hasMessages || isStreaming)"
							@mousedown="startResize($event)"
							@touchstart="startResize($event)"
							@dblclick="resetSplitPosition()"
							class="w-2 md:w-1 bg-border hover:bg-primary/50 active:bg-primary/70 cursor-col-resize shrink-0 relative group transition-colors duration-150 touch-none"
							x-transition
							role="separator"
							aria-orientation="vertical"
							aria-label="Resize panels. Double-click to reset."
							aria-valuenow="splitPosition"
							aria-valuemin="20"
							aria-valuemax="80"
							tabindex="0"
							@keydown.left="splitPosition = Math.max(20, splitPosition - 5)"
							@keydown.right="splitPosition = Math.min(80, splitPosition + 5)"
							@keydown.home="splitPosition = 20"
							@keydown.end="splitPosition = 80"
							@keydown.space.prevent="resetSplitPosition()"
						>
							<!-- Larger touch target area (invisible) -->
							<div class="absolute inset-y-0 -left-2 -right-2 md:-left-1 md:-right-1"></div>
							<!-- Visual indicator for drag handle -->
							<div class="absolute inset-y-0 -left-1 -right-1 group-hover:bg-primary/20 group-focus:bg-primary/20 transition-colors duration-150"></div>
							<!-- Center grip dots -->
							<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col gap-1 opacity-50 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-150">
								<div class="w-1 h-1 rounded-full bg-muted-foreground"></div>
								<div class="w-1 h-1 rounded-full bg-muted-foreground"></div>
								<div class="w-1 h-1 rounded-full bg-muted-foreground"></div>
							</div>
						</div>
						<!-- Right Panel - Whiteboard -->
						<aside
							class="h-full border-l border-border flex flex-col transition-all duration-200"
							x-show="showWhiteboard && (hasMessages || isStreaming)"
							x-transition:enter="transition ease-out duration-200"
							x-transition:enter-start="opacity-0 translate-x-4"
							x-transition:enter-end="opacity-100 translate-x-0"
							x-transition:leave="transition ease-in duration-150"
							x-transition:leave-start="opacity-100 translate-x-0"
							x-transition:leave-end="opacity-0 translate-x-4"
							:style="showThread ? `width: ${100 - splitPosition}%` : 'width: 100%'"
						>
							@whiteboard.Whiteboard()
						</aside>
					</div>
				}
				<!-- Keyboard Shortcuts Dialog -->
				<div x-show="showKeyboardShortcuts" x-cloak>
					@dialog.Dialog(dialog.Props{Open: true}) {
						<div x-show="showKeyboardShortcuts" @click.away="showKeyboardShortcuts = false">
							@keyboardshortcuts.KeyboardShortcuts()
						</div>
					}
				</div>
				<!-- Toast Notifications -->
				<div
					class="toast-container"
					role="region"
					aria-live="polite"
					aria-label="Notifications"
				>
					<template x-for="toast in toasts" :key="toast.id">
						<div
							:class="toast.leaving ? 'toast-leave' : 'toast-enter'"
							class="flex items-start gap-3 p-4 bg-card border border-border rounded-lg shadow-lg max-w-md min-w-[320px]"
							role="alert"
							:aria-live="toast.type === 'error' ? 'assertive' : 'polite'"
						>
							<!-- Icon -->
							<div class="shrink-0" x-html="getToastIcon(toast.type)"></div>
							<!-- Content -->
							<div class="flex-1 min-w-0">
								<p class="text-sm font-medium break-words" x-text="toast.message"></p>
							</div>
							<!-- Close Button -->
							<button
								@click="dismissToast(toast.id)"
								class="shrink-0 inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-6 w-6"
								type="button"
								aria-label="Close notification"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</template>
				</div>
			</div>
		</body>
	</html>
}
