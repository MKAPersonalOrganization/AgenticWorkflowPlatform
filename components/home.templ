package components

import (
	"aicompass/components/banner"
	"aicompass/components/chat"
	"aicompass/components/chatinput"
	"aicompass/components/code"
	"aicompass/components/collapsible"
	"aicompass/components/copybutton"
	"aicompass/components/dialog"
	"aicompass/components/dropdown"
	"aicompass/components/eventlog"
	"aicompass/components/footer"
	"aicompass/components/icon"
	"aicompass/components/input"
	"aicompass/components/keyboardshortcuts"
	"aicompass/components/messagelist"
	"aicompass/components/nav"
	"aicompass/components/popover"
	"aicompass/components/selectbox"
	"aicompass/components/sidebar"
	"aicompass/components/sidepanel"
	"aicompass/components/tabs"
	"aicompass/components/textarea"
	"aicompass/components/threads"
	"aicompass/shared"
)

templ HomeExtraHead() {
	<!-- Markdown rendering: markdown-it + KaTeX for math -->
	<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"/>
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js"></script>
	<!-- jsdiff: Myers O(ND) diff algorithm for TTS word alignment -->
	<script src="https://cdn.jsdelivr.net/npm/diff@7.0.0/dist/diff.min.js"></script>
	<script type="module" src="/assets/js/chat.js?v=fix_katex"></script>
	<!-- Alpine.js Intersect Plugin - MUST load before Alpine core -->
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
	<!-- Alpine.js Collapse Plugin - MUST load before Alpine core -->
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
	@input.Script()
	@collapsible.Script()
	@popover.Script()
	@textarea.Script()
	@sidebar.Script()
	@code.Script()
	@tabs.Script()
	@selectbox.Script()
	@copybutton.Script()
	@dropdown.Script()
	@dialog.Script()
	@icon.CompassLogoCSS()
	<style>
		@keyframes shrink {
			from { transform: scaleX(1); }
			to { transform: scaleX(0); }
		}

		/* Compass spinning animation */
		@keyframes compassSpin {
			from { transform: rotate(0deg); }
			to { transform: rotate(360deg); }
		}

		@keyframes compassFloat {
			0% { transform: rotate(0deg); }
			15% { transform: rotate(15deg); }
			30% { transform: rotate(-10deg); }
			45% { transform: rotate(5deg); }
			60% { transform: rotate(-2deg); }
			75% { transform: rotate(1deg); }
			100% { transform: rotate(0deg); }
		}

		/* Compass animation classes */
		.compass-spin {
			animation: compassSpin 8s linear infinite;
		}

		.compass-float {
			animation: compassFloat 4s ease-in-out infinite;
			transform-origin: center;
		}

		.compass-pulse {
			animation: pulse 2s ease-in-out infinite alternate;
		}

		@keyframes pulse {
			from { transform: scale(1); }
			to { transform: scale(1.05); }
		}

		/* KaTeX inline math */
		.katex-display {
			display: block !important;
			margin: 1em 0 !important;
			text-align: center;
		}

		.katex {
			font-size: 1.1em;
		}

		/* RTL alignment for display math */
		[dir="rtl"] .katex-display {
			text-align: right !important;
		}
	</style>
}

templ ChatInputScreen(user *shared.User) {
	@BaseLayout(LayoutProps{
		Title:     "Chat",
		User:      user,
		ExtraHead: HomeExtraHead(),
	}) {
		<div class="w-full h-full flex flex-col" x-data="chat" @agent-selected.window="selectAgent($event.detail.id)" @tool-input-provided="sendMessage($event.detail.input)">
			<!-- Sidebar Layout -->
			<div class="flex-1 min-h-0 overflow-hidden">
				@sidebar.Layout(sidebar.LayoutProps{Class: "h-full min-h-0"}) {
					<!-- Main Content Area -->
					<div class="flex-1 flex h-full overflow-hidden relative">
						<!-- Main Chat Panel -->
						<main
							class="flex flex-col relative overflow-hidden w-full h-full"
						>
							<!-- Global Banner -->
							@banner.Banner()
							<!-- Header -->
							@nav.MobileNav()
							@chat.Header()
							<!-- Content wrapper - class switches based on state -->
							<div
								x-cloak
								class="flex flex-col min-h-0"
								:class="(hasMessages || isStreaming)
										? 'flex-1'
										: 'flex-1 items-center justify-end sm:justify-center'"
							>
								<!-- Messages state -->
								<div
									x-show="hasMessages || isStreaming"
									x-cloak
									class="relative flex-1 overflow-hidden min-h-0"
								>
									<div
										x-ref="messageList"
										style="height: 100%; overflow-y: auto; width: 100%; scrollbar-gutter: stable; scroll-behavior: auto !important;"
										role="log"
										aria-live="polite"
									>
										<div class="flex flex-col pb-9 pt-14">
											<div class="w-full max-w-3xl xl:max-w-4xl mx-auto px-4">
												@messagelist.MessageList()
											</div>
											<div id="messages-end" x-ref="messagesEnd" class="h-0 w-full flex-shrink-0"></div>
										</div>
									</div>
									<!-- Scroll to Bottom Button -->
									<button
										x-show="scrolledUp"
										x-cloak
										x-transition:enter="transition ease-out duration-200"
										x-transition:enter-start="opacity-0 translate-y-2 scale-95"
										x-transition:enter-end="opacity-100 translate-y-0 scale-100"
										x-transition:leave="transition ease-in duration-150"
										x-transition:leave-start="opacity-100 translate-y-0 scale-100"
										x-transition:leave-end="opacity-0 translate-y-2 scale-95"
										@click="scrollToBottom()"
										class="absolute bottom-5 left-1/2 -translate-x-1/2 cursor-pointer rounded-full border border-border/50 bg-background/90 backdrop-blur-sm p-2 shadow-modern hover:shadow-modern-lg hover:bg-accent/60 transition-all duration-200 z-10 hover:scale-105 active:scale-95"
										aria-label="Scroll to bottom"
									>
										@icon.ChevronDown(icon.Props{Class: "size-5 text-muted-foreground"})
									</button>
								</div>
								<!-- ChatForm - SINGLE instance -->
								<div
									class="w-full"
									:class="(!hasMessages && !isStreaming) ? 'max-w-3xl xl:max-w-4xl mx-auto transition-all duration-200' : ''"
								>

									<div
										class="mx-auto flex w-full flex-row gap-3 transition-[max-width] duration-300 sm:px-2"
										:class="(hasMessages || isStreaming) ? 'max-w-3xl xl:max-w-4xl sm:mb-4' : 'sm:mb-28'"
									>
										@chatinput.ChatInput()
									</div>
									<div x-show="hasMessages || isStreaming" x-cloak>
										@footer.CompactFooter()
									</div>
								</div>
							</div>
							<!-- Footer (Landing Page) -->
							<div x-show="!hasMessages && !isStreaming" x-cloak>
								@footer.Footer()
							</div>
							@eventlog.EventLog()
							</main>
						<!-- Side Panel (inside layout to push content) -->
						@sidepanel.SidePanel()
						<!-- Floating Workflow Graph Panel -->
						@WorkflowGraphPanel()
					</div>
				}
			</div>
			<!-- Thread History Dialog -->
			@threads.ThreadsDialog()
			<!-- Keyboard Shortcuts Dialog -->
			<div x-show="showKeyboardShortcuts" x-cloak>
				@dialog.Dialog(dialog.Props{Open: true}) {
					<div x-show="showKeyboardShortcuts" @click.away="showKeyboardShortcuts = false">
						@keyboardshortcuts.KeyboardShortcuts()
					</div>
				}
			</div>
			<!-- Settings Dialog -->
			@nav.Settings()
			<!-- Toast Notifications -->
			<div
				class="toast-container"
				role="region"
				aria-live="polite"
				aria-label="Notifications"
			>
				<template x-for="toast in toasts" :key="toast.id">
					<div
						:class="toast.leaving ? 'toast-leave' : 'toast-enter'"
						class="w-full bg-popover/95 backdrop-blur-lg text-popover-foreground rounded-2xl shadow-modern-lg border border-border/50 pt-5 pb-4 px-4 flex items-center justify-center relative overflow-hidden group max-w-md min-w-[320px] mb-2"
						role="alert"
						:aria-live="toast.type === 'error' ? 'assertive' : 'polite'"
					>
						<!-- Progress Bar (Simulated) -->
						<div class="absolute top-0 start-0 end-0 h-1 overflow-hidden" x-show="toast.duration > 0">
							<div
								class="toast-progress h-full ltr:origin-left rtl:origin-right transition-transform ease-linear"
								:class="{
									'bg-gray-500': !toast.type || toast.type === 'default',
									'bg-green-500': toast.type === 'success',
									'bg-red-500': toast.type === 'error',
									'bg-yellow-500': toast.type === 'warning',
									'bg-blue-500': toast.type === 'info'
								}"
								:style="`animation: shrink ${toast.duration || 3000}ms linear forwards`"
							></div>
						</div>
						<!-- Icon -->
						<div class="shrink-0 me-3">
							<template x-if="toast.type === 'success'">
								@icon.CircleCheck(icon.Props{Size: 22, Class: "text-green-500"})
							</template>
							<template x-if="toast.type === 'error'">
								@icon.CircleX(icon.Props{Size: 22, Class: "text-red-500"})
							</template>
							<template x-if="toast.type === 'warning'">
								@icon.TriangleAlert(icon.Props{Size: 22, Class: "text-yellow-500"})
							</template>
							<template x-if="toast.type === 'info'">
								@icon.Info(icon.Props{Size: 22, Class: "text-blue-500"})
							</template>
						</div>
						<!-- Content -->
						<div class="flex-1 min-w-0">
							<p class="text-sm font-semibold truncate" x-text="toast.message"></p>
							<!-- Description support if we add it later -->
							<!-- <p class="text-sm opacity-90 mt-1" x-text="toast.description"></p> -->
						</div>
						<!-- Close Button -->
						<button
							@click="dismissToast(toast.id)"
							class="shrink-0 inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-6 w-6 ms-2 opacity-75 hover:opacity-100"
							type="button"
							aria-label="Close notification"
						>
							@icon.X(icon.Props{Size: 18})
						</button>
					</div>
				</template>
			</div>
		</div>
	}
}
