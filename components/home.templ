package components

import (
	"school-with-ai/components/banner"
	"school-with-ai/components/chat"
	"school-with-ai/components/chatinput"
	"school-with-ai/components/code"
	"school-with-ai/components/collapsible"
	"school-with-ai/components/copybutton"
	"school-with-ai/components/dialog"
	"school-with-ai/components/dropdown"
	"school-with-ai/components/eventlog"
	"school-with-ai/components/footer"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
	"school-with-ai/components/keyboardshortcuts"
	"school-with-ai/components/messagelist"
	"school-with-ai/components/popover"
	"school-with-ai/components/selectbox"
	"school-with-ai/components/nav"
	"school-with-ai/components/sidebar"
	"school-with-ai/components/tabs"
	"school-with-ai/components/textarea"
	"school-with-ai/domain"
)

templ HomeExtraHead() {
	<script src="https://cdn.jsdelivr.net/npm/markdown-it@14/dist/markdown-it.min.js"></script>
	<script>
	let script = document.createElement('script');
	script.src = "https://cdn.jsdelivr.net/npm/mathpix-markdown-it@1.3.6/es5/bundle.js";
	document.head.append(script);

	script.onload = function() {
		console.log('Mathpix loaded');
	}
</script>
	<script type="module" src="/assets/js/chat.js?v=limit10"></script>
	<!-- Alpine.js Intersect Plugin - MUST load before Alpine core -->
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
	<!-- Alpine.js Collapse Plugin - MUST load before Alpine core -->
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
	@input.Script()
	@collapsible.Script()
	@popover.Script()
	@textarea.Script()
	@sidebar.Script()
	@code.Script()
	@tabs.Script()
	@selectbox.Script()
	@copybutton.Script()
	@dropdown.Script()
	@dialog.Script()
	<style>
		@keyframes shrink {
			from { transform: scaleX(1); }
			to { transform: scaleX(0); }
		}

		/* Ensure inline math stays inline and doesn't force new lines */
		mjx-container:not([display="true"]) {
			display: inline-block !important;
			vertical-align: middle;
			margin: 0 0.1em !important;
			width: auto !important;
		}
		
		/* Ensure it stays inline within prose containers */
		.prose mjx-container:not([display="true"]) {
			display: inline-block !important;
		}

		/* Remove excessive margins from display math */
		mjx-container[display="true"] {
			display: block !important;
			margin-top: 1em !important;
			margin-bottom: 1em !important;
			width: 100% !important;
		}
		
		/* RTL alignment for display math */
		[dir="rtl"] mjx-container[display="true"] {
			text-align: right !important;
		}
	</style>
}

templ ChatInputScreen(user *domain.User) {
	@BaseLayout(LayoutProps{
		Title:     "Chat",
		User:      user,
		ExtraHead: HomeExtraHead(),
	}) {
		<div class="w-full h-full flex flex-col" x-data="chat" @agent-selected.window="selectedAgent = $event.detail.id">
			<!-- Sidebar Layout -->
			<div class="flex-1">
				@sidebar.Layout(sidebar.LayoutProps{Class: "h-full min-h-0"}) {
					@nav.Nav()
					<!-- Main Content Area -->
					<div class="flex-1 flex h-full overflow-hidden relative">
						<!-- Main Chat Panel -->
						<main
							class="flex flex-col relative overflow-hidden w-full h-full"
						>
							<!-- Global Banner -->
							@banner.Banner()
							<!-- Header -->
							@nav.MobileNav()
							@chat.Header()
							<!-- Content wrapper - class switches based on state -->
							<div
								class="flex flex-col"
								:class="(hasMessages || isStreaming)
									? 'h-full overflow-y-auto'
									: 'flex-1 items-center justify-end sm:justify-center'"
							>
								<!-- Messages state -->
								<div
									x-show="hasMessages || isStreaming"
									class="relative flex-1 overflow-hidden overflow-y-auto"
								>
									<div
										x-ref="messageList"
										@scroll="scrolledUp = ($refs.messageList.scrollHeight - $refs.messageList.scrollTop - $refs.messageList.clientHeight) > 100"
										style="height: 100%; overflow-y: auto; width: 100%; scrollbar-gutter: stable;"
										role="log"
										aria-live="polite"
									>
										<div class="flex flex-col pb-9 pt-14">
											<div class="w-full max-w-3xl xl:max-w-4xl mx-auto px-4">
												@messagelist.MessageList()
											</div>
											<div id="messages-end" class="h-0 w-full flex-shrink-0"></div>
										</div>
									</div>
									<!-- Scroll to Bottom Button -->
									<button
										x-show="scrolledUp"
										x-transition:enter="transition ease-out duration-200"
										x-transition:enter-start="opacity-0 translate-y-2"
										x-transition:enter-end="opacity-100 translate-y-0"
										x-transition:leave="transition ease-in duration-150"
										x-transition:leave-start="opacity-100 translate-y-0"
										x-transition:leave-end="opacity-0 translate-y-2"
										@click="scrollToBottom()"
										class="absolute bottom-5 left-1/2 -translate-x-1/2 cursor-pointer rounded-full border border-border bg-background p-2 shadow-md hover:shadow-lg hover:bg-accent/50 transition-all z-10"
										aria-label="Scroll to bottom"
									>
										@icon.ChevronDown(icon.Props{Class: "size-5 text-muted-foreground"})
									</button>
								</div>
								<!-- ChatForm - SINGLE instance -->
								<div
									class="w-full"
									:class="(!hasMessages && !isStreaming) ? 'max-w-3xl xl:max-w-4xl mx-auto transition-all duration-200' : ''"
								>
									<div
										class="mx-auto flex w-full flex-row gap-3 transition-[max-width] duration-300 sm:px-2"
										:class="(hasMessages || isStreaming) ? 'max-w-3xl xl:max-w-4xl sm:mb-4' : 'sm:mb-28'"
									>
										@chatinput.ChatInput()
									</div>
						
									<div x-show="hasMessages || isStreaming">
										@footer.CompactFooter()
									</div>
								</div>
							</div>
							<!-- Footer (Landing Page) -->
							<div x-show="!hasMessages && !isStreaming">
								@footer.Footer()
							</div>
							@eventlog.EventLog()
						</main>
					</div>
				}
			</div>
			<!-- Keyboard Shortcuts Dialog -->
			<div x-show="showKeyboardShortcuts" x-cloak>
				@dialog.Dialog(dialog.Props{Open: true}) {
					<div x-show="showKeyboardShortcuts" @click.away="showKeyboardShortcuts = false">
						@keyboardshortcuts.KeyboardShortcuts()
					</div>
				}
			</div>
			<!-- Settings Dialog -->
			@nav.Settings()
			<!-- Toast Notifications -->
			<div
				class="toast-container"
				role="region"
				aria-live="polite"
				aria-label="Notifications"
			>
				<template x-for="toast in toasts" :key="toast.id">
					<div
						:class="toast.leaving ? 'toast-leave' : 'toast-enter'"
						class="w-full bg-popover text-popover-foreground rounded-lg shadow-xs border pt-5 pb-4 px-4 flex items-center justify-center relative overflow-hidden group max-w-md min-w-[320px] mb-2"
						role="alert"
						:aria-live="toast.type === 'error' ? 'assertive' : 'polite'"
					>
						<!-- Progress Bar (Simulated) -->
						<div class="absolute top-0 left-0 right-0 h-1 overflow-hidden" x-show="toast.duration > 0">
							<div
								class="toast-progress h-full ltr:origin-left rtl:origin-right transition-transform ease-linear"
								:class="{
									'bg-gray-500': !toast.type || toast.type === 'default',
									'bg-green-500': toast.type === 'success',
									'bg-red-500': toast.type === 'error',
									'bg-yellow-500': toast.type === 'warning',
									'bg-blue-500': toast.type === 'info'
								}"
								:style="`animation: shrink ${toast.duration || 3000}ms linear forwards`"
							></div>
						</div>
						<!-- Icon -->
						<div class="shrink-0 me-3">
							<template x-if="toast.type === 'success'">
								@icon.CircleCheck(icon.Props{Size: 22, Class: "text-green-500"})
							</template>
							<template x-if="toast.type === 'error'">
								@icon.CircleX(icon.Props{Size: 22, Class: "text-red-500"})
							</template>
							<template x-if="toast.type === 'warning'">
								@icon.TriangleAlert(icon.Props{Size: 22, Class: "text-yellow-500"})
							</template>
							<template x-if="toast.type === 'info'">
								@icon.Info(icon.Props{Size: 22, Class: "text-blue-500"})
							</template>
						</div>
						<!-- Content -->
						<div class="flex-1 min-w-0">
							<p class="text-sm font-semibold truncate" x-text="toast.message"></p>
							<!-- Description support if we add it later -->
							<!-- <p class="text-sm opacity-90 mt-1" x-text="toast.description"></p> -->
						</div>
						<!-- Close Button -->
						<button
							@click="dismissToast(toast.id)"
							class="shrink-0 inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-6 w-6 ms-2 opacity-75 hover:opacity-100"
							type="button"
							aria-label="Close notification"
						>
							@icon.X(icon.Props{Size: 18})
						</button>
					</div>
				</template>
			</div>
		</div>
	}
}
