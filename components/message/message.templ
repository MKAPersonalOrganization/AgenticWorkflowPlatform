package message

templ UserMessage() {
	<div x-show="message.role === 'user'" class="flex items-center gap-2 justify-end group/usermessage">
		<div class="flex flex-col gap-2 relative">
			<!-- Copy button -->
			<button
				@click="copyMessage(message.id)"
				class="absolute -left-10 top-2 opacity-0 group-hover/usermessage:opacity-100 transition-opacity inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background hover:bg-accent hover:text-accent-foreground h-8 w-8 touch-target"
				type="button"
				aria-label="Copy message"
				title="Copy message"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
				</svg>
			</button>
			<div class="bg-muted ml-auto w-fit rounded-3xl px-4 py-2 text-right prose prose-sm text-sm text-foreground dark:[&_*]:text-white" x-html="renderMarkdown(message.content)"></div>
		</div>
	</div>
}

templ AssistantMessage() {
	<div x-show="message.role === 'assistant'" class="flex flex-col gap-2 group/assistantmessage relative">
		<!-- Copy button -->
		<button
			@click="copyMessage(message.id)"
			class="absolute -right-10 top-2 opacity-0 group-hover/assistantmessage:opacity-100 transition-opacity inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background hover:bg-accent hover:text-accent-foreground h-8 w-8 touch-target"
			type="button"
			aria-label="Copy message"
			title="Copy message"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
			</svg>
		</button>
		<div class="prose prose-sm max-w-none text-sm leading-relaxed text-foreground dark:[&_*]:text-white" x-html="renderMarkdown(message.content)"></div>
		<!-- Streaming Indicator -->
		<div x-show="message.streaming" class="flex items-center gap-1 text-muted-foreground">
			<span class="w-1 h-1 bg-current rounded-full animate-pulse"></span>
			<span class="w-1 h-1 bg-current rounded-full animate-pulse" style="animation-delay: 150ms;"></span>
			<span class="w-1 h-1 bg-current rounded-full animate-pulse" style="animation-delay: 300ms;"></span>
		</div>
	</div>
}
