package message

import "school-with-ai/components/button"
import "school-with-ai/components/icon"
import "school-with-ai/components/utils"

type ActionProps struct {
    MessageID string
    Role      string // "user" or "assistant"
    IsLast    bool   // To conditionally show "Regenerate"
}

templ Actions(props ActionProps) {
    <div class={ utils.TwMerge(
        "flex items-center gap-1 opacity-0 transition-opacity duration-200",
        // Show on group hover (parent message container must have 'group' class)
        "group-hover/message:opacity-100",
        // Mobile: always visible or different behavior? For now, stick to hover for desktop
        "md:opacity-0", 
    ) }>
        <!-- Copy Button -->
        @button.Button(button.Props{
            Size:    button.SizeIcon,
            Variant: button.VariantGhost,
            Class:   "size-6 text-muted-foreground hover:text-foreground hover:bg-muted/50 rounded-sm",
            Attributes: templ.Attributes{
                "@click": "copyMessage('" + props.MessageID + "')",
                "title":  "Copy text",
                "aria-label": "Copy text",
            },
        }) {
            @icon.Copy(icon.Props{Class: "size-3.5"})
        }

        if props.Role == "user" {
            <!-- Edit Button (Visual for now) -->
             @button.Button(button.Props{
                Size:    button.SizeIcon,
                Variant: button.VariantGhost,
                Class:   "size-6 text-muted-foreground hover:text-foreground hover:bg-muted/50 rounded-sm",
                Attributes: templ.Attributes{
                    "title":  "Edit message",
                    "aria-label": "Edit message",
                     // Future implementation: "@click": "startEditing('" + props.MessageID + "')",
                },
            }) {
                @icon.SquarePen(icon.Props{Class: "size-3.5"})
            }
        }

        if props.Role == "assistant" {
            <!-- Regenerate Button -->
             @button.Button(button.Props{
                Size:    button.SizeIcon,
                Variant: button.VariantGhost,
                Class:   "size-6 text-muted-foreground hover:text-foreground hover:bg-muted/50 rounded-sm",
                Attributes: templ.Attributes{
                    "@click": "regenerateResponse('" + props.MessageID + "')", 
                    "title":  "Regenerate response",
                     "aria-label": "Regenerate response",
                },
            }) {
                @icon.RotateCw(icon.Props{Class: "size-3.5"})
            }
        }
    </div>
}
