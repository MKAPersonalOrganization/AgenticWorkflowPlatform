package agents

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
	"school-with-ai/components/label"
	"school-with-ai/components/textarea"
)

templ AgentsDialog() {
	<div
		x-data="agentsManager"
		@open-agents-dialog.window="open()"
		@open-agent-store.window="open(); $nextTick(() => activeTab = 'store')"
	>
		@dialog.Dialog(dialog.Props{
			ID: "agents-manager-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "sm:max-w-4xl max-h-[90vh] flex flex-col p-0 overflow-hidden",
			}) {
				<!-- Main View (Agent List + Store Tabs) -->
				<template x-if="view === 'list'">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
							<div class="flex items-center justify-between mb-3">
								<div>
									@dialog.Title() {
										{ i18n.T(ctx, "Agents") }
									}
									@dialog.Description() {
										{ i18n.T(ctx, "Manage personal agents or browse the store.") }
									}
								</div>
							</div>
							<!-- Tab Bar -->
							<div class="flex gap-0 -mb-px">
								<button
									type="button"
									@click="switchTab('my-agents')"
									class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
									:class="activeTab === 'my-agents' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
								>
									@icon.Compass(icon.Props{Class: "size-4 inline-block mr-1.5 -mt-0.5"})
									{ i18n.T(ctx, "My Agents") }
								</button>
								<button
									type="button"
									@click="switchTab('store')"
									class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
									:class="activeTab === 'store' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
								>
									@icon.Store(icon.Props{Class: "size-4 inline-block mr-1.5 -mt-0.5"})
									{ i18n.T(ctx, "Agent Store") }
								</button>
							</div>
						}
						<!-- ═══════ My Agents Tab ═══════ -->
						<template x-if="activeTab === 'my-agents'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<!-- Search + Create Bar -->
								<div class="px-4 pt-3 pb-2 flex items-center gap-2">
									<div class="flex-1">
										@input.Input(input.Props{
											Type:        input.TypeSearch,
											Placeholder: i18n.T(ctx, "Search your agents..."),
											Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
											Attributes: templ.Attributes{
												"x-model.debounce.300ms": "searchQuery",
												"@input":                 "searchAgents()",
											},
										})
									</div>
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantDefault,
										Class:   "gap-1.5 shrink-0",
										Attributes: templ.Attributes{
											"@click": "showCreateForm()",
										},
									}) {
										@icon.Plus(icon.Props{Class: "size-4"})
										{ i18n.T(ctx, "New Agent") }
									}
								</div>
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<!-- Loading State -->
									<template x-if="loading">
										<div class="space-y-3">
											<template x-for="i in 3" :key="i">
												<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
													<div class="size-10 rounded-lg bg-muted"></div>
													<div class="flex-1 space-y-2">
														<div class="h-4 bg-muted rounded-md w-1/3"></div>
														<div class="h-3 bg-muted rounded-md w-2/3"></div>
													</div>
												</div>
											</template>
										</div>
									</template>
									<!-- Loaded content -->
									<template x-if="!loading">
										<div>
											<!-- Empty State -->
											<template x-if="filteredAgents.length === 0">
												<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
													@icon.Compass(icon.Props{Class: "size-12 opacity-20"})
													<template x-if="searchQuery">
														<div class="text-center">
															<p class="text-sm font-medium">{ i18n.T(ctx, "No agents found") }</p>
															<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search term.") }</p>
														</div>
													</template>
													<template x-if="!searchQuery">
														<div class="text-center">
															<p class="text-sm font-medium">{ i18n.T(ctx, "No custom agents yet") }</p>
															<p class="text-xs mt-1">{ i18n.T(ctx, "Create your first agent to get started.") }</p>
															@button.Button(button.Props{
																Size:    button.SizeSm,
																Variant: button.VariantOutline,
																Class:   "mt-3 gap-1.5",
																Attributes: templ.Attributes{
																	"@click": "showCreateForm()",
																},
															}) {
																@icon.Plus(icon.Props{Class: "size-3.5"})
																{ i18n.T(ctx, "Create Agent") }
															}
														</div>
													</template>
												</div>
											</template>
											<!-- Agent Cards -->
											<div class="space-y-2">
												<template x-for="ag in filteredAgents" :key="ag.id">
													<div
														class="group relative rounded-xl border-2 transition-all duration-200 cursor-pointer overflow-hidden"
														:class="selectedAgent === ag.id
															? 'border-primary bg-primary/4 shadow-[0_0_0_1px_hsl(var(--primary)/0.15),0_2px_8px_-2px_hsl(var(--primary)/0.12)]'
															: 'border-transparent bg-card hover:border-border hover:shadow-sm'"
														@click="selectedAgent !== ag.id && selectAgentForChat(ag.id)"
													>
														<!-- Active indicator bar -->
														<div
															class="absolute inset-y-0 left-0 w-1 rounded-l-xl transition-all duration-200"
															:class="selectedAgent === ag.id ? 'bg-primary' : 'bg-transparent group-hover:bg-border'"
														></div>
														<div class="flex items-start gap-3.5 p-3.5 pl-5">
															<!-- Agent Icon -->
															<div
																class="size-11 rounded-xl flex items-center justify-center shrink-0 [&_svg]:size-5 transition-colors duration-200"
																:class="selectedAgent === ag.id
																	? 'bg-primary text-primary-foreground shadow-sm'
																	: 'bg-primary/10 text-primary'"
																x-html="ag.icon"
															></div>
															<!-- Content -->
															<div class="flex-1 min-w-0">
																<div class="flex items-center gap-2 mb-0.5">
																	<h3 class="text-sm font-semibold text-foreground truncate" x-text="ag.name"></h3>
																	<template x-if="selectedAgent === ag.id">
																		<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-semibold bg-primary/15 text-primary border border-primary/20 select-none">
																			<span class="relative flex size-1.5">
																				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
																				<span class="relative inline-flex rounded-full size-1.5 bg-primary"></span>
																			</span>
																			{ i18n.T(ctx, "Active") }
																		</span>
																	</template>
																</div>
																<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="ag.description || 'No description'"></p>
																<div class="flex items-center gap-3 mt-2">
																	<span class="text-[10px] text-muted-foreground" x-text="'Created ' + formatDate(ag.createdAt)"></span>
																	<template x-if="ag.modelId">
																		<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-muted text-muted-foreground" x-text="ag.modelId"></span>
																	</template>
																</div>
															</div>
															<!-- Actions -->
															<div class="flex items-center gap-1.5 shrink-0" @click.stop>
																<!-- Use Agent button (shown for non-active agents) -->
																<template x-if="selectedAgent !== ag.id">
																	@button.Button(button.Props{
																		Size:    button.SizeSm,
																		Variant: button.VariantDefault,
																		Class:   "text-xs px-3 h-8 gap-1.5 font-medium shadow-sm",
																		Attributes: templ.Attributes{
																			"@click.stop": "selectAgentForChat(ag.id)",
																		},
																	}) {
																		@icon.Sparkles(icon.Props{Class: "size-3.5"})
																		{ i18n.T(ctx, "Use Agent") }
																	}
																</template>
																<!-- Active indicator (shown for active agent) -->
																<template x-if="selectedAgent === ag.id">
																	<span class="inline-flex items-center gap-1.5 h-8 px-3 text-xs font-medium text-primary rounded-md bg-primary/10 border border-primary/20 select-none">
																		@icon.CircleCheck(icon.Props{Class: "size-3.5"})
																		{ i18n.T(ctx, "In Use") }
																	</span>
																</template>
																<!-- Edit & Delete -->
																<div class="flex items-center gap-0.5 ml-1 pl-1.5 border-l border-border transition-opacity duration-150" :class="selectedAgent === ag.id ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'">
																	@button.Button(button.Props{
																		Size:    button.SizeIcon,
																		Variant: button.VariantGhost,
																		Class:   "size-7",
																		Attributes: templ.Attributes{
																			"@click.stop": "showEditForm(ag)",
																			"title":       i18n.T(ctx, "Edit"),
																		},
																	}) {
																		@icon.Pencil(icon.Props{Class: "size-3.5"})
																	}
																	@button.Button(button.Props{
																		Size:    button.SizeIcon,
																		Variant: button.VariantGhost,
																		Class:   "size-7 text-destructive hover:text-destructive",
																		Attributes: templ.Attributes{
																			"@click.stop": "confirmDelete(ag)",
																			"title":       i18n.T(ctx, "Delete"),
																		},
																	}) {
																		@icon.Trash2(icon.Props{Class: "size-3.5"})
																	}
																</div>
															</div>
														</div>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>
						<!-- ═══════ Agent Store Tab ═══════ -->
						<template x-if="activeTab === 'store'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<!-- Search + Category Filters -->
								<div class="px-4 pt-3 pb-2 space-y-2">
									@input.Input(input.Props{
										Type:        input.TypeSearch,
										Placeholder: i18n.T(ctx, "Search the agent store..."),
										Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
										Attributes: templ.Attributes{
											"x-model.debounce.300ms": "storeSearchQuery",
											"@input":                 "searchCatalog()",
										},
									})
									<!-- Category Pills -->
									<div class="flex flex-wrap gap-1.5" x-show="storeCategories.length > 0">
										<button
											type="button"
											@click="filterByCategory('')"
											class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium transition-colors border"
											:class="!selectedCategory ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent hover:text-foreground'"
										>
											{ i18n.T(ctx, "All") }
										</button>
										<template x-for="cat in storeCategories" :key="cat">
											<button
												type="button"
												@click="filterByCategory(cat)"
												class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium transition-colors border"
												:class="selectedCategory === cat ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent hover:text-foreground'"
												x-text="cat"
											></button>
										</template>
									</div>
								</div>
								<!-- Store Entries Grid -->
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<!-- Loading -->
									<template x-if="storeLoading">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
											<template x-for="i in 6" :key="i">
												<div class="p-4 rounded-lg border border-border animate-pulse">
													<div class="flex items-center gap-3 mb-3">
														<div class="size-10 rounded-lg bg-muted"></div>
														<div class="flex-1 space-y-2">
															<div class="h-4 bg-muted rounded w-2/3"></div>
															<div class="h-3 bg-muted rounded w-1/3"></div>
														</div>
													</div>
													<div class="h-3 bg-muted rounded w-full mb-2"></div>
													<div class="h-3 bg-muted rounded w-4/5"></div>
												</div>
											</template>
										</div>
									</template>
									<!-- Loaded -->
									<template x-if="!storeLoading">
										<div>
											<!-- Empty State -->
											<template x-if="storeEntries.length === 0">
												<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
													@icon.Store(icon.Props{Class: "size-12 opacity-20"})
													<div class="text-center">
														<p class="text-sm font-medium">{ i18n.T(ctx, "No agents found") }</p>
														<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search or category.") }</p>
													</div>
												</div>
											</template>
											<!-- Agent Store Cards (2-col grid) -->
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
												<template x-for="entry in storeEntries" :key="entry.id">
													<div class="group p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-accent/30 transition-all duration-150 flex flex-col">
														<div class="flex items-start gap-3 mb-2">
															<!-- Agent icon (SVG) -->
															<div
																class="size-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0 [&_svg]:size-5"
																x-html="entry.iconLabel"
															></div>
															<div class="flex-1 min-w-0">
																<div class="flex items-center gap-2">
																	<h3 class="text-sm font-semibold text-foreground truncate" x-text="entry.name"></h3>
																</div>
																<span class="text-[10px] text-muted-foreground" x-text="entry.category"></span>
															</div>
														</div>
														<p class="text-xs text-muted-foreground line-clamp-2 mb-3 flex-1" x-text="entry.description"></p>
														<div class="flex items-center justify-between mt-auto">
															<div class="flex flex-wrap gap-1">
																<template x-for="tag in (entry.tags || []).slice(0, 3)" :key="tag">
																	@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[9px] px-1.5 py-0 h-4"}) {
																		<span x-text="tag"></span>
																	}
																</template>
															</div>
															<!-- Already added state -->
															<template x-if="addedCatalogIds.includes(entry.id)">
																<span class="inline-flex items-center gap-1 h-7 px-2.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 rounded-md bg-emerald-500/10 border border-emerald-500/20 select-none">
																	@icon.Check(icon.Props{Class: "size-3"})
																	{ i18n.T(ctx, "Added") }
																</span>
															</template>
															<!-- Add / Adding button -->
															<template x-if="!addedCatalogIds.includes(entry.id)">
																<button
																	type="button"
																	@click.stop="addFromStore(entry)"
																	x-bind:disabled="storeAddingIds.includes(entry.id)"
																	class="inline-flex items-center justify-center gap-1 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 cursor-pointer border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-7 px-2.5 text-xs shrink-0"
																>
																	<span x-show="!storeAddingIds.includes(entry.id)" class="flex items-center gap-1">
																		@icon.Plus(icon.Props{Class: "size-3"})
																		{ i18n.T(ctx, "Add") }
																	</span>
																	<span x-show="storeAddingIds.includes(entry.id)" class="flex items-center gap-1">
																		<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
																		{ i18n.T(ctx, "Adding...") }
																	</span>
																</button>
															</template>
														</div>
														<!-- Inline success toast (shows briefly after adding) -->
														<div
															x-show="storeSuccessId === entry.id"
															x-transition:enter="transition ease-out duration-200"
															x-transition:enter-start="opacity-0 translate-y-1"
															x-transition:enter-end="opacity-100 translate-y-0"
															x-transition:leave="transition ease-in duration-150"
															x-transition:leave-start="opacity-100 translate-y-0"
															x-transition:leave-end="opacity-0 translate-y-1"
															class="mt-2 flex items-center gap-1.5 rounded-md bg-emerald-500/10 border border-emerald-500/20 px-2 py-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400"
														>
															@icon.Check(icon.Props{Class: "size-3"})
															{ i18n.T(ctx, "Agent added to My Agents!") }
														</div>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<span class="text-xs text-muted-foreground">
									<template x-if="activeTab === 'my-agents'">
										<span x-text="`${filteredAgents.length} agent${filteredAgents.length !== 1 ? 's' : ''}`"></span>
									</template>
									<template x-if="activeTab === 'store'">
										<span x-text="`${storeTotal} agent${storeTotal !== 1 ? 's' : ''} in store`"></span>
									</template>
								</span>
								@dialog.Close() {
									@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
										{ i18n.T(ctx, "Close") }
									}
								}
							</div>
						}
					</div>
				</template>
				<!-- Create/Edit Form View -->
				<template x-if="view === 'form'">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-center gap-2">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-8",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								<div>
									@dialog.Title() {
										<span x-text="editingAgent ? 'Edit Agent' : 'Create New Agent'"></span>
									}
									@dialog.Description() {
										<span x-text="editingAgent ? 'Modify your agent configuration.' : 'Configure your new AI agent.'"></span>
									}
								</div>
							</div>
						}
						<div class="flex-1 overflow-y-auto p-4 scrollbar-thin space-y-4">
							<!-- Agent Name -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Agent Name") }
									<span class="text-destructive">*</span>
								}
								@input.Input(input.Props{
									Placeholder: i18n.T(ctx, "e.g., Writing Coach, Code Reviewer..."),
									Attributes: templ.Attributes{
										"x-model":   "form.name",
										"maxlength": "100",
									},
								})
							</div>
							<!-- Description -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Description") }
								}
								@input.Input(input.Props{
									Placeholder: i18n.T(ctx, "Brief description of what this agent does..."),
									Attributes: templ.Attributes{
										"x-model":   "form.description",
										"maxlength": "500",
									},
								})
							</div>
							<!-- System Prompt -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "System Prompt") }
									<span class="text-destructive">*</span>
								}
								@textarea.Textarea(textarea.Props{
									Placeholder: i18n.T(ctx, "Instructions for how the agent should behave..."),
									Class:       "min-h-[120px] resize-y",
									Rows:        5,
									Attributes: templ.Attributes{
										"x-model": "form.systemPrompt",
									},
								})
								<p class="text-[11px] text-muted-foreground">
									{ i18n.T(ctx, "This is the instruction that defines the agent's personality, expertise, and behavior.") }
								</p>
							</div>
							<!-- Advanced Settings (Collapsible) -->
							<div class="border border-border rounded-lg">
								<button
									type="button"
									@click="showAdvanced = !showAdvanced"
									class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
								>
									<span class="flex items-center gap-2">
										@icon.Settings(icon.Props{Class: "size-4 text-muted-foreground"})
										{ i18n.T(ctx, "Advanced Settings") }
									</span>
									<span
										class="transition-transform duration-200"
										:class="showAdvanced ? 'rotate-180' : ''"
									>
										@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
									</span>
								</button>
								<div x-show="showAdvanced" x-collapse class="px-3 pb-3 space-y-4 border-t border-border pt-3">
									<!-- Model Override -->
									<div class="space-y-2">
										@label.Label(label.Props{}) {
											{ i18n.T(ctx, "Model Override") }
										}
										@input.Input(input.Props{
											Placeholder: i18n.T(ctx, "Leave empty to use your default model"),
											Attributes: templ.Attributes{
												"x-model": "form.modelId",
											},
										})
										<p class="text-[11px] text-muted-foreground">
											{ i18n.T(ctx, "Optionally override the AI model used by this agent.") }
										</p>
									</div>
									<!-- Temperature -->
									<div class="space-y-2">
										@label.Label(label.Props{}) {
											{ i18n.T(ctx, "Temperature") }
										}
										<div class="flex items-center gap-3">
											<input
												type="range"
												min="0"
												max="2"
												step="0.1"
												x-model="form.temperature"
												class="flex-1 h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary"
											/>
											<span class="text-sm text-muted-foreground tabular-nums w-8 text-right" x-text="parseFloat(form.temperature).toFixed(1)"></span>
										</div>
										<p class="text-[11px] text-muted-foreground">
											{ i18n.T(ctx, "Lower values make output more focused, higher values more creative.") }
										</p>
									</div>
									<!-- Max Iterations -->
									<div class="space-y-2">
										@label.Label(label.Props{}) {
											{ i18n.T(ctx, "Max Iterations") }
										}
										@input.Input(input.Props{
											Type: input.TypeNumber,
											Attributes: templ.Attributes{
												"x-model.number": "form.maxIterations",
												"min":            "1",
												"max":            "50",
											},
										})
										<p class="text-[11px] text-muted-foreground">
											{ i18n.T(ctx, "Maximum number of tool-calling loops per request.") }
										</p>
									</div>
								</div>
							</div>
							<!-- Tools & Knowledge Bases (only when editing an existing agent) -->
							<template x-if="editingAgent">
								<div class="space-y-4">
									<!-- Tools Section -->
									<div class="border border-border rounded-lg">
										<button
											type="button"
											@click="showTools = !showTools"
											class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
										>
											<span class="flex items-center gap-2">
												@icon.Blocks(icon.Props{Class: "size-4 text-muted-foreground"})
												{ i18n.T(ctx, "Tools") }
												<span class="text-[10px] text-muted-foreground tabular-nums" x-text="toolsSummary"></span>
											</span>
											<span
												class="transition-transform duration-200"
												:class="showTools ? 'rotate-180' : ''"
											>
												@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
											</span>
										</button>
										<div x-show="showTools" x-collapse class="px-3 pb-3 border-t border-border pt-3">
											<!-- Loading -->
											<template x-if="loadingTools">
												<div class="space-y-2">
													<template x-for="i in 3" :key="i">
														<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
															<div class="size-7 rounded bg-muted"></div>
															<div class="flex-1 space-y-1">
																<div class="h-3 bg-muted rounded w-1/3"></div>
																<div class="h-2 bg-muted rounded w-2/3"></div>
															</div>
														</div>
													</template>
												</div>
											</template>
											<!-- Loaded plugins -->
											<template x-if="!loadingTools">
												<div>
													<template x-if="agentPlugins.length === 0">
														<div class="py-4 text-center text-xs text-muted-foreground">
															{ i18n.T(ctx, "No plugins available. Add plugins from the Tools sidebar.") }
														</div>
													</template>
													<div class="space-y-1.5">
														<template x-for="plugin in agentPlugins" :key="plugin.id">
															<div class="rounded-md border border-border">
																<!-- Plugin header with toggle -->
																<div class="flex items-center justify-between p-2 hover:bg-accent/20 transition-colors">
																	<div class="flex items-center gap-2 flex-1 min-w-0">
																		<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
																			@icon.Blocks(icon.Props{Class: "size-3.5"})
																		</div>
																		<div class="flex-1 min-w-0">
																			<div class="text-xs font-medium text-foreground truncate" x-text="plugin.name"></div>
																			<div class="text-[10px] text-muted-foreground truncate" x-text="plugin.tools.length + ' tools'"></div>
																		</div>
																	</div>
																	<button
																		@click="toggleAgentPlugin(plugin)"
																		class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
																		:class="plugin.enabled ? 'bg-primary' : 'bg-input'"
																		role="switch"
																		:aria-checked="plugin.enabled"
																	>
																		<span
																			class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
																			:class="plugin.enabled ? 'translate-x-4' : 'translate-x-0'"
																		></span>
																	</button>
																</div>
																<!-- Individual tools (collapsible, only when plugin is enabled) -->
																<template x-if="plugin.enabled && plugin.tools.length > 1">
																	<div class="border-t border-border/50 px-2 py-1.5 space-y-1">
																		<template x-for="tool in plugin.tools" :key="tool.id">
																			<div class="flex items-center justify-between py-1 px-2 rounded hover:bg-accent/20">
																				<span class="text-[11px] text-muted-foreground truncate flex-1" x-text="tool.name"></span>
																				<button
																					@click="toggleAgentTool(plugin, tool)"
																					class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
																					:class="tool.enabled ? 'bg-primary' : 'bg-input'"
																					role="switch"
																					:aria-checked="tool.enabled"
																				>
																					<span
																						class="pointer-events-none inline-block h-3 w-3 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
																						:class="tool.enabled ? 'translate-x-3' : 'translate-x-0'"
																					></span>
																				</button>
																			</div>
																		</template>
																	</div>
																</template>
															</div>
														</template>
													</div>
												</div>
											</template>
										</div>
									</div>
									<!-- Knowledge Bases Section -->
									<div class="border border-border rounded-lg">
										<button
											type="button"
											@click="showKnowledgeBases = !showKnowledgeBases"
											class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
										>
											<span class="flex items-center gap-2">
												@icon.Library(icon.Props{Class: "size-4 text-muted-foreground"})
												{ i18n.T(ctx, "Knowledge Bases") }
												<span class="text-[10px] text-muted-foreground tabular-nums" x-text="kbSummary"></span>
											</span>
											<span
												class="transition-transform duration-200"
												:class="showKnowledgeBases ? 'rotate-180' : ''"
											>
												@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
											</span>
										</button>
										<div x-show="showKnowledgeBases" x-collapse class="px-3 pb-3 border-t border-border pt-3">
											<!-- Loading -->
											<template x-if="loadingKBs">
												<div class="space-y-2">
													<template x-for="i in 3" :key="i">
														<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
															<div class="size-7 rounded bg-muted"></div>
															<div class="flex-1 space-y-1">
																<div class="h-3 bg-muted rounded w-1/3"></div>
																<div class="h-2 bg-muted rounded w-2/3"></div>
															</div>
														</div>
													</template>
												</div>
											</template>
											<!-- Loaded workspaces -->
											<template x-if="!loadingKBs">
												<div>
													<template x-if="agentWorkspaces.length === 0">
														<div class="py-4 text-center text-xs text-muted-foreground">
															{ i18n.T(ctx, "No knowledge bases available. Create one from the Resources sidebar.") }
														</div>
													</template>
													<div class="space-y-1.5">
														<template x-for="ws in agentWorkspaces" :key="ws.id">
															<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
																<div class="flex items-center gap-2 flex-1 min-w-0">
																	<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
																		@icon.Library(icon.Props{Class: "size-3.5"})
																	</div>
																	<div class="flex-1 min-w-0">
																		<div class="text-xs font-medium text-foreground truncate" x-text="ws.name"></div>
																		<div class="text-[10px] text-muted-foreground truncate" x-text="ws.description || ws.slug"></div>
																	</div>
																</div>
																<button
																	@click="toggleAgentWorkspace(ws)"
																	class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
																	:class="ws.enabled ? 'bg-primary' : 'bg-input'"
																	role="switch"
																	:aria-checked="ws.enabled"
																>
																	<span
																		class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
																		:class="ws.enabled ? 'translate-x-4' : 'translate-x-0'"
																	></span>
																</button>
															</div>
														</template>
													</div>
												</div>
											</template>
										</div>
									</div>
								</div>
							</template>
							<!-- Tools Notice (create mode only) -->
							<template x-if="!editingAgent">
								<div class="border border-border rounded-lg p-3 flex items-start gap-2 bg-muted/30">
									@icon.Info(icon.Props{Class: "size-4 text-muted-foreground shrink-0 mt-0.5"})
									<p class="text-[11px] text-muted-foreground">
										{ i18n.T(ctx, "After creating the agent, you can configure its tools and knowledge bases by editing it.") }
									</p>
								</div>
							</template>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-end gap-2 w-full">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									{ i18n.T(ctx, "Cancel") }
								}
								@button.Button(button.Props{
									Variant: button.VariantDefault,
									Class:   "h-8 px-4 text-xs gap-1.5",
									Attributes: templ.Attributes{
										"@click":    "saveAgent()",
										":disabled": "saving || !form.name.trim()",
									},
								}) {
									<span x-show="!saving" x-text="editingAgent ? 'Save Changes' : 'Create Agent'"></span>
									<span x-show="saving" class="flex items-center gap-1.5">
										<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
										{ i18n.T(ctx, "Saving...") }
									</span>
								}
							</div>
						}
					</div>
				</template>
				<!-- Delete Confirmation View -->
				<template x-if="view === 'delete'">
					<div class="flex flex-col h-full">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							@dialog.Title() {
								{ i18n.T(ctx, "Delete Agent") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "This action cannot be undone.") }
							}
						}
						<div class="p-6 flex flex-col items-center gap-4">
							<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
								@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
							</div>
							<p class="text-sm text-center text-foreground">
								{ i18n.T(ctx, "Are you sure you want to delete") }
								<span class="font-semibold" x-text="deletingAgent?.name"></span>?
							</p>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-end gap-2 w-full">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									{ i18n.T(ctx, "Cancel") }
								}
								@button.Button(button.Props{
									Variant: button.VariantDestructive,
									Class:   "h-8 px-4 text-xs gap-1.5",
									Attributes: templ.Attributes{
										"@click":    "deleteAgent()",
										":disabled": "saving",
									},
								}) {
									<span x-show="!saving">{ i18n.T(ctx, "Delete") }</span>
									<span x-show="saving" class="flex items-center gap-1.5">
										<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
										{ i18n.T(ctx, "Deleting...") }
									</span>
								}
							</div>
						}
					</div>
				</template>
			}
		}
	</div>
}

templ AgentsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agents-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agents-dialog')",
				":title": "currentAgentData?.name || '" + i18n.T(ctx, "Agents") + "'",
			},
		}) {
			<!-- Compass icon (shown when no agent matched) -->
			<span x-show="!currentAgentData">
				@icon.Compass(icon.Props{Class: "size-5"})
			</span>
			<!-- Agent icon (shown when an agent is selected) -->
			<span
				x-cloak
				x-show="currentAgentData"
				x-html="currentAgentData?.icon || ''"
				class="size-5 flex items-center justify-center text-foreground [&_svg]:size-4"
			></span>
			<span class="sr-only">{ i18n.T(ctx, "Agents") }</span>
		}
	}
}

// AgentsNavButtonTrigger renders a static compass icon for the navbar.
templ AgentsNavButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agents-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agents-dialog')",
				"title":  i18n.T(ctx, "Agents"),
			},
		}) {
			@icon.Compass(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Agents") }</span>
		}
	}
}

// AgentStoreNavButtonTrigger renders a store icon for the navbar that opens the dialog on the store tab.
templ AgentStoreNavButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agents-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agent-store')",
				"title":  i18n.T(ctx, "Agent Store"),
			},
		}) {
			@icon.Store(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Agent Store") }</span>
		}
	}
}
