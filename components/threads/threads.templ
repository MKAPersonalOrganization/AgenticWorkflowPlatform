package threads

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
)

// ThreadsDialog renders the thread history as a dialog, consistent with other
// navbar-triggered dialogs (agents, tools, resources, search).
// NOTE: This must be rendered inside the x-data="chat" scope so it can access
// session data (getGroupedSessions, switchSession, etc.) directly.
templ ThreadsDialog() {
	<div
		@open-threads-dialog.window="$nextTick(() => {
			$refs.threadSearchInput?.focus();
			setTimeout(() => {
				const el = $refs.threadListScroll;
				if (el && el.scrollHeight <= el.clientHeight && sessionsHasMore && !sessionsLoading) {
					__loadMoreSessions();
				}
			}, 200);
		})"
	>
		@dialog.Dialog(dialog.Props{
			ID: "threads-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "sm:max-w-2xl max-h-[90vh] flex flex-col p-0 overflow-hidden",
			}) {
				@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
					<div class="flex items-center justify-between">
						<div>
							@dialog.Title() {
								{ i18n.T(ctx, "Chats") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "Browse and manage your conversations.") }
							}
						</div>
						@button.Button(button.Props{
							Size:    button.SizeSm,
							Variant: button.VariantDefault,
							Class:   "gap-1.5 shrink-0",
							Attributes: templ.Attributes{
								"@click": "createNewSession(); document.querySelector('[data-tui-dialog-close=\"threads-dialog\"]')?.click()",
							},
						}) {
							@icon.Plus(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "New Chat") }
						}
					</div>
				}
				<!-- Search Input -->
				<div class="px-4 pt-3 pb-2">
					@input.Input(input.Props{
						Type:        input.TypeSearch,
						Placeholder: i18n.T(ctx, "Search chats..."),
						Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
						Attributes: templ.Attributes{
							"x-ref":   "threadSearchInput",
							"x-model": "threadSearchQuery",
						},
					})
				</div>
				<!-- Thread List -->
				<div
					x-ref="threadListScroll"
					class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]"
					@scroll="__onSidebarScroll($event)"
				>
					<!-- Empty State -->
					<template x-if="sessions.length === 0 && !sessionsLoading">
						<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
							@icon.MessageCircle(icon.Props{Class: "size-12 opacity-20"})
							<p class="text-sm font-medium">{ i18n.T(ctx, "No conversations yet") }</p>
							<p class="text-xs">{ i18n.T(ctx, "Start a new chat to get going.") }</p>
						</div>
					</template>
					<!-- Grouped Sessions -->
					<template x-for="(group, groupIndex) in getGroupedSessions()" :key="group.title">
						<div class="mb-1">
							<h2
								class="px-1 pt-2 pb-1 text-muted-foreground text-[0.7rem] font-semibold uppercase tracking-wider"
								:class="groupIndex === 0 ? 'pt-1' : 'pt-3'"
								x-text="group.title"
							></h2>
							<div class="flex flex-col gap-0.5">
								<template x-for="session in group.sessions" :key="session.id">
									<div class="group/item relative">
										<!-- Inline Rename Overlay -->
										<div
											x-show="renamingSessionId === session.id"
											x-cloak
											class="absolute inset-0 z-20 flex w-full items-center rounded-lg bg-accent p-1.5"
										>
											<input
												type="text"
												x-model="renameTitle"
												x-effect="if (renamingSessionId === session.id) { $nextTick(() => { $el.focus(); $el.select(); }) }"
												@keydown.enter.prevent="submitRename()"
												@keydown.escape.prevent="cancelRename()"
												@click.stop
												maxlength="100"
												class="flex-1 rounded bg-transparent p-0.5 text-sm leading-tight text-foreground outline-none"
											/>
											<div class="flex gap-1">
												<button @click.stop="cancelRename()" class="rounded-md p-1 hover:opacity-70">
													@icon.X(icon.Props{Class: "size-4 text-foreground"})
												</button>
												<button @click.stop="submitRename()" class="rounded-md p-1 hover:opacity-70">
													@icon.Check(icon.Props{Class: "size-4 text-foreground"})
												</button>
											</div>
										</div>
										<!-- Conversation Row -->
										<div
											role="button"
											tabindex="0"
											class="flex w-full cursor-pointer select-none items-center gap-3 rounded-lg py-3 px-3 text-sm outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring text-start"
											:class="threadId === session.id
												? 'bg-primary/10 text-primary font-medium'
												: 'hover:bg-accent/50 hover:text-accent-foreground text-foreground'"
											@click="switchSession(session.id); document.querySelector('[data-tui-dialog-close=\'threads-dialog\']')?.click()"
											@keydown.enter="switchSession(session.id); document.querySelector('[data-tui-dialog-close=\'threads-dialog\']')?.click()"
										>
											<div
												class="size-8 rounded-md flex items-center justify-center shrink-0"
												:class="threadId === session.id
													? 'bg-primary/15 text-primary'
													: 'bg-muted/50 text-muted-foreground'"
											>
												@icon.MessageCircle(icon.Props{Class: "size-4"})
											</div>
											<div class="flex flex-col items-start gap-0.5 flex-1 min-w-0">
												<span
													class="truncate w-full"
													x-text="session.title || window.i18n.t('New Chat')"
												></span>
											</div>
											<!-- Options Button -->
											<div
												class="flex items-center opacity-0 group-hover/item:opacity-100 transition-opacity shrink-0"
												:class="threadId === session.id ? '!opacity-100' : ''"
												@click.stop
											>
												@ContextMenu(ContextMenuProps{
													ThreadID: "session.id",
												})
											</div>
										</div>
									</div>
								</template>
							</div>
						</div>
					</template>
					<!-- Loading / Infinite Scroll -->
					<div x-show="sessionsHasMore" x-intersect="__loadMoreSessions()" class="flex justify-center py-4 h-12 w-full">
						<span x-show="sessionsLoading" class="animate-spin size-4 border-2 border-primary border-t-transparent rounded-full"></span>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
					<div class="flex items-center justify-between w-full">
						<span class="text-xs text-muted-foreground" x-text="sessions.length > 0 ? sessions.length + ' ' + (sessions.length === 1 ? window.i18n.t('conversation') : window.i18n.t('conversations')) : ''"></span>
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
								{ i18n.T(ctx, "Close") }
							}
						}
					</div>
				}
			}
		}
	</div>
}

// ThreadsButtonTrigger renders the threads icon button for the navbar.
templ ThreadsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "threads-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-threads-dialog')",
				"title":  i18n.T(ctx, "Chat History"),
			},
		}) {
			@icon.MessageCircle(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Chat History") }</span>
		}
	}
}
