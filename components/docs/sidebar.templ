package docs

import "school-with-ai/components/icon"

// ─── Sidebar ─────────────────────────────────────────────────────────────────
templ docsSidebar() {
	<aside class="hidden lg:block">
		<nav class="sticky top-24 space-y-1">
			<p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">On this page</p>
			@sidebarLink("#overview", "Overview")
			@sidebarLink("#getting-started", "Getting Started")
			<p class="mt-6 mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">AI & Agents</p>
			@sidebarLink("#ai-models", "AI Models")
			@sidebarLink("#ai-settings", "AI Settings")
			@sidebarLink("#agent-store", "Agent Store")
			@sidebarLink("#custom-agents", "Custom Agents")
			@sidebarLink("#student-profile", "Student Profile")
			<p class="mt-6 mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Tools & Plugins</p>
			@sidebarLink("#plugins", "Plugin System")
			@sidebarLink("#voice-tts", "Voice & TTS")
			@sidebarLink("#visualization", "Visualization")
			@sidebarLink("#mcp", "MCP Integration")
			<p class="mt-6 mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Data & Content</p>
			@sidebarLink("#knowledge-base", "Knowledge Base")
			@sidebarLink("#memory", "Memory & Artifacts")
			@sidebarLink("#file-attachments", "File Attachments")
			@sidebarLink("#resource-library", "Resource Library")
			@sidebarLink("#conversation-search", "Conversation Search")
			<p class="mt-6 mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Platform</p>
			@sidebarLink("#token-usage", "Token Usage")
			@sidebarLink("#architecture", "Architecture")
			@sidebarLink("#security", "Security")
			@sidebarLink("#i18n", "Internationalization")
			@sidebarLink("#billing", "Billing")
			@sidebarLink("#api", "API Reference")
		</nav>
	</aside>
}

templ sidebarLink(href, text string) {
	<a
		href={ templ.SafeURL(href) }
		class="block rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground hover:bg-muted"
	>
		{ text }
	</a>
}

// ─── Hero ────────────────────────────────────────────────────────────────────
templ docsHero() {
	<div class="mb-12">
		<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground">
			@icon.BookOpen(icon.Props{Class: "size-4 text-primary"})
			<span>Documentation</span>
		</div>
		<h1 class="text-4xl font-bold tracking-tight">Compass Documentation</h1>
		<p class="mt-4 text-lg text-muted-foreground max-w-2xl">
			Everything you need to know about using Compass — from getting started to advanced features like multi-provider AI, MCP integration, knowledge graphs, personalized learning, and custom agent creation.
		</p>
	</div>
}
