package docs

import (
	"school-with-ai/components/button"
	"school-with-ai/components/icon"
)

// ─── Token Usage ─────────────────────────────────────────────────────────────
templ docsTokenUsage() {
	@docsSection("token-usage", "Token Usage and Analytics", iconChartBar, "text-orange-500") {
		<p>
			Compass.AI tracks <strong>detailed token usage per message</strong>, giving you full visibility into
			how your AI budget is being spent across different agents and models.
		</p>
		<h3>Per-Message Breakdown</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Metric</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Prompt Tokens", "Tokens in the input (your message + context)")
				@docsTableRow2("Completion Tokens", "Tokens generated in the AI response")
				@docsTableRow2("Cached Tokens", "Tokens served from cache (lower cost)")
				@docsTableRow2("Reasoning Tokens", "Tokens used for chain-of-thought reasoning (o1/o3 models)")
				@docsTableRow2("Audio Tokens", "Tokens for audio processing (TTS)")
				@docsTableRow2("Total Tokens", "Combined token count for the interaction")
			</tbody>
		}
		<h3>Analytics Dashboard</h3>
		<p>
			Administrators have access to a dedicated analytics dashboard that provides:
		</p>
		<ul class="space-y-2 my-4">
			<li>
				<strong>Tool usage time-series</strong> -- Chart-ready data showing tool usage over time
			</li>
			<li>
				<strong>Per-tool metrics</strong> -- Detailed analytics for each tool and plugin
			</li>
			<li>
				<strong>Agent-level filtering</strong> -- View statistics scoped to specific agents
			</li>
			<li>
				<strong>Usage trends</strong> -- Identify patterns and optimize your workflow
			</li>
		</ul>
		@docsInfoBox("Cost Optimization") {
			<p>Use token usage data to make informed decisions: assign cost-effective models like GPT-4o-mini or Gemini Flash Lite to simple tasks, and reserve premium models for complex analysis.</p>
		}
	}
}

// ─── Architecture ────────────────────────────────────────────────────────────
templ docsArchitecture() {
	@docsSection("architecture", "Architecture", iconLayers, "text-indigo-500") {
		<p>
			Compass.AI is built on a modern, event-sourced architecture designed for reliability, scalability,
			and observability. Every component is designed for horizontal scaling and fault tolerance.
		</p>
		<h3>Event Sourcing & CQRS</h3>
		<p>
			Every state change in Compass.AI is recorded as an immutable <strong>event</strong> in PostgreSQL.
			This event-sourced approach provides:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Full audit trail</strong> — Every action is recorded and can be replayed</li>
			<li>• <strong>Time-travel debugging</strong> — Reconstruct state at any point in time</li>
			<li>• <strong>Reliable projections</strong> — Read models are derived from events, ensuring consistency</li>
			<li>• <strong>CQRS separation</strong> — Write side (commands) and read side (queries) are fully decoupled</li>
			<li>• <strong>Optimistic concurrency</strong> — Stream version checking prevents conflicting updates</li>
		</ul>
		<h3>AG-UI Protocol & Real-Time Streaming</h3>
		<p>
			The chat interface uses the <strong>AG-UI protocol</strong> with Server-Sent Events (SSE) for
			real-time streaming. This enables:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Token-by-token delivery</strong> — See AI responses appear in real-time</li>
			<li>• <strong>Live tool execution</strong> — Watch tool calls execute and return results</li>
			<li>• <strong>Thought streaming</strong> — See AI reasoning in real-time via the Cognitive plugin</li>
			<li>• <strong>Elicitation events</strong> — Interactive forms rendered mid-conversation</li>
		</ul>
		<h3>Agent Runtime</h3>
		<p>
			Compass.AI uses a <strong>framework-agnostic agent runtime</strong> with middleware chains, hierarchical
			agent delegation (parent/child sub-agents), and a <strong>declarative requirements system</strong> for
			human-in-the-loop authorization gates and conditional tool constraints.
		</p>
		<h3>Background Processing</h3>
		<p>
			Long-running tasks (AI agent execution, document processing, embedding generation) are handled by
			<strong>Asynq</strong> — a Redis-backed task queue that supports concurrent workers,
			retry policies, circuit breakers, and graceful shutdown.
		</p>
		<h3>Multi-Pod Scalability</h3>
		<p>
			Compass.AI is designed for horizontal scaling. Events are broadcast across pods via
			<strong>Redis Pub/Sub</strong>, ensuring all instances stay synchronized. The projection
			updater runs independently, keeping read models up to date across the cluster.
		</p>
		@docsInfoBox("Tech Stack") {
			<div class="grid grid-cols-2 gap-2 mt-2 text-sm">
				<div><strong>Language:</strong> Go</div>
				<div><strong>Templates:</strong> Templ</div>
				<div><strong>Frontend:</strong> Alpine.js + HTMX patterns</div>
				<div><strong>CSS:</strong> Tailwind CSS v4</div>
				<div><strong>Database:</strong> PostgreSQL + pgvector</div>
				<div><strong>Queue:</strong> Redis + Asynq</div>
				<div><strong>Storage:</strong> S3 (MinIO compatible)</div>
				<div><strong>Payments:</strong> Stripe (event-sourced)</div>
				<div><strong>Embeddings:</strong> OpenAI / Gemini</div>
				<div><strong>TTS:</strong> OpenAI Whisper-aligned</div>
				<div><strong>Protocols:</strong> AG-UI, MCP, OAuth 2.1</div>
			</div>
		}
	}
}

// ─── Security ────────────────────────────────────────────────────────────────
templ docsSecurity() {
	@docsSection("security", "Security", iconShieldCheck, "text-red-500") {
		<p>
			Security is built into every layer of Compass.AI, from network transport to data storage.
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Layer</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Protection</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Transport", "TLS encryption with restricted elliptic curves (X25519, P256)")
				@docsTableRow2("Authentication", "Google OAuth with session management")
				@docsTableRow2("Rate Limiting", "Per-IP rate limiting (10 req/s API, 100 req/s assets)")
				@docsTableRow2("Body Limits", "1 MB default, 150 MB for file uploads")
				@docsTableRow2("Headers", "Security headers middleware on all responses")
				@docsTableRow2("Panic Recovery", "Global panic recovery middleware")
				@docsTableRow2("MCP Security", "SSRF protection, encrypted OAuth tokens at rest, per-server circuit breakers")
				@docsTableRow2("Payments", "PCI SAQ-A compliant via Stripe.js")
				@docsTableRow2("Production Guard", "Rejects development defaults in production builds")
			</tbody>
		}
	}
}

// ─── Internationalization ────────────────────────────────────────────────────
templ docsI18n() {
	@docsSection("i18n", "Internationalization", iconLanguages, "text-teal-500") {
		<p>
			Compass.AI supports multiple languages with full RTL (right-to-left) layout support.
		</p>
		<h3>Language Detection</h3>
		<p>
			The language is detected automatically from (in priority order):
		</p>
		<ol class="list-decimal list-inside space-y-1 my-4">
			<li>Query parameter (<code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">?lang=ar</code>)</li>
			<li>Cookie preference</li>
			<li>Browser <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">Accept-Language</code> header</li>
		</ol>
		<h3>RTL Support</h3>
		<p>
			When an RTL language (like Arabic) is detected, the entire UI flips direction automatically.
			This includes layout, text alignment, scroll directions, and icon mirroring. Compass.AI uses
			logical CSS properties (<code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">margin-inline-start</code>) and the
			<code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">dir</code> attribute for correct bidirectional rendering.
		</p>
		<h3>Fonts</h3>
		<p>
			Compass.AI loads optimized Google Fonts for each script:
			<strong>Inter</strong> (Latin), <strong>Noto Sans</strong> (universal fallback),
			and <strong>Noto Sans Arabic</strong> (Arabic script).
		</p>
	}
}

// ─── Billing ─────────────────────────────────────────────────────────────────
templ docsBilling() {
	@docsSection("billing", "Billing", iconLock, "text-violet-500") {
		<p>
			Compass.AI integrates with Stripe for secure, PCI SAQ-A compliant payment processing. Credit
			card data is handled entirely by Stripe and never touches Compass.AI servers.
		</p>
		<h3>Payment Flow</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Navigate to the <strong>Pricing</strong> page</li>
			<li>Select a plan and click <strong>Subscribe</strong></li>
			<li>Complete payment via Stripe Checkout</li>
			<li>Subscription activates immediately</li>
			<li>Webhooks keep Compass.AI in sync</li>
		</ol>
		<h3>Subscription Management</h3>
		<p>
			Manage subscriptions from the Profile page:
		</p>
		<ul class="space-y-2 my-4">
			<li>View current plan and billing cycle</li>
			<li>Upgrade or downgrade plans</li>
			<li>Update payment method via Stripe Customer Portal</li>
			<li>Cancel subscription (access retained until period end)</li>
		</ul>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Feature</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Details</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Payment Processor", "Stripe")
				@docsTableRow2("Compliance", "PCI SAQ-A")
				@docsTableRow2("Webhook Events", "Checkout completed, subscription updated/deleted, invoice paid")
				@docsTableRow2("Customer Portal", "Self-service billing management via Stripe")
				@docsTableRow2("Trial Support", "Configurable trial periods per plan")
			</tbody>
		}
	}
}

// ─── API Reference ───────────────────────────────────────────────────────────
templ docsAPI() {
	@docsSection("api", "API Reference", iconCode, "text-slate-500") {
		<p>
			Compass.AI exposes a comprehensive REST API for all features. All API endpoints require authentication
			unless otherwise noted.
		</p>
		<h3>Core Endpoints</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Method</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Endpoint</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("POST", "/v1/message:send", "Send a message to an agent")
				@docsTableRow("GET", "/v1/tasks/{id}:subscribe", "Stream job events (SSE)")
				@docsTableRow("POST", "/v1/tasks/{id}:cancel", "Cancel a running job")
				@docsTableRow("GET", "/v1/agents", "List user's agents")
				@docsTableRow("GET", "/v1/plugins", "List all plugins")
				@docsTableRow("GET", "/api/agui/threads", "List conversation threads")
				@docsTableRow("GET", "/api/agui/threads/{id}/messages", "Get thread messages")
			</tbody>
		}
		<h3>Agent Endpoints</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Method</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Endpoint</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("GET", "/v1/agent-definitions", "List user's custom agents")
				@docsTableRow("POST", "/v1/agent-definitions", "Create a new agent")
				@docsTableRow("PUT", "/v1/agent-definitions/{id}", "Update an agent")
				@docsTableRow("DELETE", "/v1/agent-definitions/{id}", "Delete an agent")
				@docsTableRow("GET", "/v1/agent-catalog", "Browse agent catalog")
				@docsTableRow("POST", "/v1/agent-catalog/{id}/add", "Fork catalog agent")
			</tbody>
		}
		<h3>MCP Endpoints</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Method</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Endpoint</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("GET", "/v1/mcp/connectors", "List MCP connectors")
				@docsTableRow("POST", "/v1/mcp/connectors", "Create a connector")
				@docsTableRow("POST", "/v1/mcp/connectors/{id}/connect", "Connect to MCP server")
				@docsTableRow("GET", "/v1/mcp/connectors/{id}/tools", "List discovered tools")
				@docsTableRow("POST", "/v1/mcp/connectors/{id}/refresh", "Refresh tools")
				@docsTableRow("*", "/v1/mcp/connectors/{id}/mcp/*", "MCP proxy")
			</tbody>
		}
		<h3>Knowledge Base Endpoints</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Method</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Endpoint</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("GET", "/api/knowledge/workspaces", "List workspaces")
				@docsTableRow("POST", "/api/knowledge/workspaces", "Create workspace")
				@docsTableRow("POST", "/api/knowledge/documents/upload", "Upload document")
				@docsTableRow("GET", "/api/knowledge/graph", "Get knowledge graph")
				@docsTableRow("GET", "/api/knowledge/graph/nodes/search", "Search graph nodes")
			</tbody>
		}
		<h3>Resource and File Endpoints</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Method</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Endpoint</th>
					<th class="text-left py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("GET", "/api/resources", "List public resources")
				@docsTableRow("GET", "/api/resources/private", "List user's private resources")
				@docsTableRow("POST", "/api/resources/upload", "Upload a resource file")
				@docsTableRow("GET", "/api/resources/{id}/download", "Download a resource")
				@docsTableRow("DELETE", "/api/resources/{id}", "Delete a private resource")
			</tbody>
		}
		<div class="mt-8">
			@button.Button(button.Props{
				Href:    "/",
				Variant: button.VariantOutline,
			}) {
				@icon.ArrowRight(icon.Props{Class: "size-4"})
				<span>Back to Home</span>
			}
		</div>
	}
}
