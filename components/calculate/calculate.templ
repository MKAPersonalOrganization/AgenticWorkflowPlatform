package calculate

templ Container() {
	<div class="flex flex-col p-4 bg-base-100 rounded-lg border border-base-200 shadow-sm w-full max-w-md">
		<!-- Header/Icon -->
		<div class="flex items-center gap-2 text-xs font-semibold text-primary/70 uppercase tracking-wider mb-3">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
			Calculation
		</div>
		<!-- Display Area -->
		<div class="bg-base-200/40 rounded-md p-4 text-end">
			<!-- Expression -->
			<div class="text-sm text-base-content/60 font-mono mb-1 truncate" x-text="message.parsedArgs?.expression || ''"></div>
			<!-- Result -->
			<div class="text-2xl font-mono font-bold text-primary break-all" x-text="message.parsedResult?.result || message.result"></div>
		</div>
	</div>
}
