package calculate

import "school-with-ai/components/annotation"

templ icon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		Label: "Expression Resolved",
		LabelAttrs: templ.Attributes{
			"x-text": `
				message.name === 'add' ? 'Addition' : 
				message.name === 'subtract' ? 'Subtraction' : 
				message.name === 'multiply' ? 'Multiplication' : 
				message.name === 'divide' ? 'Division' : 
				message.name === 'power' ? 'Power' : 
				message.name === 'sqrt' ? 'Square Root' : 'Expression Resolved'
			`,
		},
		Subtext: "Arithmetic precision verified via core computational engine",
	}) {
		<div class="flex flex-col gap-4">
			<!-- Expression: Academic Typography -->
			<div class="flex items-center gap-2 text-[12px] text-muted-foreground/50 italic font-serif">
				<span class="font-semibold text-muted-foreground/40">Operation:</span>
				<span class="text-primary/70 not-italic font-mono text-[11px] bg-primary/[0.05] px-2 py-0.5 rounded-md border border-primary/10" x-text="
					message.name === 'add' ? `${message.parsedArgs?.a} + ${message.parsedArgs?.b}` :
					message.name === 'subtract' ? `${message.parsedArgs?.a} - ${message.parsedArgs?.b}` :
					message.name === 'multiply' ? `${message.parsedArgs?.a} × ${message.parsedArgs?.b}` :
					message.name === 'divide' ? `${message.parsedArgs?.a} ÷ ${message.parsedArgs?.b}` :
					message.name === 'power' ? `${message.parsedArgs?.a}^${message.parsedArgs?.b}` :
					message.name === 'sqrt' ? `√${message.parsedArgs?.value}` :
					(message.parsedArgs?.expression || '')
				"></span>
			</div>
			<!-- Result Area -->
			<div class="relative w-full">
				<!-- Error State -->
				<template x-if="message.parsedResult?.error || (typeof message.result === 'string' && message.result.includes('error'))">
					<div class="flex items-center gap-3 text-destructive/80 font-medium py-3 px-4 bg-destructive/5 border border-destructive/10 rounded-xl">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-circle"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
						<span class="text-xs uppercase tracking-[0.1em] font-bold">Calculation Failed</span>
					</div>
				</template>
				<!-- Success State: High Impact Typography -->
				<template x-if="!message.parsedResult?.error && !(typeof message.result === 'string' && message.result.includes('error'))">
					<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-8 flex flex-col items-center justify-center shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)] transition-colors hover:bg-muted/[0.05]">
						<div class="text-[10px] uppercase tracking-[0.3em] font-bold text-muted-foreground/30 mb-2">Calculated Value</div>
						<div class="text-5xl font-mono font-bold text-foreground tracking-tighter break-all" x-text="message.parsedResult?.result || message.result"></div>
					</div>
				</template>
			</div>
		</div>
	}
}


