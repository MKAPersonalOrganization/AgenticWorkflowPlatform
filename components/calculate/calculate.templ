package calculate

templ Container() {
	<div class="flex flex-col bg-card rounded-xl border border-border shadow-sm w-full max-w-md overflow-hidden transition-all duration-200 hover:shadow-md">
		<!-- Header -->
		<div class="flex items-center gap-2 px-4 py-3 bg-muted/40 border-b border-border/50">
			<div class="p-1.5 bg-primary/10 rounded-md text-primary">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
			</div>
			<span
				class="text-xs font-semibold text-muted-foreground uppercase tracking-wider"
				x-text="
				message.name === 'add' ? 'Addition' : 
				message.name === 'subtract' ? 'Subtraction' : 
				message.name === 'multiply' ? 'Multiplication' : 
				message.name === 'divide' ? 'Division' : 
				message.name === 'power' ? 'Power' : 
				message.name === 'sqrt' ? 'Square Root' : 'Calculation'
			"
			></span>
		</div>
		<!-- Display Area -->
		<div class="p-5 flex flex-col items-end gap-1">
			<!-- Expression -->
			<div
				class="text-sm font-mono text-muted-foreground/80"
				x-text="
				message.name === 'add' ? `${message.parsedArgs?.a} + ${message.parsedArgs?.b} =` :
				message.name === 'subtract' ? `${message.parsedArgs?.a} - ${message.parsedArgs?.b} =` :
				message.name === 'multiply' ? `${message.parsedArgs?.a} × ${message.parsedArgs?.b} =` :
				message.name === 'divide' ? `${message.parsedArgs?.a} ÷ ${message.parsedArgs?.b} =` :
				message.name === 'power' ? `${message.parsedArgs?.a}^${message.parsedArgs?.b} =` :
				message.name === 'sqrt' ? `√${message.parsedArgs?.value} =` :
				(message.parsedArgs?.expression + ' =' || '')
			"
			></div>
			<!-- Result or Error -->
			<template x-if="message.parsedResult?.error || (typeof message.result === 'string' && message.result.includes('error'))">
				<div class="flex items-center gap-2 text-destructive font-medium">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-circle"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
					<span>Calculation Failed</span>
				</div>
			</template>
			<template x-if="!message.parsedResult?.error && !(typeof message.result === 'string' && message.result.includes('error'))">
				<div class="text-4xl font-mono font-bold text-foreground tracking-tight break-all" x-text="message.parsedResult?.result || message.result"></div>
			</template>
		</div>
	</div>
}
