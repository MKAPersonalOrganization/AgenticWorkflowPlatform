package lookupsection

templ Container() {
	<div class="flex flex-col gap-2 p-3 bg-base-100 rounded-lg border border-base-200 shadow-sm transition-all hover:shadow-md">
		<!-- Header: File Path and Section Info -->
		<div class="flex items-center justify-between text-xs text-base-content/60 border-b border-base-200 pb-2">
			<div class="flex items-center gap-2 overflow-hidden">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open flex-shrink-0"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
				<span class="font-medium truncate" x-text="(message.parsedArgs?.path || '').split('/').pop()"></span>
                <template x-if="message.parsedArgs?.section_heading">
                    <div class="flex items-center gap-1 min-w-0">
                        <span class="opacity-50 flex-shrink-0">/</span>
                        <span class="font-semibold text-primary truncate" x-text="message.parsedArgs?.section_heading"></span>
                    </div>
                </template>
			</div>
			<div class="flex-shrink-0 text-[10px] uppercase tracking-wider font-bold mx-2">
				Section
			</div>
		</div>

		<!-- Content Area -->
		<div class="relative group mt-1">
			<div class="bg-base-200/50 rounded p-3 text-sm font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed text-base-content/80">
				<span x-text="message.result"></span>
			</div>
		</div>
	</div>
}
