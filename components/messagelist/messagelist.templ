package messagelist

import "school-with-ai/components/message"
import "school-with-ai/components/errormessage"
import "school-with-ai/components/alert"
import "school-with-ai/components/badge"
import "school-with-ai/components/collapsible"
import "school-with-ai/components/agenthandoff"

templ MessageList() {
	<div class="space-y-4">
		<template x-for="message in messages" :key="message.id">
			<div
				class="group"
				role="article"
				:aria-label="`Message from ${message.role || 'system'}`"
			>
				<!-- User Message -->
				@message.UserMessage()
				<!-- Agent Transfer Tool Call - Special Rendering -->
				<div x-show="message.type === 'tool_call' && message.name === 'transfer_to_agent' && message.status === 'completed'" class="my-2 relative group/message">
					<!-- Copy button for tool call -->
					<button
						@click="copyMessage(message.id)"
						class="absolute top-2 right-2 z-10 opacity-0 group-hover/message:opacity-100 transition-opacity inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background hover:bg-accent hover:text-accent-foreground h-8 w-8 touch-target"
						type="button"
						aria-label="Copy message"
						title="Copy message"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
						</svg>
					</button>
					@alert.Alert(alert.Props{Class: "border-l-4 border-primary"}) {
						<!-- Agent collaboration icon -->
						<svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
							<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
						</svg>
						@alert.Title() {
							<span class="flex items-center gap-2">
								<template x-if="message.agentName">
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs font-medium"}) {
										<span x-text="message.agentName"></span>
									}
								</template>
								<template x-if="message.agentName">
									<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
								</template>
								@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "text-xs font-medium"}) {
									<span x-text="message.parsedArgs?.agent_name || 'specialist'"></span>
								}
								<template x-if="message.result">
									<span class="text-primary text-xs font-medium">✓ transferred</span>
								</template>
							</span>
						}
						@alert.Description() {
							<div class="space-y-2">
								<template x-if="message.parsedArgs?.question">
									<div class="text-sm">
										<span class="font-semibold text-primary">Question:</span>
										<span class="ml-2" x-text="message.parsedArgs?.question"></span>
									</div>
								</template>
								<template x-if="message.parsedArgs?.context">
									<div class="text-sm text-muted-foreground">
										<span class="font-semibold">Context:</span>
										<span class="ml-2" x-text="message.parsedArgs?.context"></span>
									</div>
								</template>
								<template x-if="!message.parsedArgs?.question && !message.parsedArgs?.context">
									<div class="text-sm text-muted-foreground italic">
										Returning to coordinator
									</div>
								</template>
							</div>
						}
					}
				</div>
				<!-- Regular Tool Call Message (with result if available) -->
				<div x-show="message.type === 'tool_call' && message.name !== 'transfer_to_agent' && message.status === 'completed'" class="my-2 relative group/message">
					<!-- Copy button for tool call -->
					<button
						@click="copyMessage(message.id)"
						class="absolute top-2 right-2 z-10 opacity-0 group-hover/message:opacity-100 transition-opacity inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background hover:bg-accent hover:text-accent-foreground h-8 w-8 touch-target"
						type="button"
						aria-label="Copy message"
						title="Copy message"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
						</svg>
					</button>
					@alert.Alert(alert.Props{Class: "border-l-4 border-primary"}) {
						<!-- Tool Icon -->
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
							<path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z"></path>
						</svg>
						@alert.Title() {
							<span class="flex items-center gap-2">
								<template x-if="message.agentName">
									<span class="text-xs text-muted-foreground" x-text="message.agentName"></span>
								</template>
								<template x-if="message.agentName">
									<span>→</span>
								</template>
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "font-mono text-xs"}) {
									<span x-text="message.name"></span>
								}
							</span>
						}
						@alert.Description() {
							<!-- Tool Arguments -->
							<div class="mb-3">
								<!-- Arguments Summary -->
								<div class="mb-2 text-sm text-muted-foreground">
									<template x-if="message.name === 'plot'">
										<div>
											<span class="font-medium">Plotting:</span>
											<span x-text="message.parsedArgs?.title || 'Graph'"></span>
										</div>
									</template>
									<template x-if="message.name === 'write_whiteboard'">
										<div>
											<span class="font-medium">Action:</span>
											<span x-text="message.parsedArgs?.action || 'write'"></span>
											<template x-if="message.parsedArgs?.content">
												<span class="text-xs ml-2">(<span x-text="(message.parsedArgs.content || '').length"></span> chars)</span>
											</template>
										</div>
									</template>
									<template x-if="message.name === 'read_whiteboard'">
										<div class="text-xs">Reading current whiteboard content</div>
									</template>
									<template x-if="message.name === 'transfer_to_agent'">
										<div>
											<span class="font-medium">Transferring to:</span>
											<span x-text="message.parsedArgs?.agent_name || ''"></span>
											<template x-if="message.parsedArgs?.question">
												<div class="mt-1 text-xs">
													<span class="font-medium">Question:</span>
													<span x-text="message.parsedArgs?.question || ''"></span>
												</div>
											</template>
										</div>
									</template>
								</div>
								@collapsible.Collapsible(collapsible.Props{Open: false}) {
									@collapsible.Trigger(collapsible.TriggerProps{Class: "flex items-center gap-2 cursor-pointer hover:text-primary"}) {
										<svg class="w-4 h-4 transition-transform [[data-tui-collapsible-state=open]_&]:rotate-90" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
										</svg>
										<span class="text-sm font-medium">Full Arguments</span>
									}
									@collapsible.Content() {
										<div class="mt-2">
											<div x-html="`<pre><code class='language-json'>${JSON.stringify(message.parsedArgs, null, 2)}</code></pre>`"></div>
										</div>
									}
								}
							</div>
							<!-- Tool Result (if available) -->
							<div x-show="message.result !== null && message.result !== undefined" class="border-t pt-3 mt-3">
								<div class="flex items-center gap-2 mb-2">
									<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-sm font-semibold">Result</span>
								</div>
								<!-- Result Summary -->
								<div class="mb-2 text-sm">
									<template x-if="message.name === 'plot' && isValidJSON(message.result)">
										<div class="space-y-1">
											<template x-if="JSON.parse(message.result).success">
												<div class="text-green-600 font-medium">✓ Plot generated successfully</div>
												<div class="text-muted-foreground">
													<span class="font-medium">Image:</span>
													<a x-bind:href="JSON.parse(message.result).image_url" target="_blank" class="text-primary hover:underline ml-1" x-text="JSON.parse(message.result).image_url"></a>
												</div>
											</template>
										</div>
									</template>
									<template x-if="message.name === 'write_whiteboard' && isValidJSON(message.result)">
										<div class="space-y-1">
											<div class="text-green-600 font-medium">✓ Whiteboard updated</div>
											<div class="text-muted-foreground text-xs">
												<span class="font-medium">Action:</span>
												<span x-text="message.parsedArgs?.action || 'write'"></span>
												<span class="mx-2">•</span>
												<span class="font-medium">Content:</span>
												<span x-text="(message.parsedArgs?.content || '').length"></span> characters
											</div>
											<template x-if="message.parsedArgs?.content">
												<div class="mt-1 text-xs text-muted-foreground bg-muted/50 rounded p-2 max-h-20 overflow-y-auto">
													<div class="whitespace-pre-wrap font-mono" x-text="(message.parsedArgs.content || '').slice(0, 200) + ((message.parsedArgs.content || '').length > 200 ? '...' : '')"></div>
												</div>
											</template>
										</div>
									</template>
									<template x-if="message.name === 'read_whiteboard' && isValidJSON(message.result)">
										<div class="text-muted-foreground">
											<span class="font-medium">Content length:</span>
											<span x-text="(JSON.parse(message.result).content || '').length"></span> characters
										</div>
									</template>
									<template x-if="message.name === 'transfer_to_agent' && isValidJSON(message.result)">
										<div class="text-green-600 font-medium">✓ Handoff successful</div>
									</template>
								</div>
								<div class="relative">
									@collapsible.Collapsible(collapsible.Props{Open: false}) {
										@collapsible.Trigger(collapsible.TriggerProps{Class: "flex items-center gap-2 cursor-pointer hover:text-primary"}) {
											<svg class="w-4 h-4 transition-transform [[data-tui-collapsible-state=open]_&]:rotate-90" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
											</svg>
											<span class="text-sm font-medium">Full Result</span>
										}
										@collapsible.Content() {
											<div class="mt-2">
												<template x-if="isValidJSON(message.result)">
													<div x-html="`<pre><code class='language-json'>${JSON.stringify(JSON.parse(message.result), null, 2)}</code></pre>`"></div>
												</template>
												<template x-if="!isValidJSON(message.result)">
													<div x-html="`<pre><code class='language-text'>${message.result}</code></pre>`"></div>
												</template>
											</div>
										}
									}
								</div>
							</div>
						}
					}
				</div>
				<!-- Tool Result Message (orphaned - should not happen with new approach, but kept for safety) -->
				<div x-show="message.type === 'tool_result'" class="my-2" style="display: none;">
					<!-- Hidden - tool results are now embedded in tool call messages -->
				</div>
				<!-- Agent Handoff Message -->
				@agenthandoff.AgentHandoff()
				<!-- Assistant Message -->
				@message.AssistantMessage()
			</div>
		</template>
		<!-- Typing Indicator -->
		<div
			x-show="showTypingIndicator"
			class="flex flex-col gap-2"
			role="status"
			aria-live="polite"
			aria-label="Assistant is typing"
		>
			<div class="flex items-center gap-1.5">
				<span class="w-2 h-2 bg-muted-foreground rounded-full animate-bounce" style="animation-duration: 1s; animation-delay: 0ms;"></span>
				<span class="w-2 h-2 bg-muted-foreground rounded-full animate-bounce" style="animation-duration: 1s; animation-delay: 150ms;"></span>
				<span class="w-2 h-2 bg-muted-foreground rounded-full animate-bounce" style="animation-duration: 1s; animation-delay: 300ms;"></span>
			</div>
		</div>
		<!-- Error Message -->
		@errormessage.ErrorMessage()
	</div>
}
