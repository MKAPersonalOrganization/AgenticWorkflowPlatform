package messagelist

import (
	"school-with-ai/components/alert"
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/calculate"
	"school-with-ai/components/elicitation"
	"school-with-ai/components/errormessage"
	"school-with-ai/components/i18n"
	"school-with-ai/components/knowledgebase"
	"school-with-ai/components/library"
	"school-with-ai/components/lookupsection"
	"school-with-ai/components/markdown"
	"school-with-ai/components/memory"
	"school-with-ai/components/message"
	"school-with-ai/components/plot"
	"school-with-ai/components/searchtext"
	"school-with-ai/components/statistics"
	"school-with-ai/components/tokenusage"
	"school-with-ai/components/utils"
)

// ScrollToBottom - LibreChat style floating scroll button
templ ScrollToBottom() {
	<button
		x-show="scrolledUp"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-2"
		@click="scrollToBottom()"
		class="absolute bottom-5 left-1/2 -translate-x-1/2 cursor-pointer rounded-full border border-border bg-background p-2 shadow-md hover:shadow-lg hover:bg-accent/50 transition-all z-10"
		aria-label={ i18n.T(ctx, "Scroll to bottom") }
	>
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-muted-foreground">
			<path
				d="M17 13L12 18L7 13M12 6L12 17"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</button>
}

// DateSeparator - LibreChat style date separator
templ DateSeparator() {
	<div
		x-show="index > 0 && getMessageDate(message) !== getMessageDate(messages[index - 1])"
		class="flex items-center justify-center my-4"
	>
		<div class="text-xs text-muted-foreground bg-muted/50 px-3 py-1 rounded-full">
			<span x-text="formatRelativeDate(getMessageDate(message))"></span>
		</div>
	</div>
}

templ MessageList() {
	<div
		class="space-y-4 relative"
		x-data="{ scrolledUp: false }"
		x-init="
		$watch('messages', () => {
			$nextTick(() => {
				const container = $refs.messageList;
				if (container) {
					const isNearBottom = container.scrollHeight - container.scrollTop - container.clientHeight < 100;
					if (isNearBottom) scrollToBottom();
				}
			});
		});
	"
	>
		<template x-for="(message, index) in messages" :key="message.id">
			<div
				class="group"
				role="article"
				:aria-label="`Message from ${message.role || 'system'}`"
				x-show="!showSearch || !searchQuery || (message.content && message.content.toLowerCase().includes(searchQuery.toLowerCase())) || (message.parsedArgs && JSON.stringify(message.parsedArgs).toLowerCase().includes(searchQuery.toLowerCase()))"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 translate-y-2"
				x-transition:enter-end="opacity-100 translate-y-0"
			>
				<!-- Date Separator -->
				@DateSeparator()
				<!-- User Message -->
				@message.UserMessage()
				<!-- Agent Transfer Tool Call - Special Rendering -->
				<div x-show="message.type === 'tool_call' && message.name === 'transfer_to_agent' && message.status === 'completed'" class="my-2 relative group/message">
					<!-- Copy button for tool call -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Class:   "absolute top-2 end-2 z-10 opacity-0 group-hover/message:opacity-100 transition-opacity bg-background/50 hover:bg-background size-8 h-8 w-8",
						Attributes: templ.Attributes{
							"@click":     "copyMessage(message.id)",
							"aria-label": "Copy message",
							"title":      "Copy message",
						},
					}) {
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
						</svg>
					}
					@alert.Alert(alert.Props{
						Class: utils.TwMerge(
							"border-s-4 overflow-hidden shadow-sm transition-all duration-300",
							"border-primary",
						),
					}) {
						<div :class="message.parsedArgs?.agent_name === 'human' ? 'absolute inset-0 bg-primary/5 pointer-events-none' : ''"></div>
						<!-- Agent collaboration icon -->
						<template x-if="message.parsedArgs?.agent_name !== 'human'">
							<svg class="w-5 h-5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
								<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
							</svg>
						</template>
						<template x-if="message.parsedArgs?.agent_name === 'human'">
							<svg class="w-5 h-5 text-primary flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
							</svg>
						</template>
						@alert.Title() {
							<span class="flex items-center gap-2 flex-wrap">
								<template x-if="message.agentName">
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs font-medium break-all"}) {
										<span class="break-all" x-text="message.agentName"></span>
									}
								</template>
								<template x-if="message.agentName">
									<svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
								</template>
								<template x-if="message.parsedArgs?.agent_name === 'human'">
									@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "text-xs font-medium px-2 py-0 h-5"}) {
										<span>{ i18n.T(ctx, "HUMAN HELP") }</span>
									}
								</template>
								<template x-if="message.parsedArgs?.agent_name !== 'human'">
									@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "text-xs font-medium break-all"}) {
										<span class="break-all" x-text="message.parsedArgs?.agent_name || 'specialist'"></span>
									}
								</template>
								<template x-if="message.result">
									<span class="text-primary text-xs font-medium">✓ { i18n.T(ctx, "transferred") }</span>
								</template>
							</span>
						}
						@alert.Description() {
							<div class="space-y-2">
								<template x-if="message.parsedArgs?.question">
									<div class="text-sm break-words">
										<span class="font-semibold text-primary">{ i18n.T(ctx, "Question:") }</span>
										<span class="mis-2" x-text="message.parsedArgs?.question"></span>
									</div>
								</template>
								<template x-if="message.parsedArgs?.context">
									<div class="text-sm text-muted-foreground break-words">
										<span class="font-semibold">{ i18n.T(ctx, "Context:") }</span>
										<span class="mis-2" x-text="message.parsedArgs?.context"></span>
									</div>
								</template>
								<template x-if="!message.parsedArgs?.question && !message.parsedArgs?.context">
									<div class="text-sm text-muted-foreground italic">
										{ i18n.T(ctx, "Transferring context to") }
									</div>
								</template>
							</div>
						}
					}
				</div>
				<!-- Elicitation: Quiz Components -->
				<div x-show="message.type === 'tool_call' && isElicitationTool(message.parsedResult?.schema?.type)" class="my-2 relative group/message w-full">
					<template x-if="message.parsedResult?.schema?.type === 'choose_multiple'">
						@elicitation.Container() {
							@elicitation.AskMultipleSelection()
						}
					</template>
					<template x-if="message.parsedResult?.schema?.type === 'multiple_choice'">
						@elicitation.Container() {
							@elicitation.MultipleChoice()
						}
					</template>
					<template x-if="message.parsedResult?.schema?.type === 'true_false'">
						@elicitation.Container() {
							@elicitation.AskTrueFalse()
						}
					</template>
					<template x-if="message.parsedResult?.schema?.type === 'short_answer'">
						@elicitation.Container() {
							@elicitation.ShortAnswer()
						}
					</template>
				</div>
				<!-- Special Tool Components -->
				<div x-show="message.type === 'tool_call' && isSpecialTool(message.name)" class="my-2 relative w-full flex flex-col items-stretch">
					<template x-if="message.name === 'browse_library'">
						@library.Library()
					</template>
					<template x-if="message.name === 'save_memory' || message.name === 'forget_memory' || message.name === 'list_memories' || message.name === 'clear_memories'">
						@memory.Container()
					</template>
					<template x-if="message.name === 'lookup_section'">
						@lookupsection.Container()
					</template>
					<template x-if="message.name === 'search_text_in_file'">
						@searchtext.Container()
					</template>
					<template x-if="message.name === 'query_knowledge_base'">
						@knowledgebase.Container()
					</template>
					<template x-if="['create_markdown', 'update_markdown', 'delete_markdown'].includes(message.name)">
						@markdown.Container()
					</template>
					<template x-if="['calculate', 'add', 'subtract', 'multiply', 'divide', 'power', 'sqrt'].includes(message.name)">
						@calculate.Container()
					</template>
					<template x-if="message.name === 'plot'">
						@plot.Container()
					</template>
					<template x-if="['mean', 'median', 'mode', 'min', 'max', 'sum', 'variance', 'standard_deviation', 'quartile', 'percentile', 'interquartile_range', 'pearson_correlation', 'euclidean_distance', 'manhattan_distance', 'sample', 'quartile_outliers', 'normal_pdf', 'normal_cdf', 'normal_ppf', 'normal_mean', 'normal_median', 'normal_std', 'normal_var', 'normal_interval', 'binomial_ncr', 'linear_regression'].includes(message.name)">
						@statistics.Container()
					</template>
				</div>
				<!-- Regular Tool Call Message -->
				<div x-show="message.type === 'tool_call' && !isSpecialTool(message.name) && !isElicitationTool(message.parsedResult?.schema?.type) && message.status === 'completed'" class="my-2 relative group/message">
					<!-- Parallel indicator bar (shown only for parallel tool calls) -->
					<template x-if="getParallelToolCallInfo(message).isParallel">
						<div class="absolute inset-inline-start-0 top-0 bottom-0 w-1 bg-primary/30 rounded-s" title="Parallel tool call"></div>
					</template>
					<!-- Copy button for tool call -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Class:   "absolute top-2 end-2 z-10 opacity-0 group-hover/message:opacity-100 transition-opacity bg-background/50 hover:bg-background size-8 h-8 w-8",
						Attributes: templ.Attributes{
							"@click":     "copyMessage(message.id)",
							"aria-label": "Copy message",
							"title":      "Copy message",
						},
					}) {
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
						</svg>
					}
					@alert.Alert(alert.Props{Class: "border-s-4 border-primary overflow-hidden"}) {
						<!-- Tool Icon -->
						<svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
							<path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z"></path>
						</svg>
						@alert.Title() {
							<span class="flex items-center gap-2 flex-wrap">
								<template x-if="message.agentName">
									<span class="text-xs text-muted-foreground break-all" x-text="message.agentName"></span>
								</template>
								<template x-if="message.agentName">
									<span class="flex-shrink-0">→</span>
								</template>
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "font-mono text-xs break-all"}) {
									<span class="break-all" x-text="message.name"></span>
								}
								<!-- Parallel badge showing position (e.g., "1/3 parallel") -->
								<template x-if="getParallelToolCallInfo(message).isParallel">
									@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] font-medium px-1.5 py-0"}) {
										<span x-text="`${getParallelToolCallInfo(message).position}/${getParallelToolCallInfo(message).count}`"></span>
									}
								</template>
							</span>
						}
						@alert.Description() {
							<!-- Tool Arguments -->
							<div class="mb-3">
								<div class="flex items-center gap-2 mb-2">
									<svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
									</svg>
									<span class="text-sm font-semibold">{ i18n.T(ctx, "Arguments") }</span>
								</div>
								<div class="bg-muted/30 rounded-md p-3 overflow-x-auto break-words">
									<div x-html="`<pre class='break-words whitespace-pre-wrap'><code class='language-json'>${JSON.stringify(message.parsedArgs || {}, null, 2)}</code></pre>`"></div>
								</div>
							</div>
							<!-- Tool Result (if available) -->
							<div x-show="message.result !== null && message.result !== undefined" class="border-t pt-3 mt-3">
								<div class="flex items-center gap-2 mb-2">
									<svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-sm font-semibold">{ i18n.T(ctx, "Result") }</span>
								</div>
								<div class="bg-muted/30 rounded-md p-3 overflow-x-auto break-words">
									<template x-if="isValidJSON(message.result)">
										<div x-html="`<pre class='break-words whitespace-pre-wrap'><code class='language-json'>${JSON.stringify(JSON.parse(message.result), null, 2)}</code></pre>`"></div>
									</template>
									<template x-if="!isValidJSON(message.result)">
										<div x-html="`<pre class='break-words whitespace-pre-wrap'><code class='language-text'>${message.result}</code></pre>`"></div>
									</template>
								</div>
							</div>
						}
					}
				</div>
				<!-- Tool Result Message (orphaned - should not happen with new approach, but kept for safety) -->
				<div x-show="message.type === 'tool_result'" class="my-2" style="display: none;">
					<!-- Hidden - tool results are now embedded in tool call messages -->
				</div>
				<!-- Assistant Message -->
				@message.AssistantMessage()
			</div>
		</template>
		<!-- Typing Indicator -->
		<div
			x-show="showTypingIndicator"
			class="flex items-start gap-4 animate-in fade-in duration-300 w-full pie-10"
			role="status"
			aria-live="polite"
			aria-label="Assistant is typing"
		>
			<div class="flex flex-col gap-1 min-w-0">
				<div class="flex items-center gap-2">
					<span class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Safar.AI") }</span>
				</div>
				<div class="flex items-center gap-1.5 h-6">
					<span class="w-1.5 h-1.5 bg-primary/70 rounded-full animate-bounce" style="animation-duration: 0.8s; animation-delay: 0ms;"></span>
					<span class="w-1.5 h-1.5 bg-primary/70 rounded-full animate-bounce" style="animation-duration: 0.8s; animation-delay: 150ms;"></span>
					<span class="w-1.5 h-1.5 bg-primary/70 rounded-full animate-bounce" style="animation-duration: 0.8s; animation-delay: 300ms;"></span>
				</div>
			</div>
		</div>
		<!-- Error Message -->
		@errormessage.ErrorMessage()
		<!-- Token Usage Display -->
		@tokenusage.TokenUsage()
	</div>
}
