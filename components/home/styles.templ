package home

// ChatPageStyles renders CSS animations and styles specific to the chat page.
// Separated following the principle of co-located styles (CSS-in-JS equivalent).
templ ChatPageStyles() {
	<style>
		@keyframes shrink {
			from { transform: scaleX(1); }
			to { transform: scaleX(0); }
		}

		/* Compass spinning animation */
		@keyframes compassSpin {
			from { transform: rotate(0deg); }
			to { transform: rotate(360deg); }
		}

		@keyframes compassFloat {
			0% { transform: rotate(0deg); }
			15% { transform: rotate(15deg); }
			30% { transform: rotate(-10deg); }
			45% { transform: rotate(5deg); }
			60% { transform: rotate(-2deg); }
			75% { transform: rotate(1deg); }
			100% { transform: rotate(0deg); }
		}

		/* Compass animation classes */
		.compass-spin {
			animation: compassSpin 8s linear infinite;
		}

		.compass-float {
			animation: compassFloat 4s ease-in-out infinite;
			transform-origin: center;
		}

		.compass-pulse {
			animation: pulse 2s ease-in-out infinite alternate;
		}

		@keyframes pulse {
			from { transform: scale(1); }
			to { transform: scale(1.05); }
		}

		/* KaTeX inline math */
		.katex-display {
			display: block !important;
			margin: 1em 0 !important;
			text-align: center;
		}

		.katex {
			font-size: 1.1em;
		}

		/* RTL alignment for display math */
		[dir="rtl"] .katex-display {
			text-align: right !important;
		}
	</style>
}
