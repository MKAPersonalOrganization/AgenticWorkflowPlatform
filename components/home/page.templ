// Package home implements the main chat page.
// Following Next.js app router conventions:
// - page.templ = the route's page component
// - head.templ = extra <head> scripts/styles for this page
// - landing_hero.templ = the landing state (no messages)
// - toast_container.templ = toast notification UI
// - styles.templ = page-specific CSS animations
package home

import (
	"school-with-ai/components"
	"school-with-ai/components/banner"
	"school-with-ai/components/chat"
	"school-with-ai/components/chatinput"
	"school-with-ai/components/dialog"
	"school-with-ai/components/eventlog"
	"school-with-ai/components/footer"
	"school-with-ai/components/keyboardshortcuts"
	"school-with-ai/components/messagelist"
	"school-with-ai/components/nav"
	"school-with-ai/components/sidebar"
	"school-with-ai/components/sidepanel"
	"school-with-ai/domain"
)

// ChatInputScreen is the main page component for the "/" route.
// It composes the layout with all chat-related sub-components.
// Equivalent to a Next.js page.tsx that uses a layout.
templ ChatInputScreen(user *domain.User) {
	@components.BaseLayout(components.LayoutProps{
		Title:     "Chat",
		User:      user,
		ExtraHead: ExtraHead(),
	}) {
		<div class="w-full h-full flex flex-col" x-data="chat" @agent-selected.window="selectedAgent = $event.detail.id">
			<!-- Sidebar Layout -->
			<div class="flex-1 min-h-0 overflow-hidden">
				@sidebar.Layout(sidebar.LayoutProps{Class: "h-full min-h-0"}) {
					@nav.Nav()
					<!-- Main Content Area -->
					<div class="flex-1 flex h-full overflow-hidden relative">
						@ChatMain()
						@sidepanel.SidePanel()
					</div>
				}
			</div>
			<!-- Keyboard Shortcuts Dialog -->
			<div x-show="showKeyboardShortcuts" x-cloak>
				@dialog.Dialog(dialog.Props{Open: true}) {
					<div x-show="showKeyboardShortcuts" @click.away="showKeyboardShortcuts = false">
						@keyboardshortcuts.KeyboardShortcuts()
					</div>
				}
			</div>
			@nav.Settings()
			@ToastContainer()
		</div>
	}
}

// ChatMain renders the main chat panel (messages + input).
// This is a "section" component — similar to React's pattern of
// extracting large JSX blocks into named components.
templ ChatMain() {
	<main
		class="flex flex-col relative overflow-hidden w-full h-full"
	>
		@banner.Banner()
		@nav.MobileNav()
		@chat.Header()
		<!-- Content wrapper - class switches based on state -->
		<div
			class="flex flex-col min-h-0"
			:class="(hasMessages || isStreaming)
					? 'flex-1'
					: 'flex-1 items-center justify-end sm:justify-center'"
		>
			@MessageArea()
			@ChatFormArea()
		</div>
		<!-- Footer (Landing Page) -->
		<div x-show="!hasMessages && !isStreaming">
			@footer.Footer()
		</div>
		@eventlog.EventLog()
	</main>
}

// MessageArea renders the scrollable message list with scroll-to-bottom button.
templ MessageArea() {
	<div
		x-show="hasMessages || isStreaming"
		class="relative flex-1 overflow-hidden min-h-0"
	>
		<div
			x-ref="messageList"
			style="height: 100%; overflow-y: auto; width: 100%; scrollbar-gutter: stable; scroll-behavior: auto !important;"
			role="log"
			aria-live="polite"
		>
			<div class="flex flex-col pb-9 pt-14">
				<div class="w-full max-w-3xl xl:max-w-4xl mx-auto px-4">
					@messagelist.MessageList()
				</div>
				<div id="messages-end" x-ref="messagesEnd" class="h-0 w-full flex-shrink-0"></div>
			</div>
		</div>
		@ScrollToBottomButton()
	</div>
}

// ChatFormArea renders the chat input form with conditional landing hero.
templ ChatFormArea() {
	<div
		class="w-full"
		:class="(!hasMessages && !isStreaming) ? 'max-w-3xl xl:max-w-4xl mx-auto transition-all duration-200' : ''"
	>
		<!-- Landing Page Hero (appears above chat input when no messages) -->
		<div x-show="!hasMessages && !isStreaming">
			@LandingHero()
		</div>
		<div
			class="mx-auto flex w-full flex-row gap-3 transition-[max-width] duration-300 sm:px-2"
			:class="(hasMessages || isStreaming) ? 'max-w-3xl xl:max-w-4xl sm:mb-4' : 'sm:mb-28'"
		>
			@chatinput.ChatInput()
		</div>
		<div x-show="hasMessages || isStreaming">
			@footer.CompactFooter()
		</div>
	</div>
}
