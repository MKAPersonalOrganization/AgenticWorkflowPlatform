package home

import (
	"school-with-ai/components/code"
	"school-with-ai/components/collapsible"
	"school-with-ai/components/copybutton"
	"school-with-ai/components/dialog"
	"school-with-ai/components/dropdown"
	"school-with-ai/components/input"
	"school-with-ai/components/popover"
	"school-with-ai/components/selectbox"
	"school-with-ai/components/sidebar"
	"school-with-ai/components/tabs"
	"school-with-ai/components/textarea"
)

// ExtraHead renders page-specific <head> content for the chat page.
// This includes third-party libraries (markdown-it, KaTeX), the chat
// module, Alpine.js plugins, and component scripts.
// Equivalent to Next.js metadata or a custom <Head> component per page.
templ ExtraHead() {
	<!-- Markdown rendering: markdown-it + KaTeX for math -->
	<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"/>
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js"></script>
	<script type="module" src="/assets/js/chat.js?v=fix_katex"></script>
	<!-- Alpine.js Intersect Plugin - MUST load before Alpine core -->
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
	<!-- Alpine.js Collapse Plugin - MUST load before Alpine core -->
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
	@input.Script()
	@collapsible.Script()
	@popover.Script()
	@textarea.Script()
	@sidebar.Script()
	@code.Script()
	@tabs.Script()
	@selectbox.Script()
	@copybutton.Script()
	@dropdown.Script()
	@dialog.Script()
	@ChatPageStyles()
}
