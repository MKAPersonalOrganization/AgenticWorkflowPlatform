package settings

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/icon"
	"school-with-ai/components/nativeselect"
	"school-with-ai/components/selectbox"
	switchcomp "school-with-ai/components/switch"
	"school-with-ai/components/tabs"
)

templ Settings() {
	<div x-show="showSettings" x-cloak>
		@dialog.Dialog(dialog.Props{Open: true, Class: "relative z-50"}) {
			<!-- Backdrop -->
			<div
				class="fixed inset-0 bg-black/50 transition-opacity"
				aria-hidden="true"
				x-show="showSettings"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
			></div>
			<div
				class="fixed inset-0 flex items-center justify-center p-4"
				x-show="showSettings"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
			>
				<div
					class="w-full md:w-[680px] max-h-[90vh] bg-background rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-border"
					@click.away="showSettings = false"
					@keydown.escape.window="showSettings = false"
				>
					<!-- Header -->
					<div class="flex items-center justify-between p-6 pb-4">
						<h2 class="text-lg font-medium text-foreground">Settings</h2>
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantGhost,
							Size:    button.SizeIcon,
							Class:   "rounded-lg p-1 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors",
							Attributes: templ.Attributes{
								"@click": "showSettings = false",
							},
						}) {
							@icon.X(icon.Props{Class: "size-5"})
						}
					</div>
					<!-- Use Tabs Component -->
					@tabs.Tabs(tabs.Props{
						Class: "flex flex-col md:flex-row h-full overflow-hidden px-6 pb-6 gap-6",
						Attributes: templ.Attributes{
							"data-orientation": "vertical",
						},
					}) {
						<!-- Tab List -->
						<div class="flex flex-row md:flex-col gap-1 min-w-[160px] overflow-x-auto md:overflow-y-auto scrollbar-none pb-2 md:pb-0 border-b md:border-b-0 md:border-r border-border pr-0 md:pr-4">
							@tabs.List(tabs.ListProps{Class: "flex flex-row md:flex-col gap-1 bg-transparent p-0 w-full h-auto items-stretch"}) {
								@tabs.Trigger(tabs.TriggerProps{
									Value:    "general",
									IsActive: true,
									Class:    "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Settings(icon.Props{Class: "size-4"})
									<span>General</span>
								}
								@tabs.Trigger(tabs.TriggerProps{
									Value: "personalization",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.UserCog(icon.Props{Class: "size-4"})
									<span>Personalization</span>
								}
								@tabs.Trigger(tabs.TriggerProps{
									Value: "speech",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Mic(icon.Props{Class: "size-4"})
									<span>Speech</span>
								}
								@tabs.Trigger(tabs.TriggerProps{
									Value: "data",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Database(icon.Props{Class: "size-4"})
									<span>Data</span>
								}
								@tabs.Trigger(tabs.TriggerProps{
									Value: "account",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.User(icon.Props{Class: "size-4"})
									<span>Account</span>
								}
							}
						</div>
						<!-- Tab Content Wrapper -->
						<div class="flex-1 overflow-y-auto pr-2 scrollbar-transparent scrollbar-hover text-sm">
							<!-- General Tab -->
							@tabs.Content(tabs.ContentProps{Value: "general", IsActive: true, Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="flex items-center justify-between gap-4">
									<div class="text-foreground">Theme</div>
									@nativeselect.Select(
										nativeselect.Props{
											Class:       "w-[180px]",
											Model:       "theme",
											Label:       "Select Theme",
											Placeholder: "Select Theme",
										},
										[]nativeselect.Option{
											{Value: "system", Label: "System"},
											{Value: "dark", Label: "Dark"},
											{Value: "light", Label: "Light"},
										},
									)
								</div>
								<div class="flex items-center justify-between gap-4">
									<div class="text-foreground">Language</div>
									@selectbox.SelectBox(selectbox.Props{Class: "w-[180px]"}) {
										@selectbox.Trigger(selectbox.TriggerProps{}) {
											<span>English</span>
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "en", Selected: true}) {
												English 
											}
											@selectbox.Item(selectbox.ItemProps{Value: "es"}) {
												Español 
											}
											@selectbox.Item(selectbox.ItemProps{Value: "fr"}) {
												Français 
											}
										}
									}
								</div>
								<div class="border-t border-border pt-4 space-y-4">
									<div class="flex items-center justify-between gap-4">
										<div class="text-foreground">Enable Markdown for user messages</div>
										@switchcomp.Switch(switchcomp.Props{
											Name:    "markdownEnabled",
											Checked: true, // Default or bind to state
											Attributes: templ.Attributes{
												// Assuming x-model handles the checking state boolean
												// But since templui switch uses a hidden checkbox, we can bind x-model to it?
												// Actually switch.Switch wraps input. The Attributes go to input.
												// However, templui switch might not support x-model directly changing its visual state if it relies on CSS peer-checked.
												// x-model usually toggles the 'checked' property, which peer-checked relies on. So it SHOULD work.
												"x-model":    "markdownEnabled",
												"aria-label": "Enable Markdown",
											},
										})
									</div>
									<div class="flex items-center justify-between gap-4">
										<div class="text-foreground">Auto-scroll during response</div>
										@switchcomp.Switch(switchcomp.Props{
											Name:    "autoScroll",
											Checked: true,
											Attributes: templ.Attributes{
												"x-model":    "autoScroll",
												"aria-label": "Auto-scroll during response",
											},
										})
									</div>
								</div>
							}
							<!-- Personalization Tab -->
							@tabs.Content(tabs.ContentProps{Value: "personalization", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="space-y-4">
									<div class="flex flex-col gap-2">
										<label class="text-foreground font-medium">Learning Style</label>
										@selectbox.SelectBox(selectbox.Props{Class: "w-full"}) {
											@selectbox.Trigger(selectbox.TriggerProps{
												Attributes: templ.Attributes{
													"x-model": "profile.learning_style",
												},
											}) {
												<span x-text="profile.learning_style || 'Select a style...'">Select a style...</span>
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
												@selectbox.Item(selectbox.ItemProps{Value: "Visual"}) {
													Visual 
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Auditory"}) {
													Auditory 
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Read/Write"}) {
													Read/Write 
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Kinesthetic"}) {
													Kinesthetic 
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Multimodal"}) {
													Multimodal 
												}
											}
										}
										<p class="text-[12px] text-muted-foreground">How you prefer to take in and process information.</p>
									</div>
									<div class="flex flex-col gap-2 pt-2">
										<label class="text-foreground font-medium">Struggles</label>
										<textarea
											x-model="profile.struggles"
											placeholder="e.g. Algebra, focus, time management..."
											class="w-full h-20 bg-card border border-border rounded-xl p-3 outline-none focus:ring-1 focus:ring-primary resize-none"
										></textarea>
										<p class="text-[12px] text-muted-foreground">Topics or skills you find challenging (comma separated).</p>
									</div>
									<div class="flex flex-col gap-2 pt-2">
										<label class="text-foreground font-medium">Strengths</label>
										<textarea
											x-model="profile.strengths"
											placeholder="e.g. Critical thinking, geometry, writing..."
											class="w-full h-20 bg-card border border-border rounded-xl p-3 outline-none focus:ring-1 focus:ring-primary resize-none"
										></textarea>
										<p class="text-[12px] text-muted-foreground">Areas where you excel or feel confident (comma separated).</p>
									</div>
									<div class="flex flex-col gap-2 pt-2">
										<label class="text-foreground font-medium">Academic Goals</label>
										<textarea
											x-model="profile.goals"
											placeholder="e.g. Master calculus, improve essay structure..."
											class="w-full h-24 bg-card border border-border rounded-xl p-3 outline-none focus:ring-1 focus:ring-primary resize-none"
										></textarea>
										<p class="text-[12px] text-muted-foreground">What you hope to achieve with your AI assistant.</p>
									</div>
									
									<!-- Explict Save Button -->
									<div class="flex items-center justify-end pt-2">
										@button.Button(button.Props{
											Type: button.TypeButton,
											Class: "min-w-[120px]",
											Attributes: templ.Attributes{
												"@click": "updateProfile()",
												":disabled": "profileLoading",
											},
										}) {
											<span x-show="!profileLoading">Save Changes</span>
											<span x-show="profileLoading" class="flex items-center gap-2">
												<span class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-foreground"></span>
												Saving...
											</span>
										}
									</div>
								</div>
								<!-- Loading indicator removed from below as it is now inside the button -->
							}
							<!-- Speech Tab -->
							@tabs.Content(tabs.ContentProps{Value: "speech", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="flex items-center justify-between gap-4">
									<div class="space-y-0.5">
										<div class="text-foreground font-medium">Text-to-Speech</div>
										<p class="text-[12px] text-muted-foreground leading-tight">Enable reading assistant messages aloud.</p>
									</div>
									@switchcomp.Switch(switchcomp.Props{
										Name: "textToSpeech",
										Attributes: templ.Attributes{
											"x-model":    "textToSpeechEnabled",
											"aria-label": "Enable Text-to-Speech",
										},
									})
								</div>
								<div class="flex flex-col gap-2 pt-4 border-t border-border">
									<div class="text-foreground">Voice Engine</div>
									@selectbox.SelectBox(selectbox.Props{Class: "w-full"}) {
										@selectbox.Trigger(selectbox.TriggerProps{}) {
											<span>Default Browser Voice</span>
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "default", Selected: true}) {
												Default Browser Voice 
											}
											@selectbox.Item(selectbox.ItemProps{Value: "premium"}) {
												Premium AI Voice (BETA) 
											}
										}
									}
								</div>
							}
							<!-- Data Tab -->
							@tabs.Content(tabs.ContentProps{Value: "data", Class: "space-y-4 animate-in fade-in duration-200"}) {
								<div
									class="flex items-center justify-between p-3 rounded-xl border border-destructive/20 bg-destructive/5 hover:bg-destructive/10 transition-colors group cursor-pointer"
									@click="if(confirm('Are you sure you want to clear all conversations?')) { sessions = []; showSettings = false; }"
								>
									<div class="space-y-0.5">
										<div class="text-destructive font-medium">Clear all conversations</div>
										<p class="text-[12px] text-muted-foreground">Permanently delete all thread history.</p>
									</div>
									@icon.Trash2(icon.Props{Class: "size-4 text-destructive"})
								</div>
								<div class="flex items-center justify-between p-3 rounded-xl border border-border hover:bg-accent transition-colors group cursor-pointer">
									<div class="space-y-0.5">
										<div class="text-foreground font-medium">Export all data</div>
										<p class="text-[12px] text-muted-foreground">Download a copy of your chat history.</p>
									</div>
									@icon.Download(icon.Props{Class: "size-4 text-muted-foreground group-hover:text-foreground"})
								</div>
							}
							<!-- Account Tab -->
							@tabs.Content(tabs.ContentProps{Value: "account", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="flex items-center gap-4">
									<div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg">
										U
									</div>
									<div>
										<div class="text-foreground font-medium">User Profile</div>
										<p class="text-xs text-muted-foreground">Manage your account details and preferences.</p>
									</div>
								</div>
								<div class="space-y-4 border-t border-border pt-4">
									<a href="/auth/settings?flow=settings" class="w-full text-left p-3 rounded-xl border border-border hover:bg-accent transition-colors flex items-center justify-between group">
										<span class="font-medium">Manage Account & Security</span>
										@icon.ChevronRight(icon.Props{Class: "size-4 text-muted-foreground group-hover:text-foreground"})
									</a>
									<button class="w-full text-left p-3 rounded-xl border border-destructive/20 bg-destructive/5 hover:bg-destructive/10 transition-colors flex items-center justify-between group">
										<span class="text-destructive font-medium">Delete Account</span>
										@icon.UserX(icon.Props{Class: "size-4 text-destructive"})
									</button>
								</div>
							}
						</div>
					}
				</div>
			</div>
		}
	</div>
}
