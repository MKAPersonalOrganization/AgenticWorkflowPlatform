package chatheader

import (
    "school-with-ai/components/icon"
    "school-with-ai/components/button"
)

// ArtifactsToggle renders the button to toggle the artifacts sidebar
templ ArtifactsToggle() {
    <div x-show="hasMessages" x-transition.opacity>
        @button.Button(button.Props{
            Size:    button.SizeIcon,
            Variant: button.VariantGhost,
            Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-muted/50 rounded-md transition-colors",
            Attributes: templ.Attributes{
                "data-tui-sidebar-trigger": "true",
                "data-tui-sidebar-target":  "artifacts-sidebar",
                "title":  "Open Artifacts",
            },
        }) {
            @icon.LayoutDashboard(icon.Props{Class: "size-5"})
        }
    </div>
}
