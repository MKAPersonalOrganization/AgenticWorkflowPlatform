package chatheader

import "school-with-ai/components/icon"
import "school-with-ai/components/sidebar"
import "school-with-ai/components/button"
import "school-with-ai/domain"

templ ChatHeader(user *domain.User) {
	<div class="sticky top-0 z-10 flex h-14 w-full items-center justify-between border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 px-4">
		<div class="flex items-center gap-2">
            <!-- Sidebar Trigger (Desktop) -->
            @sidebar.Trigger(sidebar.TriggerProps{
                Target: "thread-history-sidebar",
                Class:  "hidden md:flex size-9 hover:bg-sidebar-accent/50 text-sidebar-foreground hover:text-foreground rounded-lg items-center justify-center transition-colors",
            })
            
            <div class="md:hidden">
                 <!-- Mobile trigger placeholder -->
            </div>

            <!-- New Chat (Moved to Left) -->
             @button.Button(button.Props{
                Size:    button.SizeIcon,
                Variant: button.VariantGhost,
                Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-muted/50 rounded-md transition-colors",
                Attributes: templ.Attributes{
                    "@click": "createNewSession()",
                    "title":  "New Chat",
                },
            }) {
                @icon.SquarePen(icon.Props{Class: "size-5"})
            }

            <!-- Separator (optional, invisible in LibreChat usually, but good for spacing) -->
            
            <!-- Agent Selector (Mimicking LibreChat Model Select) -->
             <div class="relative" x-data="{ open: false }">
                <button 
                    @click="open = !open" 
                    @click.outside="open = false"
                    class="flex items-center gap-1.5 cursor-pointer hover:bg-muted/50 px-2 py-1.5 rounded-lg transition-colors group"
                >
                    <span x-text="AVAILABLE_AGENTS.find(a => a.id === selectedAgent)?.name || 'Select Agent'" class="text-lg font-semibold text-foreground/80 group-hover:text-foreground"></span>
                    @icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground/50 group-hover:text-foreground transition-colors mt-1"})
                </button>
                
                <!-- Dropdown Menu -->
                <div 
                    x-show="open" 
                    x-transition:enter="transition ease-out duration-100"
                    x-transition:enter-start="opacity-0 scale-95"
                    x-transition:enter-end="opacity-100 scale-100"
                    x-transition:leave="transition ease-in duration-75"
                    x-transition:leave-start="opacity-100 scale-100"
                    x-transition:leave-end="opacity-0 scale-95"
                    class="absolute top-full left-0 mt-1 w-64 rounded-xl border border-border bg-popover p-1 shadow-lg text-popover-foreground z-50 origin-top-left"
                    style="display: none;"
                >
                    <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground uppercase tracking-wider">Model</div>
                    <template x-for="agent in AVAILABLE_AGENTS" :key="agent.id">
                        <button
                            @click="selectedAgent = agent.id; open = false"
                            class="relative flex w-full cursor-pointer select-none items-center gap-3 rounded-lg py-2.5 px-3 text-sm outline-none hover:bg-accent/50 hover:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 transition-colors"
                            :class="selectedAgent === agent.id ? 'bg-accent/50 text-accent-foreground' : ''"
                        >
                            <!-- Icon placeholder -->
                            <div class="size-5 rounded-sm bg-primary/10 flex items-center justify-center text-primary">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path>
                                    <path d="M12 12v6"></path>
                                    <path d="M12 6h.01"></path>
                                </svg>
                            </div>
                            <div class="flex flex-col items-start gap-0.5 flex-1">
                                <span x-text="agent.name" class="font-medium text-foreground"></span>
                                <span class="text-xs text-muted-foreground" x-text="'Great for general tasks'"></span>
                            </div>
                            <template x-if="selectedAgent === agent.id">
                                @icon.Check(icon.Props{Class: "size-4 text-primary"})
                            </template>
                        </button>
                    </template>
                </div>
            </div>
		</div>

        <div class="flex items-center gap-2">
            <!-- Right Side Actions -->
            <!-- Search Toggle -->
            <div x-show="hasMessages" x-transition.opacity>
                @Search()
            </div>

            <!-- Artifacts Toggle -->
            @ArtifactsToggle()
		</div>
	</div>
}
