package chatheader

import "school-with-ai/components/icon"
import "school-with-ai/components/sidebar"
import "school-with-ai/components/button"
import "school-with-ai/components/dropdown"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"

// MobileHeader - LibreChat style mobile header
templ MobileHeader() {
	<div class="sticky top-0 z-10 flex min-h-[40px] items-center justify-center bg-background pl-1 md:hidden">
		<!-- Sidebar Toggle -->
		<button
			type="button"
			data-tui-sheet-trigger="thread-history-sidebar-mobile"
			aria-label={ i18n.T(ctx, "Toggle sidebar") }
			class="m-1 inline-flex size-10 items-center justify-center rounded-full hover:bg-accent/50 transition-colors"
		>
			<span class="sr-only">{ i18n.T(ctx, "Toggle sidebar") }</span>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M3 8C3 7.44772 3.44772 7 4 7H20C20.5523 7 21 7.44772 21 8C21 8.55228 20.5523 9 20 9H4C3.44772 9 3 8.55228 3 8ZM3 16C3 15.4477 3.44772 15 4 15H14C14.5523 15 15 15.4477 15 16C15 16.5523 14.5523 17 14 17H4C3.44772 17 3 16.5523 3 16Z" fill="currentColor"></path>
			</svg>
		</button>
		<!-- Title -->
		<h1
			class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-center text-sm font-normal"
			x-text="currentSessionTitle || 'New Chat'"
		></h1>
		<!-- New Chat -->
		<button
			type="button"
			@click="createNewSession()"
			aria-label={ i18n.T(ctx, "New chat") }
			class="m-1 inline-flex size-10 items-center justify-center rounded-full hover:bg-accent/50 transition-colors"
		>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M16.7929 2.79289C18.0118 1.57394 19.9882 1.57394 21.2071 2.79289C22.4261 4.01184 22.4261 5.98815 21.2071 7.20711L12.7071 15.7071C12.5196 15.8946 12.2652 16 12 16H9C8.44772 16 8 15.5523 8 15V12C8 11.7348 8.10536 11.4804 8.29289 11.2929L16.7929 2.79289ZM19.7929 4.20711C19.355 3.7692 18.645 3.7692 18.2071 4.2071L10 12.4142V14H11.5858L19.7929 5.79289C20.2308 5.35499 20.2308 4.64501 19.7929 4.20711ZM6 5C5.44772 5 5 5.44771 5 6V18C5 18.5523 5.44772 19 6 19H18C18.5523 19 19 18.5523 19 18V14C19 13.4477 19.4477 13 20 13C20.5523 13 21 13.4477 21 14V18C21 19.6569 19.6569 21 18 21H6C4.34315 21 3 19.6569 3 18V6C3 4.34314 4.34315 3 6 3H10C10.5523 3 11 3.44771 11 4C11 4.55228 10.5523 5 10 5H6Z" fill="currentColor"></path>
			</svg>
		</button>
	</div>
}

templ ChatHeader(user *domain.User) {
	<!-- Mobile Header -->
	@MobileHeader()
	<!-- Desktop Header -->
	<div class="absolute top-0 z-10 hidden md:flex h-14 w-full items-center justify-between bg-gradient-to-b from-background via-background/70 to-transparent p-2 font-semibold">
		<div class="flex items-center gap-2">
			<!-- Sidebar Trigger (Desktop) -->
			@sidebar.Trigger(sidebar.TriggerProps{
				Target: "thread-history-sidebar",
				Class:  "hidden md:flex size-9 hover:bg-accent/50 text-muted-foreground hover:text-foreground rounded-lg items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
			})
			<!-- New Chat -->
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-accent/50 rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
				Attributes: templ.Attributes{
					"@click": "createNewSession()",
					"title":  i18n.T(ctx, "New Chat"),
				},
			}) {
				@icon.SquarePen(icon.Props{Class: "size-5"})
			}
			<!-- Agent Selector -->
			@dropdown.Dropdown(dropdown.Props{
				ID: "agent-selector",
			}) {
				@dropdown.Trigger(dropdown.TriggerProps{
					Attributes: templ.Attributes{
						"class": "flex items-center gap-1.5 cursor-pointer hover:bg-accent/50 px-2 py-1.5 rounded-lg transition-colors group focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
					},
				}) {
					<span x-text={ "AVAILABLE_AGENTS.find(a => a.id === selectedAgent)?.name || '" + i18n.T(ctx, "Select Agent") + "'" } class="text-lg font-semibold text-foreground/80 group-hover:text-foreground"></span>
				}
				@dropdown.Content(dropdown.ContentProps{
					Class: "w-64",
				}) {
					@dropdown.Label(dropdown.LabelProps{
						Class: "text-xs font-medium text-muted-foreground uppercase tracking-wider",
					}) {
						{ i18n.T(ctx, "Model") }
					}
					<template x-for="agent in AVAILABLE_AGENTS" :key="agent.id">
						@dropdown.Item(dropdown.ItemProps{
							Attributes: templ.Attributes{
								"@click": "selectedAgent = agent.id",
								":class": "selectedAgent === agent.id ? 'bg-accent/50 text-accent-foreground' : ''",
								"class":  "relative flex w-full cursor-pointer select-none items-center gap-3 rounded-lg py-2.5 px-3 text-sm outline-none hover:bg-accent/50 hover:text-accent-foreground transition-colors focus-visible:ring-2 focus-visible:ring-ring",
							},
						}) {
							<!-- Icon placeholder -->
							<div class="size-5 rounded-sm bg-primary/10 flex items-center justify-center text-primary">
								<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path>
									<path d="M12 12v6"></path>
									<path d="M12 6h.01"></path>
								</svg>
							</div>
							<div class="flex flex-col items-start gap-0.5 flex-1">
								<span x-text="agent.name" class="font-medium text-foreground"></span>
								<span class="text-xs text-muted-foreground" x-text={ "'" + i18n.T(ctx, "Great for general tasks") + "'" }></span>
							</div>
							<template x-if="selectedAgent === agent.id">
								@icon.Check(icon.Props{Class: "size-4 text-primary absolute end-3"})
							</template>
						}
					</template>
				}
			}
		</div>
		<div class="flex items-center gap-2">
			<!-- Right Side Actions -->
			<!-- Search Toggle -->
			<div x-show="hasMessages" x-transition.opacity>
				@Search()
			</div>
			<!-- Artifacts Toggle -->
			@ArtifactsToggle()
		</div>
	</div>
}
