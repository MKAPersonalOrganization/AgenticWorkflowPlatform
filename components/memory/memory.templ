package memory

import "school-with-ai/components/annotation"

templ icon() {
	<div
		:class="message.name === 'save_memory' ? 'text-primary' : 'text-destructive'"
	>
		<template x-if="message.name === 'save_memory'">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain"><path d="M9.5 2A5 5 0 0 1 12 8v4"></path><path d="M14.5 2A5 5 0 0 0 12 8"></path><path d="M9 14.5A5 5 0 0 1 12 12V8"></path><path d="M15 14.5A5 5 0 0 0 12 12"></path><path d="M12 12v4a2 2 0 0 1-2 2h-1"></path><path d="M12 16v4a2 2 0 0 0 2 2h1"></path><path d="M4.8 8H4a2 2 0 1 0 0 4h.3"></path><path d="M19.2 8H20a2 2 0 1 1 0 4h-.3"></path><path d="M12 13h.01"></path><path d="M12 17h.01"></path></svg>
		</template>
		<template x-if="message.name === 'forget_memory'">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eraser"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.9-9.9c1-1 2.5-1 3.4 0l4.4 4.4c1 1 1 2.5 0 3.4L11 20.3z"></path><path d="M19 21H9L3 15"></path><path d="m5 11 9 9"></path></svg>
		</template>
	</div>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		ContainerAttrs: templ.Attributes{
			":class": "{ 'border-primary/20': message.name === 'save_memory', 'border-destructive/20': message.name === 'forget_memory' }",
		},
		IconAttrs: templ.Attributes{
			"class": false, // Disable default text-primary
		},
		LabelAttrs: templ.Attributes{
			"x-text": "message.name === 'save_memory' ? 'Knowledge Anchored' : 'Context Released'",
			":class": "message.name === 'save_memory' ? 'text-primary/40' : 'text-destructive/40'",
		},
		SubtextAttrs: templ.Attributes{
			"x-text": "message.name === 'save_memory' ? 'Synchronized with long-term memory' : 'Removed from retrieval context'",
		},
		FooterDotAttrs: templ.Attributes{
			":class": "message.name === 'save_memory' ? 'bg-green-500/40' : 'bg-destructive/40'",
		},
	}) {
		<div class="flex flex-col gap-4 py-2">
			<!-- The Fact: Professional Typography -->
			<div class="w-full bg-muted/[0.03] border border-border/10 rounded-xl p-6 shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)] transition-colors hover:bg-muted/[0.05]">
				<p class="text-[15px] leading-relaxed text-foreground/90 font-medium font-serif italic text-center">
					<span class="text-primary/40 mr-1 not-italic font-sans" :class="message.name === 'forget_memory' && 'text-destructive/40'">“</span>
					<span x-text="message.parsedArgs?.fact" class="underline decoration-muted/20 underline-offset-8 decoration-1"></span>
					<span class="text-primary/40 ml-1 not-italic font-sans" :class="message.name === 'forget_memory' && 'text-destructive/40'">”</span>
				</p>
			</div>
		</div>
	}
}


