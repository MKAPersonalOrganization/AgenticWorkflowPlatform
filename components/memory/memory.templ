package memory

import "school-with-ai/components/annotation"

templ icon() {
	<div
		:class="{
			'text-primary': message.name === 'save_memory',
			'text-destructive': message.name === 'forget_memory' || message.name === 'clear_memories',
			'text-blue-500': message.name === 'list_memories'
		}"
	>
		<template x-if="message.name === 'save_memory'">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain"><path d="M9.5 2A5 5 0 0 1 12 8v4"></path><path d="M14.5 2A5 5 0 0 0 12 8"></path><path d="M9 14.5A5 5 0 0 1 12 12V8"></path><path d="M15 14.5A5 5 0 0 0 12 12"></path><path d="M12 12v4a2 2 0 0 1-2 2h-1"></path><path d="M12 16v4a2 2 0 0 0 2 2h1"></path><path d="M4.8 8H4a2 2 0 1 0 0 4h.3"></path><path d="M19.2 8H20a2 2 0 1 1 0 4h-.3"></path><path d="M12 13h.01"></path><path d="M12 17h.01"></path></svg>
		</template>
		<template x-if="message.name === 'forget_memory'">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eraser"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.9-9.9c1-1 2.5-1 3.4 0l4.4 4.4c1 1 1 2.5 0 3.4L11 20.3z"></path><path d="M19 21H9L3 15"></path><path d="m5 11 9 9"></path></svg>
		</template>
		<template x-if="message.name === 'list_memories'">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list"><line x1="8" x2="21" y1="6" y2="6"></line><line x1="8" x2="21" y1="12" y2="12"></line><line x1="8" x2="21" y1="18" y2="18"></line><line x1="3" x2="3.01" y1="6" y2="6"></line><line x1="3" x2="3.01" y1="12" y2="12"></line><line x1="3" x2="3.01" y1="18" y2="18"></line></svg>
		</template>
		<template x-if="message.name === 'clear_memories'">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>
		</template>
	</div>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		ContainerAttrs: templ.Attributes{
			":class": `{
				'border-primary/20': message.name === 'save_memory',
				'border-destructive/20': message.name === 'forget_memory' || message.name === 'clear_memories',
				'border-blue-500/20': message.name === 'list_memories'
			}`,
		},
		IconAttrs: templ.Attributes{
			"class": false,
		},
		LabelAttrs: templ.Attributes{
			"x-text": `(() => {
				switch(message.name) {
					case 'save_memory': return 'Knowledge Anchored';
					case 'forget_memory': return 'Context Released';
					case 'list_memories': return 'Memory Retrieved';
					case 'clear_memories': return 'Memory Cleared';
					default: return 'Memory Operation';
				}
			})()`,
			":class": `{
				'text-primary/40': message.name === 'save_memory',
				'text-destructive/40': message.name === 'forget_memory' || message.name === 'clear_memories',
				'text-blue-500/40': message.name === 'list_memories'
			}`,
		},
		SubtextAttrs: templ.Attributes{
			"x-text": `(() => {
				switch(message.name) {
					case 'save_memory': return 'Synchronized with long-term memory';
					case 'forget_memory': return 'Removed from retrieval context';
					case 'list_memories': return 'Displaying stored memories';
					case 'clear_memories': return 'All memories permanently deleted';
					default: return '';
				}
			})()`,
		},
		FooterDotAttrs: templ.Attributes{
			":class": `{
				'bg-green-500/40': message.name === 'save_memory',
				'bg-destructive/40': message.name === 'forget_memory' || message.name === 'clear_memories',
				'bg-blue-500/40': message.name === 'list_memories'
			}`,
		},
	}) {
		<div class="flex flex-col gap-4 py-2">
			<!-- For save_memory and forget_memory: Show the fact -->
			<template x-if="message.name === 'save_memory' || message.name === 'forget_memory'">
				<div class="w-full bg-muted/[0.03] border border-border/10 rounded-xl p-6 shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)] transition-colors hover:bg-muted/[0.05]">
					<p class="text-[15px] leading-relaxed text-foreground/90 font-medium font-serif italic text-center">
						<span class="text-primary/40 mr-1 not-italic font-sans" :class="message.name === 'forget_memory' && 'text-destructive/40'">"</span>
						<span x-text="message.parsedArgs?.fact" class="underline decoration-muted/20 underline-offset-8 decoration-1"></span>
						<span class="text-primary/40 ml-1 not-italic font-sans" :class="message.name === 'forget_memory' && 'text-destructive/40'">"</span>
					</p>
				</div>
			</template>
			<!-- For list_memories: Show memory list from result -->
			<template x-if="message.name === 'list_memories'">
				<div class="w-full bg-blue-500/[0.03] border border-blue-500/10 rounded-xl p-4 shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)]">
					<div class="text-sm text-blue-500/70 font-mono whitespace-pre-wrap">
						<span x-text="message.result || 'Retrieving memories...'"></span>
					</div>
				</div>
			</template>
			<!-- For clear_memories: Show warning -->
			<template x-if="message.name === 'clear_memories'">
				<div class="w-full bg-destructive/[0.03] border border-destructive/10 rounded-xl p-6 shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)]">
					<div class="flex items-center justify-center gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-triangle text-destructive/60"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
						<p class="text-sm text-destructive/70 font-medium">All memories have been permanently deleted</p>
					</div>
				</div>
			</template>
		</div>
	}
}
