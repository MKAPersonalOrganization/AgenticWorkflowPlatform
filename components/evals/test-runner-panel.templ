package evals

import (
	"aicompass/components/button"
	"aicompass/components/i18n"
	"aicompass/components/icon"
)

// TestRunnerPanel renders an IDE-like test runner interface.
templ TestRunnerPanel() {
	<div
		x-data="testRunnerPanel"
		x-init="init()"
		class="flex flex-col h-full bg-background"
	>
		<!-- Header with controls -->
		<div class="flex items-center justify-between px-4 py-2 border-b border-border bg-muted/50">
			<div class="flex items-center gap-2">
				@icon.TestTube(icon.Props{Class: "size-4 text-muted-foreground"})
				<span class="text-sm font-medium">{ i18n.T(ctx, "Test Runner") }</span>
				<span x-show="currentRun" class="text-xs text-muted-foreground" x-text="'#' + (currentRun?.id?.substring(0, 8) || '')"></span>
			</div>
			<div class="flex items-center gap-1">
				<!-- Run button -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-7",
					Attributes: templ.Attributes{
						"@click":    "startRun()",
						":disabled": "running || !selectedEvalSet || !selectedAgent",
						"title":     i18n.T(ctx, "Run Tests"),
					},
				}) {
					@icon.Play(icon.Props{Class: "size-3.5"})
				}
				<!-- Stop button -->
				<template x-if="running">
					@button.Button(button.Props{
						Size:    button.SizeIcon,
						Variant: button.VariantGhost,
						Class:   "size-7 text-red-500",
						Attributes: templ.Attributes{
							"@click": "stopRun()",
							"title":  i18n.T(ctx, "Stop"),
						},
					}) {
						@icon.SquareStop(icon.Props{Class: "size-3.5"})
					}
				</template>
				<!-- Clear button -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-7",
					Attributes: templ.Attributes{
						"@click": "clearResults()",
						"title":  i18n.T(ctx, "Clear"),
					},
				}) {
					@icon.Trash(icon.Props{Class: "size-3.5"})
				}
			</div>
		</div>

		<!-- Progress bar -->
		<div class="h-1 bg-muted">
			<div
				class="h-full transition-all duration-300"
				:class="{
					'bg-blue-500': running,
					'bg-green-500': completed,
					'bg-red-500': failed
				}"
				:style="`width: ${progressPercent}%`"
			></div>
		</div>

		<!-- Main content area -->
		<div class="flex-1 flex overflow-hidden">
			<!-- Left sidebar: Test Explorer -->
			<div class="w-64 border-r border-border flex flex-col bg-muted/20">
				<div class="px-3 py-2 border-b border-border bg-muted/30">
					<div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
						@icon.List(icon.Props{Class: "size-3.5"})
						<span>{ i18n.T(ctx, "Test Explorer") }</span>
					</div>
				</div>

				<!-- Configuration section -->
				<div class="p-2 space-y-2 border-b border-border">
					<!-- EvalSet selector -->
					<div>
						<label class="text-xs text-muted-foreground mb-1 block">{ i18n.T(ctx, "Test Suite") }</label>
						<select
							x-model="selectedEvalSet"
							:disabled="running"
							@click="loadEvalSets()"
							class="w-full text-xs rounded border border-input bg-background px-2 py-1 ring-offset-background focus:outline-none focus:ring-1 focus:ring-ring disabled:opacity-50"
						>
							<option value="">{ i18n.T(ctx, "Select suite...") }</option>
							<template x-for="es in evalSets" :key="es.id">
								<option :value="es.id" x-text="es.name"></option>
							</template>
						</select>
					</div>
					<!-- Agent selector -->
					<div>
						<label class="text-xs text-muted-foreground mb-1 block">{ i18n.T(ctx, "Agent") }</label>
						<select
							x-model="selectedAgent"
							:disabled="running"
							@click="loadAgents()"
							class="w-full text-xs rounded border border-input bg-background px-2 py-1 ring-offset-background focus:outline-none focus:ring-1 focus:ring-ring disabled:opacity-50"
						>
							<option value="">{ i18n.T(ctx, "Select agent...") }</option>
							<template x-for="a in agents" :key="a.id">
								<option :value="a.id" x-text="a.name"></option>
							</template>
						</select>
					</div>
				</div>

				<!-- Test cases tree -->
				<div class="flex-1 overflow-y-auto p-2">
					<div x-show="!testCases.length" class="text-xs text-muted-foreground text-center py-4">
						{ i18n.T(ctx, "No tests loaded") }
					</div>
					<template x-for="(tc, idx) in testCases" :key="tc.case_id || idx">
						<div class="mb-1">
							<div
								class="flex items-center gap-1.5 px-2 py-1 rounded text-xs cursor-pointer hover:bg-muted/50"
								:class="{
									'bg-muted/70': expandedCases.has(idx)
								}"
								@click="toggleCase(idx)"
							>
								<!-- Status icon -->
								<span class="flex-shrink-0">
									<template x-if="tc.status === 'pending'">
										@icon.Circle(icon.Props{Class: "size-3 text-muted-foreground"})
									</template>
									<template x-if="tc.status === 'running'">
										<span class="animate-spin size-3 border-2 border-blue-500 border-t-transparent rounded-full block"></span>
									</template>
									<template x-if="tc.status === 'passed'">
										@icon.CircleCheck(icon.Props{Class: "size-3 text-green-600"})
									</template>
									<template x-if="tc.status === 'failed'">
										@icon.CircleX(icon.Props{Class: "size-3 text-red-600"})
									</template>
									<template x-if="tc.status === 'error'">
										@icon.CircleAlert(icon.Props{Class: "size-3 text-orange-600"})
									</template>
								</span>
								<!-- Case name -->
								<span class="flex-1 truncate" x-text="tc.case_name || 'Case ' + (idx + 1)"></span>
								<!-- Score badge -->
								<template x-if="tc.score != null">
									<span
										class="text-xs px-1 py-0.5 rounded"
										:class="{
											'bg-green-100 text-green-800': tc.score >= 0.8,
											'bg-yellow-100 text-yellow-800': tc.score >= 0.5 && tc.score < 0.8,
											'bg-red-100 text-red-800': tc.score < 0.5
										}"
										x-text="tc.score.toFixed(2)"
									></span>
								</template>
							</div>

							<!-- Expanded case details -->
							<div x-show="expandedCases.has(idx)" class="ml-6 mt-1 space-y-1 text-xs">
								<template x-for="(metric, mIdx) in tc.metrics" :key="mIdx">
									<div class="flex items-center gap-1.5 py-0.5">
										<template x-if="metric.status === 'passed'">
											@icon.Check(icon.Props{Class: "size-3 text-green-600"})
										</template>
										<template x-if="metric.status === 'failed'">
											@icon.X(icon.Props{Class: "size-3 text-red-600"})
										</template>
										<span class="text-muted-foreground" x-text="metric.metric_id"></span>
										<template x-if="metric.score != null">
											<span class="ml-auto font-mono" x-text="metric.score.toFixed(2)"></span>
										</template>
									</div>
								</template>
								<template x-if="tc.error">
									<div class="text-red-600 font-mono text-xs" x-text="tc.error"></div>
								</template>
							</div>
						</div>
					</template>
				</div>
			</div>

			<!-- Right area: Results and Terminal tabs -->
			<div class="flex-1 flex flex-col overflow-hidden">
				<!-- Tab bar -->
				<div class="flex items-center border-b border-border bg-muted/30">
					<button
						@click="activeTab = 'results'"
						class="px-3 py-1.5 text-xs border-b-2 transition-colors"
						:class="activeTab === 'results' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground'"
					>
						@icon.ChartBar(icon.Props{Class: "size-3 inline me-1"})
						{ i18n.T(ctx, "Results") }
					</button>
					<button
						@click="activeTab = 'terminal'"
						class="px-3 py-1.5 text-xs border-b-2 transition-colors"
						:class="activeTab === 'terminal' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground'"
					>
						@icon.Terminal(icon.Props{Class: "size-3 inline me-1"})
						{ i18n.T(ctx, "Terminal") }
					</button>
					<div class="flex-1"></div>
					<!-- Status indicator -->
					<div class="px-3 text-xs text-muted-foreground">
						<template x-if="running">
							<span class="flex items-center gap-1">
								<span class="animate-spin size-3 border-2 border-blue-500 border-t-transparent rounded-full"></span>
								<span x-text="progressText"></span>
							</span>
						</template>
						<template x-if="completed">
							<span class="text-green-600">{ i18n.T(ctx, "Completed") }</span>
						</template>
						<template x-if="failed">
							<span class="text-red-600">{ i18n.T(ctx, "Failed") }</span>
						</template>
					</div>
				</div>

				<!-- Tab content -->
				<div class="flex-1 overflow-hidden">
					<!-- Results tab -->
					<div x-show="activeTab === 'results'" class="h-full overflow-y-auto p-4">
						<div x-show="!testCases.length" class="flex flex-col items-center justify-center h-full text-muted-foreground">
							@icon.TestTube(icon.Props{Class: "size-12 mb-4 opacity-20"})
							<p class="text-sm">{ i18n.T(ctx, "Run tests to see results") }</p>
						</div>

						<!-- Summary cards -->
						<div x-show="testCases.length" class="mb-4 grid grid-cols-4 gap-2">
							<div class="p-3 rounded-lg border border-border bg-muted/30">
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Total") }</p>
								<p class="text-2xl font-bold" x-text="testCases.length"></p>
							</div>
							<div class="p-3 rounded-lg border border-border bg-green-50">
								<p class="text-xs text-green-700">{ i18n.T(ctx, "Passed") }</p>
								<p class="text-2xl font-bold text-green-700" x-text="passedCount"></p>
							</div>
							<div class="p-3 rounded-lg border border-border bg-red-50">
								<p class="text-xs text-red-700">{ i18n.T(ctx, "Failed") }</p>
								<p class="text-2xl font-bold text-red-700" x-text="failedCount"></p>
							</div>
							<div class="p-3 rounded-lg border border-border bg-muted/30">
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Avg Score") }</p>
								<p class="text-2xl font-bold" x-text="averageScore"></p>
							</div>
						</div>

						<!-- Results tree -->
						<div x-show="testCases.length" class="space-y-2">
							<template x-for="(tc, idx) in testCases" :key="tc.case_id || idx">
								<div
									class="rounded-lg border border-border overflow-hidden"
									:class="{
										'border-green-200 bg-green-50/30': tc.status === 'passed',
										'border-red-200 bg-red-50/30': tc.status === 'failed' || tc.status === 'error'
									}"
								>
									<div
										class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-muted/30"
										@click="toggleResult(idx)"
									>
										<template x-if="tc.status === 'passed'">
											@icon.CircleCheck(icon.Props{Class: "size-4 text-green-600 flex-shrink-0"})
										</template>
										<template x-if="tc.status === 'failed'">
											@icon.CircleX(icon.Props{Class: "size-4 text-red-600 flex-shrink-0"})
										</template>
										<template x-if="tc.status === 'error'">
											@icon.CircleAlert(icon.Props{Class: "size-4 text-orange-600 flex-shrink-0"})
										</template>
										<template x-if="tc.status === 'running'">
											<span class="animate-spin size-4 border-2 border-blue-500 border-t-transparent rounded-full flex-shrink-0"></span>
										</template>
										<template x-if="tc.status === 'pending'">
											@icon.Circle(icon.Props{Class: "size-4 text-muted-foreground flex-shrink-0"})
										</template>
										<span class="flex-1 text-sm font-medium" x-text="tc.case_name || 'Case ' + (idx + 1)"></span>
										<template x-if="tc.score != null">
											<span
												class="text-xs font-mono px-2 py-1 rounded"
												:class="{
													'bg-green-100 text-green-800': tc.score >= 0.8,
													'bg-yellow-100 text-yellow-800': tc.score >= 0.5 && tc.score < 0.8,
													'bg-red-100 text-red-800': tc.score < 0.5
												}"
												x-text="tc.score.toFixed(2)"
											></span>
										</template>
									</div>
									<div x-show="expandedResults.has(idx)" class="px-3 pb-3 border-t border-border/50">
										<template x-if="tc.metrics && tc.metrics.length">
											<div class="mt-2 space-y-1">
												<p class="text-xs font-medium text-muted-foreground mb-2">{ i18n.T(ctx, "Metrics") }</p>
												<template x-for="(metric, mIdx) in tc.metrics" :key="mIdx">
													<div class="flex items-center justify-between py-1 px-2 rounded text-xs bg-muted/30">
														<div class="flex items-center gap-2">
															<template x-if="metric.status === 'passed'">
																@icon.Check(icon.Props{Class: "size-3 text-green-600"})
															</template>
															<template x-if="metric.status === 'failed'">
																@icon.X(icon.Props{Class: "size-3 text-red-600"})
															</template>
															<span x-text="metric.metric_id"></span>
														</div>
														<span class="font-mono" x-text="metric.score?.toFixed(2) || '-'"></span>
													</div>
												</template>
											</div>
										</template>
										<template x-if="tc.error">
											<div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-xs font-mono text-red-700">
												<p class="font-medium mb-1">{ i18n.T(ctx, "Error") }</p>
												<pre class="whitespace-pre-wrap" x-text="tc.error"></pre>
											</div>
										</template>
									</div>
								</div>
							</template>
						</div>
					</div>

					<!-- Terminal tab -->
					<div x-show="activeTab === 'terminal'" class="h-full bg-zinc-950 text-zinc-100 font-mono text-xs overflow-hidden flex flex-col">
						<div class="flex items-center justify-between px-3 py-1.5 border-b border-zinc-800 bg-zinc-900">
							<span class="text-xs text-zinc-400">{ i18n.T(ctx, "Output") }</span>
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-6 text-zinc-400 hover:text-zinc-100",
								Attributes: templ.Attributes{
									"@click": "scrollTerminalToEnd()",
									"title":  i18n.T(ctx, "Scroll to bottom"),
								},
							}) {
								@icon.ArrowDown(icon.Props{Class: "size-3.5"})
							}
						</div>
						<div
							x-ref="terminal"
							class="flex-1 overflow-y-auto p-3 space-y-0.5"
						>
							<div x-show="!logs.length" class="text-zinc-500 py-4 text-center">
								{ i18n.T(ctx, "No output yet") }
							</div>
							<template x-for="(log, idx) in logs" :key="idx">
								<div class="whitespace-pre-wrap" x-text="log"></div>
							</template>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// TestRunnerPanelTrigger renders a button that opens the test runner panel.
templ TestRunnerPanelTrigger() {
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Class:   "size-9",
		Attributes: templ.Attributes{
			"@click": "$dispatch('open-test-runner-panel')",
			"title":  i18n.T(ctx, "Test Runner"),
		},
	}) {
		@icon.TestTube(icon.Props{Class: "size-5"})
		<span class="sr-only">{ i18n.T(ctx, "Test Runner") }</span>
	}
}
