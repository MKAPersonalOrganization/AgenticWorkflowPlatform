package evals

// TestRunnerPanelScript renders the Alpine.js component for the test runner panel.
templ TestRunnerPanelScript() {
	<script>
		function testRunnerPanel() {
			return {
				// State
				running: false,
				completed: false,
				failed: false,
				cancelled: false,
				activeTab: 'terminal',
				currentRun: null,
				selectedEvalSet: '',
				selectedAgent: '',
				evalSets: [],
				agents: [],
				testCases: [],
				logs: [],
				expandedCases: new Set(),
				expandedResults: new Set(),
				progressPercent: 0,
				progressText: '0 / 0',
				abortController: null,

				init() {
					window.addEventListener('open-test-runner-panel', () => {
						this.loadEvalSets();
						this.loadAgents();
					});
				},

				async loadEvalSets() {
					try {
						const res = await fetch('/api/eval-sets');
						if (res.ok) this.evalSets = await res.json();
					} catch (err) {
						console.error('Failed to load eval sets:', err);
					}
				},

				async loadAgents() {
					try {
						const res = await fetch('/v1/agent-definitions');
						if (res.ok) {
							const data = await res.json();
							this.agents = (data.agents || []).filter(a => !a.deleted_at);
						}
					} catch (err) {
						console.error('Failed to load agents:', err);
					}
				},

				async startRun() {
					if (!this.selectedEvalSet || !this.selectedAgent) return;

					// Reset state
					this.running = true;
					this.completed = false;
					this.failed = false;
					this.cancelled = false;
					this.testCases = [];
					this.logs = [];
					this.expandedCases.clear();
					this.expandedResults.clear();
					this.progressPercent = 0;
					this.progressText = '0 / 0';
					this.activeTab = 'terminal';

					// Create AbortController (browser-native cancellation)
					this.abortController = new AbortController();

					try {
						// Use inline SSE streaming endpoint (same pattern as AGUI)
						const res = await fetch('/api/evaluation/runs/eval-stream', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								eval_set_id: this.selectedEvalSet,
								agent_id: this.selectedAgent,
								num_runs: 1
							}),
							signal: this.abortController.signal  // ← Attach controller
						});

						if (!res.ok) {
							const errText = await res.text();
							throw new Error(`Failed: ${res.status} ${errText}`);
						}

						// Read SSE stream
						const reader = res.body.getReader();
						const decoder = new TextDecoder();
						let buffer = '';

						while (true) {
							const { done, value } = await reader.read();
							if (done) break;

							buffer += decoder.decode(value, { stream: true });
							const lines = buffer.split('\n');
							buffer = lines.pop() || '';

							for (const line of lines) {
								if (line.startsWith('data: ')) {
									try {
										const data = JSON.parse(line.slice(6));
										this.handleEvent(data);
									} catch (e) {
										console.error('Parse error:', e, line);
									}
								}
							}
						}
					} catch (err) {
						if (err.name === 'AbortError') {
							// User clicked Stop button
							console.log('⏹️ Run cancelled by user');
							this.running = false;
							this.cancelled = true;
							this.logs.push('[RUN] ⏹️ Cancelled by user');
						} else {
							// Real error
							console.error('❌ Run failed:', err);
							this.running = false;
							this.failed = true;
							this.logs.push('[ERROR] ' + err.message);
						}
					} finally {
						this.abortController = null;
					}
				},

				stopRun() {
					// Abort the streaming request (browser-native cancellation)
					if (this.abortController) {
						this.abortController.abort();
						this.logs.push('[INFO] Sending cancel signal...');
						this.$nextTick(() => this.autoScrollTerminal());
					}
				},

				handleEvent(data) {
					console.log('📨 Event:', data.type, data);

					switch (data.type) {
						case 'SESSION_START':
							this.currentRun = { id: data.contextId };
							this.logs.push(`[RUN] Starting evaluation ${data.contextId.substring(0, 8)}`);
							break;

						case 'RUN_STARTED':
							this.testCases = [];
							for (let i = 0; i < data.num_cases * data.num_runs; i++) {
								this.testCases.push({
									case_id: null,
									case_name: `Case ${i+1}`,
									status: 'pending',
									score: null,
									metrics: []
								});
							}
							this.logs.push(`[RUN] ${data.eval_set} (${data.num_cases} cases, ${data.num_runs} run(s))`);
							break;

						case 'CASE_STARTED':
							if (this.testCases[data.case_index]) {
								this.testCases[data.case_index].status = 'running';
								this.testCases[data.case_index].case_id = data.case_id;
								this.testCases[data.case_index].case_name = data.case_name;
							}
							this.logs.push(`[CASE] ▶️ ${data.case_name}`);
							break;

						case 'METRIC_DONE':
							this.logs.push(`  [METRIC] ${data.metric}: ${data.score.toFixed(2)} (${data.status})`);
							break;

						case 'CASE_COMPLETE':
							const idx = this.testCases.findIndex(tc => tc.case_id === data.case_id);
							if (idx !== -1) {
								this.testCases[idx].status = data.status;
								this.testCases[idx].score = data.score;
								this.testCases[idx].metrics = data.metrics || [];
							}
							this.progressPercent = Math.round(data.progress_pct);
							this.progressText = `${data.completed} / ${data.total_cases}`;
							this.logs.push(`[CASE] ✅ ${data.case_name} - ${data.status} (${data.score.toFixed(2)})`);
							break;

						case 'RUN_COMPLETE':
							this.running = false;
							this.completed = true;
							this.progressPercent = 100;
							this.logs.push(`[RUN] ✅ Completed in ${data.duration_ms}ms`);
							this.loadFinalResults(this.currentRun.id);
							this.activeTab = 'results';
							break;

						case 'RUN_ERROR':
							this.running = false;
							this.failed = true;
							this.logs.push(`[RUN] ❌ Error: ${data.message}`);
							break;
					}

					this.$nextTick(() => this.autoScrollTerminal());
				},

				async loadFinalResults(runId) {
					try {
						const res = await fetch(`/api/evaluation/runs/${runId}/results`);
						if (res.ok) {
							const results = await res.json();
							this.mergeResults(results);
						}
					} catch (err) {
						console.error('Failed to load results:', err);
					}
				},

				mergeResults(results) {
					const byCase = {};
					for (const r of results) {
						if (!byCase[r.case_id]) byCase[r.case_id] = [];
						byCase[r.case_id].push(r);
					}

					for (const tc of this.testCases) {
						if (byCase[tc.case_id]) {
							const caseResults = byCase[tc.case_id];
							tc.metrics = caseResults.map(r => ({
								metric_id: r.metric_id,
								score: r.score,
								status: r.status,
								details: r.details
							}));
							const scores = caseResults.filter(r => r.score != null).map(r => r.score);
							if (scores.length > 0) {
								tc.score = scores.reduce((a, b) => a + b, 0) / scores.length;
							}
						}
					}
				},

				clearResults() {
					// Abort any running request
					if (this.abortController) {
						this.abortController.abort();
					}
					this.running = false;
					this.completed = false;
					this.failed = false;
					this.cancelled = false;
					this.currentRun = null;
					this.testCases = [];
					this.logs = [];
					this.expandedCases.clear();
					this.expandedResults.clear();
					this.progressPercent = 0;
					this.progressText = '';
				},

				toggleCase(idx) {
					if (this.expandedCases.has(idx)) this.expandedCases.delete(idx);
					else this.expandedCases.add(idx);
				},

				toggleResult(idx) {
					if (this.expandedResults.has(idx)) this.expandedResults.delete(idx);
					else this.expandedResults.add(idx);
				},

				autoScrollTerminal() {
					this.$nextTick(() => {
						if (this.$refs.terminal) {
							this.$refs.terminal.scrollTop = this.$refs.terminal.scrollHeight;
						}
					});
				},

				get passedCount() {
					return this.testCases.filter(tc => tc.status === 'passed').length;
				},

				get failedCount() {
					return this.testCases.filter(tc => tc.status === 'failed' || tc.status === 'error').length;
				},

				get averageScore() {
					const scores = this.testCases.filter(tc => tc.score != null).map(tc => tc.score);
					if (scores.length === 0) return '-';
					return (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(2);
				}
			};
		}
	</script>
}
