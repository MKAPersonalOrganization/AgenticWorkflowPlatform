package evals

import (
	"aicompass/components/badge"
	"aicompass/components/button"
	"aicompass/components/dialog"
	"aicompass/components/i18n"
	"aicompass/components/icon"
	"aicompass/components/input"
)

templ EvalSetsDialog() {
	<div
		x-data="evalSetsDialog"
		@open-evalsets-dialog.window="open()"
	>
		@dialog.Dialog(dialog.Props{ID: "evalsets-manager-dialog"}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-3xl max-h-[85vh] flex flex-col p-0 overflow-hidden",
			}) {
				<div class="flex flex-col h-full max-h-[85vh]">
					<!-- Header -->
					@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
						<div class="flex items-center justify-between mb-3">
							<div>
								@dialog.Title() {
									{ i18n.T(ctx, "Evaluation Test Suites") }
								}
								@dialog.Description() {
									{ i18n.T(ctx, "Manage your EvalSets and test cases.") }
								}
							</div>
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>
						<div class="flex items-center gap-2 pb-3">
							<div class="relative flex-1">
								@icon.Search(icon.Props{Class: "absolute left-2.5 top-1/2 -translate-y-1/2 size-4 text-muted-foreground pointer-events-none"})
								<input
									type="text"
									x-model="search"
									placeholder={ i18n.T(ctx, "Search eval sets...") }
									class="w-full rounded-md border border-input bg-background pl-8 pr-3 py-1.5 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								/>
							</div>
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantOutline,
								Attributes: templ.Attributes{
									"@click": "triggerImport()",
									"title":  i18n.T(ctx, "Import EvalSet"),
								},
							}) {
								@icon.Download(icon.Props{Class: "size-3.5 me-1.5"})
								{ i18n.T(ctx, "Import") }
							}
							@button.Button(button.Props{
								Size: button.SizeSm,
								Attributes: templ.Attributes{
									"@click": "view = 'create'; form = {id:'', name:'', description:''}; formError = ''",
								},
							}) {
								@icon.Plus(icon.Props{Class: "size-3.5 me-1.5"})
								{ i18n.T(ctx, "New EvalSet") }
							}
						</div>
					}

					<!-- Body: list / form / cases / case-form -->
					<div class="flex-1 overflow-y-auto p-4">
						<!-- List View -->
						<div x-show="view === 'list'">
							<div x-show="loading" class="flex items-center justify-center py-12">
								<span class="animate-spin size-5 border-2 border-primary border-t-transparent rounded-full"></span>
								<span class="ms-2 text-sm text-muted-foreground">{ i18n.T(ctx, "Loading...") }</span>
							</div>

							<div x-show="!loading && filteredSets.length === 0" class="flex flex-col items-center justify-center py-12 text-center">
								@icon.TestTube(icon.Props{Class: "size-10 text-muted-foreground/50 mb-3"})
								<p class="text-sm font-medium text-foreground">{ i18n.T(ctx, "No eval sets yet") }</p>
								<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "Create a new eval set or import one from JSON.") }</p>
							</div>

							<div x-show="filteredSets.length > 0" class="space-y-2">
								<template x-for="es in filteredSets" :key="es.id">
									<div class="group flex items-start gap-3 p-3 rounded-lg border border-border/60 hover:border-border hover:bg-muted/30 transition-colors cursor-pointer"
										@click="openCases(es)">
										<div class="flex-1 min-w-0">
											<div class="flex items-center gap-2">
												<p class="text-sm font-medium text-foreground truncate" x-text="es.name"></p>
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] px-1.5 py-0"}) {
													<span x-text="es.case_count + ' cases'"></span>
												}
											</div>
											<p class="text-xs text-muted-foreground mt-0.5 truncate" x-show="es.description" x-text="es.description"></p>
										</div>
										<div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity" @click.stop>
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-6 text-muted-foreground",
												Attributes: templ.Attributes{
													"@click": "editEvalSet(es)",
													"title":  i18n.T(ctx, "Edit"),
												},
											}) {
												@icon.Pencil(icon.Props{Class: "size-3"})
											}
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-6 text-muted-foreground",
												Attributes: templ.Attributes{
													"@click": "exportEvalSet(es)",
													"title":  i18n.T(ctx, "Export"),
												},
											}) {
												@icon.Upload(icon.Props{Class: "size-3"})
											}
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-6 text-destructive/70",
												Attributes: templ.Attributes{
													"@click": "deleteEvalSet(es)",
													"title":  i18n.T(ctx, "Delete"),
												},
											}) {
												@icon.Trash2(icon.Props{Class: "size-3"})
											}
										</div>
									</div>
								</template>
							</div>
						</div>

						<!-- Create/Edit Form -->
						<div x-show="view === 'create' || view === 'edit'" class="space-y-4">
							<div class="flex items-center gap-2 mb-4">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
										"title":  i18n.T(ctx, "Back"),
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
								}
								<h3 class="text-sm font-semibold text-foreground" x-show="view === 'create'">{ i18n.T(ctx, "New EvalSet") }</h3>
								<h3 class="text-sm font-semibold text-foreground" x-show="view === 'edit'">{ i18n.T(ctx, "Edit EvalSet") }</h3>
							</div>
							<div>
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Name") } <span class="text-destructive">*</span>
								</label>
								@input.Input(input.Props{
									Type:        input.TypeText,
									Placeholder: "e.g., Weather Agent Tests",
									Attributes: templ.Attributes{
										"x-model":            "form.name",
										"@keydown.enter.prevent": "saveEvalSet()",
									},
								})
							</div>
							<div>
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Description") }
								</label>
								<textarea
									x-model="form.description"
									rows="3"
									placeholder="Optional description..."
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring resize-none"
								></textarea>
							</div>
							<div x-show="formError" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
								<p class="text-sm text-destructive" x-text="formError"></p>
							</div>
						</div>

						<!-- Cases View -->
						<div x-show="view === 'cases'" class="space-y-2">
							<div class="flex items-center gap-2 mb-4">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
										"title":  i18n.T(ctx, "Back"),
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
								}
								<div class="flex-1">
									<h3 class="text-sm font-semibold text-foreground" x-text="selectedSet?.name"></h3>
									<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Test Cases") }</p>
								</div>
								@button.Button(button.Props{
									Size: button.SizeSm,
									Attributes: templ.Attributes{
										"@click": "view = 'case-form'; caseForm = {id:'', name:'', input:'', expected_trajectory:'', expected_response:''}; caseFormError = ''",
									},
								}) {
									@icon.Plus(icon.Props{Class: "size-3.5 me-1.5"})
									{ i18n.T(ctx, "Add Case") }
								}
							</div>

							<div x-show="casesLoading" class="flex items-center justify-center py-12">
								<span class="animate-spin size-5 border-2 border-primary border-t-transparent rounded-full"></span>
							</div>

							<div x-show="!casesLoading && cases.length === 0" class="flex flex-col items-center justify-center py-12 text-center">
								@icon.FileText(icon.Props{Class: "size-10 text-muted-foreground/50 mb-3"})
								<p class="text-sm font-medium text-foreground">{ i18n.T(ctx, "No test cases yet") }</p>
							</div>

							<template x-for="(c, idx) in cases" :key="c.id">
								<div class="group p-3 rounded-lg border border-border/60 hover:bg-muted/30 transition-colors">
									<div class="flex items-start justify-between gap-2">
										<div class="flex-1 min-w-0">
											<div class="flex items-center gap-2">
												<span class="text-xs font-mono text-muted-foreground" x-text="'#' + (idx + 1)"></span>
												<span class="text-sm font-medium text-foreground" x-show="c.name" x-text="c.name"></span>
											</div>
											<p class="text-xs text-muted-foreground mt-1 line-clamp-2" x-text="c.input"></p>
											<div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
												<template x-if="c.expected_trajectory">
													@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] px-1.5 py-0"}) {
														@icon.Wrench(icon.Props{Class: "size-2.5 me-1"})
														{ i18n.T(ctx, "Has trajectory") }
													}
												</template>
												<template x-if="c.expected_response">
													@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] px-1.5 py-0"}) {
														@icon.MessageSquare(icon.Props{Class: "size-2.5 me-1"})
														{ i18n.T(ctx, "Has reference") }
													}
												</template>
											</div>
										</div>
										<div class="flex items-center gap-0.5 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-6 text-muted-foreground",
												Attributes: templ.Attributes{
													"@click": "editCase(c)",
													"title":  i18n.T(ctx, "Edit"),
												},
											}) {
												@icon.Pencil(icon.Props{Class: "size-3"})
											}
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-6 text-destructive/70",
												Attributes: templ.Attributes{
													"@click": "deleteCase(c)",
													"title":  i18n.T(ctx, "Delete"),
												},
											}) {
												@icon.Trash2(icon.Props{Class: "size-3"})
											}
										</div>
									</div>
								</div>
							</template>
						</div>

						<!-- Case Form -->
						<div x-show="view === 'case-form'" class="space-y-4">
							<div class="flex items-center gap-2 mb-4">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"@click": "view = 'cases'",
										"title":  i18n.T(ctx, "Back"),
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
								}
								<h3 class="text-sm font-semibold text-foreground" x-show="caseForm.id">{ i18n.T(ctx, "Edit Test Case") }</h3>
								<h3 class="text-sm font-semibold text-foreground" x-show="!caseForm.id">{ i18n.T(ctx, "Add Test Case") }</h3>
							</div>
							<div>
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Name") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "optional") })</span>
								</label>
								<input
									type="text"
									x-model="caseForm.name"
									placeholder="e.g., basic_query"
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								/>
							</div>
							<div>
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Input Prompt") } <span class="text-destructive">*</span>
								</label>
								<textarea
									x-model="caseForm.input"
									rows="3"
									placeholder="What's the weather in Tokyo?"
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring resize-none"
								></textarea>
							</div>
							<div>
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Expected Trajectory") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "JSON") })</span>
								</label>
								<textarea
									x-model="caseForm.expected_trajectory"
									rows="3"
									placeholder='[{"tool_name": "weather_api", "args": {"city": "Tokyo"}}]'
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm font-mono ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring resize-none"
								></textarea>
							</div>
							<div>
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Expected Response") } <span class="text-muted-foreground font-normal">({ i18n.T(ctx, "optional") })</span>
								</label>
								<textarea
									x-model="caseForm.expected_response"
									rows="2"
									placeholder="The weather in Tokyo is..."
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring resize-none"
								></textarea>
							</div>
							<div x-show="caseFormError" x-cloak class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
								<p class="text-sm text-destructive" x-text="caseFormError"></p>
							</div>
						</div>
					</div>

					<!-- Footer -->
					@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
						<div class="flex items-center justify-between w-full">
							<span class="text-xs text-muted-foreground" x-show="view === 'list'" x-text="filteredSets.length + ' eval set' + (filteredSets.length !== 1 ? 's' : '')"></span>
							<span class="text-xs text-muted-foreground" x-show="view === 'cases'" x-text="cases.length + ' case' + (cases.length !== 1 ? 's' : '')"></span>
							<div class="flex items-center gap-2">
								<template x-if="view === 'create' || view === 'edit'">
									<div class="flex items-center gap-2">
										@button.Button(button.Props{Variant: button.VariantOutline}) {
											<span @click="view = 'list'">{ i18n.T(ctx, "Cancel") }</span>
										}
										@button.Button(button.Props{
											Attributes: templ.Attributes{
												"@click":    "saveEvalSet()",
												":disabled": "!form.name || saving",
											},
										}) {
											<span x-show="!saving">{ i18n.T(ctx, "Save") }</span>
											<span x-show="saving" class="flex items-center gap-2">
												<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
												{ i18n.T(ctx, "Saving...") }
											</span>
										}
									</div>
								</template>
								<template x-if="view === 'case-form'">
									<div class="flex items-center gap-2">
										@button.Button(button.Props{Variant: button.VariantOutline}) {
											<span @click="view = 'cases'">{ i18n.T(ctx, "Cancel") }</span>
										}
										@button.Button(button.Props{
											Attributes: templ.Attributes{
												"@click":    "saveCase()",
												":disabled": "!caseForm.input || caseSaving",
											},
										}) {
											<span x-show="!caseSaving">{ i18n.T(ctx, "Save") }</span>
											<span x-show="caseSaving" class="flex items-center gap-2">
												<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
												{ i18n.T(ctx, "Saving...") }
											</span>
										}
									</div>
								</template>
								<template x-if="view === 'list' || view === 'cases'">
									@dialog.Close() {
										@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
											{ i18n.T(ctx, "Close") }
										}
									}
								</template>
							</div>
						</div>
					}

					<!-- Hidden file input for import -->
					<input
						type="file"
						accept=".json"
						x-ref="importFile"
						class="hidden"
						@change="handleImport($event)"
					/>
				</div>
			}
		}
	</div>
}

// EvalSetsButtonTrigger renders the navbar trigger button for the EvalSets dialog.
templ EvalSetsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "evalsets-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-evalsets-dialog')",
				"title":  i18n.T(ctx, "Evaluation"),
			},
		}) {
			@icon.TestTube(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Evaluation") }</span>
		}
	}
}

templ Script() {
	@dialog.Script()
	@input.Script()
}
