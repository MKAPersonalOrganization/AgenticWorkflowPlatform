package evals

import (
	"aicompass/components/button"
	"aicompass/components/dialog"
	"aicompass/components/i18n"
	"aicompass/components/icon"
)

templ EvaluationDialog() {
	<div
		x-data="evaluationDialog"
		@open-evaluation-dialog.window="open()"
	>
		@dialog.Dialog(dialog.Props{ID: "evaluation-dialog"}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-3xl max-h-[85vh] flex flex-col p-0 overflow-hidden",
			}) {
				<div class="flex flex-col h-full max-h-[85vh]">
					@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
						<div class="flex items-center justify-between">
							<div>
								@dialog.Title() {
									{ i18n.T(ctx, "Evaluation") }
								}
								@dialog.Description() {
									{ i18n.T(ctx, "Run evaluations and view results.") }
								}
							</div>
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>
					}
					<div class="flex-1 overflow-y-auto p-4 space-y-4">
						<div class="flex items-center gap-2">
							@button.Button(button.Props{
								Size: button.SizeSm,
								Attributes: templ.Attributes{
									"@click": "view = 'launch'; loadAgents(); loadProfiles()",
								},
							}) {
								@icon.Play(icon.Props{Class: "size-3.5 me-1.5"})
								{ i18n.T(ctx, "Run Evaluation") }
							}
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantOutline,
								Attributes: templ.Attributes{
									"@click": "view = 'rubrics'; loadRubrics()",
								},
							}) {
								@icon.BookOpen(icon.Props{Class: "size-3.5 me-1.5"})
								{ i18n.T(ctx, "Rubrics") }
							}
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantOutline,
								Attributes: templ.Attributes{
									"@click": "loadRuns()",
								},
							}) {
								@icon.RefreshCw(icon.Props{Class: "size-3.5 me-1.5"})
								{ i18n.T(ctx, "Refresh") }
							}
						</div>

						<!-- Launch Form -->
						<div x-show="view == 'launch'" class="space-y-3 p-3 rounded-lg border border-border/60 bg-muted/30">
							<div>
								<label class="text-xs font-medium text-foreground mb-1 block">{ i18n.T(ctx, "Agent ID") }</label>
								<input
									type="text"
									x-model="launchForm.agent_id"
									placeholder="Enter agent UUID"
									class="w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								/>
							</div>
							<div>
								<label class="text-xs font-medium text-foreground mb-1 block">{ i18n.T(ctx, "Profile ID") }</label>
								<select
									x-model="launchForm.profile_id"
									class="w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									<option value="">{ i18n.T(ctx, "Default metrics") }</option>
									<template x-for="p in profiles" :key="p.id">
										<option :value="p.id" x-text="p.name"></option>
									</template>
								</select>
							</div>
							<div>
								<label class="text-xs font-medium text-foreground mb-1 block">{ i18n.T(ctx, "Number of Runs") }</label>
								<input
									type="number"
									x-model.number="launchForm.num_runs"
									min="1"
									max="10"
									class="w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								/>
							</div>
							<div class="flex gap-2">
								@button.Button(button.Props{
									Variant: button.VariantOutline,
									Size:    button.SizeSm,
									Attributes: templ.Attributes{
										"@click": "view = 'runs'",
									},
								}) {
									{ i18n.T(ctx, "Cancel") }
								}
								@button.Button(button.Props{
									Size: button.SizeSm,
									Attributes: templ.Attributes{
										"@click":    "launchEvaluation()",
										":disabled": "!launchForm.agent_id || launching",
									},
								}) {
									<span x-show="!launching">{ i18n.T(ctx, "Launch") }</span>
									<span x-show="launching" class="flex items-center gap-1">
										<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
										{ i18n.T(ctx, "Launching...") }
									</span>
								}
							</div>
						</div>

						<!-- Runs List -->
						<div x-show="view == 'runs' || view == 'launch'">
							<div x-show="loading" class="text-center py-8 text-sm text-muted-foreground">{ i18n.T(ctx, "Loading...") }</div>
							<div x-show="!loading && runs.length == 0" class="text-center py-8 text-sm text-muted-foreground">{ i18n.T(ctx, "No evaluation runs yet") }</div>
							<template x-for="run in runs" :key="run.id">
								<div class="p-3 rounded-lg border border-border/60 hover:bg-muted/30 transition-colors mb-2">
									<div class="flex items-center justify-between">
										<div>
											<span class="text-xs font-mono px-1.5 py-0.5 rounded bg-muted" x-text="run.status"></span>
											<span class="text-xs text-muted-foreground ms-2" x-text="run.num_runs + ' runs'"></span>
										</div>
										<div class="flex items-center gap-1">
											@button.Button(button.Props{
												Size:    button.SizeIcon,
												Variant: button.VariantGhost,
												Class:   "size-6 text-muted-foreground",
												Attributes: templ.Attributes{
													"@click": "viewResults(run)",
													"title":  i18n.T(ctx, "View Results"),
												},
											}) {
												@icon.Eye(icon.Props{Class: "size-3"})
											}
										</div>
									</div>
								</div>
							</template>
						</div>

						<!-- Results View -->
						<div x-show="view == 'results'">
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantOutline,
								Attributes: templ.Attributes{
									"@click": "view = 'runs'",
								},
							}) {
								@icon.ArrowLeft(icon.Props{Class: "size-3.5 me-1.5"})
								{ i18n.T(ctx, "Back") }
							}
							<template x-for="result in results" :key="result.id">
								<div class="p-3 rounded-lg border border-border/60 mb-2">
									<div class="text-xs">
										<span x-text="'Case: ' + result.case_id"></span>
										<span class="ms-2" x-text="'Metric: ' + result.metric_id"></span>
										<span class="ms-2 font-medium" x-show="result.score != null" x-text="'Score: ' + result.score"></span>
									</div>
									<details class="mt-2">
										<summary class="text-xs text-muted-foreground cursor-pointer">{ i18n.T(ctx, "View details") }</summary>
										<pre class="mt-2 p-2 bg-muted rounded text-xs overflow-auto max-h-32" x-text="JSON.stringify(result.details, null, 2)"></pre>
									</details>
								</div>
							</template>
						</div>

						<!-- Rubrics View -->
						<div x-show="view == 'rubrics'">
							<div class="flex items-center justify-between mb-3">
								@button.Button(button.Props{
									Size:    button.SizeSm,
									Variant: button.VariantOutline,
									Attributes: templ.Attributes{
										"@click": "view = 'runs'",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-3.5 me-1.5"})
									{ i18n.T(ctx, "Back") }
								}
								@button.Button(button.Props{
									Size: button.SizeSm,
									Attributes: templ.Attributes{
										"@click": "showRubricForm = true; rubricForm = {name:'', description:'', levels:[{score:1,description:''},{score:3,description:''},{score:5,description:''}]}",
									},
								}) {
									@icon.Plus(icon.Props{Class: "size-3.5 me-1.5"})
									{ i18n.T(ctx, "New Rubric") }
								}
							</div>
							<template x-for="r in rubrics" :key="r.id">
								<div class="p-3 rounded-lg border border-border/60 mb-2">
									<p class="text-sm font-medium" x-text="r.name"></p>
									<p class="text-xs text-muted-foreground" x-show="r.description" x-text="r.description"></p>
								</div>
							</template>
							<div x-show="showRubricForm" class="mt-3 p-3 rounded-lg border border-border/60 bg-muted/30 space-y-2">
								<input type="text" x-model="rubricForm.name" placeholder="Name" class="w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm" />
								<textarea x-model="rubricForm.description" placeholder="Description" rows="2" class="w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm resize-none"></textarea>
								<div class="flex gap-2">
									@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"@click": "showRubricForm = false"}}) {
										{ i18n.T(ctx, "Cancel") }
									}
									@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"@click": "createRubric()", ":disabled": "!rubricForm.name || creatingRubric"}}) {
										<span x-show="!creatingRubric">{ i18n.T(ctx, "Create") }</span>
										<span x-show="creatingRubric" class="flex items-center gap-1">
											<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
											{ i18n.T(ctx, "Creating...") }
										</span>
									}
								</div>
							</div>
						</div>
					</div>
					@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
						<div class="flex items-center justify-between w-full">
							<span class="text-xs text-muted-foreground" x-text="runs.length + ' evaluation runs'"></span>
							@dialog.Close() {
								@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
									{ i18n.T(ctx, "Close") }
								}
							}
						</div>
					}
				</div>
			}
		}
	</div>
}

templ EvaluationButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "evaluation-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-evaluation-dialog')",
				"title":  i18n.T(ctx, "Evaluation"),
			},
		}) {
			@icon.ChartBar(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Evaluation") }</span>
		}
	}
}

templ EvaluationScript() {
	@dialog.Script()
}
