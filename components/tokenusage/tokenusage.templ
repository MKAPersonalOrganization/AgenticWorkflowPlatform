package tokenusage

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
)

templ TokenUsage() {
	<div
		x-show="tokenUsage"
		x-cloak
		x-data="{ tokenUsageExpanded: false }"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 transform translate-y-1"
		x-transition:enter-end="opacity-100 transform translate-y-0"
		class="my-2 w-full"
	>
		<!-- Compact View -->
		<div
			x-show="!tokenUsageExpanded"
			class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-muted/30 border border-primary/10 hover:border-primary/20 transition-colors group"
		>
			<div class="flex items-center gap-3 min-w-0 flex-1">
				<!-- Icon -->
				<svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
					<path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
				</svg>
				<!-- Compact Info -->
				<div class="flex items-center gap-2 flex-wrap text-xs">
					<span class="font-semibold text-primary" x-text="formatNumber(tokenUsage?.total || 0)"></span>
					<span class="text-muted-foreground">{ i18n.T(ctx, "tokens") }</span>
					<span class="text-muted-foreground">•</span>
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] font-mono px-1.5 py-0 h-4"}) {
						<span x-text="tokenUsage?.provider || 'N/A'"></span>
					}
					<!-- Cached indicator -->
					<template x-if="tokenUsage?.cached > 0">
						<div class="flex items-center gap-1 text-green-600 dark:text-green-400">
							<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
								<path d="M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z"></path>
								<path d="M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z"></path>
								<path d="M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z"></path>
							</svg>
							<span x-text="formatNumber(tokenUsage?.cached || 0)"></span>
						</div>
					</template>
				</div>
			</div>
			<!-- Expand Button -->
			@button.Button(button.Props{
				Type:    button.TypeButton,
				Variant: button.VariantGhost,
				Size:    button.SizeIcon,
				Class:   "size-6 h-6 w-6 flex-shrink-0 opacity-60 group-hover:opacity-100 transition-opacity",
				Attributes: templ.Attributes{
					"@click":     "tokenUsageExpanded = true",
					"aria-label": "Expand token usage details",
					"title":      "Show details",
				},
			}) {
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			}
		</div>
		<!-- Expanded View -->
		<div
			x-show="tokenUsageExpanded"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 transform scale-95"
			x-transition:enter-end="opacity-100 transform scale-100"
			class="p-3 rounded-lg bg-muted/30 border border-primary/10"
		>
			<!-- Header with collapse button -->
			<div class="flex items-center justify-between mb-3">
				<div class="flex items-center gap-2">
					<svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
						<path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
					</svg>
					<span class="text-sm font-semibold">{ i18n.T(ctx, "Token Usage") }</span>
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] font-mono px-1.5 py-0 h-4"}) {
						<span x-text="tokenUsage?.provider || 'N/A'"></span>
					}
				</div>
				@button.Button(button.Props{
					Type:    button.TypeButton,
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "size-6 h-6 w-6",
					Attributes: templ.Attributes{
						"@click":     "tokenUsageExpanded = false",
						"aria-label": "Collapse token usage details",
						"title":      "Collapse",
					},
				}) {
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
					</svg>
				}
			</div>
			<!-- Model Info -->
			<div class="text-xs text-muted-foreground mb-3 truncate" :title="tokenUsage?.model">
				<span x-text="`Model: ${tokenUsage?.model || 'N/A'}`"></span>
			</div>
			<!-- Token Metrics Grid -->
			<div class="grid grid-cols-3 gap-2">
				<!-- Total Tokens -->
				<div class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide">{ i18n.T(ctx, "Total") }</span>
					<span class="text-base font-bold text-primary" x-text="formatNumber(tokenUsage?.total || 0)"></span>
				</div>
				<!-- Prompt Tokens -->
				<div class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide">{ i18n.T(ctx, "Prompt") }</span>
					<span class="text-base font-semibold" x-text="formatNumber(tokenUsage?.prompt || 0)"></span>
				</div>
				<!-- Completion Tokens -->
				<div class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide">{ i18n.T(ctx, "Output") }</span>
					<span class="text-base font-semibold" x-text="formatNumber(tokenUsage?.completion || 0)"></span>
				</div>
				<!-- Cached Tokens -->
				<div x-show="tokenUsage?.cached > 0" class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide flex items-center gap-1">
						<svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
							<path d="M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z"></path>
							<path d="M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z"></path>
							<path d="M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z"></path>
						</svg>
						<span>{ i18n.T(ctx, "Cached") }</span>
					</span>
					<span class="text-base font-semibold text-green-600 dark:text-green-400" x-text="formatNumber(tokenUsage?.cached || 0)"></span>
				</div>
				<!-- Reasoning Tokens -->
				<div x-show="tokenUsage?.reasoning > 0" class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide">{ i18n.T(ctx, "Reasoning") }</span>
					<span class="text-base font-semibold" x-text="formatNumber(tokenUsage?.reasoning || 0)"></span>
				</div>
				<!-- Audio Input -->
				<div x-show="tokenUsage?.audioInput > 0" class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide">{ i18n.T(ctx, "Audio In") }</span>
					<span class="text-base font-semibold" x-text="formatNumber(tokenUsage?.audioInput || 0)"></span>
				</div>
				<!-- Audio Output -->
				<div x-show="tokenUsage?.audioOutput > 0" class="flex flex-col gap-0.5 p-2 rounded-md bg-background/50">
					<span class="text-[10px] text-muted-foreground uppercase tracking-wide">{ i18n.T(ctx, "Audio Out") }</span>
					<span class="text-base font-semibold" x-text="formatNumber(tokenUsage?.audioOutput || 0)"></span>
				</div>
			</div>
		</div>
	</div>
}

templ TokenCounter() {
	<div
		x-show="tokenUsage && tokenUsage.total > 0"
		x-cloak
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-muted/40 border border-border/40 text-[10px] text-muted-foreground select-none pointer-events-none"
	>
		<svg class="w-3 h-3 opacity-70" fill="currentColor" viewBox="0 0 20 20">
			<path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
		</svg>
		<span class="font-mono font-medium" x-text="formatNumber(tokenUsage?.total || 0)"></span>
		<span class="opacity-70">{ i18n.T(ctx, "tokens") }</span>
	</div>
}
