package a2acomp

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
)

// A2ADialog renders the main A2A Agents management dialog.
// Opened from the left navbar via the A2A icon button.
templ A2ADialog() {
	<div
		x-data="a2aConnectors"
		@open-a2a-dialog.window="open()"
	>
		@dialog.Dialog(dialog.Props{
			ID: "a2a-agents-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "sm:max-w-4xl max-h-[90vh] flex flex-col p-0 overflow-hidden",
			}) {
				<!-- Main View (list) -->
				<template x-if="!detailItem">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-center justify-between mb-1">
								<div>
									@dialog.Title() {
										<div class="flex items-center gap-2">
											@icon.A2ALogo("size-5 text-primary")
											{ i18n.T(ctx, "A2A Agents") }
										</div>
									}
									@dialog.Description() {
										{ i18n.T(ctx, "Connect to remote AI agents via the Agent-to-Agent (A2A) protocol.") }
									}
								</div>
							</div>
						}
						<!-- Search + Add bar -->
						<div class="px-4 pt-3 pb-2 flex items-center gap-2">
							<div class="flex-1">
								@input.Input(input.Props{
									Type:        input.TypeSearch,
									Placeholder: i18n.T(ctx, "Search A2A agents..."),
									Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
									Attributes: templ.Attributes{
										"x-model.debounce.300ms": "search",
									},
								})
							</div>
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantDefault,
								Class:   "gap-1.5 shrink-0",
								Attributes: templ.Attributes{
									"@click": "openAddDialog()",
								},
							}) {
								@icon.Plus(icon.Props{Class: "size-4"})
								{ i18n.T(ctx, "Add Agent") }
							}
						</div>
						<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
							<!-- Loading skeleton -->
							<template x-if="loading && connectors.length === 0">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<template x-for="i in 4" :key="i">
										<div class="p-4 rounded-lg border border-border animate-pulse">
											<div class="flex items-center gap-3 mb-3">
												<div class="size-10 rounded-lg bg-muted"></div>
												<div class="flex-1 space-y-2">
													<div class="h-4 bg-muted rounded w-2/3"></div>
													<div class="h-3 bg-muted rounded w-1/3"></div>
												</div>
											</div>
											<div class="h-3 bg-muted rounded w-full mb-2"></div>
											<div class="h-3 bg-muted rounded w-4/5"></div>
										</div>
									</template>
								</div>
							</template>
							<!-- Empty state -->
							<template x-if="!loading && connectors.length === 0">
								<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
									@icon.A2ALogo("size-12 opacity-20")
									<p class="text-sm font-medium">{ i18n.T(ctx, "No A2A agents connected") }</p>
									<p class="text-xs">{ i18n.T(ctx, "Connect to remote AI agents that support the A2A protocol.") }</p>
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantOutline,
										Class:   "mt-3 gap-1.5",
										Attributes: templ.Attributes{
											"@click": "openAddDialog()",
										},
									}) {
										@icon.Plus(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "Add A2A Agent") }
									}
								</div>
							</template>
							<!-- No search results -->
							<template x-if="!loading && filteredConnectors.length === 0 && connectors.length > 0">
								<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
									@icon.SearchX(icon.Props{Class: "size-12 opacity-20"})
									<p class="text-sm font-medium">{ i18n.T(ctx, "No agents match your search") }</p>
									<p class="text-xs">{ i18n.T(ctx, "Try a different search term.") }</p>
								</div>
							</template>
							<!-- Connector cards (2-col grid) -->
							<template x-if="!loading && filteredConnectors.length > 0">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									@A2AConnectorCard()
								</div>
							</template>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<span class="text-xs text-muted-foreground">
									<span x-text="connectors.length"></span> { i18n.T(ctx, "agents") } ·
									<span x-text="totalSkills"></span> { i18n.T(ctx, "skills") }
								</span>
								@dialog.Close() {
									@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
										{ i18n.T(ctx, "Close") }
									}
								}
							</div>
						}
					</div>
				</template>
				<!-- ═══════ Detail View ═══════ -->
				<template x-if="detailItem">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-start gap-4">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-8 shrink-0",
									Attributes: templ.Attributes{
										"@click": "closeDetail()",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								<!-- Icon -->
								<div class="size-11 rounded-lg bg-violet-500/10 flex items-center justify-center text-violet-500 shrink-0">
									@icon.A2ALogo("size-5")
								</div>
								<div class="flex-1 min-w-0">
									@dialog.Title(dialog.TitleProps{Class: "flex items-center gap-2"}) {
										<span x-text="detailItem.title"></span>
										<span
											class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
											:class="{
												'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400': detailItem.status === 'connected',
												'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400': detailItem.status === 'discovering',
												'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400': detailItem.status === 'error',
												'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300': detailItem.status === 'disconnected' || detailItem.status === 'created'
											}"
											x-text="detailItem.status.replace('_', ' ')"
										></span>
									}
									@dialog.Description(dialog.DescriptionProps{}) {
										<span x-text="detailItem.agent_description || detailItem.agent_url"></span>
									}
								</div>
							</div>
						}
						<!-- Info bar -->
						<div class="px-4 py-2.5 border-b border-border bg-muted/50">
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-3 text-xs text-muted-foreground">
									<span class="flex items-center gap-1.5">
										@icon.Sparkles(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="detailSkills.length"></span> { i18n.T(ctx, "skills") }
									</span>
									<template x-if="detailItem.agent_name">
										<span class="flex items-center gap-1.5">
											<span class="text-border">|</span>
											@icon.A2ALogo("size-3 opacity-60")
											<span x-text="detailItem.agent_name"></span>
											<template x-if="detailItem.agent_version">
												<span x-text="'v' + detailItem.agent_version" class="text-muted-foreground/60"></span>
											</template>
										</span>
									</template>
								</div>
								<!-- Connect/disconnect actions -->
								<div class="flex items-center gap-2">
									<template x-if="detailItem.status === 'connected'">
										<button
											@click="disconnect(detailItem.id)"
											class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-destructive/10 text-destructive hover:bg-destructive/20 border border-destructive/20 transition-colors"
										>
											@icon.Unplug(icon.Props{Class: "size-3.5"})
											{ i18n.T(ctx, "Disconnect") }
										</button>
									</template>
									<template x-if="detailItem.status !== 'connected' && detailItem.status !== 'discovering'">
										<button
											@click="connectAgent(detailItem.id)"
											class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
										>
											@icon.Plug(icon.Props{Class: "size-3.5"})
											{ i18n.T(ctx, "Connect") }
										</button>
									</template>
								</div>
							</div>
						</div>
						<!-- Scrollable content -->
						<div class="flex-1 overflow-y-auto scrollbar-thin p-4">
							<div class="space-y-5">
								<!-- Description -->
								<template x-if="detailItem.agent_description">
									<p x-text="detailItem.agent_description" class="text-sm text-muted-foreground leading-relaxed"></p>
								</template>
								<!-- Error message -->
								<template x-if="detailItem.error_msg">
									<div class="rounded-md bg-destructive/10 border border-destructive/20 p-3">
										<p class="text-xs text-destructive flex items-start gap-1.5">
											@icon.CircleAlert(icon.Props{Class: "size-3.5 shrink-0 mt-0.5"})
											<span x-text="detailItem.error_msg"></span>
										</p>
									</div>
								</template>
								<!-- Skills list -->
								<template x-if="detailSkills.length > 0">
									<div>
										<div class="flex items-center gap-2 mb-2.5">
											@icon.Sparkles(icon.Props{Class: "size-4 text-muted-foreground"})
											<h4 class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Agent Skills") }</h4>
										</div>
										<div class="space-y-2">
											<template x-for="skill in detailSkills" :key="skill.id">
												<div class="border border-border rounded-lg p-3 border-s-[3px] border-s-violet-500 bg-card">
													<div class="flex items-center gap-2 mb-1">
														<span class="text-xs font-semibold text-foreground" x-text="skill.name"></span>
														<template x-for="tag in (skill.tags || [])" :key="tag">
															<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-accent text-muted-foreground" x-text="tag"></span>
														</template>
													</div>
													<p class="text-xs text-muted-foreground leading-relaxed" x-text="skill.description"></p>
													<template x-if="skill.examples && skill.examples.length > 0">
														<div class="mt-2 space-y-1">
															<template x-for="ex in skill.examples" :key="ex">
																<p class="text-[11px] text-muted-foreground/70 italic" x-text="ex"></p>
															</template>
														</div>
													</template>
												</div>
											</template>
										</div>
									</div>
								</template>
								<!-- Empty skills -->
								<template x-if="detailSkills.length === 0">
									<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
										@icon.PackageOpen(icon.Props{Class: "size-10 opacity-20"})
										<p class="text-sm">{ i18n.T(ctx, "No skills discovered yet. Connect to the agent to discover skills.") }</p>
									</div>
								</template>
								<!-- Metadata -->
								<div class="border-t border-border pt-4 grid grid-cols-2 gap-3">
									<div>
										<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Agent URL") }</div>
										<div class="text-xs text-foreground flex items-center gap-1.5 truncate">
											@icon.Globe(icon.Props{Class: "size-3 text-muted-foreground shrink-0"})
											<span x-text="detailItem.agent_url" class="truncate"></span>
										</div>
									</div>
									<div>
										<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "ID") }</div>
										<code class="text-[11px] bg-muted px-1.5 py-0.5 rounded font-mono break-all" x-text="detailItem.id"></code>
									</div>
								</div>
							</div>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<div class="flex items-center gap-3 text-xs text-muted-foreground">
									<span class="flex items-center gap-1.5">
										@icon.Sparkles(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="detailSkills.length"></span> { i18n.T(ctx, "skills") }
									</span>
								</div>
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "closeDetail()",
									},
								}) {
									{ i18n.T(ctx, "Back") }
								}
							</div>
						}
					</div>
				</template>
			}
		}
		<!-- Add Agent Dialog (nested) -->
		@A2AAddDialog()
	</div>
}

// A2AConnectorCard renders A2A connector cards in the 2-column grid.
templ A2AConnectorCard() {
	<template x-for="conn in filteredConnectors" :key="conn.id">
		<div
			class="group p-4 rounded-lg border border-border hover:border-violet-500/30 hover:bg-accent/30 transition-all duration-150 cursor-pointer flex flex-col"
			@click="openDetail(conn)"
		>
			<div class="flex items-start gap-3 mb-2">
				<div class="relative">
					<div class="size-10 rounded-lg flex items-center justify-center shrink-0 bg-violet-500/10 text-violet-500">
						@icon.A2ALogo("size-5")
					</div>
					<span
						class="absolute -bottom-0.5 -end-0.5 size-2.5 rounded-full border-2 border-background"
						:class="{
							'bg-emerald-500': conn.status === 'connected',
							'bg-yellow-500 animate-pulse': conn.status === 'discovering',
							'bg-red-500': conn.status === 'error',
							'bg-gray-400': conn.status === 'created' || conn.status === 'disconnected'
						}"
					></span>
				</div>
				<div class="flex-1 min-w-0">
					<h3 class="text-sm font-semibold text-foreground truncate" x-text="conn.title"></h3>
					<span class="text-[10px] text-muted-foreground" x-text="conn.status.replace('_', ' ')"></span>
				</div>
			</div>
			<p class="text-xs text-muted-foreground line-clamp-2 mb-3 flex-1" x-text="conn.agent_description || conn.agent_url"></p>
			<div class="flex items-center justify-between mt-auto">
				<span class="text-[10px] text-muted-foreground/60 tabular-nums" x-text="conn.skill_count + ' skills'"></span>
				<div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
					<template x-if="conn.status === 'connected'">
						<button
							@click.stop="disconnect(conn.id)"
							class="p-1.5 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							title="Disconnect"
						>
							@icon.Unplug(icon.Props{Class: "size-3.5"})
						</button>
					</template>
					<template x-if="conn.status !== 'connected' && conn.status !== 'discovering'">
						<button
							@click.stop="connectAgent(conn.id)"
							class="p-1.5 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							title="Connect"
						>
							@icon.Plug(icon.Props{Class: "size-3.5"})
						</button>
					</template>
					<button
						@click.stop="remove(conn.id)"
						class="p-1.5 rounded-md hover:bg-accent text-muted-foreground hover:text-destructive transition-colors"
						title="Remove"
					>
						@icon.Trash2(icon.Props{Class: "size-3.5"})
					</button>
				</div>
			</div>
		</div>
	</template>
}

// A2AButtonTrigger renders the navbar icon button for the A2A dialog.
templ A2AButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "a2a-agents-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-a2a-dialog')",
				"title":  i18n.T(ctx, "A2A Agents"),
			},
		}) {
			@icon.A2ALogo("size-5")
			<span class="sr-only">{ i18n.T(ctx, "A2A Agents") }</span>
		}
	}
}
