package a2acomp

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

// A2AAddDialog renders the "Add A2A Agent" modal dialog.
templ A2AAddDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "a2a-add-dialog",
	}) {
		@dialog.Content(dialog.ContentProps{
			Class: "sm:max-w-lg",
		}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					<div class="flex items-center gap-2">
						@icon.Waypoints(icon.Props{Class: "size-5 text-violet-500"})
						{ i18n.T(ctx, "Add A2A Agent") }
					</div>
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ i18n.T(ctx, "Connect to a remote AI agent that supports the A2A protocol.") }
				}
			}
			<div class="space-y-4 px-6 py-4">
				<!-- Agent URL -->
				<div>
					<label for="a2a-url" class="text-sm font-medium text-foreground mb-1.5 block">
						{ i18n.T(ctx, "Agent URL") }
						<span class="text-destructive">*</span>
					</label>
					<input
						id="a2a-url"
						type="url"
						x-model="newUrl"
						placeholder="https://agent.example.com"
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						@keydown.enter="addConnector()"
					/>
					<p class="text-xs text-muted-foreground mt-1">
						{ i18n.T(ctx, "The base URL of the A2A-compatible agent. The agent card will be discovered at /.well-known/agent-card.json") }
					</p>
				</div>
				<!-- Display Name -->
				<div>
					<label for="a2a-title" class="text-sm font-medium text-foreground mb-1.5 block">
						{ i18n.T(ctx, "Display Name") }
					</label>
					<input
						id="a2a-title"
						type="text"
						x-model="newTitle"
						placeholder="Science Tutor Agent"
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
					/>
				</div>
				<!-- Advanced Options (collapsible) -->
				<details class="group">
					<summary class="text-xs font-medium text-muted-foreground cursor-pointer hover:text-foreground transition-colors flex items-center gap-1">
						@icon.ChevronRight(icon.Props{Class: "size-3 transition-transform group-open:rotate-90"})
						{ i18n.T(ctx, "Authentication") }
					</summary>
					<div class="mt-3 space-y-3 ps-4 border-s-2 border-border">
						<div>
							<label for="a2a-auth-type" class="text-xs font-medium text-foreground mb-1 block">
								{ i18n.T(ctx, "Auth Type") }
							</label>
							<select
								id="a2a-auth-type"
								x-model="newAuthType"
								class="w-full rounded-md border border-input bg-background px-3 py-2 text-xs ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							>
								<option value="none">{ i18n.T(ctx, "None") }</option>
								<option value="bearer">{ i18n.T(ctx, "Bearer Token") }</option>
								<option value="api_key">{ i18n.T(ctx, "API Key") }</option>
								<option value="custom_header">{ i18n.T(ctx, "Custom Header") }</option>
							</select>
						</div>
						<template x-if="newAuthType !== 'none'">
							<div class="space-y-3">
								<template x-if="newAuthType === 'custom_header' || newAuthType === 'api_key'">
									<div>
										<label for="a2a-auth-header" class="text-xs font-medium text-foreground mb-1 block">
											{ i18n.T(ctx, "Header Name") }
										</label>
										<input
											id="a2a-auth-header"
											type="text"
											x-model="newAuthHeader"
											placeholder="X-API-Key"
											class="w-full rounded-md border border-input bg-background px-3 py-2 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
										/>
									</div>
								</template>
								<div>
									<label for="a2a-auth-token" class="text-xs font-medium text-foreground mb-1 block">
										<template x-if="newAuthType === 'bearer'">
											<span>{ i18n.T(ctx, "Bearer Token") }</span>
										</template>
										<template x-if="newAuthType !== 'bearer'">
											<span>{ i18n.T(ctx, "Token / Secret") }</span>
										</template>
									</label>
									<input
										id="a2a-auth-token"
										type="password"
										x-model="newAuthToken"
										placeholder=""
										class="w-full rounded-md border border-input bg-background px-3 py-2 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
									/>
								</div>
							</div>
						</template>
						<p class="text-xs text-muted-foreground">
							{ i18n.T(ctx, "Authentication credentials for accessing the remote agent. Used for both agent card discovery and task execution.") }
						</p>
					</div>
				</details>
				<!-- Error display -->
				<div x-show="error" x-cloak class="rounded-md bg-destructive/10 border border-destructive/20 p-3">
					<p class="text-xs text-destructive flex items-center gap-1.5">
						@icon.CircleAlert(icon.Props{Class: "size-3.5 shrink-0"})
						<span x-text="error"></span>
					</p>
				</div>
			</div>
			@dialog.Footer(dialog.FooterProps{}) {
				@dialog.Close(dialog.CloseProps{For: "a2a-add-dialog"}) {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Class:   "h-9 px-4",
					}) {
						{ i18n.T(ctx, "Cancel") }
					}
				}
				@button.Button(button.Props{
					Class: "h-9 px-4",
					Attributes: templ.Attributes{
						"@click":    "addConnector()",
						":disabled": "addLoading || !newUrl",
					},
				}) {
					<span x-show="!addLoading" class="flex items-center gap-1.5">
						@icon.Plug(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "Connect") }
					</span>
					<span x-show="addLoading" class="flex items-center gap-1.5">
						@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin"})
						{ i18n.T(ctx, "Discovering...") }
					</span>
				}
			}
		}
	}
}
