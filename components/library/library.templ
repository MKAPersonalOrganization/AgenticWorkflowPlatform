package library

import (
	"school-with-ai/components/card"
)

templ Library() {
	<div class="w-full">
		@card.Card(card.Props{Class: "border-0 shadow-none bg-transparent overflow-visible"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				<!-- Breadcrumbs -->
				<div class="px-4 py-3 flex items-center gap-2 text-xs text-muted-foreground border-b bg-muted/5">
                    <svg class="w-4 h-4 text-muted-foreground/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    <span class="font-medium">Library</span>
                    <template x-for="(segment, index) in (message.parsedArgs?.path || '').split('/').filter(Boolean)">
                        <div class="flex items-center gap-2">
                            <svg class="w-3 h-3 text-muted-foreground/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                            <span class="font-medium text-foreground bg-secondary/50 px-1.5 py-0.5 rounded text-[11px]" x-text="segment"></span>
                        </div>
                    </template>
				</div>
				<div class="divide-y divide-border/40 border-b border-border/40">
					<template x-for="(node, nIndex) in message.parsedResult?.nodes" :key="nIndex">
						<div 
							class="flex items-center gap-4 py-3 px-2 hover:bg-muted/30 transition-all group/node cursor-default"
						>
							<!-- Elegant Icon based on type -->
							<div class="shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-muted/50 text-muted-foreground group-hover/node:bg-primary/10 group-hover/node:text-primary transition-colors">
								<template x-if="node.type === 'grade'">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
									</svg>
								</template>
								<template x-if="node.type === 'book'">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
									</svg>
								</template>
								<template x-if="node.type === 'chapter' || node.type.startsWith('heading-')">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
									</svg>
								</template>
								<template x-if="!['grade', 'book', 'chapter'].includes(node.type) && !node.type.startsWith('heading-')">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
									</svg>
								</template>
							</div>

							<div class="flex-1 min-w-0 flex items-center justify-between">
								<div>
									<p class="text-sm font-medium text-foreground tracking-tight group-hover/node:text-primary transition-colors" x-text="node.name"></p>
									<p class="text-[10px] text-muted-foreground/70 uppercase tracking-widest font-semibold mt-0.5" x-text="node.type"></p>
								</div>
								<div class="opacity-0 group-hover/node:opacity-100 transition-opacity">
									<svg class="w-4 h-4 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
									</svg>
								</div>
							</div>
						</div>
					</template>
				</div>
				<template x-if="!message.parsedResult?.nodes || message.parsedResult.nodes.length === 0">
					<div class="flex flex-col items-center justify-center py-10 text-muted-foreground/50 border-y border-dashed">
						<svg class="w-6 h-6 mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
						</svg>
						<span class="text-[11px] font-medium tracking-wide uppercase">No resources found</span>
					</div>
				</template>
			}
		}
	</div>
}
