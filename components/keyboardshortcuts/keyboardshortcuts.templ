package keyboardshortcuts

import "school-with-ai/components/dialog"

templ KeyboardShortcuts() {
	<!-- Keyboard Shortcuts Dialog -->
	@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl", HideCloseButton: true}) {
		@dialog.Header(dialog.HeaderProps{}) {
			@dialog.Title(dialog.TitleProps{}) {
				<div class="flex items-center gap-2">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
					</svg>
					Keyboard Shortcuts
				</div>
			}
			@dialog.Description(dialog.DescriptionProps{}) {
				Navigate and control the chat interface faster with these shortcuts
			}
		}
		<!-- Shortcuts Grid -->
		<div class="space-y-6 py-4">
			<!-- General -->
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-3 flex items-center gap-2">
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
					</svg>
					General
				</h3>
				<div class="space-y-2">
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">Show this help dialog</span>
						<div class="flex items-center gap-1">
							<kbd class="kbd">?</kbd>
							<span class="text-xs text-muted-foreground px-1">or</span>
							<kbd class="kbd">Ctrl</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">/</kbd>
						</div>
					</div>
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">Close dialog or cancel streaming</span>
						<kbd class="kbd">Esc</kbd>
					</div>
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">Focus message input</span>
						<div class="flex items-center gap-1">
							<kbd class="kbd">Ctrl</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">K</kbd>
						</div>
					</div>
				</div>
			</div>
			<!-- Chat Management -->
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-3 flex items-center gap-2">
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
						<path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
						<path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"></path>
					</svg>
					Chat Management
				</h3>
				<div class="space-y-2">
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">New chat session</span>
						<div class="flex items-center gap-1">
							<kbd class="kbd">Ctrl</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">Shift</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">N</kbd>
						</div>
					</div>
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">Navigate through sessions</span>
						<div class="flex items-center gap-1">
							<kbd class="kbd">Ctrl</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">↑</kbd>
							<span class="text-xs text-muted-foreground">/</span>
							<kbd class="kbd">↓</kbd>
						</div>
					</div>
				</div>
			</div>
			<!-- View Controls -->
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-3 flex items-center gap-2">
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
						<path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
						<path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path>
					</svg>
					View Controls
				</h3>
				<div class="space-y-2">
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">Toggle debug panel</span>
						<div class="flex items-center gap-1">
							<kbd class="kbd">Ctrl</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">Shift</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">E</kbd>
						</div>
					</div>
					<div class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-muted/50 transition-colors">
						<span class="text-sm">Cycle theme (Light → Dark → System)</span>
						<div class="flex items-center gap-1">
							<kbd class="kbd">Ctrl</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">Shift</kbd>
							<span class="text-xs text-muted-foreground">+</span>
							<kbd class="kbd">T</kbd>
						</div>
					</div>
				</div>
			</div>
			<!-- Tips -->
			<div class="border-t pt-4">
				<div class="flex items-start gap-3 p-3 bg-muted/30 rounded-lg">
					<svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
					</svg>
					<div class="space-y-1">
						<p class="text-sm font-medium">Pro Tip</p>
						<p class="text-xs text-muted-foreground">On macOS, use <kbd class="kbd text-xs">⌘</kbd> instead of <kbd class="kbd text-xs">Ctrl</kbd></p>
					</div>
				</div>
			</div>
		</div>
		@dialog.Footer(dialog.FooterProps{}) {
			<div class="flex justify-end">
				<button
					@click="showKeyboardShortcuts = false"
					class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
					type="button"
				>
					Got it!
				</button>
			</div>
		}
	}
}
