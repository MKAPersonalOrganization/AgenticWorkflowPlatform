package chat

import "school-with-ai/components/icon"
import "school-with-ai/components/button"
import "school-with-ai/components/i18n"

// Header renders the desktop chat header with action buttons.
templ Header() {
	<div class="absolute top-0 z-10 hidden md:flex h-14 w-full items-center justify-between bg-gradient-to-b from-background via-background/70 to-transparent p-2 font-semibold">
		<div class="flex items-center gap-2">
			<!-- Logo -->
			<div class="flex items-center gap-3">
				<div class="h-8 w-8 flex items-center justify-center bg-primary text-primary-foreground rounded-full">
					<div class="compass-spin">
						<svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<!-- Outer ring -->
							<circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1.5" fill="none"></circle>
							<!-- Cardinal points -->
							<line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
							<line x1="30" y1="16" x2="26" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
							<line x1="16" y1="30" x2="16" y2="26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
							<line x1="2" y1="16" x2="6" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
							<!-- Needle -->
							<path d="M16 8 L18.5 14 L16 13 L13.5 14 Z" fill="currentColor"></path>
							<path d="M16 24 L13.5 18 L16 19 L18.5 18 Z" fill="currentColor" opacity="0.6"></path>
							<!-- Center dot -->
							<circle cx="16" cy="16" r="1.5" fill="currentColor"></circle>
						</svg>
					</div>
				</div>
			</div>
		</div>
		<div class="flex items-center gap-2">
			<!-- Right Side Actions -->
			<!-- New Chat -->
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-accent/50 rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
				Attributes: templ.Attributes{
					"@click": "createNewSession()",
					"title":  i18n.T(ctx, "New Chat"),
				},
			}) {
				@icon.SquarePen(icon.Props{Class: "size-5"})
			}
			<!-- Search Toggle -->
			<div x-show="hasMessages" x-transition.opacity>
				@Search()
			</div>
			<!-- Artifacts Toggle -->
			@ArtifactsToggle()
		</div>
	</div>
}
