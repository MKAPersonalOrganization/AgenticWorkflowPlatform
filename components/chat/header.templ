package chat

import "aicompass/components/icon"
import "aicompass/components/button"
import "aicompass/components/i18n"

// Header renders the desktop chat header with action buttons.
templ Header() {
	<div class="absolute top-0 z-10 hidden md:flex h-14 w-full items-center justify-between bg-linear-to-b from-background via-background/80 to-transparent backdrop-blur-[2px] p-2 font-semibold">
		<div class="flex items-center gap-2"></div>
		<div class="flex items-center gap-2">
			<!-- Right Side Actions -->
			<!-- New Chat -->
			<div x-show="hasMessages || isStreaming" x-cloak>
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-accent/60 rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
					Attributes: templ.Attributes{
						"@click": "createNewSession()",
						"title":  i18n.T(ctx, "New Chat"),
					},
				}) {
					@icon.SquarePen(icon.Props{Class: "size-5"})
				}
			</div>
			<!-- Search Toggle -->
			<div x-show="hasMessages" x-cloak x-transition.opacity>
				@Search()
			</div>
			<!-- Debug Panel Toggle -->
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-accent/60 rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
				Attributes: templ.Attributes{
					"@click":  "toggleDebugPanel()",
					"title":   i18n.T(ctx, "Toggle Debugger (Ctrl+Shift+D)"),
					":class":  "showDebugPanel ? 'text-primary bg-accent/40' : ''",
				},
			}) {
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
					<path d="m18 16 4-4-4-4"></path>
					<path d="m6 8-4 4 4 4"></path>
					<path d="m14.5 4-5 16"></path>
				</svg>
			}
			<!-- Artifacts Toggle -->
			@ArtifactsToggle()
		</div>
	</div>
}
