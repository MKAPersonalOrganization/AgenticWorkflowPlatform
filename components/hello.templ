package components

import "school-with-ai/components/input"
import "school-with-ai/components/chatinput"
import "school-with-ai/components/threadhistory"
import "school-with-ai/components/messagelist"
import "school-with-ai/components/eventlog"
import "school-with-ai/components/collapsible"
import "school-with-ai/components/button"
import "school-with-ai/components/tooltip"
import "school-with-ai/components/popover"
import "school-with-ai/components/textarea"

templ ChatInputScreen() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Chat</title>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/chat.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			@input.Script()
			@collapsible.Script()
			@popover.Script()
			@textarea.Script()
		</head>
		<body class="flex min-h-screen bg-background text-foreground antialiased">
			<div class="flex w-full h-screen overflow-hidden" x-data="chat">
				<!-- Left Sidebar - Chat History -->
				@threadhistory.ThreadHistory()
				<!-- Main Content Area -->
				<main class="flex-1 flex flex-col relative">
					<!-- Sidebar Toggle -->
					@tooltip.Tooltip() {
						@tooltip.Trigger() {
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIcon,
								Class:      "absolute top-4 left-4 z-10 hidden lg:flex bg-card/80 backdrop-blur-sm shadow-sm",
								Attributes: templ.Attributes{"@click": "toggleSidebar()"},
							}) {
								<svg x-show="sidebarOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect width="18" height="18" x="3" y="3" rx="2"></rect>
									<path d="M15 3v18"></path>
									<path d="m8 9 3 3-3 3"></path>
								</svg>
								<svg x-show="!sidebarOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect width="18" height="18" x="3" y="3" rx="2"></rect>
									<path d="M9 3v18"></path>
									<path d="m16 15-3-3 3-3"></path>
								</svg>
							}
						}
						@tooltip.Content() {
							<span x-text="sidebarOpen ? 'Hide sidebar' : 'Show sidebar'"></span>
						}
					}
					<!-- Messages Container -->
					<div class="flex-1 overflow-y-auto scrollbar-thin" x-ref="messageList">
						<div x-show="messages.length === 0 && !isStreaming" class="h-full flex flex-col items-center justify-center">
							<div class="flex flex-col items-center gap-8 w-full max-w-3xl mx-auto px-4">
								<div class="flex flex-col items-center gap-4">
									<img src="/assets/images/logo.svg" alt="Logo" class="w-64 h-64 object-contain"/>
								</div> <!-- Centered Input Area -->
								<div class="w-full">
									@chatinput.ChatInput()
								</div>
							</div>
						</div>
						<!-- When messages exist: regular message list -->
						<div x-show="messages.length > 0 || isStreaming" class="max-w-3xl mx-auto px-4 py-6">
							<!-- New Chat Button -->
							<div class="flex justify-end mb-4">
								@button.Button(button.Props{
									Variant:    button.VariantDefault,
									Size:       button.SizeSm,
									Class:      "shadow-sm",
									Attributes: templ.Attributes{"@click": "createNewSession()"},
								}) {
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 5v14m-7-7h14"></path>
									</svg>
									<span>New chat</span>
								}
							</div>
							<!-- Messages -->
							@messagelist.MessageList()
						</div>
					</div>
					<!-- Input Area - Agent Chat UI Style (only show when messages exist) -->
					<div x-show="messages.length > 0 || isStreaming" class="sticky bottom-0 flex flex-col items-center gap-8 bg-background">
						<div class="mb-8 w-full">
							@chatinput.ChatInput()
						</div>
					</div>
					@eventlog.EventLog()
				</main>
			</div>
		</body>
	</html>
}
