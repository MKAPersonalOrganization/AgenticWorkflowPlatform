package components

import (
	"school-with-ai/components/button"
	"school-with-ai/components/card"
	"school-with-ai/components/input"
)

templ ChatInputScreen() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Chat</title>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/chat.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			@input.Script()
		</head>
		<body class="flex min-h-screen bg-background">
			<div class="flex w-full" x-data="chat">
				<!-- Sidebar for Session Management -->
				<div class="w-64 border-r border-border bg-card flex flex-col">
					<div class="p-4 border-b border-border">
						<h2 class="text-lg font-semibold mb-3">Sessions</h2>
						@button.Button(button.Props{
							Class: "w-full",
							Attributes: templ.Attributes{
								"@click": "createNewSession()",
							},
						}) {
							+ New Session
						}
					</div>
					<div class="flex-1 overflow-y-auto p-2">
						<template x-for="session in sessions" :key="session.id">
							<div class="group relative mb-1">
								<button
									class="w-full text-left px-3 py-2 rounded transition-colors text-sm"
									:class="session.id === threadId ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'"
									@click="switchSession(session.id)"
								>
									<div class="font-medium truncate pr-6" x-text="session.title"></div>
									<div class="text-xs opacity-70" x-text="formatSessionTime(session.lastMessage)"></div>
								</button>
								<button
									@click.stop="deleteSession(session.id)"
									class="absolute right-2 top-2 opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded hover:bg-destructive/10"
									:class="session.id === threadId ? 'text-primary-foreground hover:text-destructive' : 'text-muted-foreground hover:text-destructive'"
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 6h18"></path>
										<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
										<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
									</svg>
								</button>
							</div>
						</template>
						<div x-show="sessions.length === 0" class="text-center text-muted-foreground text-sm py-8">
							No sessions yet
						</div>
					</div>
				</div>
				<!-- Main Chat Area -->
				<div class="flex-1 flex justify-center items-center p-5" :class="showDebugPanel ? 'mr-64' : ''">
					<div class="w-full max-w-4xl h-[90vh]">
						@card.Card(card.Props{
							Class: "flex flex-col h-full",
						}) {
							@card.Header(card.HeaderProps{}) {
								<div class="flex items-center justify-between">
									<div>
										@card.Title(card.TitleProps{}) {
											Chat with AI Assistant
										}
										@card.Description(card.DescriptionProps{}) {
											Powered by AG-UI Protocol
										}
									</div>
									<button
										@click="showDebugPanel = !showDebugPanel"
										class="text-xs text-muted-foreground hover:text-foreground transition-colors px-2 py-1 rounded hover:bg-muted"
									>
										<span x-show="!showDebugPanel">Show Events</span>
										<span x-show="showDebugPanel">Hide Events</span>
									</button>
								</div>
							}
							@card.Content(card.ContentProps{
								Class: "flex-1 overflow-y-auto",
							}) {
						<div x-ref="messageList" class="space-y-4">
							<template x-for="message in messages" :key="message.id">
								<div class="flex gap-3 mb-4" :class="message.role === 'user' ? 'justify-end' : 'justify-start'">
									<div
										class="max-w-[80%] rounded-lg p-4"
										:class="message.role === 'user' ? 'bg-primary text-primary-foreground' : 'bg-muted'"
									>
										<div class="text-xs font-medium mb-1" :class="message.role === 'user' ? 'text-primary-foreground/70' : 'text-muted-foreground'">
											<span x-text="message.role === 'user' ? 'You' : 'Assistant'"></span>
											<span x-text="formatTime(message.timestamp)" class="ml-2"></span>
										</div>
										<div class="text-sm whitespace-pre-wrap" x-text="message.content"></div>
										<div x-show="message.streaming" class="text-xs mt-1 animate-pulse">●</div>
									</div>
								</div>
							</template>
							<!-- Typing Indicator -->
							<div x-show="showTypingIndicator" class="flex gap-3 mb-4 justify-start">
								<div class="max-w-[80%] rounded-lg p-4 bg-muted">
									<div class="text-xs font-medium mb-1 text-muted-foreground">
										Assistant
									</div>
									<div class="flex gap-1">
										<span class="w-2 h-2 bg-muted-foreground rounded-full animate-bounce" style="animation-delay: 0ms"></span>
										<span class="w-2 h-2 bg-muted-foreground rounded-full animate-bounce" style="animation-delay: 150ms"></span>
										<span class="w-2 h-2 bg-muted-foreground rounded-full animate-bounce" style="animation-delay: 300ms"></span>
									</div>
								</div>
							</div>
							<!-- Error Message -->
							<div x-show="errorMessage" class="flex gap-3 mb-4 p-4 rounded-lg bg-destructive/10 border border-destructive/20">
								<div class="flex-1">
									<div class="text-sm font-medium text-destructive mb-1">Error</div>
									<div class="text-sm text-destructive/90" x-text="errorMessage"></div>
								</div>
							</div>
							<div x-show="isStreaming && messages.length === 0 && !showTypingIndicator" class="text-center text-muted-foreground">
								Waiting for response...
							</div>
						</div>
					}
					@card.Footer(card.FooterProps{}) {
						<!-- Input Form -->
						<form @submit.prevent="sendMessage" class="flex gap-3 w-full">
							@input.Input(input.Props{
								Placeholder: "Type your message...",
								Attributes: templ.Attributes{
									"x-model":   "currentMessage",
									":disabled": "isStreaming",
								},
							})
							@button.Button(button.Props{
								Type: button.TypeSubmit,
								Attributes: templ.Attributes{
									":disabled": "isStreaming || !currentMessage.trim()",
								},
							}) {
								<span x-show="!isStreaming">Send</span>
								<span x-show="isStreaming">Sending...</span>
							}
						</form>
					}
						}
					</div>
				</div>
				<!-- Debug Sidebar (Right) -->
				<div
					x-show="showDebugPanel"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="translate-x-full"
					x-transition:enter-end="translate-x-0"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="translate-x-0"
					x-transition:leave-end="translate-x-full"
					class="fixed right-0 top-0 w-64 h-full border-l border-border bg-card flex flex-col"
				>
					<div class="p-4 border-b border-border">
						<div class="flex items-center justify-between mb-2">
							<h2 class="text-sm font-semibold">Debug Events</h2>
							<button
								@click="showDebugPanel = false"
								class="text-xs text-muted-foreground hover:text-foreground"
							>
								✕
							</button>
						</div>
						<p class="text-xs text-muted-foreground/70">AG-UI Protocol events</p>
					</div>
					<div class="flex-1 overflow-y-auto p-3">
						<div class="space-y-1 text-xs font-mono">
							<template x-for="event in events.slice().reverse()" :key="event.id">
								<div class="flex flex-col gap-1 p-2 rounded bg-muted/30 border border-muted-foreground/10">
									<div class="flex items-center justify-between">
										<span class="font-medium text-muted-foreground/90" x-text="event.type"></span>
										<span class="text-muted-foreground/50 text-[10px]" x-text="event.time"></span>
									</div>
									<div class="text-muted-foreground/70" x-text="event.details"></div>
								</div>
							</template>
							<div x-show="events.length === 0" class="text-center text-muted-foreground/50 py-8">
								No events yet
							</div>
						</div>
					</div>
					<div class="p-3 border-t border-border text-xs text-muted-foreground/60">
						<div class="flex items-center justify-between">
							<span>Total events:</span>
							<span x-text="events.length"></span>
						</div>
					</div>
				</div>
			</div>
		</body>
	</html>
}
