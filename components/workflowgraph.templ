package components

import "aicompass/components/icon"

templ WorkflowGraphPanel() {
    <div
        x-data="workflowGraphPanel"
        x-effect="handleWorkflowChange(isStreaming, activeWorkflowContext?.orchestratorId, selectedAgent, currentAgentData, activeWorkflowContext, AVAILABLE_AGENTS, completedNodes, failedNodes, workflowOutputs)"
        x-show="graph"
        x-cloak
        class="wf-panel absolute right-4 top-20 z-40 w-[320px] rounded-xl overflow-hidden border border-border/60 bg-background/97 backdrop-blur-xl shadow-modern-lg"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-x-6 scale-95"
        x-transition:enter-end="opacity-100 translate-x-0 scale-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-x-0 scale-100"
        x-transition:leave-end="opacity-0 translate-x-6 scale-95"
    >
        <!-- ── Status accent bar (top edge) ── -->
        <div
            class="h-[3px] w-full transition-all duration-500"
            :style="executionStatus === 'running'
                ? 'background: var(--panel-accent-bar)'
                : executionStatus === 'completed'
                    ? 'background: var(--panel-done-bar)'
                    : 'background: var(--border)'"
        ></div>

        <!-- ── Header ── -->
        <div class="flex items-center justify-between px-3 pt-2.5 pb-2 border-b border-border/50">
            <!-- Left: icon + agent name + subtitle -->
            <div class="flex items-center gap-2 min-w-0">
                <div
                    class="shrink-0 w-7 h-7 rounded-lg flex items-center justify-center transition-all duration-300"
                    :style="executionStatus === 'running'
                        ? 'background: var(--panel-live-bg); color: var(--panel-live)'
                        : executionStatus === 'completed'
                            ? 'background: var(--panel-done-bg); color: var(--panel-done)'
                            : 'background: var(--muted); color: var(--muted-foreground)'"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="16" y="16" width="6" height="6" rx="1"></rect>
                        <rect x="2" y="16" width="6" height="6" rx="1"></rect>
                        <rect x="9" y="2" width="6" height="6" rx="1"></rect>
                        <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path>
                        <path d="M12 12V8"></path>
                    </svg>
                </div>
                <div class="min-w-0">
                    <div
                        class="text-xs font-semibold text-foreground leading-tight truncate max-w-[140px]"
                        x-text="orchestratorName || 'Workflow Pipeline'"
                    ></div>
                    <div class="text-[10px] text-muted-foreground leading-tight">Execution Pipeline</div>
                </div>
            </div>

            <!-- Right: status badge + controls -->
            <div class="flex items-center gap-1 shrink-0 ml-1">
                <!-- Running badge -->
                <template x-if="executionStatus === 'running'">
                    <span
                        class="flex items-center gap-1 px-1.5 py-[3px] rounded-full text-[9px] font-semibold tracking-wide uppercase"
                        style="background: var(--panel-live-bg); color: var(--panel-live); border: 1px solid var(--panel-live-border);"
                    >
                        <span class="w-1.5 h-1.5 rounded-full shrink-0 wf-panel-pulse" style="background: var(--panel-live);"></span>
                        Live
                    </span>
                </template>
                <!-- Completed badge -->
                <template x-if="executionStatus === 'completed'">
                    <span
                        class="flex items-center gap-1 px-1.5 py-[3px] rounded-full text-[9px] font-semibold tracking-wide uppercase"
                        style="background: var(--panel-done-bg); color: var(--panel-done); border: 1px solid var(--panel-done-border);"
                    >
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Done
                    </span>
                </template>

                <!-- Minimize / restore -->
                <button
                    @click="isMinimized = !isMinimized"
                    class="w-6 h-6 rounded-md flex items-center justify-center hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
                    :title="isMinimized ? 'Expand pipeline' : 'Collapse pipeline'"
                >
                    <template x-if="!isMinimized">
                        @icon.Minus(icon.Props{Size: 12})
                    </template>
                    <template x-if="isMinimized">
                        @icon.ChevronDown(icon.Props{Size: 12})
                    </template>
                </button>

                <!-- Dismiss -->
                <button
                    @click="dismiss()"
                    class="w-6 h-6 rounded-md flex items-center justify-center hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
                    title="Dismiss"
                >
                    @icon.X(icon.Props{Size: 12})
                </button>
            </div>
        </div>

        <!-- ── Step / Iteration progress bar ── -->
        <template x-if="executionStatus === 'running' && stepInfo && stepInfo.total > 1">
            <div class="px-3 py-2 border-b border-border/40 bg-muted/20">
                <div class="flex items-center justify-between mb-1.5">
                    <span
                        class="text-[10px] font-medium text-muted-foreground"
                        x-text="stepInfo.workflowType === 'loop'
                            ? `Iteration ${stepInfo.iteration || 1} / ${stepInfo.maxIterations}`
                            : `Step ${stepInfo.current} of ${stepInfo.total}`"
                    ></span>
                    <span
                        class="text-[10px] text-muted-foreground tabular-nums"
                        x-show="stepInfo.workflowType !== 'loop'"
                        x-text="`${Math.round((stepInfo.current / stepInfo.total) * 100)}%`"
                    ></span>
                </div>
                <div class="h-1 rounded-full overflow-hidden bg-muted">
                    <div
                        class="h-full rounded-full transition-[width] duration-700 ease-out"
                        :style="`width: ${stepInfo.total > 0 ? Math.round((stepInfo.current / stepInfo.total) * 100) : 0}%;
                                 background: ${stepInfo.workflowType === 'loop' ? 'var(--panel-bar-loop)' : 'var(--panel-bar-seq)'}`"
                    ></div>
                </div>
            </div>
        </template>

        <!-- ── Pipeline body (collapsible) ── -->
        <div x-show="!isMinimized" x-collapse>
        <div class="max-h-[calc(100vh-220px)] overflow-y-auto">
            <!-- Tree visualizer -->
            <div x-show="!isLoading" class="w-full">
                <div x-data="workflowTreeVisualizer">
                    <div x-html="renderTree(graph, agentsList, activeAgentName, completedNodes, failedNodes)"></div>
                </div>
            </div>

            <!-- Loading skeleton -->
            <div x-show="isLoading" x-cloak class="p-5">
                <div class="flex flex-col items-center gap-2 mb-4">
                    <div
                        class="w-7 h-7 rounded-full border-2 border-t-transparent animate-spin"
                        style="border-color: var(--panel-live-border); border-top-color: var(--panel-live);"
                    ></div>
                    <p class="text-[11px] text-muted-foreground">Loading pipeline…</p>
                </div>
                <div class="space-y-2 px-1">
                    <div class="h-8 rounded-lg animate-pulse bg-muted/60"></div>
                    <div class="h-1 w-px mx-auto bg-border"></div>
                    <div class="h-8 rounded-lg animate-pulse bg-muted/60" style="animation-delay:120ms"></div>
                    <div class="h-1 w-px mx-auto bg-border"></div>
                    <div class="h-8 rounded-lg animate-pulse bg-muted/60" style="animation-delay:240ms"></div>
                </div>
            </div>

            <!-- ── Workflow Outputs ── -->
            <template x-if="outputEntries().length > 0">
                <div class="border-t border-border/40">
                    <!-- Collapsible header -->
                    <button
                        @click="outputsExpanded = !outputsExpanded"
                        class="w-full flex items-center justify-between px-3 py-2 text-[10px] font-semibold text-muted-foreground hover:text-foreground hover:bg-muted/30 transition-colors"
                    >
                        <span class="flex items-center gap-1.5">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                            </svg>
                            <span>Outputs</span>
                            <span
                                class="px-1 py-px rounded text-[9px] font-bold tabular-nums"
                                style="background: var(--panel-done-bg); color: var(--panel-done);"
                                x-text="outputEntries().length"
                            ></span>
                        </span>
                        <svg
                            width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                            stroke-linecap="round" stroke-linejoin="round"
                            :style="outputsExpanded ? 'transform: rotate(180deg)' : ''"
                            style="transition: transform 200ms ease"
                        >
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    <!-- Key-value rows -->
                    <div x-show="outputsExpanded" x-collapse>
                        <div class="px-2 pb-2 space-y-1">
                            <template x-for="entry in outputEntries()" :key="entry.key">
                                <div class="rounded-lg px-2 py-1.5 bg-muted/30 border border-border/40">
                                    <div class="flex items-center justify-between gap-2 mb-0.5">
                                        <span
                                            class="text-[10px] font-semibold font-mono truncate"
                                            style="color: var(--panel-done);"
                                            x-text="entry.key"
                                        ></span>
                                        <span
                                            class="text-[9px] text-muted-foreground shrink-0 truncate max-w-[90px]"
                                            x-text="entry.agentName"
                                        ></span>
                                    </div>
                                    <div
                                        class="text-[10px] text-foreground/80 font-mono break-all leading-snug"
                                        x-text="formatOutputValue(entry.value)"
                                    ></div>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </template>
        </div>
        </div>

        <!-- ── Minimized summary row ── -->
        <div x-show="isMinimized" class="px-3 py-2 text-[10px] text-muted-foreground flex items-center gap-2">
            <template x-if="executionStatus === 'running'">
                <span class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0 wf-panel-pulse" style="background: var(--panel-live);"></span>
                    <span
                        x-text="stepInfo
                            ? (stepInfo.workflowType === 'loop'
                                ? `Iter ${stepInfo.iteration || 1}/${stepInfo.maxIterations}`
                                : `Step ${stepInfo.current}/${stepInfo.total}`)
                            : 'Running…'"
                    ></span>
                </span>
            </template>
            <template x-if="executionStatus === 'completed'">
                <span class="flex items-center gap-1.5 font-medium" style="color: var(--panel-done);">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Completed
                </span>
            </template>
            <template x-if="executionStatus === 'idle'">
                <span>Tap ↑ to expand</span>
            </template>
        </div>
    </div>
}
