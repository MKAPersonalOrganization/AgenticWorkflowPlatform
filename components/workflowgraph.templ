package components

import "school-with-ai/components/icon"

templ WorkflowGraphPanel() {
    <div
        x-data="workflowGraphPanel"
        x-effect="handleWorkflowChange(activeWorkflowContext?.orchestratorId)"
        x-show="graph"
        x-cloak
        class="absolute right-4 top-20 z-40 w-80 max-h-[calc(100vh-120px)] overflow-y-auto rounded-xl shadow-modern-lg border border-border bg-background/95 backdrop-blur-md"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-x-8"
        x-transition:enter-end="opacity-100 translate-x-0"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-x-0"
        x-transition:leave-end="opacity-0 translate-x-8"
    >
        <div class="sticky top-0 z-10 flex items-center justify-between p-3 border-b border-border bg-background/95 backdrop-blur-md">
            <h3 class="text-sm font-semibold flex items-center gap-2 text-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path></svg>
                Workflow Pipeline
            </h3>
            <button 
                @click="graph = null" 
                class="rounded-md p-1.5 hover:bg-muted text-muted-foreground transition-colors"
                title="Dismiss panel"
            >
                @icon.X(icon.Props{Size: 14})
            </button>
        </div>
        
        <div class="w-full" x-show="!isLoading">
            <div x-data="workflowTreeVisualizer">
                <div x-html="renderTree(graph, agentsList, activeAgentName)"></div>
            </div>
        </div>
        <div class="p-6 text-center text-muted-foreground" x-show="isLoading" x-cloak>
            <div class="animate-spin inline-block size-6 border-[3px] border-current border-t-transparent text-primary rounded-full mb-2" role="status" aria-label="loading">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="text-xs">Loading workflow...</p>
        </div>
    </div>
}
