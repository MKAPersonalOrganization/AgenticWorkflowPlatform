package skills

import (
	"school-with-ai/components/badge"
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
	"school-with-ai/components/label"
	"school-with-ai/components/textarea"
)

templ SkillsDialog() {
	<div
		x-data="skillsManager"
		@open-skills-dialog.window="open()"
		@open-skill-store.window="open(); $nextTick(() => activeTab = 'store')"
	>
		@dialog.Dialog(dialog.Props{
			ID: "skills-manager-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "sm:max-w-4xl max-h-[90vh] flex flex-col p-0 overflow-hidden",
			}) {
				<!-- Main View (Skill List + Store Tabs) -->
				<template x-if="view === 'list'">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
							<div class="flex items-center justify-between mb-3">
								<div>
									@dialog.Title() {
										{ i18n.T(ctx, "Skills") }
									}
									@dialog.Description() {
										{ i18n.T(ctx, "Manage your skill library or browse the marketplace.") }
									}
								</div>
							</div>
							<!-- Tab Bar -->
							<div class="flex gap-0 -mb-px">
								<button
									type="button"
									@click="switchTab('my-skills')"
									class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
									:class="activeTab === 'my-skills' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
								>
									@icon.Zap(icon.Props{Class: "size-4 inline-block me-1.5 -mt-0.5"})
									{ i18n.T(ctx, "My Skills") }
								</button>
								<button
									type="button"
									@click="switchTab('store')"
									class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
									:class="activeTab === 'store' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
								>
									@icon.Store(icon.Props{Class: "size-4 inline-block me-1.5 -mt-0.5"})
									{ i18n.T(ctx, "Skill Store") }
								</button>
							</div>
						}
						<!-- ═══════ My Skills Tab ═══════ -->
						<template x-if="activeTab === 'my-skills'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<!-- Search + Create Bar -->
								<div class="px-4 pt-3 pb-2 flex items-center gap-2">
									<div class="flex-1">
										@input.Input(input.Props{
											Type:        input.TypeSearch,
											Placeholder: i18n.T(ctx, "Search your skills..."),
											Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
											Attributes: templ.Attributes{
												"x-model.debounce.300ms": "searchQuery",
												"@input":                 "searchSkills()",
											},
										})
									</div>
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantDefault,
										Class:   "gap-1.5 shrink-0",
										Attributes: templ.Attributes{
											"@click": "showCreateForm()",
										},
									}) {
										@icon.Plus(icon.Props{Class: "size-4"})
										{ i18n.T(ctx, "New Skill") }
									}
								</div>
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<!-- Loading State -->
									<template x-if="loading">
										<div class="space-y-3">
											<template x-for="i in 3" :key="i">
												<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
													<div class="size-10 rounded-lg bg-muted"></div>
													<div class="flex-1 space-y-2">
														<div class="h-4 bg-muted rounded-md w-1/3"></div>
														<div class="h-3 bg-muted rounded-md w-2/3"></div>
													</div>
												</div>
											</template>
										</div>
									</template>
									<!-- Loaded content -->
									<template x-if="!loading">
										<div>
											<!-- Empty State -->
											<template x-if="filteredSkills.length === 0">
												<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
													@icon.Zap(icon.Props{Class: "size-12 opacity-20"})
													<template x-if="searchQuery">
														<div class="text-center">
															<p class="text-sm font-medium">{ i18n.T(ctx, "No skills found") }</p>
															<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search term.") }</p>
														</div>
													</template>
													<template x-if="!searchQuery">
														<div class="text-center">
															<p class="text-sm font-medium">{ i18n.T(ctx, "No skills yet") }</p>
															<p class="text-xs mt-1">{ i18n.T(ctx, "Add skills from the store or create your own.") }</p>
															@button.Button(button.Props{
																Size:    button.SizeSm,
																Variant: button.VariantOutline,
																Class:   "mt-3 gap-1.5",
																Attributes: templ.Attributes{
																	"@click": "showCreateForm()",
																},
															}) {
																@icon.Plus(icon.Props{Class: "size-3.5"})
																{ i18n.T(ctx, "Create Skill") }
															}
														</div>
													</template>
												</div>
											</template>
											<!-- Skill Cards -->
											<div class="space-y-2">
												<template x-for="sk in filteredSkills" :key="sk.id">
													<div
														class="group relative rounded-xl border-2 transition-all duration-200 overflow-hidden border-transparent bg-card hover:border-border hover:shadow-sm"
													>
														<div class="flex items-start gap-3.5 p-3.5 ps-5">
															<!-- Skill Icon -->
															<div
																class="size-11 rounded-xl bg-violet-500/10 flex items-center justify-center text-violet-600 dark:text-violet-400 shrink-0 [&_svg]:size-5"
																x-html="sk.icon"
															></div>
															<!-- Content -->
															<div class="flex-1 min-w-0">
																<div class="flex items-center gap-2 mb-0.5">
																	<h3 class="text-sm font-semibold text-foreground truncate" x-text="sk.name"></h3>
																	<template x-if="sk.is_custom">
																		@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[9px] px-1.5 py-0 h-4"}) {
																			{ i18n.T(ctx, "Custom") }
																		}
																	</template>
																</div>
																<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="sk.description || 'No description'"></p>
																<div class="flex items-center gap-3 mt-2">
																	<span class="text-[10px] text-muted-foreground" x-text="sk.category"></span>
																	<span class="text-[10px] text-muted-foreground" x-text="'Created ' + formatDate(sk.created_at)"></span>
																</div>
															</div>
															<!-- Actions -->
															<div class="flex items-center gap-1.5 shrink-0" @click.stop>
																<!-- Permissions -->
																@button.Button(button.Props{
																	Size:    button.SizeIcon,
																	Variant: button.VariantGhost,
																	Class:   "size-7",
																	Attributes: templ.Attributes{
																		"@click.stop": "showPermissions(sk)",
																		"title":       i18n.T(ctx, "Agent Permissions"),
																	},
																}) {
																	@icon.Shield(icon.Props{Class: "size-3.5"})
																}
																<!-- Edit & Delete -->
																<div class="flex items-center gap-0.5 ms-1 ps-1.5 border-s border-border transition-opacity duration-150 opacity-0 group-hover:opacity-100">
																	@button.Button(button.Props{
																		Size:    button.SizeIcon,
																		Variant: button.VariantGhost,
																		Class:   "size-7",
																		Attributes: templ.Attributes{
																			"@click.stop": "showEditForm(sk)",
																			"title":       i18n.T(ctx, "Edit"),
																		},
																	}) {
																		@icon.Pencil(icon.Props{Class: "size-3.5"})
																	}
																	@button.Button(button.Props{
																		Size:    button.SizeIcon,
																		Variant: button.VariantGhost,
																		Class:   "size-7 text-destructive hover:text-destructive",
																		Attributes: templ.Attributes{
																			"@click.stop": "confirmDelete(sk)",
																			"title":       i18n.T(ctx, "Delete"),
																		},
																	}) {
																		@icon.Trash2(icon.Props{Class: "size-3.5"})
																	}
																</div>
															</div>
														</div>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>
						<!-- ═══════ Skill Store Tab ═══════ -->
						<template x-if="activeTab === 'store'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<!-- Search + Category Filters -->
								<div class="px-4 pt-3 pb-2 space-y-2">
									@input.Input(input.Props{
										Type:        input.TypeSearch,
										Placeholder: i18n.T(ctx, "Search the skill store..."),
										Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
										Attributes: templ.Attributes{
											"x-model.debounce.300ms": "storeSearchQuery",
											"@input":                 "searchCatalog()",
										},
									})
									<!-- Category Pills -->
									<div class="flex flex-wrap gap-1.5" x-show="storeCategories.length > 0">
										<button
											type="button"
											@click="filterByCategory('')"
											class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium transition-colors border"
											:class="!selectedCategory ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent hover:text-foreground'"
										>
											{ i18n.T(ctx, "All") }
										</button>
										<template x-for="cat in storeCategories" :key="cat">
											<button
												type="button"
												@click="filterByCategory(cat)"
												class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium transition-colors border"
												:class="selectedCategory === cat ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/50 text-muted-foreground border-border hover:bg-accent hover:text-foreground'"
												x-text="cat"
											></button>
										</template>
									</div>
								</div>
								<!-- Store Entries Grid -->
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<!-- Loading -->
									<template x-if="storeLoading">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
											<template x-for="i in 6" :key="i">
												<div class="p-4 rounded-lg border border-border animate-pulse">
													<div class="flex items-center gap-3 mb-3">
														<div class="size-10 rounded-lg bg-muted"></div>
														<div class="flex-1 space-y-2">
															<div class="h-4 bg-muted rounded w-2/3"></div>
															<div class="h-3 bg-muted rounded w-1/3"></div>
														</div>
													</div>
													<div class="h-3 bg-muted rounded w-full mb-2"></div>
													<div class="h-3 bg-muted rounded w-4/5"></div>
												</div>
											</template>
										</div>
									</template>
									<!-- Loaded -->
									<template x-if="!storeLoading">
										<div>
											<!-- Empty State -->
											<template x-if="storeEntries.length === 0">
												<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
													@icon.Store(icon.Props{Class: "size-12 opacity-20"})
													<div class="text-center">
														<p class="text-sm font-medium">{ i18n.T(ctx, "No skills found") }</p>
														<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search or category.") }</p>
													</div>
												</div>
											</template>
											<!-- Skill Store Cards (2-col grid) -->
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
												<template x-for="entry in storeEntries" :key="entry.id">
													<div class="group p-4 rounded-lg border border-border hover:border-violet-500/30 hover:bg-accent/30 transition-all duration-150 flex flex-col">
														<div class="flex items-start gap-3 mb-2">
															<!-- Skill icon (SVG) -->
															<div
																class="size-10 rounded-lg bg-violet-500/10 flex items-center justify-center text-violet-600 dark:text-violet-400 shrink-0 [&_svg]:size-5"
																x-html="entry.icon"
															></div>
															<div class="flex-1 min-w-0">
																<div class="flex items-center gap-2">
																	<h3 class="text-sm font-semibold text-foreground truncate" x-text="entry.name"></h3>
																	<template x-if="entry.featured">
																		@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "text-[9px] px-1.5 py-0 h-4 bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/20"}) {
																			@icon.Star(icon.Props{Class: "size-2.5 me-0.5"})
																			{ i18n.T(ctx, "Featured") }
																		}
																	</template>
																</div>
																<span class="text-[10px] text-muted-foreground" x-text="entry.category"></span>
															</div>
														</div>
														<p class="text-xs text-muted-foreground line-clamp-2 mb-3 flex-1" x-text="entry.description"></p>
														<div class="flex items-center justify-between mt-auto">
															<div class="flex flex-wrap gap-1">
																<template x-for="tag in (entry.tags || []).slice(0, 3)" :key="tag">
																	@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[9px] px-1.5 py-0 h-4"}) {
																		<span x-text="tag"></span>
																	}
																</template>
															</div>
															<!-- Already added state -->
															<template x-if="addedCatalogIds.includes(entry.id)">
																<span class="inline-flex items-center gap-1 h-7 px-2.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 rounded-md bg-emerald-500/10 border border-emerald-500/20 select-none">
																	@icon.Check(icon.Props{Class: "size-3"})
																	{ i18n.T(ctx, "Added") }
																</span>
															</template>
															<!-- Add / Adding button -->
															<template x-if="!addedCatalogIds.includes(entry.id)">
																<button
																	type="button"
																	@click.stop="addFromStore(entry)"
																	x-bind:disabled="storeAddingIds.includes(entry.id)"
																	class="inline-flex items-center justify-center gap-1 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 cursor-pointer border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-7 px-2.5 text-xs shrink-0"
																>
																	<span x-show="!storeAddingIds.includes(entry.id)" class="flex items-center gap-1">
																		@icon.Plus(icon.Props{Class: "size-3"})
																		{ i18n.T(ctx, "Add") }
																	</span>
																	<span x-show="storeAddingIds.includes(entry.id)" class="flex items-center gap-1">
																		<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
																		{ i18n.T(ctx, "Adding...") }
																	</span>
																</button>
															</template>
														</div>
														<!-- Inline success toast -->
														<div
															x-show="storeSuccessId === entry.id"
															x-transition:enter="transition ease-out duration-200"
															x-transition:enter-start="opacity-0 translate-y-1"
															x-transition:enter-end="opacity-100 translate-y-0"
															x-transition:leave="transition ease-in duration-150"
															x-transition:leave-start="opacity-100 translate-y-0"
															x-transition:leave-end="opacity-0 translate-y-1"
															class="mt-2 flex items-center gap-1.5 rounded-md bg-emerald-500/10 border border-emerald-500/20 px-2 py-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400"
														>
															@icon.Check(icon.Props{Class: "size-3"})
															{ i18n.T(ctx, "Skill added to My Skills!") }
														</div>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<span class="text-xs text-muted-foreground">
									<template x-if="activeTab === 'my-skills'">
										<span x-text="`${filteredSkills.length} skill${filteredSkills.length !== 1 ? 's' : ''}`"></span>
									</template>
									<template x-if="activeTab === 'store'">
										<span x-text="`${storeTotal} skill${storeTotal !== 1 ? 's' : ''} in store`"></span>
									</template>
								</span>
								@dialog.Close() {
									@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
										{ i18n.T(ctx, "Close") }
									}
								}
							</div>
						}
					</div>
				</template>
				<!-- Create/Edit Form View -->
				<template x-if="view === 'form'">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-center gap-2">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-8",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								<div>
									@dialog.Title() {
										<span x-text="editingSkill ? 'Edit Skill' : 'Create New Skill'"></span>
									}
									@dialog.Description() {
										<span x-text="editingSkill ? 'Modify your skill configuration.' : 'Define a new custom skill.'"></span>
									}
								</div>
							</div>
						}
						<div class="flex-1 overflow-y-auto p-4 scrollbar-thin space-y-4">
							<!-- Skill Name -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Skill Name") }
									<span class="text-destructive">*</span>
								}
								@input.Input(input.Props{
									Placeholder: i18n.T(ctx, "e.g., Statistics Expert, Creative Writer..."),
									Attributes: templ.Attributes{
										"x-model":   "form.name",
										"maxlength": "100",
									},
								})
							</div>
							<!-- Category -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Category") }
								}
								@input.Input(input.Props{
									Placeholder: i18n.T(ctx, "e.g., Math & Science, Writing, Programming..."),
									Attributes: templ.Attributes{
										"x-model":   "form.category",
										"maxlength": "100",
									},
								})
							</div>
							<!-- Description -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Description") }
								}
								@input.Input(input.Props{
									Placeholder: i18n.T(ctx, "Brief description of what this skill does..."),
									Attributes: templ.Attributes{
										"x-model":   "form.description",
										"maxlength": "500",
									},
								})
							</div>
							<!-- Instructions -->
							<div class="space-y-2">
								@label.Label(label.Props{}) {
									{ i18n.T(ctx, "Instructions") }
									<span class="text-destructive">*</span>
								}
								@textarea.Textarea(textarea.Props{
									Placeholder: i18n.T(ctx, "Detailed instructions that define this skill's behavior when activated..."),
									Class:       "min-h-[160px] resize-y font-mono text-xs",
									Rows:        8,
									Attributes: templ.Attributes{
										"x-model": "form.instructions",
									},
								})
								<p class="text-[11px] text-muted-foreground">
									{ i18n.T(ctx, "These instructions are injected into the agent's context when the skill is activated. Use Markdown for formatting.") }
								</p>
							</div>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-end gap-2 w-full">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									{ i18n.T(ctx, "Cancel") }
								}
								@button.Button(button.Props{
									Variant: button.VariantDefault,
									Class:   "h-8 px-4 text-xs gap-1.5",
									Attributes: templ.Attributes{
										"@click":    "saveSkill()",
										":disabled": "saving || !form.name.trim() || !form.instructions.trim()",
									},
								}) {
									<span x-show="!saving" x-text="editingSkill ? 'Save Changes' : 'Create Skill'"></span>
									<span x-show="saving" class="flex items-center gap-1.5">
										<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
										{ i18n.T(ctx, "Saving...") }
									</span>
								}
							</div>
						}
					</div>
				</template>
				<!-- Delete Confirmation View -->
				<template x-if="view === 'delete'">
					<div class="flex flex-col h-full">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							@dialog.Title() {
								{ i18n.T(ctx, "Delete Skill") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "This action cannot be undone.") }
							}
						}
						<div class="p-6 flex flex-col items-center gap-4">
							<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
								@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
							</div>
							<p class="text-sm text-center text-foreground">
								{ i18n.T(ctx, "Are you sure you want to delete") }
								<span class="font-semibold" x-text="deletingSkill?.name"></span>?
							</p>
							<p class="text-xs text-center text-muted-foreground">
								{ i18n.T(ctx, "All agent permissions for this skill will also be removed.") }
							</p>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-end gap-2 w-full">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									{ i18n.T(ctx, "Cancel") }
								}
								@button.Button(button.Props{
									Variant: button.VariantDestructive,
									Class:   "h-8 px-4 text-xs gap-1.5",
									Attributes: templ.Attributes{
										"@click":    "deleteSkill()",
										":disabled": "saving",
									},
								}) {
									<span x-show="!saving">{ i18n.T(ctx, "Delete") }</span>
									<span x-show="saving" class="flex items-center gap-1.5">
										<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
										{ i18n.T(ctx, "Deleting...") }
									</span>
								}
							</div>
						}
					</div>
				</template>
				<!-- Permissions View -->
				<template x-if="view === 'permissions'">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-center gap-2">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-8",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								<div>
									@dialog.Title() {
										{ i18n.T(ctx, "Agent Permissions") }
									}
									@dialog.Description() {
										<span>
											{ i18n.T(ctx, "Choose which agents can use") }
											<span class="font-semibold" x-text="permSkill?.name"></span>
										</span>
									}
								</div>
							</div>
						}
						<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[200px]">
							<!-- Loading Agents -->
							<template x-if="loadingAgents">
								<div class="space-y-2 pt-3">
									<template x-for="i in 3" :key="i">
										<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
											<div class="size-8 rounded-lg bg-muted"></div>
											<div class="flex-1 space-y-1.5">
												<div class="h-3.5 bg-muted rounded-md w-1/3"></div>
												<div class="h-3 bg-muted rounded-md w-1/2"></div>
											</div>
											<div class="size-9 rounded-full bg-muted"></div>
										</div>
									</template>
								</div>
							</template>
							<!-- Loaded Agents -->
							<template x-if="!loadingAgents">
								<div>
									<!-- Empty State -->
									<template x-if="permAgents.length === 0">
										<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
											@icon.CompassLogo("size-12 opacity-20")
											<div class="text-center">
												<p class="text-sm font-medium">{ i18n.T(ctx, "No agents found") }</p>
												<p class="text-xs mt-1">{ i18n.T(ctx, "Create agents first to grant skill permissions.") }</p>
											</div>
										</div>
									</template>
									<!-- Agent List with Toggle -->
									<div class="space-y-1.5 pt-3">
										<template x-for="ag in permAgents" :key="ag.id">
											<div class="flex items-center justify-between p-3 rounded-lg border border-border hover:bg-accent/20 transition-colors">
												<div class="flex items-center gap-3 flex-1 min-w-0">
													<div
														class="size-9 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0 [&_svg]:size-4"
														x-html="ag.icon"
													></div>
													<div class="flex-1 min-w-0">
														<div class="text-sm font-medium text-foreground truncate" x-text="ag.name"></div>
														<div class="text-[11px] text-muted-foreground truncate" x-text="ag.description || 'No description'"></div>
													</div>
												</div>
												<button
													@click="togglePermission(ag)"
													class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
													:class="ag.hasPermission ? 'bg-primary' : 'bg-input'"
													role="switch"
													:aria-checked="ag.hasPermission"
												>
													<span
														class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
														:class="ag.hasPermission ? 'translate-x-4' : 'translate-x-0'"
													></span>
												</button>
											</div>
										</template>
									</div>
								</div>
							</template>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<span class="text-xs text-muted-foreground">
									<span x-text="`${permAgents.filter(a => a.hasPermission).length} of ${permAgents.length} agents enabled`"></span>
								</span>
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "view = 'list'",
									},
								}) {
									{ i18n.T(ctx, "Done") }
								}
							</div>
						}
					</div>
				</template>
			}
		}
	</div>
}

// SkillStoreNavButtonTrigger renders a zap icon for the navbar that opens the skills dialog.
templ SkillStoreNavButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "skills-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-skills-dialog')",
				"title":  i18n.T(ctx, "Skills"),
			},
		}) {
			@icon.Zap(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Skills") }</span>
		}
	}
}

// SkillStoreButtonTrigger opens the skills dialog directly to the store tab.
templ SkillStoreButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "skills-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-skill-store')",
				"title":  i18n.T(ctx, "Skill Store"),
			},
		}) {
			@icon.Store(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Skill Store") }</span>
		}
	}
}
