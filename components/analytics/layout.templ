package analytics

import (
	"school-with-ai/components"
	"school-with-ai/components/chart"
	"school-with-ai/shared"
)

type LayoutProps struct {
	Title      string
	User       *shared.User
	HideNavbar bool
}

templ AnalyticsExtraHead() {
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}

templ Layout(props LayoutProps) {
	@components.BaseLayout(components.LayoutProps{
		Title:      props.Title,
		User:       props.User,
		ExtraHead:  AnalyticsExtraHead(),
		HideNavbar: props.HideNavbar,
	}) {
		<!-- Main Content -->
		<main class="flex-1">
			{ children... }
		</main>
		@chart.Script()
		<footer class="border-t py-6 bg-muted/50">
			<div class="max-w-7xl mx-auto px-4 text-center text-sm text-muted-foreground">
				<p>© 2026 Compass.AI Analytics. All rights reserved.</p>
			</div>
		</footer>
	}
}
