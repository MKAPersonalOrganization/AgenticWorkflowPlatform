package auth

import client "github.com/ory/client-go"
import "school-with-ai/domain"

type RecoveryPageProps struct {
	FlowAction string
	FlowMethod string
	Messages   []UIMessage
	LoginURL   string
	User       *domain.User
}

// RecoveryPage renders the password recovery page with a slot for form content
templ RecoveryPage(props RecoveryPageProps) {
	@AuthLayout(LayoutProps{
		Title:       "Reset Your Password",
		Description: "Enter your email to receive a recovery code",
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		<!-- Recovery Form -->
		if props.FlowAction != "" {
			@Form(FormProps{
				Action: props.FlowAction,
				Method: props.FlowMethod,
			}) {
				{ children... }
			}
			<!-- Additional Links -->
			<div class="mt-4 text-center text-sm">
				if props.LoginURL != "" {
					<div class="text-muted-foreground">
						Remember your password?
						{ " " }
						<a href={ templ.SafeURL(props.LoginURL) } class="text-primary hover:underline">
							Sign in
						</a>
					</div>
				}
			</div>
		}
	}
}

// RecoveryPageWithNodes renders the recovery page with Kratos UI nodes
templ RecoveryPageWithNodes(nodes []client.UiNode, props RecoveryPageProps) {
	@RecoveryPage(props) {
		@UINodes(UINodesProps{
			Nodes:  nodes,
			Groups: []string{"default", "code", "link"},
		})
	}
}
