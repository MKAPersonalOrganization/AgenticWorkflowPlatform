package auth

import (
	"school-with-ai/components/alert"
)

type MessagesProps struct {
	Messages []UIMessage
}

type UIMessage struct {
	ID      int64
	Text    string
	Type    string
	Context map[string]interface{}
}

// Messages renders flow messages (errors, info, success)
templ Messages(props MessagesProps) {
	if len(props.Messages) > 0 {
		<div class="space-y-2">
			for _, msg := range props.Messages {
				@alert.Alert(alert.Props{
					Variant: getAlertVariant(msg.Type),
					Class:   "text-sm",
				}) {
					@alert.Title(alert.TitleProps{}) {
						{ msg.Text }
					}
				}
			}
		</div>
	}
}

func getAlertVariant(msgType string) alert.Variant {
	switch msgType {
	case "error":
		return alert.VariantDestructive
	case "success":
		return alert.VariantDefault
	case "info":
		return alert.VariantDefault
	default:
		return alert.VariantDefault
	}
}
