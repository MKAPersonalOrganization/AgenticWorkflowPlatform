package auth

import (
	client "github.com/ory/client-go"
	"school-with-ai/components/alert"
	"school-with-ai/components/button"
	"school-with-ai/components/form"
	"school-with-ai/components/i18n"
	"school-with-ai/components/input"
	"strings"
)

type FormProps struct {
	Action string
	Method string
	Class  string
}

// Form renders a standard HTML form wrapper
templ Form(props FormProps) {
	<form
		if props.Action != "" {
			action={ props.Action }
		}
		if props.Method != "" {
			method={ props.Method }
		} else {
			method="POST"
		}
		if props.Class != "" {
			class={ props.Class }
		} else {
			class="space-y-4"
		}
	>
		{ children... }
	</form>
}

type MessagesProps struct {
	Messages []UIMessage
}

type UIMessage struct {
	ID      int64
	Text    string
	Type    string
	Context map[string]interface{}
}

// Messages renders flow messages (errors, info, success)
templ Messages(props MessagesProps) {
	if len(props.Messages) > 0 {
		<div class="space-y-2">
			for _, msg := range props.Messages {
				@alert.Alert(alert.Props{
					Variant: getAlertVariant(msg.Type),
					Class:   "text-sm",
				}) {
					@alert.Title(alert.TitleProps{}) {
						{ msg.Text }
					}
				}
			}
		</div>
	}
}

func getAlertVariant(msgType string) alert.Variant {
	switch msgType {
	case "error":
		return alert.VariantDestructive
	case "success":
		return alert.VariantDefault
	case "info":
		return alert.VariantDefault
	default:
		return alert.VariantDefault
	}
}

type UINodeProps struct {
	Node client.UiNode
}

// UINode renders a single Kratos UI node
templ UINode(props UINodeProps) {
	{{ node := props.Node }}
	if node.Attributes.UiNodeInputAttributes != nil {
		@renderInputNode(node)
	} else if node.Attributes.UiNodeTextAttributes != nil {
		@renderTextNode(node)
	} else if node.Attributes.UiNodeAnchorAttributes != nil {
		@renderAnchorNode(node)
	} else if node.Attributes.UiNodeImageAttributes != nil {
		@renderImageNode(node)
	} else if node.Attributes.UiNodeScriptAttributes != nil {
		@renderScriptNode(node)
	}
}

templ renderInputNode(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeInputAttributes }}
	if attrs.Type == "submit" || attrs.Type == "button" {
		@button.Button(button.Props{
			Type:     button.TypeSubmit,
			Class:    "w-full",
			Variant:  button.VariantDefault,
			Disabled: boolValue(attrs.Disabled),
			Attributes: templ.Attributes{
				"name":  attrs.Name,
				"value": stringValue(attrs.Value),
			},
		}) {
			{ getNodeLabel(node) }
		}
	} else if attrs.Type == "hidden" {
		<input
			type="hidden"
			name={ attrs.Name }
			value={ stringValue(attrs.Value) }
		/>
	} else if attrs.Type == "checkbox" {
		@form.ItemFlex() {
			<input
				type="checkbox"
				id={ attrs.Name }
				name={ attrs.Name }
				value={ stringValue(attrs.Value) }
				if boolValue(attrs.Required) {
					required
				}
				if boolValue(attrs.Disabled) {
					disabled
				}
				class="h-4 w-4 rounded border-gray-300"
			/>
			@form.Label(form.LabelProps{
				For: attrs.Name,
			}) {
				{ getNodeLabel(node) }
			}
		}
	} else {
		@form.Item() {
			@form.Label(form.LabelProps{
				For: attrs.Name,
			}) {
				{ getNodeLabel(node) }
			}
			@input.Input(input.Props{
				Type:        getInputTypeForNode(node),
				Name:        attrs.Name,
				ID:          attrs.Name,
				Value:       stringValue(attrs.Value),
				Placeholder: getNodeLabel(node),
				Disabled:    boolValue(attrs.Disabled),
				Attributes: templ.Attributes{
					"autocomplete": stringValue(attrs.Autocomplete),
					"required":     boolValue(attrs.Required),
				},
			})
			@renderNodeMessages(node)
		}
	}
}

templ renderTextNode(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeTextAttributes }}
	<div class="text-sm text-muted-foreground">
		{ attrs.Text.Text }
	</div>
}

templ renderAnchorNode(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeAnchorAttributes }}
	<a
		href={ templ.SafeURL(attrs.Href) }
		class="text-sm text-primary hover:underline"
		if attrs.Title.Text != "" {
			title={ attrs.Title.Text }
		}
	>
		{ attrs.Title.Text }
	</a>
}

templ renderImageNode(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeImageAttributes }}
	<img
		src={ attrs.Src }
		alt={ getNodeLabel(node) }
		class="mx-auto h-12 w-auto"
	/>
}

templ renderScriptNode(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeScriptAttributes }}
	<script src={ attrs.Src } if attrs.Async {
	async
} if attrs.Referrerpolicy != "" {
	referrerpolicy={ attrs.Referrerpolicy }
} if attrs.Crossorigin != "" {
	crossorigin={ attrs.Crossorigin }
} if attrs.Integrity != "" {
	integrity={ attrs.Integrity }
} if attrs.Type != "" {
	type={ attrs.Type }
} if attrs.Nonce != "" {
	nonce={ attrs.Nonce }
}></script>
}

templ renderNodeMessages(node client.UiNode) {
	if len(node.Messages) > 0 {
		for _, msg := range node.Messages {
			@form.Message(form.MessageProps{
				Variant: getFormMessageVariant(string(msg.Type)),
			}) {
				{ msg.Text }
			}
		}
	}
}

func getFormMessageVariant(msgType string) form.MessageVariant {
	switch msgType {
	case "error":
		return form.MessageVariantError
	case "info":
		return form.MessageVariantInfo
	default:
		return form.MessageVariantInfo
	}
}

func getNodeLabel(node client.UiNode) string {
	// Override the generic "ID" label for the login identifier field.
	// We only support email-based login so label it accordingly.
	if node.Attributes.UiNodeInputAttributes != nil && node.Attributes.UiNodeInputAttributes.Name == "identifier" {
		return "E-Mail"
	}
	if node.Meta.Label != nil && node.Meta.Label.Text != "" {
		return node.Meta.Label.Text
	}
	if node.Attributes.UiNodeInputAttributes != nil {
		return node.Attributes.UiNodeInputAttributes.Name
	}
	return ""
}

func getInputType(kratosType string) input.Type {
	switch kratosType {
	case "email":
		return input.TypeEmail
	case "password":
		return input.TypePassword
	case "number":
		return input.TypeNumber
	case "tel":
		return input.TypeTel
	case "url":
		return input.TypeURL
	default:
		return input.TypeText
	}
}

// getInputTypeForNode returns the appropriate input type, overriding for known fields.
// The "identifier" field is always email since that's our only login identifier.
func getInputTypeForNode(node client.UiNode) input.Type {
	if node.Attributes.UiNodeInputAttributes != nil {
		if node.Attributes.UiNodeInputAttributes.Name == "identifier" {
			return input.TypeEmail
		}
		return getInputType(node.Attributes.UiNodeInputAttributes.Type)
	}
	return input.TypeText
}

func stringValue(v interface{}) string {
	if v == nil {
		return ""
	}
	if s, ok := v.(string); ok {
		return s
	}
	return ""
}

func boolValue(v interface{}) bool {
	if v == nil {
		return false
	}
	if b, ok := v.(bool); ok {
		return b
	}
	return false
}

type UINodesProps struct {
	Nodes  []client.UiNode
	Groups []string
}

// UINodes renders multiple Kratos UI nodes, optionally filtered by group
templ UINodes(props UINodesProps) {
	{{ nodes := filterNodes(props.Nodes, props.Groups) }}
	<div class="space-y-4">
		for _, node := range nodes {
			@UINode(UINodeProps{Node: node})
		}
	</div>
}

// OIDCNodes renders social login / OIDC provider buttons in their own form.
// Each OIDC button submits to the same flow action but with provider=<id>.
// The OIDC group must be rendered in a separate <form> because the submit
// buttons carry different name/value pairs than the password/code form.
templ OIDCNodes(nodes []client.UiNode, action string, method string) {
	{{ oidcNodes := filterNodes(nodes, []string{"oidc"}) }}
	{{ defaultNodes := filterNodes(nodes, []string{"default"}) }}
	if len(oidcNodes) > 0 {
		<form
			action={ action }
			if method != "" {
				method={ method }
			} else {
				method="POST"
			}
			class="space-y-3"
		>
			<!-- Hidden default fields (CSRF token, etc.) -->
			for _, node := range defaultNodes {
				if node.Attributes.UiNodeInputAttributes != nil && node.Attributes.UiNodeInputAttributes.Type == "hidden" {
					<input
						type="hidden"
						name={ node.Attributes.UiNodeInputAttributes.Name }
						value={ stringValue(node.Attributes.UiNodeInputAttributes.Value) }
					/>
				}
			}
			<!-- Social login buttons -->
			<div class={ socialButtonGridClass(len(oidcNodes)) }>
				for _, node := range oidcNodes {
					@renderSocialButton(node)
				}
			</div>
		</form>
	}
}

// AuthDivider renders an "or" horizontal divider between auth method sections
templ AuthDivider() {
	<div class="relative my-6">
		<div class="absolute inset-0 flex items-center">
			<div class="w-full border-t border-border"></div>
		</div>
		<div class="relative flex justify-center text-xs uppercase">
			<span class="bg-card px-2 text-muted-foreground">{ i18n.T(ctx, "or") }</span>
		</div>
	</div>
}

// renderSocialButton renders a single OIDC provider button with icon and label
templ renderSocialButton(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeInputAttributes }}
	{{ providerID := stringValue(attrs.Value) }}
	{{ label := getNodeLabel(node) }}
	<button
		type="submit"
		name={ attrs.Name }
		value={ providerID }
		class="inline-flex w-full items-center justify-center gap-3 rounded-lg border border-border bg-background px-4 py-3 text-sm font-medium text-foreground shadow-sm transition-all hover:bg-accent hover:text-accent-foreground hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
		if boolValue(attrs.Disabled) {
			disabled
		}
	>
		@socialProviderIcon(providerID)
		<span>{ label }</span>
	</button>
}

// socialProviderIcon renders the appropriate SVG icon for a social provider
templ socialProviderIcon(providerID string) {
	switch normalizeProviderID(providerID) {
		case "google":
			<svg class="size-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
				<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
				<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
				<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
			</svg>
		case "apple":
			<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
				<path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path>
			</svg>
		default:
			<!-- Generic provider icon (globe) -->
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M2 12h20"></path>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
			</svg>
	}
}

// normalizeProviderID extracts the base provider name (e.g., "google" from "google-workspace")
func normalizeProviderID(id string) string {
	parts := strings.SplitN(id, "-", 2)
	return strings.ToLower(parts[0])
}

// socialButtonGridClass returns grid classes based on the number of social buttons
func socialButtonGridClass(count int) string {
	switch {
	case count >= 4 && count%4 == 0:
		return "grid grid-cols-4 gap-3"
	case count >= 3 && count%3 == 0:
		return "grid grid-cols-3 gap-3"
	default:
		return "grid grid-cols-1 gap-3"
	}
}

// hasOIDCNodes checks if a node list contains any OIDC provider nodes
func hasOIDCNodes(nodes []client.UiNode) bool {
	for _, node := range nodes {
		if node.Group == "oidc" {
			return true
		}
	}
	return false
}

// hasNonOIDCNodes checks if there are visible non-OIDC, non-default nodes
func hasNonOIDCNodes(nodes []client.UiNode, groups []string) bool {
	for _, node := range nodes {
		if node.Group == "oidc" || node.Group == "default" {
			continue
		}
		for _, g := range groups {
			if node.Group == g {
				return true
			}
		}
	}
	return false
}

func filterNodes(nodes []client.UiNode, groups []string) []client.UiNode {
	if len(groups) == 0 {
		return nodes
	}

	groupSet := make(map[string]bool)
	for _, g := range groups {
		groupSet[g] = true
	}

	filtered := make([]client.UiNode, 0)
	for _, node := range nodes {
		if groupSet[node.Group] {
			filtered = append(filtered, node)
		}
	}

	return filtered
}
