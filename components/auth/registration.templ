package auth

import client "github.com/ory/client-go"

type RegistrationPageProps struct {
	FlowAction string
	FlowMethod string
	Messages   []UIMessage
	LoginURL   string
}

// RegistrationPage renders the registration page with a slot for form content
templ RegistrationPage(props RegistrationPageProps) {
	@AuthLayout(LayoutProps{
		Title:       "Create Account",
		Description: "Enter your details to create a new account",
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		<!-- Registration Form -->
		if props.FlowAction != "" {
			@Form(FormProps{
				Action: props.FlowAction,
				Method: props.FlowMethod,
			}) {
				{ children... }
			}
			<!-- Additional Links -->
			<div class="mt-4 text-center text-sm">
				if props.LoginURL != "" {
					<div class="text-muted-foreground">
						Already have an account?
						{ " " }
						<a href={ templ.SafeURL(props.LoginURL) } class="text-primary hover:underline">
							Sign in
						</a>
					</div>
				}
			</div>
		}
	}
}

// RegistrationPageWithNodes renders the registration page with Kratos UI nodes
templ RegistrationPageWithNodes(nodes []client.UiNode, props RegistrationPageProps) {
	@RegistrationPage(props) {
		@UINodes(UINodesProps{
			Nodes:  nodes,
			Groups: []string{"default", "password", "profile"},
		})
	}
}
