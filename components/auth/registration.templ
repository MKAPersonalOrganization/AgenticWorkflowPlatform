package auth

import client "github.com/ory/client-go"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"

type RegistrationPageProps struct {
	FlowAction string
	FlowMethod string
	Messages   []UIMessage
	LoginURL   string
	User       *domain.User
}

// RegistrationPage renders the registration page with a slot for form content
templ RegistrationPage(props RegistrationPageProps) {
	@AuthLayout(LayoutProps{
		Title:       i18n.T(ctx, "Create Account"),
		Description: i18n.T(ctx, "Enter your details to create a new account"),
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		<!-- Registration Form -->
		if props.FlowAction != "" {
			@Form(FormProps{
				Action: props.FlowAction,
				Method: props.FlowMethod,
			}) {
				{ children... }
			}
			<!-- Additional Links -->
			<div class="mt-4 text-center text-sm">
				if props.LoginURL != "" {
					<div class="text-muted-foreground">
						{ i18n.T(ctx, "Already have an account?") }
						{ " " }
						<a href={ templ.SafeURL(props.LoginURL) } class="text-primary hover:underline">
							{ i18n.T(ctx, "Sign in") }
						</a>
					</div>
				}
			</div>
		}
	}
}

// RegistrationPageWithNodes renders the registration page with Kratos UI nodes
templ RegistrationPageWithNodes(nodes []client.UiNode, props RegistrationPageProps) {
	@AuthLayout(LayoutProps{
		Title:       i18n.T(ctx, "Create Account"),
		Description: i18n.T(ctx, "Get started by creating your account."),
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		if props.FlowAction != "" {
			<!-- 1. Social sign-up buttons (Google, etc.) — always first -->
			if hasOIDCNodes(nodes) {
				@OIDCNodes(nodes, props.FlowAction, props.FlowMethod)
			}
			<!-- 2. Divider between social and email registration -->
			if hasOIDCNodes(nodes) && hasNonOIDCNodes(nodes, []string{"password", "profile"}) {
				@AuthDivider()
			}
			<!-- 3. Email + password registration form -->
			if hasNonOIDCNodes(nodes, []string{"password", "profile"}) {
				@Form(FormProps{
					Action: props.FlowAction,
					Method: props.FlowMethod,
				}) {
					@UINodes(UINodesProps{
						Nodes:  nodes,
						Groups: []string{"default", "password", "profile"},
					})
				}
			}
			<!-- 4. Sign in link — always at the bottom -->
			if props.LoginURL != "" {
				<div class="mt-6 text-center text-sm text-muted-foreground">
					{ i18n.T(ctx, "Already have an account?") }
					{ " " }
					<a href={ templ.SafeURL(props.LoginURL) } class="font-medium text-primary hover:underline">
						{ i18n.T(ctx, "Sign in") }
					</a>
				</div>
			}
		}
	}
}
