package auth

import "school-with-ai/components"
import "school-with-ai/components/card"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"

type LayoutProps struct {
	Title       string
	Description string
	LogoURL     string
	User        *domain.User // Optional: if provided, navbar will show user info
}

// AuthLayout provides a centered card layout for authentication pages
templ AuthLayout(props LayoutProps) {
	@components.BaseLayout(components.LayoutProps{
		Title:      props.Title,
		User:       props.User,
		HideNavbar: true,
	}) {
		<style>
			/* Compass spinning animation for auth pages */
			@keyframes compassSpin {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}
			.compass-spin-slow {
				animation: compassSpin 12s linear infinite;
			}
		</style>
		<main class="flex min-h-screen items-center justify-center p-4">
			<div class="w-full max-w-md space-y-8">
				<!-- Logo -->
				<div class="flex justify-center">
					if props.LogoURL != "" {
						<img src={ props.LogoURL } alt="Compass.AI Logo" class="h-12 w-auto"/>
					} else {
						<div class="h-12 w-12 mx-auto flex items-center justify-center bg-primary text-primary-foreground rounded-full">
							<svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="compass-spin-slow">
								<!-- Outer ring -->
								<circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1.5" fill="none"></circle>
								<!-- Cardinal points -->
								<line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
								<line x1="30" y1="16" x2="26" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
								<line x1="16" y1="30" x2="16" y2="26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
								<line x1="2" y1="16" x2="6" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
								<!-- Needle -->
								<path d="M16 8 L18.5 14 L16 13 L13.5 14 Z" fill="currentColor"></path>
								<path d="M16 24 L13.5 18 L16 19 L18.5 18 Z" fill="currentColor" opacity="0.6"></path>
								<!-- Center dot -->
								<circle cx="16" cy="16" r="1.5" fill="currentColor"></circle>
							</svg>
						</div>
					}
				</div>
				<!-- Main Content Card -->
				@card.Card(card.Props{
					Class: "w-full",
				}) {
					@card.Header(card.HeaderProps{}) {
						@card.Title(card.TitleProps{
							Class: "text-center text-2xl font-bold",
						}) {
							{ props.Title }
						}
						if props.Description != "" {
							@card.Description(card.DescriptionProps{
								Class: "text-center",
							}) {
								{ props.Description }
							}
						}
					}
					@card.Content(card.ContentProps{}) {
						{ children... }
					}
				}
				<!-- Footer Links -->
				<div class="text-center text-sm text-muted-foreground">
					<div class="space-x-4">
						<a href="/privacy" class="hover:text-foreground">{ i18n.T(ctx, "Privacy") }</a>
						<span>•</span>
						<a href="/terms" class="hover:text-foreground">{ i18n.T(ctx, "Terms") }</a>
						<span>•</span>
						<a href="/support" class="hover:text-foreground">{ i18n.T(ctx, "Support") }</a>
					</div>
					<div class="mt-2 text-xs">
						© { templ.EscapeString(getCurrentYear()) } Compass.AI. { i18n.T(ctx, "All rights reserved.") }
					</div>
				</div>
			</div>
		</main>
	}
}

func getCurrentYear() string {
	return "2026"
}
