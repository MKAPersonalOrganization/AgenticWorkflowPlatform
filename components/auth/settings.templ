package auth

import (
	"school-with-ai/components"
	"school-with-ai/components/button"
	"school-with-ai/components/card"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/domain"
)

type SettingsPageProps struct {
	User *domain.User
}

// SettingsPage renders the account & security management page.
templ SettingsPage(props SettingsPageProps) {
	@components.AppLayout(components.AppLayoutProps{
		Title: i18n.T(ctx, "Account Settings"),
		User:  props.User,
	}) {
		<div class="container mx-auto max-w-2xl p-6 space-y-6">
			<!-- Header -->
			<div class="flex items-center gap-4">
				<a href="/">
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
					}) {
						@icon.ArrowLeft(icon.Props{Class: "size-5"})
						<span class="sr-only">{ i18n.T(ctx, "Back") }</span>
					}
				</a>
				<div class="flex-1">
					<h1 class="text-3xl font-bold tracking-tight">{ i18n.T(ctx, "Account Settings") }</h1>
					<p class="text-muted-foreground mt-1">{ i18n.T(ctx, "Manage your account and security") }</p>
				</div>
			</div>
			<!-- Profile Card -->
			@card.Card(card.Props{}) {
				@card.Header(card.HeaderProps{}) {
					@card.Title(card.TitleProps{}) {
						<div class="flex items-center gap-2">
							@icon.User(icon.Props{Class: "size-5"})
							<span>{ i18n.T(ctx, "Profile") }</span>
						</div>
					}
					@card.Description(card.DescriptionProps{}) {
						{ i18n.T(ctx, "Your profile is managed by your Google account.") }
					}
				}
				@card.Content(card.ContentProps{}) {
					<div class="flex items-center gap-5">
						<!-- Avatar -->
						if props.User.Picture != "" {
							<img
								src={ props.User.Picture }
								alt={ props.User.GetDisplayName() }
								class="size-16 rounded-full ring-2 ring-border"
								referrerpolicy="no-referrer"
							/>
						} else {
							<div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-2xl ring-2 ring-border">
								{ string([]rune(props.User.GetDisplayName())[0:1]) }
							</div>
						}
						<div class="space-y-1 min-w-0">
							<div class="text-lg font-semibold text-foreground truncate">
								{ props.User.GetDisplayName() }
							</div>
							<div class="text-sm text-muted-foreground truncate">
								{ props.User.Email }
							</div>
							<div class="flex items-center gap-1.5 mt-1">
								<span class="inline-flex items-center rounded-full bg-green-500/10 px-2 py-0.5 text-xs font-medium text-green-600 dark:text-green-400 ring-1 ring-inset ring-green-500/20">
									@icon.ShieldCheck(icon.Props{Class: "size-3 mr-0.5"})
									{ i18n.T(ctx, "Google Verified") }
								</span>
								<span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">
									{ props.User.Role }
								</span>
							</div>
						</div>
					</div>
					<p class="text-xs text-muted-foreground mt-4">
						{ i18n.T(ctx, "To update your name or photo, visit") }
						<a
							href="https://myaccount.google.com/personal-info"
							target="_blank"
							rel="noopener noreferrer"
							class="text-primary hover:underline inline-flex items-center gap-0.5"
						>
							{ i18n.T(ctx, "Google Account Settings") }
							@icon.ExternalLink(icon.Props{Class: "size-3"})
						</a>
						{ i18n.T(ctx, ". Changes will sync on your next login.") }
					</p>
				}
			}
			<!-- Security Card -->
			@card.Card(card.Props{}) {
				@card.Header(card.HeaderProps{}) {
					@card.Title(card.TitleProps{}) {
						<div class="flex items-center gap-2">
							@icon.Shield(icon.Props{Class: "size-5"})
							<span>{ i18n.T(ctx, "Security") }</span>
						</div>
					}
					@card.Description(card.DescriptionProps{}) {
						{ i18n.T(ctx, "Authentication and session management") }
					}
				}
				@card.Content(card.ContentProps{}) {
					<div class="space-y-4">
						<!-- Authentication method -->
						<div class="flex items-center justify-between p-3 rounded-xl border border-border">
							<div class="flex items-center gap-3">
								<div class="size-9 rounded-lg bg-background border border-border flex items-center justify-center">
									<svg class="size-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
										<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
										<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
										<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
									</svg>
								</div>
								<div>
									<div class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Google Sign-In") }</div>
									<div class="text-xs text-muted-foreground">{ props.User.Email }</div>
								</div>
							</div>
							<span class="inline-flex items-center rounded-full bg-green-500/10 px-2.5 py-0.5 text-xs font-medium text-green-600 dark:text-green-400 ring-1 ring-inset ring-green-500/20">
								{ i18n.T(ctx, "Connected") }
							</span>
						</div>
						<!-- Session management -->
						<div class="flex items-center justify-between p-3 rounded-xl border border-border">
							<div class="flex items-center gap-3">
								@icon.LogOut(icon.Props{Class: "size-5 text-muted-foreground"})
								<div>
									<div class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Active Session") }</div>
									<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "Sign out of your current session") }</div>
								</div>
							</div>
							<a href="/auth/logout">
								@button.Button(button.Props{
									Variant: button.VariantOutline,
									Size:    button.SizeSm,
								}) {
									{ i18n.T(ctx, "Sign Out") }
								}
							</a>
						</div>
					</div>
				}
			}
			<!-- Danger Zone Card -->
			@card.Card(card.Props{Class: "border-destructive/30"}) {
				@card.Header(card.HeaderProps{}) {
					@card.Title(card.TitleProps{Class: "text-destructive"}) {
						<div class="flex items-center gap-2">
							@icon.TriangleAlert(icon.Props{Class: "size-5"})
							<span>{ i18n.T(ctx, "Danger Zone") }</span>
						</div>
					}
				}
				@card.Content(card.ContentProps{}) {
					<div class="flex items-center justify-between p-3 rounded-xl border border-destructive/20 bg-destructive/5">
						<div>
							<div class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Delete Account") }</div>
							<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "Permanently delete your account and all data. This cannot be undone.") }</div>
						</div>
						@button.Button(button.Props{
							Variant:  button.VariantDestructive,
							Size:     button.SizeSm,
							Disabled: true,
						}) {
							@icon.UserX(icon.Props{Class: "size-4 mr-1"})
							{ i18n.T(ctx, "Delete Account") }
						}
					</div>
				}
			}
		</div>
	}
}
