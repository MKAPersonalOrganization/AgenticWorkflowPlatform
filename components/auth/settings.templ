package auth

import client "github.com/ory/client-go"
import "school-with-ai/components/button"
import "school-with-ai/components/icon"
import "school-with-ai/components"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"
import "strings"

type SettingsPageProps struct {
	FlowAction     string
	FlowMethod     string
	Messages       []UIMessage
	LogoutURL      string
	User           *domain.User
	SuccessMessage string
}

// SettingsPageWithNodes renders the settings page with all Kratos UI nodes
// SettingsPageWithNodes renders the settings page with all Kratos UI nodes
templ SettingsPageWithNodes(nodes []client.UiNode, props SettingsPageProps) {
	@components.AppLayout(components.AppLayoutProps{
		Title: i18n.T(ctx, "Account Settings"),
		User:  props.User,
	}) {
		<div class="container mx-auto max-w-2xl py-8">
			<!-- Main Settings Panel -->
			<div class="bg-background rounded-2xl border border-border shadow-sm overflow-hidden">
				<!-- Header -->
				<div class="flex items-center gap-4 p-6 border-b border-border bg-muted/20">
					<a href="/">
						@button.Button(button.Props{
							Variant: button.VariantGhost,
							Size:    button.SizeIcon,
							Class:   "rounded-full hover:bg-background",
						}) {
							@icon.ArrowLeft(icon.Props{Class: "size-5"})
							<span class="sr-only">{ i18n.T(ctx, "Back to Chat") }</span>
						}
					</a>
					<div class="flex-1">
						<h1 class="text-xl font-semibold tracking-tight text-foreground">{ i18n.T(ctx, "Account Settings") }</h1>
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "Manage your profile and security") }</p>
					</div>
				</div>
				<!-- Content -->
				<div class="p-6">
					<!-- Success Message -->
					if props.SuccessMessage != "" {
						<div class="rounded-xl border border-primary/20 bg-primary/5 p-4 mb-6">
							<div class="flex items-start gap-3">
								<div class="mt-0.5">
									@icon.CircleCheck(icon.Props{Class: "size-5 text-primary"})
								</div>
								<p class="text-sm text-primary">{ props.SuccessMessage }</p>
							</div>
						</div>
					}
					<!-- Flow Messages -->
					if len(props.Messages) > 0 {
						<div class="mb-6">
							@Messages(MessagesProps{Messages: props.Messages})
						</div>
					}
					<!-- Settings Form -->
					if props.FlowAction != "" {
						@Form(FormProps{
							Action: props.FlowAction,
							Method: props.FlowMethod,
							Class:  "space-y-8",
						}) {
							<!-- Profile Settings -->
							{{ profileNodes := filterNodesByGroup(nodes, "profile") }}
							if len(profileNodes) > 0 {
								<div class="space-y-4">
									<div class="flex items-center gap-2 pb-2 border-b border-border/50">
										@icon.User(icon.Props{Class: "size-4 text-muted-foreground"})
										<h1 class="font-medium text-sm text-foreground">{ i18n.T(ctx, "Profile Information") }</h1>
									</div>
									<div class="px-2">
										@UINodes(UINodesProps{
											Nodes:  profileNodes,
											Groups: []string{"profile"},
										})
									</div>
								</div>
							}
							<!-- Password Settings -->
							{{ passwordNodes := filterNodesByGroup(nodes, "password") }}
							if len(passwordNodes) > 0 {
								<div class="space-y-4">
									<div class="flex items-center gap-2 pb-2 border-b border-border/50">
										@icon.Lock(icon.Props{Class: "size-4 text-muted-foreground"})
										<h1 class="font-medium text-sm text-foreground">{ i18n.T(ctx, "Change Password") }</h1>
									</div>
									<div class="px-2">
										@UINodes(UINodesProps{
											Nodes:  passwordNodes,
											Groups: []string{"password"},
										})
									</div>
								</div>
							}
							<!-- Social Accounts (OIDC link/unlink) -->
							{{ oidcNodes := filterNodesByGroup(nodes, "oidc") }}
							if len(oidcNodes) > 0 {
								<div class="space-y-4">
									<div class="flex items-center gap-2 pb-2 border-b border-border/50">
										@icon.Link(icon.Props{Class: "size-4 text-muted-foreground"})
										<h1 class="font-medium text-sm text-foreground">{ i18n.T(ctx, "Connected Accounts") }</h1>
									</div>
									<div class="px-2 space-y-3">
										for _, node := range oidcNodes {
											if node.Attributes.UiNodeInputAttributes != nil {
												@renderOIDCSettingsNode(node)
											}
										}
									</div>
								</div>
							}
							<!-- Default/Other Settings -->
							{{ defaultNodes := filterNodesByGroup(nodes, "default") }}
							if len(defaultNodes) > 0 {
								<div class="pt-4 border-t border-border">
									@UINodes(UINodesProps{
										Nodes:  defaultNodes,
										Groups: []string{"default"},
									})
								</div>
							}
						}
					}
				</div>
			</div>
		</div>
	}
}

func filterNodesByGroup(nodes []client.UiNode, group string) []client.UiNode {
	var filtered []client.UiNode
	for _, node := range nodes {
		if node.Group == group {
			filtered = append(filtered, node)
		}
	}
	return filtered
}

// renderOIDCSettingsNode renders a single OIDC link/unlink button in settings
templ renderOIDCSettingsNode(node client.UiNode) {
	{{ attrs := node.Attributes.UiNodeInputAttributes }}
	{{ providerID := stringValue(attrs.Value) }}
	{{ isUnlink := attrs.Name == "unlink" }}
	{{ label := getNodeLabel(node) }}
	<div class="flex items-center justify-between rounded-lg border border-border px-4 py-3">
		<div class="flex items-center gap-3">
			@socialProviderIcon(providerID)
			<div>
				<p class="text-sm font-medium text-foreground">{ capitalizeProvider(providerID) }</p>
				if isUnlink {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Connected") }</p>
				} else {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Not connected") }</p>
				}
			</div>
		</div>
		<button
			type="submit"
			name={ attrs.Name }
			value={ providerID }
			if isUnlink {
				class="inline-flex items-center justify-center rounded-md border border-border bg-background px-3 py-1.5 text-xs font-medium text-destructive transition-colors hover:bg-destructive/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
			} else {
				class="inline-flex items-center justify-center rounded-md border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
			}
			if boolValue(attrs.Disabled) {
				disabled
			}
		>
			{ label }
		</button>
	</div>
}

func capitalizeProvider(id string) string {
	normalized := normalizeProviderID(id)
	if len(normalized) == 0 {
		return id
	}
	return strings.ToUpper(normalized[:1]) + normalized[1:]
}
