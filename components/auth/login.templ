package auth

import client "github.com/ory/client-go"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"

type LoginPageProps struct {
	FlowAction      string
	FlowMethod      string
	Messages        []UIMessage
	RecoveryURL     string
	RegistrationURL string
	User            *domain.User
}

// LoginPage renders the login page with a slot for form content
templ LoginPage(props LoginPageProps) {
	@AuthLayout(LayoutProps{
		Title:       i18n.T(ctx, "Sign In"),
		Description: i18n.T(ctx, "Enter your credentials to access your account"),
		User:        props.User,
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		<!-- Login Form -->
		if props.FlowAction != "" {
			@Form(FormProps{
				Action: props.FlowAction,
				Method: props.FlowMethod,
			}) {
				{ children... }
			}
			<!-- Additional Links -->
			<div class="mt-4 space-y-2 text-center text-sm">
				if props.RecoveryURL != "" {
					<div>
						<a href={ templ.SafeURL(props.RecoveryURL) } class="text-primary hover:underline">
							{ i18n.T(ctx, "Forgot your password?") }
						</a>
					</div>
				}
				if props.RegistrationURL != "" {
					<div class="text-muted-foreground">
						{ i18n.T(ctx, "Don't have an account?") }
						{ " " }
						<a href={ templ.SafeURL(props.RegistrationURL) } class="text-primary hover:underline">
							{ i18n.T(ctx, "Create one") }
						</a>
					</div>
				}
			</div>
		}
	}
}

// LoginPageWithNodes renders the login page with Kratos UI nodes
templ LoginPageWithNodes(nodes []client.UiNode, props LoginPageProps) {
	@AuthLayout(LayoutProps{
		Title:       i18n.T(ctx, "Sign In"),
		Description: i18n.T(ctx, "Welcome back! Choose how you'd like to sign in."),
		User:        props.User,
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		if props.FlowAction != "" {
			<!-- 1. Social login buttons (Google, etc.) — always first -->
			if hasOIDCNodes(nodes) {
				@OIDCNodes(nodes, props.FlowAction, props.FlowMethod)
			}
			<!-- 2. Divider between social and password login -->
			if hasOIDCNodes(nodes) && hasNonOIDCNodes(nodes, []string{"password"}) {
				@AuthDivider()
			}
			<!-- 3. Email + password form -->
			if hasNonOIDCNodes(nodes, []string{"password"}) {
				@Form(FormProps{
					Action: props.FlowAction,
					Method: props.FlowMethod,
				}) {
					@UINodes(UINodesProps{
						Nodes:  nodes,
						Groups: []string{"default", "password"},
					})
				}
				<!-- Forgot password link — placed right after the form -->
				if props.RecoveryURL != "" {
					<div class="mt-2 text-right text-sm">
						<a href={ templ.SafeURL(props.RecoveryURL) } class="text-muted-foreground hover:text-primary hover:underline">
							{ i18n.T(ctx, "Forgot your password?") }
						</a>
					</div>
				}
			}
			<!-- 4. Sign up link — always at the bottom -->
			if props.RegistrationURL != "" {
				<div class="mt-6 text-center text-sm text-muted-foreground">
					{ i18n.T(ctx, "Don't have an account?") }
					{ " " }
					<a href={ templ.SafeURL(props.RegistrationURL) } class="font-medium text-primary hover:underline">
						{ i18n.T(ctx, "Create one") }
					</a>
				</div>
			}
		}
	}
}
