package auth

import client "github.com/ory/client-go"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"

type VerificationPageProps struct {
	FlowAction string
	FlowMethod string
	Messages   []UIMessage
	LoginURL   string
	User       *domain.User
}

// VerificationPage renders the email verification page with a slot for form content
templ VerificationPage(props VerificationPageProps) {
	@AuthLayout(LayoutProps{
		Title:       i18n.T(ctx, "Verify Your Email"),
		Description: i18n.T(ctx, "Enter the verification code sent to your email"),
		User:        props.User,
	}) {
		<!-- Flow-level messages -->
		if len(props.Messages) > 0 {
			@Messages(MessagesProps{Messages: props.Messages})
		}
		<!-- Verification Form -->
		if props.FlowAction != "" {
			@Form(FormProps{
				Action: props.FlowAction,
				Method: props.FlowMethod,
			}) {
				{ children... }
			}
			<!-- Additional Links -->
			<div class="mt-4 text-center text-sm">
				if props.LoginURL != "" {
					<div class="text-muted-foreground">
						{ i18n.T(ctx, "Already verified?") }
						{ " " }
						<a href={ templ.SafeURL(props.LoginURL) } class="text-primary hover:underline">
							{ i18n.T(ctx, "Sign in") }
						</a>
					</div>
				}
			</div>
		}
	}
}

// VerificationPageWithNodes renders the verification page with Kratos UI nodes
templ VerificationPageWithNodes(nodes []client.UiNode, props VerificationPageProps) {
	@VerificationPage(props) {
		@UINodes(UINodesProps{
			Nodes:  nodes,
			Groups: []string{"default", "code", "link"},
		})
	}
}
