package banner

import (
	"aicompass/components/button"
	"aicompass/components/i18n"
	"aicompass/components/icon"
	"aicompass/components/utils"
)

type Props struct {
	Class string
}

templ Banner(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		x-show="banner && (banner.persistable || !bannerDismissedIds.includes(banner.id))"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		class={ utils.TwMerge(
            "relative flex items-center justify-center w-full px-4 py-1.5 text-sm text-center text-foreground bg-accent/40 backdrop-blur-sm z-50 border-b border-border/40",
            p.Class,
        ) }
		style="display: none;"
	>
		<div class="flex-1 [&_a]:underline [&_a]:text-primary hover:[&_a]:text-primary/80 font-medium" x-html="banner?.message"></div>
		<template x-if="banner && !banner.persistable">
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "absolute end-2 top-1/2 -translate-y-1/2 size-6 text-muted-foreground hover:text-foreground hover:bg-accent/50 rounded-full",
				Attributes: templ.Attributes{
					"@click":     "dismissBanner()",
					"aria-label": i18n.T(ctx, "Dismiss banner"),
				},
			}) {
				@icon.X(icon.Props{Class: "size-3.5"})
			}
		</template>
	</div>
}
