package nav

import (
	a2acomp "aicompass/components/a2a"
	"aicompass/components/button"
	"aicompass/components/evals"
	"aicompass/components/filesystem"
	"aicompass/components/i18n"
	"aicompass/components/icon"
	"aicompass/components/resources"
	"aicompass/components/threads"
	"aicompass/components/tools"
	"aicompass/shared"
)

type NavbarProps struct {
	Class string
	User  *shared.User // Authenticated user (nil if not authenticated)
}

templ Navbar(props ...NavbarProps) {
	{{ var p NavbarProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<style>
		/* ── Premium Navbar ── */
		#main-navbar .nav-item button {
			border-radius: 10px !important;
			transition: background 0.15s ease, color 0.15s ease,
				transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
				box-shadow 0.15s ease;
		}
		#main-navbar .nav-item button:hover {
			background: hsl(var(--accent)) !important;
			color: hsl(var(--accent-foreground)) !important;
			transform: scale(1.1) translateY(-1px);
			box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
		}
		#main-navbar .nav-item button:active {
			transform: scale(0.94) !important;
			transition-duration: 0.07s !important;
		}
		/* Brand logo wrapper pulse-on-hover */
		#main-navbar .nav-brand:hover svg {
			filter: drop-shadow(0 0 6px hsl(var(--primary) / 0.5));
		}
		/* Token-driven rotation — smooth step per token */
		#main-navbar .nav-brand svg {
			transition: transform 0.12s linear;
		}
	</style>
	<script>
		(function () {
			let _angle = 0;
			window.addEventListener('ai-token', function () {
				_angle += 1;
				const svg = document.querySelector('#main-navbar .nav-brand svg');
				if (svg) svg.style.transform = 'rotate(' + _angle + 'deg)';
			});
		})();
	</script>
	<!-- Left Navigation Bar -->
	<nav
		class={ "h-full w-[52px] flex flex-col items-center pb-3 gap-0.5 shrink-0 z-40 bg-sidebar border-e border-sidebar-border/50 shadow-[1px_0_20px_rgba(0,0,0,0.06)]", p.Class }
		id="main-navbar"
	>
		<!-- Brand Logo -->
		<a
			href="/"
			class="nav-brand flex items-center justify-center w-full h-[52px] shrink-0 transition-opacity duration-200 hover:opacity-80"
			title="Home"
		>
			@icon.CompassLogoAnimated("size-[22px] text-primary")
		</a>
		<!-- Top divider -->
		<div class="w-6 h-px bg-linear-to-r from-transparent via-sidebar-border to-transparent shrink-0 mb-0.5"></div>
		if p.User != nil {
			<!-- Chat History -->
			<div class="nav-item w-full flex justify-center">
				@threads.ThreadsButtonTrigger()
			</div>
			<!-- Group divider -->
			<div class="w-5 h-px bg-linear-to-r from-transparent via-sidebar-border/50 to-transparent my-1 shrink-0 hidden md:block"></div>
			<!-- A2A -->
			<div class="nav-item hidden md:flex w-full justify-center">
				@a2acomp.A2AButtonTrigger()
			</div>
			<!-- Plugins & Tools -->
			<div class="nav-item hidden md:flex w-full justify-center">
				@tools.ToolsButtonTrigger()
			</div>
			<!-- Evaluation -->
			<div class="nav-item hidden md:flex w-full justify-center">
				@evals.EvalSetsButtonTrigger()
			</div>
		}
		<!-- Admin Indicator -->
		if p.User != nil && p.User.Role == "admin" {
			<div class="nav-item hidden md:flex w-full justify-center mt-0.5">
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-9 text-yellow-500",
					Attributes: templ.Attributes{
						"title": i18n.T(ctx, "Administrator"),
					},
				}) {
					@icon.Shield(icon.Props{Class: "size-5"})
					<span class="sr-only">{ i18n.T(ctx, "Administrator") }</span>
				}
			</div>
		}
		<!-- Spacer -->
		<div class="flex-1"></div>
		<!-- Bottom-pinned: Filesystem + Knowledge -->
		if p.User != nil {
			<div class="hidden md:flex flex-col items-center gap-0.5 w-full bg-sidebar-accent/30 rounded-xl py-1 px-0.5 mb-1 mx-1">
				<div class="nav-item w-full flex justify-center">
					@filesystem.FilesystemButtonTrigger()
				</div>
				<div class="nav-item w-full flex justify-center">
					@resources.ResourcesButtonTrigger()
				</div>
			</div>
		}
		<!-- Separator -->
		<div class="w-6 h-px bg-linear-to-r from-transparent via-sidebar-border/60 to-transparent my-1 shrink-0"></div>
		<!-- Account Settings -->
		@AccountSettings(AccountSettingsProps{
			User:    p.User,
			ID:      "navbar-account-settings",
			Compact: true,
		})
	</nav>
}
