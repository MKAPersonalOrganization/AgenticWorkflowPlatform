package nav

import (
	"school-with-ai/components/agents"
	"school-with-ai/components/button"
	"school-with-ai/components/convsearch"
	"school-with-ai/components/filesystem"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/resources"
	"school-with-ai/components/threads"
	"school-with-ai/components/tools"
	"school-with-ai/shared"
)

type NavbarProps struct {
	Class string
	User  *shared.User // Authenticated user (nil if not authenticated)
}

templ Navbar(props ...NavbarProps) {
	{{ var p NavbarProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<!-- Left Navigation Bar -->
	<nav
		class={ "h-full w-12 bg-sidebar flex flex-col items-center py-4 gap-4 transition-opacity duration-200 border-e border-sidebar-border shrink-0 z-40", p.Class }
		id="main-navbar"
	>
		if p.User != nil {
			<!-- Chat History Button -->
			@threads.ThreadsButtonTrigger()
			<!-- Resources Button -->
			<div class="hidden md:block">
				@resources.ResourcesButtonTrigger()
			</div>
			<!-- Tools Button -->
			<div class="hidden md:block">
				@tools.ToolsButtonTrigger()
			</div>
			<!-- Agent Store Button -->
			<div class="hidden md:block">
				@agents.AgentStoreNavButtonTrigger()
			</div>
			<!-- Search Conversations Button -->
			<div class="hidden md:block">
				@convsearch.SearchButtonTrigger()
			</div>
			<!-- Filesystems Button -->
			<div class="hidden md:block">
				@filesystem.FilesystemButtonTrigger()
			</div>
		}
		<!-- Admin Indicator -->
		if p.User != nil && p.User.Role == "admin" {
			<div class="hidden md:block">
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-9 text-yellow-500",
					Attributes: templ.Attributes{
						"title": i18n.T(ctx, "Administrator"),
					},
				}) {
					@icon.Shield(icon.Props{Class: "size-5"})
					<span class="sr-only">{ i18n.T(ctx, "Administrator") }</span>
				}
			</div>
		}
		<!-- Spacer to push account settings to bottom -->
		<div class="flex-1"></div>
		<!-- User Profile / Settings Menu (at bottom) -->
		@AccountSettings(AccountSettingsProps{
			User:    p.User,
			ID:      "navbar-account-settings",
			Compact: true,
		})
	</nav>
}
