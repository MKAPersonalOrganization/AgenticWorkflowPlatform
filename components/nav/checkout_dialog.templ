package nav

import (
	"aicompass/components/button"
	"aicompass/components/i18n"
	"aicompass/components/icon"
)

// checkoutDialog is the global Stripe Elements payment modal.
// It is opened via the Alpine event open-checkout-dialog dispatched from
// the pricing dialog or any "Activate" button.
//
// Uses Stripe's recommended integration:
//   1. POST /api/billing/create-payment-intent → { clientSecret, publishableKey }
//   2. Initialize Stripe.js + mount the Payment Element (Appearance API)
//   3. User enters card → stripe.confirmPayment({ confirmParams: { return_url } })
//   4. Stripe redirects to return_url on success
//
// No raw card data ever reaches the application server (PCI SAQ-A).
templ checkoutDialog() {
	<div
		x-data="{
		open: false,
		stripe: null,
		elements: null,
		paymentElement: null,
		clientSecret: '',
		processing: false,
		succeeded: false,
		errorMsg: '',
		ready: false,
		loading: false,

		async load() {
			if (this.loading) return;
			this.open = true;
			this.errorMsg = '';
			this.processing = false;
			this.succeeded = false;
			this.ready = false;
			this.loading = true;

			try {
				const res = await fetch('/api/billing/create-payment-intent', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					credentials: 'same-origin',
				});
				if (!res.ok) {
					const body = await res.json().catch(() => ({}));
					if (res.status === 409) {
						this.succeeded = true;
						this.errorMsg = '';
						this.loading = false;
						return;
					}
					this.errorMsg = body.error || 'Failed to initialize payment. Please try again.';
					this.loading = false;
					return;
				}
				const data = await res.json();
				this.clientSecret = data.clientSecret;

				if (!this.stripe) {
					this.stripe = Stripe(data.publishableKey);
				}

				await this.$nextTick();

				// Use Stripe's built-in themes — 'stripe' for light, 'night' for dark.
				// Stripe handles all input styling, focus states, and validation visuals.
				const appearance = {
					theme: document.documentElement.classList.contains('dark') ? 'night' : 'stripe',
				};

				// Initialize Stripe Elements with clientSecret + appearance
				if (this.paymentElement) { this.paymentElement.destroy(); }
				this.elements = this.stripe.elements({
					clientSecret: this.clientSecret,
					appearance: appearance,
				});

				this.paymentElement = this.elements.create('payment', {
					layout: 'tabs',
				});
				this.paymentElement.mount('#dialog-payment-element');
				this.paymentElement.on('change', (event) => {
					this.ready = event.complete;
					if (event.complete) this.errorMsg = '';
				});
				this.paymentElement.on('loaderror', (event) => {
					this.errorMsg = 'Failed to load payment form. Please refresh and try again.';
				});
			} catch (err) {
				this.errorMsg = 'Something went wrong. Please try again.';
				console.error('stripe init error', err);
			}
			this.loading = false;
		},

		close() {
			this.open = false;
			if (this.paymentElement) { this.paymentElement.destroy(); this.paymentElement = null; }
			this.elements = null;
			this.loading = false;
		},

		async submit() {
			if (this.processing || !this.clientSecret || !this.ready) return;
			this.processing = true;
			this.errorMsg = '';

			try {
				const { error } = await this.stripe.confirmPayment({
					elements: this.elements,
					confirmParams: {
						return_url: window.location.origin + '/?redirect_status=succeeded',
					},
				});
				// If we reach here, there was an immediate error
				// (successful payments redirect, so this code only runs on failure)
				if (error) {
					if (error.type === 'card_error' || error.type === 'validation_error') {
						this.errorMsg = error.message;
					} else if (error.type === 'invalid_request_error') {
						this.errorMsg = 'Payment request was invalid. Please try again.';
					} else {
						this.errorMsg = 'An unexpected error occurred. Please try again.';
					}
					console.error('stripe payment error', error.type, error.code, error.message);
				}
			} catch (err) {
				this.errorMsg = 'Payment failed. Please check your connection and try again.';
				console.error('stripe confirm error', err);
			}
			this.processing = false;
		}
	}"
		@open-checkout-dialog.window="load()"
	>
		<!-- Backdrop -->
		<div
			class="fixed inset-0 z-[60] bg-black/50 transition-opacity"
			x-show="open"
			x-transition:enter="ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			style="display: none;"
			aria-hidden="true"
		></div>
		<!-- Modal Container -->
		<div
			class="fixed inset-0 z-[60] flex items-center justify-center p-4"
			x-show="open"
			style="display: none;"
			@click.self="close()"
		>
			<div
				class="relative w-full max-w-md max-h-[90vh] bg-background rounded-lg shadow-lg flex flex-col overflow-hidden border border-border"
				x-show="open"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@keydown.escape.window="close()"
			>
				<!-- Header -->
				<div class="flex items-center justify-between p-6 pb-4 border-b border-border">
					<div class="space-y-1">
						<h2 class="text-lg font-semibold leading-none tracking-tight">{ i18n.T(ctx, "Complete Your Purchase") }</h2>
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "$5/month — Full Access subscription") }</p>
					</div>
					<button
						type="button"
						class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
						@click="close()"
					>
						@icon.X(icon.Props{Class: "size-4"})
						<span class="sr-only">Close</span>
					</button>
				</div>
				<!-- Body -->
				<div class="flex-1 overflow-auto p-6 space-y-6">
					<!-- Order summary -->
					<div class="flex items-center justify-between p-4 rounded-lg bg-muted/50 border border-border">
						<div>
							<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "Full Access — monthly subscription") }</div>
							<div class="text-2xl font-bold tracking-tight mt-1">{ i18n.T(ctx, "$5.00") }</div>
							<div class="text-[10px] text-muted-foreground mt-1">{ i18n.T(ctx, "Billed monthly • Cancel anytime") }</div>
						</div>
						@icon.CreditCard(icon.Props{Class: "size-6 text-muted-foreground"})
					</div>
					<!-- Loading skeleton -->
					<div x-show="loading" x-cloak class="space-y-4 animate-pulse">
						<div class="h-4 bg-muted rounded w-1/3"></div>
						<div class="h-10 bg-muted rounded"></div>
						<div class="h-4 bg-muted rounded w-1/4"></div>
						<div class="flex gap-4">
							<div class="h-10 bg-muted rounded flex-1"></div>
							<div class="h-10 bg-muted rounded flex-1"></div>
						</div>
						<div class="h-10 bg-muted rounded"></div>
					</div>
					<!-- Error message -->
					<div x-show="errorMsg" x-cloak class="rounded-lg border border-destructive bg-destructive/10 p-3">
						<p class="text-sm text-destructive" x-text="errorMsg"></p>
					</div>
					<!-- Success message -->
					<div x-show="succeeded" x-cloak class="rounded-xl border border-green-500/20 bg-gradient-to-br from-green-500/5 to-transparent p-6 text-center space-y-4">
						<div class="flex justify-center">
							<div class="flex items-center justify-center size-14 rounded-full bg-green-500/10 ring-2 ring-green-500/20">
								@icon.BadgeCheck(icon.Props{Class: "size-8 text-green-600 dark:text-green-400"})
							</div>
						</div>
						<div class="space-y-1">
							<p class="text-base font-semibold text-foreground">{ i18n.T(ctx, "You're all set!") }</p>
							<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "Your Full Access subscription is now active.") }</p>
						</div>
						<div class="flex flex-wrap items-center justify-center gap-2 text-xs text-muted-foreground">
							<span class="inline-flex items-center gap-1 rounded-full bg-green-500/10 px-2.5 py-0.5 text-green-600 dark:text-green-400 ring-1 ring-inset ring-green-500/20 font-medium">
								@icon.Sparkles(icon.Props{Class: "size-3"})
								{ i18n.T(ctx, "Unlimited conversations") }
							</span>
							<span class="inline-flex items-center gap-1 rounded-full bg-green-500/10 px-2.5 py-0.5 text-green-600 dark:text-green-400 ring-1 ring-inset ring-green-500/20 font-medium">
								@icon.Sparkles(icon.Props{Class: "size-3"})
								{ i18n.T(ctx, "All AI models") }
							</span>
						</div>
						<p class="text-xs text-muted-foreground animate-pulse">{ i18n.T(ctx, "Redirecting to your dashboard…") }</p>
					</div>
					<!-- Stripe Payment Element -->
					<div x-show="!succeeded && !loading">
						<div
							id="dialog-payment-element"
							class="min-h-[120px]"
						></div>
					</div>
				</div>
				<!-- Footer -->
				<div class="p-4 border-t border-border flex items-center justify-between bg-background">
					<p class="text-[10px] text-muted-foreground max-w-[180px] leading-relaxed">
						{ i18n.T(ctx, "Secure payment powered by Stripe") }
					</p>
					<div class="flex gap-2">
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
							Attributes: templ.Attributes{
								"@click":  "close()",
								"x-show":  "!succeeded",
								"x-cloak": "",
							},
						}) {
							{ i18n.T(ctx, "Cancel") }
						}
						<div x-show="!succeeded" x-cloak>
							@button.Button(button.Props{
								Type: button.TypeButton,
								Attributes: templ.Attributes{
									"@click":    "submit()",
									":disabled": "processing || !ready",
								},
							}) {
								<span x-show="!processing" class="flex items-center gap-2">
									@icon.Lock(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "Pay $5.00") }
								</span>
								<span x-show="processing" class="flex items-center gap-2">
									<span class="size-4 rounded-full border-2 border-primary-foreground border-t-transparent animate-spin"></span>
									{ i18n.T(ctx, "Processing…") }
								</span>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
