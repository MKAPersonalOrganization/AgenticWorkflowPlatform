package nav

import (
	"school-with-ai/components/button"
	"school-with-ai/components/icon"
	"school-with-ai/components/i18n"
)

templ checkoutDialog() {
	<div x-data="{
		open: false,
		plan: null,
		paymentMethod: 'card',
		cardNumber: '',
		expiry: '',
		cvv: '',
		cardholderName: '',
		cardType: '',
		submitting: false,

		load(detail) {
			this.plan = detail;
			this.open = true;
			this.paymentMethod = 'card';
			this.cardNumber = '';
			this.expiry = '';
			this.cvv = '';
			this.cardholderName = '';
			this.cardType = '';
			this.submitting = false;
		},
		close() {
			this.open = false;
		},
		formatCardNumber(value) {
			let cleaned = value.replace(/\D/g, '').substring(0, 16);
			this.cardNumber = cleaned.match(/.{1,4}/g)?.join(' ') || cleaned;
			this.detectCardType(cleaned);
		},
		formatExpiry(value) {
			let cleaned = value.replace(/\D/g, '').substring(0, 4);
			this.expiry = cleaned.length >= 2 ? cleaned.substring(0, 2) + '/' + cleaned.substring(2) : cleaned;
		},
		formatCVV(value) {
			let maxLen = this.cardType === 'Amex' ? 4 : 3;
			this.cvv = value.replace(/\D/g, '').substring(0, maxLen);
		},
		detectCardType(num) {
			if (num.startsWith('4')) this.cardType = 'Visa';
			else if (num.startsWith('5') || (num.length >= 2 && num.startsWith('2'))) this.cardType = 'Mastercard';
			else if (num.startsWith('34') || num.startsWith('37')) this.cardType = 'Amex';
			else if (num.startsWith('6011') || num.startsWith('65')) this.cardType = 'Discover';
			else this.cardType = '';
		},
		submit() {
			this.submitting = true;
			fetch('/api/subscriptions/checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					plan_id: this.plan?.id,
					payment_method: this.paymentMethod,
					card_number: this.cardNumber.replace(/\s/g, ''),
					expiry: this.expiry,
					cvv: this.cvv,
					cardholder_name: this.cardholderName,
				})
			})
			.then(r => {
				this.submitting = false;
				if (r.ok) {
					this.close();
				}
			})
			.catch(() => { this.submitting = false; });
		}
	}"
	@open-checkout-dialog.window="load($event.detail)"
	>
		<!-- Backdrop -->
		<div
			class="fixed inset-0 z-[60] bg-black/50 transition-opacity"
			x-show="open"
			x-transition:enter="ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			style="display: none;"
			aria-hidden="true"
		></div>
		<!-- Modal Container -->
		<div
			class="fixed inset-0 z-[60] flex items-center justify-center p-4"
			x-show="open"
			style="display: none;"
			@click.self="close()"
		>
			<div
				class="relative w-full max-w-4xl max-h-[90vh] bg-background rounded-lg shadow-lg flex flex-col overflow-hidden border border-border"
				x-show="open"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@keydown.escape.window="close()"
			>
				<!-- Header -->
				<div class="flex items-center justify-between p-6 pb-4 border-b border-border">
					<div class="space-y-1">
						<h2 class="text-lg font-semibold leading-none tracking-tight">{ i18n.T(ctx, "Complete Your Purchase") }</h2>
						<p class="text-sm text-muted-foreground" x-text={ "'" + i18n.T(ctx, "Subscribe to the") + " ' + (plan?.name || '') + ' " + i18n.T(ctx, "plan") + "'" }></p>
					</div>
					<button
						type="button"
						class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
						@click="close()"
					>
						@icon.X(icon.Props{Class: "size-4"})
						<span class="sr-only">Close</span>
					</button>
				</div>
				<!-- Body -->
				<div class="flex-1 overflow-auto">
					<div class="grid grid-cols-1 lg:grid-cols-5 lg:divide-x divide-border">
						<!-- Payment Section -->
						<div class="lg:col-span-3 p-6 space-y-6">
							<div class="space-y-1">
								<h3 class="text-base font-semibold">{ i18n.T(ctx, "Payment Details") }</h3>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Enter your payment information below") }</p>
							</div>
							<!-- Payment Method Selector -->
							<div class="flex gap-2">
								<button
									type="button"
									@click="paymentMethod = 'card'"
									:class="paymentMethod === 'card' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
									class="flex-1 py-2 px-4 font-medium transition-colors rounded-lg text-sm"
								>
									<div class="flex items-center justify-center gap-2">
										@icon.CreditCard(icon.Props{Class: "size-4"})
										<span>{ i18n.T(ctx, "Card") }</span>
									</div>
								</button>
								<button
									type="button"
									@click="paymentMethod = 'paypal'"
									:class="paymentMethod === 'paypal' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
									class="flex-1 py-2 px-4 font-medium transition-colors rounded-lg text-sm"
								>
									<span>{ i18n.T(ctx, "PayPal") }</span>
								</button>
							</div>
							<!-- Card Form -->
							<div x-show="paymentMethod === 'card'" x-transition class="space-y-4">
								<div>
									<div class="flex items-center justify-between mb-1.5">
										<label class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Card Number") }</label>
										<span x-show="cardType" x-text="cardType" class="text-[10px] font-bold px-2 py-1 rounded bg-primary text-primary-foreground"></span>
									</div>
									<input
										type="text"
										x-model="cardNumber"
										@input="formatCardNumber($event.target.value)"
										placeholder="1234 5678 9012 3456"
										autocomplete="cc-number"
										inputmode="numeric"
										class="w-full h-10 px-3 rounded-md border border-input bg-background text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring font-mono tracking-wider"
									/>
								</div>
								<div class="grid grid-cols-2 gap-4">
									<div>
										<label class="text-sm font-medium text-foreground mb-1.5 block">{ i18n.T(ctx, "Expiry Date") }</label>
										<input
											type="text"
											x-model="expiry"
											@input="formatExpiry($event.target.value)"
											placeholder="MM/YY"
											autocomplete="cc-exp"
											inputmode="numeric"
											class="w-full h-10 px-3 rounded-md border border-input bg-background text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring"
										/>
									</div>
									<div>
										<label class="text-sm font-medium text-foreground mb-1.5 block">{ i18n.T(ctx, "CVV") }</label>
										<input
											type="text"
											x-model="cvv"
											@input="formatCVV($event.target.value)"
											placeholder="123"
											autocomplete="cc-csc"
											inputmode="numeric"
											class="w-full h-10 px-3 rounded-md border border-input bg-background text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring"
										/>
									</div>
								</div>
								<div>
									<label class="text-sm font-medium text-foreground mb-1.5 block">{ i18n.T(ctx, "Cardholder Name") }</label>
									<input
										type="text"
										x-model="cardholderName"
										placeholder="John Doe"
										autocomplete="cc-name"
										class="w-full h-10 px-3 rounded-md border border-input bg-background text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring"
									/>
								</div>
							</div>
							<!-- PayPal -->
							<div x-show="paymentMethod === 'paypal'" x-transition class="py-8 text-center">
								<p class="text-sm text-foreground font-medium mb-4">{ i18n.T(ctx, "You will be redirected to PayPal to complete your purchase") }</p>
								<div class="bg-muted border-2 border-dashed border-border rounded-lg p-8">
									<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "PayPal button will appear here") }</p>
								</div>
							</div>
						</div>
						<!-- Order Summary -->
						<div class="lg:col-span-2 p-6 space-y-6 bg-muted/30">
							<div class="space-y-1">
								<h3 class="text-base font-semibold">{ i18n.T(ctx, "Order Summary") }</h3>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Review your purchase details") }</p>
							</div>
							<div class="space-y-4">
								<div class="flex items-center justify-between p-3 rounded-lg bg-background/50 border border-border">
									<div>
										<div class="text-xs text-muted-foreground mb-1">{ i18n.T(ctx, "Plan") }</div>
										<div class="font-semibold" x-text="plan?.name"></div>
									</div>
								</div>
								<div class="flex items-center justify-between py-4 border-t border-border">
									<span class="font-semibold text-sm">{ i18n.T(ctx, "Total due today") }</span>
									<div class="text-right">
										<div class="text-2xl font-bold tracking-tight" x-text="plan?.price"></div>
										<div class="text-xs text-muted-foreground" x-text="plan?.period"></div>
									</div>
								</div>
							</div>
							<!-- Features -->
							<div class="pt-4 border-t border-border">
								<p class="text-xs font-bold mb-3 text-foreground">{ i18n.T(ctx, "What's included:") }</p>
								<ul class="space-y-2">
									<template x-for="feature in (plan?.features || [])" :key="feature">
										<li class="flex items-start gap-2 text-sm">
											<svg class="size-4 text-primary shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
											<span x-text="feature"></span>
										</li>
									</template>
								</ul>
							</div>
						</div>
					</div>
				</div>
				<!-- Footer -->
				<div class="p-4 border-t border-border flex items-center justify-between bg-background">
					<p class="text-[10px] text-muted-foreground max-w-xs leading-relaxed">
						{ i18n.T(ctx, "By completing this purchase, you agree to our Terms of Service and Privacy Policy.") }
					</p>
					<div class="flex gap-2">
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
							Attributes: templ.Attributes{
								"@click": "close()",
							},
						}) {
							{ i18n.T(ctx, "Cancel") }
						}
						<div x-show="paymentMethod === 'card'">
							@button.Button(button.Props{
								Type: button.TypeButton,
								Attributes: templ.Attributes{
									"@click":    "submit()",
									":disabled": "submitting",
								},
							}) {
								<span x-show="!submitting" class="flex items-center gap-2">
									@icon.Lock(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "Complete Purchase") }
								</span>
								<span x-show="submitting" class="flex items-center gap-2">
									<span class="size-4 rounded-full border-2 border-primary-foreground border-t-transparent animate-spin"></span>
									{ i18n.T(ctx, "Processing...") }
								</span>
							}
						</div>
						<div x-show="paymentMethod === 'paypal'">
							@button.Button(button.Props{
								Type: button.TypeButton,
							}) {
								{ i18n.T(ctx, "Continue to PayPal") }
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
