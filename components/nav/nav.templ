package nav

import (
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/searchbar"
	"school-with-ai/components/sidebar"
)

// Nav renders the main thread history sidebar (matches LibreChat's Nav.tsx).
templ Nav() {
	@sidebar.Sidebar(sidebar.Props{
		ID:          "thread-history-sidebar",
		Side:        sidebar.SideLeft,
		Variant:     sidebar.VariantSidebar,
		Collapsible: sidebar.CollapsibleOffcanvas,
		Collapsed:   false,
		Class:       "z-30 !absolute !left-0 !border-r-0",
		Attributes: templ.Attributes{
			"style": "--sidebar-width: 320px",
		},
	}) {
		@sidebar.Header(sidebar.HeaderProps{Class: "p-0 gap-0"}) {
			<div class="flex items-center justify-between px-0.5 py-[2px] md:py-2">
				<!-- Mobile Close -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-10 rounded-xl md:hidden hover:bg-sidebar-accent/50",
					Attributes: templ.Attributes{
						"data-tui-sheet-close": "thread-history-sidebar-mobile",
					},
				}) {
					@icon.X(icon.Props{Class: "size-5 text-sidebar-foreground"})
					<span class="sr-only">{ i18n.T(ctx, "Close Sidebar") }</span>
				}
				<!-- Desktop New Chat -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-10 rounded-xl bg-transparent hover:bg-sidebar-accent hidden md:flex",
					Attributes: templ.Attributes{
						"@click": "createNewSession()",
						"x-show": "hasMessages",
						"x-cloak": true,
					},
				}) {
					@icon.SquarePen(icon.Props{Class: "size-5 text-sidebar-foreground"})
					<span class="sr-only">{ i18n.T(ctx, "New Chat") }</span>
				}
			</div>
			<!-- Search Bar -->
			<div class="px-2 pb-2 pt-1">
				@searchbar.SearchBar(searchbar.Props{
					Placeholder: i18n.T(ctx, "Search chats..."),
					Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
					Attributes:  templ.Attributes{"x-model": "threadSearchQuery"},
				})
			</div>
		}
		@sidebar.Content(sidebar.ContentProps{Class: "gap-0 scrollbar-thin overflow-y-auto"}) {
			<div class="px-3 pt-4 pb-2">
				<h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
					{ i18n.T(ctx, "Chats") }
				</h2>
			</div>
			<template x-for="(group, groupIndex) in getGroupedSessions()" :key="group.title">
				@sidebar.Group(sidebar.GroupProps{Class: "px-2 py-0"}) {
					<h2
						class="pl-1 pt-1 text-muted-foreground text-[0.7rem]"
						:class="groupIndex === 0 ? 'mt-0' : 'mt-2'"
						x-text="group.title"
					></h2>
					@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
						<template x-for="session in group.sessions" :key="session.id">
							@sidebar.MenuItem(sidebar.MenuItemProps{Class: "group/item relative"}) {
								<!-- Inline Rename Overlay -->
								<div
									x-show="renamingSessionId === session.id"
									x-cloak
									class="absolute inset-0 z-20 flex w-full items-center rounded-lg bg-sidebar-accent p-1.5"
								>
									<input
										type="text"
										x-model="renameTitle"
										x-effect="if (renamingSessionId === session.id) { $nextTick(() => { $el.focus(); $el.select(); }) }"
										@keydown.enter.prevent="submitRename()"
										@keydown.escape.prevent="cancelRename()"
										@click.stop
										maxlength="100"
										class="flex-1 rounded bg-transparent p-0.5 text-sm leading-tight text-sidebar-foreground outline-none"
									/>
									<div class="flex gap-1">
										<button @click.stop="cancelRename()" class="rounded-md p-1 hover:opacity-70">
											@icon.X(icon.Props{Class: "size-4 text-sidebar-foreground"})
										</button>
										<button @click.stop="submitRename()" class="rounded-md p-1 hover:opacity-70">
											@icon.Check(icon.Props{Class: "size-4 text-sidebar-foreground"})
										</button>
									</div>
								</div>
								<!-- Conversation Link -->
								<div
									class="group relative flex h-12 w-full items-center rounded-lg outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring transition-all cursor-pointer"
									:class="threadId === session.id ? 'bg-sidebar-accent before:absolute before:bottom-1 before:start-0 before:top-1 before:w-[2px] before:rounded-full before:bg-foreground' : 'hover:bg-sidebar-accent/50'"
									@click="switchSession(session.id)"
									role="button"
									tabindex="0"
									:aria-label="`Conversation: ${session.title || 'Untitled'}`"
								>
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Class: "w-full justify-start h-full px-3 gap-3 text-sidebar-foreground hover:bg-transparent active:bg-transparent",
										Attributes: templ.Attributes{
											"x-bind:data-tui-sidebar-active": "threadId === session.id",
										},
									}) {
										<div class="relative flex items-center gap-2.5 w-full overflow-hidden">
											<span
												class="whitespace-nowrap text-sm font-medium flex-1 text-start tracking-tight"
												style="text-overflow: clip;"
												x-text="session.title"
												dir="auto"
											></span>
											<div
												class="pointer-events-none absolute bottom-0 right-0 top-0 w-20 rounded-r-lg bg-gradient-to-l"
												:class="threadId === session.id
													? 'from-sidebar-accent'
													: 'from-sidebar group-hover/item:from-sidebar-accent/50'"
											></div>
										</div>
									}
									<!-- Options Button -->
									<div
										class="flex origin-left items-center mr-2 max-w-0 scale-x-0 overflow-hidden transition-all duration-200 group-hover/item:max-w-[32px] group-hover/item:scale-x-100"
										:class="threadId === session.id ? '!max-w-[32px] !scale-x-100' : ''"
										@click.stop
									>
										@ContextMenu(ContextMenuProps{
											ThreadID: "session.id",
										})
									</div>
								</div>
							}
						</template>
					}
				}
			</template>
			<!-- Loading Indicator -->
			<div x-show="sessionsHasMore" x-intersect="__loadMoreSessions()" class="flex justify-center py-4 h-12 w-full">
				<span x-show="sessionsLoading" class="animate-spin size-4 border-2 border-primary border-t-transparent rounded-full"></span>
			</div>
		}
	}
}
