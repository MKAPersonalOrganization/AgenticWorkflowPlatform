package checkout

import "school-with-ai/components"
import "school-with-ai/components/card"
import "school-with-ai/components/button"
import "school-with-ai/components/icon"
import "school-with-ai/components/label"
import "school-with-ai/components/input"
import "school-with-ai/components/pageheader"
import "school-with-ai/domain"

type PlanDetails struct {
	ID          string
	Name        string
	Price       string
	Period      string
	Features    []string
}

type CheckoutPageProps struct {
	Plan  PlanDetails
	User  *domain.User
	Error string
}

templ CheckoutPage(props CheckoutPageProps) {
	@components.AppLayout(components.AppLayoutProps{
		Title: "Checkout",
		User:  props.User,
	}) {
		<div class="min-h-screen bg-background">
			<div class="container mx-auto max-w-5xl px-4 py-8 lg:py-12 space-y-10">
				<!-- Header with Back Button -->
				@pageheader.PageHeader(pageheader.Props{
					Title:       "Complete Your Purchase",
					Description: "Subscribe to the " + props.Plan.Name + " plan",
					BackURL:     "/pricing",
					BackLabel:   "Back to Pricing",
				})
				if props.Error != "" {
					<div class="rounded-xl border-2 border-destructive bg-destructive text-destructive-foreground p-5 shadow-sm">
						<div class="flex items-start gap-3">
							@icon.CircleAlert(icon.Props{Class: "size-5 mt-0.5 flex-shrink-0"})
							<p class="text-sm font-medium leading-relaxed">{ props.Error }</p>
						</div>
					</div>
				}

				<!-- Single Card Container -->
				<div class="max-w-4xl mx-auto">
					<form action="/api/subscriptions/checkout" method="POST">
						<input type="hidden" name="plan_id" value={ props.Plan.ID }/>
						<!-- Payment Method Tabs -->
						<div
							x-data="{
								paymentMethod: 'card',
								cardNumber: '',
								expiry: '',
								cvv: '',
								cardholderName: '',
								cardType: '',

								formatCardNumber(value) {
									// Remove all non-digits
									let cleaned = value.replace(/\D/g, '');
									// Limit to 16 digits
									cleaned = cleaned.substring(0, 16);
									// Add space every 4 digits
									let formatted = cleaned.match(/.{1,4}/g)?.join(' ') || cleaned;
									this.cardNumber = formatted;
									this.detectCardType(cleaned);
								},

								formatExpiry(value) {
									// Remove all non-digits
									let cleaned = value.replace(/\D/g, '');
									// Limit to 4 digits
									cleaned = cleaned.substring(0, 4);
									// Add slash after 2 digits
									if (cleaned.length >= 2) {
										this.expiry = cleaned.substring(0, 2) + '/' + cleaned.substring(2);
									} else {
										this.expiry = cleaned;
									}
								},

								formatCVV(value) {
									// Remove all non-digits
									let cleaned = value.replace(/\D/g, '');
									// Limit to 4 digits (Amex) or 3 digits (others)
									let maxLength = this.cardType === 'Amex' ? 4 : 3;
									this.cvv = cleaned.substring(0, maxLength);
								},

								detectCardType(cardNumber) {
									// Detect card type from first digits
									if (cardNumber.startsWith('4')) {
										this.cardType = 'Visa';
									} else if (cardNumber.startsWith('5') || (cardNumber.length >= 2 && cardNumber.startsWith('2') && parseInt(cardNumber.substring(0, 2)) >= 22 && parseInt(cardNumber.substring(0, 2)) <= 27)) {
										this.cardType = 'Mastercard';
									} else if (cardNumber.startsWith('34') || cardNumber.startsWith('37')) {
										this.cardType = 'Amex';
									} else if (cardNumber.startsWith('6011') || cardNumber.startsWith('65') || (cardNumber.length >= 3 && cardNumber.startsWith('64') && parseInt(cardNumber.substring(0, 3)) >= 644 && parseInt(cardNumber.substring(0, 3)) <= 649)) {
										this.cardType = 'Discover';
									} else {
										this.cardType = '';
									}
								}
							}"
						>
							@card.Card(card.Props{Class: "overflow-hidden shadow-sm"}) {
								@card.Content(card.ContentProps{Class: "p-0"}) {
									<div class="grid grid-cols-1 lg:grid-cols-5 lg:divide-x divide-border">
										<!-- Payment Section - Left Side -->
										<div class="lg:col-span-3 p-8 lg:p-10 space-y-9">
											<div class="space-y-2.5">
												<h2 class="text-2xl font-bold tracking-tight">Payment Details</h2>
												<p class="text-sm text-muted-foreground leading-relaxed">Enter your payment information below</p>
											</div>
											<!-- Payment Method Selector -->
											<div class="flex gap-2">
												<button
													type="button"
													@click="paymentMethod = 'card'"
													:class="paymentMethod === 'card' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
													class="flex-1 py-2.5 px-5 font-medium transition-colors rounded-lg"
												>
													<div class="flex items-center justify-center gap-2.5">
														@icon.CreditCard(icon.Props{Class: "size-5"})
														<span>Card</span>
													</div>
												</button>
												<button
													type="button"
													@click="paymentMethod = 'paypal'"
													:class="paymentMethod === 'paypal' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'"
													class="flex-1 py-2.5 px-5 font-medium transition-colors rounded-lg"
												>
													<div class="flex items-center justify-center gap-2.5">
														<span>PayPal</span>
													</div>
												</button>
											</div>
											<!-- Card Payment Form -->
											<div x-show="paymentMethod === 'card'" x-transition class="space-y-6">
												<div>
													<div class="flex items-center justify-between mb-3">
														@label.Label(label.Props{For: "card_number"}) {
															Card Number
														}
														<span x-show="cardType" x-text="cardType" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-primary text-primary-foreground shadow-sm"></span>
													</div>
													@input.Input(input.Props{
														ID:          "card_number",
														Name:        "card_number",
														Type:        input.TypeText,
														Placeholder: "1234 5678 9012 3456",
														Class:       "h-11 rounded-lg px-4 py-2.5 font-mono tracking-wider",
														Attributes: templ.Attributes{
															"x-model":      "cardNumber",
															"@input":       "formatCardNumber($event.target.value)",
															"required":     true,
															"autocomplete": "cc-number",
															"inputmode":    "numeric",
														},
													})
												</div>
												<div class="grid grid-cols-2 gap-5">
													<div>
														@label.Label(label.Props{For: "expiry"}) {
															Expiry Date
														}
														@input.Input(input.Props{
															ID:          "expiry",
															Name:        "expiry",
															Type:        input.TypeText,
															Placeholder: "MM/YY",
															Class:       "h-11 rounded-lg px-4 py-2.5",
															Attributes: templ.Attributes{
																"x-model":      "expiry",
																"@input":       "formatExpiry($event.target.value)",
																"required":     true,
																"autocomplete": "cc-exp",
																"inputmode":    "numeric",
															},
														})
													</div>
													<div>
														@label.Label(label.Props{For: "cvv"}) {
															CVV
														}
														@input.Input(input.Props{
															ID:          "cvv",
															Name:        "cvv",
															Type:        input.TypeText,
															Placeholder: "123",
															Class:       "h-11 rounded-lg px-4 py-2.5",
															Attributes: templ.Attributes{
																"x-model":      "cvv",
																"@input":       "formatCVV($event.target.value)",
																"required":     true,
																"autocomplete": "cc-csc",
																"inputmode":    "numeric",
															},
														})
													</div>
												</div>
												<div>
													@label.Label(label.Props{For: "cardholder_name"}) {
														Cardholder Name
													}
													@input.Input(input.Props{
														ID:          "cardholder_name",
														Name:        "cardholder_name",
														Type:        input.TypeText,
														Placeholder: "John Doe",
														Class:       "h-11 rounded-lg px-4 py-2.5",
														Attributes: templ.Attributes{
															"x-model":      "cardholderName",
															"required":     true,
															"autocomplete": "cc-name",
														},
													})
												</div>
											</div>
											<!-- PayPal Payment (Placeholder) -->
											<div x-show="paymentMethod === 'paypal'" x-transition class="space-y-6">
												<div class="text-center py-12">
													<p class="text-foreground font-medium mb-6">You will be redirected to PayPal to complete your purchase</p>
													<div class="bg-muted border-2 border-dashed border-border rounded-xl p-12">
														<p class="text-sm text-muted-foreground">PayPal button will appear here</p>
													</div>
												</div>
											</div>
										</div>
										<!-- Order Summary - Right Side -->
										<div class="lg:col-span-2 p-8 lg:p-10 space-y-8 bg-muted/30">
											<div class="space-y-2.5">
												<h2 class="text-xl font-bold tracking-tight">Order Summary</h2>
												<p class="text-sm text-muted-foreground leading-relaxed">Review your purchase details</p>
											</div>
											<!-- Plan Details -->
											<div class="space-y-6">
												<div class="flex items-center justify-between py-4 px-4 rounded-lg bg-background/50 border border-border/50">
													<div>
														<div class="text-sm text-muted-foreground mb-1.5">Plan</div>
														<div class="font-semibold text-lg">{ props.Plan.Name }</div>
													</div>
												</div>
												<div class="flex items-center justify-between py-5 px-4 border-t border-border">
													<span class="font-semibold text-base">Total due today</span>
													<div class="text-right">
														<div class="text-3xl font-bold tracking-tight">{ props.Plan.Price }</div>
														<div class="text-sm text-muted-foreground mt-1">{ props.Plan.Period }</div>
													</div>
												</div>
											</div>
											<!-- Features List -->
											<div class="pt-6 border-t-2 border-border">
												<p class="text-sm font-bold mb-5 text-foreground">What's included:</p>
												<ul class="space-y-3.5">
													for _, feature := range props.Plan.Features {
														<li class="flex items-start gap-3">
															<div class="mt-1">
																@icon.Check(icon.Props{Class: "size-4 text-primary flex-shrink-0"})
															</div>
															<span class="text-sm leading-relaxed text-foreground">{ feature }</span>
														</li>
													}
												</ul>
											</div>

										</div>
									</div>
									<!-- Submit Buttons -->
									<div class="flex flex-col sm:flex-row justify-between items-center gap-5 px-8 lg:px-10 py-7 bg-muted border-t-2 border-border">
										<p class="text-xs text-muted-foreground text-center sm:text-left leading-relaxed max-w-xs">
											By completing this purchase, you agree to our Terms of Service and Privacy Policy.
										</p>
										<div class="flex gap-4 w-full sm:w-auto">
											<a href="/pricing" class="flex-1 sm:flex-none">
												@button.Button(button.Props{
													Variant: button.VariantOutline,
													Size:    button.SizeLg,
													Class:   "w-full min-w-32",
												}) {
													Cancel
												}
											</a>
											<div x-show="paymentMethod === 'card'" class="flex-1 sm:flex-none">
												@button.Button(button.Props{
													Type:    button.TypeSubmit,
													Size:    button.SizeLg,
													Variant: button.VariantDefault,
													Class:   "w-full min-w-48",
												}) {
													@icon.Lock(icon.Props{Class: "size-4"})
													<span>Complete Purchase</span>
												}
											</div>
											<div x-show="paymentMethod === 'paypal'" class="flex-1 sm:flex-none">
												@button.Button(button.Props{
													Type:    button.TypeButton,
													Size:    button.SizeLg,
													Variant: button.VariantDefault,
													Class:   "w-full min-w-48",
												}) {
													<span>Continue to PayPal</span>
												}
											</div>
										</div>
									</div>
								}
							}
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}
