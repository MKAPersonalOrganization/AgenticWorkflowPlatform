package statistics

import "school-with-ai/components/annotation"

templ icon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bar-chart-3"><path d="M3 3v18h18"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg>
}

templ Container() {
	@annotation.Container(icon(), annotation.Props{
		LabelAttrs: templ.Attributes{
			"x-text": "`${message.name?.replace(/_/g, ' ') || 'Metric'} Derived`",
		},
		Subtext: "Statistical significance verified via distribution analysis",
	}) {
		<div class="flex flex-col gap-5">
			<!-- Input Spec: Academic Typography -->
			<div class="flex flex-col gap-2 text-[12px] text-muted-foreground/50 italic font-serif">
				<template x-if="message.parsedArgs?.data">
					<div class="flex items-center gap-2">
						<span class="font-semibold text-muted-foreground/40">Sample:</span>
						<span class="text-primary/70 not-italic font-mono text-[11px] bg-primary/[0.05] px-2 py-0.5 rounded-md border border-primary/10" x-text="Array.isArray(message.parsedArgs.data) ? `[${message.parsedArgs.data.slice(0, 5).join(', ')}${message.parsedArgs.data.length > 5 ? '...' : ''}]` : 'dataset'"></span>
						<span class="text-[10px] not-italic font-sans opacity-50" x-text="`(${message.parsedArgs.data.length} obs)`"></span>
					</div>
				</template>
				<template x-if="message.parsedArgs?.x && message.parsedArgs?.y">
					<div class="flex items-center gap-2">
						<span class="font-semibold text-muted-foreground/40">Bivariate:</span>
						<span class="text-primary/70 not-italic font-mono text-[11px] bg-primary/[0.05] px-2 py-0.5 rounded-md border border-primary/10" x-text="`x: [${message.parsedArgs.x.length}], y: [${message.parsedArgs.y.length}]`"></span>
					</div>
				</template>
			</div>
			<!-- Result Area -->
			<div class="relative w-full">
				<!-- Error State -->
				<template x-if="message.parsedResult?.error || (typeof message.result === 'string' && message.result.includes('error'))">
					<div class="flex items-center gap-3 text-destructive/80 font-medium py-3 px-4 bg-destructive/5 border border-destructive/10 rounded-xl">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-circle"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
						<span class="text-xs uppercase tracking-[0.1em] font-bold">Analysis Failed</span>
					</div>
				</template>
				<!-- Success State -->
				<template x-if="!message.parsedResult?.error && !(typeof message.result === 'string' && message.result.includes('error'))">
					<div class="flex flex-col gap-4">
						<!-- Single Value -->
						<template x-if="typeof (message.parsedResult?.result) === 'number'">
							<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-8 flex flex-col items-center justify-center shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)] transition-colors hover:bg-muted/[0.05]">
								<div class="text-[10px] uppercase tracking-[0.3em] font-bold text-muted-foreground/30 mb-2">Derived Metric</div>
								<div class="text-5xl font-mono font-bold text-foreground tracking-tighter" x-text="message.parsedResult?.result"></div>
							</div>
						</template>
						<!-- Array/Dataset -->
						<template x-if="Array.isArray(message.parsedResult?.result)">
							<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-5 font-mono text-[13px] text-foreground/90 overflow-x-auto whitespace-nowrap shadow-[inset_0_1px_4px_rgba(0,0,0,0.01)]" x-text="`[${message.parsedResult.result.join(', ')}]`"></div>
						</template>
						<!-- Regression/Complex -->
						<template x-if="message.parsedResult?.regression">
							<div class="grid grid-cols-2 gap-4">
								<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-5 flex flex-col gap-2 transition-colors hover:bg-muted/[0.05]">
									<div class="text-[9px] uppercase tracking-widest font-bold text-muted-foreground/40">Model Equation</div>
									<div class="text-[14px] font-mono text-primary/80 font-bold" x-text="message.parsedResult.equation"></div>
								</div>
								<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-5 flex flex-col gap-2 transition-colors hover:bg-muted/[0.05]">
									<div class="text-[9px] uppercase tracking-widest font-bold text-muted-foreground/40">Correlation R²</div>
									<div class="text-[14px] font-mono text-foreground/80 font-bold" x-text="message.parsedResult.correlation || 'verified'"></div>
								</div>
							</div>
						</template>
						<!-- Object Fallback -->
						<template x-if="typeof (message.parsedResult?.result) === 'object' && !Array.isArray(message.parsedResult?.result)">
							<div class="bg-muted/[0.03] border border-border/10 rounded-xl p-5 font-mono text-[12px] text-foreground/70" x-text="JSON.stringify(message.parsedResult.result, null, 2)"></div>
						</template>
					</div>
				</template>
			</div>
		</div>
	}
}


