// templui component code - version: v1.2.0 installed by templui v1.2.0
// 📚 Documentation: https://templui.io/docs/components/code
package code

import (
	"school-with-ai/components/utils"
	"school-with-ai/components/copybutton"
	"school-with-ai/components/tooltip"
)

type Props struct {
	ID        string
	Class     string
	Attrs     templ.Attributes
	Language  string
	CodeClass string
}

templ Code(props ...Props) {
	// Highlight.js with theme switching
	<link
		id="highlight-theme"
		href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-light.min.css"
		rel="stylesheet"
	/>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = "code-" + utils.RandomID() }}
	}
    // Ensure we have a unique ID for the code block itself to target with copy button
    {{ codeBlockID := p.ID + "-content" }}

	<div
		id={ p.ID }
		class={ utils.TwMerge("relative code-component rounded-md border border-border bg-muted/50 my-4", p.Class) }
		data-tui-code-component
		{ p.Attrs... }
	>
        <div class="flex items-center justify-between px-3 py-1.5 border-b border-border bg-muted/50 rounded-t-md">
            <span class="text-xs text-muted-foreground font-sans font-medium select-none uppercase">{ p.Language }</span>
            <div class="flex items-center gap-2">
                {{ tooltipID := "tooltip-" + codeBlockID }}
                @tooltip.Tooltip() {
                    @tooltip.Trigger(tooltip.TriggerProps{
                        For: tooltipID,
                    }) {
                        @copybutton.CopyButton(copybutton.Props{
                            TargetID: codeBlockID,
                            Class: "h-6 w-6 hover:bg-background/80 hover:text-foreground",
                        })
                    }
                    @tooltip.Content(tooltip.ContentProps{
                        ID: tooltipID,
                    }) {
                        Copy code
                    }
                }
            </div>
        </div>
		<pre class="overflow-hidden! m-0! p-0! bg-transparent!">
			<code
                id={ codeBlockID }
				data-tui-code-block
				class={
					utils.TwMerge(
						"language-"+p.Language,
						"overflow-y-auto! block text-sm max-h-[500px] p-4! bg-[#fafafa] dark:bg-[#282c34]!", // Force specific bg to match theme or let hljs handle it, but container needs to match
						"hljs-target",
						p.CodeClass,
					),
				}
			>
				{ children... }
			</code>
		</pre>
	</div>
}

templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/code.min.js") }></script>
}
