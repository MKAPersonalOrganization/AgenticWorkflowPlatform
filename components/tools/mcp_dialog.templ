package tools

import (
	"aicompass/components/button"
	"aicompass/components/dialog"
	"aicompass/components/i18n"
	"aicompass/components/icon"
)

// MCPAddDialog renders the "Add MCP Server" modal dialog.
templ MCPAddDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "mcp-add-dialog",
	}) {
		@dialog.Content(dialog.ContentProps{
			Class: "sm:max-w-lg",
		}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					<div class="flex items-center gap-2">
						@icon.MCPLogo("size-5 text-primary")
						{ i18n.T(ctx, "Add MCP Server") }
					</div>
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ i18n.T(ctx, "Connect to a remote MCP server to discover and use its tools.") }
				}
			}
			<div class="space-y-4 px-6 py-4">
				<!-- Server URL -->
				<div>
					<label for="mcp-url" class="text-sm font-medium text-foreground mb-1.5 block">
						{ i18n.T(ctx, "Server URL") }
						<span class="text-destructive">*</span>
					</label>
					<input
						id="mcp-url"
						type="url"
						x-model="mcpNewUrl"
						placeholder="https://mcp.example.com/v1"
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						@keydown.enter="mcpAddConnector()"
					/>
					<p class="text-xs text-muted-foreground mt-1">
						{ i18n.T(ctx, "The Streamable HTTP endpoint URL of the MCP server.") }
					</p>
				</div>
				<!-- Display Name -->
				<div>
					<label for="mcp-title" class="text-sm font-medium text-foreground mb-1.5 block">
						{ i18n.T(ctx, "Display Name") }
					</label>
					<input
						id="mcp-title"
						type="text"
						x-model="mcpNewTitle"
						placeholder="My Tools Server"
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
					/>
				</div>
				<!-- Advanced Options (collapsible) -->
				<details class="group">
					<summary class="text-xs font-medium text-muted-foreground cursor-pointer hover:text-foreground transition-colors flex items-center gap-1">
						@icon.ChevronRight(icon.Props{Class: "size-3 transition-transform group-open:rotate-90"})
						{ i18n.T(ctx, "Advanced Options") }
					</summary>
					<div class="mt-3 space-y-3 ps-4 border-s-2 border-border">
						<div>
							<label for="mcp-client-id" class="text-xs font-medium text-foreground mb-1 block">
								{ i18n.T(ctx, "OAuth Client ID") }
								<span class="text-muted-foreground font-normal">({ i18n.T(ctx, "optional") })</span>
							</label>
							<input
								id="mcp-client-id"
								type="text"
								x-model="mcpNewClientID"
								placeholder=""
								class="w-full rounded-md border border-input bg-background px-3 py-2 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							/>
						</div>
						<div>
							<label for="mcp-client-secret" class="text-xs font-medium text-foreground mb-1 block">
								{ i18n.T(ctx, "OAuth Client Secret") }
								<span class="text-muted-foreground font-normal">({ i18n.T(ctx, "optional") })</span>
							</label>
							<input
								id="mcp-client-secret"
								type="password"
								x-model="mcpNewClientSecret"
								placeholder=""
								class="w-full rounded-md border border-input bg-background px-3 py-2 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							/>
						</div>
						<p class="text-xs text-muted-foreground">
							{ i18n.T(ctx, "Pre-registered OAuth credentials. If not provided, the system will attempt Dynamic Client Registration.") }
						</p>
					</div>
				</details>
				<!-- Error display -->
				<div x-show="mcpError" x-cloak class="rounded-md bg-destructive/10 border border-destructive/20 p-3">
					<p class="text-xs text-destructive flex items-center gap-1.5">
						@icon.CircleAlert(icon.Props{Class: "size-3.5 shrink-0"})
						<span x-text="mcpError"></span>
					</p>
				</div>
			</div>
			@dialog.Footer(dialog.FooterProps{}) {
				@dialog.Close(dialog.CloseProps{For: "mcp-add-dialog"}) {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Class:   "h-9 px-4",
					}) {
						{ i18n.T(ctx, "Cancel") }
					}
				}
				@button.Button(button.Props{
					Class: "h-9 px-4",
					Attributes: templ.Attributes{
						"@click":    "mcpAddConnector()",
						":disabled": "mcpLoading || !mcpNewUrl",
					},
				}) {
					<span x-show="!mcpLoading" class="flex items-center gap-1.5">
						@icon.Plug(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "Connect") }
					</span>
					<span x-show="mcpLoading" class="flex items-center gap-1.5">
						@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin"})
						{ i18n.T(ctx, "Connecting...") }
					</span>
				}
			}
		}
	}
}

// MCPConnectorCard renders a single MCP connector entry in the plugin sidebar.
templ MCPConnectorCard() {
	<template x-for="conn in mcpConnectors" :key="conn.id">
		<div
			class="group flex items-start gap-2.5 px-3 py-2.5 cursor-pointer select-none transition-colors hover:bg-accent/40"
			@click="mcpOpenDetail(conn)"
		>
			<!-- MCP icon with status dot -->
			<div class="relative">
				<div
					class="size-9 rounded-lg flex items-center justify-center shrink-0 mt-0.5 bg-blue-500/10 text-blue-500"
				>
					@icon.MCPLogo("size-4")
				</div>
				<!-- Status dot -->
				<span
					class="absolute -bottom-0.5 -end-0.5 size-2.5 rounded-full border-2 border-sidebar"
					:class="{
						'bg-emerald-500': conn.status === 'connected',
						'bg-yellow-500 animate-pulse': conn.status === 'connecting',
						'bg-orange-500': conn.status === 'auth_required' || conn.status === 'authorizing',
						'bg-red-500': conn.status === 'error',
						'bg-gray-400': conn.status === 'created' || conn.status === 'disconnected'
					}"
				></span>
			</div>
			<!-- Info -->
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-1.5">
					<span x-text="conn.title" class="text-sm font-medium text-foreground truncate"></span>
				</div>
				<p class="text-xs text-muted-foreground truncate mt-0.5 leading-snug" x-text="conn.server_url"></p>
				<div class="flex items-center gap-1.5 mt-1">
					<span class="inline-block px-1.5 py-0 text-[9px] font-medium rounded-full bg-blue-500/10 text-blue-500">
						MCP
					</span>
					<span
						class="text-[10px] text-muted-foreground/60 tabular-nums"
						x-text="conn.tool_count + ' tools'"
					></span>
					<template x-if="conn.status === 'error'">
						<span class="text-[10px] text-destructive truncate max-w-[120px]" x-text="conn.error_msg" :title="conn.error_msg"></span>
					</template>
				</div>
			</div>
			<!-- Actions -->
			<div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity shrink-0 mt-1">
				<template x-if="conn.status === 'connected'">
					<button
						@click.stop="mcpDisconnect(conn.id)"
						class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground"
						:title="'Disconnect'"
					>
						@icon.Unplug(icon.Props{Class: "size-3"})
					</button>
				</template>
				<template x-if="conn.status === 'auth_required'">
					<button
						@click.stop="mcpAuthorize(conn)"
						class="p-1 rounded-md hover:bg-accent text-orange-500 hover:text-orange-600"
						:title="'Authorize'"
					>
						@icon.KeyRound(icon.Props{Class: "size-3"})
					</button>
				</template>
				<template x-if="conn.status !== 'connected' && conn.status !== 'connecting' && conn.status !== 'auth_required'">
					<button
						@click.stop="mcpConnect(conn.id)"
						class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground"
						:title="'Connect'"
					>
						@icon.Plug(icon.Props{Class: "size-3"})
					</button>
				</template>
				<button
					@click.stop="mcpRemove(conn.id)"
					class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-destructive"
					:title="'Remove'"
				>
					@icon.Trash2(icon.Props{Class: "size-3"})
				</button>
			</div>
		</div>
	</template>
}
