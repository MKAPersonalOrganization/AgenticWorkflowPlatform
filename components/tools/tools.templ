package tools

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ ToolsSidebar() {
	<!-- Plugins Sidebar (VS Code Extensions-style) -->
	<div
		x-data="toolsSidebar"
		@toggle-tools-sidebar.window="toggle()"
		class="contents"
	>
		<!-- ═══════════ SIDEBAR: Search & Browse Only ═══════════ -->
		<aside
			x-show="open"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="-translate-x-full opacity-0"
			x-transition:enter-end="translate-x-0 opacity-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="translate-x-0 opacity-100"
			x-transition:leave-end="-translate-x-full opacity-0"
			x-cloak
			class="fixed left-12 top-0 h-svh w-80 z-30 bg-sidebar border-r border-sidebar-border flex flex-col"
		>
			<div class="flex flex-col h-full">
				<!-- Header -->
				<div class="flex items-center justify-between px-3 py-2 border-b border-border shrink-0">
					<div class="flex items-center gap-1.5">
						@icon.Blocks(icon.Props{Class: "size-3.5 text-muted-foreground"})
						<span class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "Plugins") }</span>
					</div>
					<div class="flex items-center gap-1">
						<button
							@click="fetchPlugins()"
							class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							title={ i18n.T(ctx, "Refresh") }
						>
							@icon.RotateCw(icon.Props{Class: "size-3"})
						</button>
						<button
							@click="open = false"
							class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
						>
							@icon.X(icon.Props{Class: "size-3.5"})
						</button>
					</div>
				</div>
				<!-- Search bar -->
				<div class="px-2 py-1.5 border-b border-border shrink-0">
					<div class="relative">
						<div class="absolute inset-y-0 left-0 flex items-center pl-2 pointer-events-none">
							@icon.Search(icon.Props{Class: "size-3.5 text-muted-foreground"})
						</div>
						<input
							type="text"
							x-model="search"
							placeholder={ i18n.T(ctx, "Search plugins...") }
							class="w-full rounded border border-input bg-background pl-7 pr-7 py-1 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring transition-colors"
						/>
						<button
							x-show="search.length > 0"
							x-transition
							@click="search = ''"
							class="absolute inset-y-0 right-0 flex items-center pr-2 text-muted-foreground hover:text-foreground transition-colors"
						>
							@icon.X(icon.Props{Class: "size-3"})
						</button>
					</div>
				</div>
				<!-- Scrollable plugin list -->
				<div class="flex-1 overflow-y-auto scrollbar-thin">
					<!-- ═══════ MCP SERVERS SECTION ═══════ -->
					<div x-data="mcpConnectors">
						<div class="flex items-center justify-between px-3 py-1.5 bg-muted/30 border-b border-border">
							<span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "MCP Servers") }</span>
							<button
								@click="mcpOpenAddDialog()"
								class="p-0.5 rounded hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
								title={ i18n.T(ctx, "Add MCP Server") }
							>
								@icon.Plus(icon.Props{Class: "size-3.5"})
							</button>
						</div>
						<!-- MCP connector cards -->
						<template x-if="mcpConnectors.length > 0">
							<div class="divide-y divide-border/50">
								@MCPConnectorCard()
							</div>
						</template>
						<template x-if="mcpConnectors.length === 0">
							<div class="px-3 py-3 text-center">
								<button
									@click="mcpOpenAddDialog()"
									class="text-xs text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1"
								>
									@icon.Plus(icon.Props{Class: "size-3"})
									{ i18n.T(ctx, "Add your first MCP server") }
								</button>
							</div>
						</template>
						<!-- MCP Dialogs -->
						@MCPAddDialog()
						@MCPConnectorDetailDialog()
					</div>
					<!-- ═══════ BUILT-IN PLUGINS SECTION ═══════ -->
					<div class="flex items-center px-3 py-1.5 bg-muted/30 border-b border-border">
						<span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "Built-in Plugins") }</span>
					</div>
					<!-- Loading skeleton -->
					<template x-if="loading && plugins.length === 0">
						<div class="divide-y divide-border">
							<template x-for="i in 5" :key="i">
								<div class="flex items-center gap-3 px-3 py-2.5 animate-pulse">
									<div class="size-8 rounded bg-muted shrink-0"></div>
									<div class="flex-1 space-y-1.5">
										<div class="h-3 bg-muted rounded w-1/3"></div>
										<div class="h-2.5 bg-muted rounded w-2/3"></div>
									</div>
								</div>
							</template>
						</div>
					</template>
					<!-- Empty state -->
					<template x-if="!loading && plugins.length === 0">
						<div class="flex flex-col items-center justify-center py-12 gap-2 text-muted-foreground">
							@icon.PackageOpen(icon.Props{Class: "size-8 opacity-20"})
							<span class="text-xs">{ i18n.T(ctx, "No plugins available") }</span>
						</div>
					</template>
					<!-- No search results -->
					<template x-if="!loading && filteredPlugins.length === 0 && plugins.length > 0">
						<div class="flex flex-col items-center justify-center py-12 gap-2 text-muted-foreground">
							@icon.SearchX(icon.Props{Class: "size-8 opacity-20"})
							<span class="text-xs">{ i18n.T(ctx, "No plugins match your search") }</span>
						</div>
					</template>
					<!-- Plugin list -->
					<template x-if="filteredPlugins.length > 0">
						<div class="divide-y divide-border/50">
							<template x-for="plugin in filteredPlugins" :key="plugin.id">
								<div
									class="group flex items-start gap-2.5 px-3 py-2.5 cursor-pointer select-none transition-colors hover:bg-accent/40"
									:class="profilePlugin && profilePlugin.id === plugin.id ? 'bg-accent/60 border-l-2 border-l-primary' : ''"
									@click="openProfile(plugin)"
								>
									<!-- Plugin icon -->
									<div
										class="size-9 rounded-lg flex items-center justify-center shrink-0 mt-0.5"
										:class="plugin.enabled ? 'bg-primary/10 text-primary' : 'bg-accent/80 text-muted-foreground'"
									>
										@icon.Blocks(icon.Props{Class: "size-4"})
									</div>
									<!-- Info -->
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-1.5">
											<span x-text="plugin.name" class="text-sm font-medium text-foreground truncate"></span>
											<span
												x-show="plugin.enabled"
												class="shrink-0 size-1.5 rounded-full bg-emerald-500"
												title={ i18n.T(ctx, "Enabled") }
											></span>
										</div>
										<p x-text="plugin.description" class="text-xs text-muted-foreground truncate mt-0.5 leading-snug"></p>
										<div class="flex items-center gap-1.5 mt-1">
											<span
												class="inline-block px-1.5 py-0 text-[9px] font-medium rounded-full bg-accent text-muted-foreground"
												x-text="plugin.category"
											></span>
											<span
												class="text-[10px] text-muted-foreground/60 tabular-nums"
												x-text="`${plugin.tools.filter(t => t.enabled).length}/${plugin.tools.length} tools`"
											></span>
										</div>
									</div>
								</div>
							</template>
						</div>
					</template>
				</div>
				<!-- Footer -->
				<div class="flex items-center justify-between px-3 py-1.5 border-t border-border shrink-0">
					<span class="text-[10px] text-muted-foreground tabular-nums" x-show="plugins.length > 0">
						<span x-text="enabledSummary.sets"></span>/<span x-text="enabledSummary.total"></span> { i18n.T(ctx, "enabled") } ·
						<span x-text="enabledSummary.tools"></span> { i18n.T(ctx, "tools") }
					</span>
					<div x-show="plugins.length === 0"></div>
				</div>
			</div>
		</aside>
		<!-- ═══════════ PLUGIN DETAIL DIALOG ═══════════ -->
		@dialog.Dialog(dialog.Props{
			ID: "plugin-profile-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "sm:max-w-2xl max-h-[90vh] flex flex-col p-0 overflow-hidden",
			}) {
				<template x-if="profilePlugin">
					<div class="flex flex-col h-full overflow-hidden">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-start gap-4">
								<!-- Plugin icon -->
								<div
									class="size-11 rounded-lg flex items-center justify-center shrink-0"
									:class="profilePlugin.enabled ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'"
								>
									@icon.Puzzle(icon.Props{Class: "size-5"})
								</div>
								<div class="flex-1 min-w-0">
									@dialog.Title(dialog.TitleProps{Class: "flex items-center gap-2"}) {
										<span x-text="profilePlugin.name"></span>
										<template x-if="profilePlugin.enabled">
											<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
												{ i18n.T(ctx, "Enabled") }
											</span>
										</template>
										<template x-if="!profilePlugin.enabled">
											<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
												{ i18n.T(ctx, "Disabled") }
											</span>
										</template>
									}
									@dialog.Description(dialog.DescriptionProps{}) {
										<span x-text="profilePlugin.description"></span>
									}
								</div>
							</div>
						}
						<!-- Action bar -->
						<div class="px-4 py-2.5 border-b border-border bg-muted/50">
							<div class="flex items-center justify-between">
								<!-- Stats -->
								<div class="flex items-center gap-3 text-xs text-muted-foreground">
									<span class="flex items-center gap-1.5">
										@icon.Tag(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="profilePlugin.category"></span>
									</span>
									<span class="text-border">|</span>
									<span class="flex items-center gap-1.5">
										@icon.Blocks(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="profilePlugin.tools.length"></span> { i18n.T(ctx, "tools") }
									</span>
									<span class="text-border">|</span>
									<span class="flex items-center gap-1.5">
										@icon.CircleCheck(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="profilePlugin.tools.filter(t => t.enabled).length"></span> { i18n.T(ctx, "active") }
									</span>
								</div>
								<!-- Enable/Disable toggle -->
								<button
									@click="togglePlugin(profilePlugin)"
									class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors"
									:class="profilePlugin.enabled
										? 'bg-destructive/10 text-destructive hover:bg-destructive/20 border border-destructive/20'
										: 'bg-primary text-primary-foreground hover:bg-primary/90'"
								>
									<template x-if="!profilePlugin.enabled">
										<span class="flex items-center gap-1.5">
											@icon.Download(icon.Props{Class: "size-3.5"})
											{ i18n.T(ctx, "Enable") }
										</span>
									</template>
									<template x-if="profilePlugin.enabled">
										<span class="flex items-center gap-1.5">
											@icon.X(icon.Props{Class: "size-3.5"})
											{ i18n.T(ctx, "Disable") }
										</span>
									</template>
								</button>
							</div>
						</div>
						<!-- Tab switcher -->
						<div class="flex items-center gap-0 border-b border-border px-4">
							<button
								@click="profileTab = 'details'"
								class="px-3 py-2 text-xs font-medium transition-colors border-b-2 -mb-px"
								:class="profileTab === 'details' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground'"
							>
								@icon.Info(icon.Props{Class: "size-3.5 inline mr-1.5 -mt-px"})
								{ i18n.T(ctx, "Details") }
							</button>
							<button
								@click="profileTab = 'tools'"
								class="px-3 py-2 text-xs font-medium transition-colors border-b-2 -mb-px"
								:class="profileTab === 'tools' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground'"
							>
								@icon.Wrench(icon.Props{Class: "size-3.5 inline mr-1.5 -mt-px"})
								{ i18n.T(ctx, "Feature Contributions") }
							</button>
						</div>
						<!-- Scrollable tab content -->
						<div class="flex-1 overflow-auto scrollbar-thin p-4">
							<!-- ── Details tab ── -->
							<div x-show="profileTab === 'details'">
								<div class="space-y-5">
									<p x-text="profilePlugin.description" class="text-sm text-muted-foreground leading-relaxed"></p>
									<template x-if="profilePlugin.tools.length > 0">
										<div>
											<div class="flex items-center gap-2 mb-2.5">
												@icon.Sparkles(icon.Props{Class: "size-4 text-muted-foreground"})
												<h4 class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "What this plugin provides") }</h4>
											</div>
											<div class="space-y-2 pl-6">
												<template x-for="tool in profilePlugin.tools" :key="tool.id">
													<div class="border border-border rounded-lg p-2.5 border-l-[3px] bg-card" :class="tool.enabled ? 'border-l-primary' : 'border-l-border opacity-70'">
														<div class="flex items-center gap-2 mb-1">
															<span class="text-xs font-semibold text-foreground" x-text="tool.name"></span>
															<template x-if="tool.category">
																<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-accent text-muted-foreground" x-text="tool.category"></span>
															</template>
														</div>
														<p class="text-xs text-muted-foreground leading-relaxed" x-text="tool.description"></p>
													</div>
												</template>
											</div>
										</div>
									</template>
									<!-- Plugin metadata -->
									<div class="border-t border-border pt-4 grid grid-cols-2 gap-3">
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Category") }</div>
											<div class="text-xs text-foreground flex items-center gap-1.5">
												@icon.Tag(icon.Props{Class: "size-3 text-muted-foreground"})
												<span x-text="profilePlugin.category"></span>
											</div>
										</div>
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Plugin ID") }</div>
											<code class="text-[11px] bg-muted px-1.5 py-0.5 rounded font-mono break-all" x-text="profilePlugin.id"></code>
										</div>
									</div>
								</div>
							</div>
							<!-- ── Feature Contributions tab ── -->
							<div x-show="profileTab === 'tools'">
								<template x-if="profilePlugin.tools.length === 0">
									<div class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground">
										@icon.PackageOpen(icon.Props{Class: "size-10 opacity-20"})
										<p class="text-sm">{ i18n.T(ctx, "No tools registered for this plugin") }</p>
									</div>
								</template>
								<template x-if="profilePlugin.tools.length > 0">
									<div class="space-y-2">
										<template x-for="tool in profilePlugin.tools" :key="tool.id">
											<div
												class="group border rounded-lg overflow-hidden transition-all duration-200 border-l-[3px] hover:shadow-md"
												:class="tool.enabled ? 'border-border border-l-primary bg-card' : 'border-border border-l-border opacity-70'"
											>
												<div class="flex items-center justify-between gap-4 p-3">
													<div class="flex items-start gap-3 flex-1 min-w-0">
														<div
															class="size-8 rounded-lg flex items-center justify-center shrink-0"
															:class="tool.enabled ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'"
														>
															@icon.Cog(icon.Props{Class: "size-3.5"})
														</div>
														<div class="flex flex-col gap-0.5 flex-1 min-w-0">
															<div class="flex items-center gap-2">
																<span x-text="tool.name" class="text-sm font-semibold text-foreground truncate"></span>
																<template x-if="tool.category">
																	<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-accent text-muted-foreground" x-text="tool.category"></span>
																</template>
															</div>
															<p x-text="tool.description" class="text-xs text-muted-foreground line-clamp-2"></p>
														</div>
													</div>
													<div class="flex items-center gap-2 shrink-0">
														<button
															@click="toggleTool(profilePlugin, tool)"
															class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"
															:class="tool.enabled ? 'bg-primary' : 'bg-input'"
															role="switch"
															:aria-checked="tool.enabled"
															:aria-label="tool.name"
															:disabled="!profilePlugin.enabled"
														>
															<span
																class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
																:class="tool.enabled ? 'translate-x-4' : 'translate-x-0'"
															></span>
														</button>
													</div>
												</div>
											</div>
										</template>
									</div>
								</template>
							</div>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<div class="flex items-center gap-3 text-xs text-muted-foreground">
									<span class="flex items-center gap-1.5">
										@icon.Blocks(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="profilePlugin.tools.filter(t=>t.enabled).length"></span>/<span x-text="profilePlugin.tools.length"></span> { i18n.T(ctx, "tools active") }
									</span>
									<span class="text-border">|</span>
									<template x-if="profilePlugin.enabled">
										<span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
											@icon.CircleCheck(icon.Props{Class: "size-3"})
											{ i18n.T(ctx, "Plugin enabled") }
										</span>
									</template>
									<template x-if="!profilePlugin.enabled">
										<span class="flex items-center gap-1.5">
											@icon.CircleDot(icon.Props{Class: "size-3 opacity-60"})
											{ i18n.T(ctx, "Plugin disabled") }
										</span>
									</template>
								</div>
								@dialog.Close(dialog.CloseProps{For: "plugin-profile-dialog"}) {
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Class:   "h-8 px-3 text-xs",
										Attributes: templ.Attributes{
											"@click": "closeProfile()",
										},
									}) {
										{ i18n.T(ctx, "Close") }
									}
								}
							</div>
						}
					</div>
				</template>
			}
		}
	</div>
}

templ ToolsButtonTrigger() {
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Class:   "size-9",
		Attributes: templ.Attributes{
			"@click": "$dispatch('toggle-tools-sidebar')",
			"title":  i18n.T(ctx, "Tools"),
		},
	}) {
		@icon.Wrench(icon.Props{Class: "size-5"})
		<span class="sr-only">{ i18n.T(ctx, "Tools") }</span>
	}
}
