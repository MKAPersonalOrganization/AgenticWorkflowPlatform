package tools

import (
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ ToolsSidebar() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('toolsSidebar', () => ({
				open: false,
				plugins: [],
				loading: false,
				search: '',
				expandedSets: [],
				_loaded: false,
				init() {
					// When thread-history-sidebar opens, close tools sidebar
					const threadSidebar = document.querySelector('[data-tui-sidebar-wrapper][data-tui-sidebar-id="thread-history-sidebar"]');
					if (threadSidebar) {
						new MutationObserver((mutations) => {
							for (const m of mutations) {
								if (m.attributeName === 'data-tui-sidebar-state' &&
									m.target.getAttribute('data-tui-sidebar-state') === 'expanded' &&
									this.open) {
									this.open = false;
								}
							}
						}).observe(threadSidebar, { attributes: true, attributeFilter: ['data-tui-sidebar-state'] });
					}
				},
				get _agentId() {
					try {
						const chatEl = document.querySelector('[x-data="chat"]');
						if (chatEl) {
							const chatData = Alpine.$data(chatEl);
							if (chatData?.selectedAgent) return chatData.selectedAgent;
						}
					} catch (e) { /* ignore */ }
					return '';
				},
				_buildUrl(path) {
					const agentId = this._agentId;
					return agentId ? `${path}?agent_id=${encodeURIComponent(agentId)}` : path;
				},
				async toggle() {
					this.open = !this.open;
					if (this.open) {
						// Collapse thread-history-sidebar
						const wrapper = document.querySelector('[data-tui-sidebar-wrapper][data-tui-sidebar-id="thread-history-sidebar"]');
						if (wrapper && wrapper.getAttribute('data-tui-sidebar-state') === 'expanded') {
							wrapper.setAttribute('data-tui-sidebar-state', 'collapsed');
						}
						if (!this._loaded) {
							await this.fetchPlugins();
							this._loaded = true;
						}
					}
				},
				async fetchPlugins() {
					this.loading = true;
					try {
						const response = await fetch(this._buildUrl('/v1/plugins'));
						if (response.ok) {
							const data = await response.json();
							if (data.plugins && Array.isArray(data.plugins)) {
								this.plugins = data.plugins;
							}
						} else {
							this.plugins = [];
						}
					} catch (err) {
						console.error('Failed to fetch plugins:', err);
						this.plugins = [];
					} finally {
						this.loading = false;
					}
				},
				get filteredPlugins() {
					if (!this.search) return this.plugins;
					const q = this.search.toLowerCase();
					return this.plugins.filter(plugin =>
						plugin.name.toLowerCase().includes(q) ||
						plugin.description.toLowerCase().includes(q) ||
						plugin.category.toLowerCase().includes(q) ||
						plugin.tools.some(tool =>
							tool.name.toLowerCase().includes(q) ||
							tool.description.toLowerCase().includes(q)
						)
					);
				},
				get enabledSummary() {
					const enabledSets = this.plugins.filter(p => p.enabled).length;
					let enabledTools = 0;
					this.plugins.forEach(p => {
						if (p.enabled) enabledTools += (p.tools || []).filter(t => t.enabled).length;
					});
					return { sets: enabledSets, tools: enabledTools, total: this.plugins.length };
				},
				async togglePlugin(plugin) {
					const newState = !plugin.enabled;
					try {
						const response = await fetch(this._buildUrl(`/v1/plugins/${plugin.id}`), {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ enabled: newState })
						});
						if (response.ok) {
							plugin.enabled = newState;
							plugin.tools.forEach(tool => tool.enabled = newState);
						}
					} catch (err) {
						console.error('Failed to toggle plugin:', err);
					}
				},
				async toggleTool(plugin, tool) {
					const newState = !tool.enabled;
					try {
						const response = await fetch(this._buildUrl(`/v1/plugins/${plugin.id}/tools/${tool.id}`), {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ enabled: newState })
						});
						if (response.ok) {
							tool.enabled = newState;
							plugin.enabled = plugin.tools.some(t => t.enabled);
						}
					} catch (err) {
						console.error('Failed to toggle tool:', err);
					}
				},
				toggleExpand(plugin) {
					const idx = this.expandedSets.indexOf(plugin.id);
					if (idx === -1) {
						this.expandedSets.push(plugin.id);
					} else {
						this.expandedSets.splice(idx, 1);
					}
				},
				isExpanded(plugin) {
					return this.expandedSets.includes(plugin.id);
				}
			}));
		});
	</script>
	<!-- Plugins Sidebar (VS Code Extensions-style) -->
	<div
		x-data="toolsSidebar"
		@toggle-tools-sidebar.window="toggle()"
		class="contents"
	>
		<aside
			x-show="open"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="-translate-x-full opacity-0"
			x-transition:enter-end="translate-x-0 opacity-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="translate-x-0 opacity-100"
			x-transition:leave-end="-translate-x-full opacity-0"
			x-cloak
			class="fixed left-12 top-0 h-svh w-80 z-30 bg-sidebar border-r border-sidebar-border flex flex-col"
		>
			<!-- Header -->
			<div class="flex items-center justify-between px-3 py-2 border-b border-border shrink-0">
				<div class="flex items-center gap-1.5">
					@icon.Blocks(icon.Props{Class: "size-3.5 text-muted-foreground"})
					<span class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "Plugins") }</span>
				</div>
				<div class="flex items-center gap-1">
					<button
						@click="fetchPlugins()"
						class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
						title={ i18n.T(ctx, "Refresh") }
					>
						@icon.RotateCw(icon.Props{Class: "size-3"})
					</button>
					<button
						@click="open = false"
						class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
					>
						@icon.X(icon.Props{Class: "size-3.5"})
					</button>
				</div>
			</div>
			<!-- Search bar -->
			<div class="px-2 py-1.5 border-b border-border shrink-0">
				<div class="relative">
					<div class="absolute inset-y-0 left-0 flex items-center pl-2 pointer-events-none">
						@icon.Search(icon.Props{Class: "size-3.5 text-muted-foreground"})
					</div>
					<input
						type="text"
						x-model="search"
						placeholder={ i18n.T(ctx, "Search plugins...") }
						class="w-full rounded border border-input bg-background pl-7 pr-7 py-1 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring transition-colors"
					/>
					<button
						x-show="search.length > 0"
						x-transition
						@click="search = ''"
						class="absolute inset-y-0 right-0 flex items-center pr-2 text-muted-foreground hover:text-foreground transition-colors"
					>
						@icon.X(icon.Props{Class: "size-3"})
					</button>
				</div>
			</div>
			<!-- Scrollable plugin list -->
			<div class="flex-1 overflow-y-auto scrollbar-thin">
				<!-- Loading skeleton -->
				<template x-if="loading && plugins.length === 0">
					<div class="divide-y divide-border">
						<template x-for="i in 5" :key="i">
							<div class="flex items-center gap-3 px-3 py-2.5 animate-pulse">
								<div class="size-8 rounded bg-muted shrink-0"></div>
								<div class="flex-1 space-y-1.5">
									<div class="h-3 bg-muted rounded w-1/3"></div>
									<div class="h-2.5 bg-muted rounded w-2/3"></div>
								</div>
							</div>
						</template>
					</div>
				</template>
				<!-- Empty state -->
				<template x-if="!loading && plugins.length === 0">
					<div class="flex flex-col items-center justify-center py-12 gap-2 text-muted-foreground">
						@icon.PackageOpen(icon.Props{Class: "size-8 opacity-20"})
						<span class="text-xs">{ i18n.T(ctx, "No plugins available") }</span>
					</div>
				</template>
				<!-- No search results -->
				<template x-if="!loading && filteredPlugins.length === 0 && plugins.length > 0">
					<div class="flex flex-col items-center justify-center py-12 gap-2 text-muted-foreground">
						@icon.SearchX(icon.Props{Class: "size-8 opacity-20"})
						<span class="text-xs">{ i18n.T(ctx, "No plugins match your search") }</span>
					</div>
				</template>
				<!-- Plugin list -->
				<template x-if="filteredPlugins.length > 0">
					<div class="divide-y divide-border/50">
						<template x-for="plugin in filteredPlugins" :key="plugin.id">
							<div>
								<!-- Plugin row -->
								<div
									class="group flex items-start gap-2.5 px-3 py-2 cursor-pointer select-none transition-colors"
									:class="isExpanded(plugin) ? 'bg-accent/60' : 'hover:bg-accent/40'"
									@click="toggleExpand(plugin)"
								>
									<!-- Plugin icon -->
									<div
										class="size-8 rounded flex items-center justify-center shrink-0 mt-0.5"
										:class="plugin.enabled ? 'bg-primary/10' : 'bg-accent/80'"
									>
										@icon.Blocks(icon.Props{Class: "size-4"})
									</div>
									<!-- Info -->
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-1.5">
											<span x-text="plugin.name" class="text-sm font-medium text-foreground truncate"></span>
											<span
												class="shrink-0 text-[10px] text-muted-foreground tabular-nums"
												x-text="`${plugin.tools.filter(t => t.enabled).length}/${plugin.tools.length}`"
											></span>
										</div>
										<p x-text="plugin.description" class="text-xs text-muted-foreground truncate mt-0.5 leading-snug"></p>
										<span
											class="inline-block mt-0.5 px-1.5 py-0 text-[9px] font-medium rounded-full bg-accent text-muted-foreground"
											x-text="plugin.category"
										></span>
									</div>
									<!-- Enable/disable toggle -->
									<button
										@click.stop="togglePlugin(plugin)"
										class="shrink-0 mt-1 relative inline-flex h-4 w-7 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
										:class="plugin.enabled ? 'bg-primary' : 'bg-input'"
										role="switch"
										:aria-checked="plugin.enabled"
										:aria-label="plugin.name"
									>
										<span
											class="pointer-events-none inline-block h-3 w-3 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
											:class="plugin.enabled ? 'translate-x-3' : 'translate-x-0'"
										></span>
									</button>
								</div>
								<!-- Expanded: individual tools -->
								<div
									x-show="isExpanded(plugin)"
									x-collapse
								>
									<div class="bg-accent/30 border-t border-border/50">
										<template x-for="tool in plugin.tools" :key="tool.id">
											<div class="flex items-center gap-2.5 pl-[3.25rem] pr-3 py-1.5 hover:bg-accent/50 transition-colors">
												<div class="flex-1 min-w-0">
													<span x-text="tool.name" class="text-xs font-medium text-foreground"></span>
													<p x-text="tool.description" class="text-[11px] text-muted-foreground truncate leading-snug"></p>
												</div>
												<button
													@click="toggleTool(plugin, tool)"
													class="shrink-0 relative inline-flex h-3.5 w-6 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-40"
													:class="tool.enabled ? 'bg-primary/80' : 'bg-input'"
													role="switch"
													:aria-checked="tool.enabled"
													:aria-label="tool.name"
													:disabled="!plugin.enabled"
												>
													<span
														class="pointer-events-none inline-block h-2.5 w-2.5 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
														:class="tool.enabled ? 'translate-x-2.5' : 'translate-x-0'"
													></span>
												</button>
											</div>
										</template>
									</div>
								</div>
							</div>
						</template>
					</div>
				</template>
			</div>
			<!-- Footer -->
			<div class="flex items-center justify-between px-3 py-1.5 border-t border-border shrink-0">
				<span class="text-[10px] text-muted-foreground tabular-nums" x-show="plugins.length > 0">
					<span x-text="enabledSummary.sets"></span>/<span x-text="enabledSummary.total"></span> { i18n.T(ctx, "enabled") } ·
					<span x-text="enabledSummary.tools"></span> { i18n.T(ctx, "tools") }
				</span>
				<div x-show="plugins.length === 0"></div>
			</div>
		</aside>
	</div>
}

templ ToolsButtonTrigger() {
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Class:   "size-9",
		Attributes: templ.Attributes{
			"@click": "$dispatch('toggle-tools-sidebar')",
			"title":  i18n.T(ctx, "Tools"),
		},
	}) {
		@icon.Wrench(icon.Props{Class: "size-5"})
		<span class="sr-only">{ i18n.T(ctx, "Tools") }</span>
	}
}
