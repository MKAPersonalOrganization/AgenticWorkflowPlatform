package tools

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ ToolsDialog() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('toolsDialog', () => ({
				tools: [],
				agents: [],
				loading: false,
				loadingAgents: false,
				search: '',
				selectedAgent: '',
				selectedCategory: 'all',
				viewMode: 'grid', // 'grid' or 'list'
				async init() {
					const chatEl = document.querySelector('[x-data="chat"]');
					if (chatEl) {
						try {
							const chatData = Alpine.$data(chatEl);
							if (chatData) {
								this.selectedAgent = chatData.selectedAgent || '';
							}
						} catch (e) { /* ignore */ }
					}
					await this.fetchAgents();
					await this.fetchTools();
				},
				async fetchAgents() {
					this.loadingAgents = true;
					try {
						const response = await fetch('/v1/agents');
						if (response.ok) {
							const data = await response.json();
							if (data.agents && Array.isArray(data.agents)) {
								this.agents = data.agents;
								// Set first agent as default if no agent is selected
								if (!this.selectedAgent && this.agents.length > 0) {
									this.selectedAgent = this.agents[0].id;
								}
							}
						}
					} catch (err) {
						console.error('Failed to fetch agents:', err);
					} finally {
						this.loadingAgents = false;
					}
				},
				async fetchTools() {
					if (!this.selectedAgent) {
						this.tools = [];
						return;
					}
					this.loading = true;
					try {
						const response = await fetch(`/v1/agents/${this.selectedAgent}/toolsets`);
						if (response.ok) {
							const data = await response.json();
							if (data.toolsets && Array.isArray(data.toolsets)) {
								this.tools = data.toolsets;
							}
						} else {
							// Handle case where agent doesn't exist or has no tools
							this.tools = [];
						}
					} catch (err) {
						console.error('Failed to fetch tool sets:', err);
						this.tools = [];
					} finally {
						this.loading = false;
					}
				},
				async onAgentChange() {
					// Clear current tools and fetch new ones
					this.tools = [];
					await this.fetchTools();
				},
				get filteredTools() {
					let filtered = this.tools;
					
					// Apply category filter
					if (this.selectedCategory !== 'all') {
						filtered = filtered.filter(toolSet => toolSet.category === this.selectedCategory);
					}
					
					// Apply search filter
					if (this.search) {
						const q = this.search.toLowerCase();
						filtered = filtered.filter(toolSet =>
							toolSet.name.toLowerCase().includes(q) ||
							toolSet.description.toLowerCase().includes(q) ||
							toolSet.category.toLowerCase().includes(q) ||
							toolSet.tools.some(tool => 
								tool.name.toLowerCase().includes(q) ||
								tool.description.toLowerCase().includes(q)
							)
						);
					}
					
					return filtered;
				},
				get categories() {
					const cats = [...new Set(this.tools.map(t => t.category))];
					cats.sort();
					return cats;
				},
				get categoriesWithCounts() {
					const counts = {};
					this.tools.forEach(toolSet => {
						counts[toolSet.category] = (counts[toolSet.category] || 0) + 1;
					});
					return Object.entries(counts).map(([category, count]) => ({ category, count }));
				},
				toolSetsByCategory(category) {
					return this.filteredTools.filter(t => t.category === category);
				},
				async toggleToolSet(toolSet) {
					const newState = !toolSet.enabled;
					try {
						const response = await fetch(`/v1/agents/${this.selectedAgent}/toolsets/${toolSet.id}`, {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ enabled: newState })
						});
						if (response.ok) {
							toolSet.enabled = newState;
							// If disabling the tool set, disable all individual tools
							if (!newState) {
								toolSet.tools.forEach(tool => tool.enabled = false);
							} else {
								// If enabling the tool set, enable all individual tools (default behavior)
								toolSet.tools.forEach(tool => tool.enabled = true);
							}
						}
					} catch (err) {
						console.error('Failed to toggle tool set:', err);
					}
				},
				async toggleTool(toolSet, tool) {
					const newState = !tool.enabled;
					try {
						const response = await fetch(`/v1/agents/${this.selectedAgent}/toolsets/${toolSet.id}/tools/${tool.id}`, {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ enabled: newState })
						});
						if (response.ok) {
							tool.enabled = newState;
							// Update tool set status based on individual tool states
							const enabledTools = toolSet.tools.filter(t => t.enabled).length;
							const totalTools = toolSet.tools.length;
							// Tool set is considered enabled if at least one tool is enabled
							toolSet.enabled = enabledTools > 0;
						}
					} catch (err) {
						console.error('Failed to toggle individual tool:', err);
					}
				},
				categoryColor(category) {
					const colors = {
						'Calculator': 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
						'Visualization': 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
						'Documents': 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
						'Memory': 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400',
					};
					return colors[category] || 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400';
				}
			}));
		});
	</script>
	<div
		x-data="toolsDialog"
		@open-tools-dialog.window="init()"
	>
		@dialog.Dialog(dialog.Props{
			ID: "tools-manager-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "!w-[98vw] !h-[95vh] !max-w-none !max-h-none flex flex-col p-0 overflow-hidden",
			}) {
				@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
					<div class="flex items-center justify-between">
						<div>
							@dialog.Title() {
								{ i18n.T(ctx, "Tools Management") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "Select an agent and manage its available tools.") }
							}
						</div>
						<div class="flex items-center gap-3">
							<!-- View Mode Toggle -->
							<div class="flex items-center border border-border rounded-md">
								<button
									@click="viewMode = 'grid'"
									class="px-3 py-1.5 text-xs font-medium rounded-l-md transition-colors"
									:class="viewMode === 'grid' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:text-foreground'"
								>
									Grid
								</button>
								<button
									@click="viewMode = 'list'"
									class="px-3 py-1.5 text-xs font-medium rounded-r-md transition-colors"
									:class="viewMode === 'list' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:text-foreground'"
								>
									List
								</button>
							</div>
						</div>
					</div>
				}
				<!-- Top Controls -->
				<div class="p-4 border-b border-border bg-muted/30">
					<div class="flex gap-4">
						<!-- Agent Selection -->
						<div class="flex-1">
							<label class="block text-sm font-medium text-foreground mb-2">{ i18n.T(ctx, "Select Agent") }</label>
							<div class="relative">
								<select
									x-model="selectedAgent"
									@change="onAgentChange()"
									class="w-full rounded-md border border-input bg-background px-3 py-2 pr-8 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring appearance-none"
									:disabled="loadingAgents"
								>
									<template x-for="agent in agents" :key="agent.id">
										<option :value="agent.id" x-text="agent.name"></option>
									</template>
								</select>
								<div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
									<template x-if="loadingAgents">
										<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary"></div>
									</template>
									<template x-if="!loadingAgents">
										<svg class="h-4 w-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
										</svg>
									</template>
								</div>
							</div>
						</div>
						<!-- Search -->
						<div class="flex-1">
							<label class="block text-sm font-medium text-foreground mb-2">{ i18n.T(ctx, "Search Tools") }</label>
							<input
								type="text"
								x-model="search"
								placeholder={ i18n.T(ctx, "Search tools and tool sets...") }
								class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
							/>
						</div>
					</div>
				</div>
				<!-- Main Content with Sidebar -->
				<div class="flex-1 flex overflow-hidden">
					<!-- Category Sidebar -->
					<div class="w-64 border-r border-border bg-muted/20 overflow-y-auto">
						<div class="p-4">
							<h3 class="text-sm font-semibold text-foreground mb-3">Categories</h3>
							<div class="space-y-1">
								<!-- All Tools Option -->
								<button
									@click="selectedCategory = 'all'"
									class="w-full text-left px-3 py-2 text-sm rounded-md transition-colors"
									:class="selectedCategory === 'all' ? 'bg-primary text-primary-foreground' : 'text-foreground hover:bg-accent'"
								>
									<div class="flex items-center justify-between">
										<span>All Tools</span>
										<span class="text-xs" x-text="tools.length"></span>
									</div>
								</button>
								<!-- Category List -->
								<template x-for="{ category, count } in categoriesWithCounts" :key="category">
									<button
										@click="selectedCategory = category"
										class="w-full text-left px-3 py-2 text-sm rounded-md transition-colors"
										:class="selectedCategory === category ? 'bg-primary text-primary-foreground' : 'text-foreground hover:bg-accent'"
									>
										<div class="flex items-center justify-between">
											<span x-text="category"></span>
											<span class="text-xs" x-text="count"></span>
										</div>
									</button>
								</template>
							</div>
						</div>
					</div>
					<!-- Tools Content -->
					<div class="flex-1 overflow-auto">
						<div class="p-4">
							<!-- Loading States -->
							<template x-if="loading && tools.length === 0">
								<div class="flex justify-center p-8">
									<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
								</div>
							</template>
							<template x-if="!loading && !selectedAgent">
								<div class="text-center p-8 text-muted-foreground italic">
									{ i18n.T(ctx, "Please select an agent to view its tools.") }
								</div>
							</template>
							<template x-if="!loading && selectedAgent && tools.length === 0">
								<div class="text-center p-8 text-muted-foreground italic">
									{ i18n.T(ctx, "No tools available for this agent.") }
								</div>
							</template>
							<template x-if="!loading && filteredTools.length === 0 && tools.length > 0">
								<div class="text-center p-8 text-muted-foreground italic">
									{ i18n.T(ctx, "No tools match your search or category filter.") }
								</div>
							</template>
							<!-- Tools Grid/List -->
							<template x-if="filteredTools.length > 0">
								<div>
									<!-- Stats Header -->
									<div class="flex items-center justify-between mb-4">
										<div class="text-sm text-muted-foreground">
											<span x-text="filteredTools.length"></span> tool sets
											<template x-if="selectedCategory !== 'all'">
												in "<span x-text="selectedCategory"></span>"
											</template>
											<template x-if="search">
												matching "<span x-text="search"></span>"
											</template>
										</div>
									</div>
									<!-- Grid Layout -->
									<div
										x-show="viewMode === 'grid'"
										class="grid gap-4"
										:class="filteredTools.length > 6 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' : filteredTools.length > 2 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'"
									>
										<template x-for="toolSet in filteredTools" :key="toolSet.id">
											<div class="border border-border rounded-lg overflow-hidden hover:shadow-md transition-shadow">
												<!-- Tool Set Header -->
												<div class="flex items-start justify-between gap-3 p-4 bg-accent/20">
													<div class="flex flex-col gap-1 flex-1 min-w-0">
														<div class="flex items-center gap-2">
															<span x-text="toolSet.name" class="text-sm font-medium text-foreground"></span>
															<span
																class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium"
																:class="categoryColor(toolSet.category)"
																x-text="toolSet.category"
															></span>
														</div>
														<span x-text="toolSet.description" class="text-xs text-muted-foreground line-clamp-2"></span>
														<span class="text-xs text-muted-foreground mt-1" x-text="`${toolSet.tools.length} tools`"></span>
													</div>
													<div class="flex flex-col items-end gap-2">
														<!-- Tool Set Toggle -->
														<button
															@click="toggleToolSet(toolSet)"
															class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
															:class="toolSet.enabled ? 'bg-primary' : 'bg-input'"
															role="switch"
															:aria-checked="toolSet.enabled"
															:title="toolSet.enabled ? 'Disable tool set' : 'Enable tool set'"
														>
															<span
																class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
																:class="toolSet.enabled ? 'translate-x-4' : 'translate-x-0'"
															></span>
														</button>
													</div>
												</div>
												<!-- Individual Tools -->
												<div class="border-t border-border divide-y divide-border">
													<template x-for="tool in toolSet.tools" :key="tool.id">
														<div class="flex items-center justify-between gap-3 py-2.5 px-4 hover:bg-accent/30 transition-colors">
															<div class="flex flex-col gap-0.5 flex-1 min-w-0">
																<span x-text="tool.name" class="text-sm text-foreground"></span>
																<span x-text="tool.description" class="text-xs text-muted-foreground line-clamp-1"></span>
															</div>
															<button
																@click="toggleTool(toolSet, tool)"
																class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
																:class="tool.enabled ? 'bg-primary/80' : 'bg-input'"
																role="switch"
																:aria-checked="tool.enabled"
																:title="tool.enabled ? `Disable ${tool.name}` : `Enable ${tool.name}`"
																:disabled="!toolSet.enabled"
															>
																<span
																	class="pointer-events-none inline-block h-3 w-3 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
																	:class="tool.enabled ? 'translate-x-3' : 'translate-x-0'"
																></span>
															</button>
														</div>
													</template>
												</div>
											</div>
										</template>
									</div>
									<!-- List Layout -->
									<div
										x-show="viewMode === 'list'"
										class="space-y-2"
									>
										<template x-for="toolSet in filteredTools" :key="toolSet.id">
											<div class="border border-border rounded-lg overflow-hidden">
												<!-- Tool Set Header -->
												<div class="flex items-center justify-between gap-3 p-3 bg-accent/20">
													<div class="flex flex-col gap-0.5 flex-1 min-w-0">
														<div class="flex items-center gap-2">
															<span x-text="toolSet.name" class="text-sm font-medium text-foreground"></span>
															<span
																class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium"
																:class="categoryColor(toolSet.category)"
																x-text="toolSet.category"
															></span>
															<span class="text-xs text-muted-foreground" x-text="`(${toolSet.tools.length} tools)`"></span>
														</div>
														<span x-text="toolSet.description" class="text-xs text-muted-foreground"></span>
													</div>
													<div class="flex items-center gap-2">
														<!-- Tool Set Toggle -->
														<button
															@click="toggleToolSet(toolSet)"
															class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
															:class="toolSet.enabled ? 'bg-primary' : 'bg-input'"
															role="switch"
															:aria-checked="toolSet.enabled"
															:title="toolSet.enabled ? 'Disable tool set' : 'Enable tool set'"
														>
															<span
																class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
																:class="toolSet.enabled ? 'translate-x-4' : 'translate-x-0'"
															></span>
														</button>
													</div>
												</div>
												<!-- Individual Tools -->
												<div class="border-t border-border">
													<template x-for="tool in toolSet.tools" :key="tool.id">
														<div class="flex items-center justify-between gap-3 py-2.5 px-3 hover:bg-accent/30 transition-colors">
															<div class="flex flex-col gap-0.5 flex-1 min-w-0 pl-2">
																<span x-text="tool.name" class="text-sm text-foreground"></span>
																<span x-text="tool.description" class="text-xs text-muted-foreground truncate"></span>
															</div>
															<button
																@click="toggleTool(toolSet, tool)"
																class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
																:class="tool.enabled ? 'bg-primary/80' : 'bg-input'"
																role="switch"
																:aria-checked="tool.enabled"
																:title="tool.enabled ? `Disable ${tool.name}` : `Enable ${tool.name}`"
																:disabled="!toolSet.enabled"
															>
																<span
																	class="pointer-events-none inline-block h-3 w-3 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
																	:class="tool.enabled ? 'translate-x-3' : 'translate-x-0'"
																></span>
															</button>
														</div>
													</template>
												</div>
											</div>
										</template>
									</div>
								</div>
							</template>
						</div>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{Class: "p-6 pt-2 border-t mt-auto"}) {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantGhost}) {
							{ i18n.T(ctx, "Close") }
						}
					}
				}
			}
		}
	</div>
}

templ ToolsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "tools-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-tools-dialog')",
				"title":  i18n.T(ctx, "Tools"),
			},
		}) {
			@icon.Wrench(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Tools") }</span>
		}
	}
}
