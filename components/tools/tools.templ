package tools

import (
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ ToolsSidebar() {
	<!-- Plugins Sidebar (VS Code Extensions-style) -->
	<div
		x-data="toolsSidebar"
		@toggle-tools-sidebar.window="toggle()"
		class="contents"
	>
		<!-- ═══════════ SIDEBAR: Search & Browse Only ═══════════ -->
		<aside
			x-show="open"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="-translate-x-full opacity-0"
			x-transition:enter-end="translate-x-0 opacity-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="translate-x-0 opacity-100"
			x-transition:leave-end="-translate-x-full opacity-0"
			x-cloak
			class="fixed left-12 top-0 h-svh w-80 z-30 bg-sidebar border-r border-sidebar-border flex flex-col"
		>
			<div class="flex flex-col h-full">
				<!-- Header -->
				<div class="flex items-center justify-between px-3 py-2 border-b border-border shrink-0">
					<div class="flex items-center gap-1.5">
						@icon.Blocks(icon.Props{Class: "size-3.5 text-muted-foreground"})
						<span class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "Plugins") }</span>
					</div>
					<div class="flex items-center gap-1">
						<button
							@click="fetchPlugins()"
							class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							title={ i18n.T(ctx, "Refresh") }
						>
							@icon.RotateCw(icon.Props{Class: "size-3"})
						</button>
						<button
							@click="open = false"
							class="p-1 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
						>
							@icon.X(icon.Props{Class: "size-3.5"})
						</button>
					</div>
				</div>
				<!-- Search bar -->
				<div class="px-2 py-1.5 border-b border-border shrink-0">
					<div class="relative">
						<div class="absolute inset-y-0 left-0 flex items-center pl-2 pointer-events-none">
							@icon.Search(icon.Props{Class: "size-3.5 text-muted-foreground"})
						</div>
						<input
							type="text"
							x-model="search"
							placeholder={ i18n.T(ctx, "Search plugins...") }
							class="w-full rounded border border-input bg-background pl-7 pr-7 py-1 text-xs ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring transition-colors"
						/>
						<button
							x-show="search.length > 0"
							x-transition
							@click="search = ''"
							class="absolute inset-y-0 right-0 flex items-center pr-2 text-muted-foreground hover:text-foreground transition-colors"
						>
							@icon.X(icon.Props{Class: "size-3"})
						</button>
					</div>
				</div>
				<!-- Scrollable plugin list -->
				<div class="flex-1 overflow-y-auto scrollbar-thin">
					<!-- Loading skeleton -->
					<template x-if="loading && plugins.length === 0">
						<div class="divide-y divide-border">
							<template x-for="i in 5" :key="i">
								<div class="flex items-center gap-3 px-3 py-2.5 animate-pulse">
									<div class="size-8 rounded bg-muted shrink-0"></div>
									<div class="flex-1 space-y-1.5">
										<div class="h-3 bg-muted rounded w-1/3"></div>
										<div class="h-2.5 bg-muted rounded w-2/3"></div>
									</div>
								</div>
							</template>
						</div>
					</template>
					<!-- Empty state -->
					<template x-if="!loading && plugins.length === 0">
						<div class="flex flex-col items-center justify-center py-12 gap-2 text-muted-foreground">
							@icon.PackageOpen(icon.Props{Class: "size-8 opacity-20"})
							<span class="text-xs">{ i18n.T(ctx, "No plugins available") }</span>
						</div>
					</template>
					<!-- No search results -->
					<template x-if="!loading && filteredPlugins.length === 0 && plugins.length > 0">
						<div class="flex flex-col items-center justify-center py-12 gap-2 text-muted-foreground">
							@icon.SearchX(icon.Props{Class: "size-8 opacity-20"})
							<span class="text-xs">{ i18n.T(ctx, "No plugins match your search") }</span>
						</div>
					</template>
					<!-- Plugin list -->
					<template x-if="filteredPlugins.length > 0">
						<div class="divide-y divide-border/50">
							<template x-for="plugin in filteredPlugins" :key="plugin.id">
								<div
									class="group flex items-start gap-2.5 px-3 py-2.5 cursor-pointer select-none transition-colors hover:bg-accent/40"
									:class="profilePlugin && profilePlugin.id === plugin.id ? 'bg-accent/60 border-l-2 border-l-primary' : ''"
									@click="openProfile(plugin)"
								>
									<!-- Plugin icon -->
									<div
										class="size-9 rounded-lg flex items-center justify-center shrink-0 mt-0.5"
										:class="plugin.enabled ? 'bg-primary/10 text-primary' : 'bg-accent/80 text-muted-foreground'"
									>
										@icon.Blocks(icon.Props{Class: "size-4"})
									</div>
									<!-- Info -->
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-1.5">
											<span x-text="plugin.name" class="text-sm font-medium text-foreground truncate"></span>
											<span
												x-show="plugin.enabled"
												class="shrink-0 size-1.5 rounded-full bg-emerald-500"
												title={ i18n.T(ctx, "Enabled") }
											></span>
										</div>
										<p x-text="plugin.description" class="text-xs text-muted-foreground truncate mt-0.5 leading-snug"></p>
										<div class="flex items-center gap-1.5 mt-1">
											<span
												class="inline-block px-1.5 py-0 text-[9px] font-medium rounded-full bg-accent text-muted-foreground"
												x-text="plugin.category"
											></span>
											<span
												class="text-[10px] text-muted-foreground/60 tabular-nums"
												x-text="`${plugin.tools.filter(t => t.enabled).length}/${plugin.tools.length} tools`"
											></span>
										</div>
									</div>
								</div>
							</template>
						</div>
					</template>
				</div>
				<!-- Footer -->
				<div class="flex items-center justify-between px-3 py-1.5 border-t border-border shrink-0">
					<span class="text-[10px] text-muted-foreground tabular-nums" x-show="plugins.length > 0">
						<span x-text="enabledSummary.sets"></span>/<span x-text="enabledSummary.total"></span> { i18n.T(ctx, "enabled") } ·
						<span x-text="enabledSummary.tools"></span> { i18n.T(ctx, "tools") }
					</span>
					<div x-show="plugins.length === 0"></div>
				</div>
			</div>
		</aside>
		<!-- ═══════════ DETAIL PANEL (editor-tab area, VS Code / IntelliJ style) ═══════════ -->
		<div
			x-show="profilePlugin"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 translate-y-2"
			x-cloak
			class="fixed inset-0 z-40 bg-background overflow-hidden flex flex-col"
			style="left: calc(3rem + 20rem)"
		>
			<template x-if="profilePlugin">
				<div class="flex flex-col h-full overflow-hidden">
					<!-- Editor tab bar -->
					<div class="flex items-center h-9 bg-sidebar border-b border-border shrink-0 px-1 gap-px">
						<div class="flex items-center gap-1.5 px-3 h-full bg-background border-r border-border text-xs font-medium text-foreground">
							@icon.Puzzle(icon.Props{Class: "size-3.5 text-primary"})
							<span x-text="profilePlugin.name" class="truncate max-w-[200px]"></span>
							<button
								@click="closeProfile()"
								class="ml-2 p-0.5 rounded hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							>
								@icon.X(icon.Props{Class: "size-3"})
							</button>
						</div>
					</div>
					<!-- Scrollable content -->
					<div class="flex-1 overflow-y-auto">
						<!-- Banner header -->
						<div class="bg-sidebar border-b border-border">
							<div class="max-w-5xl mx-auto px-6 py-5">
								<div class="flex items-start gap-5">
									<!-- Icon -->
									<div class="size-[72px] rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/10 flex items-center justify-center shrink-0 shadow-sm">
										@icon.Puzzle(icon.Props{Class: "size-9 text-primary"})
									</div>
									<!-- Info -->
									<div class="flex-1 min-w-0">
										<h1 x-text="profilePlugin.name" class="text-xl font-bold text-foreground"></h1>
										<p x-text="profilePlugin.description" class="text-sm text-muted-foreground leading-relaxed mt-1 max-w-2xl"></p>
										<!-- Stats row -->
										<div class="flex items-center gap-3 mt-3 text-xs text-muted-foreground">
											<span class="flex items-center gap-1">
												@icon.Tag(icon.Props{Class: "size-3"})
												<span x-text="profilePlugin.category"></span>
											</span>
											<span class="text-border">|</span>
											<span class="flex items-center gap-1">
												@icon.Blocks(icon.Props{Class: "size-3"})
												<span x-text="profilePlugin.tools.length + ' tools'"></span>
											</span>
											<span class="text-border">|</span>
											<span class="flex items-center gap-1">
												@icon.CircleCheck(icon.Props{Class: "size-3"})
												<span x-text="profilePlugin.tools.filter(t => t.enabled).length + ' active'"></span>
											</span>
										</div>
										<!-- Action buttons — like VS Code Install/Uninstall -->
										<div class="flex items-center gap-2 mt-4">
											<button
												@click="togglePlugin(profilePlugin)"
												class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-md transition-colors"
												:class="profilePlugin.enabled
													? 'bg-destructive/10 text-destructive hover:bg-destructive/20 border border-destructive/20'
													: 'bg-primary text-primary-foreground hover:bg-primary/90'"
											>
												<template x-if="!profilePlugin.enabled">
													<span class="flex items-center gap-1.5">
														@icon.Download(icon.Props{Class: "size-3.5"})
														{ i18n.T(ctx, "Enable") }
													</span>
												</template>
												<template x-if="profilePlugin.enabled">
													<span class="flex items-center gap-1.5">
														@icon.X(icon.Props{Class: "size-3.5"})
														{ i18n.T(ctx, "Disable") }
													</span>
												</template>
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>
						<!-- Body: Tabs + side metadata -->
						<div class="max-w-5xl mx-auto px-6 py-6">
							<div class="flex gap-8">
								<!-- Main content area -->
								<div class="flex-1 min-w-0">
									<!-- Tab switcher -->
									<div class="flex items-center gap-0 border-b border-border mb-5">
										<button
											@click="profileTab = 'details'"
											class="px-4 py-2 text-xs font-medium transition-colors border-b-2 -mb-px"
											:class="profileTab === 'details' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground'"
										>
											@icon.Info(icon.Props{Class: "size-3.5 inline mr-1.5 -mt-px"})
											{ i18n.T(ctx, "Details") }
										</button>
										<button
											@click="profileTab = 'tools'"
											class="px-4 py-2 text-xs font-medium transition-colors border-b-2 -mb-px"
											:class="profileTab === 'tools' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground hover:text-foreground'"
										>
											@icon.Wrench(icon.Props{Class: "size-3.5 inline mr-1.5 -mt-px"})
											{ i18n.T(ctx, "Feature Contributions") }
										</button>
									</div>
									<!-- ── Details tab ── -->
									<div x-show="profileTab === 'details'">
										<div class="prose prose-sm dark:prose-invert max-w-none">
											<p x-text="profilePlugin.description" class="text-muted-foreground leading-relaxed"></p>
											<template x-if="profilePlugin.tools.length > 0">
												<div>
													<h3 class="text-sm font-semibold text-foreground mt-6 mb-3 flex items-center gap-2">
														@icon.Sparkles(icon.Props{Class: "size-4 text-primary"})
														{ i18n.T(ctx, "What this plugin provides") }
													</h3>
													<ul class="space-y-2.5 list-none pl-0 mt-0">
														<template x-for="tool in profilePlugin.tools" :key="tool.id">
															<li class="flex items-start gap-2.5 text-sm text-muted-foreground">
																@icon.ChevronRight(icon.Props{Class: "size-3.5 mt-0.5 text-primary shrink-0"})
																<span>
																	<span class="font-medium text-foreground" x-text="tool.name"></span>
																	<span>— </span>
																	<span x-text="tool.description"></span>
																</span>
															</li>
														</template>
													</ul>
												</div>
											</template>
										</div>
									</div>
									<!-- ── Feature Contributions tab (with inline toggles) ── -->
									<div x-show="profileTab === 'tools'">
										<template x-if="profilePlugin.tools.length === 0">
											<div class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground">
												@icon.PackageOpen(icon.Props{Class: "size-10 opacity-20"})
												<p class="text-sm">{ i18n.T(ctx, "No tools registered for this plugin") }</p>
											</div>
										</template>
										<template x-if="profilePlugin.tools.length > 0">
											<div class="border border-border rounded-lg overflow-hidden">
												<table class="w-full text-sm">
													<thead>
														<tr class="bg-muted/50 border-b border-border">
															<th class="text-left px-4 py-2.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider">
																{ i18n.T(ctx, "Tool") }
															</th>
															<th class="text-left px-4 py-2.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider hidden md:table-cell">
																{ i18n.T(ctx, "Category") }
															</th>
															<th class="text-center px-4 py-2.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider w-24">
																{ i18n.T(ctx, "Enabled") }
															</th>
														</tr>
													</thead>
													<tbody class="divide-y divide-border/50">
														<template x-for="tool in profilePlugin.tools" :key="tool.id">
															<tr class="hover:bg-accent/30 transition-colors">
																<td class="px-4 py-3">
																	<div class="flex items-center gap-2.5">
																		<div class="size-7 rounded bg-accent flex items-center justify-center shrink-0">
																			@icon.Cog(icon.Props{Class: "size-3.5 text-muted-foreground"})
																		</div>
																		<div class="min-w-0">
																			<div class="font-medium text-foreground truncate" x-text="tool.name"></div>
																			<div class="text-xs text-muted-foreground truncate max-w-sm" x-text="tool.description"></div>
																		</div>
																	</div>
																</td>
																<td class="px-4 py-3 hidden md:table-cell">
																	<template x-if="tool.category">
																		<span class="inline-block px-2 py-0.5 text-[10px] font-medium rounded-full bg-accent text-muted-foreground" x-text="tool.category"></span>
																	</template>
																	<template x-if="!tool.category">
																		<span class="text-xs text-muted-foreground/40">—</span>
																	</template>
																</td>
																<td class="px-4 py-3">
																	<div class="flex justify-center">
																		<button
																			@click="toggleTool(profilePlugin, tool)"
																			class="relative inline-flex h-5 w-9 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"
																			:class="tool.enabled ? 'bg-primary' : 'bg-input'"
																			role="switch"
																			:aria-checked="tool.enabled"
																			:aria-label="tool.name"
																			:disabled="!profilePlugin.enabled"
																		>
																			<span
																				class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
																				:class="tool.enabled ? 'translate-x-4' : 'translate-x-0'"
																			></span>
																		</button>
																	</div>
																</td>
															</tr>
														</template>
													</tbody>
												</table>
											</div>
										</template>
									</div>
								</div>
								<!-- Right sidebar metadata -->
								<aside class="w-52 shrink-0 hidden lg:block">
									<div class="space-y-4 sticky top-6">
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Category") }</div>
											<div class="text-xs text-foreground flex items-center gap-1.5">
												@icon.Tag(icon.Props{Class: "size-3 text-muted-foreground"})
												<span x-text="profilePlugin.category"></span>
											</div>
										</div>
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Tools") }</div>
											<div class="text-xs text-foreground" x-text="profilePlugin.tools.length + ' registered'"></div>
										</div>
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Active Tools") }</div>
											<div class="text-xs text-foreground" x-text="profilePlugin.tools.filter(t=>t.enabled).length + ' of ' + profilePlugin.tools.length"></div>
										</div>
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Status") }</div>
											<template x-if="profilePlugin.enabled">
												<div class="text-xs flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
													@icon.CircleCheck(icon.Props{Class: "size-3"})
													{ i18n.T(ctx, "Enabled") }
												</div>
											</template>
											<template x-if="!profilePlugin.enabled">
												<div class="text-xs flex items-center gap-1.5 text-muted-foreground">
													@icon.CircleDot(icon.Props{Class: "size-3"})
													{ i18n.T(ctx, "Disabled") }
												</div>
											</template>
										</div>
										<div>
											<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "Plugin ID") }</div>
											<code class="text-[11px] bg-muted px-1.5 py-0.5 rounded font-mono break-all" x-text="profilePlugin.id"></code>
										</div>
									</div>
								</aside>
							</div>
						</div>
					</div>
				</div>
			</template>
		</div>
	</div>
}

templ ToolsButtonTrigger() {
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Class:   "size-9",
		Attributes: templ.Attributes{
			"@click": "$dispatch('toggle-tools-sidebar')",
			"title":  i18n.T(ctx, "Tools"),
		},
	}) {
		@icon.Wrench(icon.Props{Class: "size-5"})
		<span class="sr-only">{ i18n.T(ctx, "Tools") }</span>
	}
}
