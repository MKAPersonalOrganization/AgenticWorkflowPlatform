package tools

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
	"school-with-ai/components/input"
)

templ ToolsDialog() {
	<div
		x-data="toolsDialog"
		@open-tools-dialog.window="open()"
	>
		<div x-data="{ expanded: false, toggleExpand() { this.expanded = !this.expanded } }">
			@dialog.Dialog(dialog.Props{
				ID: "tools-manager-dialog",
			}) {
				@dialog.Content(dialog.ContentProps{
					HideCloseButton: true,
					Class:           "sm:max-w-4xl max-h-[90vh] flex flex-col p-0 overflow-hidden transition-all duration-300 ease-in-out",
					Attributes: templ.Attributes{
						":class": "expanded ? '!max-w-[calc(100vw-2rem)] !max-h-[calc(100vh-2rem)] !w-[calc(100vw-2rem)] !h-[calc(100vh-2rem)]' : ''",
					},
				}) {
				<!-- Main View (Plugins + MCP Tabs) -->
				<template x-if="!detailItem">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
							<div class="flex items-center justify-between mb-3">
								<div>
									@dialog.Title() {
										{ i18n.T(ctx, "Plugins & Tools") }
									}
									@dialog.Description() {
										{ i18n.T(ctx, "Manage built-in plugins and MCP server connections.") }
									}
								</div>
								<div class="flex items-center gap-1">
									@button.Button(button.Props{
										Size:    button.SizeIcon,
										Variant: button.VariantGhost,
										Class:   "size-7 text-muted-foreground",
										Attributes: templ.Attributes{
											"@click": "toggleExpand()",
											"title":  i18n.T(ctx, "Toggle fullscreen"),
										},
									}) {
										<span x-show="!expanded">
											@icon.Maximize2(icon.Props{Class: "size-3.5"})
										</span>
										<span x-show="expanded">
											@icon.Minimize2(icon.Props{Class: "size-3.5"})
										</span>
									}
									@dialog.Close() {
										@button.Button(button.Props{
											Size:    button.SizeIcon,
											Variant: button.VariantGhost,
											Class:   "size-7 text-muted-foreground",
											Attributes: templ.Attributes{
												"title": i18n.T(ctx, "Close"),
											},
										}) {
											@icon.X(icon.Props{Class: "size-3.5"})
										}
									}
								</div>
							</div>
							<!-- Tab Bar -->
							<div class="flex gap-0 -mb-px">
								<button
									type="button"
									@click="activeTab = 'plugins'"
									class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
									:class="activeTab === 'plugins' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
								>
									@icon.Blocks(icon.Props{Class: "size-4 inline-block me-1.5 -mt-0.5"})
									{ i18n.T(ctx, "Built-in Plugins") }
								</button>
								<button
									type="button"
									@click="activeTab = 'mcp'"
									class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
									:class="activeTab === 'mcp' ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border'"
								>
									@icon.MCPLogo("size-4 inline-block me-1.5 -mt-0.5")
									{ i18n.T(ctx, "MCP Servers") }
								</button>
							</div>
						}
						<!-- ═══════ Built-in Plugins Tab ═══════ -->
						<template x-if="activeTab === 'plugins'">
							<div class="flex flex-col flex-1 overflow-hidden">
								<!-- Search bar -->
								<div class="px-4 pt-3 pb-2">
									@input.Input(input.Props{
										Type:        input.TypeSearch,
										Placeholder: i18n.T(ctx, "Search plugins..."),
										Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
										Attributes: templ.Attributes{
											"x-model.debounce.300ms": "search",
										},
									})
								</div>
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<!-- Loading skeleton -->
									<template x-if="loading && plugins.length === 0">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
											<template x-for="i in 6" :key="i">
												<div class="p-4 rounded-lg border border-border animate-pulse">
													<div class="flex items-center gap-3 mb-3">
														<div class="size-10 rounded-lg bg-muted"></div>
														<div class="flex-1 space-y-2">
															<div class="h-4 bg-muted rounded w-2/3"></div>
															<div class="h-3 bg-muted rounded w-1/3"></div>
														</div>
													</div>
													<div class="h-3 bg-muted rounded w-full mb-2"></div>
													<div class="h-3 bg-muted rounded w-4/5"></div>
												</div>
											</template>
										</div>
									</template>
									<!-- Empty state -->
									<template x-if="!loading && plugins.length === 0">
										<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
											@icon.PackageOpen(icon.Props{Class: "size-12 opacity-20"})
											<p class="text-sm font-medium">{ i18n.T(ctx, "No plugins available") }</p>
										</div>
									</template>
									<!-- No search results -->
									<template x-if="!loading && filteredPlugins.length === 0 && plugins.length > 0">
										<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
											@icon.SearchX(icon.Props{Class: "size-12 opacity-20"})
											<p class="text-sm font-medium">{ i18n.T(ctx, "No plugins match your search") }</p>
											<p class="text-xs">{ i18n.T(ctx, "Try a different search term.") }</p>
										</div>
									</template>
									<!-- Plugin cards (2-col grid) -->
									<template x-if="!loading && filteredPlugins.length > 0">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
											<template x-for="plugin in filteredPlugins" :key="plugin.id">
												<div
													class="group p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-accent/30 transition-all duration-150 cursor-pointer flex flex-col"
													@click="openProfile(plugin)"
												>
													<div class="flex items-start gap-3 mb-2">
														<div
															class="size-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0 [&_svg]:size-5"
															x-html="plugin.icon"
														></div>
														<div class="flex-1 min-w-0">
															<h3 class="text-sm font-semibold text-foreground truncate" x-text="plugin.name"></h3>
															<span class="text-[10px] text-muted-foreground" x-text="plugin.category"></span>
														</div>
													</div>
													<p class="text-xs text-muted-foreground line-clamp-2 mb-3 flex-1" x-text="plugin.description"></p>
													<div class="flex items-center justify-between mt-auto">
														<span class="text-[10px] text-muted-foreground/60 tabular-nums" x-text="plugin.tools.length + ' tools'"></span>
													</div>
												</div>
											</template>
										</div>
									</template>
								</div>
							</div>
						</template>
						<!-- ═══════ MCP Servers Tab ═══════ -->
						<template x-if="activeTab === 'mcp'">
							<div class="flex flex-col flex-1 overflow-hidden" x-data="mcpConnectors">
								<!-- Top bar with Add button -->
								<div class="px-4 pt-3 pb-2 flex items-center gap-2">
									<div class="flex-1">
										@input.Input(input.Props{
											Type:        input.TypeSearch,
											Placeholder: i18n.T(ctx, "Search MCP servers..."),
											Class:       "h-9 bg-muted/40 border-transparent focus-within:bg-background",
											Attributes: templ.Attributes{
												"x-model.debounce.300ms": "mcpSearch",
											},
										})
									</div>
									@button.Button(button.Props{
										Size:    button.SizeSm,
										Variant: button.VariantDefault,
										Class:   "gap-1.5 shrink-0",
										Attributes: templ.Attributes{
											"@click": "mcpOpenAddDialog()",
										},
									}) {
										@icon.Plus(icon.Props{Class: "size-4"})
										{ i18n.T(ctx, "Add Server") }
									}
								</div>
								<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
									<!-- MCP connector cards -->
									<template x-if="mcpConnectors.length > 0">
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
											@MCPConnectorDialogCard()
										</div>
									</template>
									<!-- Empty state -->
									<template x-if="mcpConnectors.length === 0">
										<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
											@icon.MCPLogo("size-12 opacity-20")
											<p class="text-sm font-medium">{ i18n.T(ctx, "No MCP servers connected") }</p>
											<p class="text-xs">{ i18n.T(ctx, "Connect to remote MCP servers to discover and use their tools.") }</p>
											@button.Button(button.Props{
												Size:    button.SizeSm,
												Variant: button.VariantOutline,
												Class:   "mt-3 gap-1.5",
												Attributes: templ.Attributes{
													"@click": "mcpOpenAddDialog()",
												},
											}) {
												@icon.Plus(icon.Props{Class: "size-3.5"})
												{ i18n.T(ctx, "Add MCP Server") }
											}
										</div>
									</template>
								</div>
								<!-- MCP Add Dialog (nested inside mcpConnectors scope) -->
								@MCPAddDialog()
							</div>
						</template>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<span class="text-xs text-muted-foreground">
									<template x-if="activeTab === 'plugins'">
										<span>
											<span x-text="pluginSummary.plugins"></span> { i18n.T(ctx, "plugins") } ·
											<span x-text="pluginSummary.tools"></span> { i18n.T(ctx, "tools") }
										</span>
									</template>
									<template x-if="activeTab === 'mcp'">
										<span x-text="'MCP servers'"></span>
									</template>
								</span>
								@dialog.Close() {
									@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
										{ i18n.T(ctx, "Close") }
									}
								}
							</div>
						}
					</div>
				</template>
				<!-- ═══════ Unified Detail View (Plugin or MCP) ═══════ -->
				<template x-if="detailItem">
					<div class="flex flex-col h-full max-h-[90vh]">
						@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
							<div class="flex items-start gap-4">
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-8 shrink-0",
									Attributes: templ.Attributes{
										"@click": "closeDetail()",
									},
								}) {
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
								}
								<!-- Icon -->
								<div
									class="size-11 rounded-lg flex items-center justify-center shrink-0 [&_svg]:size-5"
									:class="detailItem._type === 'mcp' ? 'bg-primary/10 text-primary' : 'bg-primary/10 text-primary'"
									x-html="detailItem._icon"
								></div>
								<div class="flex-1 min-w-0">
									@dialog.Title(dialog.TitleProps{Class: "flex items-center gap-2"}) {
										<span x-text="detailItem._name"></span>
										<!-- MCP status badge -->
										<template x-if="detailItem._type === 'mcp' && detailItem.status">
											<span
												class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
												:class="{
													'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400': detailItem.status === 'connected',
													'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400': detailItem.status === 'connecting',
													'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400': detailItem.status === 'auth_required',
													'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400': detailItem.status === 'error',
													'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300': detailItem.status === 'disconnected' || detailItem.status === 'created'
												}"
												x-text="detailItem.status.replace('_', ' ')"
											></span>
										</template>
									}
									@dialog.Description(dialog.DescriptionProps{}) {
										<span x-text="detailItem._subtitle"></span>
									}
								</div>
							</div>
						}
						<!-- Info bar -->
						<div class="px-4 py-2.5 border-b border-border bg-muted/50">
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-3 text-xs text-muted-foreground">
									<!-- Category (plugins) -->
									<template x-if="detailItem._type === 'plugin' && detailItem.category">
										<span class="flex items-center gap-1.5">
											@icon.Tag(icon.Props{Class: "size-3 opacity-60"})
											<span x-text="detailItem.category"></span>
										</span>
									</template>
									<template x-if="detailItem._type === 'plugin' && detailItem.category">
										<span class="text-border">|</span>
									</template>
									<!-- Tool count -->
									<span class="flex items-center gap-1.5">
										@icon.Blocks(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="detailItem._tools.length"></span> { i18n.T(ctx, "tools") }
									</span>
									<!-- MCP server info -->
									<template x-if="detailItem._type === 'mcp' && detailItem.server_name">
										<span class="flex items-center gap-1.5">
											<span class="text-border">|</span>
											@icon.Server(icon.Props{Class: "size-3 opacity-60"})
											<span x-text="detailItem.server_name"></span>
											<template x-if="detailItem.server_version">
												<span x-text="'v' + detailItem.server_version" class="text-muted-foreground/60"></span>
											</template>
										</span>
									</template>
								</div>
								<!-- MCP connect/disconnect actions -->
								<template x-if="detailItem._type === 'mcp'">
									<div class="flex items-center gap-2">
										<template x-if="detailItem.status === 'connected'">
											<button
												@click="window.dispatchEvent(new CustomEvent('mcp-action-disconnect', { detail: detailItem.id }))"
												class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-destructive/10 text-destructive hover:bg-destructive/20 border border-destructive/20 transition-colors"
											>
												@icon.Unplug(icon.Props{Class: "size-3.5"})
												{ i18n.T(ctx, "Disconnect") }
											</button>
										</template>
										<template x-if="detailItem.status !== 'connected' && detailItem.status !== 'connecting'">
											<button
												@click="window.dispatchEvent(new CustomEvent('mcp-action-connect', { detail: detailItem.id }))"
												class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
											>
												@icon.Plug(icon.Props{Class: "size-3.5"})
												{ i18n.T(ctx, "Connect") }
											</button>
										</template>
									</div>
								</template>
							</div>
						</div>
						<!-- Scrollable content — unified tool list -->
						<div class="flex-1 overflow-y-auto scrollbar-thin p-4">
							<div class="space-y-5">
								<!-- Description -->
								<p x-text="detailItem._description" class="text-sm text-muted-foreground leading-relaxed"></p>
								<!-- Error message (MCP only) -->
								<template x-if="detailItem._type === 'mcp' && detailItem.error_msg">
									<div class="rounded-md bg-destructive/10 border border-destructive/20 p-3">
										<p class="text-xs text-destructive flex items-start gap-1.5">
											@icon.CircleAlert(icon.Props{Class: "size-3.5 shrink-0 mt-0.5"})
											<span x-text="detailItem.error_msg"></span>
										</p>
									</div>
								</template>
								<!-- Tools list -->
								<template x-if="detailItem._tools.length > 0">
									<div>
										<div class="flex items-center gap-2 mb-2.5">
											@icon.Sparkles(icon.Props{Class: "size-4 text-muted-foreground"})
											<h4 class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Available tools") }</h4>
										</div>
										<div class="space-y-2">
											<template x-for="tool in detailItem._tools" :key="tool.id || tool.name">
												<div class="border border-border rounded-lg p-3 border-s-[3px] border-s-primary bg-card">
													<div class="flex items-center gap-2 mb-1">
														<span class="text-xs font-semibold text-foreground" x-text="tool.name"></span>
														<template x-if="tool.category">
															<span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-accent text-muted-foreground" x-text="tool.category"></span>
														</template>
													</div>
													<div x-html="renderToolDescription(tool.description)" class="text-xs text-muted-foreground leading-relaxed prose prose-xs dark:prose-invert max-w-none prose-p:my-1 prose-ul:my-1 prose-ol:my-1 prose-li:my-0.5 prose-headings:my-1 prose-pre:my-1 prose-pre:text-[11px] prose-code:text-[11px] prose-code:before:content-none prose-code:after:content-none"></div>
												</div>
											</template>
										</div>
									</div>
								</template>
								<!-- Empty tools -->
								<template x-if="detailItem._tools.length === 0">
									<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
										@icon.PackageOpen(icon.Props{Class: "size-10 opacity-20"})
										<template x-if="detailItem._type === 'mcp'">
											<p class="text-sm">{ i18n.T(ctx, "No tools discovered yet. Connect to the server to discover tools.") }</p>
										</template>
										<template x-if="detailItem._type === 'plugin'">
											<p class="text-sm">{ i18n.T(ctx, "This plugin has no tools.") }</p>
										</template>
									</div>
								</template>
								<!-- Plugin Settings Section -->
								<template x-if="detailItem._type === 'plugin'">
									<div x-data="pluginSettingsManager()" class="border-t border-border pt-5 space-y-4">
										<template x-if="schemas.find(s => s.plugin_id === detailItem.plugin_id)">
											<div class="space-y-4">
												<div class="flex items-center gap-2 mb-2">
													@icon.Settings(icon.Props{Class: "size-4 text-muted-foreground"})
													<h4 class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Plugin Settings") }</h4>
													<template x-if="isConfigured(detailItem.plugin_id)">
														<span class="ms-1 inline-flex items-center rounded-full bg-green-500/10 px-1.5 py-0.5 text-[9px] font-medium text-green-600 dark:text-green-400 ring-1 ring-inset ring-green-500/20">{ i18n.T(ctx, "Configured") }</span>
													</template>
												</div>
												<!-- Settings fields -->
												<div class="space-y-4 bg-muted/30 rounded-xl p-4 border border-border/50">
													<template x-for="field in (schemas.find(s => s.plugin_id === detailItem.plugin_id)?.schema || [])" :key="field.key">
														<div class="flex flex-col gap-1.5">
															<label class="text-foreground text-xs font-medium flex items-center gap-1">
																<span x-text="field.label"></span>
																<span x-show="field.required" class="text-destructive font-bold">*</span>
															</label>
															<!-- Text input -->
															<template x-if="field.type === 'string'">
																<input
																	type="text"
																	:placeholder="field.description"
																	:value="getField(detailItem.plugin_id, field.key)"
																	@input="setField(detailItem.plugin_id, field.key, $event.target.value)"
																	class="w-full h-8 px-3 py-1 text-xs rounded-md border border-input bg-background shadow-xs focus:ring-1 focus:ring-primary outline-none"
																/>
															</template>
															<!-- Password input -->
															<template x-if="field.type === 'password'">
																<input
																	type="password"
																	:placeholder="field.description"
																	:value="getField(detailItem.plugin_id, field.key)"
																	@input="setField(detailItem.plugin_id, field.key, $event.target.value)"
																	class="w-full h-8 px-3 py-1 text-xs rounded-md border border-input bg-background shadow-xs focus:ring-1 focus:ring-primary outline-none"
																/>
															</template>
															<!-- Select input -->
															<template x-if="field.type === 'select'">
																<select
																	:value="getField(detailItem.plugin_id, field.key)"
																	@change="setField(detailItem.plugin_id, field.key, $event.target.value)"
																	class="w-full h-8 px-3 py-1 text-xs rounded-md border border-input bg-background shadow-xs focus:ring-1 focus:ring-primary outline-none"
																>
																	<option value="">{ i18n.T(ctx, "Select...") }</option>
																	<template x-for="opt in field.options" :key="opt">
																		<option :value="opt" x-text="opt" :selected="opt === getField(detailItem.plugin_id, field.key)"></option>
																	</template>
																</select>
															</template>
															<p x-show="field.description && field.type !== 'string' && field.type !== 'password'" class="text-[10px] text-muted-foreground" x-text="field.description"></p>
														</div>
													</template>
													<!-- Error message -->
													<template x-if="errors[detailItem.plugin_id]">
														<div class="p-2.5 rounded-lg border border-destructive/20 bg-destructive/5 text-destructive text-[11px]" x-text="errors[detailItem.plugin_id]"></div>
													</template>
													<!-- Actions -->
													<div class="flex items-center justify-between pt-2">
														<button
															type="button"
															@click="deletePlugin(detailItem.plugin_id)"
															class="text-[10px] text-muted-foreground hover:text-destructive transition-colors underline underline-offset-2"
															x-show="isConfigured(detailItem.plugin_id)"
														>{ i18n.T(ctx, "Reset settings") }</button>
														<div class="flex items-center gap-3 ms-auto">
															<span x-show="saved[detailItem.plugin_id]" x-transition class="text-[11px] text-emerald-600 font-medium flex items-center gap-1">
																@icon.Check(icon.Props{Class: "size-3"})
																{ i18n.T(ctx, "Saved") }
															</span>
															<button
																type="button"
																@click="savePlugin(detailItem.plugin_id)"
																:disabled="saving[detailItem.plugin_id]"
																class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-semibold transition-all cursor-pointer bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-8 px-4 disabled:opacity-50"
															>
																<span x-show="!saving[detailItem.plugin_id]">{ i18n.T(ctx, "Save Settings") }</span>
																<template x-if="saving[detailItem.plugin_id]">
																	<span class="flex items-center gap-2">
																		<span class="animate-spin rounded-full h-3 w-3 border-b-2 border-primary-foreground"></span>
																		{ i18n.T(ctx, "Saving...") }
																	</span>
																</template>
															</button>
														</div>
													</div>
												</div>
											</div>
										</template>
									</div>
								</template>
								<!-- Metadata (both types) -->
								<div class="border-t border-border pt-4 grid grid-cols-2 gap-3">
									<div>
										<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">
											<template x-if="detailItem._type === 'plugin'">
												<span>{ i18n.T(ctx, "Category") }</span>
											</template>
											<template x-if="detailItem._type === 'mcp'">
												<span>{ i18n.T(ctx, "Server URL") }</span>
											</template>
										</div>
										<div class="text-xs text-foreground flex items-center gap-1.5">
											<template x-if="detailItem._type === 'plugin'">
												<span class="flex items-center gap-1.5">
													@icon.Tag(icon.Props{Class: "size-3 text-muted-foreground"})
													<span x-text="detailItem.category"></span>
												</span>
											</template>
											<template x-if="detailItem._type === 'mcp'">
												<span class="flex items-center gap-1.5 truncate">
													@icon.MCPLogo("size-3 text-muted-foreground shrink-0")
													<span x-text="detailItem.server_url" class="truncate"></span>
												</span>
											</template>
										</div>
									</div>
									<div>
										<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/70 mb-1">{ i18n.T(ctx, "ID") }</div>
										<code class="text-[11px] bg-muted px-1.5 py-0.5 rounded font-mono break-all" x-text="detailItem.id"></code>
									</div>
								</div>
							</div>
						</div>
						@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
							<div class="flex items-center justify-between w-full">
								<div class="flex items-center gap-3 text-xs text-muted-foreground">
									<span class="flex items-center gap-1.5">
										@icon.Blocks(icon.Props{Class: "size-3 opacity-60"})
										<span x-text="detailItem._tools.length"></span> { i18n.T(ctx, "tools") }
									</span>
								</div>
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Class:   "h-8 px-3 text-xs",
									Attributes: templ.Attributes{
										"@click": "closeDetail()",
									},
								}) {
									{ i18n.T(ctx, "Back") }
								}
							</div>
						}
					</div>
				</template>
				}
			}
		</div>
	</div>
}

// MCPConnectorDialogCard renders MCP connector cards styled to match plugin cards.
templ MCPConnectorDialogCard() {
	<template x-for="conn in mcpConnectors" :key="conn.id">
		<div
			class="group p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-accent/30 transition-all duration-150 cursor-pointer flex flex-col"
			@click="mcpOpenDetail(conn)"
		>
			<div class="flex items-start gap-3 mb-2">
				<!-- Icon with status dot (mirrors plugin icon area) -->
				<div class="relative">
					<div class="size-10 rounded-lg flex items-center justify-center shrink-0 bg-primary/10 text-primary">
						@icon.MCPLogo("size-5")
					</div>
					<span
						class="absolute -bottom-0.5 -end-0.5 size-2.5 rounded-full border-2 border-background"
						:class="{
							'bg-emerald-500': conn.status === 'connected',
							'bg-yellow-500 animate-pulse': conn.status === 'connecting',
							'bg-orange-500': conn.status === 'auth_required' || conn.status === 'authorizing',
							'bg-red-500': conn.status === 'error',
							'bg-gray-400': conn.status === 'created' || conn.status === 'disconnected'
						}"
					></span>
				</div>
				<div class="flex-1 min-w-0">
					<h3 class="text-sm font-semibold text-foreground truncate" x-text="conn.title"></h3>
					<span class="text-[10px] text-muted-foreground" x-text="conn.status.replace('_', ' ')"></span>
				</div>
			</div>
			<p class="text-xs text-muted-foreground line-clamp-2 mb-3 flex-1" x-text="conn.server_url"></p>
			<div class="flex items-center justify-between mt-auto">
				<span class="text-[10px] text-muted-foreground/60 tabular-nums" x-text="conn.tool_count + ' tools'"></span>
				<!-- Hover actions -->
				<div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
					<template x-if="conn.status === 'connected'">
						<button
							@click.stop="mcpDisconnect(conn.id)"
							class="p-1.5 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							title="Disconnect"
						>
							@icon.Unplug(icon.Props{Class: "size-3.5"})
						</button>
					</template>
					<template x-if="conn.status === 'auth_required'">
						<button
							@click.stop="mcpAuthorize(conn)"
							class="p-1.5 rounded-md hover:bg-accent text-orange-500 hover:text-orange-600 transition-colors"
							title="Authorize"
						>
							@icon.KeyRound(icon.Props{Class: "size-3.5"})
						</button>
					</template>
					<template x-if="conn.status !== 'connected' && conn.status !== 'connecting' && conn.status !== 'auth_required'">
						<button
							@click.stop="mcpConnect(conn.id)"
							class="p-1.5 rounded-md hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
							title="Connect"
						>
							@icon.Plug(icon.Props{Class: "size-3.5"})
						</button>
					</template>
					<button
						@click.stop="mcpRemove(conn.id)"
						class="p-1.5 rounded-md hover:bg-accent text-muted-foreground hover:text-destructive transition-colors"
						title="Remove"
					>
						@icon.Trash2(icon.Props{Class: "size-3.5"})
					</button>
				</div>
			</div>
		</div>
	</template>
}

templ ToolsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "tools-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-tools-dialog')",
				"title":  i18n.T(ctx, "Plugins & Tools"),
			},
		}) {
			@icon.MCPLogo("size-5")
			<span class="sr-only">{ i18n.T(ctx, "Plugins & Tools") }</span>
		}
	}
}
