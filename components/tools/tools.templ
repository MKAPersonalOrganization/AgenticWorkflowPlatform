package tools

import (
	"school-with-ai/components/button"
	"school-with-ai/components/dialog"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

templ ToolsDialog() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('toolsDialog', () => ({
				tools: [],
				agents: [],
				loading: false,
				loadingAgents: false,
				search: '',
				selectedAgent: '',
				selectedCategory: 'all',
				viewMode: 'grid',
				async init() {
					const chatEl = document.querySelector('[x-data="chat"]');
					if (chatEl) {
						try {
							const chatData = Alpine.$data(chatEl);
							if (chatData) {
								this.selectedAgent = chatData.selectedAgent || '';
							}
						} catch (e) { /* ignore */ }
					}
					await this.fetchAgents();
					await this.fetchTools();
				},
				async fetchAgents() {
					this.loadingAgents = true;
					try {
						const response = await fetch('/v1/agents');
						if (response.ok) {
							const data = await response.json();
							if (data.agents && Array.isArray(data.agents)) {
								this.agents = data.agents;
								if (!this.selectedAgent && this.agents.length > 0) {
									this.selectedAgent = this.agents[0].id;
								}
							}
						}
					} catch (err) {
						console.error('Failed to fetch agents:', err);
					} finally {
						this.loadingAgents = false;
					}
				},
				async fetchTools() {
					if (!this.selectedAgent) {
						this.tools = [];
						return;
					}
					this.loading = true;
					try {
						const response = await fetch(`/v1/agents/${this.selectedAgent}/toolsets`);
						if (response.ok) {
							const data = await response.json();
							if (data.toolsets && Array.isArray(data.toolsets)) {
								this.tools = data.toolsets;
							}
						} else {
							this.tools = [];
						}
					} catch (err) {
						console.error('Failed to fetch tool sets:', err);
						this.tools = [];
					} finally {
						this.loading = false;
					}
				},
				async onAgentChange() {
					this.tools = [];
					await this.fetchTools();
				},
				get filteredTools() {
					let filtered = this.tools;
					if (this.selectedCategory !== 'all') {
						filtered = filtered.filter(toolSet => toolSet.category === this.selectedCategory);
					}
					if (this.search) {
						const q = this.search.toLowerCase();
						filtered = filtered.filter(toolSet =>
							toolSet.name.toLowerCase().includes(q) ||
							toolSet.description.toLowerCase().includes(q) ||
							toolSet.category.toLowerCase().includes(q) ||
							toolSet.tools.some(tool =>
								tool.name.toLowerCase().includes(q) ||
								tool.description.toLowerCase().includes(q)
							)
						);
					}
					return filtered;
				},
				get categoriesWithCounts() {
					const counts = {};
					this.tools.forEach(toolSet => {
						counts[toolSet.category] = (counts[toolSet.category] || 0) + 1;
					});
					return Object.entries(counts).map(([category, count]) => ({ category, count })).sort((a, b) => a.category.localeCompare(b.category));
				},
				get enabledSummary() {
					const enabledSets = this.tools.filter(ts => ts.enabled).length;
					let enabledTools = 0;
					this.tools.forEach(ts => {
						if (ts.enabled) enabledTools += (ts.tools || []).filter(t => t.enabled).length;
					});
					return { sets: enabledSets, tools: enabledTools, total: this.tools.length };
				},
				async toggleToolSet(toolSet) {
					const newState = !toolSet.enabled;
					try {
						const response = await fetch(`/v1/agents/${this.selectedAgent}/toolsets/${toolSet.id}`, {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ enabled: newState })
						});
						if (response.ok) {
							toolSet.enabled = newState;
							if (!newState) {
								toolSet.tools.forEach(tool => tool.enabled = false);
							} else {
								toolSet.tools.forEach(tool => tool.enabled = true);
							}
						}
					} catch (err) {
						console.error('Failed to toggle tool set:', err);
					}
				},
				async toggleTool(toolSet, tool) {
					const newState = !tool.enabled;
					try {
						const response = await fetch(`/v1/agents/${this.selectedAgent}/toolsets/${toolSet.id}/tools/${tool.id}`, {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ enabled: newState })
						});
						if (response.ok) {
							tool.enabled = newState;
							toolSet.enabled = toolSet.tools.some(t => t.enabled);
						}
					} catch (err) {
						console.error('Failed to toggle individual tool:', err);
					}
				},
				categoryColor(category) {
					const colors = {
						'Calculator': 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
						'Visualization': 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
						'Documents': 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
						'Memory': 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400',
					};
					return colors[category] || 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400';
				},
				categoryBorderColor(category) {
					const colors = {
						'Calculator': 'border-l-blue-400 dark:border-l-blue-500',
						'Visualization': 'border-l-purple-400 dark:border-l-purple-500',
						'Documents': 'border-l-green-400 dark:border-l-green-500',
						'Memory': 'border-l-amber-400 dark:border-l-amber-500',
					};
					return colors[category] || 'border-l-gray-400 dark:border-l-gray-500';
				}
			}));
		});
	</script>
	<div
		x-data="toolsDialog"
		@open-tools-dialog.window="init()"
	>
		@dialog.Dialog(dialog.Props{
			ID: "tools-manager-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "!w-[98vw] !h-[95vh] !max-w-none !max-h-none flex flex-col p-0 overflow-hidden",
			}) {
				@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
					<div class="flex items-center justify-between">
						<div>
							@dialog.Title() {
								{ i18n.T(ctx, "Tools Management") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "Select an agent and manage its available tools.") }
							}
						</div>
						<div class="flex items-center gap-1 bg-muted rounded-lg p-1">
							<button
								@click="viewMode = 'grid'"
								class="p-1.5 rounded-md transition-all duration-200"
								:class="viewMode === 'grid' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'"
								:aria-label="'Grid view'"
							>
								@icon.LayoutGrid(icon.Props{Class: "size-4"})
							</button>
							<button
								@click="viewMode = 'list'"
								class="p-1.5 rounded-md transition-all duration-200"
								:class="viewMode === 'list' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'"
								:aria-label="'List view'"
							>
								@icon.List(icon.Props{Class: "size-4"})
							</button>
						</div>
					</div>
				}
				<!-- Top Controls -->
				<div class="p-4 border-b border-border bg-muted/50">
					<div class="flex gap-4">
						<div class="flex-1">
							<label class="block text-xs font-medium text-muted-foreground mb-1.5 uppercase tracking-wide">{ i18n.T(ctx, "Agent") }</label>
							<div class="relative">
								<select
									x-model="selectedAgent"
									@change="onAgentChange()"
									class="w-full rounded-lg border border-input bg-background px-3 py-2 pr-8 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring appearance-none transition-colors"
									:disabled="loadingAgents"
								>
									<template x-for="agent in agents" :key="agent.id">
										<option :value="agent.id" x-text="agent.name"></option>
									</template>
								</select>
								<div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none">
									<template x-if="loadingAgents">
										<div class="animate-spin rounded-full h-4 w-4 border-2 border-primary border-t-transparent"></div>
									</template>
									<template x-if="!loadingAgents">
										@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
									</template>
								</div>
							</div>
						</div>
						<div class="flex-1">
							<label class="block text-xs font-medium text-muted-foreground mb-1.5 uppercase tracking-wide">{ i18n.T(ctx, "Search") }</label>
							<div class="relative">
								<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
									@icon.Search(icon.Props{Class: "size-4 text-muted-foreground"})
								</div>
								<input
									type="text"
									x-model="search"
									placeholder={ i18n.T(ctx, "Search tools and tool sets...") }
									class="w-full rounded-lg border border-input bg-background pl-9 pr-9 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring transition-colors"
								/>
								<button
									x-show="search.length > 0"
									x-transition:enter="transition-opacity duration-100"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									@click="search = ''"
									class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted-foreground hover:text-foreground transition-colors"
								>
									@icon.X(icon.Props{Class: "size-3.5"})
								</button>
							</div>
						</div>
					</div>
				</div>
				<!-- Main Content with Sidebar -->
				<div class="flex-1 flex overflow-hidden">
					<!-- Category Sidebar -->
					<div class="w-52 border-r border-border bg-muted/50 overflow-y-auto shrink-0 scrollbar-thin">
						<div class="p-3">
							<h3 class="text-[11px] font-semibold text-muted-foreground mb-2 uppercase tracking-wider px-2">{ i18n.T(ctx, "Categories") }</h3>
							<div class="space-y-0.5">
								<button
									@click="selectedCategory = 'all'"
									class="w-full text-left px-3 py-2 text-sm rounded-lg transition-all duration-150"
									:class="selectedCategory === 'all' ? 'bg-accent text-accent-foreground font-medium border-l-2 border-primary pl-2.5' : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'"
								>
									<div class="flex items-center justify-between">
										<span>{ i18n.T(ctx, "All Tools") }</span>
										<span class="text-xs tabular-nums opacity-60" x-text="tools.length"></span>
									</div>
								</button>
								<template x-for="{ category, count } in categoriesWithCounts" :key="category">
									<button
										@click="selectedCategory = category"
										class="w-full text-left px-3 py-2 text-sm rounded-lg transition-all duration-150"
										:class="selectedCategory === category ? 'bg-accent text-accent-foreground font-medium border-l-2 border-primary pl-2.5' : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'"
									>
										<div class="flex items-center justify-between">
											<span x-text="category"></span>
											<span class="text-xs tabular-nums opacity-60" x-text="count"></span>
										</div>
									</button>
								</template>
							</div>
						</div>
					</div>
					<!-- Tools Content -->
					<div class="flex-1 overflow-auto scrollbar-thin">
						<div class="p-4">
							<!-- Skeleton Loading -->
							<template x-if="loading && tools.length === 0">
								<div>
									<div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
										<template x-for="i in 6" :key="i">
											<div class="border border-border rounded-lg overflow-hidden animate-pulse">
												<div class="p-4 bg-accent/20">
													<div class="flex items-center justify-between">
														<div class="space-y-2 flex-1">
															<div class="h-4 bg-muted rounded-md w-2/3"></div>
															<div class="h-3 bg-muted rounded-md w-full"></div>
														</div>
														<div class="h-5 w-9 bg-muted rounded-full"></div>
													</div>
												</div>
												<div class="p-4 space-y-3">
													<div class="h-3 bg-muted rounded-md w-3/4"></div>
													<div class="h-3 bg-muted rounded-md w-1/2"></div>
												</div>
											</div>
										</template>
									</div>
								</div>
							</template>
							<template x-if="!loading && !selectedAgent">
								<div class="flex flex-col items-center justify-center py-20 gap-3 text-muted-foreground">
									@icon.Wrench(icon.Props{Class: "size-12 opacity-20"})
									<span class="text-sm font-medium">{ i18n.T(ctx, "Select an agent to manage tools") }</span>
									<span class="text-xs">{ i18n.T(ctx, "Choose an agent from the dropdown above to get started.") }</span>
								</div>
							</template>
							<template x-if="!loading && selectedAgent && tools.length === 0">
								<div class="flex flex-col items-center justify-center py-20 gap-3 text-muted-foreground">
									@icon.PackageOpen(icon.Props{Class: "size-12 opacity-20"})
									<span class="text-sm font-medium">{ i18n.T(ctx, "No tools available") }</span>
									<span class="text-xs">{ i18n.T(ctx, "This agent has no tool sets configured yet.") }</span>
								</div>
							</template>
							<template x-if="!loading && filteredTools.length === 0 && tools.length > 0">
								<div class="flex flex-col items-center justify-center py-20 gap-3 text-muted-foreground">
									@icon.SearchX(icon.Props{Class: "size-12 opacity-20"})
									<span class="text-sm font-medium">{ i18n.T(ctx, "No results found") }</span>
									<span class="text-xs">{ i18n.T(ctx, "Try adjusting your search or category filter.") }</span>
								</div>
							</template>
							<!-- Tools Grid/List -->
							<template x-if="filteredTools.length > 0">
								<div>
									<div class="flex items-center justify-between mb-4">
										<p class="text-sm text-muted-foreground">
											<span class="font-medium text-foreground" x-text="filteredTools.length"></span> { i18n.T(ctx, "tool sets") }
											<template x-if="selectedCategory !== 'all'">
												<span> { i18n.T(ctx, "in") } <span class="font-medium text-foreground" x-text="selectedCategory"></span></span>
											</template>
											<template x-if="search">
												<span> &middot; { i18n.T(ctx, "matching") } &ldquo;<span class="font-medium text-foreground" x-text="search"></span>&rdquo;</span>
											</template>
										</p>
									</div>
									<!-- Grid Layout -->
									<div
										x-show="viewMode === 'grid'"
										x-transition:enter="transition-opacity duration-200"
										x-transition:enter-start="opacity-0"
										x-transition:enter-end="opacity-100"
										class="grid gap-4"
										:class="filteredTools.length > 6 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' : filteredTools.length > 2 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'"
									>
										<template x-for="toolSet in filteredTools" :key="toolSet.id">
											<div
												class="group border rounded-lg overflow-hidden transition-all duration-200 border-l-[3px] hover:-translate-y-0.5 hover:shadow-lg"
												:class="[toolSet.enabled ? 'border-border bg-card' : 'border-border opacity-60', categoryBorderColor(toolSet.category)]"
											>
												<div class="flex items-start justify-between gap-3 p-4 bg-accent/10 group-hover:bg-accent/20 transition-colors">
													<div class="flex flex-col gap-1 flex-1 min-w-0">
														<div class="flex items-center gap-2">
															<span
																class="size-1.5 rounded-full shrink-0"
																:class="toolSet.enabled ? 'bg-primary' : 'bg-input'"
															></span>
															<span x-text="toolSet.name" class="text-sm font-semibold text-foreground"></span>
															<span
																class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
																:class="categoryColor(toolSet.category)"
																x-text="toolSet.category"
															></span>
														</div>
														<span x-text="toolSet.description" class="text-xs text-muted-foreground line-clamp-2 pl-3.5"></span>
														<span class="text-[11px] text-muted-foreground pl-3.5 tabular-nums">
															<span x-text="toolSet.tools.filter(t => t.enabled).length"></span>/<span x-text="toolSet.tools.length"></span> { i18n.T(ctx, "tools enabled") }
														</span>
													</div>
													<button
														@click="toggleToolSet(toolSet)"
														class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
														:class="toolSet.enabled ? 'bg-primary' : 'bg-input'"
														role="switch"
														:aria-checked="toolSet.enabled"
														:aria-label="toolSet.name"
													>
														<span
															class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
															:class="toolSet.enabled ? 'translate-x-4' : 'translate-x-0'"
														></span>
													</button>
												</div>
												<div class="border-t border-border divide-y divide-border/50">
													<template x-for="tool in toolSet.tools" :key="tool.id">
														<div class="flex items-center justify-between gap-3 py-2.5 px-4 hover:bg-accent/30 transition-colors">
															<div class="flex flex-col gap-0.5 flex-1 min-w-0">
																<span x-text="tool.name" class="text-sm text-foreground"></span>
																<span x-text="tool.description" class="text-xs text-muted-foreground line-clamp-1"></span>
															</div>
															<button
																@click="toggleTool(toolSet, tool)"
																class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
																:class="tool.enabled ? 'bg-primary/80' : 'bg-input'"
																role="switch"
																:aria-checked="tool.enabled"
																:aria-label="tool.name"
																:disabled="!toolSet.enabled"
															>
																<span
																	class="pointer-events-none inline-block h-3 w-3 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
																	:class="tool.enabled ? 'translate-x-3' : 'translate-x-0'"
																></span>
															</button>
														</div>
													</template>
												</div>
											</div>
										</template>
									</div>
									<!-- List Layout -->
									<div
										x-show="viewMode === 'list'"
										x-transition:enter="transition-opacity duration-200"
										x-transition:enter-start="opacity-0"
										x-transition:enter-end="opacity-100"
										class="space-y-2"
									>
										<template x-for="toolSet in filteredTools" :key="toolSet.id">
											<div
												class="group border rounded-lg overflow-hidden transition-all duration-200 border-l-[3px]"
												:class="[toolSet.enabled ? 'border-border bg-card' : 'border-border opacity-60', categoryBorderColor(toolSet.category)]"
											>
												<div class="flex items-center justify-between gap-3 p-3 bg-accent/10 group-hover:bg-accent/20 transition-colors">
													<div class="flex flex-col gap-0.5 flex-1 min-w-0">
														<div class="flex items-center gap-2">
															<span
																class="size-1.5 rounded-full shrink-0"
																:class="toolSet.enabled ? 'bg-primary' : 'bg-input'"
															></span>
															<span x-text="toolSet.name" class="text-sm font-semibold text-foreground"></span>
															<span
																class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
																:class="categoryColor(toolSet.category)"
																x-text="toolSet.category"
															></span>
															<span class="text-[11px] text-muted-foreground tabular-nums" x-text="`(${toolSet.tools.filter(t => t.enabled).length}/${toolSet.tools.length})`"></span>
														</div>
														<span x-text="toolSet.description" class="text-xs text-muted-foreground pl-3.5"></span>
													</div>
													<button
														@click="toggleToolSet(toolSet)"
														class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
														:class="toolSet.enabled ? 'bg-primary' : 'bg-input'"
														role="switch"
														:aria-checked="toolSet.enabled"
														:aria-label="toolSet.name"
													>
														<span
															class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
															:class="toolSet.enabled ? 'translate-x-4' : 'translate-x-0'"
														></span>
													</button>
												</div>
												<div class="border-t border-border">
													<template x-for="tool in toolSet.tools" :key="tool.id">
														<div class="flex items-center justify-between gap-3 py-2.5 px-3 hover:bg-accent/30 transition-colors">
															<div class="flex flex-col gap-0.5 flex-1 min-w-0 pl-3.5">
																<span x-text="tool.name" class="text-sm text-foreground"></span>
																<span x-text="tool.description" class="text-xs text-muted-foreground truncate"></span>
															</div>
															<button
																@click="toggleTool(toolSet, tool)"
																class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
																:class="tool.enabled ? 'bg-primary/80' : 'bg-input'"
																role="switch"
																:aria-checked="tool.enabled"
																:aria-label="tool.name"
																:disabled="!toolSet.enabled"
															>
																<span
																	class="pointer-events-none inline-block h-3 w-3 rounded-full bg-background shadow ring-0 transition-transform duration-200 ease-in-out"
																	:class="tool.enabled ? 'translate-x-3' : 'translate-x-0'"
																></span>
															</button>
														</div>
													</template>
												</div>
											</div>
										</template>
									</div>
								</div>
							</template>
						</div>
					</div>
				</div>
				@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
					<div class="flex items-center justify-between w-full">
						<div class="flex items-center gap-3 text-xs text-muted-foreground" x-show="tools.length > 0">
							<span class="flex items-center gap-1.5">
								<span class="size-1.5 rounded-full bg-primary"></span>
								<span x-text="enabledSummary.sets"></span>/<span x-text="enabledSummary.total"></span> { i18n.T(ctx, "tool sets") }
							</span>
							<span class="text-border">|</span>
							<span x-text="enabledSummary.tools"></span> { i18n.T(ctx, "individual tools") }
						</div>
						<div x-show="tools.length === 0"></div>
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
								{ i18n.T(ctx, "Close") }
							}
						}
					</div>
				}
			}
		}
	</div>
}

templ ToolsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "tools-manager-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-tools-dialog')",
				"title":  i18n.T(ctx, "Tools"),
			},
		}) {
			@icon.Wrench(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Tools") }</span>
		}
	}
}
