package rightnavbar

import (
	"school-with-ai/components/button"
	"school-with-ai/components/i18n"
	"school-with-ai/components/icon"
)

type Props struct {
	Class string
}

templ triggerButton(iconComp templ.Component, label string, view string) {
	@button.Button(button.Props{
		Size:    button.SizeIcon,
		Variant: button.VariantGhost,
		Class:   "size-9",
		Attributes: templ.Attributes{
			"@click": "activeView = '" + view + "'; $dispatch('open-right-sidebar')",
			":class": "activeView === '" + view + "' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-muted-foreground hover:text-foreground'",
		},
	}) {
		@iconComp
		<span class="sr-only">{ label }</span>
	}
}

templ RightNavbar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<!-- Right Navigation Bar -->
	<nav
		class={ "h-full w-16 bg-sidebar flex flex-col items-center py-4 gap-4 transition-opacity duration-200 border-s border-sidebar-border shrink-0", p.Class }
		id="right-navbar"
	>
		<!-- Artifacts Toggle -->
		@triggerButton(icon.LayoutDashboard(icon.Props{Class: "size-5"}), i18n.T(ctx, "Artifacts"), "artifacts")

		<!-- Bookmarks Toggle -->
		@triggerButton(icon.Bookmark(icon.Props{Class: "size-5"}), i18n.T(ctx, "Bookmarks"), "bookmarks")

		<!-- Files Toggle -->
		@triggerButton(icon.Folder(icon.Props{Class: "size-5"}), i18n.T(ctx, "Files"), "files")

		<!-- Prompts Toggle -->
		@triggerButton(icon.Command(icon.Props{Class: "size-5"}), i18n.T(ctx, "Prompts"), "prompts")

	</nav>
}
