package elicitation

templ AskTrueFalse() {
    <template x-if="awaitingHumanInput">
        <div 
            class="mt-4 pt-4 border-t border-primary/10 animate-in fade-in slide-in-from-top-2"
            x-data="{ selection: null }"
        >
            <div class="grid grid-cols-2 gap-3 w-full">
                <!-- True Option -->
                <button 
                    @click="selection = 'True'"
                    class="flex flex-col items-center justify-center p-4 rounded-lg border-2 transition-all cursor-pointer hover:bg-accent hover:text-accent-foreground"
                    :class="selection === 'True' ? 'border-primary bg-primary/5 text-primary' : 'border-muted bg-background'"
                >
                    <span class="text-lg font-bold">True</span>
                    <span class="text-xs text-muted-foreground mt-1">Yes / Correct</span>
                </button>

                <!-- False Option -->
                <button 
                    @click="selection = 'False'"
                    class="flex flex-col items-center justify-center p-4 rounded-lg border-2 transition-all cursor-pointer hover:bg-accent hover:text-accent-foreground"
                    :class="selection === 'False' ? 'border-primary bg-primary/5 text-primary' : 'border-muted bg-background'"
                >
                    <span class="text-lg font-bold">False</span>
                    <span class="text-xs text-muted-foreground mt-1">No / Incorrect</span>
                </button>
            </div>
            
            <div class="mt-4 flex justify-end w-full">
                <button 
                    @click="sendMessage(selection)"
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 shadow-sm gap-2"
                    :disabled="!selection"
                >
                    <span>Submit Answer</span>
                </button>
            </div>
        </div>
    </template>

     <!-- History State -->
    <template x-if="!awaitingHumanInput">
         <div class="mt-2 text-sm text-muted-foreground italic">
            (True/False)
         </div>
    </template>
}
