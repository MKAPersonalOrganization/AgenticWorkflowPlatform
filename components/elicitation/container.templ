package elicitation

import "school-with-ai/components/alert"

// Props - no specific props, relies on Alpine context `message`
type Props struct {}

templ Container() {
    <div class="my-4 relative group/message animate-in fade-in slide-in-from-bottom-2 duration-300">
        @alert.Alert(alert.Props{
            Class: "border-l-4 border-primary/50 bg-gradient-to-r from-primary/5 to-transparent",
        }) {
            @alert.Title() {
                <span class="flex items-center gap-2">
                    <div class="p-1 rounded-full bg-primary/10 text-primary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <span class="text-sm font-semibold text-primary">Clarification Requested</span>
                    <template x-if="awaitingHumanInput && index === messages.length - 1">
                         <span class="flex h-2 w-2 relative ml-1">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                        </span>
                    </template>
                </span>
            }
            @alert.Description() {
                <div class="mt-2 prose prose-sm max-w-none text-foreground font-medium" x-html="renderMarkdown(message.parsedArgs?.question || '')"></div>
                
                <!-- Logic to choose between Question Types -->
                
                <!-- CHOOSE ONE / MULTIPLE CHOICE -->
                <template x-if="message.parsedArgs?.schema?.type === 'choose_one' || (message.parsedArgs?.schema?.enum && !message.parsedArgs?.schema?.type)">
                    @MultipleChoice()
                </template>

                <!-- CHOOSE MULTIPLE (CHECKBOXES) -->
                <template x-if="message.parsedArgs?.schema?.type === 'choose_multiple'">
                    @ChooseMultiple()
                </template>
                
                <!-- NUMERIC RANGE (SLIDER) -->
                <template x-if="message.parsedArgs?.schema?.type === 'numeric_range'">
                    @NumericRange()
                </template>

                <!-- TRUE/FALSE (SINGLE CHECKBOX) -->
                <template x-if="message.parsedArgs?.schema?.type === 'true_false'">
                    @TrueFalse()
                </template>

                <!-- FREE TEXT: Default -->
                <template x-if="!message.parsedArgs?.schema?.enum && !['choose_one', 'choose_multiple', 'scale', 'true_false'].includes(message.parsedArgs?.schema?.type) && !message.parsedArgs?.schema?.type?.includes('array')">
                    @FreeText()
                </template>
            }
        }
    </div>
}
