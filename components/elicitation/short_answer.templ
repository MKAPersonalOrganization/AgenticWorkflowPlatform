package elicitation

// ShortAnswerProps - no specific props needed as it relies on parent Alpine context
type ShortAnswerProps struct {}

templ ShortAnswer() {
    <template x-if="awaitingHumanInput && index === messages.length - 1">
        <div class="mt-4 pt-4 border-t border-primary/10 animate-in fade-in slide-in-from-top-2 w-full">
            <form @submit.prevent="sendMessage(elicitationAnswer)" class="flex flex-col gap-2">
                <div class="relative">
                    <input
                        type="text"
                        x-model="elicitationAnswer"
                        class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                        placeholder="Type your answer here..."
                        autofocus
                    />
                </div>
                <div class="flex justify-end w-full">
                    <button 
                        type="submit"
                        class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 shadow-sm"
                        :disabled="!canSendElicitation"
                    >
                        Reply
                    </button>
                </div>
            </form>
        </div>
    </template>
}
