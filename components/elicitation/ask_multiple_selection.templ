package elicitation

import "school-with-ai/components/badge"

templ AskMultipleSelection() {
    <template x-if="awaitingHumanInput">
        <div
            class="mt-4 pt-4 border-t border-primary/10 animate-in fade-in slide-in-from-top-2 w-full"
            x-data="{
                selected: [],
                get choices() {
                    const choices = message.parsedResult?.answer_choices;
                    return Array.isArray(choices) ? choices : [];
                }
            }"
        >
            <div class="flex flex-col w-full gap-2">
                <template x-for="option in choices">
                    <label class="flex items-center space-x-3 p-3 rounded-md border border-input hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors">
                        <input
                            type="checkbox"
                            :value="option"
                            x-model="selected"
                            class="h-4 w-4 rounded border-primary text-primary shadow focus:ring-primary"
                        />
                        <span class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" x-text="option"></span>
                    </label>
                </template>
            </div>

            <div class="mt-4 flex justify-end w-full">
                <button
                    @click="sendMessage(selected.join(', '))"
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 shadow-sm"
                    :disabled="selected.length === 0"
                >
                   <span>Submit Selection</span>
                </button>
            </div>
        </div>
    </template>

    <!-- History State -->
    <template x-if="!awaitingHumanInput">
        <div
            class="mt-3 flex flex-wrap gap-2"
            x-data="{
                get choices() {
                    const choices = message.parsedResult?.answer_choices;
                    return Array.isArray(choices) ? choices : [];
                }
            }"
        >
             <template x-for="option in choices">
                @badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-xs pointer-events-none opacity-60"}) {
                    <span x-text="option"></span>
                }
            </template>
        </div>
    </template>
}
