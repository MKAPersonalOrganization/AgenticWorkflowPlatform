package elicitation

// ChooseMultipleProps - no specific props as it relies on Alpine context
type ChooseMultipleProps struct {}

templ ChooseMultiple() {
    <!-- Active State: Checkboxes with Submit -->
    <template x-if="awaitingHumanInput && index === messages.length - 1">
        <div 
            class="mt-4 pt-4 border-t border-primary/10 animate-in fade-in slide-in-from-top-2"
            x-data="{ selected: [] }"
        >
            <div class="flex flex-col w-full gap-2">
                <template x-for="option in message.parsedArgs.schema.enum">
                    <label class="flex items-center space-x-3 p-3 rounded-md border border-input hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors">
                        <input 
                            type="checkbox" 
                            :value="option" 
                            x-model="selected"
                            class="h-4 w-4 rounded border-primary text-primary shadow focus:ring-primary"
                        >
                        <span class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" x-text="option"></span>
                    </label>
                </template>
            </div>
            
            <div class="mt-4 flex justify-end w-full">
                <button 
                    @click="sendMessage(selected.join(', '))"
                    :disabled="selected.length === 0"
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 shadow-sm gap-2"
                >
                    <span>Submit Selection</span>
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </button>
            </div>
        </div>
    </template>

    <!-- History State: Static Badges for Options -->
    <!-- Note: In history, we usually show the ANSWER (user message) not the options provided. 
         But if we want to show the options that were available (like in MultipleChoice), we can. 
         However, the container logic handled the history display for single choice. 
         Let's replicate it here for consistency using the correct schema path. -->
    <template x-if="!awaitingHumanInput || index !== messages.length - 1">
        <div class="mt-3 flex flex-wrap gap-2">
            <template x-for="option in message.parsedArgs.schema.enum">
                <!-- We can style them as all outline, or potentially verify which one was selected if we parsed the answer? 
                     That's hard since the answer is in a different message. Just show available options as static badges. -->
                 <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground opacity-60 pointer-events-none border-dashed">
                    <span x-text="option"></span>
                </div>
            </template>
        </div>
    </template>
}
