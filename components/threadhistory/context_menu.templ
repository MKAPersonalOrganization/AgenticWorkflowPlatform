package threadhistory

import "school-with-ai/components/icon"
import "school-with-ai/components/button"
import "school-with-ai/components/i18n"

type ContextMenuProps struct {
	ThreadID string
}

templ ContextMenu(props ContextMenuProps) {
	<div
		x-data="{ 
			open: false,
			top: 0,
			left: 0,
			isLoading: false,
			toggle() {
				this.open = !this.open;
				if (this.open) {
					this.$nextTick(() => {
						const rect = this.$refs.trigger.getBoundingClientRect();
						this.top = rect.top;
						this.left = rect.right + 8;
						
						if (window.innerHeight - rect.bottom < 200) {
							this.top = rect.bottom - 180;
						}
					});
				}
			}
		}"
		class="relative shrink-0"
	>
		@button.Button(button.Props{
			Type:    button.TypeButton,
			Variant: button.VariantGhost,
			Size:    button.SizeIcon,
			Class:   "opacity-0 group-hover/item:opacity-100 transition-opacity size-7 flex items-center justify-center rounded-lg text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-foreground outline-none focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-ring",
			Attributes: templ.Attributes{
				"x-ref":       "trigger",
				"@click.stop": "toggle()",
			},
		}) {
			@icon.Ellipsis(icon.Props{Class: "size-4"})
			<span class="sr-only">{ i18n.T(ctx, "Thread options") }</span>
		}
		<template x-teleport="body">
			<div
				x-show="open"
				x-transition:enter="transition ease-out duration-150"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-100"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@click.outside="open = false"
				:style="`top: ${top}px; left: ${left}px;`"
				class="fixed z-[60] w-52 rounded-xl border border-border/50 bg-popover text-popover-foreground shadow-xl backdrop-blur-sm"
				style="display: none;"
			>
				<div class="flex flex-col p-1.5">
					<!-- Share Button -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-3 px-3 py-2 text-sm rounded-lg hover:bg-accent hover:text-accent-foreground text-start w-full transition-colors",
						Attributes: templ.Attributes{
							"@click.stop": "shareSession(" + props.ThreadID + "); open = false",
						},
					}) {
						@icon.Share2(icon.Props{Class: "size-4 text-muted-foreground"})
						<span>{ i18n.T(ctx, "Share") }</span>
					}
					<!-- Duplicate Button -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-3 px-3 py-2 text-sm rounded-lg hover:bg-accent hover:text-accent-foreground text-start w-full transition-colors",
						Attributes: templ.Attributes{
							"@click.stop": "duplicateSession(" + props.ThreadID + "); open = false",
						},
					}) {
						@icon.Copy(icon.Props{Class: "size-4 text-muted-foreground"})
						<span>{ i18n.T(ctx, "Duplicate") }</span>
					}
					<!-- Archive Button -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-3 px-3 py-2 text-sm rounded-lg hover:bg-accent hover:text-accent-foreground text-start w-full transition-colors",
						Attributes: templ.Attributes{
							"@click.stop": "archiveSession(" + props.ThreadID + "); open = false",
						},
					}) {
						@icon.Archive(icon.Props{Class: "size-4 text-muted-foreground"})
						<span>{ i18n.T(ctx, "Archive") }</span>
					}
					<hr class="my-1.5 border-border/50"/>
					<!-- Rename Button -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-3 px-3 py-2 text-sm rounded-lg hover:bg-accent hover:text-accent-foreground text-start w-full transition-colors",
						Attributes: templ.Attributes{
							"@click.stop": "renameSession(" + props.ThreadID + "); open = false",
						},
					}) {
						@icon.Pencil(icon.Props{Class: "size-4 text-muted-foreground"})
						<span>{ i18n.T(ctx, "Rename") }</span>
					}
					<hr class="my-1.5 border-border/50"/>
					<!-- Delete Button -->
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-3 px-3 py-2 text-sm rounded-lg hover:bg-destructive/10 text-destructive hover:text-destructive text-start w-full transition-colors",
						Attributes: templ.Attributes{
							"@click.stop": "deleteSession(" + props.ThreadID + "); open = false",
						},
					}) {
						@icon.Trash2(icon.Props{Class: "size-4"})
						<span>{ i18n.T(ctx, "Delete") }</span>
					}
				</div>
			</div>
		</template>
	</div>
}
