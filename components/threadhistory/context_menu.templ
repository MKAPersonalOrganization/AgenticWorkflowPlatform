package threadhistory

import "school-with-ai/components/icon"
import "school-with-ai/components/button"

type ContextMenuProps struct {
	ThreadID string
}

templ ContextMenu(props ContextMenuProps) {
	<div 
		x-data="{ 
			open: false,
			top: 0,
			left: 0,
			toggle() {
				this.open = !this.open;
				if (this.open) {
					this.$nextTick(() => {
						const rect = this.$refs.trigger.getBoundingClientRect();
						this.top = rect.top;
						this.left = rect.right + 8; // 8px gap
						
						// Boundary check - flip if close to bottom (optional simplistic)
						if (window.innerHeight - rect.bottom < 150) {
							this.top = rect.bottom - 100; // Adjust as needed
						}
					});
				}
			}
		}" 
		class="relative shrink-0"
	>
		@button.Button(button.Props{
			Type:    button.TypeButton,
			Variant: button.VariantGhost,
			Size:    button.SizeIcon,
			Class:   "opacity-0 group-hover/item:opacity-100 transition-opacity size-6 flex items-center justify-center rounded-md text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-foreground outline-none focus-visible:opacity-100",
			Attributes: templ.Attributes{
				"x-ref":       "trigger",
				"@click.stop": "toggle()",
			},
		}) {
			@icon.EllipsisVertical(icon.Props{Class: "size-4"})
			<span class="sr-only">Thread options</span>
		}
		<template x-teleport="body">
			<div 
				x-show="open" 
				x-transition:enter="transition ease-out duration-150"
				x-transition:enter-start="opacity-0 scale-95 translate-x-[-10px]"
				x-transition:enter-end="opacity-100 scale-100 translate-x-0"
				x-transition:leave="transition ease-in duration-100"
				x-transition:leave-start="opacity-100 scale-100 translate-x-0"
				x-transition:leave-end="opacity-0 scale-95 translate-x-[-10px]"
				@click.outside="open = false"
				:style="`top: ${top}px; left: ${left}px;`"
				class="fixed z-[60] w-48 rounded-lg border border-border/50 bg-popover/95 text-popover-foreground shadow-xl backdrop-blur-sm ring-1 ring-black/5"
				style="display: none;"
			>
				<div class="flex flex-col p-1">
					<div class="px-2 py-1.5 text-xs font-medium text-muted-foreground/70">
						Options
					</div>
					<hr class="my-1 border-border/50" />
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-2 px-2 py-1.5 text-sm rounded-md hover:bg-accent hover:text-accent-foreground text-left w-full cursor-not-allowed opacity-50 transition-colors",
						Attributes: templ.Attributes{
							"title":       "Coming soon",
							"@click.stop": "open = false",
						},
					}) {
						@icon.Pencil(icon.Props{Class: "size-4"})
						<span>Rename</span>
					}
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "justify-start flex items-center gap-2 px-2 py-1.5 text-sm rounded-md hover:bg-accent hover:text-accent-foreground text-left w-full transition-colors",
						Attributes: templ.Attributes{
							"@click.stop": "deleteSession(" + props.ThreadID + "); open = false",
						},
					}) {
						@icon.Trash2(icon.Props{Class: "size-4"})
						<span>Delete</span>
					}
				</div>
			</div>
		</template>
	</div>
}
