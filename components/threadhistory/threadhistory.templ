package threadhistory

import "school-with-ai/components/button"
import "school-with-ai/components/separator"
import "school-with-ai/components/sidebar"
import "school-with-ai/components/icon"

templ ThreadHistory() {
	@sidebar.Sidebar(sidebar.Props{
		ID:          "thread-history-sidebar",
		Side:        sidebar.SideLeft,
		Variant:     sidebar.VariantSidebar,
		Collapsible: sidebar.CollapsibleOffcanvas,
		Collapsed:   true,
		Class:       "z-30 !left-0 !border-r-0",
	}) {
		@sidebar.Header() {
			<div class="flex items-center justify-end">
				<!-- Close Sidebar Button -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-7 md:hidden",
					Attributes: templ.Attributes{
						"data-tui-sheet-close": "thread-history-sidebar-mobile",
					},
				}) {
					@icon.X(icon.Props{Class: "size-4"})
					<span class="sr-only">Close Thread History</span>
				}
				<div class="hidden md:block">
					@button.Button(button.Props{
						Size:    button.SizeIcon,
						Variant: button.VariantGhost,
						Class:   "size-7",
						Attributes: templ.Attributes{
							"data-tui-sidebar-trigger": true,
							"data-tui-sidebar-target":  "thread-history-sidebar",
						},
					}) {
						@icon.PanelLeftClose(icon.Props{Class: "size-4"})
						<span class="sr-only">Close Thread History</span>
					}
				</div>
			</div>
			@separator.Separator(separator.Props{Class: "mt-1"})
		}
		@sidebar.Content() {
			<!-- Action Buttons Stack -->
			<div class="px-3 py-2 space-y-2">
				<!-- New Chat Button -->
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
					Class:   "w-full justify-start gap-2 shadow-sm",
					Attributes: templ.Attributes{
						"@click": "createNewSession()",
					},
				}) {
					@icon.Plus(icon.Props{Class: "size-4"})
					<span>New Chat</span>
				}
				<!-- Future buttons can be added here -->
			</div>
			@separator.Separator()
			<!-- Thread List -->
			@sidebar.Menu() {
				<template x-for="session in sessions" :key="session.id">
					@sidebar.MenuItem() {
						<div class="flex items-center gap-2 w-full group/item">
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Class: "flex-1 relative",
								Attributes: templ.Attributes{
									"@click":             "switchSession(session.id)",
									":class":             "threadId === session.id ? 'bg-sidebar-accent/50 font-medium before:absolute before:left-0 before:top-1/2 before:-translate-y-1/2 before:h-5 before:w-0.5 before:bg-primary before:rounded-r-full' : 'hover:bg-sidebar-accent/30'",
									"x-bind:data-active": "threadId === session.id",
									"class":              "transition-all duration-300 ease-out",
								},
							}) {
								<div class="flex items-center gap-2 w-full">
									<!-- Streaming indicator -->
									<span x-show="isThreadStreaming(session.id)" class="flex h-2 w-2 relative">
										<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
										<span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
									</span>
									<span class="truncate flex-1" x-text="session.title"></span>
								</div>
							}
							@ContextMenu(ContextMenuProps{
								ThreadID: "session.id",
							})
						</div>
					}
				</template>
				<!-- Loading indicator for infinite scroll -->
				<li x-show="sessionsLoading" class="flex justify-center py-2">
					<span class="animate-spin size-4 border-2 border-primary border-t-transparent rounded-full"></span>
				</li>
			}
		}
	}
}
