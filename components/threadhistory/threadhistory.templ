package threadhistory

import (
	"strings"

	"school-with-ai/components/button"
	"school-with-ai/components/icon"
	"school-with-ai/components/popover"
	"school-with-ai/components/sidebar"
	"school-with-ai/components/tooltip"
	"school-with-ai/domain"
)

type Props struct {
	User *domain.User
}

templ ThreadHistory(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	@sidebar.Sidebar(sidebar.Props{
		ID:          "thread-history-sidebar",
		Side:        sidebar.SideLeft,
		Variant:     sidebar.VariantSidebar,
		Collapsible: sidebar.CollapsibleOffcanvas,
		Collapsed:   false,
		Class:       "z-30 !left-0 !border-r-0",
		Attributes:  templ.Attributes{
			"style": "--sidebar-width: 260px", 
		},
	}) {
		@sidebar.Header() {
			<div class="flex items-center justify-between w-full px-1">
				<!-- Sidebar Toggle (Left) -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-9 hover:bg-sidebar-accent/50 rounded-lg",
					Attributes: templ.Attributes{
						"data-tui-sidebar-trigger": true,
						"data-tui-sidebar-target":  "thread-history-sidebar",
						"class":                    "hidden md:inline-flex items-center justify-center",
					},
				}) {
					@icon.PanelLeftClose(icon.Props{Class: "size-5 text-sidebar-foreground"})
					<span class="sr-only">Close Sidebar</span>
				}
				<!-- Mobile Toggle -->
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-8 md:hidden hover:bg-sidebar-accent/50 rounded-lg",
					Attributes: templ.Attributes{
						"data-tui-sheet-close": "thread-history-sidebar-mobile",
					},
				}) {
					@icon.X(icon.Props{Class: "size-5 text-sidebar-foreground"})
					<span class="sr-only">Close Sidebar</span>
				}

				<!-- New Chat Button (Right) -->
				@tooltip.Tooltip(tooltip.Props{}) {
					@tooltip.Trigger(tooltip.TriggerProps{}) {
						@button.Button(button.Props{
							Size:    button.SizeIcon,
							Variant: button.VariantGhost,
							Class:   "size-9 hover:bg-sidebar-accent/50 rounded-lg",
							Attributes: templ.Attributes{
								"@click": "createNewSession()",
							},
						}) {
							@icon.SquarePen(icon.Props{Class: "size-5 text-sidebar-foreground"})
							<span class="sr-only">New Chat</span>
						}
					}
					@tooltip.Content(tooltip.ContentProps{Class: "bg-popover text-popover-foreground"}) {
						 New Chat
					}
				}
			</div>
			<!-- Search Bar -->
			<div class="px-2 pb-1 pt-1">
				<div class="group relative flex h-9 items-center gap-2 rounded-lg border-2 border-transparent px-2 py-1.5 text-foreground focus-within:border-ring/20 focus-within:bg-sidebar-accent/50 hover:bg-sidebar-accent/30 transition-all cursor-text"
					@click="$refs.searchInput.focus()">
					@icon.Search(icon.Props{Class: "absolute left-2.5 h-4 w-4 text-muted-foreground group-focus-within:text-foreground"})
					<input 
						x-ref="searchInput"
						type="text" 
						placeholder="Search chats..." 
						class="w-full bg-transparent text-sm text-foreground placeholder:text-muted-foreground focus:outline-none pl-6"
					/>
				</div>
			</div>
		}

		@sidebar.Content(sidebar.ContentProps{Class: "gap-0 scrollbar-transparent scrollbar-hover overflow-y-auto"}) {
			<!-- Infinite Scroll Sentinel & Loading Indicator (Top for reverse scroll? No, traditionally bottom for chat history loading older) -->
			<!-- Actually for thread list, usually we load more as we scroll down. -->
			
			<template x-for="group in getGroupedSessions()" :key="group.title">
				@sidebar.Group(sidebar.GroupProps{Class: "px-2 py-0"}) {
					@sidebar.GroupLabel(sidebar.GroupLabelProps{
						Class: "text-muted-foreground/50 px-3 py-3 h-auto text-[11px] font-semibold sticky top-0 bg-sidebar z-10 uppercase tracking-wider",
					}) {
						<span x-text="group.title"></span>
					}
					@sidebar.Menu(sidebar.MenuProps{Class: "gap-0.5"}) {
						<template x-for="session in group.sessions" :key="session.id">
							@sidebar.MenuItem(sidebar.MenuItemProps{ Class: "group/item relative" }) {
								@sidebar.MenuButton(sidebar.MenuButtonProps{
									Class: "w-full justify-start h-[42px] px-3 gap-3 text-sidebar-foreground hover:bg-sidebar-accent/50 transition-colors data-[tui-sidebar-active=true]:bg-sidebar-accent data-[tui-sidebar-active=true]:text-sidebar-accent-foreground data-[tui-sidebar-active=true]:font-medium pr-10 rounded-lg",
									Attributes: templ.Attributes{
										"@click": "switchSession(session.id)",
										"x-bind:data-tui-sidebar-active": "threadId === session.id",
									},
								}) {
									<div class="flex items-center gap-2 w-full overflow-hidden">
										<!-- Active Indicator Bar (LibreChat Style) -->
										<div class="absolute left-0 top-0 bottom-0 w-[2px] bg-foreground transition-all duration-200"
 											x-show="threadId === session.id"
 											x-transition:enter="transition ease-out duration-200"
 											x-transition:enter-start="opacity-0 scale-y-50"
 											x-transition:enter-end="opacity-100 scale-y-100"
 										></div>
										
										<!-- Title -->
										<span class="truncate text-sm flex-1 text-left" x-text="session.title"></span>
									</div>
								}

								<!-- Context Menu (Trigger) -->
								<div class="absolute right-1 top-1.5 z-10"
									:class="threadId === session.id ? 'opacity-100' : 'opacity-0 group-hover/item:opacity-100'"
									@click.stop>
									@ContextMenu(ContextMenuProps{
										ThreadID: "session.id",
									})
								</div>
							}
						</template>
					}
				}
			</template>

			<!-- Loading Indicator -->
			<div x-show="sessionsHasMore" x-intersect.margin.200px="__loadMoreSessions()" class="flex justify-center py-4 h-12 w-full">
				<span x-show="sessionsLoading" class="animate-spin size-4 border-2 border-primary border-t-transparent rounded-full"></span>
			</div>
		}

		@sidebar.Footer() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@popover.Trigger(popover.TriggerProps{
						For: "sidebar-profile-popover",
					}) {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							Size: "lg",
							Class: "hover:bg-sidebar-accent/50 transition-colors py-2 px-2 rounded-xl",
						}) {
							if p.User != nil {
								<div class="flex items-center gap-2 w-full">
									<div class="size-8 rounded-full bg-primary/10 flex items-center justify-center overflow-hidden shrink-0 border border-border/50">
										<span class="text-xs font-bold text-primary">{ strings.ToUpper(p.User.Email[:1]) }</span>
									</div>
									<div class="grid flex-1 text-left text-sm leading-tight">
										<span class="truncate font-medium text-sidebar-foreground">{ p.User.GetDisplayName() }</span>
									</div>
									@icon.ChevronsUpDown(icon.Props{Class: "size-4 text-muted-foreground/70"})
								</div>
							} else {
								<div class="flex items-center gap-2 w-full">
									<div class="size-8 rounded-full bg-muted flex items-center justify-center overflow-hidden shrink-0 border border-border/50">
										@icon.User(icon.Props{Class: "size-4 text-muted-foreground"})
									</div>
									<div class="grid flex-1 text-left text-sm leading-tight">
										<span class="truncate font-medium text-sidebar-foreground">Guest</span>
									</div>
									@icon.ChevronsUpDown(icon.Props{Class: "size-4 text-muted-foreground/70"})
								</div>
							}
						}
					}
					@popover.Content(popover.ContentProps{
						ID:        "sidebar-profile-popover",
						Placement: popover.PlacementTopStart,
						Class:     "w-64 overflow-hidden p-1 border border-border bg-popover text-popover-foreground shadow-lg rounded-xl mb-2",
					}) {
						<div class="flex flex-col">
							@sidebar.Menu() {
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Class: "hover:bg-sidebar-accent/50 transition-colors py-2 px-3 rounded-lg flex items-center gap-3 w-full text-left",
										Attributes: templ.Attributes{
											"@click": "showSettings = true", 
										},
									}) {
										@icon.Settings(icon.Props{Class: "size-4 text-muted-foreground"})
										<span class="text-sm font-medium">Settings</span>
									}
								}
								<div class="my-1 h-px bg-border/50"></div>
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Href:  "/logout",
										Class: "hover:bg-sidebar-accent/50 transition-colors py-2 px-3 rounded-lg flex items-center gap-3 w-full text-left text-destructive hover:text-destructive",
									}) {
										@icon.LogOut(icon.Props{Class: "size-4"})
										<span class="text-sm font-medium">Log out</span>
									}
								}
							}
						</div>
					}
				}
			}
		}
	}
}
