package components

import (
	"school-with-ai/components/i18n"
	"school-with-ai/components/nav"
	"school-with-ai/domain"
)

// LayoutProps configures the root application layout.
// Similar to Next.js layout.tsx props pattern.
type LayoutProps struct {
	Title      string
	User       *domain.User
	ExtraHead  templ.Component
	HideNavbar bool
}

// BaseLayout is the root layout component — equivalent to Next.js RootLayout.
// It composes: DocumentHead, ThemeProvider (body), Navbar, content slot, and GlobalModals.
// All pages render inside this layout.
templ BaseLayout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) } dir={ i18n.Dir(ctx) }>
		@DocumentHead(props.Title, props.ExtraHead)
		<body class="flex h-dvh bg-background text-foreground antialiased overflow-hidden" x-data="themeManager">
			<div class="flex h-dvh w-full overflow-hidden">
				if !props.HideNavbar {
					@nav.Navbar(nav.NavbarProps{
						User: props.User,
					})
				}
				<!-- Main Content Area -->
				<div class="flex-1 min-w-0 overflow-hidden relative" id="main-content">
					{ children... }
				</div>
			</div>
			@GlobalModals()
		</body>
	</html>
}

// AppLayoutProps is kept for backward compatibility.
type AppLayoutProps struct {
	Title       string
	User        *domain.User
	IncludeChat bool // If true, includes chat-specific scripts
}

// AppLayout wraps BaseLayout for backward compatibility.
templ AppLayout(props AppLayoutProps) {
	@BaseLayout(LayoutProps{
		Title: props.Title,
		User:  props.User,
	}) {
		{ children... }
	}
}
