package components

import "school-with-ai/components/navbar"
import "school-with-ai/domain"

type AppLayoutProps struct {
	Title       string
	User        *domain.User
	IncludeChat bool // If true, includes chat-specific scripts
}

// AppLayout provides the main application layout with navbar
templ AppLayout(props AppLayoutProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - SchoolWithAI</title>
			<link rel="icon" type="image/svg+xml" href="/assets/images/logo-black.svg"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
		</head>
		<body class="flex min-h-screen bg-background text-foreground antialiased">
			<!-- Left Navigation Bar -->
			@navbar.Navbar(navbar.Props{User: props.User})
			<!-- Main Content with margin for navbar -->
			<div class="ml-16 flex-1">
				{ children... }
			</div>
		</body>
	</html>
}
