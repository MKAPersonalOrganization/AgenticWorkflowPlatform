package pricing

import "school-with-ai/components/card"
import "school-with-ai/components/button"
import "school-with-ai/components/icon"
import "school-with-ai/components/badge"
import "school-with-ai/components/pageheader"
import "school-with-ai/components"
import "school-with-ai/domain"
import "school-with-ai/components/i18n"
import "context"

type Plan struct {
	ID          string
	Name        string
	Price       string
	Period      string
	Description string
	Features    []string
	Popular     bool
	ButtonText  string
	ButtonHref  string
}

type PricingPageProps struct {
	Plans []Plan
	User  *domain.User
}

templ PricingPage(props PricingPageProps) {
	@components.AppLayout(components.AppLayoutProps{
		Title: i18n.T(ctx, "Pricing Plans"),
		User:  props.User,
	}) {
		<div class="min-h-screen bg-background">
			<div class="container mx-auto max-w-7xl px-6 py-8 lg:py-12 space-y-10">
				<!-- Header with Back Button -->
				@pageheader.PageHeader(pageheader.Props{
					Title:       i18n.T(ctx, "Choose Your Plan"),
					Description: i18n.T(ctx, "Unlock the full potential of AI-powered learning with our flexible pricing options"),
					BackURL:     "/",
					BackLabel:   i18n.T(ctx, "Back to Home"),
				})
				<!-- Pricing Cards -->
				@PricingCards(props)
			</div>
		</div>
	}
}

templ PricingCards(props PricingPageProps) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
		for _, plan := range props.Plans {
			if plan.Popular {
				<div class="relative lg:scale-105 lg:z-10">
					@card.Card(card.Props{
						Class: "border-2 border-primary shadow-xl",
					}) {
						<div class="absolute -top-4 left-1/2 -translate-x-1/2">
							@badge.Badge(badge.Props{
								Variant: badge.VariantDefault,
								Class:   "px-4 py-2 text-xs font-bold shadow-lg",
							}) {
								<span>{ i18n.T(ctx, "POPULAR") }</span>
							}
						</div>
						@planCardContent(plan)
					}
				</div>
			} else {
				<div class="relative">
					@card.Card(card.Props{
						Class: "border-2 border-border hover:border-ring transition-all hover:shadow-lg",
					}) {
						@planCardContent(plan)
					}
				</div>
			}
		}
	</div>
}

templ planCardContent(plan Plan) {
	@card.Header(card.HeaderProps{Class: "text-center pb-10 pt-8"}) {
		@card.Title(card.TitleProps{Class: "text-2xl font-bold"}) {
			{ plan.Name }
		}
		@card.Description(card.DescriptionProps{Class: "mt-3 leading-relaxed"}) {
			{ plan.Description }
		}
		<div class="mt-6">
			<div class="flex items-baseline justify-center gap-2">
				<span class="text-5xl font-bold tracking-tight">{ plan.Price }</span>
				if plan.Period != "" {
					<span class="text-base text-muted-foreground font-medium">{ plan.Period }</span>
				}
			</div>
		</div>
	}
	@card.Content(card.ContentProps{Class: "space-y-5 pb-8"}) {
		<ul class="space-y-4">
			for _, feature := range plan.Features {
				<li class="flex items-start gap-3">
					<div class="mt-1">
						@icon.Check(icon.Props{Class: "size-5 text-primary flex-shrink-0"})
					</div>
					<span class="text-sm leading-relaxed">{ feature }</span>
				</li>
			}
		</ul>
	}
	@card.Footer(card.FooterProps{Class: "flex-col pt-6"}) {
		if plan.Popular {
			@button.Button(button.Props{
				Variant:   button.VariantDefault,
				FullWidth: true,
				Href:      plan.ButtonHref,
				Size:      button.SizeLg,
			}) {
				{ plan.ButtonText }
			}
		} else {
			@button.Button(button.Props{
				Variant:   button.VariantOutline,
				FullWidth: true,
				Href:      plan.ButtonHref,
				Size:      button.SizeLg,
			}) {
				{ plan.ButtonText }
			}
		}
	}
}

