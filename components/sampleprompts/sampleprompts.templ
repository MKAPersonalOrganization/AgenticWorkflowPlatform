package sampleprompts

import "school-with-ai/components/icon"

templ SamplePrompts() {
	<!-- Welcome Screen / Sample Prompts -->
	<div class="w-full flex flex-col items-center justify-center min-h-[60vh] space-y-10 animate-in fade-in duration-500" x-data="{ selectedCategory: null }">
		



		<!-- Category Grid -->
		<div class="w-full max-w-4xl">
			<div class="grid gap-4 grid-cols-2 md:grid-cols-4 lg:grid-cols-4">
				<!-- Math -->
				@CategoryButton("math", "Mathematics", icon.Calculator)
				<!-- Physics -->
				@CategoryButton("physics", "Physics", icon.Atom)
				<!-- Chemistry -->
				@CategoryButton("chemistry", "Chemistry", icon.FlaskConical)
				<!-- Biology -->
				@CategoryButton("biology", "Biology", icon.Dna)
				<!-- History -->
				@CategoryButton("history", "History", icon.Landmark)
				<!-- Literature -->
				@CategoryButton("literature", "Literature", icon.BookOpen)
				<!-- Comp Sci -->
				@CategoryButton("cs", "Computer Science", icon.Cpu)
				<!-- Economics -->
				@CategoryButton("economics", "Economics", icon.TrendingUp)
			</div>
		</div>

		<!-- Expanded Examples (Centered & Clean) -->
		<div class="w-full max-w-2xl transition-all duration-300 ease-in-out">
			<!-- Math Examples -->
			<div x-show="selectedCategory === 'math'" x-collapse class="space-y-2">
				@PromptButton("Solve the quadratic equation: x² + 5x + 6 = 0")
				@PromptButton("What is the derivative of sin(x) · cos(x)?")
				@PromptButton("Calculate the area of a circle with radius 5")
				@PromptButton("Calculate mean and standard deviation of: 4, 8, 6, 5, 3, 7")
			</div>
			<!-- Physics Examples -->
			<div x-show="selectedCategory === 'physics'" x-collapse class="space-y-2">
				@PromptButton("Calculate the force needed to accelerate a 50kg object at 3m/s²")
				@PromptButton("What is the kinetic energy of a 2kg object moving at 10m/s?")
				@PromptButton("Explain Newton's third law of motion with an example")
			</div>
			<!-- Chemistry Examples -->
			<div x-show="selectedCategory === 'chemistry'" x-collapse class="space-y-2">
				@PromptButton("Balance the equation: H₂ + O₂ → H₂O")
				@PromptButton("What is the molar mass of glucose (C₆H₁₂O₆)?")
				@PromptButton("Explain the difference between ionic and covalent bonds")
			</div>
			<!-- Biology Examples -->
			<div x-show="selectedCategory === 'biology'" x-collapse class="space-y-2">
				@PromptButton("Explain the process of photosynthesis")
				@PromptButton("What are the main differences between plant and animal cells?")
				@PromptButton("Describe the structure of DNA")
			</div>
			<!-- History Examples -->
			<div x-show="selectedCategory === 'history'" x-collapse class="space-y-2">
				@PromptButton("Explain the causes of World War I")
				@PromptButton("What were the key events of the French Revolution?")
				@PromptButton("Describe the impact of the Industrial Revolution on society")
			</div>
			<!-- Literature Examples -->
			<div x-show="selectedCategory === 'literature'" x-collapse class="space-y-2">
				@PromptButton("Analyze the theme of revenge in Hamlet")
				@PromptButton("What are the main literary devices in To Kill a Mockingbird?")
				@PromptButton("Compare and contrast a sonnet and a haiku")
			</div>
			<!-- Computer Science Examples -->
			<div x-show="selectedCategory === 'cs'" x-collapse class="space-y-2">
				@PromptButton("Explain what an algorithm is with examples")
				@PromptButton("What is the difference between a stack and a queue?")
				@PromptButton("Write a simple Python program to find prime numbers")
			</div>
			<!-- Economics Examples -->
			<div x-show="selectedCategory === 'economics'" x-collapse class="space-y-2">
				@PromptButton("Explain the law of supply and demand")
				@PromptButton("What is the difference between GDP and GNP?")
				@PromptButton("How does inflation affect the economy?")
			</div>
		</div>
	</div>
}

templ CategoryButton(id string, label string, iconFunc func(...icon.Props) templ.Component) {
	<button
		@click={ "selectedCategory = selectedCategory === '" + id + "' ? null : '" + id + "'" }
		class="group flex flex-col items-center justify-center p-4 gap-3 rounded-xl border border-border/40 bg-card hover:bg-accent/50 hover:border-primary/50 transition-all duration-200 hover:shadow-sm"
		:class={ "selectedCategory === '" + id + "' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : ''" }
	>
		<div class="p-3 rounded-lg bg-background group-hover:bg-background/80 transition-colors shadow-sm ring-1 ring-border/50">
			@iconFunc(icon.Props{Size: 20, Class: "text-foreground/70 group-hover:text-primary transition-colors"})
		</div>
		<span class="text-sm font-medium text-foreground/80 group-hover:text-foreground">{ label }</span>
	</button>
}

templ PromptButton(text string) {
	<button
		@click={ "currentMessage = '" + text + "'; sendMessage()" }
		class="w-full text-left p-4 rounded-xl border border-border/40 bg-card/50 hover:bg-accent hover:border-primary/50 transition-all duration-200 text-sm group flex items-center justify-between"
	>
		<span>{ text }</span>
		<span class="opacity-0 group-hover:opacity-100 transition-opacity text-muted-foreground">→</span>
	</button>
}
