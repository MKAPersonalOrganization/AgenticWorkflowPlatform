package lightrag

import "school-with-ai/domain"

type DashboardProps struct {
	User *domain.User
}

templ Dashboard(props DashboardProps) {
	@Layout(LayoutProps{
		Title: "LightRAG Dashboard",
		User:  props.User,
	}) {
		<div
			x-data="lightragDashboard()"
			x-init="init()"
			class="p-6 md:p-8 space-y-6 max-w-7xl mx-auto"
		>
			<!-- Header -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<h1 class="text-3xl font-bold tracking-tight bg-gradient-to-r from-primary to-primary/60 bg-clip-text text-transparent">LightRAG Dashboard</h1>
					<p class="text-muted-foreground mt-1">Upload documents, run the indexing pipeline, then query the knowledge base.</p>
				</div>
				<div class="flex items-center gap-2">
					<span
						x-show="health.status"
						x-text="health.status"
						class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium"
						:class="health.status === 'healthy' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400'"
					></span>
					<button @click="refresh()" class="inline-flex items-center justify-center rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors gap-1.5">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
						Refresh
					</button>
				</div>
			</div>
			<!-- Tabs: Overview → Documents → Pipeline → Query → Maintenance -->
			<div class="border-b">
				<nav class="-mb-px flex gap-4" aria-label="Tabs">
					<template x-for="tab in ['overview','documents','pipeline','query','maintenance']" :key="tab">
						<button
							@click="activeTab = tab"
							:class="activeTab === tab ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground hover:border-muted-foreground/30'"
							class="whitespace-nowrap border-b-2 pb-3 px-1 text-sm font-medium capitalize transition-colors"
							x-text="tab === 'pipeline' ? 'Pipeline (' + (statusCounts.pending ?? 0) + ' pending)' : tab"
						></button>
					</template>
				</nav>
			</div>
			<!-- Overview Tab -->
			<div x-show="activeTab === 'overview'" x-cloak>
				@overviewTab()
			</div>
			<!-- Documents Tab -->
			<div x-show="activeTab === 'documents'" x-cloak>
				@documentsTab()
			</div>
			<!-- Pipeline Tab -->
			<div x-show="activeTab === 'pipeline'" x-cloak>
				@pipelineTab()
			</div>
			<!-- Query Tab -->
			<div x-show="activeTab === 'query'" x-cloak>
				@queryTab()
			</div>
			<!-- Maintenance Tab -->
			<div x-show="activeTab === 'maintenance'" x-cloak>
				@maintenanceTab()
			</div>
			<!-- Toast (global) -->
			<div
				x-show="toast"
				x-transition
				class="fixed bottom-6 right-6 rounded-lg shadow-lg px-4 py-3 text-sm font-medium z-50"
				:class="toastType === 'error' ? 'bg-destructive text-destructive-foreground' : 'bg-primary text-primary-foreground'"
				x-text="toast"
			></div>
		</div>
		@dashboardScript()
	}
}

templ overviewTab() {
	<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
		<template
			x-for="[label, key] in [
			['Total', 'total'],
			['Processed', 'processed'],
			['Processing', 'processing'],
			['Pending', 'pending'],
			['Failed', 'failed']
		]"
			:key="key"
		>
			<div class="rounded-xl border bg-card p-4 shadow-sm">
				<p class="text-sm text-muted-foreground" x-text="label"></p>
				<p class="text-2xl font-bold mt-1" x-text="statusCounts[key] ?? 0"></p>
			</div>
		</template>
	</div>
	<!-- Flow hint -->
	<div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
		<span class="font-medium">Flow:</span>
		<span class="rounded bg-muted px-2 py-0.5">1. Upload</span>
		<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
		<span class="rounded bg-muted px-2 py-0.5">2. Pipeline</span>
		<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
		<span class="rounded bg-muted px-2 py-0.5">3. Query</span>
	</div>
	<div class="mt-4 rounded-xl border bg-card p-5 shadow-sm">
		<h3 class="text-sm font-semibold text-muted-foreground mb-3">System Info</h3>
		<dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
			<div>
				<dt class="text-muted-foreground">Storages</dt>
				<dd class="font-medium" x-text="health.storages_status || '-'"></dd>
			</div>
			<div>
				<dt class="text-muted-foreground">Working Dir</dt>
				<dd class="font-medium truncate" x-text="health.working_dir || '-'" :title="health.working_dir"></dd>
			</div>
			<div>
				<dt class="text-muted-foreground">Workspace</dt>
				<dd class="font-medium" x-text="health.workspace || '(default)'"></dd>
			</div>
		</dl>
	</div>
}

templ documentsTab() {
	<!-- File Browser Toolbar -->
	<div class="flex flex-col gap-4 mb-4">
		<!-- Breadcrumbs & Actions -->
		<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
			<!-- Breadcrumbs -->
			<nav class="flex items-center text-sm font-medium text-muted-foreground overflow-x-auto whitespace-nowrap">
				<button
					@click="navigateTo('')"
					class="hover:text-foreground transition-colors flex items-center gap-1"
					:class="currentPath === '' ? 'text-foreground font-semibold' : ''"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
					Home
				</button>
				<template x-for="(part, index) in pathParts" :key="index">
					<div class="flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-1 text-muted-foreground/50"><path d="m9 18 6-6-6-6"></path></svg>
						<button
							@click="navigateTo(part.path)"
							class="hover:text-foreground transition-colors"
							:class="part.path === currentPath ? 'text-foreground font-semibold' : ''"
							x-text="part.name"
						></button>
					</div>
				</template>
			</nav>
			<!-- Actions -->
			<div class="flex items-center gap-2">
				<!-- Scope Selector -->
				<div class="flex items-center gap-2 bg-muted/50 rounded-lg p-1">
					<label class="cursor-pointer px-3 py-1.5 rounded-md text-sm transition-colors" :class="uploadScope === 'public' ? 'bg-background shadow-sm font-medium text-foreground' : 'text-muted-foreground hover:text-foreground'">
						<input type="radio" name="scope" value="public" x-model="uploadScope" @change="refresh()" class="hidden"/>
						Public
					</label>
					<label class="cursor-pointer px-3 py-1.5 rounded-md text-sm transition-colors" :class="uploadScope === 'private' ? 'bg-background shadow-sm font-medium text-foreground' : 'text-muted-foreground hover:text-foreground'">
						<input type="radio" name="scope" value="private" x-model="uploadScope" @change="refresh()" class="hidden"/>
						Private
					</label>
				</div>
				<!-- New Folder -->
				<button
					@click="createFolder()"
					class="inline-flex items-center gap-2 rounded-lg border bg-background px-3 py-2 text-sm font-medium shadow-sm hover:bg-muted transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path><line x1="12" y1="10" x2="12" y2="16"></line><line x1="9" y1="13" x2="15" y2="13"></line></svg>
					New Folder
				</button>
				<!-- Upload -->
				<label class="inline-flex items-center gap-2 cursor-pointer rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
					Upload
					<input type="file" ref="fileInput" class="hidden" @change="uploadFile($event)" accept=".txt,.md,.pdf,.html,.csv,.json,.xml,.yaml,.yml,.log,.go,.py,.js,.ts" multiple/>
				</label>
			</div>
		</div>
		<span x-show="uploading" class="text-sm text-muted-foreground animate-pulse">Uploading...</span>
	</div>
	<!-- Documents List -->
	<div class="rounded-xl border bg-card shadow-sm overflow-hidden min-h-[400px]">
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b bg-muted/50">
						<th class="text-left p-3 font-medium text-muted-foreground w-8"></th>
						<th class="text-left p-3 font-medium text-muted-foreground">Name</th>
						<th class="text-left p-3 font-medium text-muted-foreground">Status</th>
						<th class="text-left p-3 font-medium text-muted-foreground hidden md:table-cell">Size</th>
						<th class="text-left p-3 font-medium text-muted-foreground hidden md:table-cell">Modified</th>
						<th class="text-right p-3 font-medium text-muted-foreground">Actions</th>
					</tr>
				</thead>
				<tbody>
					<!-- Empty State -->
					<template x-if="documents.length === 0">
						<tr>
							<td colspan="6" class="p-12 text-center text-muted-foreground flex flex-col items-center justify-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground/30"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
								<p>This folder is empty.</p>
							</td>
						</tr>
					</template>
					<!-- Parent Directory Link -->
					<template x-if="currentPath !== ''">
						<tr class="border-b hover:bg-muted/30 transition-colors cursor-pointer" @click="navigateUp()">
							<td class="p-3 text-center">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
							</td>
							<td class="p-3 font-medium">..</td>
							<td colspan="4"></td>
						</tr>
					</template>
					<!-- File/Folder Items -->
					<template x-for="doc in documents" :key="doc.id">
						<tr
							class="border-b last:border-0 hover:bg-muted/30 transition-colors cursor-pointer"
							@click="doc.is_dir ? navigateTo(currentPath + doc.file_path + '/') : null"
						>
							<td class="p-3 text-center">
								<!-- Icon -->
								<template x-if="doc.is_dir">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-blue-200 dark:text-blue-900/50 stroke-blue-500 stroke-2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
								</template>
								<template x-if="!doc.is_dir">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								</template>
							</td>
							<td class="p-3">
								<span class="font-medium" x-text="doc.file_path"></span>
							</td>
							<td class="p-3">
								<template x-if="!doc.is_dir">
									<span
										class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium"
										:class="{
											'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400': doc.status === 'processed' || doc.status === 'indexed',
											'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400': doc.status === 'processing' || doc.status === 'pipelined',
											'bg-gray-100 text-gray-800 dark:bg-gray-800/50 dark:text-gray-400': doc.status === 'uploaded',
											'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400': doc.status === 'failed',
											'bg-neutral-100 text-neutral-500 dark:bg-neutral-900/50 dark:text-neutral-500 line-through': doc.status === 'deleted'
										}"
										x-text="doc.status"
									></span>
								</template>
							</td>
							<td class="p-3 hidden md:table-cell text-muted-foreground" x-text="doc.is_dir ? '-' : formatBytes(doc.content_length)"></td>
							<td class="p-3 hidden md:table-cell text-muted-foreground" x-text="formatDate(doc.created_at)"></td>
							<td class="p-3 text-right" @click.stop>
								<button
									x-show="!doc.is_dir && doc.status === 'uploaded'"
									@click="ingestDoc(doc.id)"
									class="text-primary hover:text-primary/80 text-xs font-medium transition-colors mr-2"
								>Ingest</button>
								<button
									x-show="!doc.is_dir && doc.status !== 'deleted'"
									@click="deleteDoc(doc)"
									class="text-destructive hover:text-destructive/80 text-xs font-medium transition-colors"
								>Delete</button>
								<span
									x-show="doc.status === 'deleted'"
									class="text-muted-foreground text-xs font-medium opacity-50 cursor-not-allowed"
								>Deleted</span>
								<button
									x-show="doc.is_dir"
									@click="deleteDoc(doc)"
									class="text-destructive hover:text-destructive/80 text-xs font-medium transition-colors"
								>Delete</button>
							</td>
						</tr>
					</template>
				</tbody>
			</table>
		</div>
		<!-- Pagination -->
		<div x-show="docPagination.total_pages > 1" class="flex items-center justify-between px-4 py-3 border-t bg-muted/30">
			<span class="text-sm text-muted-foreground" x-text="'Page ' + docPagination.page + ' of ' + docPagination.total_pages + ' (' + docPagination.total + ' items)'"></span>
			<div class="flex gap-2">
				<button
					@click="loadDocuments(docPagination.page - 1)"
					:disabled="docPagination.page <= 1"
					class="px-3 py-1 text-sm rounded-md border hover:bg-muted transition-colors disabled:opacity-50"
				>Prev</button>
				<button
					@click="loadDocuments(docPagination.page + 1)"
					:disabled="docPagination.page >= docPagination.total_pages"
					class="px-3 py-1 text-sm rounded-md border hover:bg-muted transition-colors disabled:opacity-50"
				>Next</button>
			</div>
		</div>
	</div>
}

templ pipelineTab() {
	<div class="max-w-3xl space-y-6">
		<!-- Pipeline status cards -->
		<div class="grid grid-cols-3 gap-4">
			<div class="rounded-xl border bg-card p-4 shadow-sm text-center">
				<p class="text-3xl font-bold" x-text="statusCounts.pending ?? 0"></p>
				<p class="text-sm text-muted-foreground mt-1">Pending</p>
			</div>
			<div class="rounded-xl border bg-card p-4 shadow-sm text-center">
				<p class="text-3xl font-bold" x-text="statusCounts.processing ?? 0"></p>
				<p class="text-sm text-muted-foreground mt-1">Processing</p>
			</div>
			<div class="rounded-xl border bg-card p-4 shadow-sm text-center">
				<p class="text-3xl font-bold" x-text="statusCounts.processed ?? 0"></p>
				<p class="text-sm text-muted-foreground mt-1">Indexed</p>
			</div>
		</div>
		<!-- Index action -->
		<div class="rounded-xl border bg-card p-6 shadow-sm space-y-4">
			<div>
				<h3 class="text-lg font-semibold">Run Indexing Pipeline</h3>
				<p class="text-sm text-muted-foreground mt-1">
					Reads all pending documents, extracts text, chunks content, generates embeddings, and builds the knowledge graph.
				</p>
			</div>
			<div class="flex items-center gap-4">
				<button
					@click="runPipeline()"
					:disabled="indexing"
					class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors disabled:opacity-50"
				>
					<template x-if="!indexing">
						<span class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
							Run Pipeline
						</span>
					</template>
					<template x-if="indexing">
						<span class="flex items-center gap-2 animate-pulse">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
							Indexing...
						</span>
					</template>
				</button>
			</div>
		</div>
		<!-- Pipeline result -->
		<div x-show="pipelineResult" class="rounded-xl border bg-card p-5 shadow-sm">
			<h3 class="text-sm font-semibold text-muted-foreground mb-3">Last Pipeline Run</h3>
			<div class="grid grid-cols-3 gap-4 text-sm">
				<div>
					<span class="text-muted-foreground">Processed:</span>
					<span class="font-bold text-green-600 dark:text-green-400 ml-1" x-text="pipelineResult ? pipelineResult.processed : 0"></span>
				</div>
				<div>
					<span class="text-muted-foreground">Failed:</span>
					<span class="font-bold text-red-600 dark:text-red-400 ml-1" x-text="pipelineResult ? pipelineResult.failed : 0"></span>
				</div>
				<div>
					<span class="text-muted-foreground">Skipped:</span>
					<span class="font-bold ml-1" x-text="pipelineResult ? pipelineResult.skipped : 0"></span>
				</div>
			</div>
			<template x-if="pipelineResult && pipelineResult.errors && pipelineResult.errors.length > 0">
				<div class="mt-3 p-3 rounded-lg bg-destructive/5 border border-destructive/20">
					<p class="text-xs font-medium text-destructive mb-1">Errors:</p>
					<template x-for="e in pipelineResult.errors" :key="e">
						<p class="text-xs text-destructive/80" x-text="e"></p>
					</template>
				</div>
			</template>
		</div>
	</div>
}

templ queryTab() {
	<div class="max-w-3xl space-y-4">
		<div class="flex gap-3">
			<select x-model="queryMode" class="rounded-lg border bg-background px-3 py-2 text-sm focus:ring-2 focus:ring-primary outline-none">
				<option value="hybrid">Hybrid</option>
				<option value="local">Local</option>
				<option value="global">Global</option>
				<option value="naive">Naive</option>
			</select>
			<input
				type="text"
				x-model="queryText"
				@keydown.enter="submitQuery()"
				placeholder="Ask the knowledge base..."
				class="flex-1 rounded-lg border bg-background px-4 py-2 text-sm focus:ring-2 focus:ring-primary outline-none"
			/>
			<button
				@click="submitQuery()"
				:disabled="querying || !queryText.trim()"
				class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors disabled:opacity-50"
			>
				<span x-show="!querying">Query</span>
				<span x-show="querying" class="animate-pulse">Querying...</span>
			</button>
		</div>
		<div x-show="queryResult" class="rounded-xl border bg-card p-5 shadow-sm">
			<h3 class="text-sm font-semibold text-muted-foreground mb-2">Response</h3>
			<div class="prose dark:prose-invert prose-sm max-w-none" x-html="queryResult"></div>
		</div>
		<div x-show="queryError" class="rounded-xl border border-destructive/50 bg-destructive/5 p-4">
			<p class="text-sm text-destructive" x-text="queryError"></p>
		</div>
	</div>
}

templ maintenanceTab() {
	<div class="grid md:grid-cols-2 gap-6 max-w-3xl">
		<div class="rounded-xl border bg-card p-5 shadow-sm space-y-3">
			<h3 class="font-semibold">Clear All Documents</h3>
			<p class="text-sm text-muted-foreground">Permanently removes all documents and their chunks from the knowledge base.</p>
			<button
				@click="if(confirm('Are you sure? This will delete ALL documents.')) clearAllDocs()"
				class="rounded-lg bg-destructive px-4 py-2 text-sm font-medium text-destructive-foreground shadow-sm hover:bg-destructive/90 transition-colors"
			>Clear All Documents</button>
		</div>
		<div class="rounded-xl border bg-card p-5 shadow-sm space-y-3">
			<h3 class="font-semibold">Clear LLM Cache</h3>
			<p class="text-sm text-muted-foreground">Removes cached LLM responses. New queries will call the LLM fresh.</p>
			<button
				@click="if(confirm('Clear all cached LLM responses?')) clearCache()"
				class="rounded-lg border px-4 py-2 text-sm font-medium shadow-sm hover:bg-muted transition-colors"
			>Clear Cache</button>
		</div>
	</div>
}

templ dashboardScript() {
	<script>
		function lightragDashboard() {
			const basePath = '/api/lightrag';
			return {
				activeTab: 'overview',
				// Overview
				statusCounts: {},
				health: {},
				// Documents
				documents: [],
				docPagination: { page: 1, total_pages: 1, total: 0 },
				uploading: false,
				uploadScope: 'public',
				currentPath: '', // Current directory path (e.g. "folder/subfolder/")
				
				// Pipeline
				indexing: false,
				pipelineResult: null,
				// Query
				queryMode: 'hybrid',
				queryText: '',
				queryResult: '',
				queryError: '',
				querying: false,
				// Toast
				toast: '',
				toastType: 'success',

				get pathParts() {
					if (!this.currentPath) return [];
					const parts = this.currentPath.replace(/\/$/, '').split('/');
					let acc = '';
					return parts.map(p => {
						acc += p + '/';
						return { name: p, path: acc };
					});
				},

				async init() {
					await this.refresh();
				},

				async refresh() {
					await Promise.all([
						this.loadStatusCounts(),
						this.loadHealth(),
						this.loadDocuments(1),
					]);
				},

				async api(path, opts = {}) {
					const resp = await fetch(basePath + path, {
						headers: { 'Content-Type': 'application/json', ...opts.headers },
						...opts,
					});
					if (!resp.ok) {
						const body = await resp.text();
						throw new Error(body || resp.statusText);
					}
					return resp.json();
				},

				async loadStatusCounts() {
					try {
						const data = await this.api('/documents/status-counts');
						this.statusCounts = data.status_counts || {};
					} catch (e) { console.error('status counts:', e); }
				},

				async loadHealth() {
					try {
						this.health = await this.api('/health');
					} catch (e) { console.error('health:', e); }
				},

				async loadDocuments(page) {
					try {
						const url = '/documents?page=' + page + '&page_size=20' 
							+ '&scope=' + this.uploadScope 
							+ '&prefix=' + encodeURIComponent(this.currentPath);
						const data = await this.api(url);
						this.documents = data.documents || [];
						this.docPagination = { page: data.page, total_pages: data.total_pages, total: data.total };
					} catch (e) { console.error('documents:', e); }
				},
				
				async navigateTo(path) {
					this.currentPath = path;
					await this.loadDocuments(1);
				},

				async navigateUp() {
					// Remove last segment
					if (!this.currentPath) return;
					const parts = this.currentPath.replace(/\/$/, '').split('/');
					parts.pop();
					this.currentPath = parts.length > 0 ? parts.join('/') + '/' : '';
					await this.loadDocuments(1);
				},

				async createFolder() {
					const name = prompt("Enter folder name:");
					if (!name) return;
					
					try {
						const fullPath = this.currentPath + name + '/';
						await this.api('/documents/folder', {
							method: 'POST',
							body: JSON.stringify({ path: fullPath, scope: this.uploadScope })
						});
						this.showToast('Folder created');
						await this.refresh();
					} catch (e) {
						this.showToast(e.message, 'error');
					}
				},

				async uploadFile(event) {
					const files = event.target.files;
					if (!files || files.length === 0) return;
					
					this.uploading = true;
					try {
						const form = new FormData();
						for (let i = 0; i < files.length; i++) {
							form.append('file', files[i]);
						}
						form.append('scope', this.uploadScope);
						form.append('path', this.currentPath);
						
						const resp = await fetch(basePath + '/documents/upload', { method: 'POST', body: form });
						if (!resp.ok) {
							const body = await resp.json().catch(() => ({}));
							throw new Error(body.error || resp.statusText);
						}
						
						const result = await resp.json();
						if (result.status === 'partial_success' && result.errors) {
							this.showToast('Uploaded with errors: ' + result.errors.length + ' failed', 'error');
						} else if (result.status === 'failure') {
							throw new Error(result.message || 'Upload failed');
						} else {
							this.showToast('File(s) uploaded');
						}
						
						await this.refresh();
					} catch (e) {
						this.showToast(e.message, 'error');
					} finally {
						this.uploading = false;
						event.target.value = '';
					}
				},

				async ingestDoc(id) {
					try {
						await this.api('/documents/ingest', { 
							method: 'POST',
							body: JSON.stringify({ files: [id], scope: this.uploadScope }) 
						});
						this.showToast('Document queued for ingestion');
						await this.refresh();
					} catch (e) {
						this.showToast(e.message, 'error');
					}
				},

				async deleteDoc(doc) {
					const msg = doc.is_dir ? 'Are you sure you want to delete this folder and all its contents?' : 'Delete this document?';
					if (!confirm(msg)) return;
					try {
						await this.api('/documents/' + encodeURIComponent(doc.id) + '?scope=' + this.uploadScope, { method: 'DELETE' });
						await this.refresh();
						this.showToast(doc.is_dir ? 'Folder deleted' : 'Document deleted');
					} catch (e) {
						this.showToast(e.message, 'error');
					}
				},

				async runPipeline() {
					this.indexing = true;
					this.pipelineResult = null;
					try {
						const result = await this.api('/pipeline/index', { method: 'POST' });
						this.pipelineResult = result;
						// await this.refresh(); // Indexing is async in backend usually, or waits? 
						// Handler waits for result.
						if (result.processed > 0) {
							this.showToast(result.processed + ' document(s) indexed');
						} else if (result.failed > 0) {
							this.showToast(result.failed + ' document(s) failed', 'error');
						} else {
							this.showToast('Pipeline finished');
						}
						// Refresh to update statuses
						await this.refresh();
					} catch (e) {
						this.showToast(e.message, 'error');
					} finally {
						this.indexing = false;
					}
				},

				async submitQuery() {
					if (!this.queryText.trim()) return;
					this.querying = true;
					this.queryResult = '';
					this.queryError = '';
					try {
						const data = await this.api('/query', {
							method: 'POST',
							body: JSON.stringify({ query: this.queryText, mode: this.queryMode }),
						});
						this.queryResult = data.response || '(empty response)';
					} catch (e) {
						this.queryError = e.message;
					} finally {
						this.querying = false;
					}
				},

				async clearAllDocs() {
					try {
						await this.api('/documents', { method: 'DELETE' });
						await this.refresh();
						this.showToast('All documents cleared');
					} catch (e) {
						this.showToast(e.message, 'error');
					}
				},

				async clearCache() {
					try {
						await this.api('/documents/clear-cache', { method: 'POST' });
						this.showToast('LLM cache cleared');
					} catch (e) {
						this.showToast(e.message, 'error');
					}
				},

				showToast(msg, type = 'success') {
					this.toast = msg;
					this.toastType = type;
					setTimeout(() => { this.toast = ''; }, 3000);
				},

				formatDate(s) {
					if (!s) return '-';
					try { return new Date(s).toLocaleDateString() + ' ' + new Date(s).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}); } catch { return s; }
				},

				formatBytes(n) {
					if (!n) return '-';
					if (n < 1024) return n + ' B';
					if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
					return (n / (1024 * 1024)).toFixed(1) + ' MB';
				},
			};
		}
	</script>
}
