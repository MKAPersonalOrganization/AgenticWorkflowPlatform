package lightrag

import "school-with-ai/domain"

type DashboardProps struct {
	User *domain.User
}

templ Dashboard(props DashboardProps) {
	@Layout(LayoutProps{
		Title: "Drive",
		User:  props.User,
	}) {
		<div
			x-data="driveApp()"
			x-init="init()"
			class="flex h-full bg-white dark:bg-gray-950"
			@dragover.prevent="dragOver = true"
			@dragleave.prevent="dragOver = false"
			@drop.prevent="handleDrop($event)"
		>
			<!-- Sidebar -->
			@driveSidebar()
			<!-- Main Content -->
			<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
				@driveToolbar()
				@driveContent()
			</div>
			<!-- Context Menu -->
			@driveContextMenu()
			<!-- Rename Dialog -->
			@renameDialog()
			<!-- Move Dialog -->
			@moveDialog()
			<!-- Drop Overlay -->
			<div
				x-show="dragOver"
				x-transition.opacity
				class="fixed inset-0 z-50 bg-blue-500/10 border-4 border-dashed border-blue-500 rounded-xl flex items-center justify-center pointer-events-none"
			>
				<div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl px-12 py-8 text-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-3 text-blue-500"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
					<p class="text-lg font-semibold text-gray-800 dark:text-gray-200">Drop files to upload</p>
				</div>
			</div>
			<!-- Toast -->
			<div
				x-show="toast"
				x-transition
				class="fixed bottom-6 right-6 rounded-lg shadow-lg px-4 py-3 text-sm font-medium z-[100]"
				:class="toastType === 'error' ? 'bg-red-600 text-white' : 'bg-gray-800 text-white dark:bg-gray-100 dark:text-gray-900'"
				x-text="toast"
			></div>
		</div>
		@driveScript()
	}
}

templ driveSidebar() {
	<aside class="w-64 border-r border-gray-200 dark:border-gray-800 flex flex-col bg-gray-50/50 dark:bg-gray-900/50 shrink-0">
		<!-- Logo -->
		<div class="px-5 py-4 flex items-center gap-3">
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-blue-600"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
			<span class="text-lg font-semibold text-gray-900 dark:text-white">Drive</span>
		</div>
		<!-- New Button -->
		<div class="px-3 mb-3">
			<div x-data="{open:false}" class="relative">
				<button @click="open=!open" class="w-full flex items-center gap-3 px-5 py-3 rounded-2xl shadow-md bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow text-sm font-medium text-gray-700 dark:text-gray-200">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
					New
				</button>
				<div x-show="open" @click.away="open=false" x-transition class="absolute left-0 top-full mt-1 w-52 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 py-1 z-50">
					<button @click="open=false; createFolder()" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path><line x1="12" y1="10" x2="12" y2="16"></line><line x1="9" y1="13" x2="15" y2="13"></line></svg>
						New folder
					</button>
					<hr class="my-1 border-gray-200 dark:border-gray-700"/>
					<label class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
						File upload
						<input type="file" class="hidden" @change="uploadFile($event)" multiple/>
					</label>
				</div>
			</div>
		</div>
		<!-- Nav Items -->
		<nav class="flex-1 px-3 space-y-0.5 overflow-y-auto">
			<button @click="switchView('drive')" class="w-full flex items-center gap-3 px-4 py-2 rounded-full text-sm font-medium transition-colors" :class="currentView === 'drive' ? 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-200/60 dark:hover:bg-gray-800'">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
				My Drive
			</button>
			<button @click="switchView('recent')" class="w-full flex items-center gap-3 px-4 py-2 rounded-full text-sm font-medium transition-colors" :class="currentView === 'recent' ? 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-200/60 dark:hover:bg-gray-800'">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
				Recent
			</button>
			<button @click="switchView('trash')" class="w-full flex items-center gap-3 px-4 py-2 rounded-full text-sm font-medium transition-colors" :class="currentView === 'trash' ? 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-200/60 dark:hover:bg-gray-800'">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
				Trash
			</button>
		</nav>
		<!-- Storage -->
		<div class="px-5 py-4 border-t border-gray-200 dark:border-gray-800">
			<div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>
				<span x-text="totalDocs + ' items'">0 items</span>
			</div>
		</div>
	</aside>
}

templ driveToolbar() {
	<div class="flex items-center gap-3 px-6 py-3 border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 shrink-0">
		<!-- Breadcrumbs -->
		<nav class="flex items-center gap-1 text-sm flex-1 min-w-0 overflow-x-auto" x-show="currentView === 'drive'">
			<button @click="navigateTo('')" class="shrink-0 px-2 py-1 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 font-medium text-gray-700 dark:text-gray-200 transition-colors">My Drive</button>
			<template x-for="(part, i) in pathParts" :key="i">
				<div class="flex items-center shrink-0">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-400"><path d="m9 18 6-6-6-6"></path></svg>
					<button @click="navigateTo(part.path)" class="px-2 py-1 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 font-medium text-gray-700 dark:text-gray-200 transition-colors" x-text="part.name"></button>
				</div>
			</template>
		</nav>
		<span x-show="currentView === 'recent'" class="text-sm font-medium text-gray-700 dark:text-gray-200 flex-1">Recent</span>
		<span x-show="currentView === 'trash'" class="text-sm font-medium text-gray-700 dark:text-gray-200 flex-1">Trash</span>
		<span x-show="currentView === 'search'" class="text-sm font-medium text-gray-700 dark:text-gray-200 flex-1">Search results</span>
		<!-- Search -->
		<div class="relative w-72">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
			<input
				type="text"
				x-model="searchQuery"
				@input.debounce.300ms="performSearch()"
				@keydown.escape="searchQuery=''; if(currentView==='search') switchView('drive')"
				placeholder="Search in Drive"
				class="w-full pl-9 pr-3 py-2 rounded-full bg-gray-100 dark:bg-gray-800 border-0 text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-gray-900 outline-none transition-colors"
			/>
		</div>
		<!-- View Toggle -->
		<div class="flex items-center border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden" x-show="currentView !== 'search'">
			<button @click="viewMode='grid'" class="p-2 transition-colors" :class="viewMode==='grid' ? 'bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white' : 'text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800'">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>
			</button>
			<button @click="viewMode='list'" class="p-2 transition-colors" :class="viewMode==='list' ? 'bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white' : 'text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800'">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
			</button>
		</div>
		<!-- Sort -->
		<div x-data="{open:false}" class="relative" x-show="currentView !== 'search'">
			<button @click="open=!open" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 16 4 4 4-4"></path><path d="M7 20V4"></path><path d="m21 8-4-4-4 4"></path><path d="M17 4v16"></path></svg>
			</button>
			<div x-show="open" @click.away="open=false" x-transition class="absolute right-0 top-full mt-1 w-44 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 py-1 z-50">
				<button @click="sortBy='name'; open=false; loadDocuments(1)" class="w-full px-4 py-2 text-sm text-left hover:bg-gray-100 dark:hover:bg-gray-700" :class="sortBy==='name' ? 'text-blue-600 font-medium' : 'text-gray-700 dark:text-gray-200'">Name</button>
				<button @click="sortBy='updated'; open=false; loadDocuments(1)" class="w-full px-4 py-2 text-sm text-left hover:bg-gray-100 dark:hover:bg-gray-700" :class="sortBy==='updated' ? 'text-blue-600 font-medium' : 'text-gray-700 dark:text-gray-200'">Last modified</button>
				<button @click="sortBy='size'; open=false; loadDocuments(1)" class="w-full px-4 py-2 text-sm text-left hover:bg-gray-100 dark:hover:bg-gray-700" :class="sortBy==='size' ? 'text-blue-600 font-medium' : 'text-gray-700 dark:text-gray-200'">File size</button>
			</div>
		</div>
		<!-- Trash actions -->
		<template x-if="currentView === 'trash' && documents.length > 0">
			<button @click="emptyTrash()" class="px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors">Empty trash</button>
		</template>
	</div>
}

templ driveContent() {
	<div class="flex-1 overflow-y-auto px-6 py-4">
		<!-- Loading -->
		<div x-show="loading" class="flex items-center justify-center py-20">
			<svg class="animate-spin h-8 w-8 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
		</div>
		<!-- Empty State -->
		<div x-show="!loading && documents.length === 0" class="flex flex-col items-center justify-center py-20 text-gray-400">
			<template x-if="currentView === 'trash'">
				<div class="text-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="mx-auto mb-4 text-gray-300"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
					<p class="text-lg font-medium text-gray-500">Trash is empty</p>
				</div>
			</template>
			<template x-if="currentView !== 'trash'">
				<div class="text-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="mx-auto mb-4 text-gray-300"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
					<p class="text-lg font-medium text-gray-500 mb-1">No files here</p>
					<p class="text-sm">Drop files here or use the "New" button</p>
				</div>
			</template>
		</div>
		<!-- Grid View -->
		<div x-show="!loading && documents.length > 0 && viewMode === 'grid'" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
			<template x-for="doc in documents" :key="doc.id">
				<div
					@click="handleItemClick($event, doc)"
					@dblclick="openItem(doc)"
					@contextmenu.prevent="showContextMenu($event, doc)"
					class="group rounded-xl border border-transparent p-3 cursor-pointer transition-all duration-150 select-none"
					:class="isSelected(doc.id) ? 'bg-blue-50 dark:bg-blue-900/30 border-blue-300 dark:border-blue-700 ring-1 ring-blue-300 dark:ring-blue-700' : 'hover:bg-gray-50 dark:hover:bg-gray-900 hover:border-gray-200 dark:hover:border-gray-800'"
				>
					<!-- Icon -->
					<div class="flex items-center justify-center h-28 rounded-lg mb-2" :class="doc.is_dir ? 'bg-gray-50 dark:bg-gray-800/50' : 'bg-gray-100 dark:bg-gray-800'">
						<template x-if="doc.is_dir">
							<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="text-blue-100 dark:text-blue-900/50 stroke-blue-500 stroke-[1.5]"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
						</template>
						<template x-if="!doc.is_dir">
							<div class="flex flex-col items-center">
								<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" :class="getFileColor(doc.display_name)"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								<span class="text-[10px] font-bold uppercase mt-1" :class="getFileColor(doc.display_name)" x-text="getFileExt(doc.display_name)"></span>
							</div>
						</template>
					</div>
					<!-- Name -->
					<p class="text-sm font-medium text-gray-800 dark:text-gray-200 truncate" x-text="doc.display_name" :title="doc.display_name"></p>
					<p class="text-xs text-gray-400 mt-0.5" x-text="doc.is_dir ? '' : formatBytes(doc.size)"></p>
				</div>
			</template>
		</div>
		<!-- List View -->
		<div x-show="!loading && documents.length > 0 && viewMode === 'list'" class="rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50">
						<th class="text-left p-3 font-medium text-gray-500 dark:text-gray-400 w-12"></th>
						<th class="text-left p-3 font-medium text-gray-500 dark:text-gray-400">Name</th>
						<th class="text-left p-3 font-medium text-gray-500 dark:text-gray-400 hidden md:table-cell">Last modified</th>
						<th class="text-left p-3 font-medium text-gray-500 dark:text-gray-400 hidden md:table-cell">File size</th>
						<th class="w-12"></th>
					</tr>
				</thead>
				<tbody>
					<template x-for="doc in documents" :key="doc.id">
						<tr
							@click="handleItemClick($event, doc)"
							@dblclick="openItem(doc)"
							@contextmenu.prevent="showContextMenu($event, doc)"
							class="border-b border-gray-100 dark:border-gray-800/50 last:border-0 cursor-pointer transition-colors select-none"
							:class="isSelected(doc.id) ? 'bg-blue-50 dark:bg-blue-900/20' : 'hover:bg-gray-50 dark:hover:bg-gray-900/30'"
						>
							<td class="p-3 text-center">
								<template x-if="doc.is_dir">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-blue-100 dark:text-blue-900/50 stroke-blue-500 stroke-[1.5]"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
								</template>
								<template x-if="!doc.is_dir">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" :class="getFileColor(doc.display_name)"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								</template>
							</td>
							<td class="p-3">
								<span class="font-medium text-gray-800 dark:text-gray-200" x-text="doc.display_name"></span>
							</td>
							<td class="p-3 hidden md:table-cell text-gray-500" x-text="formatDate(doc.updated_at)"></td>
							<td class="p-3 hidden md:table-cell text-gray-500" x-text="doc.is_dir ? '—' : formatBytes(doc.size)"></td>
							<td class="p-3">
								<button @click.stop="showContextMenu($event, doc)" class="p-1 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
								</button>
							</td>
						</tr>
					</template>
				</tbody>
			</table>
		</div>
		<!-- Pagination -->
		<div x-show="pagination.total_pages > 1" class="flex items-center justify-center gap-2 mt-6 pb-4">
			<button @click="loadDocuments(pagination.page - 1)" :disabled="pagination.page <= 1" class="px-4 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-40 transition-colors">Previous</button>
			<span class="text-sm text-gray-500 px-3" x-text="pagination.page + ' / ' + pagination.total_pages"></span>
			<button @click="loadDocuments(pagination.page + 1)" :disabled="pagination.page >= pagination.total_pages" class="px-4 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-40 transition-colors">Next</button>
		</div>
	</div>
}

templ driveContextMenu() {
	<div
		x-show="ctxMenu.show"
		@click.away="ctxMenu.show=false"
		x-transition
		class="fixed bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 py-1 w-52 z-[90]"
		:style="'left:'+ctxMenu.x+'px; top:'+ctxMenu.y+'px'"
	>
		<template x-if="ctxMenu.doc && ctxMenu.doc.is_dir && currentView !== 'trash'">
			<button @click="openItem(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
				Open
			</button>
		</template>
		<template x-if="ctxMenu.doc && !ctxMenu.doc.is_dir && currentView !== 'trash'">
			<button @click="downloadDoc(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
				Download
			</button>
		</template>
		<template x-if="currentView !== 'trash'">
			<div>
				<hr class="my-1 border-gray-200 dark:border-gray-700"/>
				<button @click="startRename(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
					Rename
				</button>
				<button @click="startMove(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path><path d="M12 10v6"></path><path d="m15 13-3 3-3-3"></path></svg>
					Move to
				</button>
				<hr class="my-1 border-gray-200 dark:border-gray-700"/>
				<button @click="trashDoc(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
					Move to trash
				</button>
			</div>
		</template>
		<template x-if="currentView === 'trash'">
			<div>
				<button @click="restoreDoc(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
					Restore
				</button>
				<button @click="permanentDelete(ctxMenu.doc); ctxMenu.show=false" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
					Delete forever
				</button>
			</div>
		</template>
	</div>
}

templ renameDialog() {
	<div x-show="renameModal.show" class="fixed inset-0 z-[80] flex items-center justify-center bg-black/40" @click.self="renameModal.show=false">
		<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-96 p-6" x-transition>
			<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Rename</h3>
			<input
				type="text"
				x-model="renameModal.newName"
				@keydown.enter="confirmRename()"
				class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
				x-ref="renameInput"
			/>
			<div class="flex justify-end gap-2 mt-5">
				<button @click="renameModal.show=false" class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">Cancel</button>
				<button @click="confirmRename()" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">Rename</button>
			</div>
		</div>
	</div>
}

templ moveDialog() {
	<div x-show="moveModal.show" class="fixed inset-0 z-[80] flex items-center justify-center bg-black/40" @click.self="moveModal.show=false">
		<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-96 p-6" x-transition>
			<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Move to</h3>
			<div class="border border-gray-200 dark:border-gray-700 rounded-lg max-h-64 overflow-y-auto">
				<button @click="moveModal.targetFolder=''" class="w-full flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" :class="moveModal.targetFolder === '' ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-600' : 'text-gray-700 dark:text-gray-200'">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
					My Drive (root)
				</button>
				<template x-for="folder in moveModal.folders" :key="folder.id">
					<button @click="moveModal.targetFolder=folder.name" class="w-full flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" :class="moveModal.targetFolder === folder.name ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-600' : 'text-gray-700 dark:text-gray-200'">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-blue-100 stroke-blue-500 stroke-[1.5]"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
						<span x-text="folder.display_name"></span>
					</button>
				</template>
			</div>
			<div class="flex justify-end gap-2 mt-5">
				<button @click="moveModal.show=false" class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">Cancel</button>
				<button @click="confirmMove()" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">Move</button>
			</div>
		</div>
	</div>
}

templ driveScript() {
	<script>
	function driveApp() {
		const B = '/api/lightrag';
		return {
			currentView: 'drive', viewMode: 'grid', sortBy: 'name',
			currentPath: '', documents: [], loading: false,
			pagination: {page:1,total_pages:1,total:0},
			selectedIds: [], lastClickedId: null,
			searchQuery: '', dragOver: false,
			toast: '', toastType: 'success', totalDocs: 0,
			ctxMenu: {show:false, x:0, y:0, doc:null},
			renameModal: {show:false, doc:null, newName:''},
			moveModal: {show:false, doc:null, targetFolder:'', folders:[]},

			get pathParts() {
				if (!this.currentPath) return [];
				const parts = this.currentPath.replace(/\/$/, '').split('/');
				let acc = '';
				return parts.map(p => { acc += p + '/'; return {name:p, path:acc}; });
			},

			async init() { await this.loadDocuments(1); },

			async api(path, opts={}) {
				const r = await fetch(B+path, {headers:{'Content-Type':'application/json',...opts.headers},...opts});
				if (!r.ok) { const b = await r.text(); throw new Error(b||r.statusText); }
				return r.json();
			},

			switchView(v) {
				this.currentView = v;
				this.selectedIds = [];
				if (v === 'drive') { this.loadDocuments(1); }
				else if (v === 'trash') { this.loadTrash(1); }
				else if (v === 'recent') { this.loadDocuments(1); }
			},

			async loadDocuments(page) {
				this.loading = true;
				try {
					const url = '/documents?page='+page+'&page_size=50&parent_path='+encodeURIComponent(this.currentPath)+'&scope=public';
					const d = await this.api(url);
					this.documents = d.documents||[];
					this.pagination = {page:d.page,total_pages:d.total_pages,total:d.total};
					this.totalDocs = d.total;
				} catch(e) { console.error(e); }
				finally { this.loading = false; }
			},

			async loadTrash(page) {
				this.loading = true;
				try {
					const d = await this.api('/documents/trash?page='+page+'&page_size=50&scope=public');
					this.documents = d.documents||[];
					this.pagination = {page:d.page,total_pages:d.total_pages,total:d.total};
				} catch(e) { console.error(e); }
				finally { this.loading = false; }
			},

			async performSearch() {
				if (!this.searchQuery.trim()) { if(this.currentView==='search') this.switchView('drive'); return; }
				this.currentView = 'search'; this.loading = true;
				try {
					const d = await this.api('/documents/search?q='+encodeURIComponent(this.searchQuery)+'&scope=public');
					this.documents = d.documents||[];
					this.pagination = {page:d.page,total_pages:d.total_pages,total:d.total};
				} catch(e) { console.error(e); }
				finally { this.loading = false; }
			},

			navigateTo(path) { this.currentPath = path; this.selectedIds=[]; this.loadDocuments(1); },

			openItem(doc) {
				if (doc.is_dir) { this.currentPath = doc.name; if(!this.currentPath.endsWith('/')) this.currentPath+='/'; this.selectedIds=[]; this.loadDocuments(1); }
				else { this.downloadDoc(doc); }
			},

			handleItemClick(e, doc) {
				if (e.shiftKey && this.lastClickedId) {
					const ids = this.documents.map(d=>d.id);
					const a = ids.indexOf(this.lastClickedId), b = ids.indexOf(doc.id);
					const [s,en] = a<b?[a,b]:[b,a];
					this.selectedIds = ids.slice(s, en+1);
				} else if (e.ctrlKey || e.metaKey) {
					const i = this.selectedIds.indexOf(doc.id);
					if (i>=0) this.selectedIds.splice(i,1); else this.selectedIds.push(doc.id);
				} else {
					this.selectedIds = [doc.id];
				}
				this.lastClickedId = doc.id;
			},

			isSelected(id) { return this.selectedIds.includes(id); },

			showContextMenu(e, doc) {
				if (!this.isSelected(doc.id)) this.selectedIds = [doc.id];
				this.ctxMenu = {show:true, x:Math.min(e.clientX, window.innerWidth-220), y:Math.min(e.clientY, window.innerHeight-200), doc};
			},

			async createFolder() {
				const name = prompt('Enter folder name:');
				if (!name) return;
				try {
					await this.api('/documents/folder', {method:'POST', body:JSON.stringify({name, parent_path:this.currentPath, scope:'public'})});
					this.showToast('Folder created');
					await this.loadDocuments(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async uploadFile(event) {
				const files = event.target.files;
				if (!files || !files.length) return;
				try {
					const form = new FormData();
					for (let f of files) form.append('file', f);
					form.append('scope', 'public');
					form.append('parent_path', this.currentPath);
					const r = await fetch(B+'/documents/upload', {method:'POST', body:form});
					const result = await r.json();
					this.showToast(result.message || 'Uploaded');
					await this.loadDocuments(1);
				} catch(e) { this.showToast(e.message, 'error'); }
				finally { event.target.value = ''; }
			},

			async handleDrop(e) {
				this.dragOver = false;
				const files = e.dataTransfer?.files;
				if (!files || !files.length) return;
				try {
					const form = new FormData();
					for (let f of files) form.append('file', f);
					form.append('scope', 'public');
					form.append('parent_path', this.currentPath);
					const r = await fetch(B+'/documents/upload', {method:'POST', body:form});
					const result = await r.json();
					this.showToast(result.message || 'Uploaded');
					await this.loadDocuments(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			downloadDoc(doc) {
				window.open(B+'/documents/'+doc.id+'/download?scope=public', '_blank');
			},

			startRename(doc) {
				this.renameModal = {show:true, doc, newName: doc.display_name};
				this.$nextTick(() => { if(this.$refs.renameInput) this.$refs.renameInput.select(); });
			},

			async confirmRename() {
				if (!this.renameModal.newName.trim()) return;
				try {
					await this.api('/documents/'+this.renameModal.doc.id+'/rename?scope=public', {method:'POST', body:JSON.stringify({new_name:this.renameModal.newName})});
					this.renameModal.show = false;
					this.showToast('Renamed');
					await this.loadDocuments(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async startMove(doc) {
				try {
					const d = await this.api('/documents?parent_path=&scope=public&page_size=100');
					this.moveModal = {show:true, doc, targetFolder:'', folders: (d.documents||[]).filter(f=>f.is_dir && f.id!==doc.id)};
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async confirmMove() {
				try {
					await this.api('/documents/'+this.moveModal.doc.id+'/move?scope=public', {method:'POST', body:JSON.stringify({target_folder:this.moveModal.targetFolder})});
					this.moveModal.show = false;
					this.showToast('Moved');
					await this.loadDocuments(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async trashDoc(doc) {
				try {
					await this.api('/documents/'+doc.id+'/trash?scope=public', {method:'POST'});
					this.showToast('Moved to trash');
					await this.loadDocuments(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async restoreDoc(doc) {
				try {
					await this.api('/documents/'+doc.id+'/restore?scope=public', {method:'POST'});
					this.showToast('Restored');
					await this.loadTrash(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async permanentDelete(doc) {
				if (!confirm('Delete forever? This cannot be undone.')) return;
				try {
					await this.api('/documents/'+doc.id+'?scope=public', {method:'DELETE'});
					this.showToast('Deleted permanently');
					await this.loadTrash(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			async emptyTrash() {
				if (!confirm('Empty trash? All items will be permanently deleted.')) return;
				try {
					await this.api('/documents/trash?scope=public', {method:'DELETE'});
					this.showToast('Trash emptied');
					await this.loadTrash(1);
				} catch(e) { this.showToast(e.message, 'error'); }
			},

			showToast(msg, type='success') { this.toast=msg; this.toastType=type; setTimeout(()=>{this.toast='';},3000); },
			formatDate(s) { if(!s) return '—'; try{const d=new Date(s); return d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});}catch{return s;} },
			formatBytes(n) { if(!n) return '—'; if(n<1024) return n+' B'; if(n<1048576) return (n/1024).toFixed(1)+' KB'; return (n/1048576).toFixed(1)+' MB'; },
			getFileExt(name) { if(!name) return ''; const p=name.lastIndexOf('.'); return p>=0?name.slice(p+1).toUpperCase():''; },
			getFileColor(name) {
				const ext = this.getFileExt(name).toLowerCase();
				const colors = {pdf:'text-red-500',doc:'text-blue-600',docx:'text-blue-600',xls:'text-green-600',xlsx:'text-green-600',ppt:'text-orange-500',pptx:'text-orange-500',jpg:'text-purple-500',jpeg:'text-purple-500',png:'text-purple-500',gif:'text-purple-500',svg:'text-purple-500',mp4:'text-pink-500',mp3:'text-pink-500',zip:'text-yellow-600',rar:'text-yellow-600',py:'text-blue-400',go:'text-cyan-500',js:'text-yellow-400',ts:'text-blue-500',html:'text-orange-500',css:'text-blue-400',json:'text-gray-500',md:'text-gray-600',txt:'text-gray-500',csv:'text-green-500',yaml:'text-red-400',yml:'text-red-400'};
				return colors[ext]||'text-gray-400';
			},
		};
	}
	</script>
}
