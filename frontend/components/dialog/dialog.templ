type contextKey string

const (
	openKey contextKey = "dialogOpen"
)

type Props struct {
	ID               string
	Class            string
	Attributes       templ.Attributes
	DisableClickAway bool
	DisableESC       bool
	Open             bool
}

type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string // Dialog root ID for external triggers
}

type ContentProps struct {
	Class           string
	PanelClass      string // Overrides the inner panel classes (default: "relative flex flex-col gap-4 p-6 min-h-0 grow")
	Attributes      templ.Attributes
	HideCloseButton bool
}

type CloseProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string // Dialog root ID to close (optional, defaults to closest dialog)
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ Dialog(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ ctx = context.WithValue(ctx, openKey, p.Open) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-dialog
		if p.DisableClickAway {
			data-tui-dialog-disable-click-away="true"
		}
		if p.DisableESC {
			data-tui-dialog-disable-esc="true"
		}
		data-tui-dialog-open={ utils.IfElse(p.Open, "true", "false") }
		class={ utils.TwMerge("contents", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-dialog-trigger
		if p.For != "" {
			data-tui-dialog-target={ p.For }
		}
		data-tui-dialog-trigger-open="false"
		class={ utils.TwMerge("contents", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ open := false }}
	if val := ctx.Value(openKey); val != nil {
		{{ open = val.(bool) }}
	}
	<dialog
		class={
			utils.TwMerge(
				// Positioning & sizing
				"fixed left-[50%] top-[50%] z-50 m-0 w-full max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 overflow-hidden outline-none sm:max-w-lg",
				// Surface — elevated card with subtle border
				"bg-card text-card-foreground border border-border/60 p-0",
				// Premium radius + layered shadow from the theme's modern shadow system
				"rounded-xl shadow-modern-xl",
				// Visibility (templui state-driven)
				"[&:not([open]):not([data-tui-dialog-closing=true])]:hidden",
				// Backdrop — blurred cinematic scrim
				"[&::backdrop]:transition-all [&::backdrop]:duration-300 [&::backdrop]:ease-out",
				"data-[tui-dialog-open=false]:[&::backdrop]:bg-black/0",
				"data-[tui-dialog-open=false]:[&::backdrop]:backdrop-blur-none",
				"data-[tui-dialog-open=true]:[&::backdrop]:bg-black/50",
				"data-[tui-dialog-open=true]:[&::backdrop]:backdrop-blur-sm",
				// Enter/exit — smoother premium easing with subtle scale
				"transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]",
				"data-[tui-dialog-open=false]:scale-[0.98]",
				"data-[tui-dialog-open=true]:scale-100",
				"data-[tui-dialog-open=false]:opacity-0",
				"data-[tui-dialog-open=true]:opacity-100",
				p.Class,
			),
		}
		data-tui-dialog-content
		data-tui-dialog-open={ utils.IfElse(open, "true", "false") }
		data-tui-dialog-initial-open={ utils.IfElse(open, "true", "false") }
		{ p.Attributes... }
	>
		<div class={ utils.TwMerge("relative flex flex-col gap-4 p-6 min-h-0 grow", p.PanelClass) } data-tui-dialog-panel>
			{ children... }
			if !p.HideCloseButton {
				<button
					class={ utils.TwMerge(
							// Positioning & proper click target
							"absolute top-3 right-3",
							"size-8 inline-flex items-center justify-center",
							// Surface & radius matching the premium card
							"rounded-md text-muted-foreground",
							// Smooth hover treatment
							"transition-all duration-200 ease-out",
							"hover:bg-accent hover:text-foreground",
							// Focus states
							"focus:outline-none focus:ring-2",
							"focus:ring-ring focus:ring-offset-2",
							"ring-offset-background",
							// Disabled state
							"disabled:pointer-events-none",
							// Icon styles
							"[&_svg]:pointer-events-none",
						"[&_svg]:shrink-0",
						"[&_svg:not([class*='size-'])]:size-4",
					) }
					data-tui-dialog-close
					aria-label="Close"
					type="button"
				>
					@icon.X()
					<span class="sr-only">Close</span>
				</button>
			}
		</div>
	</dialog>
}

templ Close(props ...CloseProps) {
