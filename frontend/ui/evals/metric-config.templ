package evals

import (
	"aicompass/frontend/components/badge"
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
)

templ MetricConfigDialog() {
	<div
		x-data="metricConfigDialog"
		@open-metric-config.window="open()"
	>
		@dialog.Dialog(dialog.Props{ID: "metric-config-dialog"}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-3xl max-h-[85vh] flex flex-col p-0 overflow-hidden",
			}) {
				<div class="flex flex-col h-full max-h-[85vh]">
					<!-- Header -->
					@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-0 border-b border-border"}) {
						<div class="flex items-center justify-between mb-3">
							<div>
								@dialog.Title() {
									{ i18n.T(ctx, "Evaluation Metrics") }
								}
								@dialog.Description() {
									{ i18n.T(ctx, "Select metrics and configure thresholds.") }
								}
							</div>
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>

						<!-- Profile Selector -->
						<div class="flex items-center gap-2 pb-3">
							<select
								x-model="selectedProfileId"
								@change="onProfileChange()"
								class="flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							>
								<option value="">{ i18n.T(ctx, "New Profile...") }</option>
								<template x-for="p in profiles" :key="p.id">
									<option :value="p.id" x-text="p.name + (p.is_default ? ' (default)' : '')"></option>
								</template>
							</select>
							<template x-if="selectedProfileId">
								@button.Button(button.Props{
									Size:    button.SizeSm,
									Variant: button.VariantOutline,
									Attributes: templ.Attributes{
										"@click": "saveProfile()",
										"title":  i18n.T(ctx, "Update Profile"),
									},
								}) {
									@icon.Save(icon.Props{Class: "size-3.5 me-1.5"})
									{ i18n.T(ctx, "Save") }
								}
							</template>
							<template x-if="!selectedProfileId">
								@button.Button(button.Props{
									Size:    button.SizeSm,
									Attributes: templ.Attributes{
										"@click": "saveProfile()",
										"title":  i18n.T(ctx, "Save as New Profile"),
									},
								}) {
									@icon.Save(icon.Props{Class: "size-3.5 me-1.5"})
									{ i18n.T(ctx, "Save Profile") }
								}
							</template>
						</div>
					}

					<!-- Metric Cards Grid -->
					<div class="flex-1 overflow-y-auto p-4">
						<!-- New profile name input -->
						<template x-if="!selectedProfileId">
							<div class="mb-4">
								<label class="text-sm font-medium text-foreground mb-1.5 block">
									{ i18n.T(ctx, "Profile Name") } <span class="text-destructive">*</span>
								</label>
								@input.Input(input.Props{
									Type:        input.TypeText,
									Placeholder: "e.g., Standard Quality Check",
									Attributes: templ.Attributes{
										"x-model": "profileName",
									},
								})
							</div>
						</template>

						<!-- Summary -->
						<div class="mb-3 text-xs text-muted-foreground">
							<span x-text="enabledCount + ' of ' + metrics.length + ' metrics enabled'"></span>
						</div>

						<!-- Error message -->
						<div x-show="errors.general" x-cloak class="mb-3 rounded-lg border border-destructive/50 bg-destructive/10 p-3">
							<p class="text-sm text-destructive" x-text="errors.general"></p>
						</div>

						<!-- Cards -->
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
							<template x-for="m in metrics" :key="m.id">
								<div
									class="rounded-xl border border-border/60 p-3 transition-colors"
									:class="configs[m.id]?.enabled ? 'border-primary/30 bg-primary/5' : ''"
								>
									<div class="flex items-start justify-between gap-2 mb-2">
										<div class="flex-1 min-w-0">
											<div class="flex items-center gap-1.5">
												<p class="text-sm font-medium text-foreground truncate" x-text="m.name"></p>
												<span class="text-[10px] px-1 py-0 rounded-full font-medium shrink-0"
													:class="m.category === 'core' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' : 'bg-muted text-muted-foreground'"
													x-text="m.category"></span>
											</div>
											@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] px-1 py-0 mt-1"}) {
												<span x-text="typeLabels[m.type] || m.type"></span>
											}
										</div>
										<!-- Toggle -->
										<button
											type="button"
											@click="toggleMetric(m.id)"
											class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors"
											:class="configs[m.id]?.enabled ? 'bg-primary' : 'bg-muted'"
										>
											<span
												class="pointer-events-none inline-block size-4 rounded-full bg-white shadow-xs transition-transform"
												:class="configs[m.id]?.enabled ? 'translate-x-4' : 'translate-x-0'"
											></span>
										</button>
									</div>
									<p class="text-xs text-muted-foreground mb-2 line-clamp-2" x-text="m.description"></p>

									<!-- Threshold controls (only when enabled) -->
									<template x-if="configs[m.id]?.enabled && m.range_min !== m.range_max">
										<div class="space-y-1.5">
											<div class="flex items-center justify-between">
												<label class="text-[11px] font-medium text-foreground">{ i18n.T(ctx, "Threshold") }</label>
												<input
													type="number"
													:x-model.number="configs[m.id].threshold"
													:min="m.range_min"
													:max="m.range_max"
													:step="(m.range_max - m.range_min) / 100"
													class="w-16 rounded border border-input bg-background px-1.5 py-0.5 text-xs text-center ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
												/>
											</div>
											<input
												type="range"
												:x-model.number="configs[m.id].threshold"
												:min="m.range_min"
												:max="m.range_max"
												:step="(m.range_max - m.range_min) / 100"
												class="w-full accent-primary"
											/>
											<div class="flex items-center justify-between">
												<span class="text-[10px] text-muted-foreground" x-text="'Min: ' + m.range_min"></span>
												<button
													type="button"
													@click="resetToDefault(m)"
													class="text-[10px] text-muted-foreground hover:text-foreground transition-colors"
												>
													{ i18n.T(ctx, "Reset to default") }
												</button>
												<span class="text-[10px] text-muted-foreground" x-text="'Max: ' + m.range_max"></span>
											</div>
											<div x-show="errors[m.id]" x-cloak class="text-[10px] text-destructive" x-text="errors[m.id]"></div>
										</div>
									</template>
									<template x-if="configs[m.id]?.enabled && m.range_min === m.range_max">
										<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "No threshold range — scored by LLM judge") }</p>
									</template>
								</div>
							</template>
						</div>
					</div>

					<!-- Footer -->
					@dialog.Footer(dialog.FooterProps{Class: "px-4 py-3 border-t mt-auto bg-muted/50"}) {
						<div class="flex items-center justify-between w-full">
							<span class="text-xs text-muted-foreground" x-show="selectedProfileId">{ i18n.T(ctx, "Editing existing profile") }</span>
							<span class="text-xs text-muted-foreground" x-show="!selectedProfileId">{ i18n.T(ctx, "Creating new profile") }</span>
							@dialog.Close() {
								@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-8 px-3 text-xs"}) {
									{ i18n.T(ctx, "Close") }
								}
							}
						</div>
					}
				</div>
			}
		}
	</div>
}

templ MetricConfigScript() {
	@dialog.Script()
	@input.Script()
}
