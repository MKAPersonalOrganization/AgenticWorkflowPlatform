package docs

// ─── Workflow Diagram Components ─────────────────────────────────────────────
//
// Professional static workflow diagrams for documentation. Each pattern type
// uses a consistent visual language: rounded node cards, clear directional
// arrows, and type-specific container styles.
//
// Pattern containers:
//   Sequential  → solid border, blue accent
//   Parallel    → double border, amber accent, fork/join bars
//   Loop        → dashed border, purple accent
//   Conditional → dotted border, red accent, branch labels
//
// ─────────────────────────────────────────────────────────────────────────────

// ─── Data types ──────────────────────────────────────────────────────────────

type wfAgent struct {
	Name     string
	Subtitle string
	Badges   []string
}

type wfNode = wfAgent

type wfBranch struct {
	Label     string
	Condition string
	Color     string // "emerald", "amber", "slate"
}

type wfLoopGroup struct {
	Agents    []wfAgent
	MaxIter   string
	EarlyExit bool
}

type wfConditionalGroup struct {
	Evaluator wfAgent
	OutputKey string
	Branches  []wfBranch
}

type wfNestedGroup struct {
	Label    string
	RootType string
	Agents   []wfAgent
	Branches []wfNestedBranch
	Children []wfNestedGroup
	Nodes    []wfNestedNode
}

type wfNestedNode struct {
	Type     string
	Node     wfAgent
	Children []wfNestedNode
}

type wfNestedBranch struct {
	Condition string
	Agents    []wfAgent
	Children  []wfNestedGroup
}

// ─── Agent card ──────────────────────────────────────────────────────────────

templ wfAgentCard(a wfAgent) {
	<div class="rounded-md border border-border bg-card px-4 py-2.5 min-w-[150px] flex-shrink-0">
		<div class="flex items-center gap-2">
			<span class="size-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
			<div class="min-w-0">
				<div class="text-[13px] font-medium text-foreground truncate">{ a.Name }</div>
				if a.Subtitle != "" {
					<div class="text-[11px] text-muted-foreground truncate font-mono">{ a.Subtitle }</div>
				}
			</div>
		</div>
		if len(a.Badges) > 0 {
			<div class="flex gap-1 mt-1.5 flex-wrap">
				for _, b := range a.Badges {
					<span class="inline-flex items-center rounded border border-border bg-muted px-1.5 py-px text-[9px] font-medium text-muted-foreground">{ b }</span>
				}
			</div>
		}
	</div>
}

// ─── Arrow connector ─────────────────────────────────────────────────────────

templ wfArrow() {
	<div class="flex items-center justify-center w-10 flex-shrink-0">
		<div class="flex-1 h-px bg-muted-foreground/40"></div>
		<svg class="size-4 text-muted-foreground flex-shrink-0 -ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
	</div>
}

// ─── Sequential pipeline ─────────────────────────────────────────────────────

templ wfSequential(agents []wfAgent) {
	<div class="my-6 rounded-lg border border-border/60 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
			<span>Sequential</span>
		</div>
		<div class="flex items-center gap-0 mt-1">
			for i, a := range agents {
				@wfAgentCard(a)
				if i < len(agents)-1 {
					@wfArrow()
				}
			}
		</div>
	</div>
}

// ─── Parallel fan-out/in ────────────────────────────────────────────────────

templ wfParallel(agents []wfAgent, mergeAgent wfAgent) {
	<div class="my-6 rounded-lg border-2 border-double border-amber-500/30 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v18"/><path d="M16 3v18"/></svg>
			<span>Parallel</span>
		</div>
		<div class="flex items-stretch gap-4 mt-1">
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			<div class="flex flex-col gap-3 flex-1">
				for _, a := range agents {
					<div class="flex items-center gap-0">
						<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
						@wfAgentCard(a)
					</div>
				}
			</div>
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			if mergeAgent.Name != "" {
				@wfArrow()
				@wfAgentCard(mergeAgent)
			}
		</div>
	</div>
}

// ─── Parallel + Sequential ──────────────────────────────────────────────────

templ wfParallelSequential(agents []wfAgent, after []wfAgent) {
	<div class="my-6 rounded-lg border-2 border-double border-amber-500/30 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v18"/><path d="M16 3v18"/></svg>
			<span>Parallel</span>
		</div>
		<div class="flex items-stretch gap-4 mt-1">
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			<div class="flex flex-col gap-3 flex-1">
				for _, a := range agents {
					<div class="flex items-center gap-0">
						<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
						@wfAgentCard(a)
					</div>
				}
			</div>
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			if len(after) > 0 {
				@wfArrow()
				for i, a := range after {
					@wfAgentCard(a)
					if i < len(after)-1 {
						@wfArrow()
					}
				}
			}
		</div>
	</div>
}

// ─── Loop ────────────────────────────────────────────────────────────────────

templ wfLoop(group wfLoopGroup) {
	<div class="my-6 rounded-lg border-2 border-dashed border-purple-500/30 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>Loop</span>
		</div>
		if group.MaxIter != "" {
			<div class="absolute -top-[9px] right-4 text-[10px] font-bold px-2 py-0.5 rounded bg-background text-foreground border border-border">{ group.MaxIter }</div>
		}
		<div class="flex items-center gap-0 mt-1">
			for i, a := range group.Agents {
				@wfAgentCard(a)
				if i < len(group.Agents)-1 {
					@wfArrow()
				}
			}
		</div>
		<div class="mt-2 flex items-center gap-1 text-[11px] text-muted-foreground">
			<svg class="size-3.5 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>Repeats until exit condition</span>
			if group.EarlyExit {
				<span>or <code class="text-purple-500 font-semibold">exit_loop</code> tool</span>
			}
		</div>
	</div>
}

// ─── Conditional routing ─────────────────────────────────────────────────────

templ wfConditional(group wfConditionalGroup) {
	<div class="my-6 rounded-lg border-2 border-dotted border-red-500/25 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="m8 3-5 5 5 5"/><path d="m3 12 6 6 6-6"/><path d="m9 18 6-6-6-6"/></svg>
			<span>Conditional</span>
		</div>
		if group.OutputKey != "" {
			<div class="absolute -top-[9px] right-4 text-[10px] font-bold px-2 py-0.5 rounded bg-background text-foreground border border-border">{ group.OutputKey }</div>
		}
		<div class="flex items-start gap-4 mt-1">
			@wfAgentCard(group.Evaluator)
			@wfArrow()
			<div class="flex items-stretch gap-4 flex-1">
				<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
				<div class="flex flex-col gap-4 flex-1">
					for _, b := range group.Branches {
						<div class="flex flex-col gap-0">
							<span class="text-[10px] font-semibold text-muted-foreground mb-1 ml-5 uppercase tracking-wide">
								if b.Condition == "*" {
									default
								} else {
									{ b.Condition }
								}
							</span>
							<div class="flex items-center gap-0">
								<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
								<div class={ "rounded-md border bg-card px-4 py-2.5 min-w-[150px] flex-shrink-0", "border-" + b.Color + "-500/30" }>
									<div class="text-[13px] font-medium text-foreground">{ b.Label }</div>
								</div>
							</div>
						</div>
					}
				</div>
				<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			</div>
		</div>
	</div>
}

// ─── Nested composition ──────────────────────────────────────────────────────

func inferRootType(group wfNestedGroup) string {
	if group.RootType != "" {
		return group.RootType
	}
	if len(group.Nodes) > 0 && group.Nodes[0].Type != "" {
		return group.Nodes[0].Type
	}
	return ""
}

templ wfNested(group wfNestedGroup) {
	switch inferRootType(group) {
	case "parallel":
		@wfNestedParallel(group)
	case "loop":
		@wfNestedLoop(group)
	case "conditional":
		@wfNestedConditional(group)
	default:
		@wfNestedSequential(group)
	}
}

// ─── Nested sequential ───────────────────────────────────────────────────────

templ wfNestedSequential(group wfNestedGroup) {
	<div class="my-6 rounded-lg border border-border/60 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
			<span>{ group.Label }</span>
		</div>
		if len(group.Agents) > 0 {
			<div class="flex items-center gap-0 mt-1">
				for i, a := range group.Agents {
					@wfAgentCard(a)
					if i < len(group.Agents)-1 {
						@wfArrow()
					}
				}
			</div>
		}
		if len(group.Nodes) > 0 {
			<div class="mt-2 space-y-2">
				for i, n := range group.Nodes {
					@wfRenderNestedNode(n)
					if i < len(group.Nodes)-1 {
						@wfArrow()
					}
				}
			</div>
		}
		if len(group.Children) > 0 {
			<div class="mt-3 space-y-3">
				for _, c := range group.Children {
					@wfNested(c)
				}
			</div>
		}
	</div>
}

// ─── Nested parallel ─────────────────────────────────────────────────────────

templ wfNestedParallel(group wfNestedGroup) {
	<div class="my-6 rounded-lg border-2 border-double border-amber-500/30 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v18"/><path d="M16 3v18"/></svg>
			<span>{ group.Label }</span>
		</div>
		<div class="flex items-stretch gap-4 mt-1">
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			<div class="flex flex-col gap-3 flex-1">
				for _, a := range group.Agents {
					<div class="flex items-center gap-0">
						<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
						@wfAgentCard(a)
					</div>
				}
				for _, n := range group.Nodes {
					<div class="flex items-center gap-0">
						<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
						@wfRenderNestedNode(n)
					</div>
				}
				for _, c := range group.Children {
					<div class="flex items-center gap-0">
						<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
						@wfNested(c)
					</div>
				}
			</div>
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
		</div>
	</div>
}

// ─── Nested loop ─────────────────────────────────────────────────────────────

templ wfNestedLoop(group wfNestedGroup) {
	<div class="my-6 rounded-lg border-2 border-dashed border-purple-500/30 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>{ group.Label }</span>
		</div>
		if len(group.Agents) > 0 {
			<div class="flex items-center gap-0 mt-1">
				for i, a := range group.Agents {
					@wfAgentCard(a)
					if i < len(group.Agents)-1 {
						@wfArrow()
					}
				}
			</div>
		}
		if len(group.Nodes) > 0 {
			<div class="flex items-center gap-0 mt-2">
				for i, n := range group.Nodes {
					@wfRenderNestedNode(n)
					if i < len(group.Nodes)-1 {
						@wfArrow()
					}
				}
			</div>
		}
		if len(group.Children) > 0 {
			<div class="mt-3 space-y-3">
				for _, c := range group.Children {
					@wfNested(c)
				}
			</div>
		}
		<div class="mt-2 flex items-center gap-1 text-[11px] text-muted-foreground">
			<svg class="size-3.5 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>Repeats until exit condition</span>
		</div>
	</div>
}

// ─── Nested conditional ──────────────────────────────────────────────────────

templ wfNestedConditional(group wfNestedGroup) {
	<div class="my-6 rounded-lg border-2 border-dotted border-red-500/25 bg-card/30 p-5 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="m8 3-5 5 5 5"/><path d="m3 12 6 6 6-6"/><path d="m9 18 6-6-6-6"/></svg>
			<span>{ group.Label }</span>
		</div>
		<div class="flex items-start gap-4 mt-1">
			if len(group.Agents) > 0 {
				@wfAgentCard(group.Agents[0])
				@wfArrow()
			}
			<div class="flex items-stretch gap-4 flex-1">
				<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
				<div class="flex flex-col gap-4 flex-1">
					for _, b := range group.Branches {
						<div class="flex flex-col gap-0">
							<span class="text-[10px] font-semibold text-muted-foreground mb-1 ml-5 uppercase tracking-wide">
								if b.Condition == "*" {
									default
								} else {
									{ b.Condition }
								}
							</span>
							<div class="flex flex-col gap-2">
								for i, a := range b.Agents {
									<div class="flex items-center gap-0">
										<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
										@wfAgentCard(a)
									</div>
									if i < len(b.Agents)-1 {
										@wfArrow()
									}
								}
								for _, c := range b.Children {
									<div class="flex items-center gap-0">
										<div class="w-4 h-px bg-muted-foreground/30 flex-shrink-0 rounded-full"></div>
										@wfNested(c)
									</div>
								}
							</div>
						</div>
					}
				</div>
				<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			</div>
		</div>
	</div>
}

// ─── Render legacy nested node ───────────────────────────────────────────────

templ wfRenderNestedNode(n wfNestedNode) {
	switch n.Type {
	case "sequential":
		@wfRenderNestedSequential(n.Children)
	case "parallel":
		@wfRenderNestedParallel(n.Children)
	case "loop":
		@wfRenderNestedLoop(n)
	case "conditional":
		@wfRenderNestedConditional(n)
	default:
		@wfAgentCard(n.Node)
		for _, c := range n.Children {
			@wfArrow()
			@wfRenderNestedNode(c)
		}
	}
}

templ wfRenderNestedSequential(children []wfNestedNode) {
	<div class="flex items-center gap-0">
		for i, c := range children {
			@wfRenderNestedNode(c)
			if i < len(children)-1 {
				@wfArrow()
			}
		}
	</div>
}

templ wfRenderNestedParallel(children []wfNestedNode) {
	<div class="flex items-stretch gap-4">
		<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
		<div class="flex flex-col gap-3 flex-1">
			for _, c := range children {
				@wfRenderNestedNode(c)
			}
		</div>
		<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
	</div>
}

templ wfRenderNestedLoop(n wfNestedNode) {
	<div class="rounded-lg border-2 border-dashed border-purple-500/30 bg-card/30 p-4 relative">
		<div class="absolute -top-[9px] left-4 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-background text-foreground border border-border">
			<svg class="size-3 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>Loop</span>
		</div>
		<div class="flex items-center gap-0 mt-1">
			for i, c := range n.Children {
				@wfRenderNestedNode(c)
				if i < len(n.Children)-1 {
					@wfArrow()
				}
			}
		</div>
		<div class="mt-2 flex items-center gap-1 text-[11px] text-muted-foreground">
			<svg class="size-3.5 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
			<span>Repeats until exit condition</span>
		</div>
	</div>
}

templ wfRenderNestedConditional(n wfNestedNode) {
	<div class="flex items-start gap-4">
		@wfAgentCard(n.Node)
		@wfArrow()
		<div class="flex items-stretch gap-4 flex-1">
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
			<div class="flex flex-col gap-3 flex-1">
				for _, c := range n.Children {
					@wfRenderNestedNode(c)
				}
			</div>
			<div class="w-0.5 bg-muted-foreground/30 self-stretch flex-shrink-0 rounded-full"></div>
		</div>
	</div>
}

// ─── Concept badge ───────────────────────────────────────────────────────────

templ wfConceptBadge(text string) {
	<span class="inline-flex items-center rounded-full border border-border bg-muted px-2.5 py-0.5 text-[10px] font-medium text-muted-foreground">{ text }</span>
}

templ wfConceptBadges(concepts []string) {
	<div class="my-3 flex items-center gap-1.5 flex-wrap">
		for _, c := range concepts {
			@wfConceptBadge(c)
		}
	</div>
}

// ─── Legacy compatibility ────────────────────────────────────────────────────

func patternColor(pattern string) string {
	switch pattern {
	case "sequential":
		return "bg-blue-600"
	case "parallel":
		return "bg-emerald-600"
	case "loop", "loop (early exit)":
		return "bg-rose-500"
	case "conditional":
		return "bg-red-500"
	default:
		return "bg-slate-600"
	}
}
