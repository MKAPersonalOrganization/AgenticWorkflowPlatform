package docs

// ─── Plugin System ───────────────────────────────────────────────────────────
templ docsPlugins() {
	@docsSection("plugins", "Plugin System", iconPuzzle, "text-green-500") {
		<p>
			Compass.AI's plugin system provides a powerful extension mechanism that gives agents specialized
			capabilities. Plugins are registered at startup and managed through a central registry, with
			per-agent toggle control for fine-grained configuration.
		</p>
		<h3>Built-in Plugins</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Plugin</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Description</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Use Cases</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Calculator", "Mathematical computations and expressions", "Arithmetic, powers and roots, solving algebraic equations")
				@docsTableRow("Cognitive", "Advanced reasoning and analysis tools", "Logic puzzles, step-by-step problem solving")
				@docsTableRow("Document Management", "Create, update, and delete markdown documents the agent produces", "Reports, notes, structured write-ups")
				@docsTableRow("Filesystem", "Read and write files in your attached virtual filesystems", "Browsing folders, editing files, organizing project content")
				@docsTableRow("Plan Mode", "Research-first planning with your approval before execution", "Safe autonomous research, reviewing a plan before changes")
				@docsTableRow("Progress Tracker", "Structured task lists with real-time status updates", "Following an agent's progress on multi-step requests")
				@docsTableRow("Task Tracker", "Hierarchical tasks with dependencies, statuses, and visual graphs", "Project management, breaking down large initiatives")
				@docsTableRow("Text-to-Speech", "Convert AI responses to spoken audio", "Accessibility, narration, auditory processing")
				@docsTableRow("Web Search", "Grounded web search with real-time results and citations", "Up-to-date research, fact-finding, troubleshooting")
			</tbody>
		}
		@docsInfoBox("Memory and artifacts aren't plugins") {
			<p>
				Cross-session memory and versioned artifact storage used to appear in this
				list as plugins. Both are now first-class agent features — toggle them per
				agent in the designer. See the <strong>Memory &amp; Artifacts</strong> docs
				section for what they do and how to enable them.
			</p>
		}
		<h3>How Plugins Work</h3>
		<p>
			Each plugin registers its tool sets when the platform starts. Your enable/disable choices are saved persistently, so your agent configurations survive restarts.
		</p>
		<h3>Per-Agent Tool Management</h3>
		<p>
			Plugins expose <strong>tool sets</strong>, and each tool set contains one or more <strong>individual tools</strong>.
			You can control availability at both levels:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Toggle a full tool set</strong> — Enable or disable all tools in a plugin for a specific agent</li>
			<li>• <strong>Toggle individual tools</strong> — Fine-tune by enabling/disabling specific tools within a set</li>
		</ul>
		<p>
			This flexibility lets you create highly specialized agents. For example, a "Research Assistant" agent might
			have the Web Search plugin fully enabled, but only the <strong>Solve Equation</strong> tool from the Calculator plugin.
		</p>
		<h3>MCP & A2A Integration</h3>
		<p>
			MCP connectors and A2A agent connectors are both registered as dynamic plugins in the tool
			registry. MCP servers expose individual tools; A2A agents appear as a single callable tool
			per remote agent. Both show up alongside built-in plugins in the agent's tool configuration
			panel, providing a unified management experience.
		</p>
	}
}

// ─── Voice & TTS ─────────────────────────────────────────────────────────────
templ docsVoiceTTS() {
	@docsSection("voice-tts", "Voice and Text-to-Speech", iconHeadphones, "text-indigo-500") {
		<p>
			The Text-to-Speech plugin converts AI responses into <strong>lifelike spoken audio</strong>
			using advanced voice synthesis. Perfect for accessibility, reviewing
			reference materials, and hands-free interactions.
		</p>
		<h3>Voice Configuration</h3>
		<p>
			Text-to-speech currently uses your OpenAI provider key, added in <strong>Settings → AI</strong>
			(support for additional voice providers is planned). Enable <strong>Text-to-Speech</strong> in
			<strong>Settings → Speech</strong>, then choose the TTS model and default voice in the
			Text-to-Speech plugin's <strong>Plugin Settings</strong> panel, found in the Plugins &amp; Tools
			dialog. Configure once, and every agent that uses the TTS plugin automatically picks up your preferences.
		</p>
		<h3>Available Voices</h3>
		<p>
			Compass.AI offers <strong>a wide selection of AI voices</strong>, each with its own character and tone:
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Voice</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Character</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("alloy", "Neutral, balanced, great default")
				@docsTableRow2("ash", "Warm, conversational")
				@docsTableRow2("ballad", "Melodic, storytelling")
				@docsTableRow2("coral", "Clear, professional")
				@docsTableRow2("echo", "Authoritative, deep")
				@docsTableRow2("fable", "Gentle, narrative")
				@docsTableRow2("nova", "Energetic, expressive")
				@docsTableRow2("onyx", "Rich, confident")
				@docsTableRow2("sage", "Calm, wise")
				@docsTableRow2("shimmer", "Bright, friendly")
				@docsTableRow2("verse", "Articulate, precise")
				@docsTableRow2("marin", "Warm, approachable (recommended)")
				@docsTableRow2("cedar", "Steady, trustworthy (recommended)")
			</tbody>
		}
		<h3>Features</h3>
		<ul class="space-y-2 my-4">
			<li>
				<strong>Per-user voice selection</strong> -- Choose your preferred default voice in the plugin's settings; agents can still override per-request
			</li>
			<li>
				<strong>Word-level timestamps</strong> -- Synchronized highlighting via Whisper forced-alignment so you can follow along as audio plays
			</li>
			<li>
				<strong>Custom voice instructions</strong> -- Control tone, speed, emotion, and accent through natural language
			</li>
			<li>
				<strong>MP3 output</strong> -- Generated audio is saved as a downloadable MP3 artifact attached to the thread
			</li>
			<li>
				<strong>Up to 4,096 characters</strong> -- Per request, supporting full paragraph-length narration
			</li>
		</ul>
		<h3>Usage</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Add your OpenAI API key in <strong>Settings → AI</strong></li>
			<li>Configure your preferred TTS model and voice in the Text-to-Speech plugin's <strong>Plugin Settings</strong> panel</li>
			<li>Enable the <strong>Text-to-Speech</strong> plugin for your agent</li>
			<li>Ask the agent to read text aloud, explain something verbally, or narrate content</li>
			<li>The agent generates an audio file and presents it with an inline player</li>
		</ol>
		<h3>Focus Mode Listening Sessions</h3>
		<p>
			Every generated audio clip includes a <strong>Focus Mode</strong> button that opens a fullscreen
			listening session designed for deep listening and language learning:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Synchronized word highlighting</strong> — Follow along word by word as the audio plays, and click any word to jump there</li>
			<li>• <strong>Playback controls</strong> — Adjustable speed, sentence-by-sentence navigation, and repeat</li>
			<li>• <strong>A-B looping</strong> — Set loop points to replay a passage until it sticks</li>
			<li>• <strong>Transcript reading modes</strong> — Show, blur, or hide the transcript to test your listening comprehension</li>
			<li>• <strong>Keyboard shortcuts</strong> — Drive the whole session from the keyboard: Space to play/pause, arrows to navigate, and more (press <strong>?</strong> in Focus Mode for the full list)</li>
		</ul>
		@docsInfoBox("Interactive Audio") {
			<p>Agents can pause mid-conversation and ask you for input, making interactive audio sessions possible: the agent reads a report aloud, then asks you for feedback.</p>
		}
	}
}

// ─── MCP Integration ─────────────────────────────────────────────────────────
templ docsMCP() {
	@docsSection("mcp", "MCP Integration", iconMCPLogo, "text-orange-500") {
		<p>
			The <strong>Model Context Protocol (MCP)</strong> is an open standard that allows AI applications to connect
			with external tools and data sources. Compass.AI implements full MCP client support, enabling your agents to
			interact with remote services seamlessly.
		</p>
		<h3>How MCP Works</h3>
		<p>
			MCP connectors act as bridges between Compass.AI and external servers. When you connect to an MCP server,
			Compass.AI automatically discovers the available tools and makes them accessible to your agents.
		</p>
		@docsInfoBox("Connector Lifecycle") {
			<div class="flex flex-wrap items-center gap-2 mt-2 text-sm">
				@statusBadge("Created", "bg-muted-foreground")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Connecting", "bg-info")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Connected", "bg-success")
				<span class="text-muted-foreground">or</span>
				@statusBadge("Auth Required", "bg-warning")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Authorizing", "bg-primary")
			</div>
		}
		<h3>Setting Up an MCP Connector</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Open <strong>Plugins &amp; Tools</strong> from the sidebar</li>
			<li>Switch to the <strong>MCP Servers</strong> tab</li>
			<li>Click <strong>"Add Server"</strong></li>
			<li>Enter the MCP server URL (e.g., <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">https://mcp.github.com</code>)</li>
			<li>If the server requires OAuth, you'll be redirected to authenticate</li>
			<li>Once connected, available tools are automatically discovered</li>
			<li>Assign the connector's tools to specific agents</li>
		</ol>
		<h3>OAuth 2.1 Support</h3>
		<p>
			Compass.AI supports the full OAuth 2.1 Authorization Code + PKCE flow for secure authentication
			with MCP servers. This means you can safely connect to services like GitHub, Notion, and Slack
			without exposing your credentials.
		</p>
		<h3>MCP Proxy</h3>
		<p>
			Compass.AI includes an authenticated reverse proxy to MCP servers. This means your agents can
			communicate with external services through Compass.AI's secure infrastructure, with SSRF protection —
			and your OAuth tokens are never exposed through the API.
		</p>
		<h3>Preset Connectors</h3>
		<p>
			Compass.AI recognizes the server URLs of popular services — GitHub, Stripe, Box, Linear, and
			Notion. When you enter one of these URLs, Compass.AI automatically applies a friendly display
			name and any pre-configured OAuth settings.
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Feature</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Details</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Protocol", "Model Context Protocol (MCP)")
				@docsTableRow2("Auth Flow", "OAuth 2.1 Authorization Code + PKCE")
				@docsTableRow2("Max Connectors", "20 per user")
				@docsTableRow2("Tool Discovery", "Automatic on connect — reconnect to re-discover tools")
				@docsTableRow2("Security", "SSRF protection; OAuth tokens are never exposed through the API")
				@docsTableRow2("Proxy", "Authenticated reverse proxy to MCP servers")
			</tbody>
		}
	}
}

// ─── A2A Integration ─────────────────────────────────────────────────────────
templ docsA2A() {
	@docsSection("a2a", "A2A Integration", iconA2ALogo, "text-violet-500") {
		<p>
			The <strong>Agent-to-Agent (A2A) protocol</strong> is an open standard for AI-to-AI communication.
			While MCP connects agents to <em>tools and data sources</em>, A2A connects agents to <em>other agents</em> — running
			on different servers, built with different frameworks, maintained by different teams.
		</p>
		@docsInfoBox("A2A vs MCP — When to Use Which") {
			<ul class="space-y-1 mt-2 text-sm">
				<li>• <strong>MCP</strong> — Connect to <em>tools</em> (GitHub, Slack, filesystem, APIs). Each server exposes individual tools.</li>
				<li>• <strong>A2A</strong> — Connect to <em>agents</em> (research bots, code reviewers, translators). Each agent is one callable tool.</li>
			</ul>
		}
		<h3>How A2A Works</h3>
		<p>
			Every A2A-compliant agent publishes an <strong>agent card</strong> at
			<code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">/.well-known/agent-card.json</code>.
			This card describes the agent's name, skills, authentication requirements, and capabilities.
			When you connect a remote agent in Compass.AI, it:
		</p>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Fetches and validates the agent card from the remote URL</li>
			<li>Extracts the agent's skills, description, and provider information</li>
			<li>Registers the entire agent as <strong>one tool</strong> in the tool registry</li>
			<li>Embeds the agent's skills in the tool description so the LLM knows when to delegate</li>
		</ol>
		@docsInfoBox("One Tool per Agent") {
			<p class="mt-1 text-sm">
				Unlike MCP (which creates one tool per server endpoint), A2A treats each remote agent as
				<strong>a single atomic tool</strong>. Your agent sends a natural-language request; the remote
				agent decides which of its own skills to use. Enable/disable is at the agent level — you cannot
				toggle individual skills.
			</p>
		}
		<h3>Connector Lifecycle</h3>
		@docsInfoBox("Status Flow") {
			<div class="flex flex-wrap items-center gap-2 mt-2 text-sm">
				@statusBadge("Created", "bg-muted-foreground")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Discovering", "bg-info")
				<span class="text-muted-foreground">→</span>
				@statusBadge("Connected", "bg-success")
				<span class="text-muted-foreground">or</span>
				@statusBadge("Error", "bg-destructive")
			</div>
			<p class="mt-2 text-sm">
				You can also disconnect a connector at any time — it moves to a
				<strong>Disconnected</strong> state and can be reconnected later.
			</p>
		}
		<h3>Setting Up an A2A Connector</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Click the <strong>A2A icon</strong> in the navigation bar</li>
			<li>Click <strong>"Add A2A Agent"</strong></li>
			<li>Enter the agent's base URL (e.g., <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">http://agent.example.com:4030</code>)</li>
			<li>Optionally provide a title and authentication credentials</li>
			<li>Compass.AI discovers the agent card and extracts skills automatically</li>
			<li>The agent appears as a tool you can assign to any of your agents</li>
		</ol>
		<h3>Authentication</h3>
		<p>
			A2A connectors support multiple authentication methods for secure inter-agent communication:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>None</strong> — For development or trusted network environments</li>
			<li>• <strong>Bearer Token</strong> — Standard Authorization header with Bearer scheme</li>
			<li>• <strong>API Key</strong> — Token sent in <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">X-API-Key</code> header (customizable)</li>
			<li>• <strong>Custom Header</strong> — Any header name + value for proprietary auth schemes</li>
		</ul>
		<h3>For Developers — Building A2A-Compatible Agents</h3>
		<p>
			Any agent that publishes a valid agent card can be connected to Compass.AI. Your agent needs:
		</p>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>A <code class="px-1.5 py-0.5 rounded bg-muted text-sm font-mono">/.well-known/agent-card.json</code> endpoint returning your agent's metadata</li>
			<li>A message endpoint that accepts A2A protocol messages and returns responses</li>
			<li>Skills defined in the agent card so Compass.AI knows what your agent can do</li>
		</ol>
		<p>
			Use any language or framework — <strong>LangChain</strong>, <strong>CrewAI</strong>, or a custom implementation. As long as it speaks A2A, it works.
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Feature</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Details</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("Protocol", "Agent-to-Agent (A2A) open standard")
				@docsTableRow2("Discovery", "Automatic via /.well-known/agent-card.json")
				@docsTableRow2("Granularity", "One tool per agent (not per skill)")
				@docsTableRow2("Auth Methods", "None, Bearer, API Key, Custom Header")
				@docsTableRow2("Max Connectors", "20 per user")
				@docsTableRow2("Security", "SSRF protection — private and internal network addresses are blocked")
				@docsTableRow2("Compatibility", "Any A2A-compliant agent (Python, Go, Node.js, etc.)")
			</tbody>
		}
	}
}
