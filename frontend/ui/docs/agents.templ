package docs

// ─── AI Models ───────────────────────────────────────────────────────────────
templ docsAIModels() {
	@docsSection("ai-models", "AI Models", iconCpu, "text-blue-500") {
		<p>
			Compass.AI supports <strong>models from OpenAI and Google Gemini</strong>. Configure your preferred
			model globally in Settings → AI → Chat Model, and all agents automatically use it.
		</p>
		<h3>Supported Providers</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Provider</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Description</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("OpenAI", "GPT family of models — all-rounders with strong reasoning and multimodal capabilities")
				@docsTableRow2("Google Gemini", "Flash and Pro models — fast, efficient, with large context windows")
			</tbody>
		}
		<h3>Streaming and Real-Time Delivery</h3>
		<p>
			All models stream responses in real-time over Server-Sent Events (SSE).
			You see tokens appear character-by-character as the AI generates them, with live tool
			execution feedback and smooth UI updates.
		</p>
		<h3>Global Execution Settings</h3>
		<p>
			All AI execution parameters are configured globally in Settings → AI → Chat Model.
			Every agent inherits the same model, temperature, max tokens, and iteration limits.
			Agents only define behavioral configuration: name, system prompt, tools, and knowledge base access.
		</p>
		@docsInfoBox("Provider Health") {
			<p>Compass.AI monitors provider availability and can gracefully handle provider outages. Each provider connection is health-checked independently.</p>
		}
	}
}

// ─── AI Settings ─────────────────────────────────────────────────────────────
templ docsAISettings() {
	@docsSection("ai-settings", "AI Settings — Bring Your Own Key", iconSlidersHorizontal, "text-teal-500") {
		<p>
			Compass.AI gives you <strong>full control over your AI infrastructure</strong> through a clean
			two-layer architecture: <strong>provider credentials</strong> and <strong>capability configuration</strong>.
			Add your API keys once, then independently choose which provider and model powers each AI
			function — chat, voice, embeddings — without any overlap or duplication.
		</p>
		<h3>Two-Layer Architecture</h3>
		<p>
			Unlike platforms that lock you into a single AI provider or force you to reconfigure credentials per feature,
			Compass.AI cleanly separates the two concerns:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Layer 1 — Providers</strong> — Store API keys for OpenAI and Google Gemini. Each provider is configured once and shared across all capabilities.</li>
			<li>• <strong>Layer 2 — Capabilities</strong> — For each AI function (chat, voice, embedding), choose which of your configured providers and which specific model to use. No re-entering keys.</li>
		</ul>
		<p>
			This means you can use GPT-4o for chat, Gemini Flash for a different agent, OpenAI TTS for voice, and
			Gemini for embeddings — all at the same time, on the same account. Change your chat model without
			touching your voice or embedding setup.
		</p>
		<h3>Capabilities</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Capability</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">What It Controls</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Configurable Settings</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Chat Model (LLM)", "The AI model used for chatting with agents", "Provider, model, temperature, max tokens, max iterations")
				@docsTableRow("Text-to-Speech (TTS)", "Voice synthesis for spoken audio", "Provider, model, voice, voice instructions")
				@docsTableRow("Embedding", "Vector embeddings for knowledge graph search", "Provider, model")
				@docsTableRow("Speech-to-Text (STT)", "Transcription and audio understanding", "Provider, model")
				@docsTableRow("Image Generation", "AI image creation from text", "Coming soon")
			</tbody>
		}
		<h3>Setup Workflow</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li><strong>Add your providers</strong> — Go to Settings → AI and enter your API keys for OpenAI or Gemini. Add as many as you like.</li>
			<li><strong>Configure each capability</strong> — Under each capability section (Chat Model, Voice, Embedding), pick a provider and model from your already-configured list. No re-entering keys.</li>
			<li><strong>Fine-tune settings</strong> — Adjust capability-specific options like temperature, max tokens, or voice selection.</li>
			<li><strong>Start using agents</strong> — Every agent automatically uses the right provider for each capability based on your configuration.</li>
		</ol>
		@docsInfoBox("Your Keys, Your Control") {
			<p>Compass.AI never stores your API keys in plain text — they are encrypted at rest. You own your keys and can revoke them at any time. Compass.AI does not proxy or mark up API costs; all charges go directly to your provider. Use token analytics to monitor usage and optimize spend.</p>
		}
	}
}

// ─── Agent Templates ─────────────────────────────────────────────────────────
templ docsAgentStore() {
	@docsSection("agent-store", "Agent Templates", iconStore, "text-purple-500") {
		<p>
			Agent Templates is a catalog of pre-built workflow templates, each demonstrating a
			multi-agent <strong>composition pattern</strong>. They are learning-by-example starting
			points: fork one, study how it is wired, and adapt it to your own use case.
		</p>
		<h3>Browsing the Catalog</h3>
		<p>
			Open the Agent Templates from the sidebar navigation. Templates can be searched
			by name, description, or tags.
		</p>
		<h3>Pattern Families</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Family</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">What it demonstrates</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Templates</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Basic workflows", "The three core orchestration primitives", "Sequential Workflow, Parallel Workflow, Loop Workflow, Loop with Exit")
				@docsTableRow("Nested composition", "Workflows inside workflows, arbitrarily deep", "Sequential Inside Parallel, Parallel Inside Sequential, Sequential Inside Loop, Parallel Inside Loop Inside Sequential")
				@docsTableRow("Routing & delegation", "Dynamic control flow between agents", "Conditional Routing, Transfer to Peers, Transfer to Parent")
				@docsTableRow("State & context", "Passing data and controlling what agents see", "Implicit State, Output Schema, Context Control, Agent Isolation")
			</tbody>
		}
		<h3>Forking Agents</h3>
		<p>
			When you find an agent you like, click <strong>"Add to My Agents"</strong> to fork it into your personal
			collection. Forked agents are fully editable — you can customize the system prompt,
			add or remove tools, and configure knowledge base access.
		</p>
		@docsInfoBox("Agent Properties") {
			<ul class="space-y-2 mt-2">
				<li><strong>Name</strong> — Display name for the agent</li>
				<li><strong>Description</strong> — Short description of the agent's purpose</li>
				<li><strong>System Prompt</strong> — Instructions that define the agent's behavior and personality</li>
				<li><strong>Icon</strong> — Emoji label for visual identification</li>
				<li><strong>Tool Sets</strong> — Which plugins and individual tools are enabled</li>
				<li><strong>Workspace Access</strong> — Which knowledge base workspaces the agent can query</li>
			</ul>
		}
	}
}

// ─── Custom Agents ───────────────────────────────────────────────────────────
templ docsCustomAgents() {
	@docsSection("custom-agents", "Custom Agents", iconWand, "text-amber-500") {
		<p>
			Beyond the catalog, you can create agents entirely from scratch. Custom agents give you full
			control over every aspect of the AI's behavior.
		</p>
		<h3>Creating a Custom Agent</h3>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Open the Agent Templates from the sidebar</li>
			<li>Click <strong>"Create Agent"</strong> at the top</li>
			<li>Fill in the agent's name, description, and icon</li>
			<li>Write a detailed system prompt that defines the agent's role and instructions</li>
			<li>Configure which tool sets and individual tools are available to the agent</li>
			<li>Assign knowledge base workspaces the agent can access</li>
		</ol>
		<h3>System Prompt Best Practices</h3>
		<p>
			The system prompt is the most important part of an agent. It defines who the agent is, how it should
			behave, and what it should focus on. Here are some tips:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Be specific</strong> — Define the agent's role, expertise, and boundaries clearly</li>
			<li>• <strong>Set the tone</strong> — Specify whether the agent should be formal, friendly, technical, etc.</li>
			<li>• <strong>Include examples</strong> — Show the agent what good responses look like</li>
			<li>• <strong>Define constraints</strong> — Tell the agent what it should NOT do</li>
			<li>• <strong>Reference tools</strong> — Mention when the agent should use specific tools</li>
		</ul>
		<h3>Per-Agent Tool Configuration</h3>
		<p>
			Each agent can have a unique set of enabled tools. This lets you create specialized agents that only
			use relevant capabilities:
		</p>
		<ul class="space-y-2 my-4">
			<li>• A <strong>Data Analyst</strong> might only need Calculator and Knowledge Base</li>
			<li>• A <strong>Research Assistant</strong> might need Knowledge Base and Document tools</li>
			<li>• A <strong>Code Reviewer</strong> might need Codebase and Cognitive tools</li>
		</ul>
		<h3>Workspace Permissions</h3>
		<p>
			Control which knowledge base workspaces each agent can access. This is useful when you have
			multiple knowledge bases (e.g., "Physics Notes" and "History Research") and want specific
			agents to only query relevant workspaces.
		</p>
	}
}

// ─── Workflow Orchestration ──────────────────────────────────────────────────
templ docsMultiAgentOrchestration() {
	@docsSection("multi-agent", "Workflow Orchestration", iconGitBranch, "text-indigo-500") {
		<p>
			Compass.AI supports <strong>composing multiple agents into coordinated workflows</strong> that solve
			complex, multi-step problems. Built on proven agent orchestration patterns, the engine supports five composition
			patterns — sequential, parallel, loop, conditional routing, and coordinator delegation — all configurable from a
			visual builder in the UI.
		</p>
		<h3>Why Workflow Orchestration?</h3>
		<p>
			Individual LM agents work well for focused tasks. But real-world workflows require
			<strong>
				specialization
				and coordination
			</strong>: a research agent gathers data, an analyst extracts insights, and a
			writer produces the final report. Workflow orchestration lets you build these pipelines
			visually, with each agent owning a specific domain and passing structured results downstream.
		</p>
		<h3>Composition Patterns</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Pattern</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Behavior</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Use Case</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Sequential", "Agents execute one after another. Each receives the prior agent's output.", "Research → Analysis → Report pipelines")
				@docsTableRow("Parallel", "All child agents execute simultaneously. Results are collected and merged.", "Running multiple analysts on the same dataset at once")
				@docsTableRow("Loop", "Re-executes child agents until an exit condition is met or max iterations reached.", "Iterative refinement: draft → review → revise cycles")
				@docsTableRow("Conditional", "An evaluator agent analyzes input and routes to the appropriate specialist branch.", "Sentiment-based routing: positive → happy agent, negative → empathetic agent")
				@docsTableRow("Coordinator", "An LM agent delegates to sub-agents dynamically based on conversation context.", "Open-ended triage: user query routed to the best specialist")
			</tbody>
		}
		<h3>Sub-Agents vs Agent-as-Tool</h3>
		<p>
			There are two ways to wire one agent to call another, and the right choice depends on
			<strong>who owns the final answer</strong>:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Sub-Agent (transfer)</strong> — The parent hands off; the sub-agent takes over the turn and its reply becomes the user-visible response. Use when a specialist is better qualified to answer end-to-end ("hand off to the billing agent").</li>
			<li>• <strong>Agent-as-Tool (function call)</strong> — The parent stays in charge; it calls the other agent like any tool, reads its output, and keeps reasoning. Use when the parent needs a capability but must remain responsible for the final answer ("run Agent B on this snippet, then combine with my other findings").</li>
		</ul>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Aspect</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Sub-Agent (transfer)</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Agent-as-Tool (function call)</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Control flow", "Parent transfers to child; child drives the turn", "Parent calls child, child returns, parent keeps going")
				@docsTableRow("Who answers the user", "The child (directly)", "The parent (after using the child's output)")
				@docsTableRow("Child session", "Shares the thread's session and history", "Fresh in-memory session per call — isolated")
				@docsTableRow("Summarization", "No extra step — the child's reply is the reply", "Parent summarises by default (toggle off to return raw output)")
				@docsTableRow("Typical use", `"Escalate to specialist"`, `"Use another agent as a utility"`)
			</tbody>
		}
		@docsInfoBox("Combine them freely") {
			<p>Sub-Agents and Agent-as-Tool attachments are orthogonal — a single agent can transfer to peers <em>and</em> call utility agents as tools. When an agent is wrapped as a tool, its own Sub-Agents and Agent Tools are <strong>not</strong> propagated into the call — you get a plain callable. This keeps semantics simple and prevents accidental cycles.</p>
		}
		<h3>Agent as Tool (Function-Call Pattern)</h3>
		<p>
			The <strong>Agent as Tool</strong> pattern lets one agent call another like any
			function tool. The parent's LLM sees the child in its tool list, decides to invoke
			it, reads the child's output, and keeps reasoning. Control never transfers — the
			parent always produces the final user-visible response.
		</p>
		<p>
			Under the hood the target agent is built, wrapped as a function tool, and
			appended to the parent's tools. The child runs inside an
			<strong>isolated in-memory session</strong> per call, so it cannot read or
			write the parent's session state, memory, or artifacts — safe by default.
		</p>
		<h4>Wiring it in the designer</h4>
		<p>
			In the agent editor, open the <strong>Agents as Tools</strong> section (distinct
			from <strong>Sub-Agents</strong>):
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Add Agent Tool</strong> — Pick any of your other agents. The child's name and description become the function declaration the parent's LLM sees.</li>
			<li>• <strong>Return raw output (skip summarization)</strong> — Off by default: the parent summarises the child's output in its own reply. Turn on when the child produces the final authoritative response and you want the parent to pass it through verbatim.</li>
		</ul>
		<h4>What the caller sees</h4>
		<p>
			The parent's LLM receives a function declaration built from the child's fields:
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Function name</strong> — derived from the child's display name (slugified to match provider rules, e.g. OpenAI's <code>^[a-zA-Z0-9_-]+$</code>).</li>
			<li>• <strong>Description</strong> — the child's description, verbatim. Make it actionable — the LLM picks the tool based on this text.</li>
			<li>• <strong>Parameters</strong> — the child's <strong>Input Schema</strong> (see below). With no schema, the caller passes a single <code>request</code> string.</li>
		</ul>
		@docsInfoBox("Publish a proper signature") {
			<p>If you want the calling LLM to produce typed arguments instead of a blob of prose, set the child's <strong>Input Schema</strong> in its "Called as a Tool" section. Without it, the callable signature falls back to a single free-text <code>request</code>.</p>
		}
		<h4>Runtime semantics</h4>
		<ul class="space-y-2 my-4">
			<li>• <strong>Isolated session</strong> — each invocation gets a fresh in-memory session. No leakage of parent state, memory, or artifacts into the child.</li>
			<li>• <strong>Flattened child</strong> — when wrapped as a tool, the child's own Sub-Agents and Agent Tools are <em>not</em> propagated. You always get a plain leaf callable, which keeps semantics simple and prevents cycles.</li>
			<li>• <strong>Workflow agents are rejected</strong> — only simple LLM agents can be wrapped. A composed workflow (sequential/parallel/loop) must be invoked via its own orchestration, not as a tool.</li>
			<li>• <strong>Errors propagate</strong> — a failure inside the child surfaces as a tool error to the parent's LLM, which can retry or report naturally.</li>
		</ul>
		<h4>When to reach for it</h4>
		<ul class="space-y-2 my-4">
			<li>• <strong>Utility sub-tasks</strong> — "summarise this passage", "extract entities", "translate to French" — the parent needs the result but owns the final answer.</li>
			<li>• <strong>Structured extraction</strong> — a child with an Output Schema produces validated JSON that the parent merges into its broader response.</li>
			<li>• <strong>Capability wrapping</strong> — expose a specialist agent (with its own tools/KB) as a clean callable without giving the parent those tools directly.</li>
		</ul>
		@docsInfoBox("Not for handoffs") {
			<p>If the child should <em>own</em> the reply end-to-end (e.g. "escalate to the billing specialist"), use a <strong>Sub-Agent</strong> and let the parent transfer instead. Agent-as-Tool always keeps the parent in charge.</p>
		}
		<h3>Transfer Policies</h3>
		<p>
			Transfer policies control how agents can delegate work to each other in an LLM-routed
			composition. These prevent undesirable delegation chains and enforce architectural boundaries.
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Block transfer to parent</strong> — Prevents a sub-agent from handing control back to the parent. Useful when a specialist should fully resolve its task before returning.</li>
			<li>• <strong>Block transfer to peers</strong> — Prevents a sub-agent from delegating to sibling agents. Enforces strict separation of concerns between specialists.</li>
		</ul>
		@docsInfoBox("Default Behavior") {
			<p>By default, all transfers are allowed. Transfer policies are optional constraints you apply per-agent to tighten delegation when your workflow requires it. You can set defaults on the agent definition and override them per-node in a workflow.</p>
		}
		<h3>Context Control (Include Contents)</h3>
		<p>
			When a sub-agent is invoked, you can control whether it receives the parent's full conversation
			history or starts with a <strong>fresh context</strong>.
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Default (Include History)</strong> — The sub-agent sees all prior messages. Best for agents that need to reference earlier conversation context.</li>
			<li>• <strong>None (Fresh Context)</strong> — The sub-agent starts with a clean slate. Best for independent specialists that should not be influenced by upstream dialogue.</li>
		</ul>
		<h3>Output Keys and Template Variables</h3>
		<p>
			Each agent can store its final output in <strong>session state</strong> under a named key.
			Downstream agents reference those outputs with template placeholders inside their
			system prompts. The orchestration engine substitutes each placeholder with the live
			session-state value before the model is called.
		</p>
		@docsInfoBox("Example Pipeline") {
			<p>
				<strong>Step 1:</strong> Data Analyst agent with <code>output_key: research_data</code>
				<br/>
				<strong>Step 2:</strong> Report Writer agent whose system prompt contains
				<code>&#123;research_data&#125;</code>. Before the Report Writer runs, the
				placeholder is replaced by whatever the Data Analyst produced — no need to
				forward the full conversation history.
			</p>
		}
		<h4>Template Syntax</h4>
		<p>
			Keys may only contain letters, digits, and underscores, and must start with a
			letter or underscore. Anything that doesn't match is left as literal text.
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Syntax</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Meaning</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("{key}", "Required — resolves to the session-state value; the run errors if the key is missing.")
				@docsTableRow2("{key?}", "Optional — empty string when the key is missing; the run proceeds.")
			</tbody>
		}
		<h4>The Template Variable Picker</h4>
		<p>
			The designer surfaces a <strong>&#123;-triggered autocomplete</strong> under the system-prompt
			textarea. Typing <code>&#123;</code> opens a popover listing every key the orchestration engine
			can resolve at runtime, grouped by how relevant it is to the agent you're editing:
		</p>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Group</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Contents</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow2("This agent", "The agent's own output key — referenced by agents downstream of it.")
				@docsTableRow2("Direct sub-agents", "Output keys of agents listed under Sub-Agents or Agents-as-Tools.")
				@docsTableRow2("Workflow children", "For a composed agent, the output keys of every leaf inside its own graph.")
				@docsTableRow2("Workflow peers", "For a leaf, the output keys of other leaves in any workflow that contains it — the dominant read pattern in multi-step pipelines.")
				@docsTableRow2("Other agents in your library", "Fallback entries — any output key you've declared elsewhere, so references still resolve once you wire the workflow.")
				@docsTableRow2("Syntax reference", "The optional ? suffix, so you can mark a placeholder as safe to omit without looking up the syntax.")
			</tbody>
		}
		<p>
			<strong>Keyboard.</strong> Use <code>↑</code> / <code>↓</code> to move between
			suggestions, <code>Enter</code> or <code>Tab</code> to insert, <code>Esc</code> to close.
			If you type a reference that doesn't match any known key, a warning appears below
			the textarea. Add <code>?</code> to silence it when the key may legitimately be absent.
		</p>
		@docsInfoBox("How it works") {
			<p>
				The picker lists the output keys declared across your agents, grouped by how
				likely they are to be upstream of the agent you're editing. If you reference
				a key that isn't in the list, the warning below the textarea gives you a chance
				to fix a typo before the agent runs.
			</p>
		}
		<h3>Global Instructions <span class="text-[10px] font-semibold uppercase tracking-wider ms-2 px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 align-middle">Root only</span></h3>
		<p>
			A <strong>global instruction</strong> is a shared directive applied to <strong>every agent in the workflow</strong>.
			It lives on the <strong>root agent</strong> and automatically covers the root
			itself plus every sub-agent it delegates to — coordinator children, workflow
			leaves, and agents-as-tools alike. Use it for cross-cutting rules like tone,
			compliance language, or a required output format.
		</p>
		<p>
			The designer enforces this by only showing the Global Instruction field when
			you're editing a <strong>root</strong> agent. On a sub-agent, the field is
			hidden — setting it there would have no effect, so the UI takes the decision
			away from you.
		</p>
		@docsInfoBox("How to tell which agent is the root") {
			<p>
				The root is the agent users pick from your agent library — the one that
				answers first. Coordinator sub-agents, workflow-graph leaves, and
				agents-as-tools are all children of some root and don't get their own
				global instruction. If the Global Instruction section isn't showing while
				you edit an agent, that agent is a child of another one.
			</p>
		}
		<h3>Input Schema (Inbound Signature)</h3>
		<p>
			The <strong>input schema</strong> defines the callable signature an agent publishes
			to its callers. It's an <strong>inbound</strong> contract — "here is how I want to be invoked"
			— and it lives on the <em>callee</em>, not the caller.
		</p>
		<p>
			<strong>When it matters.</strong> The input schema is consulted only when the agent is
			invoked programmatically as a callable — specifically when it is wrapped via the
			<em>Agents as Tools</em> pattern, or exposed over A2A. On direct chat, inside workflow
			leaves, and at transfer targets the input schema is <strong>ignored</strong> — those paths
			always receive free-text user content.
		</p>
		<p>
			<strong>Default behaviour.</strong> An agent with no input schema is called with a single
			free-text argument named <code>request</code>. Set a schema to require named, typed
			arguments — e.g. <code>topic</code> as a string and <code>depth</code> as an integer —
			and the calling LLM will produce a properly structured function call instead of a
			blob of prose.
		</p>
		@docsInfoBox("Rule of thumb") {
			<p>If nothing ever wraps this agent as a tool and you don't publish it over A2A, the input schema has no effect — leave it empty. If another agent calls this one through <strong>Agents as Tools</strong>, define the input schema here to tell that caller what arguments to provide.</p>
		}
		<h3>Output Schema (Structured Replies)</h3>
		<p>
			The <strong>output schema</strong> constrains an agent's reply to a JSON Schema.
			Unlike the input schema, the output schema is <strong>universal</strong>: it applies
			on every reply regardless of how the agent was invoked (direct chat, workflow leaf,
			transfer target, or wrapped as a tool).
		</p>
		@docsInfoBox("Input vs Output Schema") {
			<p><strong>Input schema</strong> = inbound, situational — only consulted when someone calls this agent as a tool or over A2A. <strong>Output schema</strong> = outbound, universal — constrains every reply the agent produces.</p>
		}
		<h3>Visual Workflow Builder</h3>
		<p>
			The workflow tree builder provides a <strong>visual, interactive editor</strong> to compose multi-agent workflows.
		</p>
		<ul class="space-y-2 my-4">
			<li>• <strong>Add nodes</strong> — Insert sequential, parallel, loop, or agent nodes at any level of the tree</li>
			<li>• <strong>Nest compositions</strong> — Place a parallel group inside a sequential pipeline, or a loop inside a parallel group — any combination works</li>
			<li>• <strong>Per-node overrides</strong> — Override transfer policies and context control on individual nodes without changing the agent definition</li>
			<li>• <strong>Live preview</strong> — See an animated pipeline visualization with flow particles showing execution direction</li>
			<li>• <strong>Drag to reorder</strong> — Rearrange agents within compositions by dragging</li>
		</ul>
		<p>
			<strong>Precedence resolution:</strong> per-node overrides in a workflow take priority over
			agent-level defaults, which take priority over system defaults. This means the same agent
			can behave differently depending on where it appears in a workflow.
		</p>
	}
}

// ─── Personalized Profile ─────────────────────────────────────────────────────────
templ docsUserProfile() {
	@docsSection("personalized-profile", "Personalized Profile", iconUser, "text-amber-500") {
		<p>
			The Personalized Profile lets you define your work preferences so every AI agent
			automatically adjusts its approach to match how you work best.
			Access it from the account settings menu (click your avatar in the bottom-left corner).
		</p>
		<h3>Profile Fields</h3>
		@docsTable() {
			<thead>
				<tr>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Field</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Purpose</th>
					<th class="text-start py-2 px-3 text-sm font-medium border-b border-border">Example</th>
				</tr>
			</thead>
			<tbody>
				@docsTableRow("Learning Style", "How you prefer to absorb and process information", "Visual thinker, hands-on, detail-oriented")
				@docsTableRow("Struggles", "Areas where you need extra help", "Complex math, abstract concepts")
				@docsTableRow("Strengths", "Subjects or skills you are good at", "Problem solving, creative thinking")
				@docsTableRow("Goals", "What you are working toward", "Ship new features, improve system design")
			</tbody>
		}
		<h3>How It Works</h3>
		<p>
			Your profile is automatically <strong>injected into every agent system prompt</strong>.
			When you ask a Research Assistant for help, it already knows you prefer visual explanations
			and adjusts its communication accordingly.
		</p>
		<ol class="list-decimal list-inside space-y-2 my-4">
			<li>Open the account settings menu (avatar icon, bottom-left of the sidebar)</li>
			<li>Click <strong>Profile</strong> to open the profile dialog</li>
			<li>Fill in your learning style, struggles, strengths, and goals</li>
			<li>Save — changes apply to all future conversations immediately</li>
		</ol>
		<h3>Adaptive Communication</h3>
		<p>
			The profile data is used by specialized agent prompts to deliver personalized experiences:
		</p>
		<ul class="space-y-2 my-4">
			<li>
				<strong>Visual thinkers</strong> get more diagrams, charts, and spatial explanations
			</li>
			<li>
				<strong>Hands-on workers</strong> get interactive examples and actionable steps
			</li>
			<li>
				<strong>Strengths</strong> allow agents to reference known concepts for faster communication
			</li>
			<li>
				<strong>Goals</strong> help agents align their responses with your broader objectives
			</li>
		</ul>
		@docsInfoBox("Privacy") {
			<p>Your personalized profile is private to your account and is only used to tailor AI interactions. It is never shared with other users or used for training.</p>
		}
	}
}
