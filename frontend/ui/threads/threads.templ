package threads

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// ThreadsDialog renders the thread history as a VS Code-style command
// palette: a translucent, top-aligned sheet with a prominent search input
// and a scrollable list of chats in temporal order.
//
// Per-row actions (rename, share, duplicate, archive, delete) are surfaced
// through a shared context menu reached two ways: right-click on a row, or
// click a hover-revealed three-dot button. The menu is a single DOM node
// rendered once at the panel level and positioned with `fixed` + viewport
// coordinates — the same proven pattern used by
// frontend/ui/filesystem/filesystem.templ (which lives in the same kind of
// templui <dialog>).
//
// NOTE: Must render inside the x-data="chat" scope to access session
// helpers (getGroupedSessions, switchSession, createNewSession,
// __loadMoreSessions, __onSidebarScroll, shareSession, duplicateSession,
// archiveSession, startRename, deleteSession).
templ ThreadsDialog() {
	<div
		@open-threads-dialog.window="$nextTick(() => {
			$refs.threadSearchInput?.focus();
			setTimeout(() => {
				const el = $refs.threadListScroll;
				if (el && el.scrollHeight <= el.clientHeight && sessionsHasMore && !sessionsLoading) {
					__loadMoreSessions();
				}
			}, 200);
		})"
	>
		@dialog.Dialog(dialog.Props{
			ID: "threads-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				// Palette-specific overrides only: top-aligned, wide.
				// The translucent glass surface comes from the system default
				// (dialog.Content → .glass-heavy). No bg/border/blur overrides
				// here — they would fight the themed --glass-* tokens.
				Class: "sm:max-w-2xl max-h-[65vh] h-auto top-[12vh] -translate-y-0",
			}) {
				// -m-6 cancels the panel's hardcoded p-6 (v1.11.0 removed PanelClass) so the list fills edge-to-edge.
				<div
					class="-m-6 flex flex-col max-h-[65vh] min-h-0"
					x-data="{
						rowMenu: { x: 0, y: 0, session: null },
						positionAndShow(x, y, session) {
							this.rowMenu = { x, y, session };
							this.$nextTick(() => {
								const m = this.$refs.rowMenu;
								if (!m) return;
								// Native popover API: browser moves m into the top
								// layer, whose containing block is the initial
								// containing block (viewport). That's the ONLY
								// way fixed coords stay viewport-relative when
								// the dialog ancestor uses transform +
								// backdrop-filter (both establish containing
								// blocks for fixed descendants otherwise).
								m.style.left = x + 'px';
								m.style.top = y + 'px';
								if (!m.matches(':popover-open')) {
									try { m.showPopover(); } catch (e) { /* already open / not supported */ }
								}
							});
						},
						openRowMenuAtCursor(ev, session) {
							ev.preventDefault();
							this.positionAndShow(ev.clientX, ev.clientY, session);
						},
						openRowMenuAtButton(btn, session) {
							const r = btn.getBoundingClientRect();
							this.positionAndShow(r.left, r.bottom + 4, session);
						},
						closeRowMenu() {
							const m = this.$refs.rowMenu;
							if (m && m.matches(':popover-open')) {
								try { m.hidePopover(); } catch (e) { /* noop */ }
							}
							this.rowMenu = { x: 0, y: 0, session: null };
						}
					}"
					@keydown.escape.window="if ($refs.rowMenu && $refs.rowMenu.matches(':popover-open')) { closeRowMenu(); $event.stopPropagation(); }"
				>
					<!-- Search -->
					<div class="flex items-center gap-3 px-4 h-12 shrink-0 border-b border-border/30">
						@icon.Search(icon.Props{Class: "size-4 text-muted-foreground/70 shrink-0"})
						<input
							type="search"
							x-ref="threadSearchInput"
							x-model="threadSearchQuery"
							placeholder={ i18n.T(ctx, "Search your chats or start a new one…") }
							class="flex-1 bg-transparent border-0 outline-none text-sm text-foreground placeholder:text-muted-foreground/60 focus:ring-0 focus:outline-none"
							aria-label={ i18n.T(ctx, "Search conversations") }
						/>
						<template x-if="threadSearchQuery">
							<button
								type="button"
								@click="threadSearchQuery = ''; $refs.threadSearchInput?.focus()"
								class="size-6 rounded-md hover:bg-accent/60 flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors"
								title={ i18n.T(ctx, "Clear") }
							>
								@icon.X(icon.Props{Class: "size-3.5"})
							</button>
						</template>
						<kbd
							class="hidden sm:inline-flex items-center h-5 px-1.5 rounded border border-border/30 text-[10px] text-muted-foreground/70 bg-muted/20 font-medium"
							title={ i18n.T(ctx, "Close") }
						>esc</kbd>
					</div>
					<!-- Results -->
					<div
						x-ref="threadListScroll"
						class="flex-1 overflow-y-auto scrollbar-thin min-h-0 py-1"
						@scroll="__onSidebarScroll($event)"
					>
						<!-- New conversation: shown only when no query -->
						<template x-if="!threadSearchQuery">
							<button
								type="button"
								@click="createNewSession(); document.querySelector('[data-tui-dialog-close=\'threads-dialog\']')?.click()"
								class="group flex w-full items-center gap-3 px-4 py-2 text-sm outline-none hover:bg-accent/40 focus-visible:bg-accent/40 transition-colors text-start"
							>
								@icon.Plus(icon.Props{Class: "size-4 text-muted-foreground/80 group-hover:text-foreground shrink-0"})
								<span class="text-foreground/90 group-hover:text-foreground flex-1">{ i18n.T(ctx, "New conversation") }</span>
							</button>
						</template>
						<!-- Empty state -->
						<template x-if="sessions.length === 0 && !sessionsLoading && !threadSearchQuery">
							<div class="flex flex-col items-center justify-center gap-2 py-12 text-muted-foreground/70">
								@icon.MessagesSquare(icon.Props{Class: "size-8 opacity-40"})
								<p class="text-xs">{ i18n.T(ctx, "No conversations yet") }</p>
							</div>
						</template>
						<!-- No search matches -->
						<template x-if="sessions.length > 0 && getGroupedSessions().length === 0">
							<div class="flex flex-col items-center justify-center gap-2 py-10 text-muted-foreground/70">
								<p class="text-xs">{ i18n.T(ctx, "No matches") }</p>
							</div>
						</template>
						<!-- Grouped sessions -->
						<template x-for="group in getGroupedSessions()" :key="group.title">
							<div>
								<div class="px-4 pt-3 pb-0.5">
									<span
										class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/60"
										x-text="group.title"
									></span>
								</div>
								<template x-for="session in group.sessions" :key="session.id">
									<div class="group/item relative">
										<!--
											Inline rename overlay. startRename() sets
											renamingSessionId to this row's id; the
											overlay covers the row so row clicks can't
											interfere while the input is active.
										-->
										<div
											x-show="renamingSessionId === session.id"
											x-cloak
											class="absolute inset-x-2 inset-y-0 z-10 flex items-center gap-1 rounded-md bg-background/80 backdrop-blur-xl ring-1 ring-ring px-2"
										>
											<input
												type="text"
												x-model="renameTitle"
												x-effect="if (renamingSessionId === session.id) { $nextTick(() => { $el.focus(); $el.select(); }) }"
												@keydown.enter.prevent="submitRename()"
												@keydown.escape.prevent="cancelRename()"
												@click.stop
												maxlength="100"
												class="flex-1 bg-transparent border-0 outline-none text-sm text-foreground focus:ring-0"
											/>
											<button @click.stop="cancelRename()" type="button" class="size-6 rounded-md hover:bg-accent/60 flex items-center justify-center text-muted-foreground">
												@icon.X(icon.Props{Class: "size-3.5"})
											</button>
											<button @click.stop="submitRename()" type="button" class="size-6 rounded-md hover:bg-accent/60 flex items-center justify-center text-primary">
												@icon.Check(icon.Props{Class: "size-3.5"})
											</button>
										</div>
										<!-- Row -->
										<div
											role="button"
											tabindex="0"
											class="relative flex w-full cursor-pointer select-none items-center gap-3 px-4 py-1.5 text-sm outline-none transition-colors"
											:class="threadId === session.id ? 'bg-accent/50 text-foreground' : 'hover:bg-accent/30 focus-visible:bg-accent/30 text-foreground/90'"
											@click="switchSession(session.id); document.querySelector('[data-tui-dialog-close=\'threads-dialog\']')?.click()"
											@keydown.enter="switchSession(session.id); document.querySelector('[data-tui-dialog-close=\'threads-dialog\']')?.click()"
											@contextmenu="openRowMenuAtCursor($event, session)"
										>
											<!-- Active bar -->
											<div
												class="absolute inset-y-1 start-0 w-0.5 rounded-full transition-all"
												:class="threadId === session.id ? 'bg-primary' : 'bg-transparent'"
											></div>
											@icon.MessageCircle(icon.Props{Class: "size-3.5 text-muted-foreground/70 shrink-0"})
											<span
												class="truncate flex-1 min-w-0"
												x-text="session.title || window.i18n.t('New Chat')"
											></span>
											<!-- Three-dot: reveals on hover, opens the shared row menu -->
											<button
												type="button"
												@click.stop="openRowMenuAtButton($el, session)"
												class="size-6 inline-flex items-center justify-center rounded-md text-muted-foreground/70 hover:bg-accent/60 hover:text-foreground opacity-0 group-hover/item:opacity-100 focus-visible:opacity-100 transition-opacity shrink-0"
												:class="threadId === session.id ? 'opacity-100' : ''"
												:title="window.i18n.t('More')"
												aria-label={ i18n.T(ctx, "Thread actions") }
											>
												@icon.Ellipsis(icon.Props{Class: "size-3.5"})
											</button>
										</div>
									</div>
								</template>
							</div>
						</template>
						<!-- Infinite scroll sentinel -->
						<div x-show="sessionsHasMore" x-intersect="__loadMoreSessions()" class="flex justify-center py-3 h-8 w-full">
							<span x-show="sessionsLoading" class="animate-spin size-3.5 border-2 border-muted-foreground/30 border-t-primary rounded-full"></span>
						</div>
					</div>
					<!--
						Shared row context menu. Uses the native popover API so
						the browser moves it into the top layer when opened —
						that's the only way `fixed` stays viewport-relative
						inside a dialog whose ancestors have transform +
						backdrop-filter (both otherwise establish containing
						blocks for fixed descendants).

						inset-auto + m-0 defeat the browser's popover default
						styles (inset:0 + margin:auto otherwise centers it).
						Outside-click dismissal is wired via a document
						mousedown listener in x-init; we don't use
						popover="auto" because its light-dismiss races with
						trigger clicks and flickers the menu closed on open.
					-->
					<div
						x-ref="rowMenu"
						popover="manual"
						@contextmenu.prevent=""
						@toggle="if ($event.newState === 'closed') rowMenu.session = null"
						x-init="
							document.addEventListener('mousedown', (ev) => {
								if (!$el.matches(':popover-open')) return;
								if ($el.contains(ev.target)) return;
								closeRowMenu();
							}, true);
						"
						class="glass fixed inset-auto m-0 z-[100] min-w-[180px] rounded-lg shadow-xl p-1"
						role="menu"
					>
						<!--
							Only the actions that actually exist on the chat
							Alpine component (see assets/js/chat/chat-sessions.js).
							startRename / deleteSession are method calls, so we
							invoke them as Alpine expressions — that keeps the
							chat component as `this`. Passing a bare function
							reference through a wrapper strips the binding.
							Share / Duplicate / Archive aren't implemented on
							the chat component yet; reintroduce them here once
							the methods land.
						-->
						<button
							type="button"
							role="menuitem"
							@click="const id = rowMenu.session?.id; closeRowMenu(); if (id) startRename(id)"
							class="w-full flex items-center gap-2.5 px-2.5 py-1.5 text-sm rounded-md hover:bg-accent/50 text-foreground/90 hover:text-foreground text-start transition-colors"
						>
							@icon.Pencil(icon.Props{Class: "size-3.5 text-muted-foreground"})
							<span>{ i18n.T(ctx, "Rename") }</span>
						</button>
						<div class="h-px bg-border/40 my-1 -mx-1"></div>
						<button
							type="button"
							role="menuitem"
							@click="const id = rowMenu.session?.id; closeRowMenu(); if (id) deleteSession(id)"
							class="w-full flex items-center gap-2.5 px-2.5 py-1.5 text-sm rounded-md hover:bg-destructive/10 text-destructive/90 hover:text-destructive text-start transition-colors"
						>
							@icon.Trash2(icon.Props{Class: "size-3.5"})
							<span>{ i18n.T(ctx, "Delete") }</span>
						</button>
					</div>
				</div>
			}
		}
	</div>
}

// ThreadsButtonTrigger renders the threads icon button for the navbar.
// Icon is Telescope — the dialog is a temporal-order palette for
// exploring past conversations, so "peering into history" fits better
// than a speech bubble (which reads as "start a chat").
templ ThreadsButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "threads-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-threads-dialog')",
				"title":  i18n.T(ctx, "Chat History"),
			},
		}) {
			@icon.Telescope(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Chat History") }</span>
		}
	}
}
