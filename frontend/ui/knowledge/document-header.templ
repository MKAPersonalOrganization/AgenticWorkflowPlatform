package knowledge

/**
 * DocumentHeader - Header section for document management page.
 * Matches EdgeQuake edgequake_webui/src/components/documents/document-header.tsx
 *
 * Shows: title, document count badge, pipeline busy indicator, refresh button,
 * reprocess-failed button, and clear-all dialog trigger.
 */

import (
	"aicompass/frontend/components/badge"
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/components/label"
)

templ DocumentHeader() {
	<header class="flex items-center justify-between gap-3 flex-wrap">
		<div class="space-y-0.5">
			<div class="flex items-center gap-2">
				<h1 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "Documents") }</h1>
				<span
					x-show="totalCount > 0"
					x-cloak
				>
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs font-normal"}) {
						<span x-text="totalCount"></span>
					}
				</span>
				<!-- Connection Status Dot -->
				<span
					class="relative flex h-2 w-2"
					x-show="pipelineStatus"
					x-cloak
				>
					<span
						class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
						:class="pipelineStatus?.is_busy ? 'bg-blue-400' : 'bg-green-400'"
					></span>
					<span
						class="relative inline-flex rounded-full h-2 w-2"
						:class="pipelineStatus?.is_busy ? 'bg-blue-500' : 'bg-green-500'"
					></span>
				</span>
			</div>
			<p class="text-sm text-muted-foreground">
				{ i18n.T(ctx, "Upload, manage and track your documents through the ingestion pipeline.") }
			</p>
		</div>
		<div class="flex items-center gap-2 flex-wrap">
			<!-- Pipeline Busy Button -->
			<template x-if="pipelineStatus?.is_busy">
				<button
					@click="pipelineDialogOpen = true"
					class="inline-flex items-center gap-1 rounded-md border px-3 h-9 text-sm font-medium text-orange-500 hover:bg-orange-50 dark:hover:bg-orange-950/30 transition-colors"
				>
					<span class="animate-spin size-4 border-2 border-orange-500 border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Pipeline Busy") }
				</button>
			</template>
			<!-- Reprocess Failed -->
			<template x-if="docStatusCounts.failed > 0 || docStatusCounts.partial_failure > 0">
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"@click":    "reprocessFailed()",
						":disabled": "reprocessingFailed",
					},
				}) {
					<template x-if="reprocessingFailed">
						<span class="animate-spin size-3.5 border-2 border-primary border-t-transparent rounded-full me-1"></span>
					</template>
					@icon.RefreshCw(icon.Props{Class: "size-4 me-1"})
					{ i18n.T(ctx, "Retry Failed") }
				}
			</template>
			<!-- Refresh -->
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"@click": "refreshAll()",
				},
			}) {
				<span :class="isRefreshing && 'animate-spin'">
					@icon.RefreshCw(icon.Props{Class: "size-4 me-1"})
				</span>
				{ i18n.T(ctx, "Refresh") }
			}
			<!-- Clear All Documents (with confirmation dialog) -->
			<span x-show="totalCount > 0" x-cloak>
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"@click":    "window.tui.dialog.open('clear-all-dialog')",
						":disabled": "deletingAllDocs",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 me-1"})
					{ i18n.T(ctx, "Clear All") }
				}
			</span>
		</div>
	</header>
	<!-- Clear All Confirmation Dialog -->
	@dialog.Dialog(dialog.Props{ID: "clear-all-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{Class: "flex items-center gap-2 text-destructive"}) {
					@icon.TriangleAlert(icon.Props{Class: "size-5"})
					{ i18n.T(ctx, "Delete All Documents") }
				}
				@dialog.Description(dialog.DescriptionProps{Class: "space-y-3"}) {
					<p>{ i18n.T(ctx, "This action cannot be undone. This will permanently delete:") }</p>
					<ul class="list-disc list-inside space-y-1 text-sm">
						<li><span x-text="totalCount"></span> { i18n.T(ctx, "document(s)") }</li>
						<li>{ i18n.T(ctx, "All extracted entities and relationships") }</li>
						<li>{ i18n.T(ctx, "All document chunks and embeddings") }</li>
					</ul>
					<div class="pt-2" x-data="{ clearConfirmation: '' }">
						@label.Label(label.Props{For: "clear-confirmation", Class: "text-sm font-medium"}) {
							{ i18n.T(ctx, "Type DELETE ALL to confirm:") }
						}
						@input.Input(input.Props{
							ID:          "clear-confirmation",
							Placeholder: "DELETE ALL",
							Class:       "mt-2",
							Attributes: templ.Attributes{
								"x-model":      "clearConfirmation",
								"autocomplete": "off",
							},
						})
						<div class="flex justify-end gap-2 pt-4">
							@dialog.Close(dialog.CloseProps{}) {
								@button.Button(button.Props{Variant: button.VariantOutline}) {
									{ i18n.T(ctx, "Cancel") }
								}
							}
							@button.Button(button.Props{
								Class: "bg-destructive text-destructive-foreground hover:bg-destructive/90",
								Attributes: templ.Attributes{
									"@click":    "if (clearConfirmation === 'DELETE ALL') { deleteAllDocuments(); window.tui.dialog.close('clear-all-dialog'); clearConfirmation = ''; }",
									":disabled": "clearConfirmation !== 'DELETE ALL' || deletingAllDocs",
								},
							}) {
								<template x-if="deletingAllDocs">
									@icon.LoaderCircle(icon.Props{Class: "size-4 me-2 animate-spin"})
								</template>
								<span x-text="deletingAllDocs ? 'Deleting...' : 'Delete All Documents'"></span>
							}
						</div>
					</div>
				}
			}
		}
	}
}
