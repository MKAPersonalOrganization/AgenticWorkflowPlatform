package knowledge

/**
 * UploadProgressList - Shows upload progress for each file being uploaded.
 * Matches EdgeQuake edgequake_webui/src/components/documents/ingestion-progress-panel.tsx
 *
 * Shows: List of uploading files with filename, progress bar, status, cancel button.
 */

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
)

templ UploadProgressList() {
	<div x-show="uploadingFiles.length > 0" x-cloak class="space-y-2">
		<!-- Header -->
		<div class="flex items-center justify-between">
			<h4 class="text-sm font-medium flex items-center gap-2">
				@icon.Upload(icon.Props{Class: "size-4 text-primary"})
				<span>{ i18n.T(ctx, "Uploading") }</span>
				<span class="text-xs text-muted-foreground" x-text="'(' + uploadingFiles.length + ')'"></span>
			</h4>
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "h-7 text-xs",
				Attributes: templ.Attributes{
					"@click": "uploadingFiles = uploadingFiles.filter(f => f.progress < 100)",
					"x-show": "uploadingFiles.some(f => f.progress >= 100)",
				},
			}) {
				{ i18n.T(ctx, "Clear completed") }
			}
		</div>
		<!-- File list -->
		<div class="space-y-1.5 max-h-40 overflow-y-auto">
			<template x-for="(file, idx) in uploadingFiles" :key="file.name + idx">
				<div class="flex items-center gap-3 rounded-md border px-3 py-2 bg-card">
					<!-- File icon -->
					<div class="shrink-0" x-html="fileTypeIcon(file.name)"></div>
					<!-- Name + progress -->
					<div class="flex-1 min-w-0">
						<p class="text-sm truncate" x-text="file.name"></p>
						<div class="mt-1 h-1.5 rounded-full bg-muted overflow-hidden">
							<div
								class="h-full rounded-full transition-all duration-300"
								:class="file.error ? 'bg-destructive' : (file.progress >= 100 ? 'bg-success' : 'bg-primary')"
								:style="'width: ' + file.progress + '%'"
							></div>
						</div>
					</div>
					<!-- Status -->
					<div class="shrink-0 text-xs">
						<template x-if="file.error">
							<span class="text-destructive flex items-center gap-1">
								@icon.CircleX(icon.Props{Class: "size-3"})
								{ i18n.T(ctx, "Failed") }
							</span>
						</template>
						<template x-if="!file.error && file.progress >= 100">
							<span class="text-success flex items-center gap-1">
								@icon.CircleCheck(icon.Props{Class: "size-3"})
								{ i18n.T(ctx, "Done") }
							</span>
						</template>
						<template x-if="!file.error && file.progress < 100">
							<span class="text-muted-foreground" x-text="file.progress + '%'"></span>
						</template>
					</div>
					<!-- Cancel button (only while uploading) -->
					<template x-if="!file.error && file.progress < 100 && file.xhr">
						@button.Button(button.Props{
							Variant: button.VariantGhost,
							Size:    button.SizeIcon,
							Class:   "h-6 w-6",
							Attributes: templ.Attributes{
								"@click": "file.xhr.abort(); file.error = 'Cancelled'",
							},
						}) {
							@icon.X(icon.Props{Class: "size-3"})
						}
					</template>
				</div>
			</template>
		</div>
	</div>
}
