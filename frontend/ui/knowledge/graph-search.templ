package knowledge

/**
 * GraphSearch - Entity search with popover results list.
 * Matches EdgeQuake edgequake_webui/src/components/graph/graph-search.tsx
 *
 * Features:
 * - Popover with search input and results list
 * - Debounced local + server-side search
 * - Color-coded entity type indicators
 * - Keyboard shortcuts (⌘K, /)
 * - Keyboard navigation hints in footer
 * - Server result indicator (Cloud icon)
 */

import (
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/popover"
)

templ GraphSearch() {
	@popover.Root(popover.RootProps{ID: "graph-search-popover"}) {
		@popover.Trigger(popover.TriggerProps{
			Attributes: templ.Attributes{
				"id": "graph-search-trigger",
			},
		}) {
			<button
				class="inline-flex items-center justify-center rounded-md border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-8 gap-2 px-3 text-sm font-medium transition-colors"
				aria-label={ i18n.T(ctx, "Search nodes") }
			>
				@icon.Search(icon.Props{Class: "size-4"})
				<span class="hidden sm:inline text-xs">{ i18n.T(ctx, "Search nodes...") }</span>
				<kbd class="hidden lg:inline-flex h-5 items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
					<span class="text-xs">⌘</span>K
				</kbd>
			</button>
		}
		@popover.Content(popover.ContentProps{
			Placement: popover.PlacementBottomStart,
			Class:     "w-96 p-0",
		}) {
		<div
			x-data="{
				query: '',
				results: [],
				serverResults: [],
				isSearching: false,
				isServerSearching: false,
				selectedIndex: -1,
				searchTimeout: null,
				
				async search() {
					const q = this.query.trim();
					if (!q) {
						this.results = getRecentNodes ? getRecentNodes(8) : [];
						this.serverResults = [];
						return;
					}
					this.isSearching = true;
					this.results = searchGraphLocal ? searchGraphLocal(q) : [];
					this.isSearching = false;
					
					if (q.length >= 2 && typeof searchGraphServer === 'function') {
						this.isServerSearching = true;
						try {
							this.serverResults = await searchGraphServer(q);
						} catch(e) {
							this.serverResults = [];
						}
						this.isServerSearching = false;
					}
				},
				
				get combinedResults() {
					if (this.serverResults.length > 0) return this.serverResults;
					return this.results;
				},
				
				selectResult(result) {
					focusNode(result.id);
					this.query = '';
					this.results = [];
					this.serverResults = [];
					document.getElementById('graph-search-popover')?.dispatchEvent(new Event('close'));
				},
				
				handleKeydown(e) {
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						this.selectedIndex = Math.min(this.selectedIndex + 1, this.combinedResults.length - 1);
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						this.selectedIndex = Math.max(this.selectedIndex - 1, 0);
					} else if (e.key === 'Enter' && this.selectedIndex >= 0) {
						e.preventDefault();
						this.selectResult(this.combinedResults[this.selectedIndex]);
					}
				}
			}"
			@keydown.window.prevent.ctrl.k="$refs.searchInput.focus(); document.getElementById('graph-search-trigger')?.click()"
			@keydown.window.prevent.meta.k="$refs.searchInput.focus(); document.getElementById('graph-search-trigger')?.click()"
			role="dialog"
			aria-label={ i18n.T(ctx, "Search nodes") }
		>
			<!-- Search Input -->
			<div class="flex items-center border-b px-3 py-1 bg-muted/30">
				<template x-if="isSearching">
					@icon.Loader(icon.Props{Class: "me-2 size-4 shrink-0 animate-spin text-muted-foreground"})
				</template>
				<template x-if="!isSearching">
					@icon.Search(icon.Props{Class: "me-2 size-4 shrink-0 text-muted-foreground"})
				</template>
				<input
					x-ref="searchInput"
					type="text"
					x-model="query"
					@input.debounce.150ms="search()"
					@keydown="handleKeydown($event)"
					placeholder={ i18n.T(ctx, "Search nodes...") }
					class="flex h-10 w-full bg-transparent py-3 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50"
					aria-label={ i18n.T(ctx, "Search nodes") }
				/>
			</div>
			<!-- Results -->
			<div class="max-h-80 overflow-y-auto">
				<!-- Server searching indicator -->
				<template x-if="isServerSearching">
					<div class="py-4 text-center text-sm text-muted-foreground flex items-center justify-center gap-2">
						@icon.Loader(icon.Props{Class: "size-4 animate-spin"})
						<span>{ i18n.T(ctx, "Searching full database...") }</span>
					</div>
				</template>
				<!-- No results -->
				<template x-if="combinedResults.length === 0 && query.trim() && !isServerSearching">
					<div class="py-6 text-center text-sm text-muted-foreground">
						{ i18n.T(ctx, "No nodes found") }
					</div>
				</template>
				<!-- Results list -->
				<template x-if="combinedResults.length > 0">
					<div>
						<div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">
							<span x-text="serverResults.length > 0 ? 'Server Results' : (query.trim() ? 'Results' : 'Nodes')"></span>
						</div>
						<template x-for="(result, index) in combinedResults" :key="result.id">
							<button
								@click="selectResult(result)"
								class="flex items-start gap-3 px-3 py-2 cursor-pointer w-full text-start transition-colors rounded-sm"
								:class="index === selectedIndex ? 'bg-accent text-accent-foreground' : 'hover:bg-accent/50'"
								role="option"
								:aria-selected="index === selectedIndex"
							>
								<svg class="size-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor" :style="`color: ${entityColors[result.entityType || result.node_type] || '#64748b'}`">
									<circle cx="12" cy="12" r="10"></circle>
								</svg>
								<div class="flex-1 min-w-0">
									<div class="flex items-center gap-2">
										<span class="font-medium truncate text-sm" x-text="result.label"></span>
										<template x-if="result.entityType || result.node_type">
											<span class="text-xs text-muted-foreground bg-muted px-1.5 py-0.5 rounded shrink-0" x-text="result.entityType || result.node_type"></span>
										</template>
										<template x-if="result.isServerResult">
											@icon.Cloud(icon.Props{Class: "size-3 text-blue-500 shrink-0"})
										</template>
									</div>
									<template x-if="result.description">
										<p class="text-xs text-muted-foreground truncate mt-0.5" x-text="result.description"></p>
									</template>
								</div>
							</button>
						</template>
					</div>
				</template>
			</div>
			<!-- Keyboard hints footer -->
			<div class="border-t px-3 py-2 text-xs text-muted-foreground flex items-center gap-4">
				<span class="flex items-center gap-1">
					<kbd class="px-1 py-0.5 bg-muted rounded text-[10px]">↑↓</kbd>
					{ i18n.T(ctx, "Navigate") }
				</span>
				<span class="flex items-center gap-1">
					<kbd class="px-1 py-0.5 bg-muted rounded text-[10px]">↵</kbd>
					{ i18n.T(ctx, "Select") }
				</span>
				<span class="flex items-center gap-1">
					<kbd class="px-1 py-0.5 bg-muted rounded text-[10px]">esc</kbd>
					{ i18n.T(ctx, "Close") }
				</span>
			</div>
		</div>
		}
	}
}
