package knowledge

import (
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
)

templ KeyboardShortcutsHelp() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "graph-shortcuts-help",
	}) {
		<button
			class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-8 w-8"
			aria-label="Keyboard shortcuts"
		>
			@icon.Keyboard(icon.Props{Class: "size-4"})
		</button>
	}
}

// KeyboardShortcutsDialog renders the dialog overlay + content.
// Must be placed OUTSIDE any stacking context (e.g., outside the toolbar header)
// so that its fixed-position backdrop and content float above the entire page.
templ KeyboardShortcutsDialog() {
	@dialog.Dialog(dialog.Props{
		ID:    "graph-shortcuts-help",
		Class: "max-w-md",
	}) {
		@dialog.Content(dialog.ContentProps{}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					<span class="flex items-center gap-2">
						@icon.Keyboard(icon.Props{Class: "size-5"})
						{ i18n.T(ctx, "Keyboard Shortcuts") }
					</span>
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ i18n.T(ctx, "Use these shortcuts to navigate the graph efficiently.") }
				}
			}
			<div class="space-y-6 pt-4">
				<!-- Navigation -->
				<div>
					<h4 class="text-sm font-medium text-muted-foreground mb-3">
						{ i18n.T(ctx, "Navigation") }
					</h4>
					<div class="space-y-2">
						@ShortcutRow(i18n.T(ctx, "Next node"), "Tab")
						@ShortcutRow(i18n.T(ctx, "Previous node"), "Shift+Tab")
						@ShortcutRow(i18n.T(ctx, "Navigate nodes"), "↑+↓+←+→")
						@ShortcutRow(i18n.T(ctx, "Focus on selected node"), "Enter")
						@ShortcutRow(i18n.T(ctx, "Deselect node"), "Escape")
					</div>
				</div>
				<!-- View Controls -->
				<div>
					<h4 class="text-sm font-medium text-muted-foreground mb-3">
						{ i18n.T(ctx, "View Controls") }
					</h4>
					<div class="space-y-2">
						@ShortcutRow(i18n.T(ctx, "Zoom in"), "+")
						@ShortcutRow(i18n.T(ctx, "Zoom out"), "-")
						@ShortcutRow(i18n.T(ctx, "Reset view"), "0")
						@ShortcutRow(i18n.T(ctx, "Toggle fullscreen"), "F")
					</div>
				</div>
				<!-- Search -->
				<div>
					<h4 class="text-sm font-medium text-muted-foreground mb-3">
						{ i18n.T(ctx, "Search") }
					</h4>
					<div class="space-y-2">
						@ShortcutRow(i18n.T(ctx, "Open search"), "⌘+K")
						@ShortcutRow(i18n.T(ctx, "Quick search"), "/")
					</div>
				</div>
			</div>
			<div class="pt-4 border-t mt-4">
				<p class="text-xs text-muted-foreground text-center">
					{ i18n.T(ctx, "Press") }
					<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-muted rounded border">?</kbd>
					{ i18n.T(ctx, "to show this dialog anytime") }
				</p>
			</div>
			@dialog.Footer(dialog.FooterProps{}) {
				@dialog.Close(dialog.CloseProps{}) {
					{ i18n.T(ctx, "Got it!") }
				}
			}
		}
	}
}

templ ShortcutRow(label string, shortcut string) {
	<div class="flex items-center justify-between text-sm">
		<span class="text-foreground">{ label }</span>
		<div class="flex items-center gap-1">
			for i, key := range splitKeys(shortcut) {
				if i > 0 {
					<span class="text-muted-foreground">+</span>
				}
				<kbd class="px-2 py-1 text-xs font-mono bg-muted rounded border border-border">
					{ key }
				</kbd>
			}
		</div>
	</div>
}

func splitKeys(s string) []string {
	var keys []string
	current := ""
	for i := 0; i < len(s); i++ {
		if s[i] == '+' {
			if current != "" {
				keys = append(keys, current)
			}
			current = ""
			continue
		}
		current += string(s[i])
	}
	if current != "" {
		keys = append(keys, current)
	}
	return keys
}
