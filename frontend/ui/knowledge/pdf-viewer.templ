package knowledge

import (
	"fmt"
	"aicompass/frontend/components/button"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
)

type PDFViewerProps struct {
	URL    string
	Height int
}

templ PDFViewer(props PDFViewerProps) {
	<div
		x-data={ "pdfViewer('" + props.URL + "')" }
		class="flex flex-col h-full bg-muted/10 rounded-lg overflow-hidden border"
	>
		<!-- Toolbar -->
		<div class="flex items-center justify-between gap-2 p-2 border-b bg-muted/30 shrink-0">
			<!-- Page Navigation -->
			<div class="flex items-center gap-1">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "prevPage()",
						":disabled": "pageNum <= 1 || isLoading",
					},
				}) {
					@icon.ChevronLeft(icon.Props{Class: "size-4"})
				}
				<span class="text-sm text-muted-foreground min-w-[80px] text-center font-medium tabular-nums">
					<template x-if="isLoading">
						<span>...</span>
					</template>
					<template x-if="!isLoading">
						<span x-text="`${pageNum} / ${numPages}`"></span>
					</template>
				</span>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "nextPage()",
						":disabled": "pageNum >= numPages || isLoading",
					},
				}) {
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				}
			</div>
			<!-- Zoom Controls -->
			<div class="flex items-center gap-1">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "zoomOut()",
						":disabled": "scale <= 0.5 || isLoading",
					},
				}) {
					@icon.ZoomOut(icon.Props{Class: "size-4"})
				}
				<span class="text-sm text-muted-foreground min-w-[50px] text-center font-medium tabular-nums" x-text="`${Math.round(scale * 100)}%`"></span>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click":    "zoomIn()",
						":disabled": "scale >= 3.0 || isLoading",
					},
				}) {
					@icon.ZoomIn(icon.Props{Class: "size-4"})
				}
				<div class="w-px h-4 bg-border mx-1"></div>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "h-8 w-8",
					Attributes: templ.Attributes{
						"@click": "resetZoom()",
					},
				}) {
					@icon.Maximize(icon.Props{Class: "size-4"})
				}
			</div>
		</div>
		<!-- Scroll Area -->
		<div
			class="flex-1 overflow-auto bg-muted/10 flex flex-col items-center py-4 relative custom-scrollbar scroll-smooth"
			style={ fmt.Sprintf("height: %dpx; -webkit-overflow-scrolling: touch;", props.Height) }
		>
			<!-- Loading state -->
			<template x-if="isLoading">
				<div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-background/50 backdrop-blur-sm z-10">
					<div class="animate-spin size-8 border-2 border-primary border-t-transparent rounded-full"></div>
					<p class="text-sm text-muted-foreground tracking-wide font-medium">{ i18n.T(ctx, "Loading PDF...") }</p>
				</div>
			</template>
			<!-- Error state -->
			<template x-if="error">
				<div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center bg-background/80 z-20">
					<div class="bg-destructive/10 text-destructive p-3 rounded-full mb-4">
						@icon.TriangleAlert(icon.Props{Class: "size-8"})
					</div>
					<h3 class="font-semibold text-destructive border-none mb-1">{ i18n.T(ctx, "Failed to load PDF") }</h3>
					<p class="text-xs text-destructive/80 mb-6 max-w-xs" x-text="error"></p>
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: templ.Attributes{
							"@click": "init()",
						},
					}) {
						@icon.RefreshCw(icon.Props{Class: "size-3 me-1.5"})
						{ i18n.T(ctx, "Retry") }
					}
				</div>
			</template>
			<!-- Canvas Container -->
			<div
				class="bg-white shadow-2xl ring-1 ring-black/5 relative"
				:class="{ 'opacity-0': isLoading || error }"
			>
				<canvas x-ref="pdfCanvas" class="max-w-full h-auto block"></canvas>
			</div>
		</div>
	</div>
}
