package knowledge

/**
 * FilesTab - Uploaded files listing tab.
 * Extracted from workspace_details.templ Files tab content.
 *
 * Contains: Search bar, file table with loading/empty states,
 * pagination, and per-file actions (reprocess, delete).
 */

import (
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
)

templ FilesTab() {
	<div class="space-y-4 mt-4">
		<div class="flex items-center justify-between">
			<h2 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "Uploaded Files") }</h2>
			<div class="relative w-full max-w-sm">
				@icon.Search(icon.Props{Class: "absolute start-2.5 top-2.5 size-4 text-muted-foreground"})
				<input
					type="search"
					placeholder={ i18n.T(ctx, "Search files...") }
					class="flex h-9 w-full rounded-md border border-input bg-transparent ps-9 pe-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
					x-model.debounce.300ms="fileSearch"
					@input="filePage = 1; loadFiles()"
				/>
			</div>
		</div>
		<!-- Loading State -->
		<div x-show="filesLoading" class="space-y-3">
			<template x-for="i in 5" :key="i">
				<div class="h-16 rounded-lg bg-muted animate-pulse"></div>
			</template>
		</div>
		<!-- Files Table -->
		<div x-show="!filesLoading && files.length > 0" x-cloak>
			<div class="rounded-xl border bg-card shadow-sm overflow-hidden">
				<table class="w-full caption-bottom text-sm">
					<thead>
						<tr class="border-b bg-muted/50">
							<th class="h-12 px-4 text-start align-middle font-medium text-muted-foreground w-8">
								<input
									type="checkbox"
									@change="toggleSelectAllFiles($event.target.checked)"
									:checked="selectedFiles.length === files.length && files.length > 0"
									class="rounded border-input text-primary focus:ring-primary"
								/>
							</th>
							<th class="h-12 px-4 text-start align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "File Name") }</th>
							<th class="h-12 px-4 text-start align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Size") }</th>
							<th class="h-12 px-4 text-start align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Status") }</th>
							<th class="h-12 px-4 text-start align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Uploaded") }</th>
							<th class="h-12 px-4 text-end align-middle font-medium text-muted-foreground">{ i18n.T(ctx, "Actions") }</th>
						</tr>
					</thead>
					<tbody>
						<template x-for="file in files" :key="file.pdf_id">
							<tr class="border-b transition-colors hover:bg-muted/50" :class="{ 'bg-primary/5': selectedFiles.includes(file.pdf_id) }">
								<td class="p-4 align-middle">
									<input
										type="checkbox"
										:value="file.pdf_id"
										x-model="selectedFiles"
										class="rounded border-input text-primary focus:ring-primary"
									/>
								</td>
								<td class="p-4 align-middle font-medium">
									<div class="flex items-center gap-2">
										@icon.FileText(icon.Props{Class: "size-4 text-muted-foreground shrink-0"})
										<span class="truncate max-w-[300px]" x-text="file.filename"></span>
									</div>
								</td>
								<td class="p-4 align-middle text-muted-foreground" x-text="formatBytes(file.file_size_bytes)"></td>
								<td class="p-4 align-middle">
									<span
										class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium"
										:class="{
											'bg-success/15 text-success': file.status === 'completed',
											'bg-info/15 text-info': file.status === 'processing',
											'bg-warning/15 text-warning': file.status === 'pending',
											'bg-destructive/15 text-destructive': file.status === 'failed',
										}"
										x-text="file.status || 'uploaded'"
									></span>
								</td>
								<td class="p-4 align-middle text-muted-foreground" x-text="formatDate(file.uploaded_at || file.created_at)"></td>
								<td class="p-4 align-middle text-end">
									<div class="flex items-center justify-end gap-1">
										<button
											x-show="file.status === 'failed'"
											@click="retryPdf(file.pdf_id)"
											class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-warning/10 hover:text-warning h-8 w-8"
											title="Retry"
										>
											@icon.RotateCcw(icon.Props{Class: "size-4"})
										</button>
										<button
											@click="deleteFile(file.pdf_id, file.filename)"
											class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-destructive/10 hover:text-destructive h-8 w-8"
											title="Delete"
										>
											@icon.Trash2(icon.Props{Class: "size-4"})
										</button>
									</div>
								</td>
							</tr>
						</template>
					</tbody>
				</table>
				<!-- Pagination -->
				<div class="flex items-center justify-between py-3 px-4 border-t bg-muted/30">
					<span class="text-sm text-muted-foreground" x-text="`${fileTotal} files total`"></span>
					<div class="flex items-center gap-2">
						<button
							@click="filePage = Math.max(1, filePage - 1); loadFiles()"
							:disabled="filePage <= 1"
							class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-8 w-8 border disabled:opacity-50"
						>
							@icon.ChevronLeft(icon.Props{Class: "size-4"})
						</button>
						<span class="text-sm text-muted-foreground" x-text="`Page ${filePage} of ${fileTotalPages || 1}`"></span>
						<button
							@click="filePage = Math.min(fileTotalPages, filePage + 1); loadFiles()"
							:disabled="filePage >= fileTotalPages"
							class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-muted h-8 w-8 border disabled:opacity-50"
						>
							@icon.ChevronRight(icon.Props{Class: "size-4"})
						</button>
					</div>
				</div>
			</div>
		</div>
		<!-- Empty State -->
		<div x-show="!filesLoading && files.length === 0" x-cloak class="flex flex-col items-center justify-center py-20 text-center">
			@icon.File(icon.Props{Class: "size-10 text-muted-foreground mb-4"})
			<h3 class="text-lg font-semibold">{ i18n.T(ctx, "No files uploaded") }</h3>
			<p class="text-sm text-muted-foreground mt-1">{ i18n.T(ctx, "Upload your first document to get started.") }</p>
		</div>
	</div>
}
