package chat

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// ActivityToggle renders the chat-header trigger for the floating
// multi-agent Activity panel. It only appears when the current session
// has at least one multi-agent turn (i.e. there's something worth
// showing). A pulsing primary dot indicates a live run.
//
// The panel itself is a free-floating, draggable, minimizable window —
// not part of the right sidebar — so this toggle just opens / minimizes
// it via toggleActivityPanel().
templ ActivityToggle() {
	<div x-show="hasWorkflowGraph || hasActivity" x-cloak x-transition.opacity>
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9 relative text-muted-foreground hover:text-foreground hover:bg-muted/50 rounded-md transition-colors",
			Attributes: templ.Attributes{
				"title":  i18n.T(ctx, "Activity"),
				"@click": "toggleActivityPanel()",
			},
		}) {
			@icon.Workflow(icon.Props{Class: "size-5"})
			<!-- Live indicator dot (pulses while a multi-agent run streams) -->
			<span
				x-show="isStreaming && hasActivity"
				x-cloak
				class="absolute top-1.5 right-1.5 size-2 rounded-full bg-primary ring-2 ring-background"
			>
				<span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-75"></span>
			</span>
		}
	</div>
}
