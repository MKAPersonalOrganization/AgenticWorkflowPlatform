package chat

import "aicompass/frontend/components/button"
import "aicompass/frontend/ui/i18n"
import "aicompass/frontend/components/icon"

// Header renders the desktop chat header with action buttons.
// The Agent Designer trigger used to live here; it now lives in the app's
// global TopBar (frontend/ui/nav/navbar.templ) so it's reachable from any
// view, not only the chat view.
templ Header() {
	<div class="absolute top-0 z-10 hidden md:flex h-14 w-full items-center justify-between p-2 font-semibold">
		<div class="flex items-center gap-2"></div>
		<div class="flex items-center gap-2">
			<!-- Right Side Actions -->
			<!-- New Chat -->
			<div x-show="hasMessages || isStreaming" x-cloak>
				@button.Button(button.Props{
					Size:    button.SizeIcon,
					Variant: button.VariantGhost,
					Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-accent/60 rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
					Attributes: templ.Attributes{
						"@click": "createNewSession()",
						"title":  i18n.T(ctx, "New Chat"),
					},
				}) {
					@icon.SquarePen(icon.Props{Class: "size-5"})
				}
			</div>
			<!-- Search Toggle -->
			<div x-show="hasMessages" x-cloak x-transition.opacity>
				@Search()
			</div>
			<!-- Debugger toggle moved to the global BottomBar. -->
			<!-- Activity Toggle (multi-agent workflow side panel) -->
			@ActivityToggle()
			<!-- Artifacts Toggle -->
			@ArtifactsToggle()
		</div>
	</div>
}
