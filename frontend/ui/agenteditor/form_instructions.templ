package agenteditor

import (
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/textarea"
	"aicompass/frontend/ui/i18n"
)

// formInstructionsSection renders the system-prompt card with its
// ADK-instruction template-variable autocomplete popover. Typing '{'
// opens a picker anchored below the textarea listing live OutputKeys
// plus ADK syntax hints ({key?}, {artifact.name}, {user:key}, {app:key},
// {temp:key}). Regex and scope rules match
// .READ/adk-go/internal/llminternal/instruction_processor.go. Parent card
// uses overflow-visible so the popover isn't clipped by the rounded
// border. @mousedown.prevent on items keeps textarea focus so the blur
// handler doesn't swallow the click.
templ formInstructionsSection() {
	<div class="rounded-xl border border-border bg-card">
		<div class="flex items-center gap-2 px-4 py-2.5 bg-linear-to-r from-amber-500/5 to-transparent border-b border-border/50 rounded-t-xl">
			<div class="size-6 rounded-md bg-amber-500/10 flex items-center justify-center">
				@icon.FileText(icon.Props{Class: "size-3.5 text-amber-600 dark:text-amber-400"})
			</div>
			<span class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "Instructions") }</span>
			<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Define the agent's behavior") }</span>
		</div>
		<div class="p-4 space-y-3">
			<div class="relative">
				@textarea.Textarea(textarea.Props{
					Placeholder: i18n.T(ctx, "Define this agent's role, expertise, and behavior..."),
					Class:       "min-h-[140px] resize-y text-sm leading-relaxed",
					Rows:        6,
					Attributes: templ.Attributes{
						"x-model":  "form.systemPrompt",
						"x-ref":    "promptTextarea",
						"@input":   "handlePromptInput($event)",
						"@keydown": "handlePromptKeydown($event)",
						"@blur":    "setTimeout(() => closePromptAutocomplete(), 150)",
					},
				})
				@promptAutocompletePopover()
			</div>
			<p class="text-[10px] text-muted-foreground leading-relaxed">
				@icon.Info(icon.Props{Class: "size-3 inline me-0.5"})
				{ i18n.T(ctx, "Describe the agent's role, expertise, and behavior. Type { to reference an upstream agent's output by key. Append ? to make a reference optional.") }
			</p>
			@unknownPromptKeysWarning()
		</div>
	</div>
}

// promptAutocompletePopover is the `{`-triggered template-variable
// picker. Rendered as an absolute-positioned sibling of the textarea so
// the parent card's overflow-visible lets it escape the border radius.
templ promptAutocompletePopover() {
	<div
		x-show="promptAutocomplete.open && promptAutocomplete.items.length > 0"
		x-cloak
		@mousedown.prevent
		class="absolute left-0 right-0 top-full mt-1 z-50 max-h-72 overflow-y-auto rounded-lg border border-border bg-popover text-popover-foreground shadow-xl"
	>
		<div class="sticky top-0 px-3 py-1.5 text-[10px] font-semibold text-muted-foreground uppercase tracking-wider border-b border-border/50 bg-popover">
			{ i18n.T(ctx, "Template variables") }
			<span class="font-normal normal-case tracking-normal text-[9px] ms-1 text-muted-foreground/70" x-text="promptAutocomplete.query ? 'matching \'' + promptAutocomplete.query + '\'' : (promptAutocomplete.items.length + ' available')"></span>
		</div>
		<template x-for="(item, idx) in promptAutocomplete.items" :key="item.kind + ':' + item.key">
			<div>
				<!-- Tier divider: shown above the first row of each priority group.
				     Mirrors ADK's sample usage (self → direct sub-agent → workflow
				     peer → library → syntax reference) so non-programmers see *why*
				     this key is being suggested. -->
				<template x-if="promptShowGroupHeader(idx)">
					<div class="px-3 py-1 text-[9px] font-semibold uppercase tracking-wider text-muted-foreground/80 bg-muted/40 border-y border-border/40" x-text="promptSuggestionGroup(item)"></div>
				</template>
				<button
					type="button"
					class="flex w-full items-center gap-2 px-3 py-2 text-left text-xs hover:bg-accent transition-colors"
					:class="idx === promptAutocomplete.activeIndex ? 'bg-accent' : ''"
					@mousedown.prevent="insertStateKey($refs.promptTextarea, item)"
					@mouseenter="promptAutocomplete.activeIndex = idx"
				>
					<span
						class="inline-flex items-center justify-center size-5 rounded text-[10px] font-semibold shrink-0"
						:class="{
							'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400': item.scope === 'session',
							'bg-muted text-muted-foreground': item.scope === 'optional',
						}"
						x-text="(item.scope || 's').charAt(0).toUpperCase()"
					></span>
					<span class="font-mono text-foreground shrink-0" x-text="'{' + item.key + '}'"></span>
					<span class="ms-auto text-[10px] text-muted-foreground truncate min-w-0" x-text="item.source"></span>
				</button>
			</div>
		</template>
		<div class="sticky bottom-0 px-3 py-1.5 text-[9px] text-muted-foreground border-t border-border/50 bg-popover flex items-center gap-3">
			<span><kbd class="font-mono">↑↓</kbd> { i18n.T(ctx, "navigate") }</span>
			<span><kbd class="font-mono">↵</kbd> { i18n.T(ctx, "insert") }</span>
			<span><kbd class="font-mono">esc</kbd> { i18n.T(ctx, "close") }</span>
		</div>
	</div>
}

// unknownPromptKeysWarning surfaces `{key}` references that don't match
// any known OutputKey in the designer's current context. ADK raises at
// runtime if the key isn't in session state (unless the user wrote
// {key?}), so catching this here saves a round-trip.
templ unknownPromptKeysWarning() {
	<div
		x-show="unknownPromptKeys.length > 0"
		x-cloak
		class="rounded-md border border-amber-500/30 bg-amber-500/5 px-3 py-2"
	>
		<div class="flex items-start gap-2 text-[11px] text-amber-700 dark:text-amber-400">
			@icon.TriangleAlert(icon.Props{Class: "size-3.5 shrink-0 mt-0.5"})
			<div class="flex-1 min-w-0">
				<div class="font-medium">{ i18n.T(ctx, "Unknown template variables") }</div>
				<div class="text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "These references don't match any known output key. The run will fail at execution time unless you append ? to make them optional.") }
				</div>
				<div class="mt-1 flex flex-wrap gap-1">
					<template x-for="k in unknownPromptKeys" :key="k">
						<code class="px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 dark:text-amber-300 text-[10px] font-mono" x-text="'{' + k + '}'"></code>
					</template>
				</div>
			</div>
		</div>
	</div>
}
