package agenteditor

import (
	"aicompass/frontend/components/badge"
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/ui/i18n"
)

// listView is the default entry screen for AgentDesignerDialog: a search
// box, New Agent / Delete All actions, and a responsive card grid of the
// user's saved agents (simple + composed). Click on a card routes to the
// appropriate edit form; click the trash icon triggers confirm flow.
templ listView() {
	<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
		<div class="flex flex-col flex-1 overflow-hidden">
			<div class="px-4 pt-3 pb-2 flex items-center gap-2">
				<div class="flex-1">
					@input.Input(input.Props{
						Type:        input.TypeSearch,
						Placeholder: i18n.T(ctx, "Search agents..."),
						Class:       "h-9 border-transparent focus-within:bg-background",
						Attributes: templ.Attributes{
							"x-model.debounce.300ms": "searchQuery",
							"@input":                 "searchAgents()",
						},
					})
				</div>
				@button.Button(button.Props{
					Size:    button.SizeSm,
					Variant: button.VariantDefault,
					Class:   "gap-1.5 shrink-0",
					Attributes: templ.Attributes{
						"@click": "view = 'typeSelect'",
					},
				}) {
					@icon.Plus(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "New Agent") }
				}
				@button.Button(button.Props{
					Size:    button.SizeSm,
					Variant: button.VariantGhost,
					Class:   "gap-1.5 shrink-0 text-destructive hover:text-destructive hover:bg-destructive/10",
					Attributes: templ.Attributes{
						"@click": "confirmDeleteAll()",
						"x-show": "agents.length > 0",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "Delete All") }
				}
			</div>
			<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
				<template x-if="loading">
					<div class="space-y-3">
						<template x-for="i in 3" :key="i">
							<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
								<div class="size-10 rounded-lg bg-muted"></div>
								<div class="flex-1 space-y-2">
									<div class="h-4 bg-muted rounded-md w-1/3"></div>
									<div class="h-3 bg-muted rounded-md w-2/3"></div>
								</div>
							</div>
						</template>
					</div>
				</template>
				<template x-if="!loading">
					<div>
						<template x-if="filteredAgents.length === 0">
							@listEmptyState()
						</template>
						<!-- Agent Cards Grid -->
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
							<template x-for="ag in filteredAgents" :key="ag.id">
								@listAgentCard()
							</template>
						</div>
					</div>
				</template>
			</div>
		</div>
	</div>
}

// listEmptyState is the empty-state panel shown when filteredAgents is
// empty: either a "no results" hint when a search is active, or the
// onboarding "build your first AI agent" CTA otherwise.
templ listEmptyState() {
	<div class="flex flex-col items-center justify-center py-12 gap-4">
		<!-- Decorative icon ring -->
		<div class="relative">
			<div class="size-20 rounded-full bg-linear-to-br from-primary/10 to-primary/5 flex items-center justify-center ring-1 ring-primary/10">
				@icon.DraftingCompass(icon.Props{Class: "size-8 opacity-30 text-primary"})
			</div>
			<!-- Floating dots -->
			<div class="absolute -top-1 -right-2 size-2.5 rounded-full bg-emerald-400/30 animate-pulse"></div>
			<div class="absolute -bottom-1 -left-3 size-2 rounded-full bg-indigo-400/30 animate-pulse" style="animation-delay: 0.5s"></div>
			<div class="absolute top-1 -left-2 size-1.5 rounded-full bg-amber-400/30 animate-pulse" style="animation-delay: 1s"></div>
		</div>
		<template x-if="searchQuery">
			<div class="text-center">
				<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "No agents found") }</p>
				<p class="text-xs mt-1 text-muted-foreground">{ i18n.T(ctx, "Try a different search term.") }</p>
			</div>
		</template>
		<template x-if="!searchQuery">
			<div class="text-center max-w-xs">
				<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Build your first AI agent") }</p>
				<p class="text-xs mt-1.5 text-muted-foreground leading-relaxed">{ i18n.T(ctx, "Create a single agent with custom instructions, or orchestrate multiple agents in a workflow.") }</p>
				<!-- Quick action steps -->
				<div class="mt-5 space-y-2.5">
					<button
						@click="view = 'typeSelect'"
						class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-medium hover:bg-primary/90 transition-colors shadow-sm"
					>
						@icon.Plus(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "Create an Agent") }
					</button>
					<div class="flex items-center gap-3 text-[10px] text-muted-foreground justify-center pt-1">
						<span class="flex items-center gap-1"><span class="size-1.5 rounded-full bg-emerald-400/60 inline-block"></span> Single Agent</span>
						<span class="flex items-center gap-1"><span class="size-1.5 rounded-full bg-indigo-400/60 inline-block"></span> Workflow</span>
						<span class="flex items-center gap-1"><span class="size-1.5 rounded-full bg-amber-400/60 inline-block"></span> Import YAML</span>
					</div>
				</div>
			</div>
		</template>
	</div>
}

// listAgentCard renders one agent card in the grid. Click-through opens
// the correct editor (single-agent form vs. workflow designer); the
// hover-only delete button short-circuits the parent click.
templ listAgentCard() {
	<div
		class="group relative rounded-xl border border-border hover:border-primary/40 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer overflow-hidden bg-card"
		:class="ag.isComposed ? 'hover:border-indigo-400/40 hover:shadow-indigo-500/5' : 'hover:shadow-primary/5'"
		@click="ag.isComposed ? showEditPipelineForm(ag) : showEditNodeForm(ag)"
	>
		<!-- Subtle gradient overlay on hover -->
		<div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
			:class="ag.isComposed
				? 'bg-linear-to-br from-indigo-500/5 via-transparent to-transparent'
				: 'bg-linear-to-br from-primary/5 via-transparent to-transparent'">
		</div>
		<div class="relative p-4">
			<div class="flex items-start gap-3">
				<!-- Agent Icon -->
				<div
					class="size-10 rounded-lg flex items-center justify-center shrink-0 [&_svg]:size-5 ring-1 ring-border/50 group-hover:ring-primary/20 transition-all duration-200"
					:class="ag.isComposed ? 'bg-linear-to-br from-indigo-500/15 to-indigo-500/5 text-indigo-600 dark:text-indigo-400 group-hover:ring-indigo-400/30' : 'bg-linear-to-br from-primary/15 to-primary/5 text-primary'"
				>
					<template x-if="ag.isComposed">
						@icon.GitBranch(icon.Props{Class: "size-5"})
					</template>
					<template x-if="!ag.isComposed">
						<span x-html="ag.icon"></span>
					</template>
				</div>
				<div class="flex-1 min-w-0">
					<h3 class="text-sm font-semibold text-foreground truncate group-hover:text-primary/80 transition-colors" x-text="ag.name"></h3>
					<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="ag.description || 'No description'"></p>
				</div>
			</div>
			<!-- Metadata -->
			<div class="flex items-center gap-2 mt-3 pt-2 border-t border-border/50">
				<template x-if="!ag.isComposed">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[9px] px-1.5 py-0 h-4"}) {
						@icon.Bot(icon.Props{Class: "size-2.5 me-0.5"})
						{ i18n.T(ctx, "LLM Agent") }
					}
				</template>
				<template x-if="ag.isComposed">
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[9px] px-1.5 py-0 h-4 border-indigo-500/30 text-indigo-600 dark:text-indigo-400"}) {
						@icon.GitBranch(icon.Props{Class: "size-2.5 me-0.5"})
						{ i18n.T(ctx, "Workflow") }
					}
				</template>
				<template x-if="ag.isComposed && ag.graph">
					<span class="text-[10px] text-muted-foreground">
						<span x-text="collectAgentIds(ag.graph).length"></span> agents
					</span>
				</template>
				<span class="text-[10px] text-muted-foreground" x-text="formatDate(ag.createdAt || ag.created_at)"></span>
				<div class="flex-1"></div>
				<div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity" @click.stop>
					@button.Button(button.Props{
						Size:    button.SizeIcon,
						Variant: button.VariantGhost,
						Class:   "size-7 text-destructive hover:text-destructive",
						Attributes: templ.Attributes{
							"@click.stop": "ag.isComposed ? confirmDeletePipeline(ag) : confirmDeleteNode(ag)",
							"title":       i18n.T(ctx, "Delete"),
						},
					}) {
						@icon.Trash2(icon.Props{Class: "size-3.5"})
					}
				</div>
			</div>
		</div>
	</div>
}
