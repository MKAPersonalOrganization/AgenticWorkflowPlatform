package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// agentFormView is the create/edit screen for a single LLM agent. Wraps
// the shared agentNodeForm() body with a back-to-list header and a
// Cancel/Save footer. Save text adapts to whether editingAgent is set.
templ agentFormView() {
	<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
		<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50">
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "size-8",
				Attributes: templ.Attributes{
					"@click": "view = 'list'",
				},
			}) {
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
			}
			<h3 class="text-sm font-semibold" x-text="editingAgent ? 'Edit Agent' : 'New Agent'"></h3>
			<span class="text-[10px] text-muted-foreground" x-text="editingAgent ? 'Configure your agent' : 'Set up your new agent'"></span>
		</div>
		<div class="flex-1 overflow-y-auto p-4 scrollbar-thin space-y-4">
			@agentNodeForm()
		</div>
		<!-- Save Footer -->
		<div class="px-4 py-3 border-t flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": "view = 'list'",
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    "saveNode()",
					":disabled": "saving || !form.name.trim()",
				},
			}) {
				<span x-show="!saving" x-text="editingAgent ? 'Save Changes' : 'Create Agent'"></span>
				<span x-show="saving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Saving...") }
				</span>
			}
		</div>
	</div>
}
