package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// forkNameDialog is the modal that prompts the user to name a copy of a
// template before forking it. Overlays the whole dialog (z-60) rather
// than sitting inside a specific view so the user can see the template
// card they came from behind it.
templ forkNameDialog() {
	<div>
		<!-- Backdrop -->
		<div
			x-show="showForkNameDialog"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="cancelForkNameDialog()"
			class="fixed inset-0 z-[60] bg-black/40 backdrop-blur-[3px]"
		></div>
		<!-- Content -->
		<div
			x-show="showForkNameDialog"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-[0.97]"
			x-transition:enter-end="opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-[0.97]"
			@keydown.escape.window="cancelForkNameDialog()"
			class="fixed z-[60] left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] bg-background rounded-2xl border border-border/60 shadow-modern-xl w-full max-w-md"
		>
			<!-- Header -->
			<div class="flex items-center justify-between px-5 pt-5 pb-0">
				<div class="flex items-center gap-2.5">
					<div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
						@icon.GitBranch(icon.Props{Class: "size-4"})
					</div>
					<div>
						<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Name Your Agent") }</h3>
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Choose a name for your new agent") }</p>
					</div>
				</div>
				<button type="button" @click="cancelForkNameDialog()" class="size-8 rounded-lg hover:bg-accent flex items-center justify-center text-muted-foreground">
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</div>
			<!-- Body -->
			<div class="px-5 py-4 space-y-4">
				<div class="space-y-1.5">
					<label class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold">{ i18n.T(ctx, "Agent Name") }</label>
					<input
						type="text"
						x-model="forkNameInput"
						@keydown.enter="confirmForkName()"
						placeholder={ i18n.T(ctx, "Enter agent name") }
						class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground outline-none focus:ring-1 focus:ring-primary"
						autofocus
					/>
				</div>
				<template x-if="forkNameEntry?.description">
					<div class="space-y-1">
						<label class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold">{ i18n.T(ctx, "Description") }</label>
						<p class="text-xs text-muted-foreground leading-relaxed" x-text="forkNameEntry.description"></p>
					</div>
				</template>
			</div>
			<!-- Footer -->
			<div class="px-5 py-3 border-t border-border/50 flex items-center justify-end gap-2">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Class:   "h-8 px-3 text-xs",
					Attributes: templ.Attributes{
						"@click": "cancelForkNameDialog()",
					},
				}) {
					{ i18n.T(ctx, "Cancel") }
				}
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Class:   "h-8 px-4 text-xs gap-1.5",
					Attributes: templ.Attributes{
						"@click":    "confirmForkName()",
						":disabled": "forkNameAdding || !forkNameInput.trim()",
					},
				}) {
					<span x-show="!forkNameAdding">{ i18n.T(ctx, "Fork & Edit") }</span>
					<span x-show="forkNameAdding" class="flex items-center gap-1.5">
						<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
						{ i18n.T(ctx, "Forking...") }
					</span>
				}
			</div>
		</div>
	</div>
}
