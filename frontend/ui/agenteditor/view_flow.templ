package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// flowView is the workflow-tree editor: an IDE-style three-pane layout
// (node palette, tree canvas, property panel) with a bottom panel for
// evaluation output. The largest single view in AgentDesignerDialog —
// kept isolated so its VS Code-style panel plumbing doesn't bleed into
// the other views' simpler structures.
templ flowView() {
					<div
							class="relative flex flex-col flex-1 overflow-hidden"
							:class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'"
							@keydown.window="if ($event.key === '?' && $event.target.tagName !== 'INPUT' && $event.target.tagName !== 'TEXTAREA' && $event.target.tagName !== 'SELECT' && view === 'flow') { $event.preventDefault(); $store.flow._showHelp = !$store.flow._showHelp; }"
						>
						<!-- Header -->
						<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50 shrink-0">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-8",
								Attributes: templ.Attributes{
									"@click": "_syncGraphFromStore(); view = 'list'",
									"title":  i18n.T(ctx, "Back to agent list"),
								},
							}) {
								@icon.ArrowLeft(icon.Props{Class: "size-4"})
							}
							<h3 class="text-sm font-semibold" x-text="(editingPipeline ? 'Edit' : 'New') + ' Workflow'"></h3>
							<div class="flex-1"></div>
							<!-- Consumers indicator -->
							<template x-if="editingPipeline && pipelineConsumers.length > 0">
								<div class="flex items-center gap-1.5 text-[10px] text-muted-foreground mr-2">
									<span class="text-[10px] text-muted-foreground" x-text="pipelineConsumers.length + ' workflow' + (pipelineConsumers.length !== 1 ? 's' : '') + ' use this'"></span>
									<template x-for="consumer in pipelineConsumers.slice(0, 3)" :key="consumer.id">
										<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20" x-text="consumer.name"></span>
									</template>
									<template x-if="pipelineConsumers.length > 3">
										<span class="text-[10px] text-muted-foreground">+</span>
									</template>
								</div>
							</template>
							<div class="flex items-center gap-1">
								<template x-if="isPipelineValid">
									<span class="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
										@icon.CircleCheck(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "Valid") }
									</span>
								</template>
								<template x-if="!isPipelineValid">
									<span class="flex items-center gap-1 text-[10px] text-amber-600 dark:text-amber-400">
										@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
										<span x-text="pipelineErrors.length + ' issue' + (pipelineErrors.length !== 1 ? 's' : '')"></span>
									</span>
								</template>
							</div>
							<!-- Save button -->
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Class:   "h-8 px-4 text-xs gap-1.5",
								Attributes: templ.Attributes{
									"@click":    "saveFromFlowView()",
									":disabled": "pipelineSaving || !pipelineName.trim()",
								},
							}) {
								<span x-show="!pipelineSaving" x-text="editingPipeline ? 'Save' : 'Create'"></span>
								<span x-show="pipelineSaving" class="flex items-center gap-1.5">
									<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
								</span>
							}
							<!-- Panel visibility toggles (VS Code style) -->
							<div class="flex items-center gap-0.5 ml-2 pl-2 border-l border-border/50">
								<!-- Bottom Panel toggle (Terminal/Results) -->
								<button
									@click="bottomPanelActive = !bottomPanelActive"
									:title="bottomPanelActive ? 'Hide Bottom Panel' : 'Show Bottom Panel'"
									class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
									:class="bottomPanelActive ? 'text-foreground bg-accent hover:bg-accent/60' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
								>
									@icon.PanelBottom(icon.Props{Class: "size-3.5"})
								</button>
								<!-- Right Panel toggle (Properties) -->
								<button
									@click="togglePropertyPanel()"
									:title="propertyPanelVisible ? 'Hide Properties' : 'Show Properties'"
									class="flex items-center justify-center w-7 h-7 rounded text-xs transition-all duration-150"
									:class="propertyPanelVisible ? 'text-indigo-400 bg-indigo-500/15 hover:bg-indigo-500/25' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'"
								>
									@icon.PanelRight(icon.Props{Class: "size-3.5"})
								</button>
							</div>
						</div>
						<!-- Name + description bar -->
						<div class="flex items-center gap-2 px-3 py-1.5 border-b border-border/50 shrink-0">
							<span class="text-[10px] text-muted-foreground shrink-0">{ i18n.T(ctx, "Name") }</span>
							<input
								x-model="pipelineName"
								type="text"
								placeholder="Workflow name..."
								class="flex-1 bg-transparent text-xs text-foreground outline-none placeholder:text-muted-foreground"
							/>
							<span class="text-[10px] text-muted-foreground shrink-0 border-l border-border/50 pl-2">{ i18n.T(ctx, "Desc") }</span>
							<input
								x-model="pipelineDescription"
								type="text"
								placeholder="Optional description..."
								class="flex-1 bg-transparent text-xs text-foreground outline-none placeholder:text-muted-foreground"
							/>
						</div>
						<!-- Status Bar -->
						<div class="flex items-center gap-4 px-3 py-1 border-b border-border/30 shrink-0">
							<span
								class="text-[10px] font-mono tabular-nums"
								:class="$store.flow.nodeCount() > 40 ? 'text-amber-500' : 'text-muted-foreground'"
								x-text="$store.flow.nodeCount() + ' / 50 nodes'"
							></span>
							<span
								class="text-[10px] font-mono tabular-nums"
								:class="$store.flow.maxDepth() > 4 ? 'text-amber-500' : 'text-muted-foreground'"
								x-text="'depth ' + $store.flow.maxDepth() + ' / 5'"
							></span>
							<span class="flex-1"></span>
							<button
								x-show="$store.flow.canUndo()"
								@click="$store.flow.undo()"
								class="text-[10px] text-muted-foreground hover:text-foreground transition-colors"
								title="Undo (Ctrl+Z)"
							>
								{ i18n.T(ctx, "undo") }
							</button>
							<button
								x-show="$store.flow.canRedo()"
								@click="$store.flow.redo()"
								class="text-[10px] text-muted-foreground hover:text-foreground transition-colors"
								title="Redo (Ctrl+Shift+Z)"
							>
								{ i18n.T(ctx, "redo") }
							</button>
							<span class="text-[10px] text-muted-foreground/50">{ i18n.T(ctx, "? for shortcuts") }</span>
						</div>

						<!-- ═══════════════════════════════════════════ -->
						<!-- IDE LAYOUT (VS Code / IntelliJ pattern)     -->
						<!-- ═══════════════════════════════════════════ -->
						<div class="flex flex-1 overflow-hidden min-h-0">
							<!-- Activity Bar (far left) - Primary actions only -->
							<div class="shrink-0 w-12 flex flex-col items-center py-2 bg-sidebar border-e border-sidebar-border/50 gap-1">
								<!-- Test Explorer toggle -->
								<button
									@click="evalPanelActive = !evalPanelActive"
									:title="evalPanelActive ? 'Hide Test Explorer' : 'Show Test Explorer'"
									class="flex items-center justify-center w-10 h-10 rounded-lg transition-all duration-150 hover:bg-accent hover:text-foreground"
									:class="evalPanelActive ? 'text-foreground border-l-2 border-foreground bg-accent/50' : 'text-muted-foreground'"
								>
									@icon.TestTube(icon.Props{Class: "size-5"})
								</button>

                                                        </div>

							<!-- Left Panel: Test Explorer -->
							<template x-if="evalPanelActive">
								<div
									class="shrink-0 w-64 overflow-hidden"
									x-transition:enter="transition-all duration-200 ease-out"
									x-transition:enter-start="opacity-0 -translate-x-full"
									x-transition:enter-end="opacity-100 translate-x-0"
									x-transition:leave="transition-all duration-150 ease-in"
									x-transition:leave-start="opacity-100 translate-x-0"
									x-transition:leave-end="opacity-0 -translate-x-full"
								>
                                                                <!-- Test Explorer Panel (inlined) -->
                                                                <div class="flex flex-col h-full bg-background border-r border-border/50 overflow-hidden">
                                                                        <!-- Panel Header -->
                                                                        <div class="flex items-center gap-2 px-3 py-2 border-b border-border/50 shrink-0">
                                                                                <span class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-widest text-foreground">
                                                                                        @icon.TestTube(icon.Props{Class: "size-3"})
                                                                                        Test Explorer
                                                                                </span>
                                                                                <span class="flex-1"></span>
                                                                                @dialog.Trigger(dialog.TriggerProps{
                                                                                        For: "evalsets-manager-dialog",
                                                                                }) {
                                                                                        @button.Button(button.Props{
                                                                                                Size:    button.SizeIcon,
                                                                                                Variant: button.VariantGhost,
                                                                                                Class:   "size-6",
                                                                                                Attributes: templ.Attributes{
                                                                                                        "title": "Manage Eval Sets",
                                                                                                },
                                                                                        }) {
                                                                                                @icon.Settings(icon.Props{Class: "size-3"})
                                                                                        }
                                                                                }
                                                                                <button
                                                                                        @click="loadEvalSets()"
                                                                                        title="Refresh"
                                                                                        class="flex items-center justify-center w-6 h-6 rounded text-[10px] text-muted-foreground hover:text-foreground hover:transition-colors"
                                                                                >
                                                                                        @icon.RefreshCw(icon.Props{Class: "size-3"})
                                                                                </button>

                                                                        </div>
                                                                        <!-- Panel Content -->
                                                                        <div class="flex-1 overflow-y-auto p-2 space-y-1">
                                                                                <!-- Loading State -->
                                                                                <template x-if="evalSetsLoading">
                                                                                        <div class="flex items-center justify-center py-8">
                                                                                                <span class="animate-spin size-4 border-2 border-muted-foreground border-t-transparent rounded-full"></span>
                                                                                        </div>
                                                                                </template>

                                                                                <!-- Empty State -->
                                                                                <template x-if="!evalSetsLoading && evalSets.length === 0">
                                                                                        <div class="text-center py-8 text-muted-foreground">
                                                                                                @icon.TestTube(icon.Props{Class: "size-8 opacity-20 mx-auto mb-2"})
                                                                                                <p class="text-xs">No eval sets found</p>
                                                                                                <p class="text-[10px] mt-1">Create one to start testing</p>
                                                                                        </div>
                                                                                </template>

                                                                                <!-- Eval Sets Tree -->
                                                                                <template x-for="es in evalSets" :key="es.id">
                                                                                        <div class="space-y-0.5">
                                                                                                <!-- EvalSet Header -->
                                                                                                <div
                                                                                                        class="flex items-center gap-1.5 px-2 py-1.5 rounded text-xs cursor-pointer hover:group"
                                                                                                        @click="es.expanded = !es.expanded"
                                                                                                >
                                                                                                        <span
                                                                                                                class="transition-transform duration-150 text-muted-foreground text-[8px]"
                                                                                                                :class="es.expanded ? 'rotate-90' : ''"
                                                                                                        >▶</span>
                                                                                                        @icon.FileText(icon.Props{Class: "size-3.5 text-muted-foreground"})
                                                                                                        <span class="flex-1 truncate font-medium" x-text="es.name"></span>
                                                                                                        <span class="text-[9px] text-muted-foreground" x-text="es.case_count"></span>
                                                                                                </div>

                                                                                                <!-- Cases List (expandable) -->
                                                                                                <div x-show="es.expanded" class="ml-4 space-y-0.5" x-transition>
                                                                                                        <button
                                                                                                                @click="runEvalSet(es.id)"
                                                                                                                :disabled="evalRunning || !currentAgentId"
                                                                                                                class="w-full flex items-center gap-1.5 px-2 py-1 rounded text-[11px] cursor-pointer hover:disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                                                                                                        >
                                                                                                                @icon.Play(icon.Props{Class: "size-3 text-green-600"})
                                                                                                                <span class="text-green-700 dark:text-green-400">Run All</span>
                                                                                                        </button>

                                                                                                        <!-- Toggle to show/hide individual cases -->
                                                                                                        <template x-if="es.cases && es.cases.length > 0">
                                                                                                                <button
                                                                                                                        @click="es.casesExpanded = !es.casesExpanded"
                                                                                                                        class="w-full flex items-center gap-1 px-2 py-0.5 rounded text-[10px] text-muted-foreground hover:text-foreground hover:transition-colors"
                                                                                                                >
                                                                                                                        <span class="transition-transform duration-150 text-[8px]" :class="es.casesExpanded ? 'rotate-90' : ''">▶</span>
                                                                                                                        <span x-text="(es.cases?.length || 0) + ' cases'"></span>
                                                                                                                </button>
                                                                                                        </template>

                                                                                                        <!-- Individual cases -->
                                                                                                        <div x-show="es.casesExpanded" class="ml-2 space-y-0.5" x-transition>
                                                                                                                <template x-for="tc in es.cases" :key="tc.id">
                                                                                                                        <div class="space-y-0.5">
                                                                                                                                <!-- Case row (clickable to expand results) -->
                                                                                                                                <div
                                                                                                                                        @click="tc.resultsExpanded = !tc.resultsExpanded"
                                                                                                                                        class="flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] cursor-pointer hover:transition-colors"
                                                                                                                                >
                                                                                                                                        <!-- Expand indicator -->
                                                                                                                                        <template x-if="getCaseResult(tc.id)?.metrics?.length > 0">
                                                                                                                                                <span class="transition-transform duration-150 text-[8px]" :class="tc.resultsExpanded ? 'rotate-90' : ''">▶</span>
                                                                                                                                        </template>
                                                                                                                                        <template x-if="!getCaseResult(tc.id)?.metrics?.length">
                                                                                                                                                <span class="w-2"></span>
                                                                                                                                        </template>
                                                                                                                                        <!-- Status icon from testResults -->
                                                                                                                                        <template x-if="getCaseResult(tc.id)?.status === 'passed'">
                                                                                                                                                @icon.CircleCheck(icon.Props{Class: "size-3 text-green-600 flex-shrink-0"})
                                                                                                                                        </template>
                                                                                                                                        <template x-if="getCaseResult(tc.id)?.status === 'failed' || getCaseResult(tc.id)?.status === 'error'">
                                                                                                                                                @icon.CircleX(icon.Props{Class: "size-3 text-red-600 flex-shrink-0"})
                                                                                                                                        </template>
                                                                                                                                        <template x-if="getCaseResult(tc.id)?.status === 'running'">
                                                                                                                                                <span class="animate-spin size-3 border border-blue-500 border-t-transparent rounded-full flex-shrink-0"></span>
                                                                                                                                        </template>
                                                                                                                                        <template x-if="!getCaseResult(tc.id)">
                                                                                                                                                @icon.Circle(icon.Props{Class: "size-3 text-muted-foreground flex-shrink-0"})
                                                                                                                                        </template>
                                                                                                                                        <!-- Case name -->
                                                                                                                                        <span class="flex-1 truncate text-muted-foreground" x-text="tc.name"></span>
                                                                                                                                        <!-- Score badge -->
                                                                                                                                        <template x-if="getCaseResult(tc.id)?.score != null">
                                                                                                                                                <span
                                                                                                                                                        class="text-[9px] font-mono px-1 rounded"
                                                                                                                                                        :class="getCaseResult(tc.id).score >= 0.8 ? 'text-green-700 dark:text-green-400' : getCaseResult(tc.id).score >= 0.5 ? 'text-yellow-700 dark:text-yellow-400' : 'text-red-700 dark:text-red-400'"
                                                                                                                                                        x-text="getCaseResult(tc.id).score.toFixed(2)"
                                                                                                                                                ></span>
                                                                                                                                        </template>
                                                                                                                                </div>

                                                                                                                                <!-- Expandable metrics -->
                                                                                                                                <template x-if="tc.resultsExpanded && getCaseResult(tc.id)?.metrics?.length > 0">
                                                                                                                                        <div class="ml-4 space-y-0.5">
                                                                                                                                                <template x-for="metric in getCaseResult(tc.id).metrics" :key="metric.metric_id">
                                                                                                                                                        <div class="flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] text-muted-foreground">
                                                                                                                                                                <template x-if="metric.status === 'passed'">
                                                                                                                                                                        @icon.CircleCheck(icon.Props{Class: "size-2.5 text-green-600 flex-shrink-0"})
                                                                                                                                                                </template>
                                                                                                                                                                <template x-if="metric.status !== 'passed'">
                                                                                                                                                                        @icon.CircleX(icon.Props{Class: "size-2.5 text-red-600 flex-shrink-0"})
                                                                                                                                                                </template>
                                                                                                                                                                <span class="flex-1 truncate font-mono" x-text="metric.metric_id"></span>
                                                                                                                                                                <span class="font-mono" x-text="metric.score?.toFixed(2) ?? '-'"></span>
                                                                                                                                                        </div>
                                                                                                                                                </template>
                                                                                                                                        </div>
                                                                                                                                </template>
                                                                                                                        </div>
                                                                                                                </template>
                                                                                                        </div>
                                                                                                </div>
                                                                                        </div>
                                                                                </template>
                                                                        </div>

                                                                        <!-- Panel Footer -->
                                                                        <div class="px-3 py-2 border-t border-border/50 shrink-0 space-y-1.5">
                                                                                <button
                                                                                        @click="runAllEvalSets()"
                                                                                        :disabled="evalRunning || !currentAgentId || evalSets.length === 0"
                                                                                        class="w-full flex items-center justify-center gap-2 px-3 py-1.5 rounded text-xs font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                                                                        :class="!evalRunning && currentAgentId && evalSets.length > 0 ? 'bg-violet-500 text-white hover:bg-violet-600 shadow-sm' : 'bg-muted text-muted-foreground'"
                                                                                >
                                                                                        @icon.Play(icon.Props{Class: "size-3.5"})
                                                                                        Run All Tests
                                                                                </button>
                                                                                <button
                                                                                        @click="exportTestResults()"
                                                                                        :disabled="testResults.length === 0"
                                                                                        class="w-full flex items-center justify-center gap-2 px-3 py-1 rounded text-xs transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                                                                        :class="testResults.length > 0 ? 'bg-muted text-muted-foreground hover:bg-muted/80' : 'bg-muted text-muted-foreground'"
                                                                                >
                                                                                        @icon.Download(icon.Props{Class: "size-3"})
                                                                                        Export Results
                                                                                </button>
                                                                        </div>
                                                                </div>
								</div>
							</template>

							<!-- Main Content Area (Tree + Bottom Panel) -->
							<div class="flex-1 flex flex-col overflow-hidden min-w-0">
						<!-- Tree + Property Panel (resizable) -->
						<div
							class="flex flex-1 overflow-hidden"
							x-data="{ panelW: 288, dragging: false }"
							@mousemove.window="if (dragging) { const r = $el.getBoundingClientRect(); panelW = Math.min(Math.max(r.right - $event.clientX, 200), r.width * 0.6); }"
							@mouseup.window="dragging = false; document.body.style.cursor = ''; document.body.style.userSelect = '';"
						>
							<!-- Tree View -->
							<div
								x-data="editableWorkflowTree()"
								x-init="init()"
								class="flex-1 overflow-auto bg-background"
							>
								<div class="ewt-pipeline-canvas">
									<!-- Tree will be rendered here -->
								</div>
							</div>
							<!-- Resize Handle -->
							<div
								x-show="propertyPanelVisible"
								@mousedown.prevent="dragging = true; document.body.style.cursor = 'col-resize'; document.body.style.userSelect = 'none';"
								class="shrink-0 w-1 cursor-col-resize group relative z-10"
								class="shrink-0 w-1 cursor-col-resize group relative z-10 bg-muted"
							>
								<div
									class="absolute inset-y-0 -left-1 -right-1 group-hover:bg-indigo-500/20 transition-colors duration-150"
									:class="dragging ? 'bg-indigo-500/30' : ''"
								></div>
							</div>
							<!-- Property Panel -->
							<div
								x-data="alpineflowPropertyPanel"
								x-show="propertyPanelVisible"
								x-transition:enter="transition-all duration-200 ease-out"
								x-transition:enter-start="opacity-0 translate-x-full"
								x-transition:enter-end="opacity-100 translate-x-0"
								x-transition:leave="transition-all duration-150 ease-in"
								x-transition:leave-start="opacity-100 translate-x-0"
								x-transition:leave-end="opacity-0 translate-x-full"
								class="shrink-0 overflow-y-auto scrollbar-thin flex flex-col bg-card border-border"
								:style="'width:' + panelW + 'px;'"
							>
								<template x-if="!node">
									<!-- Empty state when no node is selected. Intentionally
									     no System Prompt or Global Instruction editor here:
									     a pipeline is rooted at a Sequential / Parallel / Loop
									     agent, and those types have neither a per-instance
									     Instruction field (only llmagent.Config does) nor a
									     GlobalInstruction the orchestration engine will honour
									     (asLLMAgent(workflowRoot) is nil — see
									     .READ/adk-go/internal/llminternal/agent_transfer.go:186
									     and instruction_processor.go:48). Either field shown
									     here would persist but silently do nothing at runtime. -->
									<div class="flex flex-col items-center justify-center h-full px-4 py-12 text-center space-y-3">
										<div class="w-9 h-9 rounded-lg flex items-center justify-center bg-muted border-border">
											@icon.MousePointerClick(icon.Props{Class: "size-4 text-muted-foreground"})
										</div>
										<div class="space-y-1">
											<p class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Properties") }</p>
											<p class="text-[10px] text-muted-foreground leading-relaxed">{ i18n.T(ctx, "Select a node in the canvas to view and edit its settings.") }</p>
										</div>
									</div>
								</template>
								<template x-if="node">
									<div class="flex flex-col h-full">
										<!-- Node Header -->
										<div class="flex items-center gap-2 px-3 py-2 border-b shrink-0 border-border">
											<div
												class="shrink-0 w-6 h-6 rounded flex items-center justify-center text-[10px] font-bold"
												:style="'background:' + nodeTypeColor + '12; color:' + nodeTypeColor + '; border: 1px solid ' + nodeTypeColor + '20'"
												x-text="nodeTypeChar"
											></div>
											<div class="flex-1 min-w-0">
												<span class="text-[10px] font-semibold text-foreground uppercase tracking-wider block truncate" x-text="nodeTypeLabel"></span>
												<span class="text-[9px] text-muted-foreground block truncate" x-text="node.label || 'unlabeled'"></span>
											</div>
											<div class="flex items-center gap-0.5 shrink-0">
												<button @click="moveUp()" :disabled="!canMoveUp" title="Move up" class="w-6 h-6 flex items-center justify-center rounded hover:bg-accent text-muted-foreground hover:text-foreground disabled:opacity-20 disabled:cursor-not-allowed transition-colors">↑</button>
												<button @click="moveDown()" :disabled="!canMoveDown" title="Move down" class="w-6 h-6 flex items-center justify-center rounded hover:bg-accent text-muted-foreground hover:text-foreground disabled:opacity-20 disabled:cursor-not-allowed transition-colors">↓</button>
												<!-- Delete node. Trash icon + confirm() because the earlier '✕'
												     glyph was easy to mistake for a close-panel control and
												     fired deleteNode() on a single click. -->
												<button
													x-show="!isRoot"
													@click="confirm('Delete this node from the workflow? This cannot be undone.') && deleteNode()"
													title="Delete node"
													class="w-6 h-6 flex items-center justify-center rounded hover:bg-red-500/10 text-muted-foreground hover:text-red-400 transition-colors"
												>
													@icon.Trash2(icon.Props{Class: "size-3.5"})
												</button>
											</div>
										</div>
										<!-- Scrollable Content -->
										<div class="flex-1 overflow-y-auto p-3 space-y-3 scrollbar-thin">
											<!-- Label Field -->
											<div>
												<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">Label</label>
												<input :value="node.label" @input="set('label', $event.target.value)" type="text" placeholder="Display name..." class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
											</div>

											<!-- Agent Node -->
											<template x-if="node.type === 'agent'">
												<div class="space-y-3">
													<!-- Agent Selector -->
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">LLM Agent <span class="text-rose-500">*</span></label>
														<select :value="node.agent_id" @change="set('agent_id', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border">
															<option value="">— select agent —</option>
															<template x-for="ag in agents" :key="ag.id">
																<option :value="ag.id" x-text="ag.name"></option>
															</template>
														</select>
													</div>

													<!-- Agent Info Card -->
													<template x-if="selectedAgent">
<div class="rounded-lg overflow-hidden bg-muted border-border">
															<!-- Agent name header -->
															<div class="px-2.5 py-2 border-b border-border flex items-center justify-between">
																<span class="text-[10px] font-semibold text-foreground truncate flex-1" x-text="selectedAgent.name"></span>
																<!-- Coordinator badge -->
																<template x-if="isCoordinator">
																	<span class="shrink-0 ml-2 text-[8px] px-1.5 py-0.5 rounded-full bg-violet-500/15 text-violet-600 dark:text-violet-400 border border-violet-500/20 flex items-center gap-1">
																		@icon.Users(icon.Props{Class: "size-2.5"})
																		<span x-text="selectedAgent.subAgents?.length + ' sub'"></span>
																	</span>
																</template>
															</div>
															<!-- Model -->
																<template x-if="selectedAgent.modelOverride && selectedAgent.modelOverride.modelName">
															<div class="px-2.5 py-1.5 flex items-center gap-2 border-b border-border">
																@icon.Cpu(icon.Props{Class: "size-3 text-muted-foreground"})
																<span class="text-[9px] font-mono rounded px-1.5 py-0.5 text-muted-foreground bg-muted" x-text="(selectedAgent.modelOverride.provider ? selectedAgent.modelOverride.provider + '/' : '') + selectedAgent.modelOverride.modelName"></span>
															</div>
														</template>
															<!-- Description -->
															<template x-if="selectedAgent.description">
																<div class="px-2.5 py-2 border-b border-border">
																	<p class="text-[10px] text-muted-foreground leading-relaxed line-clamp-2" x-text="selectedAgent.description"></p>
																</div>
															</template>
															<!-- Subagents team hierarchy -->
															<template x-if="isCoordinator">
																<div class="px-2.5 py-2 border-b border-border">
																	<div class="text-[8px] uppercase tracking-widest text-violet-500 font-semibold mb-1.5 flex items-center gap-1">
																		@icon.Users(icon.Props{Class: "size-2.5"})
																		Team
																	</div>
																	<div class="space-y-1">
																		<template x-for="subAgent in selectedAgent.subAgents" :key="subAgent.agent_id">
																			<div class="flex items-center gap-1.5 px-2 py-1 rounded bg-background border border-violet-500/20 text-[9px]">
																				<span class="text-[8px] flex-shrink-0">🤖</span>
																				<span class="flex-1 min-w-0 truncate text-foreground font-medium" x-text="getSubAgentName(subAgent.agent_id)"></span>
																				<template x-if="subAgent.output_key">
																					<span class="text-[8px] font-mono text-violet-600 dark:text-violet-400 flex-shrink-0" x-text="'→'+subAgent.output_key"></span>
																				</template>
																			</div>
																		</template>
																	</div>
																</div>
															</template>
															<!-- Agent Config Summary -->
															<div class="px-2.5 py-2">
																<div class="flex items-center gap-2 text-[9px] text-muted-foreground flex-wrap">
																	<template x-if="selectedAgent.output_key">
																		<span class="flex items-center gap-1">
																			@icon.Key(icon.Props{Class: "size-2.5"})
																			<span class="font-mono text-muted-foreground" x-text="'{'+selectedAgent.output_key+'}'"></span>
																		</span>
																	</template>
																</div>
																<template x-if="!selectedAgent.systemPrompt && !selectedAgent.description && !(selectedAgent.modelOverride && selectedAgent.modelOverride.modelName)">
																	<p class="text-[10px] text-muted-foreground italic">{ i18n.T(ctx, "No configuration yet — edit the agent to set it up.") }</p>
																</template>
															</div>
														</div>
													</template>

													<!-- Agent Configuration Summary -->
													<div class="border-t pt-2 border-border">
														<div class="flex items-center justify-between mb-2">
															<h4 class="text-[9px] uppercase tracking-widest text-muted-foreground font-semibold">
																@icon.Settings(icon.Props{Class: "size-3 inline me-0.5"})
																Agent Configuration
															</h4>
															<button
																@click="editAgent()"
																class="text-[9px] text-indigo-400 hover:text-indigo-300 font-medium transition-colors px-2 py-0.5 rounded border border-indigo-400/30 hover:border-indigo-400/60 hover:bg-indigo-500/5"
															>
																@icon.Pencil(icon.Props{Class: "size-2.5 inline me-1"})
																Edit Agent
															</button>
														</div>

														<!-- Loading state -->
														<template x-if="loadingMetadata">
															<div class="space-y-1.5">
																<template x-for="i in 3" :key="i">
																	<div class="flex items-center gap-2 p-2 rounded-lg animate-pulse bg-muted">
																		<div class="size-4 rounded bg-muted-foreground/20"></div>
																		<div class="flex-1 h-3 bg-muted-foreground/20 rounded"></div>
																	</div>
																</template>
															</div>
														</template>

														<!-- Configuration summary -->
														<template x-if="!loadingMetadata">
															<div class="space-y-1.5">
																<!-- Tools -->
																<div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-border/50">
																	@icon.Blocks(icon.Props{Class: "size-3 text-muted-foreground shrink-0"})
																	<span class="text-[10px] text-muted-foreground flex-1">Tools</span>
																	<span class="text-[10px] font-semibold text-foreground" x-text="toolCount + ' tool' + (toolCount !== 1 ? 's' : '')"></span>
																</div>

																<!-- Subagents -->
																<div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-border/50">
																	@icon.Users(icon.Props{Class: "size-3 text-muted-foreground shrink-0"})
																	<span class="text-[10px] text-muted-foreground flex-1">Subagents</span>
																	<span class="text-[10px] font-semibold text-foreground" x-text="subAgentCount + ' agent' + (subAgentCount !== 1 ? 's' : '')"></span>
																</div>

																<!-- Knowledge Bases -->
																<div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-border/50">
																	@icon.BookOpenText(icon.Props{Class: "size-3 text-muted-foreground shrink-0"})
																	<span class="text-[10px] text-muted-foreground flex-1">Knowledge Bases</span>
																	<span class="text-[10px] font-semibold text-foreground" x-text="kbCount + ' KB' + (kbCount !== 1 ? 's' : '')"></span>
																</div>

																<!-- Filesystems -->
																<div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-border/50">
																	@icon.FolderOpen(icon.Props{Class: "size-3 text-muted-foreground shrink-0"})
																	<span class="text-[10px] text-muted-foreground flex-1">Filesystems</span>
																	<span class="text-[10px] font-semibold text-foreground" x-text="fsCount + ' FS' + (fsCount !== 1 ? 's' : '')"></span>
																</div>
															</div>
														</template>
													</div>

													<!-- Output Variable (for storing result in session state) -->
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">
															@icon.Key(icon.Props{Class: "size-3 inline me-0.5"})
															Output Variable
														</label>
														<input :value="node.output_key || ''" @input="set('output_key', $event.target.value)" type="text" placeholder="e.g. research_results" class="w-full text-[11px] font-mono rounded-lg px-2.5 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
														<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "Stores output in session state for other agents to use via {variable}") }</p>
													</div>

													<!-- Condition (only for branches of a conditional node) -->
													<template x-if="isConditionalBranch">
														<div>
															<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">
																@icon.GitBranch(icon.Props{Class: "size-3 inline me-0.5"})
																Branch Condition
															</label>
															<input :value="node.condition || ''" @input="set('condition', $event.target.value)" type="text" placeholder="e.g. technical, billing" class="w-full text-[11px] font-mono rounded-lg px-2.5 py-1.5 text-foreground placeholder:text-muted-foreground outline-none focus:ring-1 focus:ring-red-400/40 bg-background border-border"/>
															<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "Value to match against evaluator output. Use * for fallback/default branch.") }</p>
														</div>
													</template>
												</div>
											</template>

											<!-- Remote Node -->
											<template x-if="node.type === 'remote'">
												<div class="space-y-3">
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">A2A Connector <span class="text-rose-500">*</span></label>
														<select :value="node.a2a_connector_id" @change="set('a2a_connector_id', $event.target.value)" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border">
															<option value="">— select connector —</option>
															<template x-for="conn in connectors" :key="conn.id">
																<option :value="conn.id" x-text="conn.name || conn.id"></option>
															</template>
														</select>
													</div>
												</div>
											</template>

											<!-- Loop Node -->
											<template x-if="node.type === 'loop'">
												<div class="space-y-3">
													<div>
														<label class="block text-[8px] uppercase tracking-widest text-muted-foreground font-semibold mb-1.5">Max Iterations</label>
														<input :value="node.max_iterations||3" @input="set('max_iterations', parseInt($event.target.value)||1)" type="number" min="1" max="100" class="w-full text-[11px] rounded-lg px-2.5 py-1.5 text-foreground outline-none focus:ring-1 focus:ring-primary/40 bg-background border-border"/>
														<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "How many times the agents in this loop will repeat.") }</p>
													</div>
													<label class="flex items-center gap-2 cursor-pointer group">
														<input type="checkbox" :checked="node.allow_early_exit" @change="setBool('allow_early_exit', $event.target.checked)" class="rounded accent-primary"/>
														<span class="text-[10px] text-muted-foreground group-hover:text-foreground transition-colors">{ i18n.T(ctx, "Allow the agent to exit the loop early when done") }</span>
													</label>
												</div>
											</template>

											<!-- Sequential/Parallel Node -->
											<template x-if="node.type === 'sequential' || node.type === 'parallel'">
												<div class="rounded-lg p-3 text-center bg-muted border-border">
													<p class="text-[10px] text-muted-foreground">
														<template x-if="node.type === 'sequential'">{ i18n.T(ctx, "Runs agents one after another, in order.") }</template>
														<template x-if="node.type === 'parallel'">{ i18n.T(ctx, "Runs all agents at the same time, then collects results.") }</template>
													</p>
													<p class="text-[9px] text-muted-foreground mt-1">
														<template x-if="node.children && node.children.length" x-text="node.children.length + ' sub-agent(s)'"></template>
														<template x-if="!node.children || node.children.length === 0">No sub-agents yet</template>
													</p>
												</div>
											</template>

											<!-- Conditional Node -->
											<template x-if="node.type === 'conditional'">
												<div class="space-y-3">
													<!-- Info card -->
													<div class="rounded-lg p-3 bg-muted border-border">
														<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Routes to one branch based on an evaluator's output.") }</p>
														<p class="text-[9px] text-muted-foreground mt-1">{ i18n.T(ctx, "First child = evaluator (runs always). Remaining children = branches (only one executes).") }</p>
													</div>

													<!-- Evaluator warning: missing -->
													<template x-if="!node.children || node.children.length < 2">
														<div class="rounded-lg p-2.5 bg-amber-500/10 border border-amber-500/20">
															<p class="text-[10px] text-amber-600 dark:text-amber-400 flex items-start gap-1.5">
																<span class="shrink-0 mt-0.5">⚠️</span>
																<span>{ i18n.T(ctx, "Needs at least an evaluator + 1 branch. Add agents as children.") }</span>
															</p>
														</div>
													</template>

													<!-- Evaluator warning: missing output_key -->
													<template x-if="node.children && node.children.length >= 2 && evaluatorNode && !evaluatorHasOutputKey">
														<div class="rounded-lg p-2.5 bg-red-500/10 border border-red-500/20">
															<p class="text-[10px] text-red-600 dark:text-red-400 flex items-start gap-1.5">
																<span class="shrink-0 mt-0.5">🔑</span>
																<span>
																	{ i18n.T(ctx, "Evaluator agent needs output_key set in the agent settings. This is how the router reads the classification.") }
																	<button type="button" @click="editEvaluatorAgent()" class="underline font-semibold hover:text-red-500 transition-colors inline">{ i18n.T(ctx, "Open agent → State & Context → Output Variable") }</button>
																</span>
															</p>
														</div>
													</template>

													<!-- Branch summary -->
													<template x-if="node.children && node.children.length >= 2">
														<div class="space-y-1.5">
															<!-- Evaluator status -->
															<div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border"
																:class="evaluatorHasOutputKey ? 'bg-blue-500/10 border-blue-500/20' : 'bg-red-500/10 border-red-500/20'">
																<span class="text-[8px]">🎯</span>
																<span class="text-[10px] font-medium" :class="evaluatorHasOutputKey ? 'text-blue-600 dark:text-blue-400' : 'text-red-600 dark:text-red-400'">
																	<template x-if="evaluatorAgent" x-text="'Evaluator: ' + evaluatorAgent.name"></template>
																	<template x-if="!evaluatorAgent">No evaluator agent set</template>
																</span>
																<template x-if="evaluatorHasOutputKey">
																	<span class="text-[8px] font-mono px-1 py-0.5 rounded bg-blue-500/20 text-blue-500" x-text="'→ ' + evaluatorAgent.output_key"></span>
																</template>
																<template x-if="!evaluatorHasOutputKey && evaluatorAgent">
																	<span class="text-[8px] font-mono text-red-400">no output_key</span>
																</template>
															</div>
															<!-- Branches -->
															<template x-for="(child, idx) in node.children.slice(1)" :key="child.id">
																<div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-muted border-border">
																	<span class="text-[8px]">🔀</span>
																	<span class="text-[10px] text-muted-foreground" x-text="'Branch ' + (idx + 1)"></span>
																	<!-- Branch agent name -->
																	<template x-if="child.type === 'agent' && child.agent_id">
																		<span class="text-[9px] font-medium text-foreground truncate max-w-[100px]" x-text="$store.flow.agentName(child.agent_id)"></span>
																	</template>
																	<!-- Condition badge -->
																	<template x-if="child.condition">
																		<span class="text-[8px] font-mono px-1 py-0.5 rounded bg-red-500/10 text-red-500" x-text="child.condition === '*' ? '*' : child.condition"></span>
																	</template>
																	<template x-if="!child.condition">
																		<span class="text-[8px] font-mono text-muted-foreground/50">no condition</span>
																	</template>
																</div>
															</template>
														</div>
													</template>
												</div>
											</template>
										</div>
										<!-- Footer -->
										<div class="px-3 py-1.5 border-t shrink-0 border-border">
											<p class="text-[8px] text-muted-foreground font-mono truncate tracking-wide" x-text="node.id"></p>
										</div>
									</div>
								</template>
							</div>
							</div>
							<!-- Validation errors footer -->
							<template x-if="pipelineErrors.length > 0">
								<div class="shrink-0 px-4 py-2 border-t border-amber-500/20 bg-amber-500/5 flex items-start gap-2">
									@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-amber-500 shrink-0 mt-0.5"})
									<div class="flex-1 min-w-0">
										<template x-for="(err, idx) in pipelineErrors.slice(0,3)" :key="idx">
											<p class="text-[10px] text-amber-600 dark:text-amber-400 truncate" x-text="err"></p>
										</template>
										<template x-if="pipelineErrors.length > 3">
											<p class="text-[10px] text-amber-500/70" x-text="'+ ' + (pipelineErrors.length - 3) + ' more'"></p>
										</template>
									</div>
								</div>
							</template>


						<!-- ═══════════════════════════════════════════ -->
						<!-- BOTTOM PANEL (VS Code pattern)             -->
						<!-- ═══════════════════════════════════════════ -->
                                                <!-- ═══════════════════════════════════════════ -->
                                                <!-- BOTTOM PANEL (VS Code pattern)             -->
                                                <!-- ═══════════════════════════════════════════ -->
                                                <div
                                                        x-show="bottomPanelActive"
                                                        class="flex flex-col border-t border-border/50 bg-background overflow-hidden transition-all duration-300 ease-in-out"
                                                        :style="bottomPanelCollapsed ? 'height:32px' : 'height:220px'"
                                                        x-transition:enter="transition-all duration-200 ease-out"
                                                        x-transition:enter-start="opacity-0 translate-y-full"
                                                        x-transition:enter-end="opacity-100 translate-y-0"
                                                        x-transition:leave="transition-all duration-150 ease-in"
                                                        x-transition:leave-start="opacity-100 translate-y-0"
                                                        x-transition:leave-end="opacity-0 translate-y-full"
                                                >
                                                        <!-- Tab Bar -->
                                                        <div class="flex items-center gap-0 px-2 shrink-0 border-b border-border/50" style="height:32px;">
                                                                <template x-for="tab in bottomTabs" :key="tab.id">
                                                                        <button
                                                                                @click="activeBottomTab = tab.id"
                                                                                class="flex items-center gap-1.5 px-3 h-full text-[10px] font-medium border-b-2 transition-colors"
                                                                                :class="activeBottomTab === tab.id ? 'border-foreground text-foreground bg-background/50' : 'border-transparent text-muted-foreground hover:text-foreground hover:bg-muted/50'"
                                                                        >
                                                                                <span x-html="tab.icon"></span>
                                                                                <span x-text="tab.label"></span>
                                                                                <template x-if="tab.badge">
                                                                                        <span class="text-[8px] px-1 rounded bg-muted-foreground/20" x-text="tab.badge"></span>
                                                                                </template>
                                                                        </button>
                                                                </template>
                                                                <span class="flex-1"></span>
                                                                <button
                                                                        @click="bottomPanelCollapsed = !bottomPanelCollapsed"
                                                                        :title="bottomPanelCollapsed ? 'Expand' : 'Minimize'"
                                                                        class="flex items-center justify-center w-6 h-6 rounded text-[10px] text-muted-foreground hover:text-foreground hover:transition-colors"
                                                                >
                                                                        <span class="transition-transform duration-200 inline-flex" :class="bottomPanelCollapsed ? '' : 'rotate-180'">
                                                                                @icon.ChevronDown(icon.Props{Class: "size-3"})
                                                                        </span>
                                                                </button>
                                                                <button
                                                                        @click="bottomPanelActive = false"
                                                                        title="Close"
                                                                        class="flex items-center justify-center w-6 h-6 rounded text-[10px] text-muted-foreground hover:text-destructive hover:transition-colors"
                                                                >
                                                                        @icon.X(icon.Props{Class: "size-3"})
                                                                </button>
                                                        </div>

                                                        <!-- Tab Content -->
                                                        <div x-show="!bottomPanelCollapsed" class="flex-1 overflow-hidden min-h-0">
                                                                <!-- Terminal Tab -->
                                                                <template x-if="activeBottomTab === 'terminal'">
                                                                        <div x-ref="terminalPanel" class="h-full overflow-y-auto p-3 font-mono text-[10px] space-y-0.5 bg-muted/40 text-foreground">
                                                                                <template x-if="evalLogs.length === 0">
                                                                                        <div class="flex flex-col items-center justify-center h-full text-muted-foreground">
                                                                                                @icon.Terminal(icon.Props{Class: "size-8 opacity-30 mb-2"})
                                                                                                <span class="text-xs">No terminal output yet</span>
                                                                                                <span class="text-[10px]">Run an evaluation to see logs here</span>
                                                                                        </div>
                                                                                </template>
                                                                                <template x-for="(log, idx) in evalLogs" :key="idx">
                                                                                        <div class="whitespace-pre-wrap" x-text="log"></div>
                                                                                </template>
                                                                        </div>
                                                                </template>

                                                                <!-- Output Tab -->
                                                                <template x-if="activeBottomTab === 'output'">
                                                                        <div class="h-full overflow-y-auto p-3 font-mono text-[10px] space-y-1">
                                                                                <div class="text-muted-foreground text-center py-8">
                                                                                        @icon.Info(icon.Props{Class: "size-8 opacity-30 mx-auto mb-2"})
                                                                                        <p>Evaluation output will appear here</p>
                                                                                </div>
                                                                        </div>
                                                                </template>

                                                        </div>
                                                </div>

							</div><!-- /Main Content Area -->
						</div><!-- /IDE LAYOUT -->
					<!-- Blinking cursor keyframe -->
					<style>@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}</style>
					<!-- Keyboard Shortcuts Overlay -->
					<div
						x-show="$store.flow?._showHelp"
						x-transition:enter="transition ease-out duration-150"
						x-transition:enter-start="opacity-0"
						x-transition:enter-end="opacity-100"
						x-transition:leave="transition ease-in duration-100"
						x-transition:leave-start="opacity-100"
						x-transition:leave-end="opacity-0"
						@click="$store.flow._showHelp = false"
						@keydown.escape.window="if ($store.flow?._showHelp) $store.flow._showHelp = false"
						class="absolute inset-0 z-50 flex items-center justify-center"
						style="background:rgba(0,0,0,0.5); backdrop-filter:blur(2px);"
					>
						<div @click.stop class="rounded-xl border border-border shadow-2xl max-w-md w-full bg-background">
							<div class="px-5 pt-5 pb-3">
								<h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.Keyboard(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "Workflow Editor Shortcuts") }
								</h3>
								<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "Navigate and edit your workflow faster.") }</p>
							</div>
							<div class="px-5 pb-4 space-y-4">
								<!-- Editing -->
								<div>
									<h4 class="text-xs font-semibold text-muted-foreground mb-2">{ i18n.T(ctx, "Editing") }</h4>
									<div class="space-y-1">
										@shortcutRow(i18n.T(ctx, "Delete selected node"), "Delete")
										@shortcutRow(i18n.T(ctx, "Duplicate selected node"), "Ctrl+D")
										@shortcutRow(i18n.T(ctx, "Undo"), "Ctrl+Z")
										@shortcutRow(i18n.T(ctx, "Redo"), "Ctrl+Shift+Z")
									</div>
								</div>
								<!-- Navigation -->
								<div>
									<h4 class="text-xs font-semibold text-muted-foreground mb-2">{ i18n.T(ctx, "Navigation") }</h4>
									<div class="space-y-1">
										@shortcutRow(i18n.T(ctx, "Move node up"), "Ctrl+↑")
										@shortcutRow(i18n.T(ctx, "Move node down"), "Ctrl+↓")
										@shortcutRow(i18n.T(ctx, "Collapse node"), "←")
										@shortcutRow(i18n.T(ctx, "Expand node"), "→")
									</div>
								</div>
								<!-- General -->
								<div>
									<h4 class="text-xs font-semibold text-muted-foreground mb-2">{ i18n.T(ctx, "General") }</h4>
									<div class="space-y-1">
										@shortcutRow(i18n.T(ctx, "Toggle property panel"), "Ctrl+]")
										@shortcutRow(i18n.T(ctx, "Show this help"), "?")
									</div>
								</div>
								<!-- Tip -->
								<div class="flex items-start gap-2 p-2.5 rounded-lg">
									@icon.Info(icon.Props{Class: "size-3.5 text-primary shrink-0 mt-0.5"})
									<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "On macOS, use ⌘ instead of Ctrl") }</p>
								</div>
							</div>
						</div>
					</div>
					</div>
}
