package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/components/label"
	"aicompass/frontend/components/textarea"
)

// AgentDesignerDialog is the unified dialog for creating and managing AI agents.
// Supports single agents and multi-agent workflows (sequential, parallel, loop).
templ AgentDesignerDialog() {
	<div
		x-data="agentDesigner"
		x-init="init()"
		@open-agent-designer.window="open()"
		@open-agent-designer-node.window="open(); $nextTick(() => showEditNodeForm($event.detail))"
		@open-agent-designer-pipeline.window="open(); $nextTick(() => showEditPipelineForm($event.detail))"
		@open-agent-designer-with-id.window="open(); $nextTick(() => { fetchAgentById($event.detail.agentId).then(agent => { if (agent.isComposed) showEditPipelineForm(agent); else showEditNodeForm(agent); }) })"
		@open-agent-designer-templates.window="open(); $nextTick(() => openTemplatesView())"
		@agents-updated.window="fetchAgents()"
	>
		@dialog.Dialog(dialog.Props{
			ID: "agent-designer-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				HideCloseButton: true,
				Class:           "sm:max-w-5xl max-h-[90vh] flex flex-col p-0 overflow-hidden transition-all duration-300 ease-in-out",
				Attributes: templ.Attributes{
					":class": "expanded ? '!max-w-[calc(100vw-2rem)] !max-h-[calc(100vh-2rem)] !w-[calc(100vw-2rem)] !h-[calc(100vh-2rem)]' : ''",
				},
			}) {
				@dialog.Header(dialog.HeaderProps{Class: "p-4 pb-3 border-b border-border"}) {
					<div class="flex items-center justify-between">
						<div>
							@dialog.Title() {
								<span class="flex items-center gap-2">
									@icon.Workflow(icon.Props{Class: "size-5"})
									{ i18n.T(ctx, "Agent Designer") }
								</span>
							}
							@dialog.Description() {
								{ i18n.T(ctx, "Create AI agents and orchestrate workflows.") }
							}
						</div>
						<div class="flex items-center gap-1">
							@button.Button(button.Props{
								Size:    button.SizeIcon,
								Variant: button.VariantGhost,
								Class:   "size-7 text-muted-foreground",
								Attributes: templ.Attributes{
									"@click": "toggleExpand()",
									"title":  i18n.T(ctx, "Toggle fullscreen"),
								},
							}) {
								<span x-show="!expanded">
									@icon.Maximize2(icon.Props{Class: "size-3.5"})
								</span>
								<span x-show="expanded">
									@icon.Minimize2(icon.Props{Class: "size-3.5"})
								</span>
							}
							@dialog.Close() {
								@button.Button(button.Props{
									Size:    button.SizeIcon,
									Variant: button.VariantGhost,
									Class:   "size-7 text-muted-foreground",
									Attributes: templ.Attributes{
										"title": i18n.T(ctx, "Close"),
									},
								}) {
									@icon.X(icon.Props{Class: "size-3.5"})
								}
							}
						</div>
					</div>
				}
				<!-- ═══════════════════════════════════════════ -->
				<!-- UNIFIED AGENT LIST                         -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'list'">
					@listView()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- TYPE SELECTOR                               -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'typeSelect'">
					@typeSelectView()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- IMPORT YAML                                 -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'importYaml'">
					@importYamlView()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- TEMPLATES / CATALOG                         -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'templates'">
					@templatesView()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- FORK NAME DIALOG                          -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="showForkNameDialog">
					@forkNameDialog()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- AGENT FORM                                  -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'agentForm'">
					@agentFormView()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- DELETE CONFIRMATION                         -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'delete'">
					@deleteConfirmation("view = 'list'", "deletingAgent?.isComposed ? deletePipeline() : deleteNode()")
				</template>
				<!-- DELETE ALL CONFIRMATION                     -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'deleteAll'">
					@deleteAllConfirmation()
				</template>
				<!-- ═══════════════════════════════════════════ -->
				<!-- WORKFLOW AGENT FORM                         -->
				<!-- ═══════════════════════════════════════════ -->
				<!-- ═══════════════════════════════════════════ -->
				<!-- WORKFLOW TREE EDITOR                        -->
				<!-- ═══════════════════════════════════════════ -->
				<template x-if="view === 'flow'">
					@flowView()
				</template>
			}
		}
		@toastStack()
	</div>
}

// agentNodeForm renders the form fields for creating/editing a single agent.
templ agentNodeForm() {
	<!-- Identity Section -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<div class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-primary/5 to-transparent border-b border-border/50">
			<div class="size-6 rounded-md bg-primary/10 flex items-center justify-center">
				@icon.Bot(icon.Props{Class: "size-3.5 text-primary"})
			</div>
			<span class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "Identity") }</span>
			<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Basic information about this agent") }</span>
		</div>
		<div class="p-4 space-y-4">
			<div class="space-y-1.5">
				@label.Label(label.Props{Class: "text-xs"}) {
					{ i18n.T(ctx, "Name") }
					<span class="text-destructive">*</span>
				}
				@input.Input(input.Props{
					Placeholder: i18n.T(ctx, "e.g., Writing Coach, Code Reviewer..."),
					Class:       "h-9 text-sm",
					Attributes: templ.Attributes{
						"x-model":   "form.name",
						"maxlength": "100",
					},
				})
			</div>
			<div class="space-y-1.5">
				@label.Label(label.Props{Class: "text-xs"}) {
					{ i18n.T(ctx, "Description") }
				}
				@input.Input(input.Props{
					Placeholder: i18n.T(ctx, "Brief description of what this agent does..."),
					Class:       "h-9 text-sm",
					Attributes: templ.Attributes{
						"x-model":   "form.description",
						"maxlength": "500",
					},
				})
			</div>
		</div>
	</div>
	@formInstructionsSection()
	@formGlobalInstructionSection()
	@formMemorySection()
	@formArtifactsSection()
	@formCodeExecutionSection()
	@formStreamingSection()
	<!-- Sub-Agents (Coordinator) Section -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showSubAgents = !showSubAgents"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showSubAgents ? 'bg-gradient-to-r from-violet-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-violet-500/10 flex items-center justify-center">
					@icon.Users(icon.Props{Class: "size-3.5 text-violet-600 dark:text-violet-400"})
				</div>
				{ i18n.T(ctx, "Sub-Agents") }
				<span class="text-[10px] text-muted-foreground" x-text="(form.subAgents || []).length > 0 ? '(' + (form.subAgents || []).length + ')' : ''"></span>
			</span>
			<span class="transition-transform duration-200" :class="showSubAgents ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showSubAgents" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-violet-500"})
					{ i18n.T(ctx, "This agent will act as a coordinator, delegating tasks to specialist sub-agents. The coordinator LLM decides which sub-agent to use based on conversation context.") }
				</p>

				<button type="button" @click="openSubAgentDialog()" class="w-full text-center text-xs text-primary hover:text-primary/80 py-1.5 border border-dashed border-border rounded-lg hover:border-primary/40 transition-colors">
					+ { i18n.T(ctx, "Select Sub-Agents") }
				</button>

				<!-- Selected Agents List -->
				<div class="space-y-1.5">
					<template x-for="(ref, idx) in (form.subAgents || [])" :key="ref.agent_id">
						<div class="flex items-center gap-2 p-2 rounded-md border border-border">
							<span class="size-5 rounded bg-primary/10 flex items-center justify-center text-primary shrink-0 text-[10px] font-bold" x-text="idx + 1"></span>
							<div class="flex-1 min-w-0">
								<div class="text-xs font-medium truncate" x-text="getAgentName(ref.agent_id)"></div>
							</div>
							<button type="button" @click="removeSubAgent(idx)" class="text-muted-foreground hover:text-destructive transition-colors shrink-0">
								@icon.X(icon.Props{Class: "size-3"})
							</button>
						</div>
					</template>
					<template x-if="(form.subAgents || []).length === 0">
						<div class="text-center text-xs text-muted-foreground py-2">{ i18n.T(ctx, "No sub-agents selected") }</div>
					</template>
				</div>

				<!-- Delegation Controls (part of coordinator config) -->
				<div class="pt-2 border-t border-border/50">
					<span class="text-[10px] font-semibold text-foreground uppercase tracking-wider flex items-center gap-1.5 mb-2">
						@icon.Shield(icon.Props{Class: "size-3 text-muted-foreground"})
						{ i18n.T(ctx, "Delegation Policy") }
					</span>
					<p class="text-[10px] text-muted-foreground mb-2">{ i18n.T(ctx, "Control how the coordinator delegates to sub-agents.") }</p>
					<div class="space-y-1.5">
						@toggleSwitch("form.disallowTransferToParent", i18n.T(ctx, "Prevent escalation to parent"), i18n.T(ctx, "Sub-agents cannot hand work back to the coordinator's parent."))
						@toggleSwitch("form.disallowTransferToPeers", i18n.T(ctx, "Prevent delegation to siblings"), i18n.T(ctx, "Sub-agents cannot pass work to other agents at the same level."))
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Agents-as-Tools Section -->
	<!-- Orthogonal to Sub-Agents: the parent calls these as tools and keeps -->
	<!-- control; Sub-Agents delegate control via transfer. Maps to ADK-Go's -->
	<!-- tool/agenttool package. -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showAgentTools = !showAgentTools"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showAgentTools ? 'bg-gradient-to-r from-sky-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-sky-500/10 flex items-center justify-center">
					@icon.Wrench(icon.Props{Class: "size-3.5 text-sky-600 dark:text-sky-400"})
				</div>
				{ i18n.T(ctx, "Agents as Tools") }
				<span class="text-[10px] text-muted-foreground" x-text="(form.agentTools || []).length > 0 ? '(' + (form.agentTools || []).length + ')' : ''"></span>
			</span>
			<span class="transition-transform duration-200" :class="showAgentTools ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showAgentTools" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-sky-500"})
					{ i18n.T(ctx, "Expose other agents as callable tools. The parent LLM calls them like any function, receives their output, and continues. Unlike Sub-Agents, control does not transfer — this agent stays in charge.") }
				</p>

				<button type="button" @click="openAgentToolsDialog()" class="w-full text-center text-xs text-primary hover:text-primary/80 py-1.5 border border-dashed border-border rounded-lg hover:border-primary/40 transition-colors">
					+ { i18n.T(ctx, "Add Agent Tool") }
				</button>

				<!-- Selected Agent-Tools List -->
				<div class="space-y-1.5">
					<template x-for="(ref, idx) in (form.agentTools || [])" :key="ref.agent_id">
						<div class="flex items-center gap-2 p-2 rounded-md border border-border">
							<div class="size-5 rounded bg-sky-500/10 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
								@icon.Wrench(icon.Props{Class: "size-3"})
							</div>
							<div class="flex-1 min-w-0">
								<div class="text-xs font-medium truncate" x-text="getAgentName(ref.agent_id)"></div>
								<label class="flex items-center gap-1.5 text-[10px] text-muted-foreground cursor-pointer mt-0.5 select-none">
									<input
										type="checkbox"
										class="size-3 accent-sky-500"
										:checked="ref.skip_summarization"
										@change="toggleAgentToolSkipSummarization(idx)"
									/>
									{ i18n.T(ctx, "Return raw output (skip summarization)") }
								</label>
							</div>
							<button type="button" @click="removeAgentTool(idx)" class="text-muted-foreground hover:text-destructive transition-colors shrink-0">
								@icon.X(icon.Props{Class: "size-3"})
							</button>
						</div>
					</template>
					<template x-if="(form.agentTools || []).length === 0">
						<div class="text-center text-xs text-muted-foreground py-2">{ i18n.T(ctx, "No agent tools selected") }</div>
					</template>
				</div>
			</div>
		</div>
	</div>

	<!-- Agent-Tool Selection Dialog -->
	<template x-if="agentToolsDialogOpen">
		<div class="fixed inset-0 z-[60] flex items-center justify-center p-4">
			<div class="fixed inset-0 bg-black/60 backdrop-blur-sm" @click="agentToolsDialogOpen = false"></div>
			<div class="relative w-full max-w-2xl bg-card border border-border rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
				<div class="flex items-center justify-between px-4 py-3 border-b border-border/50 shrink-0">
					<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Add Agent Tools") }</h3>
					<button type="button" @click="agentToolsDialogOpen = false" class="text-muted-foreground hover:text-foreground transition-colors">
						@icon.X(icon.Props{Class: "size-4"})
					</button>
				</div>
				<div class="flex-1 overflow-y-auto p-4 space-y-1.5">
					<template x-for="agent in allAgents.filter(a => a.id !== editingAgent?.id)" :key="agent.id">
						<button type="button" @click="toggleAgentToolFromDialog(agent.id)" class="w-full flex items-center gap-3 p-2.5 rounded-lg border transition-colors text-left"
							:class="isAgentToolSelected(agent.id) ? 'border-sky-400/50 bg-sky-500/5' : 'border-border hover:bg-accent/30'"
						>
							<div class="size-8 rounded-lg bg-sky-500/10 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
								<template x-if="isAgentToolSelected(agent.id)">
									@icon.Check(icon.Props{Class: "size-4"})
								</template>
								<template x-if="!isAgentToolSelected(agent.id)">
									@icon.Wrench(icon.Props{Class: "size-4"})
								</template>
							</div>
							<div class="flex-1 min-w-0">
								<div class="text-xs font-medium text-foreground truncate" x-text="agent.name"></div>
								<div class="text-[10px] text-muted-foreground truncate" x-text="agent.description"></div>
							</div>
						</button>
					</template>
					<template x-if="allAgents.filter(a => a.id !== editingAgent?.id).length === 0">
						<div class="text-center text-xs text-muted-foreground py-8">{ i18n.T(ctx, "No other agents available") }</div>
					</template>
				</div>
				<div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-border/50 shrink-0">
					<button type="button" @click="agentToolsDialogOpen = false" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-medium transition-colors focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3">
						{ i18n.T(ctx, "Done") }
					</button>
				</div>
			</div>
		</div>
	</template>

	<!-- Sub-Agent Selection Dialog -->
	<template x-if="subAgentDialogOpen">
		<div class="fixed inset-0 z-[60] flex items-center justify-center p-4">
			<div class="fixed inset-0 bg-black/60 backdrop-blur-sm" @click="subAgentDialogOpen = false"></div>
			<div class="relative w-full max-w-2xl bg-card border border-border rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
				<div class="flex items-center justify-between px-4 py-3 border-b border-border/50 shrink-0">
					<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Select Sub-Agents") }</h3>
					<button type="button" @click="subAgentDialogOpen = false" class="text-muted-foreground hover:text-foreground transition-colors">
						@icon.X(icon.Props{Class: "size-4"})
					</button>
				</div>
				<div class="flex-1 overflow-y-auto p-4 space-y-1.5">
					<template x-for="agent in availableAgentsForSubAgent" :key="agent.id">
						<button type="button" @click="toggleSubAgentFromDialog(agent.id)" class="w-full flex items-center gap-3 p-2.5 rounded-lg border transition-colors text-left"
							:class="isAgentSelected(agent.id) ? 'border-primary/40 bg-primary/5' : 'border-border hover:bg-accent/30'"
						>
							<div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
								<template x-if="isAgentSelected(agent.id)">
									@icon.Check(icon.Props{Class: "size-4"})
								</template>
								<template x-if="!isAgentSelected(agent.id)">
									@icon.Circle(icon.Props{Class: "size-4"})
								</template>
							</div>
							<div class="flex-1 min-w-0">
								<div class="text-xs font-medium text-foreground truncate" x-text="agent.name"></div>
								<div class="text-[10px] text-muted-foreground truncate" x-text="agent.description"></div>
							</div>
						</button>
					</template>
					<template x-if="availableAgentsForSubAgent.length === 0">
						<div class="text-center text-xs text-muted-foreground py-8">{ i18n.T(ctx, "No other agents available") }</div>
					</template>
				</div>
				<div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-border/50 shrink-0">
					<button type="button" @click="subAgentDialogOpen = false" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-medium transition-colors focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3">
						{ i18n.T(ctx, "Done") }
					</button>
				</div>
			</div>
		</div>
	</template>
	<!-- State & Context -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<div class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500/5 to-transparent border-b border-border/50">
			<div class="size-6 rounded-md bg-blue-500/10 flex items-center justify-center">
				@icon.Key(icon.Props{Class: "size-3.5 text-blue-600 dark:text-blue-400"})
			</div>
			<span class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "State & Context") }</span>
			<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "How this agent reads and writes session state") }</span>
		</div>
		<div class="p-4 space-y-4">
			<!-- Output Key -->
			<div class="space-y-2">
				<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
					@icon.ArrowRight(icon.Props{Class: "size-3.5 text-muted-foreground"})
					{ i18n.T(ctx, "Output Variable") }
				</span>
				@input.Input(input.Props{
					Placeholder: i18n.T(ctx, "e.g., research_results, draft_content..."),
					Class:       "h-8 text-xs",
					Attributes: templ.Attributes{
						"x-model":   "form.outputKey",
						"maxlength": "100",
					},
				})
				<p class="text-[10px] text-muted-foreground">
					{ i18n.T(ctx, "Store this agent's output in session state for other agents to reference via {variable_name}.") }
				</p>
			</div>
			<!-- Context Control -->
			<div class="space-y-2">
				<span class="text-xs font-medium text-foreground flex items-center gap-1.5">
					@icon.MessageSquare(icon.Props{Class: "size-3.5 text-muted-foreground"})
					{ i18n.T(ctx, "Conversation Context") }
				</span>
				<div class="flex gap-2">
					<button
						type="button"
						@click="form.includeContents = ''"
						class="flex-1 px-3 py-1.5 rounded-md border text-xs font-medium transition-colors"
						:class="!form.includeContents || form.includeContents === 'default' ? 'bg-primary text-primary-foreground border-primary' : 'text-muted-foreground border-border hover:bg-accent'"
					>
						{ i18n.T(ctx, "Include History") }
					</button>
					<button
						type="button"
						@click="form.includeContents = 'none'"
						class="flex-1 px-3 py-1.5 rounded-md border text-xs font-medium transition-colors"
						:class="form.includeContents === 'none' ? 'bg-primary text-primary-foreground border-primary' : 'text-muted-foreground border-border hover:bg-accent'"
					>
						{ i18n.T(ctx, "Fresh Context") }
					</button>
				</div>
				<p class="text-[10px] text-muted-foreground">
					{ i18n.T(ctx, "Choose whether this agent sees the full conversation history or only the current message.") }
				</p>
			</div>
		</div>
	</div>
	<!-- Called as a Tool — inbound signature. -->
	<!-- ADK reads llmagent.Config.InputSchema ONLY when this agent is wrapped -->
	<!-- via tool/agenttool. Direct chat, workflow leaves, and transfers ignore -->
	<!-- it — so this section only matters if another agent exposes this one as -->
	<!-- an agent-tool (see "Agents as Tools" above) or over A2A. -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showCalledAsTool = !showCalledAsTool"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showCalledAsTool ? 'bg-gradient-to-r from-slate-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-slate-500/10 flex items-center justify-center">
					@icon.ArrowDownToLine(icon.Props{Class: "size-3.5 text-slate-600 dark:text-slate-400"})
				</div>
				{ i18n.T(ctx, "Called as a Tool") }
				<span class="text-[10px] text-muted-foreground" x-text="inputSchemaRows.length > 0 ? '(' + inputSchemaRows.length + ' arg' + (inputSchemaRows.length === 1 ? '' : 's') + ')' : ''"></span>
			</span>
			<span class="transition-transform duration-200" :class="showCalledAsTool ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showCalledAsTool" x-collapse>
			<div class="p-4 space-y-3 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-slate-500"})
					{ i18n.T(ctx, "Define the arguments another agent must provide when calling this one as a tool. Leave empty for a single free-text argument. Ignored on direct chat — only matters when this agent is exposed via 'Agents as Tools' or A2A.") }
				</p>

				@schemaBuilder("inputSchema", i18n.T(ctx, "No arguments — callers will pass a single free-text request."))
			</div>
		</div>
	</div>

	<!-- Output Schema — universal: applies on every reply regardless of how -->
	<!-- the agent is invoked. Tools + transfer still work: ADK either passes -->
	<!-- ResponseSchema natively (most providers) or injects a set_model_response -->
	<!-- workaround tool (Gemini API + Gemini ≤ 2.5). Uses the shared -->
	<!-- @schemaBuilder from the Input Schema section above. -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showOutputSchema = !showOutputSchema"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showOutputSchema ? 'bg-gradient-to-r from-slate-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-slate-500/10 flex items-center justify-center">
					@icon.ArrowUpToLine(icon.Props{Class: "size-3.5 text-slate-600 dark:text-slate-400"})
				</div>
				{ i18n.T(ctx, "Output Schema") }
				<span class="text-[10px] text-muted-foreground" x-text="outputSchemaRows.length > 0 ? '(' + outputSchemaRows.length + ' field' + (outputSchemaRows.length === 1 ? '' : 's') + ')' : ''"></span>
			</span>
			<span class="transition-transform duration-200" :class="showOutputSchema ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showOutputSchema" x-collapse>
			<div class="p-4 space-y-3 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-slate-500"})
					{ i18n.T(ctx, "Constrain every reply to a JSON Schema. Tools and sub-agent transfer continue to work — the orchestration engine enforces the schema natively on most providers and falls back to an equivalent workaround on older Gemini models. Leave empty to keep replies free-form.") }
				</p>
				@schemaBuilder("outputSchema", i18n.T(ctx, "No schema — replies are free-form. Add a field to turn on structured output."))
			</div>
		</div>
	</div>
	<!-- Model Configuration -->
	@modelConfigurationSection()
	<!-- Tools, KBs, Filesystems (edit mode only) -->
	<template x-if="editingAgent">
		<div class="space-y-4">
			@toolsSection()
			@knowledgeBasesSection()
			@filesystemsSection()
		</div>
	</template>
	<!-- Info notice (create mode) -->
	<template x-if="!editingAgent">
		<div class="border border-border rounded-lg p-3 flex items-start gap-2">
			@icon.Info(icon.Props{Class: "size-4 text-muted-foreground shrink-0 mt-0.5"})
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "After creating the agent, you can add tools and knowledge bases by editing it.") }
			</p>
		</div>
	</template>
}

// toggleSwitch renders a labeled toggle switch for boolean form fields.
templ toggleSwitch(model string, labelText string, helpText string) {
	<label class="flex items-center justify-between gap-2 py-1.5 cursor-pointer">
		<div class="flex-1 min-w-0">
			<span class="text-xs font-medium text-foreground">{ labelText }</span>
			<p class="text-[10px] text-muted-foreground mt-0.5">{ helpText }</p>
		</div>
		<button
			type="button"
			x-on:click={ model + " = !" + model }
			class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
			x-bind:class={ model + " ? 'bg-primary' : 'bg-input'" }
			role="switch"
			x-bind:aria-checked={ model }
		>
			<span
				class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200 ease-in-out"
				x-bind:class={ model + " ? 'translate-x-4' : 'translate-x-0'" }
			></span>
		</button>
	</label>
}

// schemaBuilder renders the row-based JSON Schema editor used by both the
// Input Schema and Output Schema sections.
//
// fieldKey      — the form field this builder edits ("inputSchema" | "outputSchema").
//                 Drives the Alpine state names (<fieldKey>Mode, <fieldKey>Rows,
//                 <fieldKey>JSONError) and the form.<fieldKey> JSON fallback.
// emptyMessage  — the hint shown when there are zero rows in visual mode. Callers
//                 use different copy for inbound ("no arguments") vs outbound
//                 ("structured output off") semantics.
templ schemaBuilder(fieldKey, emptyMessage string) {
	<!-- Mode toggle (visual row builder ↔ raw JSON) -->
	<div class="flex items-center justify-between gap-2">
		<div class="inline-flex rounded-md border border-border overflow-hidden">
			<button
				type="button"
				@click={ "switchSchemaToVisual('" + fieldKey + "')" }
				class="px-3 py-1 text-[11px] font-medium transition-colors"
				:class={ fieldKey + "Mode === 'visual' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-accent'" }
			>{ i18n.T(ctx, "Fields") }</button>
			<button
				type="button"
				@click={ "switchSchemaToJSON('" + fieldKey + "')" }
				class="px-3 py-1 text-[11px] font-medium transition-colors border-s border-border"
				:class={ fieldKey + "Mode === 'json' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-accent'" }
			>{ i18n.T(ctx, "JSON") }</button>
		</div>
		<template x-if={ fieldKey + "Mode === 'visual'" }>
			<button
				type="button"
				@click={ "addSchemaRow('" + fieldKey + "')" }
				class="text-[11px] text-primary hover:text-primary/80 transition-colors"
			>
				+ { i18n.T(ctx, "Add field") }
			</button>
		</template>
	</div>
	<!-- Visual row builder -->
	<template x-if={ fieldKey + "Mode === 'visual'" }>
		<div class="space-y-2">
			<template x-for={ "(row, idx) in " + fieldKey + "Rows" } :key="idx">
				<div class="flex items-start gap-1.5 p-2 rounded-md border border-border">
					<div class="flex-1 min-w-0 grid grid-cols-[minmax(0,1fr)_auto] gap-1.5">
						<input
							type="text"
							x-model="row.name"
							placeholder="field_name"
							class="h-7 rounded-md border border-border bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						/>
						<select
							x-model="row.type"
							class="h-7 rounded-md border border-border bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						>
							<template x-for="t in schemaTypeOptions" :key="t">
								<option :value="t" x-text="t"></option>
							</template>
						</select>
						<input
							type="text"
							x-model="row.description"
							placeholder="Short description (optional)"
							class="col-span-2 h-7 rounded-md border border-border bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						/>
					</div>
					<label class="inline-flex items-center gap-1.5 text-[10px] text-muted-foreground cursor-pointer select-none mt-1">
						<input type="checkbox" x-model="row.required" class="size-3 accent-slate-500"/>
						{ i18n.T(ctx, "required") }
					</label>
					<button
						type="button"
						@click={ "removeSchemaRow('" + fieldKey + "', idx)" }
						class="text-muted-foreground hover:text-destructive transition-colors shrink-0 mt-1"
					>
						@icon.X(icon.Props{Class: "size-3"})
					</button>
				</div>
			</template>
			<template x-if={ fieldKey + "Rows.length === 0" }>
				<div class="text-center text-xs text-muted-foreground py-2">{ emptyMessage }</div>
			</template>
		</div>
	</template>
	<!-- JSON fallback view — used for schemas too complex for the row builder. -->
	<template x-if={ fieldKey + "Mode === 'json'" }>
		<div class="space-y-1.5">
			@textarea.Textarea(textarea.Props{
				Placeholder: i18n.T(ctx, `{"type": "object", "properties": {"topic": {"type": "string"}}, "required": ["topic"]}`),
				Class:       "min-h-[80px] resize-y font-mono text-[11px]",
				Rows:        3,
				Attributes: templ.Attributes{
					"x-model": "form." + fieldKey,
				},
			})
			<p class="text-[10px] text-muted-foreground">
				{ i18n.T(ctx, "Raw JSON Schema. Use this for nested or array fields the row builder can't express.") }
			</p>
			<template x-if={ fieldKey + "JSONError" }>
				<p class="text-[10px] text-destructive" x-text={ fieldKey + "JSONError" }></p>
			</template>
		</div>
	</template>
}

// shortcutRow renders a single keyboard shortcut row for the help overlay.
templ shortcutRow(label string, keys string) {
	<div class="flex items-center justify-between py-1.5 px-2.5 rounded-md hover:transition-colors">
		<span class="text-xs text-foreground">{ label }</span>
		<div class="flex items-center gap-1">
			<kbd class="kbd">{ keys }</kbd>
		</div>
	</div>
}

// modelConfigurationSection renders a unified panel for per-agent model configuration.
// It combines provider/model selection (AgentModelOverride) and generation parameters
// (AgentModelConfig) into one cohesive section, matching the unified agent config pipeline.
templ modelConfigurationSection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showModelConfig = !showModelConfig"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showModelConfig ? 'bg-gradient-to-r from-primary/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-primary/10 flex items-center justify-center">
					@icon.Cpu(icon.Props{Class: "size-3.5 text-primary"})
				</div>
				{ i18n.T(ctx, "Model Configuration") }
				<span
					class="text-[10px] text-muted-foreground"
					x-show="(form.modelOverride.provider && form.modelOverride.modelName) || form.modelConfig.temperature !== null || form.modelConfig.topP !== null || form.modelConfig.topK !== null || form.modelConfig.maxOutputTokens !== null || form.modelConfig.stopSequences.length > 0"
				>
					<template x-if="form.modelOverride.provider && form.modelOverride.modelName">
						<span class="font-mono" x-text="' ' + form.modelOverride.provider + '/' + form.modelOverride.modelName"></span>
					</template>
					<template x-if="!form.modelOverride.provider || !form.modelOverride.modelName">
						<span>{ i18n.T(ctx, "overrides set") }</span>
					</template>
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showModelConfig ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showModelConfig" x-collapse>
			<div class="p-4 space-y-6 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-primary"})
					{ i18n.T(ctx, "Choose a specific AI model and fine-tune generation parameters for this agent. Leave blank to use your global defaults.") }
				</p>

				<!-- ═══ Model Selection ═══ -->
				<div class="space-y-3">
					<h4 class="text-[10px] uppercase tracking-widest text-muted-foreground font-semibold flex items-center gap-1.5">
						@icon.Layers(icon.Props{Class: "size-3"})
						{ i18n.T(ctx, "Model") }
					</h4>
					<!-- Provider -->
					<div class="space-y-1.5">
						<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Provider") }</span>
						<select
							class="w-full h-9 rounded-lg border border-input bg-background px-3 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
							x-model="form.modelOverride.provider"
							@change="form.modelOverride.modelName = ''; fetchModelsForProvider($event.target.value)"
						>
							<option value="">{ i18n.T(ctx, "— use global default —") }</option>
							<option value="gemini">Gemini (Google)</option>
							<option value="openai">OpenAI</option>
							<option value="anthropic">Anthropic</option>
						</select>
					</div>
					<!-- Model -->
					<div class="space-y-1.5" x-show="form.modelOverride.provider">
						<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Model") }</span>
						<div x-show="providerModelsLoading" class="text-xs text-muted-foreground py-2">{ i18n.T(ctx, "Loading models…") }</div>
						<div x-show="providerModelsError && !providerModelsLoading" class="text-xs text-destructive py-1" x-text="providerModelsError"></div>
						<select
							x-show="!providerModelsLoading"
							class="w-full h-9 rounded-lg border border-input bg-background px-3 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
							x-model="form.modelOverride.modelName"
						>
							<option value="">{ i18n.T(ctx, "— select a model —") }</option>
							<template x-for="m in providerModelOptions" :key="m.id">
								<option :value="m.id" x-text="m.displayName"></option>
							</template>
						</select>
					</div>
					<!-- Clear -->
					<button
						type="button"
						x-show="form.modelOverride.provider || form.modelOverride.modelName"
						@click="form.modelOverride = { provider: '', modelName: '' }; providerModelOptions = []; providerModelsError = ''"
						class="text-xs text-muted-foreground hover:text-destructive transition-colors inline-flex items-center gap-1"
					>
						@icon.X(icon.Props{Class: "size-3"})
						{ i18n.T(ctx, "Clear override") }
					</button>
				</div>

				<!-- ═══ Generation Parameters ═══ -->
				<div class="space-y-4 pt-4 border-t border-border/50">
					<h4 class="text-[10px] uppercase tracking-widest text-muted-foreground font-semibold flex items-center gap-1.5">
						@icon.SlidersHorizontal(icon.Props{Class: "size-3"})
						{ i18n.T(ctx, "Generation Parameters") }
					</h4>
					<!-- Temperature -->
					<div class="space-y-1.5">
						<div class="flex items-center justify-between">
							<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Temperature") }</span>
							<span class="text-[11px] text-muted-foreground font-mono" x-text="form.modelConfig.temperature !== null && form.modelConfig.temperature !== '' ? form.modelConfig.temperature : '—'"></span>
						</div>
						<input
							type="range"
							min="0"
							max="2"
							step="0.05"
							class="w-full accent-primary"
							x-model.number="form.modelConfig.temperature"
						/>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Lower = focused, higher = creative.") }</p>
					</div>
					<!-- Max Output Tokens -->
					<div class="space-y-1.5">
						<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Max Output Tokens") }</span>
						@input.Input(input.Props{
							Type:        "number",
							Placeholder: i18n.T(ctx, "e.g. 4096 (blank = global default)"),
							Attributes: templ.Attributes{
								"x-model.number": "form.modelConfig.maxOutputTokens",
								"min":            "1",
								"max":            "65536",
							},
						})
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Maximum response length (1–65,536 tokens).") }</p>
					</div>
					<!-- Advanced: TopP / TopK -->
					<details class="group">
						<summary class="text-[11px] text-muted-foreground cursor-pointer select-none list-none flex items-center gap-1 hover:text-foreground transition-colors">
							<span class="transition-transform group-open:rotate-90">▶</span>
							{ i18n.T(ctx, "Advanced sampling (TopP / TopK)") }
						</summary>
						<div class="mt-3 space-y-3">
							<!-- TopP -->
							<div class="space-y-1.5">
								<div class="flex items-center justify-between">
									<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Top-P (nucleus sampling)") }</span>
									<span class="text-[11px] text-muted-foreground font-mono" x-text="form.modelConfig.topP !== null && form.modelConfig.topP !== '' ? form.modelConfig.topP : '—'"></span>
								</div>
								<input
									type="range"
									min="0"
									max="1"
									step="0.01"
									class="w-full accent-primary"
									x-model.number="form.modelConfig.topP"
								/>
								<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Controls diversity. 0.9 = top 90% most likely words.") }</p>
							</div>
							<!-- TopK -->
							<div class="space-y-1.5">
								<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Top-K") }</span>
								@input.Input(input.Props{
									Type:        "number",
									Placeholder: i18n.T(ctx, "e.g. 40 (blank = model default)"),
									Attributes: templ.Attributes{
										"x-model.number": "form.modelConfig.topK",
										"min":            "1",
									},
								})
								<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Limits the model to the top K most likely words.") }</p>
							</div>
						</div>
					</details>
					<!-- Stop Sequences -->
					<div class="space-y-1.5">
						<span class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Stop Sequences") }</span>
						<div class="flex flex-wrap gap-1 min-h-7 p-1.5 rounded-md border border-input bg-background">
							<template x-for="(seq, idx) in form.modelConfig.stopSequences" :key="idx">
								<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-muted text-[11px] font-mono">
									<span x-text="seq"></span>
									<button type="button" @click="form.modelConfig.stopSequences.splice(idx, 1)" class="text-muted-foreground hover:text-foreground leading-none">&times;</button>
								</span>
							</template>
							<input
								type="text"
								class="flex-1 min-w-[120px] bg-transparent text-[11px] font-mono outline-none placeholder:text-muted-foreground"
								placeholder={ i18n.T(ctx, "Type and press Enter…") }
								@keydown.enter.prevent="
									const v = $event.target.value.trim();
									if (v && !form.modelConfig.stopSequences.includes(v)) {
										form.modelConfig.stopSequences.push(v);
									}
									$event.target.value = '';
								"
							/>
						</div>
						<p class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Stops generation on any of these strings. Enter to add.") }</p>
					</div>
					<!-- Reset button -->
					<button
						type="button"
						@click="form.modelConfig = { temperature: null, topP: null, topK: null, maxOutputTokens: null, stopSequences: [] }"
						class="text-xs text-muted-foreground hover:text-destructive transition-colors inline-flex items-center gap-1"
					>
						@icon.RotateCcw(icon.Props{Class: "size-3"})
						{ i18n.T(ctx, "Reset all to global defaults") }
					</button>
				</div>
			</div>
		</div>
	</div>
}

// toolsSection renders the collapsible tools section for an agent in edit mode.
//
// Each plugin and tool row has two independent controls:
//   1. Enable toggle (right side) — allow ↔ block. Binary. Saves immediately.
//   2. "Confirm" mini-toggle — shown only when enabled. Sets require_confirmation.
//      Orthogonal to the enable state: a tool can be enabled with or without confirmation.
//
// A gear (⚙) icon appears next to the confirm toggle when confirmation is on,
// opening a small settings panel for the hint text and per-turn invocation limit.
// Additional future requirements (rate limits, cost budgets, etc.) can be added
// as further independent mini-toggles in the same row without restructuring.
templ toolsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showTools = !showTools"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Blocks(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Tools") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="toolsSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showTools ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showTools" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingTools">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingTools">
				<div>
					<template x-if="agentPlugins.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No plugins available. Add plugins from the Tools sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="plugin in agentPlugins" :key="plugin.id">
							<div class="rounded-md border border-border overflow-hidden">
								<!-- Plugin header row -->
								<div
									class="flex items-center gap-2 p-2 transition-colors"
									:class="plugin.requirement_config?.action === 'block' ? 'bg-muted/30' : ''"
								>
									<!-- Icon -->
									<div
										class="size-7 rounded-md flex items-center justify-center shrink-0 transition-colors"
										:class="plugin.requirement_config?.action === 'block' ? 'bg-muted text-muted-foreground' : 'bg-primary/10 text-primary'"
									>
										@icon.Blocks(icon.Props{Class: "size-3.5"})
									</div>
									<!-- Name + tool count -->
									<div class="flex-1 min-w-0">
										<div
											class="text-xs font-medium truncate transition-colors"
											:class="plugin.requirement_config?.action === 'block' ? 'line-through text-muted-foreground' : 'text-foreground'"
											x-text="plugin.name"
										></div>
										<div class="text-[10px] text-muted-foreground tabular-nums" x-text="plugin.tools.length + ' tools'"></div>
									</div>
									<!-- Confirm mini-toggle — only visible when plugin is enabled.
									     Orthogonal to the enable toggle: pauses before each run and asks user. -->
									<template x-if="isPluginEnabled(plugin)">
										<div class="flex items-center gap-1.5 shrink-0">
											<label
												class="flex items-center gap-1 cursor-pointer select-none"
												:title="plugin.requirement_config?.action === 'require_confirmation' ? 'Confirmation required before each run — click to turn off' : 'Click to require user confirmation before each run'"
											>
												<span
													class="text-[10px] transition-colors"
													:class="plugin.requirement_config?.action === 'require_confirmation' ? 'text-amber-600 dark:text-amber-400 font-medium' : 'text-muted-foreground'"
												>{ i18n.T(ctx, "Confirm") }</span>
												<!-- Mini toggle switch -->
												<button
													type="button"
													@click.stop="setToolSetAction(plugin, plugin.requirement_config?.action === 'require_confirmation' ? 'allow' : 'require_confirmation')"
													role="switch"
													:aria-checked="plugin.requirement_config?.action === 'require_confirmation'"
													class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
													:class="plugin.requirement_config?.action === 'require_confirmation' ? 'bg-amber-500' : 'bg-input'"
												>
													<span
														class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200"
														:class="plugin.requirement_config?.action === 'require_confirmation' ? 'translate-x-3' : 'translate-x-0'"
													></span>
												</button>
											</label>
											<!-- Gear icon for confirmation hint + invocation limit -->
											<template x-if="plugin.requirement_config?.action === 'require_confirmation'">
												<button
													type="button"
													@click.stop="openToolSetRequirements(plugin)"
													title="Set confirmation prompt and invocation limits"
													class="p-1 rounded text-amber-500/70 hover:text-amber-600 hover:bg-amber-500/10 transition-colors"
												>
													@icon.SlidersHorizontal(icon.Props{Class: "size-3"})
												</button>
											</template>
										</div>
									</template>
									<!-- Enable/disable toggle — allow ↔ block -->
									<!-- Absence of requirement_config means disabled (no tools enabled by default) -->
									<button
										type="button"
										@click.stop="setToolSetAction(plugin, isPluginEnabled(plugin) ? 'block' : 'allow')"
										role="switch"
										:aria-checked="isPluginEnabled(plugin)"
										:title="isPluginEnabled(plugin) ? 'Disable plugin' : 'Enable plugin'"
										class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
										:class="isPluginEnabled(plugin) ? 'bg-primary' : 'bg-input'"
									>
										<span
											class="pointer-events-none inline-block size-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200"
											:class="isPluginEnabled(plugin) ? 'translate-x-4' : 'translate-x-0'"
										></span>
									</button>
								</div>
								<!-- Individual tools — shown when plugin is enabled and has multiple tools -->
								<template x-if="isPluginEnabled(plugin) && plugin.tools.length > 1">
									<div class="border-t border-border/50 divide-y divide-border/30 bg-background/40">
										<template x-for="tool in plugin.tools" :key="tool.id">
											<div
												class="flex items-center gap-2 px-2 py-1.5 transition-colors"
												:class="!isToolEnabled(tool) ? 'bg-muted/20' : ''"
											>
												<!-- Indent marker + name -->
												<span class="w-3 shrink-0"></span>
												<span
													class="text-[11px] flex-1 min-w-0 truncate transition-colors"
													:class="!isToolEnabled(tool) ? 'line-through text-muted-foreground/50' : 'text-muted-foreground'"
													x-text="tool.name"
												></span>
												<!-- Confirm mini-toggle (only when tool is enabled) -->
												<template x-if="isToolEnabled(tool)">
													<div class="flex items-center gap-1 shrink-0">
														<label
															class="flex items-center gap-1 cursor-pointer select-none"
															:title="tool.requirement_config?.action === 'require_confirmation' ? 'Confirmation required — click to turn off' : 'Require confirmation before this tool runs'"
														>
															<span
																class="text-[9px] transition-colors"
																:class="tool.requirement_config?.action === 'require_confirmation' ? 'text-amber-600 dark:text-amber-400 font-medium' : 'text-muted-foreground'"
															>{ i18n.T(ctx, "Confirm") }</span>
															<button
																type="button"
																@click.stop="setToolAction(plugin, tool, tool.requirement_config?.action === 'require_confirmation' ? 'allow' : 'require_confirmation')"
																role="switch"
																:aria-checked="tool.requirement_config?.action === 'require_confirmation'"
																class="relative inline-flex h-3.5 w-6 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
																:class="tool.requirement_config?.action === 'require_confirmation' ? 'bg-amber-500' : 'bg-input'"
															>
																<span
																	class="pointer-events-none inline-block size-2.5 rounded-full bg-background shadow ring-0 transition-transform duration-200"
																	:class="tool.requirement_config?.action === 'require_confirmation' ? 'translate-x-2.5' : 'translate-x-0'"
																></span>
															</button>
														</label>
														<!-- Gear for tool-level confirmation hint/limits -->
														<template x-if="tool.requirement_config?.action === 'require_confirmation'">
															<button
																type="button"
																@click.stop="openToolRequirements(plugin, tool)"
																title="Set confirmation prompt and invocation limits"
																class="p-0.5 rounded text-amber-500/70 hover:text-amber-600 hover:bg-amber-500/10 transition-colors"
															>
																@icon.SlidersHorizontal(icon.Props{Class: "size-2.5"})
															</button>
														</template>
													</div>
												</template>
												<!-- Enable/disable toggle for individual tool -->
												<button
													type="button"
													@click.stop="setToolAction(plugin, tool, tool.requirement_config?.action === 'block' ? 'allow' : 'block')"
													role="switch"
													:aria-checked="tool.requirement_config?.action !== 'block'"
													:title="tool.requirement_config?.action === 'block' ? 'Enable tool' : 'Disable tool'"
													class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
													:class="tool.requirement_config?.action !== 'block' ? 'bg-primary' : 'bg-input'"
												>
													<span
														class="pointer-events-none inline-block size-3 rounded-full bg-background shadow ring-0 transition-transform duration-200"
														:class="tool.requirement_config?.action !== 'block' ? 'translate-x-3' : 'translate-x-0'"
													></span>
												</button>
											</div>
										</template>
									</div>
								</template>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
	<!-- Confirmation settings panel — opens via the gear icon when confirm is on.
	     Contains only the hint text and invocation limit; the enable/confirm toggles
	     are inline in the row and do not appear here. -->
	@toolRequirementsDialog()
}

// toolRequirementsDialog renders the confirmation settings panel for a tool or tool set.
// Reached only via the gear (⚙) icon that appears next to the Confirm toggle.
// Contains only the hint text and per-turn invocation limit.
// The enable/disable toggle and the confirm toggle live inline in the tool list rows.
templ toolRequirementsDialog() {
	<!-- Backdrop overlay -->
	<div
		x-show="showRequirementsPanel"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@click.self="closeRequirementsPanel()"
		class="fixed inset-0 z-60 bg-black/40 backdrop-blur-[3px]"
	></div>
	<!-- Dialog content -->
	<div
		x-show="showRequirementsPanel"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 scale-[0.97]"
		x-transition:enter-end="opacity-100 scale-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 scale-100"
		x-transition:leave-end="opacity-0 scale-[0.97]"
		@keydown.escape.window="closeRequirementsPanel()"
		class="fixed z-60 left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] bg-background rounded-2xl border border-border/60 shadow-modern-xl w-full max-w-[calc(100%-2rem)] sm:max-w-md"
	>
		<!-- Header -->
		<div class="flex items-center justify-between px-5 pt-5 pb-0">
			<div class="flex items-center gap-2.5">
				<div class="size-8 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-600 dark:text-amber-400">
					@icon.SlidersHorizontal(icon.Props{Class: "size-4"})
				</div>
				<div>
					<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Confirmation Settings") }</h3>
					<p class="text-xs text-muted-foreground" x-text="reqConfigTarget?.name || ''"></p>
				</div>
			</div>
			<button
				type="button"
				@click="closeRequirementsPanel()"
				class="size-8 rounded-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
			>
				@icon.X(icon.Props{Class: "size-4"})
			</button>
		</div>
		<!-- Body -->
		<div class="px-5 py-4 space-y-4">
			<!-- Confirmation hint -->
			<div class="space-y-2">
				<label class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Confirmation Prompt") }</label>
				@textarea.Textarea(textarea.Props{
					Placeholder: i18n.T(ctx, "e.g., This tool will modify files. Are you sure?"),
					Class:       "min-h-[56px] resize-y text-xs",
					Rows:        2,
					Attributes: templ.Attributes{
						"x-model": "reqConfig.confirmation_hint",
					},
				})
				<p class="text-[11px] text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "Shown to the user before the tool runs. Leave blank to use a default prompt.") }
				</p>
			</div>
			<!-- Max invocations -->
			<div class="space-y-2">
				<label class="text-xs font-medium text-foreground">{ i18n.T(ctx, "Max Invocations per Turn") }</label>
				<input
					type="number"
					min="0"
					x-model.number="reqConfig.max_invocations"
					placeholder="0"
					class="w-full h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-ring"
				/>
				<p class="text-[11px] text-muted-foreground leading-relaxed">
					{ i18n.T(ctx, "Maximum times this tool can run in a single agent turn. 0 means unlimited.") }
				</p>
			</div>
		</div>
		<!-- Footer -->
		<div class="flex items-center justify-end gap-2 px-5 pb-5 pt-0">
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": "closeRequirementsPanel()",
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    "saveRequirementConfig()",
					":disabled": "savingReqConfig",
				},
			}) {
				<span x-show="!savingReqConfig" class="flex items-center gap-1.5">
					@icon.Check(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "Save") }
				</span>
				<span x-show="savingReqConfig" class="flex items-center gap-1.5">
					<span class="animate-spin size-3.5 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Saving...") }
				</span>
			}
		</div>
	</div>
}

// knowledgeBasesSection renders the collapsible KB section for an agent in edit mode.
templ knowledgeBasesSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showKnowledgeBases = !showKnowledgeBases"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Library(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Knowledge Bases") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="kbSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showKnowledgeBases ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showKnowledgeBases" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingKBs">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingKBs">
				<div>
					<template x-if="agentWorkspaces.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No knowledge bases available. Create one from the Resources sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="ws in agentWorkspaces" :key="ws.id">
							<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
								<div class="flex items-center gap-2 flex-1 min-w-0">
									<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
										@icon.Library(icon.Props{Class: "size-3.5"})
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-xs font-medium text-foreground truncate" x-text="ws.name"></div>
										<div class="text-[10px] text-muted-foreground truncate" x-text="ws.description || ws.slug"></div>
									</div>
								</div>
								<button
									@click="toggleAgentWorkspace(ws)"
									class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
									:class="ws.enabled ? 'bg-primary' : 'bg-input'"
									role="switch"
									:aria-checked="ws.enabled"
								>
									<span class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200" :class="ws.enabled ? 'translate-x-4' : 'translate-x-0'"></span>
								</button>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// filesystemsSection renders the collapsible filesystem section for an agent in edit mode.
templ filesystemsSection() {
	<div class="border border-border rounded-lg">
		<button
			type="button"
			@click="showFilesystems = !showFilesystems"
			class="flex items-center justify-between w-full p-3 text-sm font-medium text-foreground hover:bg-accent/30 rounded-lg transition-colors"
		>
			<span class="flex items-center gap-2">
				@icon.Folder(icon.Props{Class: "size-4 text-muted-foreground"})
				{ i18n.T(ctx, "Filesystems") }
				<span class="text-[10px] text-muted-foreground tabular-nums" x-text="fsSummary"></span>
			</span>
			<span class="transition-transform duration-200" :class="showFilesystems ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showFilesystems" x-collapse class="px-3 pb-3 border-t border-border pt-3">
			<template x-if="loadingFilesystems">
				<div class="space-y-2">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-2 animate-pulse rounded-md">
							<div class="size-7 rounded bg-muted"></div>
							<div class="flex-1 space-y-1">
								<div class="h-3 bg-muted rounded w-1/3"></div>
								<div class="h-2 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!loadingFilesystems">
				<div>
					<template x-if="agentFilesystems.length === 0">
						<div class="py-4 text-center text-xs text-muted-foreground">
							{ i18n.T(ctx, "No filesystems available. Create one from the Files sidebar.") }
						</div>
					</template>
					<div class="space-y-1.5">
						<template x-for="fs in agentFilesystems" :key="fs.id">
							<div class="flex items-center justify-between p-2 rounded-md border border-border hover:bg-accent/20 transition-colors">
								<div class="flex items-center gap-2 flex-1 min-w-0">
									<div class="size-7 rounded-md bg-primary/10 flex items-center justify-center text-primary shrink-0">
										@icon.Folder(icon.Props{Class: "size-3.5"})
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-xs font-medium text-foreground truncate" x-text="fs.name"></div>
										<div class="text-[10px] text-muted-foreground truncate" x-text="fs.description || fs.type"></div>
									</div>
								</div>
								<button
									@click="toggleAgentFilesystem(fs)"
									class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200"
									:class="fs.enabled ? 'bg-primary' : 'bg-input'"
									role="switch"
									:aria-checked="fs.enabled"
								>
									<span class="pointer-events-none inline-block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform duration-200" :class="fs.enabled ? 'translate-x-4' : 'translate-x-0'"></span>
								</button>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// deleteConfirmation renders a reusable delete confirmation view.
templ deleteConfirmation(cancelAction string, deleteAction string) {
	<div class="flex flex-col h-full">
		<div class="p-4 pb-3 border-b border-border">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "Delete Agent") }</h2>
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "This action cannot be undone.") }</p>
		</div>
		<div class="p-6 flex flex-col items-center gap-4">
			<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
				@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
			</div>
			<p class="text-sm text-center text-foreground">
				{ i18n.T(ctx, "Are you sure you want to delete") }
				<span class="font-semibold" x-text="deletingAgent?.name"></span>?
			</p>
		</div>
		<div class="px-4 py-3 border-t mt-auto flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": cancelAction,
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    deleteAction,
					":disabled": "saving || pipelineSaving",
				},
			}) {
				<span x-show="!saving && !pipelineSaving">{ i18n.T(ctx, "Delete") }</span>
				<span x-show="saving || pipelineSaving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Deleting...") }
				</span>
			}
		</div>
	</div>
}

// deleteAllConfirmation renders a delete-all-agents confirmation view.
templ deleteAllConfirmation() {
	<div class="flex flex-col h-full">
		<div class="p-4 pb-3 border-b border-border">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "Delete All Agents") }</h2>
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "This action cannot be undone.") }</p>
		</div>
		<div class="p-6 flex flex-col items-center gap-4">
			<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
				@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
			</div>
			<p class="text-sm text-center text-foreground">
				{ i18n.T(ctx, "Are you sure you want to delete all") }
				<span class="font-semibold" x-text="agents.length"></span>
				{ i18n.T(ctx, " agents?") }
			</p>
		</div>
		<div class="px-4 py-3 border-t mt-auto flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": "view = 'list'",
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    "deleteAllAgents()",
					":disabled": "saving",
				},
			}) {
				<span x-show="!saving">{ i18n.T(ctx, "Delete All") }</span>
				<span x-show="saving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Deleting...") }
				</span>
			}
		</div>
	</div>
}

// AgentDesignerNavButtonTrigger renders a workflow icon button for the navbar.
templ AgentDesignerNavButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agent-designer-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agent-designer')",
				"title":  i18n.T(ctx, "Agent Designer"),
			},
		}) {
			@icon.Workflow(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Agent Designer") }</span>
		}
	}
}

// AgentDesignerHeaderButton renders an icon button for the top header bar.
templ AgentDesignerHeaderButton() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "agent-designer-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9 text-muted-foreground hover:text-foreground hover:bg-accent/60 rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-agent-designer')",
				"title":  i18n.T(ctx, "Agent Designer"),
			},
		}) {
			@icon.Workflow(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Agent Designer") }</span>
		}
	}
}
