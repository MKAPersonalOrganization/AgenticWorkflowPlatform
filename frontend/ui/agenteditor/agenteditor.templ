package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/components/label"
	switchcomp "aicompass/frontend/components/switch"
	"aicompass/frontend/components/textarea"
	"aicompass/frontend/ui/i18n"
)

// agentDesignerBody renders the x-data-scoped inner body of the designer —
// the views, listeners, and toast stack. Shared between the full-page
// variant (AgentDesignerPage) and any embedded variant. No dialog wrapper;
// callers decide the surrounding chrome.
//
// `initExpr` is the Alpine expression to run on x-init — the page variant
// calls open() plus applies URL query params for direct-edit links; callers
// can customise. A minimum of `open()` should always be included so the
// agent/connector fetch fires.
templ agentDesignerBody(initExpr string) {
	<div
		class="flex flex-col h-full min-h-0 bg-background"
		x-data="agentDesigner"
		x-init={ initExpr }
		@open-agent-designer.window="open()"
		@open-agent-designer-node.window="open(); $nextTick(() => showEditNodeForm($event.detail))"
		@open-agent-designer-pipeline.window="open(); $nextTick(() => showEditPipelineForm($event.detail))"
		@open-agent-designer-with-id.window="open(); $nextTick(() => { fetchAgentById($event.detail.agentId).then(agent => { if (agent.isComposed) showEditPipelineForm(agent); else showEditNodeForm(agent); }) })"
		@open-agent-designer-templates.window="open(); $nextTick(() => openTemplatesView())"
		@agents-updated.window="fetchAgents()"
	>
		<!-- Each view supplies its own header (back button + title + view-specific
		     actions). No outer page chrome here — it only added vertical noise
		     on top of self-sufficient view headers. -->
		<!-- Views (switched via x-if on `view`) -->
		<template x-if="view === 'list'">
			@listView()
		</template>
		<template x-if="view === 'typeSelect'">
			@typeSelectView()
		</template>
		<template x-if="view === 'importYaml'">
			@importYamlView()
		</template>
		<template x-if="view === 'templates'">
			@templatesView()
		</template>
		<template x-if="showForkNameDialog">
			@forkNameDialog()
		</template>
		<template x-if="view === 'agentForm'">
			@agentFormView()
		</template>
		<template x-if="view === 'delete'">
			@deleteConfirmation("view = 'list'", "deletingAgent?.isComposed ? deletePipeline() : deleteNode()")
		</template>
		<template x-if="view === 'deleteAll'">
			@deleteAllConfirmation()
		</template>
		<template x-if="view === 'flow'">
			@flowView()
		</template>
		@toastStack()
	</div>
}

// agentNodeForm renders the form fields for creating/editing a single agent.
templ agentNodeForm() {
	<!-- Identity Section -->
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<div class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-primary/5 to-transparent border-b border-border/50">
			<div class="size-6 rounded-md bg-primary/10 flex items-center justify-center">
				@icon.Bot(icon.Props{Class: "size-3.5 text-primary"})
			</div>
			<span class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "Identity") }</span>
			<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Basic information about this agent") }</span>
		</div>
		<div class="p-4 space-y-4">
			<div class="space-y-1.5">
				@label.Label(label.Props{Class: "text-xs"}) {
					{ i18n.T(ctx, "Name") }
					<span class="text-destructive">*</span>
				}
				@input.Input(input.Props{
					Placeholder: i18n.T(ctx, "e.g., Writing Coach, Code Reviewer..."),
					Class:       "h-9 text-sm",
					Attributes: templ.Attributes{
						"x-model":   "form.name",
						"maxlength": "100",
					},
				})
			</div>
			<div class="space-y-1.5">
				@label.Label(label.Props{Class: "text-xs"}) {
					{ i18n.T(ctx, "Description") }
				}
				@input.Input(input.Props{
					Placeholder: i18n.T(ctx, "Brief description of what this agent does..."),
					Class:       "h-9 text-sm",
					Attributes: templ.Attributes{
						"x-model":   "form.description",
						"maxlength": "500",
					},
				})
			</div>
		</div>
	</div>
	@formInstructionsSection()
	@formGlobalInstructionSection()
	@formMemorySection()
	@formArtifactsSection()
	@formCodeExecutionSection()
	@formStreamingSection()
	@formSubAgentsSection()
	@formAgentsAsToolsSection()
	<template x-if="agentToolsDialogOpen">
		@agentToolsSelectionDialog()
	</template>
	<template x-if="subAgentDialogOpen">
		@subAgentSelectionDialog()
	</template>
	@formStateContextSection()
	@formInputSchemaSection()
	@formOutputSchemaSection()
	<!-- Model Configuration -->
	@modelConfigurationSection()
	<!-- Tools, KBs, Filesystems (edit mode only) -->
	<template x-if="editingAgent">
		<div class="space-y-4">
			@toolsSection()
			@knowledgeBasesSection()
			@filesystemsSection()
		</div>
	</template>
	<!-- Info notice (create mode) -->
	<template x-if="!editingAgent">
		<div class="border border-border rounded-lg p-3 flex items-start gap-2">
			@icon.Info(icon.Props{Class: "size-4 text-muted-foreground shrink-0 mt-0.5"})
			<p class="text-[11px] text-muted-foreground">
				{ i18n.T(ctx, "After creating the agent, you can add tools and knowledge bases by editing it.") }
			</p>
		</div>
	</template>
}

// toggleSwitch renders a labeled toggle switch for boolean form fields.
templ toggleSwitch(model string, labelText string, helpText string) {
	<div class="flex items-center justify-between gap-2 py-1.5">
		<div class="flex-1 min-w-0">
			<span class="text-xs font-medium text-foreground">{ labelText }</span>
			<p class="text-[10px] text-muted-foreground mt-0.5">{ helpText }</p>
		</div>
		@switchcomp.Switch(switchcomp.Props{
			Attributes: templ.Attributes{
				"x-model":      model,
				"aria-label":   labelText,
			},
		})
	</div>
}

// schemaBuilder renders the row-based JSON Schema editor used by both the
// Input Schema and Output Schema sections.
//
// fieldKey      — the form field this builder edits ("inputSchema" | "outputSchema").
//                 Drives the Alpine state names (<fieldKey>Mode, <fieldKey>Rows,
//                 <fieldKey>JSONError) and the form.<fieldKey> JSON fallback.
// emptyMessage  — the hint shown when there are zero rows in visual mode. Callers
//                 use different copy for inbound ("no arguments") vs outbound
//                 ("structured output off") semantics.
templ schemaBuilder(fieldKey, emptyMessage string) {
	<!-- Mode toggle (visual row builder ↔ raw JSON) -->
	<div class="flex items-center justify-between gap-2">
		<div class="inline-flex rounded-md border border-border overflow-hidden">
			<button
				type="button"
				@click={ "switchSchemaToVisual('" + fieldKey + "')" }
				class="px-3 py-1 text-[11px] font-medium transition-colors"
				:class={ fieldKey + "Mode === 'visual' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-accent'" }
			>{ i18n.T(ctx, "Fields") }</button>
			<button
				type="button"
				@click={ "switchSchemaToJSON('" + fieldKey + "')" }
				class="px-3 py-1 text-[11px] font-medium transition-colors border-s border-border"
				:class={ fieldKey + "Mode === 'json' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-accent'" }
			>{ i18n.T(ctx, "JSON") }</button>
		</div>
		<template x-if={ fieldKey + "Mode === 'visual'" }>
			<button
				type="button"
				@click={ "addSchemaRow('" + fieldKey + "')" }
				class="text-[11px] text-primary hover:text-primary/80 transition-colors"
			>
				+ { i18n.T(ctx, "Add field") }
			</button>
		</template>
	</div>
	<!-- Visual row builder -->
	<template x-if={ fieldKey + "Mode === 'visual'" }>
		<div class="space-y-2">
			<template x-for={ "(row, idx) in " + fieldKey + "Rows" } :key="idx">
				<div class="flex items-start gap-1.5 p-2 rounded-md border border-border">
					<div class="flex-1 min-w-0 grid grid-cols-[minmax(0,1fr)_auto] gap-1.5">
						<input
							type="text"
							x-model="row.name"
							placeholder="field_name"
							class="h-7 rounded-md border border-border bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						/>
						<select
							x-model="row.type"
							class="h-7 rounded-md border border-border bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						>
							<template x-for="t in schemaTypeOptions" :key="t">
								<option :value="t" x-text="t"></option>
							</template>
						</select>
						<input
							type="text"
							x-model="row.description"
							placeholder="Short description (optional)"
							class="col-span-2 h-7 rounded-md border border-border bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						/>
					</div>
					<label class="inline-flex items-center gap-1.5 text-[10px] text-muted-foreground cursor-pointer select-none mt-1">
						<input type="checkbox" x-model="row.required" class="size-3 accent-slate-500"/>
						{ i18n.T(ctx, "required") }
					</label>
					<button
						type="button"
						@click={ "removeSchemaRow('" + fieldKey + "', idx)" }
						class="text-muted-foreground hover:text-destructive transition-colors shrink-0 mt-1"
					>
						@icon.X(icon.Props{Class: "size-3"})
					</button>
				</div>
			</template>
			<template x-if={ fieldKey + "Rows.length === 0" }>
				<div class="text-center text-xs text-muted-foreground py-2">{ emptyMessage }</div>
			</template>
		</div>
	</template>
	<!-- JSON fallback view — used for schemas too complex for the row builder. -->
	<template x-if={ fieldKey + "Mode === 'json'" }>
		<div class="space-y-1.5">
			@textarea.Textarea(textarea.Props{
				Placeholder: i18n.T(ctx, `{"type": "object", "properties": {"topic": {"type": "string"}}, "required": ["topic"]}`),
				Class:       "min-h-[80px] resize-y font-mono text-[11px]",
				Rows:        3,
				Attributes: templ.Attributes{
					"x-model": "form." + fieldKey,
				},
			})
			<p class="text-[10px] text-muted-foreground">
				{ i18n.T(ctx, "Raw JSON Schema. Use this for nested or array fields the row builder can't express.") }
			</p>
			<template x-if={ fieldKey + "JSONError" }>
				<p class="text-[10px] text-destructive" x-text={ fieldKey + "JSONError" }></p>
			</template>
		</div>
	</template>
}

// shortcutRow renders a single keyboard shortcut row for the help overlay.
templ shortcutRow(label string, keys string) {
	<div class="flex items-center justify-between py-1.5 px-2.5 rounded-md hover:transition-colors">
		<span class="text-xs text-foreground">{ label }</span>
		<div class="flex items-center gap-1">
			<kbd class="kbd">{ keys }</kbd>
		</div>
	</div>
}
// deleteConfirmation renders a reusable delete confirmation view.
templ deleteConfirmation(cancelAction string, deleteAction string) {
	<div class="flex flex-col h-full">
		<div class="p-4 pb-3 border-b border-border">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "Delete Agent") }</h2>
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "This action cannot be undone.") }</p>
		</div>
		<div class="p-6 flex flex-col items-center gap-4">
			<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
				@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
			</div>
			<p class="text-sm text-center text-foreground">
				{ i18n.T(ctx, "Are you sure you want to delete") }
				<span class="font-semibold" x-text="deletingAgent?.name"></span>?
			</p>
		</div>
		<div class="px-4 py-3 border-t mt-auto flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": cancelAction,
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    deleteAction,
					":disabled": "saving || pipelineSaving",
				},
			}) {
				<span x-show="!saving && !pipelineSaving">{ i18n.T(ctx, "Delete") }</span>
				<span x-show="saving || pipelineSaving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Deleting...") }
				</span>
			}
		</div>
	</div>
}

// deleteAllConfirmation renders a delete-all-agents confirmation view.
templ deleteAllConfirmation() {
	<div class="flex flex-col h-full">
		<div class="p-4 pb-3 border-b border-border">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "Delete All Agents") }</h2>
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "This action cannot be undone.") }</p>
		</div>
		<div class="p-6 flex flex-col items-center gap-4">
			<div class="size-12 rounded-full bg-destructive/10 flex items-center justify-center">
				@icon.Trash2(icon.Props{Class: "size-6 text-destructive"})
			</div>
			<p class="text-sm text-center text-foreground">
				{ i18n.T(ctx, "Are you sure you want to delete all") }
				<span class="font-semibold" x-text="agents.length"></span>
				{ i18n.T(ctx, " agents?") }
			</p>
		</div>
		<div class="px-4 py-3 border-t mt-auto flex items-center justify-end gap-2">
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Class:   "h-8 px-3 text-xs",
				Attributes: templ.Attributes{
					"@click": "view = 'list'",
				},
			}) {
				{ i18n.T(ctx, "Cancel") }
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Class:   "h-8 px-4 text-xs gap-1.5",
				Attributes: templ.Attributes{
					"@click":    "deleteAllAgents()",
					":disabled": "saving",
				},
			}) {
				<span x-show="!saving">{ i18n.T(ctx, "Delete All") }</span>
				<span x-show="saving" class="flex items-center gap-1.5">
					<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
					{ i18n.T(ctx, "Deleting...") }
				</span>
			}
		</div>
	</div>
}

// Note: the two navigation-chrome templs (AgentDesignerHeaderButton,
// AgentDesignerNavButtonTrigger) that used to live here moved to
// frontend/ui/nav/navbar.templ. Keeping them here would create a cycle:
// the Agent Designer page (in this package) imports frontend/ui for
// BaseLayout, and frontend/ui/nav imports this package for the button.
// Chrome belongs with chrome.
