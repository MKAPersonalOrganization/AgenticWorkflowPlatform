package agenteditor

import (
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// Four collapsible policy-toggle cards that share the same "chevron
// button + x-collapse body + toggleSwitch" shape. Split per-section so
// each card's adapter contract (MemoryPolicy, ArtifactPolicy,
// CodeExecutionPolicy, StreamingPolicy) documents itself next to the
// control that flips it.

// formMemorySection is the memory-policy card. The orchestration engine
// exposes memory as a runner-level service plus two in-tree tools
// (load_memory + preload_memory). This card is the user-facing toggle
// for those tools — replaces the old "Agent Memory" plugin entry that
// used to live in the Tools picker. The adapter reads Config.MemoryPolicy
// when non-null; pre-M8 agents that still have the legacy memory-set
// toolset permission keep working.
templ formMemorySection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showMemory = !showMemory"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showMemory ? 'bg-linear-to-r from-cyan-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-cyan-500/10 flex items-center justify-center">
					@icon.Brain(icon.Props{Class: "size-3.5 text-cyan-600 dark:text-cyan-400"})
				</div>
				{ i18n.T(ctx, "Memory") }
				<span x-show="memoryEnabled" class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-700 dark:text-cyan-400">
					{ i18n.T(ctx, "on") }
				</span>
				<span x-show="memoryEnabled && memoryPreload" class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-700 dark:text-cyan-400">
					{ i18n.T(ctx, "auto-preload") }
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showMemory ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showMemory" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-cyan-500"})
					{ i18n.T(ctx, "When on, past conversations with this user are indexed and the agent can search them. Leave off for one-shot agents that don't need to remember anything between runs.") }
				</p>
				<div class="space-y-1.5">
					@toggleSwitch("memoryEnabled", i18n.T(ctx, "Remember past conversations"), i18n.T(ctx, "Gives the agent a tool to search earlier sessions on demand."))
					<div x-show="memoryEnabled" x-collapse>
						@toggleSwitch("memoryPreload", i18n.T(ctx, "Auto-recall every turn"), i18n.T(ctx, "Searches memory before each reply and injects relevant context automatically. Costs an extra search per turn."))
					</div>
				</div>
			</div>
		</div>
	</div>
}

// formArtifactsSection is the artifact-policy card. When enabled,
// load_artifacts is injected so the agent can list, read, and create
// files that persist across sessions. AutoSaveUserBlobs additionally
// tells the runner to move inline attachments from user messages into
// the artifact store and replace them with text placeholders the model
// reads instead of raw bytes (see
// .READ/adk-go/runner/runner.go:270-309).
templ formArtifactsSection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showArtifacts = !showArtifacts"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showArtifacts ? 'bg-linear-to-r from-amber-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-amber-500/10 flex items-center justify-center">
					@icon.FileStack(icon.Props{Class: "size-3.5 text-amber-600 dark:text-amber-400"})
				</div>
				{ i18n.T(ctx, "Artifacts") }
				<span x-show="artifactsEnabled" class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 dark:text-amber-400">
					{ i18n.T(ctx, "on") }
				</span>
				<span x-show="artifactsEnabled && artifactsAutoSaveBlobs" class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 dark:text-amber-400">
					{ i18n.T(ctx, "auto-save uploads") }
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showArtifacts ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showArtifacts" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-amber-500"})
					{ i18n.T(ctx, "Lets this agent create, list, and load versioned files that persist across conversations — reports, CSVs, generated images, refined code. Leave off for agents that don't need durable outputs.") }
				</p>
				<div class="space-y-1.5">
					@toggleSwitch("artifactsEnabled", i18n.T(ctx, "Use artifacts"), i18n.T(ctx, "Adds a tool so the agent can list and load versioned files, and save new ones."))
					<div x-show="artifactsEnabled" x-collapse>
						@toggleSwitch("artifactsAutoSaveBlobs", i18n.T(ctx, "Auto-save uploaded files"), i18n.T(ctx, "When the user attaches a file, save it as an artifact automatically and hand the agent a text reference instead of raw bytes. Makes referring back to the file trivial."))
					</div>
				</div>
			</div>
		</div>
	</div>
}

// formCodeExecutionSection is the code-execution policy card.
// Provider-agnostic toggle at the UI layer: when on + the active model
// is Gemini, the adapter appends &genai.Tool{CodeExecution: ...} to the
// request so Google's sandbox runs the generated Python and returns
// ExecutableCode + CodeExecutionResult parts. OpenAI / Anthropic: the
// toggle saves but has no effect until their adapters wire their own
// native code-interpreter paths. Nothing runs on our infrastructure —
// the provider sandboxes the execution.
templ formCodeExecutionSection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showCodeExecution = !showCodeExecution"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showCodeExecution ? 'bg-linear-to-r from-teal-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-teal-500/10 flex items-center justify-center">
					@icon.Terminal(icon.Props{Class: "size-3.5 text-teal-600 dark:text-teal-400"})
				</div>
				{ i18n.T(ctx, "Code Execution") }
				<span x-show="codeExecutionEnabled" class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-teal-500/10 text-teal-700 dark:text-teal-400">
					{ i18n.T(ctx, "on") }
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showCodeExecution ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showCodeExecution" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-teal-500"})
					{ i18n.T(ctx, "Lets the agent run Python to do precise calculations and data work. The code runs in the AI provider's own sandbox — never on our servers. The output appears inline in the chat.") }
				</p>
				<div class="space-y-1.5">
					@toggleSwitch("codeExecutionEnabled", i18n.T(ctx, "Let the agent run code"), i18n.T(ctx, "Best for math, data crunching, format conversion, and anything where the model would otherwise guess."))
				</div>
				<!-- Friendly nudge when the current provider doesn't have it wired yet.
				     The toggle stays savable on every provider so the value sticks
				     across model changes; the adapter no-ops on non-Gemini
				     providers today. -->
				<div
					x-show="codeExecutionEnabled && !codeExecutionSupportedByProvider"
					x-cloak
					class="rounded-md border border-warning/30 bg-warning/5 px-3 py-2 text-[11px] text-warning leading-relaxed"
				>
					@icon.TriangleAlert(icon.Props{Class: "size-3.5 inline me-1"})
					{ i18n.T(ctx, "Code execution is wired on Gemini and OpenAI today. Your selected model provider doesn't run the code yet — the setting will kick in once we add it for this provider.") }
				</div>
			</div>
		</div>
	</div>
}

// formStreamingSection is the streaming-policy card. Maps to ADK-Go's
// RunConfig.StreamingMode (see .READ/adk-go/agent/run_config.go —
// StreamingModeSSE / StreamingModeNone). Default is SSE so users get
// the live typewriter effect; flipping this off delivers the full reply
// as one frame, which is usually what you want for eval runs and
// structured-output agents where partial deltas are noise.
templ formStreamingSection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showStreaming = !showStreaming"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showStreaming ? 'bg-linear-to-r from-sky-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-sky-500/10 flex items-center justify-center">
					@icon.Zap(icon.Props{Class: "size-3.5 text-sky-600 dark:text-sky-400"})
				</div>
				{ i18n.T(ctx, "Streaming") }
				<span x-show="!streamingEnabled" class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-muted text-muted-foreground">
					{ i18n.T(ctx, "off") }
				</span>
			</span>
			<span class="transition-transform duration-200" :class="showStreaming ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showStreaming" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-sky-500"})
					{ i18n.T(ctx, "On (default): the reply appears word-by-word as the model generates it. Off: the whole reply shows up at once — handy for evaluation runs or agents that must return strict structured output.") }
				</p>
				<div class="space-y-1.5">
					@toggleSwitch("streamingEnabled", i18n.T(ctx, "Stream responses (recommended)"), i18n.T(ctx, "Typewriter effect in chat. Turn this off if you prefer to wait and show the full reply in a single frame."))
				</div>
			</div>
		</div>
	</div>
}
