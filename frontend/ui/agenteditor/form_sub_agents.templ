package agenteditor

import (
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// Sub-agent composition: four pieces that work as a unit —
// SubAgents (coordinator pattern, control transfers) +
// AgentsAsTools (tool pattern, control stays) +
// two selection modal dialogs.
//
// Sub-Agents and Agents-as-Tools are orthogonal:
//   - SubAgents → ADK-Go llmagent with SubAgents populated; a transfer
//     call hands the user's thread over to the chosen sub-agent.
//   - AgentsAsTools → tool/agenttool wrapping; the parent calls them
//     like functions, gets a reply, and stays in charge.
//
// The two dialogs render as fixed-overlay modals because Alpine's
// x-if mounting lives alongside the expanded section, but the overlay
// must escape any parent stacking context.

// formSubAgentsSection — the coordinator-pattern section. Lists
// selected sub-agents, opens the selection dialog, and surfaces the
// two delegation-policy toggles that control transfer semantics.
templ formSubAgentsSection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showSubAgents = !showSubAgents"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showSubAgents ? 'bg-gradient-to-r from-violet-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-violet-500/10 flex items-center justify-center">
					@icon.Users(icon.Props{Class: "size-3.5 text-violet-600 dark:text-violet-400"})
				</div>
				{ i18n.T(ctx, "Sub-Agents") }
				<span class="text-[10px] text-muted-foreground" x-text="(form.subAgents || []).length > 0 ? '(' + (form.subAgents || []).length + ')' : ''"></span>
			</span>
			<span class="transition-transform duration-200" :class="showSubAgents ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showSubAgents" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-violet-500"})
					{ i18n.T(ctx, "This agent will act as a coordinator, delegating tasks to specialist sub-agents. The coordinator LLM decides which sub-agent to use based on conversation context.") }
				</p>
				<button type="button" @click="openSubAgentDialog()" class="w-full text-center text-xs text-primary hover:text-primary/80 py-1.5 border border-dashed border-border rounded-lg hover:border-primary/40 transition-colors">
					+ { i18n.T(ctx, "Select Sub-Agents") }
				</button>
				<!-- Selected Agents List -->
				<div class="space-y-1.5">
					<template x-for="(ref, idx) in (form.subAgents || [])" :key="ref.agent_id">
						<div class="flex items-center gap-2 p-2 rounded-md border border-border">
							<span class="size-5 rounded bg-primary/10 flex items-center justify-center text-primary shrink-0 text-[10px] font-bold" x-text="idx + 1"></span>
							<div class="flex-1 min-w-0">
								<div class="text-xs font-medium truncate" x-text="getAgentName(ref.agent_id)"></div>
							</div>
							<button type="button" @click="removeSubAgent(idx)" class="text-muted-foreground hover:text-destructive transition-colors shrink-0">
								@icon.X(icon.Props{Class: "size-3"})
							</button>
						</div>
					</template>
					<template x-if="(form.subAgents || []).length === 0">
						<div class="text-center text-xs text-muted-foreground py-2">{ i18n.T(ctx, "No sub-agents selected") }</div>
					</template>
				</div>
				<!-- Delegation Controls (part of coordinator config) -->
				<div class="pt-2 border-t border-border/50">
					<span class="text-[10px] font-semibold text-foreground uppercase tracking-wider flex items-center gap-1.5 mb-2">
						@icon.Shield(icon.Props{Class: "size-3 text-muted-foreground"})
						{ i18n.T(ctx, "Delegation Policy") }
					</span>
					<p class="text-[10px] text-muted-foreground mb-2">{ i18n.T(ctx, "Control how the coordinator delegates to sub-agents.") }</p>
					<div class="space-y-1.5">
						@toggleSwitch("form.disallowTransferToParent", i18n.T(ctx, "Prevent escalation to parent"), i18n.T(ctx, "Sub-agents cannot hand work back to the coordinator's parent."))
						@toggleSwitch("form.disallowTransferToPeers", i18n.T(ctx, "Prevent delegation to siblings"), i18n.T(ctx, "Sub-agents cannot pass work to other agents at the same level."))
					</div>
				</div>
			</div>
		</div>
	</div>
}

// formAgentsAsToolsSection — the tool-pattern section. Orthogonal to
// SubAgents: the parent calls these as tools and keeps control; sub-agents
// delegate control via transfer. Maps to ADK-Go's tool/agenttool package.
// Per-entry skip_summarization toggle returns the called agent's raw
// output instead of an LLM-summarised paraphrase.
templ formAgentsAsToolsSection() {
	<div class="rounded-xl border border-border bg-card overflow-hidden">
		<button
			type="button"
			@click="showAgentTools = !showAgentTools"
			class="flex items-center justify-between w-full px-4 py-2.5 text-sm font-medium text-foreground hover:bg-accent/30 transition-colors"
			:class="showAgentTools ? 'bg-gradient-to-r from-sky-500/5 to-transparent border-b border-border/50' : ''"
		>
			<span class="flex items-center gap-2">
				<div class="size-6 rounded-md bg-sky-500/10 flex items-center justify-center">
					@icon.Wrench(icon.Props{Class: "size-3.5 text-sky-600 dark:text-sky-400"})
				</div>
				{ i18n.T(ctx, "Agents as Tools") }
				<span class="text-[10px] text-muted-foreground" x-text="(form.agentTools || []).length > 0 ? '(' + (form.agentTools || []).length + ')' : ''"></span>
			</span>
			<span class="transition-transform duration-200" :class="showAgentTools ? 'rotate-180' : ''">
				@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
			</span>
		</button>
		<div x-show="showAgentTools" x-collapse>
			<div class="p-4 space-y-4 border-t border-border/50">
				<p class="text-xs text-muted-foreground leading-relaxed">
					@icon.Info(icon.Props{Class: "size-3.5 inline me-1 text-sky-500"})
					{ i18n.T(ctx, "Expose other agents as callable tools. The parent LLM calls them like any function, receives their output, and continues. Unlike Sub-Agents, control does not transfer — this agent stays in charge.") }
				</p>
				<button type="button" @click="openAgentToolsDialog()" class="w-full text-center text-xs text-primary hover:text-primary/80 py-1.5 border border-dashed border-border rounded-lg hover:border-primary/40 transition-colors">
					+ { i18n.T(ctx, "Add Agent Tool") }
				</button>
				<!-- Selected Agent-Tools List -->
				<div class="space-y-1.5">
					<template x-for="(ref, idx) in (form.agentTools || [])" :key="ref.agent_id">
						<div class="flex items-center gap-2 p-2 rounded-md border border-border">
							<div class="size-5 rounded bg-sky-500/10 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
								@icon.Wrench(icon.Props{Class: "size-3"})
							</div>
							<div class="flex-1 min-w-0">
								<div class="text-xs font-medium truncate" x-text="getAgentName(ref.agent_id)"></div>
								<label class="flex items-center gap-1.5 text-[10px] text-muted-foreground cursor-pointer mt-0.5 select-none">
									<input
										type="checkbox"
										class="size-3 accent-sky-500"
										:checked="ref.skip_summarization"
										@change="toggleAgentToolSkipSummarization(idx)"
									/>
									{ i18n.T(ctx, "Return raw output (skip summarization)") }
								</label>
							</div>
							<button type="button" @click="removeAgentTool(idx)" class="text-muted-foreground hover:text-destructive transition-colors shrink-0">
								@icon.X(icon.Props{Class: "size-3"})
							</button>
						</div>
					</template>
					<template x-if="(form.agentTools || []).length === 0">
						<div class="text-center text-xs text-muted-foreground py-2">{ i18n.T(ctx, "No agent tools selected") }</div>
					</template>
				</div>
			</div>
		</div>
	</div>
}

// agentToolsSelectionDialog — modal picker for Agents-as-Tools.
// Backdrop-click dismisses; Done button closes. Selection toggles are
// applied immediately (no local staging) so the underlying form.agentTools
// reflects the picker state live.
templ agentToolsSelectionDialog() {
	<div class="fixed inset-0 z-[60] flex items-center justify-center p-4">
		<div class="fixed inset-0 bg-black/60 backdrop-blur-sm" @click="agentToolsDialogOpen = false"></div>
		<div class="relative w-full max-w-2xl bg-card border border-border rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
			<div class="flex items-center justify-between px-4 py-3 border-b border-border/50 shrink-0">
				<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Add Agent Tools") }</h3>
				<button type="button" @click="agentToolsDialogOpen = false" class="text-muted-foreground hover:text-foreground transition-colors">
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</div>
			<div class="flex-1 overflow-y-auto p-4 space-y-1.5">
				<template x-for="agent in allAgents.filter(a => a.id !== editingAgent?.id)" :key="agent.id">
					<button type="button" @click="toggleAgentToolFromDialog(agent.id)" class="w-full flex items-center gap-3 p-2.5 rounded-lg border transition-colors text-left"
						:class="isAgentToolSelected(agent.id) ? 'border-sky-400/50 bg-sky-500/5' : 'border-border hover:bg-accent/30'"
					>
						<div class="size-8 rounded-lg bg-sky-500/10 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
							<template x-if="isAgentToolSelected(agent.id)">
								@icon.Check(icon.Props{Class: "size-4"})
							</template>
							<template x-if="!isAgentToolSelected(agent.id)">
								@icon.Wrench(icon.Props{Class: "size-4"})
							</template>
						</div>
						<div class="flex-1 min-w-0">
							<div class="text-xs font-medium text-foreground truncate" x-text="agent.name"></div>
							<div class="text-[10px] text-muted-foreground truncate" x-text="agent.description"></div>
						</div>
					</button>
				</template>
				<template x-if="allAgents.filter(a => a.id !== editingAgent?.id).length === 0">
					<div class="text-center text-xs text-muted-foreground py-8">{ i18n.T(ctx, "No other agents available") }</div>
				</template>
			</div>
			<div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-border/50 shrink-0">
				<button type="button" @click="agentToolsDialogOpen = false" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-medium transition-colors focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3">
					{ i18n.T(ctx, "Done") }
				</button>
			</div>
		</div>
	</div>
}

// subAgentSelectionDialog — modal picker for the coordinator-style
// Sub-Agents. Available list is filtered to avoid cycles
// (availableAgentsForSubAgent handles that in Alpine).
templ subAgentSelectionDialog() {
	<div class="fixed inset-0 z-[60] flex items-center justify-center p-4">
		<div class="fixed inset-0 bg-black/60 backdrop-blur-sm" @click="subAgentDialogOpen = false"></div>
		<div class="relative w-full max-w-2xl bg-card border border-border rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
			<div class="flex items-center justify-between px-4 py-3 border-b border-border/50 shrink-0">
				<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Select Sub-Agents") }</h3>
				<button type="button" @click="subAgentDialogOpen = false" class="text-muted-foreground hover:text-foreground transition-colors">
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</div>
			<div class="flex-1 overflow-y-auto p-4 space-y-1.5">
				<template x-for="agent in availableAgentsForSubAgent" :key="agent.id">
					<button type="button" @click="toggleSubAgentFromDialog(agent.id)" class="w-full flex items-center gap-3 p-2.5 rounded-lg border transition-colors text-left"
						:class="isAgentSelected(agent.id) ? 'border-primary/40 bg-primary/5' : 'border-border hover:bg-accent/30'"
					>
						<div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
							<template x-if="isAgentSelected(agent.id)">
								@icon.Check(icon.Props{Class: "size-4"})
							</template>
							<template x-if="!isAgentSelected(agent.id)">
								@icon.Circle(icon.Props{Class: "size-4"})
							</template>
						</div>
						<div class="flex-1 min-w-0">
							<div class="text-xs font-medium text-foreground truncate" x-text="agent.name"></div>
							<div class="text-[10px] text-muted-foreground truncate" x-text="agent.description"></div>
						</div>
					</button>
				</template>
				<template x-if="availableAgentsForSubAgent.length === 0">
					<div class="text-center text-xs text-muted-foreground py-8">{ i18n.T(ctx, "No other agents available") }</div>
				</template>
			</div>
			<div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-border/50 shrink-0">
				<button type="button" @click="subAgentDialogOpen = false" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-medium transition-colors focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3">
					{ i18n.T(ctx, "Done") }
				</button>
			</div>
		</div>
	</div>
}
