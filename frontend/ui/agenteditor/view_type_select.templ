package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

// typeSelectView renders the "what would you like to create?" picker shown
// from the agent-list's "New Agent" button. Three cards (LLM agent,
// workflow orchestrator, template fork) plus an Import-YAML affordance.
templ typeSelectView() {
	<div class="flex flex-col flex-1 overflow-hidden">
		<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50">
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "size-8",
				Attributes: templ.Attributes{
					"@click": "view = 'list'",
				},
			}) {
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
			}
			<h3 class="text-sm font-semibold">{ i18n.T(ctx, "What would you like to create?") }</h3>
		</div>
		<div class="flex-1 flex flex-col items-center justify-center p-8 gap-6 overflow-y-auto">
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-lg">
				<!-- LLM Agent Card -->
				<button
					type="button"
					@click="showCreateNodeForm()"
					class="group relative flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-border hover:border-emerald-400/50 hover:shadow-lg hover:shadow-emerald-500/5 hover:-translate-y-0.5 bg-card transition-all duration-200 text-center cursor-pointer overflow-hidden"
				>
					<!-- Gradient overlay -->
					<div class="absolute inset-0 bg-linear-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
					<div class="relative size-14 rounded-2xl bg-linear-to-br from-emerald-500/15 to-emerald-500/5 flex items-center justify-center text-emerald-600 dark:text-emerald-400 group-hover:scale-110 group-hover:shadow-md transition-all duration-200 ring-1 ring-emerald-500/20 group-hover:ring-emerald-400/40">
						@icon.Bot(icon.Props{Class: "size-7"})
					</div>
					<div class="relative">
						<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "LLM Agent") }</h4>
						<p class="text-xs text-muted-foreground mt-1.5 leading-relaxed max-w-[220px]">{ i18n.T(ctx, "An AI agent with custom instructions, tools, and the ability to delegate to sub-agents.") }</p>
					</div>
					<!-- Feature pills -->
					<div class="relative flex flex-wrap gap-1 mt-1 justify-center">
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">System Prompt</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50">Tools</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50">Sub-agents</span>
					</div>
				</button>
				<!-- Workflow Orchestrator Card -->
				<button
					type="button"
					@click="showCreatePipelineForm()"
					class="group relative flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-border hover:border-indigo-400/50 hover:shadow-lg hover:shadow-indigo-500/5 hover:-translate-y-0.5 bg-card transition-all duration-200 text-center cursor-pointer overflow-hidden"
				>
					<!-- Gradient overlay -->
					<div class="absolute inset-0 bg-linear-to-br from-indigo-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
					<div class="relative size-14 rounded-2xl bg-linear-to-br from-indigo-500/15 to-indigo-500/5 flex items-center justify-center text-indigo-600 dark:text-indigo-400 group-hover:scale-110 group-hover:shadow-md transition-all duration-200 ring-1 ring-indigo-500/20 group-hover:ring-indigo-400/40">
						@icon.GitBranch(icon.Props{Class: "size-7"})
					</div>
					<div class="relative">
						<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Workflow Orchestrator") }</h4>
						<p class="text-xs text-muted-foreground mt-1.5 leading-relaxed max-w-[220px]">{ i18n.T(ctx, "Orchestrate multiple agents with sequential, parallel, loop, or conditional execution.") }</p>
					</div>
					<!-- Feature pills -->
					<div class="relative flex flex-wrap gap-1 mt-1 justify-center">
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">Sequential</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50">Parallel</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50">Conditional</span>
					</div>
				</button>
				<!-- From Template Card -->
				<button
					type="button"
					@click="openTemplatesView()"
					class="group relative flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-border hover:border-amber-400/50 hover:shadow-lg hover:shadow-amber-500/5 hover:-translate-y-0.5 bg-card transition-all duration-200 text-center cursor-pointer overflow-hidden"
				>
					<!-- Gradient overlay -->
					<div class="absolute inset-0 bg-linear-to-br from-amber-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
					<div class="relative size-14 rounded-2xl bg-linear-to-br from-amber-500/15 to-amber-500/5 flex items-center justify-center text-amber-600 dark:text-amber-400 group-hover:scale-110 group-hover:shadow-md transition-all duration-200 ring-1 ring-amber-500/20 group-hover:ring-amber-400/40">
					@icon.LayoutGrid(icon.Props{Class: "size-7"})
					</div>
					<div class="relative">
						<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "From Template") }</h4>
						<p class="text-xs text-muted-foreground mt-1.5 leading-relaxed max-w-[220px]">{ i18n.T(ctx, "Start from a pre-built agent template and customize it.") }</p>
					</div>
					<!-- Feature pills -->
					<div class="relative flex flex-wrap gap-1 mt-1 justify-center">
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">Pre-built</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50">One-click</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50">Customizable</span>
					</div>
				</button>
			</div>
			<div class="flex items-center gap-4">
				<button
					type="button"
					@click="showImportYamlView()"
					class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors group"
				>
					@icon.Upload(icon.Props{Class: "size-3.5 group-hover:-translate-y-0.5 transition-transform"})
					{ i18n.T(ctx, "Import from YAML") }
				</button>
			</div>
		</div>
	</div>
}
