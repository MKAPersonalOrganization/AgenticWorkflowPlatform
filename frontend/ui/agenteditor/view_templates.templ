package agenteditor

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/ui/i18n"
)

// templatesView renders the catalog browser: search + category pills +
// a grid of template cards. "Fork & Edit" prompts for a user-supplied
// name before creating a copy of the template as a user-owned agent.
templ templatesView() {
	<div class="flex flex-col flex-1 overflow-hidden" :class="expanded ? 'max-h-[calc(100vh-8rem)]' : 'max-h-[calc(90vh-8rem)]'">
		<!-- Header -->
		<div class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-border/50 shrink-0">
			@button.Button(button.Props{
				Size:    button.SizeIcon,
				Variant: button.VariantGhost,
				Class:   "size-8",
				Attributes: templ.Attributes{
					"@click": "view = 'typeSelect'",
				},
			}) {
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
			}
			<h3 class="text-sm font-semibold">{ i18n.T(ctx, "Browse Templates") }</h3>
			<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Pick a template to customize and edit") }</span>
		</div>
		<!-- Search + Category Filter -->
		<div class="px-4 pt-3 pb-2 flex items-center gap-2 shrink-0">
			<div class="flex-1">
				@input.Input(input.Props{
					Type:        input.TypeSearch,
					Placeholder: i18n.T(ctx, "Search templates..."),
					Class:       "h-9 border-transparent focus-within:bg-background",
					Attributes: templ.Attributes{
						"x-model.debounce.300ms": "catalogSearchQuery",
						"@input":                 "searchCatalog()",
					},
				})
			</div>
		</div>
		<!-- Category Pills -->
		<div class="px-4 pb-2 flex gap-1.5 overflow-x-auto shrink-0 scrollbar-thin">
			<button
				type="button"
				@click="catalogSelectedCategory = ''"
				class="shrink-0 px-3 py-1 rounded-full text-[11px] font-medium transition-colors border"
				:class="!catalogSelectedCategory ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30' : 'bg-muted text-muted-foreground border-border hover:bg-accent'"
			>
				{ i18n.T(ctx, "All") }
			</button>
			<template x-for="cat in catalogCategories" :key="cat">
				<button
					type="button"
					@click="catalogSelectedCategory = cat"
					class="shrink-0 px-3 py-1 rounded-full text-[11px] font-medium transition-colors border capitalize"
					:class="catalogSelectedCategory === cat ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30' : 'bg-muted text-muted-foreground border-border hover:bg-accent'"
					x-text="cat"
				></button>
			</template>
		</div>
		<!-- Template Cards Grid -->
		<div class="flex-1 overflow-y-auto px-4 pb-4 scrollbar-thin min-h-[300px]">
			<template x-if="catalogLoading">
				<div class="space-y-3">
					<template x-for="i in 3" :key="i">
						<div class="flex items-center gap-3 p-3 animate-pulse rounded-lg border border-border">
							<div class="size-10 rounded-lg bg-muted"></div>
							<div class="flex-1 space-y-2">
								<div class="h-4 bg-muted rounded w-1/3"></div>
								<div class="h-3 bg-muted rounded w-2/3"></div>
							</div>
						</div>
					</template>
				</div>
			</template>
			<template x-if="!catalogLoading">
				<div>
					<template x-if="filteredCatalogEntries.length === 0">
						<div class="flex flex-col items-center justify-center py-12 gap-3 text-muted-foreground">
							@icon.LayoutGrid(icon.Props{Class: "size-12 opacity-20"})
							<div class="text-center">
								<p class="text-sm font-medium">{ i18n.T(ctx, "No templates found") }</p>
								<p class="text-xs mt-1">{ i18n.T(ctx, "Try a different search or create from scratch.") }</p>
							</div>
						</div>
					</template>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<template x-for="entry in filteredCatalogEntries" :key="entry.id">
							@templatesCatalogCard()
						</template>
					</div>
				</div>
			</template>
		</div>
	</div>
}

// templatesCatalogCard is one template entry in the catalog grid.
// Rendered inside `x-for="entry in filteredCatalogEntries"` so the
// `entry` binding is in scope.
templ templatesCatalogCard() {
	<div
		class="group relative rounded-xl border border-border hover:border-amber-400/30 hover:shadow-sm transition-all duration-200 overflow-hidden bg-card"
	>
		<!-- Gradient overlay on hover -->
		<div class="absolute inset-0 bg-linear-to-br from-amber-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
		<div class="relative p-4">
			<div class="flex items-start gap-3">
				<!-- Template Icon -->
				<div
					class="size-10 rounded-lg flex items-center justify-center shrink-0 [&_svg]:size-5 bg-linear-to-br from-amber-500/15 to-amber-500/5 text-amber-600 dark:text-amber-400 ring-1 ring-amber-500/20"
				>
					<template x-if="entry.icon">
						<span x-html="entry.icon"></span>
					</template>
					<template x-if="!entry.icon">
						@icon.LayoutGrid(icon.Props{Class: "size-5"})
					</template>
				</div>
				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2">
						<h3 class="text-sm font-semibold text-foreground truncate" x-text="entry.name"></h3>
					</div>
					<p class="text-xs text-muted-foreground mt-0.5 line-clamp-2" x-text="entry.description || 'No description'"></p>
					<!-- Category + Tags -->
					<div class="flex items-center gap-1.5 mt-2 flex-wrap">
						<template x-if="entry.category">
							<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 capitalize" x-text="entry.category"></span>
						</template>
						<template x-for="tag in (entry.tags || []).slice(0, 3)" :key="tag">
							<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground border border-border/50" x-text="tag"></span>
						</template>
					</div>
				</div>
			</div>
			<!-- Action Button -->
			<div class="mt-3 pt-2 border-t border-border/50 flex items-center gap-2">
				<div class="flex-1"></div>
				<template x-if="catalogAddingIds.includes(entry.id)">
					<span class="inline-flex items-center gap-1.5 text-[10px] text-muted-foreground">
						<span class="animate-spin size-3 border-2 border-current border-t-transparent rounded-full"></span>
						{ i18n.T(ctx, "Forking...") }
					</span>
				</template>
				<template x-if="!catalogAddingIds.includes(entry.id)">
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Size:    button.SizeSm,
						Class:   "gap-1.5 text-xs",
						Attributes: templ.Attributes{
							"@click": "promptForForkName(entry)",
						},
					}) {
						@icon.GitBranch(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "Fork & Edit") }
					}
				</template>
			</div>
		</div>
	</div>
}
