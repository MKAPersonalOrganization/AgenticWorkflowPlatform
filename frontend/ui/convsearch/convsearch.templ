package convsearch

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

templ SearchDialog() {
	<div
		x-data="convSearchDialog"
		@open-conv-search-dialog.window="init(); $nextTick(() => $refs.convSearchInput?.focus())"
	>
		@dialog.Dialog(dialog.Props{
			ID: "conv-search-dialog",
		}) {
			@dialog.Content(dialog.ContentProps{
				Class:           "sm:max-w-xl max-h-[85vh]",
				HideCloseButton: true,
			}) {
				<!-- Edge-to-edge wrapper: cancels the panel's p-6 so the search bar spans full width -->
				<div class="-m-6 flex flex-col h-full min-h-0">
					<!-- Command-palette search bar -->
					<div class="flex items-center gap-3 px-4 h-14 border-b border-border/60 shrink-0">
						@icon.Search(icon.Props{Class: "size-4 text-muted-foreground shrink-0"})
						<input
							type="search"
							x-ref="convSearchInput"
							x-model="query"
							placeholder={ i18n.T(ctx, "Search your conversations...") }
							class="flex-1 bg-transparent border-0 outline-none text-sm text-foreground placeholder:text-muted-foreground focus:ring-0"
							aria-label={ i18n.T(ctx, "Search conversations") }
						/>
						<kbd class="kbd shrink-0">ESC</kbd>
					</div>
					<!-- Results list -->
					<div class="flex-1 min-h-[280px] overflow-y-auto scrollbar-thin p-2">
						<!-- Loading -->
						<template x-if="loading">
							<div class="flex items-center justify-center py-12">
								<span class="animate-spin size-5 border-2 border-muted-foreground/30 border-t-primary rounded-full"></span>
							</div>
						</template>
						<!-- Empty (pre-search) -->
						<template x-if="!loading && query.trim() === ''">
							<div class="flex flex-col items-center justify-center gap-3 py-12 text-sm text-muted-foreground">
								@icon.MessageCircle(icon.Props{Class: "size-8 opacity-40"})
								<span>{ i18n.T(ctx, "Start typing to search your conversations") }</span>
							</div>
						</template>
						<!-- No results -->
						<template x-if="!loading && query.trim() !== '' && results.length === 0">
							<div class="flex flex-col items-center justify-center gap-3 py-12 text-sm text-muted-foreground">
								@icon.Search(icon.Props{Class: "size-8 opacity-40"})
								<span>{ i18n.T(ctx, "No conversations found") }</span>
							</div>
						</template>
						<!-- Results -->
						<template x-if="!loading && results.length > 0">
							<div class="flex flex-col">
								<template x-for="thread in results" :key="thread.id">
									<button
										@click="selectThread(thread.id)"
										class="group flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground transition-colors focus-visible:ring-2 focus-visible:ring-ring text-start"
									>
										<div class="size-8 rounded-md bg-muted/60 flex items-center justify-center text-muted-foreground shrink-0 group-hover:bg-background group-hover:text-foreground transition-colors">
											@icon.MessageCircle(icon.Props{Class: "size-4"})
										</div>
										<div class="flex flex-col items-start gap-0.5 flex-1 min-w-0">
											<span x-text="thread.title || 'New Chat'" class="font-medium text-foreground truncate w-full"></span>
											<span x-text="formatDate(thread.updatedAt)" class="text-xs text-muted-foreground"></span>
										</div>
										@icon.ChevronRight(icon.Props{Class: "size-4 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity shrink-0"})
									</button>
								</template>
							</div>
						</template>
					</div>
				</div>
			}
		}
	</div>
}

templ SearchButtonTrigger() {
	@dialog.Trigger(dialog.TriggerProps{
		For: "conv-search-dialog",
	}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-9",
			Attributes: templ.Attributes{
				"@click": "$dispatch('open-conv-search-dialog')",
				"title":  i18n.T(ctx, "Search Conversations"),
			},
		}) {
			@icon.Search(icon.Props{Class: "size-5"})
			<span class="sr-only">{ i18n.T(ctx, "Search Conversations") }</span>
		}
	}
}
