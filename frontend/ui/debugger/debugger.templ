package debugger

templ DebuggerPanel() {
	<!-- Debugger Panel: bottom-docked panel with event log and workflow tree tabs -->
	<div
		x-show="showDebugPanel"
		x-cloak
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 translate-y-4"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-4"
		class="border-t border-border bg-card flex flex-col shrink-0 overflow-hidden"
		:style="`height: ${debugPanelHeight}px`"
	>
		<!-- Resize Handle -->
		<div
			@pointerdown="startDebugResize($event)"
			@pointermove="onDebugResize($event)"
			@pointerup="stopDebugResize()"
			class="h-1.5 w-full cursor-ns-resize bg-transparent hover:bg-primary/20 transition-colors flex items-center justify-center shrink-0 group touch-none"
		>
			<div class="w-8 h-0.5 rounded-full bg-border group-hover:bg-primary/40 transition-colors"></div>
		</div>
		<!-- Header with tabs and controls -->
		<div class="flex items-center justify-between px-3 py-1 bg-muted/30 border-b border-border/50 shrink-0">
			<!-- Tabs -->
			<div class="flex items-center gap-0.5">
				<button
					@click="setDebugTab('events')"
					class="px-3 py-1 text-xs font-medium rounded-md transition-colors"
					:class="debugActiveTab === 'events'
						? 'bg-primary text-primary-foreground'
						: 'text-muted-foreground hover:text-foreground hover:bg-muted'"
				>
					Event Log
					<span class="ml-1 text-[10px] opacity-70" x-text="`(${events.length})`"></span>
				</button>
				<button
					@click="setDebugTab('workflow')"
					class="px-3 py-1 text-xs font-medium rounded-md transition-colors"
					:class="debugActiveTab === 'workflow'
						? 'bg-primary text-primary-foreground'
						: 'text-muted-foreground hover:text-foreground hover:bg-muted'"
				>
					Workflow
				</button>
			</div>
			<!-- Controls -->
			<div class="flex items-center gap-1">
				<!-- Event Log controls (visible on events tab) -->
				<div x-show="debugActiveTab === 'events'" class="flex items-center gap-1" x-cloak>
					<!-- Toggle logging -->
					<button
						@click="toggleEventLogEnabled()"
						class="p-1.5 hover:bg-muted rounded text-xs transition-colors"
						:class="eventLogEnabled ? 'text-destructive' : 'text-muted-foreground hover:text-foreground'"
						:title="eventLogEnabled ? 'Pause logging' : 'Resume logging'"
					>
						<!-- Record dot when enabled -->
						<svg x-show="eventLogEnabled" x-cloak xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
							<circle cx="12" cy="12" r="6"></circle>
						</svg>
						<!-- Paused icon when disabled -->
						<svg x-show="!eventLogEnabled" x-cloak xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="10" y1="15" x2="10" y2="9"></line>
							<line x1="14" y1="15" x2="14" y2="9"></line>
						</svg>
					</button>
					<!-- Copy -->
					<button
						@click="copy()"
						class="p-1.5 hover:bg-muted rounded text-xs transition-all"
						:class="eventLogCopied ? 'text-primary' : 'text-muted-foreground hover:text-foreground'"
						title="Copy log"
					>
						<svg x-show="!eventLogCopied" x-cloak xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
							<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
						</svg>
						<svg x-show="eventLogCopied" x-cloak xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 6 9 17l-5-5"></path>
						</svg>
					</button>
					<!-- Clear -->
					<button
						@click="clear()"
						class="p-1.5 hover:bg-muted rounded text-xs text-muted-foreground hover:text-foreground transition-colors"
						title="Clear log"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 6h18"></path>
							<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
							<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
						</svg>
					</button>
					<!-- Separator -->
					<div class="w-px h-4 bg-border mx-0.5"></div>
				</div>
				<!-- Close -->
				<button
					@click="showDebugPanel = false"
					class="p-1.5 hover:bg-muted rounded text-muted-foreground hover:text-foreground transition-colors"
					title="Close debugger"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 6 6 18"></path>
						<path d="m6 6 12 12"></path>
					</svg>
				</button>
			</div>
		</div>
		<!-- Tab Content -->
		<div class="flex-1 overflow-hidden">
			<!-- Event Log Tab -->
			<div
				x-show="debugActiveTab === 'events'"
				class="h-full overflow-y-auto p-3 space-y-1.5 font-mono text-xs"
				x-ref="debugEventLogContainer"
			>
				<template x-for="event in events" :key="event.id">
					<div class="p-2.5 bg-muted/30 hover:bg-muted/50 rounded-lg border border-border/50 hover:border-border transition-all">
						<div class="flex items-start justify-between gap-2 mb-1.5">
							<div class="flex items-center gap-2">
								<span class="text-muted-foreground/80 whitespace-nowrap text-[10px]" x-text="event.time"></span>
								<span class="font-bold px-2 py-0.5 rounded text-[10px]" :class="getEventTypeColor(event.type)" x-text="event.type"></span>
							</div>
							<span class="text-[10px] text-muted-foreground/60" x-text="`#${event.id.slice(-6)}`"></span>
						</div>
						<div class="mt-1 text-[11px] text-muted-foreground break-all">
							<template x-if="event.type === 'CUSTOM'">
								<div class="space-y-1">
									<div class="font-semibold text-foreground/80" x-text="event.data.name"></div>
									<template x-if="event.data.value">
										<pre class="p-1.5 bg-background/50 rounded text-[10px] overflow-x-auto" x-text="JSON.stringify(event.data.value, null, 2)"></pre>
									</template>
								</div>
							</template>
							<template x-if="event.type !== 'CUSTOM'">
								<div>
									<template x-if="event.data && (event.data.value || event.data.message || event.data.content || event.data.delta)">
										<span x-text="typeof (event.data.value || event.data.message || event.data.content || event.data.delta) === 'object' ? JSON.stringify(event.data.value || event.data.message || event.data.content || event.data.delta, null, 2) : (event.data.value || event.data.message || event.data.content || event.data.delta)"></span>
									</template>
									<template x-if="!event.data || (!event.data.value && !event.data.message && !event.data.content && !event.data.delta)">
										<pre class="p-1.5 bg-background/50 rounded text-[10px] overflow-x-auto" x-text="JSON.stringify(event.data, null, 2)"></pre>
									</template>
								</div>
							</template>
						</div>
					</div>
				</template>
				<!-- Empty state -->
				<div x-show="!hasEvents" class="flex flex-col items-center justify-center text-muted-foreground py-12 gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-40">
						<path d="M3 3v18h18"></path>
						<path d="m19 9-5 5-4-4-3 3"></path>
					</svg>
					<span class="text-xs">No events recorded yet</span>
					<span x-show="!eventLogEnabled" x-cloak class="text-[10px] opacity-60">Logging is paused</span>
				</div>
			</div>
			<!-- Workflow Tab -->
			<div
				x-show="debugActiveTab === 'workflow'"
				x-cloak
				class="h-full overflow-hidden flex flex-col"
			>
				<!-- Status bar -->
				<div x-show="getDebugGraph()" class="flex items-center gap-2 px-3 py-1.5 border-b border-border/40 bg-muted/20 text-[11px] text-muted-foreground shrink-0">
					<span class="font-medium text-foreground truncate" x-text="currentAgentData?.name || 'Workflow'"></span>
					<template x-if="isStreaming && Object.keys(activeAgentNames).length > 0">
						<span class="flex items-center gap-1.5 flex-wrap">
							<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse shrink-0"></span>
							<span x-text="Object.keys(activeAgentNames).join(', ')"></span>
						</span>
					</template>
					<template x-if="!isStreaming && Object.keys(completedNodes).length > 0">
						<span class="flex items-center gap-1 text-success">
							<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
							Done
						</span>
					</template>
				</div>
				<!-- Tree (horizontal scroll) -->
				<div class="flex-1 overflow-auto p-3">
					<template x-if="getDebugGraph()">
						<div x-data="workflowTreeVisualizer">
							<div x-html="renderTree(getDebugGraph(), AVAILABLE_AGENTS, activeAgentNames, completedNodes, failedNodes)"></div>
						</div>
					</template>
					<!-- Empty state -->
					<div x-show="!getDebugGraph()" class="flex flex-col items-center justify-center text-muted-foreground py-12 gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-40">
							<rect x="16" y="16" width="6" height="6" rx="1"></rect>
							<rect x="2" y="16" width="6" height="6" rx="1"></rect>
							<rect x="9" y="2" width="6" height="6" rx="1"></rect>
							<path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path>
							<path d="M12 12V8"></path>
						</svg>
						<span class="text-xs">No workflow active</span>
						<span class="text-[10px] opacity-60">Select a workflow agent to see its pipeline</span>
					</div>
				</div>
			</div>
		</div>
	</div>
}
