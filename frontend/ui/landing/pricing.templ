package landing

import (
	"aicompass/frontend/components/button"
	"aicompass/shared"
)

// ─── Pricing Section ─────────────────────────────────────────────────────────
templ pricingSection(user *shared.User) {
	<section id="pricing" class="border-t border-border bg-muted/20 py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl">
					Simple, transparent pricing
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					One plan. Full access. No hidden fees.
				</p>
			</div>
			<div class="mx-auto mt-16 max-w-md">
				<!-- Ultra-clean pricing card -->
				<div class="rounded-3xl border border-border/40 bg-background p-10 shadow-modern-lg ring-1 ring-border/20 transition-shadow duration-300 hover:shadow-modern-xl">
					<div class="text-center">
						<h3 class="text-xl font-semibold tracking-tight text-foreground">Compass.AI Pro</h3>
						<div class="mt-6 flex items-baseline justify-center gap-1">
							<span class="text-6xl font-semibold tracking-tight text-foreground">$5</span>
							<span class="text-sm font-medium text-muted-foreground">/mo</span>
						</div>
						<p class="mt-4 text-sm text-muted-foreground">A complete platform, nothing held back.</p>
					</div>
					<ul class="mt-10 space-y-4">
						@checkListItem("Access to all leading AI models")
						@checkListItem("Unlimited agent creation and community access")
						@checkListItem("Full suite of built-in tooling and plugins")
						@checkListItem("Native MCP connector support")
						@checkListItem("Multi-workspace RAG knowledge bases")
						@checkListItem("Synchronized lifelike AI voice generation")
						@checkListItem("Personalized, adaptive memory")
					</ul>
					<div class="mt-10">
						if user != nil {
							@button.Button(button.Props{
								Href:      "/pricing",
								FullWidth: true,
								Size:      button.SizeLg,
							}) {
								<span>Upgrade Now</span>
							}
						} else {
							@button.Button(button.Props{
								Href:      "/auth/login",
								FullWidth: true,
								Size:      button.SizeLg,
							}) {
								<span>Get Started</span>
							}
						}
					</div>
					<p class="mt-6 text-center text-xs text-muted-foreground">
						Secure payment powered by Stripe.
					</p>
				</div>
			</div>
		</div>
	</section>
}
