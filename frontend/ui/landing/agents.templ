package landing

import "aicompass/frontend/components/icon"

// ─── Agent Templates ─────────────────────────────────────────────────────────
templ agentStoreSection() {
	<section id="agents" class="border-t border-border bg-muted/20 py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<!-- Text content -->
				<div>
					<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-1.5 text-sm text-muted-foreground">
						@icon.Bot(icon.Props{Class: "size-4 text-purple-500"})
						<span>Agent Templates</span>
					</div>
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
						Discover and create
						<span class="text-primary">AI agents</span>
					</h2>
					<p class="mt-4 text-lg text-muted-foreground">
						Start from pre-built templates designed around proven agentic patterns — or build your own from scratch. Each agent can have its own tools, knowledge base access, personality, and the ability to delegate to sub-agents — then orchestrate them into workflow pipelines.
					</p>
					<ul class="mt-8 space-y-4">
						@checkListItem("Start from templates: sequential, parallel, loop, conditional, and coordinator patterns")
						@checkListItem("Fork and customize any template to make it yours")
						@checkListItem("Configure system prompts, transfer policies, and output schemas per agent")
						@checkListItem("Assign specific tool sets and knowledge workspaces per agent")
						@checkListItem("Orchestrate agents into sequential, parallel, loop, or conditional workflows with a visual builder")
						@checkListItem("Create coordinator agents that delegate tasks to specialist sub-agents dynamically")
						@checkListItem("Global AI settings — model, temperature, max tokens, and iteration limits shared across all agents")
					</ul>
				</div>
				<!-- Visual card grid — agentic patterns -->
				<div class="grid grid-cols-2 gap-4">
					@agentPreviewCard("⛓️", "Sequential", "Chain agents in a step-by-step pipeline where each reads the prior output", "text-blue-500")
					@agentPreviewCard("⚡", "Parallel", "Fan-out to multiple agents running concurrently, then merge results", "text-emerald-500")
					@agentPreviewCard("🔄", "Loop", "Iterative generate → evaluate → refine cycles with early exit", "text-rose-500")
					@agentPreviewCard("🔀", "Conditional", "Classify input then route to the right specialist branch", "text-red-500")
					@agentPreviewCard("🎯", "Coordinator", "LLM-driven dynamic delegation to specialist sub-agents", "text-indigo-500")
					@agentPreviewCard("🧩", "Nested", "Compose patterns inside patterns — sequential within parallel within loop", "text-amber-500")
				</div>
			</div>
		</div>
	</section>
}

templ agentPreviewCard(emoji, name, desc, borderColor string) {
	<div class={ "rounded-xl border border-border bg-card p-4 transition-all hover:border-primary/30 hover:shadow-md" }>
		<div class="text-2xl mb-2">{ emoji }</div>
		<h4 class="font-semibold text-sm">{ name }</h4>
		<p class="mt-1 text-xs text-muted-foreground line-clamp-2">{ desc }</p>
	</div>
}
