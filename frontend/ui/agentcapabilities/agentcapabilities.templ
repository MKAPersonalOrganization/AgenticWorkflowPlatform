package agentcapabilities

import (
	"aicompass/frontend/components/badge"
	"aicompass/frontend/components/button"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/tooltip"
)

// AgentCapabilities renders a button that opens an Alpine-driven panel
// showing the current agent's enabled tools, knowledge bases, and
// filesystems.  The panel stays inside the x-data scope so that all
// reactive expressions resolve correctly (the TUI popover component
// portals content to <body>, which breaks nested Alpine scopes).
templ AgentCapabilities() {
	<div x-data="agentCapabilities" class="relative">
		<!-- Trigger button -->
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{}) {
				@button.Button(button.Props{
					Type:    button.TypeButton,
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Class:   "text-muted-foreground hover:text-foreground transition-colors p-2 rounded-xl hover:bg-muted/50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none relative",
					Attributes: templ.Attributes{
						"@click.stop":    "toggle()",
						"x-ref":          "capTrigger",
						"aria-label":     i18n.T(ctx, "Agent capabilities"),
						":aria-expanded": "open",
					},
				}) {
					@icon.ShieldCheck(icon.Props{Class: "size-5"})
					<!-- Badge showing total enabled count -->
					<span
						x-show="totalEnabled > 0"
						x-cloak
						class="absolute -top-0.5 -end-0.5 flex size-4 items-center justify-center rounded-full bg-primary text-[9px] font-bold text-primary-foreground"
						x-text="totalEnabled > 9 ? '9+' : totalEnabled"
					></span>
				}
			}
			@tooltip.Content(tooltip.ContentProps{Class: "text-xs"}) {
				{ i18n.T(ctx, "Agent capabilities") }
			}
		}
		<!-- Backdrop -->
		<div
			x-show="open"
			x-cloak
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="open = false"
			class="fixed inset-0 z-60 bg-black/30 dark:bg-black/60"
		></div>
		<!-- Panel: centered in viewport -->
		<div
			x-ref="capPanel"
			x-show="open"
			x-cloak
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-90"
			x-transition:enter-end="opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-90"
			@keydown.escape.window="open = false"
			class="fixed inset-0 z-70 m-auto w-[min(90vw,36rem)] h-fit max-h-[min(80vh,40rem)] border border-border bg-popover text-popover-foreground shadow-2xl rounded-2xl overflow-hidden"
		>
			@capabilitiesPanelContent()
		</div>
	</div>
}

templ capabilitiesPanelContent() {
	{{ toolLabel := i18n.T(ctx, "tool") }}
	{{ toolsLabel := i18n.T(ctx, "tools") }}
	{{ kbLabel := i18n.T(ctx, "knowledge base") }}
	{{ kbsLabel := i18n.T(ctx, "knowledge bases") }}
	{{ fsLabel := i18n.T(ctx, "filesystem") }}
	{{ fssLabel := i18n.T(ctx, "filesystems") }}
	<div class="flex flex-col h-full max-h-[inherit]">
		<!-- Header -->
		<div class="flex items-center gap-3 px-5 pt-4 pb-3 border-b border-border/50">
			<div
				class="size-9 rounded-lg flex items-center justify-center shrink-0 [&_svg]:size-5 bg-primary/10 text-primary"
				x-html="agentIcon"
			></div>
			<div class="flex-1 min-w-0">
				<h3 class="text-sm font-semibold text-foreground truncate" x-text="agentName"></h3>
				<p class="text-[11px] text-muted-foreground mt-0.5 line-clamp-1" x-text="agentDescription || ''"></p>
			</div>
			<button type="button" @click="open = false" class="p-1 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors shrink-0" aria-label="Close">
				@icon.X(icon.Props{Class: "size-4"})
			</button>
		</div>
		<!-- Loading State -->
		<template x-if="loading">
			<div class="p-4 space-y-3">
				<template x-for="i in 3" :key="i">
					<div class="flex items-center gap-3 animate-pulse">
						<div class="size-8 rounded-lg bg-muted"></div>
						<div class="flex-1 space-y-1.5">
							<div class="h-3 bg-muted rounded w-1/3"></div>
							<div class="h-2.5 bg-muted rounded w-2/3"></div>
						</div>
					</div>
				</template>
			</div>
		</template>
		<!-- Loaded Content -->
		<template x-if="!loading">
			<div class="overflow-y-auto scrollbar-thin">
				<!-- Summary Badges -->
				<div class="flex flex-wrap gap-1.5 px-5 pt-3 pb-2">
					<template x-if="enabledTools > 0">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] gap-1 px-2 py-0.5"}) {
							@icon.Blocks(icon.Props{Class: "size-3"})
							<span x-text={ "enabledTools + ' ' + (enabledTools === 1 ? '" + toolLabel + "' : '" + toolsLabel + "')" }></span>
						}
					</template>
					<template x-if="enabledKBs > 0">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] gap-1 px-2 py-0.5"}) {
							@icon.Library(icon.Props{Class: "size-3"})
							<span x-text={ "enabledKBs + ' ' + (enabledKBs === 1 ? '" + kbLabel + "' : '" + kbsLabel + "')" }></span>
						}
					</template>
					<template x-if="enabledFS > 0">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] gap-1 px-2 py-0.5"}) {
							@icon.Folder(icon.Props{Class: "size-3"})
							<span x-text={ "enabledFS + ' ' + (enabledFS === 1 ? '" + fsLabel + "' : '" + fssLabel + "')" }></span>
						}
					</template>
					<template x-if="hasOrchestrationConfig">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px] gap-1 px-2 py-0.5"}) {
							@icon.GitBranch(icon.Props{Class: "size-3"})
							<span>{ i18n.T(ctx, "orchestration") }</span>
						}
					</template>
					<template x-if="totalEnabled === 0 && !hasOrchestrationConfig">
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] gap-1 px-2 py-0.5 text-muted-foreground"}) {
							@icon.Info(icon.Props{Class: "size-3"})
							{ i18n.T(ctx, "No capabilities configured") }
						}
					</template>
				</div>
				<!-- Tools Section -->
				<template x-if="plugins.length > 0">
					<div class="px-5 pb-2">
						<button
							type="button"
							@click="showToolsSection = !showToolsSection"
							class="flex items-center justify-between w-full py-1.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider hover:text-foreground transition-colors"
						>
							<span class="flex items-center gap-1.5">
								@icon.Blocks(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "Tools") }
							</span>
							<span
								class="transition-transform duration-200"
								:class="showToolsSection ? 'rotate-180' : ''"
							>
								@icon.ChevronDown(icon.Props{Class: "size-3.5"})
							</span>
						</button>
						<div x-show="showToolsSection" x-collapse>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-1">
								<template x-for="plugin in plugins" :key="plugin.id">
									<div class="rounded-lg border border-border/50 overflow-hidden">
										<!-- Plugin header -->
										<div class="flex items-center gap-2 px-2.5 py-1.5 bg-muted/30">
											<div
												class="size-5 rounded flex items-center justify-center shrink-0"
												:class="plugin.requirement_config?.action === 'block' ? 'bg-muted text-muted-foreground' : 'bg-primary/10 text-primary'"
											>
												@icon.Blocks(icon.Props{Class: "size-3"})
											</div>
											<span
												class="text-[11px] font-medium truncate flex-1"
												:class="plugin.requirement_config?.action === 'block' ? 'text-muted-foreground line-through' : 'text-foreground'"
												x-text="plugin.name"
											></span>
											<template x-if="plugin.requirement_config?.action === 'block'">
												<span class="inline-flex items-center rounded-full bg-destructive/10 px-1.5 py-0.5 text-[9px] font-medium text-destructive">blocked</span>
											</template>
											<template x-if="plugin.requirement_config?.action === 'require_confirmation'">
												<span class="inline-flex items-center rounded-full bg-warning/10 px-1.5 py-0.5 text-[9px] font-medium text-warning">confirm</span>
											</template>
											<template x-if="plugin.requirement_config?.action !== 'block'">
												<span
													class="text-[9px] tabular-nums shrink-0 text-primary"
													x-text="enabledToolCount(plugin) + '/' + plugin.tools.length"
												></span>
											</template>
										</div>
										<!-- Individual tools (only for non-blocked plugins with >1 tool) -->
										<template x-if="plugin.requirement_config?.action !== 'block' && plugin.tools.length > 1">
											<div class="border-t border-border/30 px-2.5 py-1 space-y-0.5 bg-background/50">
												<template x-for="tool in plugin.tools" :key="tool.id">
													<div class="flex items-center gap-1.5 py-px">
														<span
															class="size-1.5 rounded-full shrink-0"
															:class="tool.requirement_config?.action === 'block' ? 'bg-muted-foreground/30' : 'bg-primary'"
														></span>
														<span
															class="text-[10px] truncate"
															:class="tool.requirement_config?.action === 'block' ? 'text-muted-foreground line-through' : 'text-foreground'"
															x-text="tool.name"
														></span>
													</div>
												</template>
											</div>
										</template>
									</div>
								</template>
							</div>
						</div>
					</div>
				</template>
				<!-- Knowledge Bases Section -->
				<template x-if="workspaces.length > 0">
					<div class="px-5 pb-2">
						<button
							type="button"
							@click="showKBSection = !showKBSection"
							class="flex items-center justify-between w-full py-1.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider hover:text-foreground transition-colors"
						>
							<span class="flex items-center gap-1.5">
								@icon.Library(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "Knowledge Bases") }
							</span>
							<span
								class="transition-transform duration-200"
								:class="showKBSection ? 'rotate-180' : ''"
							>
								@icon.ChevronDown(icon.Props{Class: "size-3.5"})
							</span>
						</button>
						<div x-show="showKBSection" x-collapse>
							<div class="space-y-1 mt-1">
								<template x-for="ws in workspaces" :key="ws.id">
									<div
										class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg border border-border/50"
										:class="ws.enabled ? 'bg-muted/30' : 'opacity-50'"
									>
										<div
											class="size-6 rounded-md flex items-center justify-center shrink-0"
											:class="ws.enabled ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'"
										>
											@icon.Library(icon.Props{Class: "size-3"})
										</div>
										<div class="flex-1 min-w-0">
											<div
												class="text-xs font-medium truncate"
												:class="ws.enabled ? 'text-foreground' : 'text-muted-foreground line-through'"
												x-text="ws.name"
											></div>
											<div class="text-[10px] text-muted-foreground truncate" x-text="ws.description || ws.slug"></div>
										</div>
										<span
											class="size-2 rounded-full shrink-0"
											:class="ws.enabled ? 'bg-success' : 'bg-muted-foreground/30'"
										></span>
									</div>
								</template>
							</div>
						</div>
					</div>
				</template>
				<!-- Filesystems Section -->
				<template x-if="filesystems.length > 0">
					<div class="px-5 pb-2">
						<button
							type="button"
							@click="showFSSection = !showFSSection"
							class="flex items-center justify-between w-full py-1.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider hover:text-foreground transition-colors"
						>
							<span class="flex items-center gap-1.5">
								@icon.Folder(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "Filesystems") }
							</span>
							<span
								class="transition-transform duration-200"
								:class="showFSSection ? 'rotate-180' : ''"
							>
								@icon.ChevronDown(icon.Props{Class: "size-3.5"})
							</span>
						</button>
						<div x-show="showFSSection" x-collapse>
							<div class="space-y-1 mt-1">
								<template x-for="fs in filesystems" :key="fs.id">
									<div
										class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg border border-border/50"
										:class="fs.enabled ? 'bg-muted/30' : 'opacity-50'"
									>
										<div
											class="size-6 rounded-md flex items-center justify-center shrink-0"
											:class="fs.enabled ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'"
										>
											@icon.Folder(icon.Props{Class: "size-3"})
										</div>
										<div class="flex-1 min-w-0">
											<div
												class="text-xs font-medium truncate"
												:class="fs.enabled ? 'text-foreground' : 'text-muted-foreground line-through'"
												x-text="fs.name"
											></div>
											<div class="text-[10px] text-muted-foreground truncate" x-text="fs.description || fs.type"></div>
										</div>
										<span
											class="size-2 rounded-full shrink-0"
											:class="fs.enabled ? 'bg-success' : 'bg-muted-foreground/30'"
										></span>
									</div>
								</template>
							</div>
						</div>
					</div>
				</template>
				<!-- Multi-Agent Orchestration Section -->
				<template x-if="hasOrchestrationConfig">
					<div class="px-5 pb-2">
						<button
							type="button"
							@click="showOrchestrationSection = !showOrchestrationSection"
							class="flex items-center justify-between w-full py-1.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider hover:text-foreground transition-colors"
						>
							<span class="flex items-center gap-1.5">
								@icon.GitBranch(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "Multi-Agent Orchestration") }
							</span>
							<span
								class="transition-transform duration-200"
								:class="showOrchestrationSection ? 'rotate-180' : ''"
							>
								@icon.ChevronDown(icon.Props{Class: "size-3.5"})
							</span>
						</button>
						<div x-show="showOrchestrationSection" x-collapse>
							<div class="space-y-1.5 mt-1">
								<!-- Transfer Policy -->
								<template x-if="orchTransferToParentBlocked || orchTransferToPeersBlocked">
									<div class="rounded-lg border border-border/50 bg-muted/30 px-3 py-2">
										<div class="flex items-center gap-2 mb-1.5">
											<div class="size-5 rounded flex items-center justify-center shrink-0 bg-amber-500/10 text-amber-600 dark:text-amber-400">
												@icon.ShieldAlert(icon.Props{Class: "size-3"})
											</div>
											<span class="text-[11px] font-medium text-foreground">{ i18n.T(ctx, "Transfer Policy") }</span>
										</div>
										<div class="flex flex-wrap gap-1.5 pl-7">
											<template x-if="orchTransferToParentBlocked">
												@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] gap-1 px-2 py-0.5 border-amber-500/30 text-amber-700 dark:text-amber-400"}) {
													@icon.ArrowUp(icon.Props{Class: "size-2.5"})
													{ i18n.T(ctx, "Parent blocked") }
												}
											</template>
											<template x-if="orchTransferToPeersBlocked">
												@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] gap-1 px-2 py-0.5 border-amber-500/30 text-amber-700 dark:text-amber-400"}) {
													@icon.ArrowLeftRight(icon.Props{Class: "size-2.5"})
													{ i18n.T(ctx, "Peers blocked") }
												}
											</template>
										</div>
									</div>
								</template>
								<!-- Output Key -->
								<template x-if="orchOutputKey">
									<div class="flex items-center gap-2.5 px-3 py-2 rounded-lg border border-border/50 bg-muted/30">
										<div class="size-5 rounded flex items-center justify-center shrink-0 bg-blue-500/10 text-blue-600 dark:text-blue-400">
											@icon.Key(icon.Props{Class: "size-3"})
										</div>
										<div class="flex-1 min-w-0">
											<div class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Output Key") }</div>
											<div class="text-[11px] font-mono font-medium text-foreground truncate" x-text="orchOutputKey"></div>
										</div>
									</div>
								</template>
								<!-- Include Contents -->
								<template x-if="orchIncludeContents === 'none'">
									<div class="flex items-center gap-2.5 px-3 py-2 rounded-lg border border-border/50 bg-muted/30">
										<div class="size-5 rounded flex items-center justify-center shrink-0 bg-purple-500/10 text-purple-600 dark:text-purple-400">
											@icon.MessageSquare(icon.Props{Class: "size-3"})
										</div>
										<div class="flex-1 min-w-0">
											<div class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "History Forwarding") }</div>
											<div class="text-[11px] font-medium text-foreground">{ i18n.T(ctx, "Fresh context (no history forwarded)") }</div>
										</div>
									</div>
								</template>
								<!-- Global Instruction -->
								<template x-if="orchGlobalInstruction">
									<div class="rounded-lg border border-border/50 bg-muted/30 px-3 py-2">
										<div class="flex items-center gap-2 mb-1">
											<div class="size-5 rounded flex items-center justify-center shrink-0 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
												@icon.Globe(icon.Props{Class: "size-3"})
											</div>
											<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Global Instruction") }</span>
										</div>
										<p class="text-[11px] text-foreground/80 pl-7 line-clamp-3 whitespace-pre-line" x-text="orchGlobalInstruction"></p>
									</div>
								</template>
								<!-- Output Schema -->
								<template x-if="orchOutputSchema">
									<div class="rounded-lg border border-border/50 bg-muted/30 px-3 py-2">
										<div class="flex items-center gap-2 mb-1">
											<div class="size-5 rounded flex items-center justify-center shrink-0 bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">
												@icon.Braces(icon.Props{Class: "size-3"})
											</div>
											<span class="text-[10px] text-muted-foreground">{ i18n.T(ctx, "Output Schema") }</span>
										</div>
										<pre class="text-[10px] text-foreground/70 pl-7 max-h-20 overflow-auto font-mono leading-relaxed" x-text="orchOutputSchema"></pre>
									</div>
								</template>
							</div>
						</div>
					</div>
				</template>
				<!-- Empty State -->
				<template x-if="plugins.length === 0 && workspaces.length === 0 && filesystems.length === 0 && !hasOrchestrationConfig">
					<div class="flex flex-col items-center justify-center py-6 px-4 gap-2 text-muted-foreground">
						@icon.ShieldCheck(icon.Props{Class: "size-8 opacity-20"})
						<p class="text-xs text-center">{ i18n.T(ctx, "This agent has no tools, knowledge bases, or filesystems configured yet.") }</p>
						<p class="text-[10px] text-center text-muted-foreground/70">{ i18n.T(ctx, "Edit the agent to configure its capabilities.") }</p>
					</div>
				</template>
				<!-- Footer spacer -->
				<div class="h-2"></div>
			</div>
		</template>
	</div>
}
