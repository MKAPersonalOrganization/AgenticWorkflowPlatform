package messagelist

import (
	"context"
	"aicompass/frontend/components/badge"
	"aicompass/frontend/ui/errormessage"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/ui/message"
	"aicompass/frontend/ui/tokenusage"
)

// ScrollToBottom - LibreChat style floating scroll button
templ ScrollToBottom() {
	<button
		x-show="scrolledUp"
		x-cloak
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-2"
		@click="scrollToBottom()"
		class="absolute bottom-5 left-1/2 -translate-x-1/2 cursor-pointer rounded-full border border-border bg-background p-2 shadow-md hover:shadow-lg hover:bg-accent/50 transition-all z-10"
		aria-label={ i18n.T(ctx, "Scroll to bottom") }
	>
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-muted-foreground">
			<path
				d="M17 13L12 18L7 13M12 6L12 17"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</button>
}

// DateSeparator - LibreChat style date separator
templ DateSeparator() {
	<div
		x-show="index > 0 && getMessageDate(message) !== getMessageDate(displayMessages[index - 1])"
		x-cloak
		class="flex items-center justify-center my-4"
	>
		<div class="text-xs text-muted-foreground bg-muted/50 px-3 py-1 rounded-full">
			<span x-text="formatRelativeDate(getMessageDate(message))"></span>
		</div>
	</div>
}

// ToolConfirmationDialog - Renders a confirmation dialog for tools that require binary verification.
// Shows when a tool message has status 'awaiting_confirmation' with a question_text in parsedResult.
templ ToolConfirmationDialog() {
	<div
		x-show="message.type === 'tool_call' && message.status === 'awaiting_confirmation' && message.parsedResult?.question_text"
		x-data="{
			confirm() {
				$dispatch('tool-input-provided', {
					toolCallId: message.id,
					input: JSON.stringify({ confirmed: true })
				});
			},
			deny() {
				$dispatch('tool-input-provided', {
					toolCallId: message.id,
					input: JSON.stringify({ confirmed: false })
				});
			}
		}"
		class="my-3 rounded-xl border border-warning/30 bg-warning/5 overflow-hidden shadow-lg shadow-warning/10"
	>
		<!-- Header -->
		<div class="flex items-center gap-3 px-4 py-3 bg-warning/10 border-b border-warning/20">
			<div class="flex-shrink-0 w-8 h-8 rounded-full bg-warning/20 flex items-center justify-center">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning">
					<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path>
					<path d="M12 8v4"></path>
					<path d="M12 16h.01"></path>
				</svg>
			</div>
			<div class="flex-1 min-w-0">
				<div class="text-sm font-semibold text-warning">
					Confirmation Required
				</div>
				<div class="text-xs text-warning/70" x-text="message.name"></div>
			</div>
		</div>
		<!-- Question -->
		<div class="px-4 py-4">
			<p class="text-sm text-foreground/90 leading-relaxed" x-text="message.parsedResult?.question_text || 'Confirmation required'"></p>
		</div>
		<!-- Actions -->
		<div class="flex items-center justify-end gap-3 px-4 py-3 bg-muted/30 border-t border-border/10">
			<button
				type="button"
				@click="deny()"
				class="px-4 py-2 rounded-lg border border-border/30 bg-background text-sm font-medium text-foreground/70 hover:bg-muted/50 hover:text-foreground/90 transition-all duration-200"
			>
				<span class="flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
					Deny
				</span>
			</button>
			<button
				type="button"
				@click="confirm()"
				class="px-4 py-2 rounded-lg bg-success text-success-foreground text-sm font-medium hover:bg-success/90 transition-all duration-200 shadow-sm shadow-success/20"
			>
				<span class="flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
					Allow
				</span>
			</button>
		</div>
	</div>
}

// ToolCustomInputDialog - Renders a text input form for tools that request custom user input
// via io.Read(). Shows when a tool message has status 'awaiting_input' with a question_text.
templ ToolCustomInputDialog() {
	<div
		x-show="message.type === 'tool_call' && message.status === 'awaiting_input' && message.parsedResult?.question_text"
		x-data="{
			userInput: '',
			submit() {
				if (!this.userInput.trim()) return;
				$dispatch('tool-input-provided', {
					toolCallId: message.id,
					input: this.userInput.trim()
				});
			}
		}"
		class="my-3 rounded-xl border border-info/30 bg-info/5 overflow-hidden shadow-lg shadow-info/10"
	>
		<!-- Header -->
		<div class="flex items-center gap-3 px-4 py-3 bg-info/10 border-b border-info/20">
			<div class="flex-shrink-0 w-8 h-8 rounded-full bg-info/20 flex items-center justify-center">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-info">
					<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
				</svg>
			</div>
			<div class="flex-1 min-w-0">
				<div class="text-sm font-semibold text-info">
					Input Required
				</div>
				<div class="text-xs text-info/70" x-text="message.name"></div>
			</div>
		</div>
		<!-- Question -->
		<div class="px-4 py-4">
			<p class="text-sm text-foreground/90 leading-relaxed mb-3" x-text="message.parsedResult?.question_text || 'Please provide input'"></p>
			<input
				type="text"
				x-model="userInput"
				@keydown.enter="submit()"
				placeholder="Type your response..."
				class="w-full px-3 py-2 rounded-lg border border-border/40 bg-background text-sm text-foreground placeholder-foreground/40 focus:outline-none focus:ring-2 focus:ring-info/40 focus:border-info/50"
			/>
		</div>
		<!-- Actions -->
		<div class="flex items-center justify-end gap-3 px-4 py-3 bg-muted/30 border-t border-border/10">
			<button
				type="button"
				@click="submit()"
				:disabled="!userInput.trim()"
				class="px-4 py-2 rounded-lg bg-info text-info-foreground text-sm font-medium hover:bg-info/90 transition-all duration-200 shadow-sm shadow-info/20 disabled:opacity-50 disabled:cursor-not-allowed"
			>
				<span class="flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
					Submit
				</span>
			</button>
		</div>
	</div>
}

// ToolCall - Modern specialized tool call rendering
templ ToolCall(ctx context.Context) {
	<div
		x-data="{ expanded: false }"
		class="my-2 relative group/message border-s-4 border-primary bg-card/30 rounded-e-lg overflow-hidden transition-all duration-300 hover:bg-card/50"
		:class="expanded ? 'shadow-md' : 'shadow-sm'"
	>
		<!-- Parallel indicator bar -->
		<template x-if="getParallelToolCallInfo(message).isParallel">
			<div class="absolute inset-inline-start-0 top-0 bottom-0 w-1 bg-primary/20" title="Parallel tool call"></div>
		</template>
		<!-- Header/Summary line -->
		<div
			@click="expanded = !expanded"
			class="flex items-center gap-3 px-4 py-3 cursor-pointer select-none overflow-hidden"
		>
			<!-- Tool Icon -->
			<div class="flex-shrink-0 text-primary">
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
					<path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z"></path>
				</svg>
			</div>
			<div class="flex items-center gap-2 min-w-0 flex-1">
				<template x-if="message.agentName">
					<span class="text-xs font-medium text-muted-foreground truncate" x-text="message.agentName"></span>
				</template>
				<template x-if="message.agentName">
					<svg class="w-3 h-3 text-muted-foreground/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
				</template>
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "font-mono text-[10px] px-1.5 py-0 h-5 truncate"}) {
					<span x-text="message.name"></span>
				}
				<template x-if="getParallelToolCallInfo(message).isParallel">
					<span class="text-[10px] text-muted-foreground/70 font-medium" x-text="`${getParallelToolCallInfo(message).position}/${getParallelToolCallInfo(message).count}`"></span>
				</template>
			</div>
			<div class="flex items-center gap-2 flex-shrink-0">
				<span class="text-xs text-primary/80 font-medium" x-text="message.status === 'completed' ? '✓' : '...' "></span>
				<svg
					class="w-4 h-4 text-muted-foreground transition-transform duration-300"
					:class="expanded ? 'rotate-180' : ''"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			</div>
		</div>
		<!-- Collapsible Details -->
		<div x-show="expanded" x-collapse>
			<div class="px-4 pb-4 pt-0 space-y-4 border-t border-border/20 bg-muted/5">
				<!-- Arguments -->
				<div class="space-y-1.5">
					<div class="flex items-center gap-2 text-[11px] font-semibold text-muted-foreground uppercase tracking-tight">
						<span>{ i18n.T(ctx, "Arguments") }</span>
					</div>
					<div class="rounded-md bg-muted/40 p-3 font-mono text-xs overflow-x-auto ring-1 ring-inset ring-border/20">
						<div x-html="`<pre class='whitespace-pre-wrap break-words'><code>${JSON.stringify(message.parsedArgs || {}, null, 2)}</code></pre>`"></div>
					</div>
				</div>
				<!-- Result -->
				<template x-if="message.result">
					<div class="space-y-1.5">
						<div class="flex items-center gap-2 text-[11px] font-semibold text-muted-foreground uppercase tracking-tight">
							<span>{ i18n.T(ctx, "Result") }</span>
						</div>
						<div class="rounded-md bg-background/50 p-3 font-mono text-xs overflow-x-auto ring-1 ring-inset ring-border/20">
							<template x-if="isValidJSON(message.result)">
								<div x-html="`<pre class='whitespace-pre-wrap break-words'><code>${JSON.stringify(JSON.parse(message.result), null, 2)}</code></pre>`"></div>
							</template>
							<template x-if="!isValidJSON(message.result)">
								<div x-text="message.result" class="whitespace-pre-wrap break-words"></div>
							</template>
						</div>
					</div>
				</template>
			</div>
		</div>
	</div>
}

// ArtifactCard renders a document/file artifact produced by an agent.
// Generic UI affordance — no transport-specific details exposed here.
templ ArtifactCard(ctx context.Context) {
	<div
		x-show="message.type === 'artifact'"
		x-cloak
		x-data="{ expanded: true }"
		class="w-full my-2 animate-in fade-in slide-in-from-bottom-2 duration-300"
	>
		<div class="rounded-lg border border-border bg-card overflow-hidden shadow-modern-xs">
			<!-- Header -->
			<div
				@click="expanded = !expanded"
				class="flex items-center gap-3 px-4 py-3 cursor-pointer select-none bg-muted/30 hover:bg-muted/50 transition-colors"
			>
				<svg class="size-4 text-muted-foreground shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
				</svg>
				<span class="text-sm font-medium text-foreground flex-1 truncate" x-text="message.title || '...'"></span>
				<template x-if="message.agentName">
					<span class="text-xs text-muted-foreground me-2 shrink-0" x-text="message.agentName"></span>
				</template>
				<svg
					class="size-4 text-muted-foreground transition-transform duration-200 shrink-0"
					:class="expanded ? 'rotate-180' : ''"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
				</svg>
			</div>
			<!-- Content -->
			<div x-show="expanded" x-collapse>
				<div
					class="px-4 py-4 prose prose-sm max-w-none text-[0.9375rem] leading-[1.75] text-foreground dark:**:text-white border-t border-border/50"
					x-html="renderMarkdown(message.content)"
					dir="auto"
				></div>
			</div>
		</div>
	</div>
}

// FileCard renders a downloadable file attachment produced by an agent.
// Generic UI affordance — no transport-specific details exposed here.
templ FileCard(ctx context.Context) {
	<div
		x-show="message.type === 'file_attachment'"
		x-cloak
		class="w-full my-2 animate-in fade-in slide-in-from-bottom-2 duration-300"
	>
		<div class="rounded-lg border border-border bg-card overflow-hidden shadow-modern-xs">
			<div class="flex items-center gap-3 px-4 py-3 bg-muted/30">
				<svg class="size-4 text-muted-foreground shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				<a
					:href="message.fileUrl"
					:download="message.fileName || true"
					target="_blank"
					rel="noopener noreferrer"
					class="text-sm font-medium text-foreground hover:text-primary flex-1 truncate transition-colors"
					x-text="message.fileName || 'Download file'"
				></a>
				<template x-if="message.agentName">
					<span class="text-xs text-muted-foreground shrink-0" x-text="message.agentName"></span>
				</template>
			</div>
		</div>
	</div>
}

// CodeExecutionCard renders the code the LLM asked the provider's sandbox
// to run plus the output it got back. Nothing runs on our infrastructure —
// this is a read-only audit trail of what Gemini (or future OpenAI /
// Anthropic code interpreters) executed. Outcome drives the style so the
// user can tell at a glance whether the run succeeded.
templ CodeExecutionCard() {
	<div
		x-show="message.type === 'code_execution'"
		x-cloak
		class="w-full my-2 animate-in fade-in slide-in-from-bottom-2 duration-300"
	>
		<div
			class="rounded-lg border overflow-hidden shadow-modern-xs"
			:class="message.ok ? 'border-teal-500/30 bg-card' : 'border-destructive/30 bg-card'"
		>
			<!-- Header: icon + language + outcome pill -->
			<div
				class="flex items-center gap-2.5 px-3 py-2 border-b"
				:class="message.ok ? 'border-teal-500/20 bg-teal-500/5' : 'border-destructive/20 bg-destructive/5'"
			>
				<svg class="size-4 shrink-0" :class="message.ok ? 'text-teal-600 dark:text-teal-400' : 'text-destructive'" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<polyline points="4 17 10 11 4 5"></polyline>
					<line x1="12" y1="19" x2="20" y2="19"></line>
				</svg>
				<span class="text-[10px] font-semibold uppercase tracking-wider" :class="message.ok ? 'text-teal-700 dark:text-teal-400' : 'text-destructive'" x-text="'code · ' + (message.language || 'python')"></span>
				<span x-show="!message.ok" class="text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-destructive/10 text-destructive" x-text="message.outcome || 'failed'"></span>
				<template x-if="message.agentName">
					<span class="ms-auto text-[10px] text-muted-foreground shrink-0" x-text="message.agentName"></span>
				</template>
			</div>
			<!-- Code block -->
			<pre class="px-3 py-2 text-[12px] font-mono leading-relaxed overflow-x-auto bg-muted/30 text-foreground"><code x-text="message.code"></code></pre>
			<!-- Output (only if present) -->
			<template x-if="message.output">
				<div class="border-t border-border/50">
					<div class="px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground bg-muted/50">{ i18n.T(ctx, "Output") }</div>
					<pre class="px-3 py-2 text-[11px] font-mono leading-relaxed overflow-x-auto whitespace-pre-wrap text-foreground/80" x-text="message.output"></pre>
				</div>
			</template>
		</div>
	</div>
}

// ArtifactSavedCard renders a compact notification when an agent creates or
// updates a versioned artifact via the artifact service.
templ ArtifactSavedCard() {
	<div
		x-show="message.type === 'artifact_saved'"
		x-cloak
		class="w-full my-2 animate-in fade-in slide-in-from-bottom-2 duration-300"
	>
		<div class="rounded-lg border border-border bg-card overflow-hidden shadow-modern-xs">
			<div class="flex items-center gap-3 px-4 py-3 bg-muted/30">
				<svg class="size-4 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M21 7h-3a2 2 0 0 1-2-2V2"></path>
					<path d="M21 6v6.5c0 .8-.7 1.5-1.5 1.5h-7c-.8 0-1.5-.7-1.5-1.5v-9c0-.8.7-1.5 1.5-1.5H17Z"></path>
					<path d="M7 8v8.8c0 .3.2.6.4.8.2.2.5.4.8.4H15"></path>
					<path d="M3 12v8.8c0 .3.2.6.4.8.2.2.5.4.8.4H11"></path>
				</svg>
				<div class="flex-1 min-w-0">
					<span class="text-sm font-medium text-foreground truncate" x-text="message.fileName"></span>
					<span class="text-xs text-muted-foreground ml-1.5" x-text="'v' + message.version"></span>
				</div>
				<template x-if="message.agentName">
					<span class="text-xs text-muted-foreground shrink-0" x-text="message.agentName"></span>
				</template>
			</div>
		</div>
	</div>
}

// ThinkingSkeleton - Premium thinking indicator for assistant activity
templ ThinkingSkeleton() {
	<div
		x-show="showTypingIndicator"
		x-cloak
		class="flex items-center py-4 animate-in fade-in slide-in-from-bottom-2 duration-500"
		role="status"
		aria-live="polite"
	>
		<div class="flex items-center gap-3 px-4">
			<!-- Animated shimmer orb -->
			<div class="relative flex items-center justify-center size-5">
				<div class="absolute inset-0 rounded-full bg-primary/20 animate-ping" style="animation-duration: 2s;"></div>
				<div class="size-2.5 rounded-full bg-primary animate-pulse shadow-sm shadow-primary/50"></div>
			</div>
			<span class="thinking-shimmer text-sm font-medium text-muted-foreground tracking-wide">
				{ i18n.T(ctx, "thinking") }
			</span>
		</div>
	</div>
}

// MessageContextMenu renders a floating right-click context menu for messages.
// It is positioned at the cursor via Alpine state (contextMenuX, contextMenuY)
// and dismissed on click-outside or Escape.
templ MessageContextMenu() {
	<div
		x-show="contextMenuOpen"
		x-cloak
		x-transition:enter="transition ease-out duration-100"
		x-transition:enter-start="opacity-0 scale-95"
		x-transition:enter-end="opacity-100 scale-100"
		x-transition:leave="transition ease-in duration-75"
		x-transition:leave-start="opacity-100 scale-100"
		x-transition:leave-end="opacity-0 scale-95"
		@click.outside="contextMenuOpen = false"
		@keydown.escape.window="contextMenuOpen = false"
		class="fixed z-50 min-w-[160px] rounded-md border border-border bg-popover p-1 shadow-md"
		:style="`left: ${contextMenuX}px; top: ${contextMenuY}px;`"
		role="menu"
		aria-label={ i18n.T(ctx, "Message actions") }
	>
		<!-- Copy -->
		<button
			@click="contextMenuCopyMessage(); contextMenuOpen = false"
			class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm text-popover-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer outline-none transition-colors"
			role="menuitem"
		>
			<svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
			<span>{ i18n.T(ctx, "Copy") }</span>
		</button>
	</div>
}

// StreamingPlaceholder renders a calm "working" indicator in the main
// chat thread while a multi-agent workflow is streaming. The intermediate
// agent output streams into the Activity side panel; the user sees a
// stable, premium placeholder in chat instead of agent text flashing in
// and out of the bubble area.
templ StreamingPlaceholder() {
	<template x-if="message.type === 'streaming_placeholder'">
		<div class="flex items-start gap-4 group/message w-full pie-10">
			<div class="flex items-center gap-3 rounded-2xl glass shadow-modern-sm border border-border/40 px-4 py-2.5 text-sm">
				<div class="relative shrink-0">
					<div class="size-6 rounded-full bg-primary/10 flex items-center justify-center ring-1 ring-primary/30">
						<svg class="size-3 text-primary animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
							<path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
						</svg>
					</div>
				</div>
				<div class="min-w-0">
					<div class="text-foreground/85 font-medium">
						{ i18n.T(ctx, "Working through the workflow") }
						<span class="inline-block animate-pulse">…</span>
					</div>
					<button
						type="button"
						@click="activityPanelMinimized ? restoreActivityPanel() : openActivityPanel()"
						class="text-[11px] text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1 mt-0.5"
					>
						<span>{ i18n.T(ctx, "View live activity") }</span>
						<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
					</button>
				</div>
			</div>
		</div>
	</template>
}

// FinalAttribution renders a tasteful "via AgentName" footer under the
// final assistant message of a multi-agent turn. Hidden for single-agent
// turns to avoid noise.
templ FinalAttribution() {
	<template x-if="message._isFinalOfTurn && message.agentName">
		<div class="flex items-center gap-1.5 mt-1 ps-1 text-[11px] text-muted-foreground/70">
			<svg class="size-3 text-primary/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
			<span>{ i18n.T(ctx, "Final answer · via") } <span class="font-medium text-foreground/70" x-text="message.agentName"></span></span>
		</div>
	</template>
}

templ MessageList() {
	<div class="space-y-4 relative">
		<template x-for="(message, index) in displayMessages" :key="message.id">
			<div
				class="group"
				role="article"
				:aria-label="`Message from ${message.role || message.type || 'system'}`"
				x-show="message.type !== 'activity_card' && (message.type === 'streaming_placeholder' || !showSearch || !searchQuery || (message.content && message.content.toLowerCase().includes(searchQuery.toLowerCase())) || (message.parsedArgs && JSON.stringify(message.parsedArgs).toLowerCase().includes(searchQuery.toLowerCase())))"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 translate-y-2"
				x-transition:enter-end="opacity-100 translate-y-0"
				@contextmenu.prevent="openMessageContextMenu($event, message)"
			>
				<!-- Date Separator -->
				@DateSeparator()
				<!-- Calm placeholder shown in the chat thread while a
				     multi-agent workflow streams. Real agent text lands in
				     the floating Activity panel, not here. -->
				@StreamingPlaceholder()
				<!-- User Message -->
				@message.UserMessage()
				<!-- Tool Confirmation Dialog (for awaiting_confirmation state) -->
				@ToolConfirmationDialog()
				<!-- Tool Custom Input Dialog (for awaiting_input state) -->
				@ToolCustomInputDialog()
				<!-- Tool Call Message -->
				<template x-if="message.type === 'tool_call'">
					@ToolCall(ctx)
				</template>
				<!-- Assistant Message -->
				@message.AssistantMessage()
				<!-- Final-answer attribution (multi-agent turns only) -->
				@FinalAttribution()
				<!-- Artifact Card -->
				@ArtifactCard(ctx)
				<!-- File Attachment Card -->
				@FileCard(ctx)
				<!-- Artifact Version Saved Card -->
				@ArtifactSavedCard()
				<!-- Code Execution Card — surfaces code the LLM ran in the
				     provider's sandbox (Gemini today). Read-only source +
				     output, rendered inline with the turn that produced it. -->
				@CodeExecutionCard()
			</div>
		</template>
		<!-- Right-click Context Menu -->
		@MessageContextMenu()
		<!-- Typing Indicator -->
		@ThinkingSkeleton()
		<!-- Error Message -->
		@errormessage.ErrorMessage()
		<!-- Token Usage Display -->
		@tokenusage.TokenUsage()
	</div>
}
