package nav

import (
	"aicompass/foundation/features"
	"fmt"
	"aicompass/frontend/components/alert"
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/collapsible"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/components/selectbox"
	switchcomp "aicompass/frontend/components/switch"
	"aicompass/frontend/components/tabs"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/ui/nativeselect"
)

// Settings renders the settings dialog
// (matches LibreChat's Settings.tsx).
templ Settings() {
	<!--
		Self-contained x-data="settingsManager" (assets/js/components/settings-manager.js)
		so the dialog works on any BaseLayout page, not just /chat whose
		x-data="chat" scope historically owned showSettings / profile /
		preferences / sessions. The settingsManager component persists
		preference toggles to localStorage so changes made from any page
		survive navigation. fetchProfile() runs when the dialog opens.
	-->
	<div
		x-data="settingsManager"
		x-show="showSettings"
		x-cloak
		@open-settings-dialog.window="let _tab = ($event.detail || {}).tab; showSettings = true; fetchProfile(); if (_tab) $nextTick(function() { if (window.tui && window.tui.tabs) window.tui.tabs.setActive('settings-tabs', _tab); })"
	>
		@dialog.Dialog(dialog.Props{Class: "relative z-50"}) {
			<!-- Backdrop — mode-aware scrim + blur, matches premium dialog pattern -->
			<div
				class="fixed inset-0 bg-black/30 dark:bg-black/60 backdrop-blur-sm transition-opacity"
				aria-hidden="true"
				x-show="showSettings"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
			></div>
			<div
				class="fixed inset-0 flex items-center justify-center p-4"
				x-show="showSettings"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@click.self="showSettings = false"
			>
				<div
					class="w-full md:w-[800px] max-h-[90vh] bg-card rounded-2xl shadow-modern-xl flex flex-col overflow-hidden border border-border/60 relative z-10"
					@keydown.escape.window="showSettings = false"
				>
					<!-- Header -->
					<div class="flex items-center justify-between p-6 pb-4">
						<h2 class="text-lg font-medium text-foreground">{ i18n.T(ctx, "Settings") }</h2>
						@button.Button(button.Props{
							Type:    button.TypeButton,
							Variant: button.VariantGhost,
							Size:    button.SizeIcon,
							Class:   "rounded-lg p-1 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors",
							Attributes: templ.Attributes{
								"@click": "showSettings = false",
							},
						}) {
							@icon.X(icon.Props{Class: "size-5"})
						}
					</div>
					<!-- Use Tabs Component -->
					@tabs.Tabs(tabs.Props{
						ID:    "settings-tabs",
						Class: "flex flex-col md:flex-row h-full overflow-hidden px-6 pb-6 gap-6",
						Attributes: templ.Attributes{
							"data-orientation": "vertical",
						},
					}) {
						<!-- Tab List -->
						<div class="flex flex-row md:flex-col gap-1 min-w-40 overflow-x-auto md:overflow-y-auto scrollbar-none pb-2 md:pb-0 border-b md:border-b-0 md:border-e border-border pe-0 md:pe-4">
							@tabs.List(tabs.ListProps{Class: "flex flex-row md:flex-col gap-1 bg-transparent p-0 w-full h-auto items-stretch"}) {
								@tabs.Trigger(tabs.TriggerProps{
									Value:    "general",
									IsActive: true,
									Class:    "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Settings(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "General") }</span>
								}
								@tabs.Trigger(tabs.TriggerProps{Value: "ai",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Bot(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "AI") }</span>
								}
								@tabs.Trigger(tabs.TriggerProps{Value: "personalization",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.UserCog(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "Personalization") }</span>
								}
								@tabs.Trigger(tabs.TriggerProps{
									Value: "speech",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Mic(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "Speech") }</span>
								}
								@tabs.Trigger(tabs.TriggerProps{
									Value: "data",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.Database(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "Data") }</span>
								}

								@tabs.Trigger(tabs.TriggerProps{
									Value: "account",
									Class: "justify-start gap-2 px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 data-[tui-tabs-state=active]:bg-accent data-[tui-tabs-state=active]:text-foreground data-[tui-tabs-state=inactive]:text-muted-foreground hover:bg-accent/50 hover:text-foreground shadow-none border-none",
								}) {
									@icon.User(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "Account") }</span>
								}
							}
						</div>
						<!-- Tab Content Wrapper -->
						<div class="flex-1 overflow-y-auto pe-2 scrollbar-transparent scrollbar-hover text-sm">
							<!-- General Tab -->
							@tabs.Content(tabs.ContentProps{Value: "general", IsActive: true, Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="flex items-center justify-between gap-4">
									<div class="text-foreground">{ i18n.T(ctx, "Theme") }</div>
									@nativeselect.Select(
										nativeselect.Props{
											Class:       "w-[180px]",
											Model:       "preferences.theme",
											Label:       i18n.T(ctx, "Select Theme"),
											Placeholder: i18n.T(ctx, "Select Theme"),
										},
										[]nativeselect.Option{
											{Value: "system", Label: i18n.T(ctx, "System")},
											{Value: "dark", Label: i18n.T(ctx, "Dark")},
											{Value: "light", Label: i18n.T(ctx, "Light")},
										},
									)
								</div>
								<div class="flex items-center justify-between gap-4">
									<div class="text-foreground">{ i18n.T(ctx, "Language") }</div>
									@selectbox.SelectBox(selectbox.Props{Class: "w-[200px]"}) {
										<div class="relative w-full" x-data="{ currentLang: '', languages: window.i18n ? window.i18n.LANGUAGES : {} }" x-init={ fmt.Sprintf("currentLang = '%s'", i18n.Lang(ctx)) }>
											<select
												x-model="currentLang"
												@change="window.location.href = '?lang=' + $event.target.value"
												class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
												aria-label="Select Language"
											>
												<template x-for="lang in Object.values(languages).sort((a, b) => a.nativeName.localeCompare(b.nativeName))" :key="lang.code">
													<option :value="lang.code" :selected="lang.code === currentLang" x-text="lang.nativeName"></option>
												</template>
											</select>
											<div class="w-full h-9 px-3 py-1 text-base md:text-sm flex items-center justify-between rounded-md border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground">
												<span x-text="languages[currentLang] ? languages[currentLang].nativeName : currentLang"></span>
												@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
											</div>
										</div>
									}
								</div>
								<div class="border-t border-border pt-4 space-y-4">
									<div class="flex items-center justify-between gap-4">
										<div class="text-foreground">{ i18n.T(ctx, "Enable Markdown for user messages") }</div>
										@switchcomp.Switch(switchcomp.Props{
											Name:    "markdownEnabled",
											Checked: true,
											Attributes: templ.Attributes{
												"x-model":    "preferences.markdownEnabled",
												"aria-label": i18n.T(ctx, "Enable Markdown"),
											},
										})
									</div>
									<div class="flex items-center justify-between gap-4">
										<div class="text-foreground">{ i18n.T(ctx, "Auto-scroll during response") }</div>
										@switchcomp.Switch(switchcomp.Props{
											Name:    "autoScroll",
											Checked: true,
											Attributes: templ.Attributes{
												"x-model":    "preferences.autoScroll",
												"aria-label": i18n.T(ctx, "Auto-scroll during response"),
											},
										})
									</div>
								</div>
							}
							<!-- AI Tab -->
							@tabs.Content(tabs.ContentProps{Value: "ai", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div
									x-data="aiSettingsManager()"
									x-init="loadSettings()"
									class="space-y-6"
								>
									<!-- Provider Selection -->
									<div class="space-y-4">
										<div class="flex items-center justify-between">
											<h3 class="text-foreground font-medium">{ i18n.T(ctx, "AI Provider Configuration") }</h3>
										</div>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Configure your own AI provider and API keys. You are responsible for any costs incurred.") }</p>
									</div>
									<!-- Status Banner -->
									<template x-if="statusMessage">
										<div
											:class="statusType === 'error' ? 'bg-destructive/10 border-destructive/30 text-destructive' : 'bg-success/10 border-success/30 text-success'"
											class="p-3 rounded-xl border text-sm"
											x-text="statusMessage"
										></div>
									</template>
									<!-- Existing Providers -->
									<template x-if="settings.length > 0">
										<div class="space-y-3">
											<template x-for="s in settings" :key="s.id">
												<div
													class="flex items-center justify-between p-3 rounded-xl border border-border hover:bg-accent/50 transition-colors"
													:class="s.is_default ? 'ring-1 ring-primary/50' : ''"
												>
													<div class="flex items-center gap-3">
														<div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center">
															<span class="text-primary text-xs font-bold" x-text="s.provider.substring(0,2).toUpperCase()"></span>
														</div>
														<div>
															<div class="font-medium text-foreground flex items-center gap-2">
																<span x-text="providerName(s.provider)"></span>
																<template x-if="s.is_default">
																	<span class="text-[10px] bg-primary/20 text-primary rounded-full px-2 py-0.5">Default</span>
																</template>
															</div>
															<div class="text-xs text-muted-foreground">
																<span x-text="s.api_key_masked"></span>
															</div>
														</div>
													</div>
													<div class="flex items-center gap-1">
														<button
															x-show="!s.is_default"
															@click="setDefault(s.id)"
															class="text-xs px-2 py-1 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
															title="Set as Default"
														>Set Default</button>
														<button
															@click="editProvider(s)"
															class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
															title="Edit"
														>✎</button>
														<button
															@click="deleteProvider(s.id)"
															class="p-1.5 rounded-lg text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors"
															title="Delete"
														>✕</button>
													</div>
												</div>
											</template>
										</div>
									</template>
									<!-- Add / Edit Provider Form -->
									<div class="border-t border-border pt-4 space-y-4">
										<h4 class="text-foreground font-medium" x-text="editing ? 'Edit Provider' : 'Add Provider'"></h4>
										<!-- Provider Select -->
										<div class="flex flex-col gap-2">
											<label class="text-foreground text-sm">{ i18n.T(ctx, "Provider") }</label>
											<select
												x-model="form.provider"
												@change="onProviderChange()"
												class="w-full h-9 px-3 py-1 text-sm rounded-md border border-input bg-background shadow-xs"
											>
												<option value="">{ i18n.T(ctx, "Select a provider...") }</option>
												<template x-for="p in providers" :key="p.id">
													<option :value="p.id" x-text="p.name"></option>
												</template>
											</select>
										</div>
										<!-- API Key -->
										<div class="flex flex-col gap-2">
											<label class="text-foreground text-sm">{ i18n.T(ctx, "API Key") }</label>
											@input.Input(input.Props{
												Type:        input.TypePassword,
												Placeholder: i18n.T(ctx, "sk-...or paste your API key"),
												Attributes: templ.Attributes{
													"x-model": "form.api_key",
												},
											})
											<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "Your API key is encrypted and stored securely. You are responsible for usage costs.") }</p>
										</div>
										<!-- Save / Cancel -->
										<div class="flex items-center justify-end gap-2 pt-2">
											<button
												x-show="editing"
												@click="cancelEdit()"
												class="px-4 py-2 text-sm rounded-xl border border-border text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
											>{ i18n.T(ctx, "Cancel") }</button>
											@button.Button(button.Props{
												Type:  button.TypeButton,
												Class: "min-w-[120px]",
												Attributes: templ.Attributes{
													"@click":    "saveProvider()",
													":disabled": "saving || !form.provider || !form.api_key",
												},
											}) {
												<span x-show="!saving" x-text="editing ? 'Update Provider' : 'Add Provider'"></span>
												<span x-show="saving" class="flex items-center gap-2">
													<span class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-foreground"></span>
													{ i18n.T(ctx, "Saving...") }
												</span>
											}
										</div>
									</div>
									<!-- Chat Model Configuration (LLM) -->
									<div class="border-t border-border pt-6 space-y-4">
										<div class="space-y-1">
											<h3 class="text-foreground font-medium flex items-center gap-2">
												@icon.MessageSquare(icon.Props{Class: "size-4"})
												{ i18n.T(ctx, "Chat Model") }
											</h3>
											<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Choose which model to use for chatting with agents. Your configured providers are listed automatically.") }</p>
										</div>
										<!-- Chat Status Banner -->
										<template x-if="chatStatusMessage">
											<div
												:class="chatStatusType === 'error' ? 'bg-destructive/10 border-destructive/30 text-destructive' : 'bg-success/10 border-success/30 text-success'"
												class="p-3 rounded-xl border text-sm"
												x-text="chatStatusMessage"
											></div>
										</template>
										<!-- Current Chat Config Display -->
										<template x-if="currentChatConfig">
											<div class="flex items-center gap-3 p-3 rounded-xl border border-primary/20 bg-primary/5">
												<div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center">
													@icon.MessageSquare(icon.Props{Class: "size-4 text-primary"})
												</div>
												<div>
													<div class="font-medium text-foreground text-sm">
														<span x-text="currentChatConfig.model"></span>
													</div>
													<div class="text-xs text-muted-foreground">
														<span x-text="currentChatConfig.provider_name"></span>
													</div>
												</div>
											</div>
										</template>
										<!-- No providers warning -->
										<template x-if="chatProviders.length === 0 && settings.length > 0">
											<div class="p-3 rounded-xl border border-warning/30 bg-warning/10 text-warning text-sm">
												{ i18n.T(ctx, "No configured providers with chat models found. Configure a provider with an API key above to get started.") }
											</div>
										</template>
										<!-- Chat Provider -->
										<div class="flex flex-col gap-2" x-show="chatProviders.length > 0">
											<label class="text-foreground text-sm">{ i18n.T(ctx, "Provider") }</label>
											<select
												x-model="chatForm.provider"
												@change="onChatProviderChange()"
												class="w-full h-9 px-3 py-1 text-sm rounded-md border border-input bg-background shadow-xs"
											>
												<option value="">{ i18n.T(ctx, "Select a provider...") }</option>
												<template x-for="p in chatProviders" :key="p.id">
													<option :value="p.id" x-text="p.name"></option>
												</template>
											</select>
										</div>
										<!-- Chat Model -->
										<div class="flex flex-col gap-2" x-show="chatForm.provider">
											<label class="text-foreground text-sm">{ i18n.T(ctx, "Model") }</label>
											<select
												x-model="chatForm.model"
												class="w-full h-9 px-3 py-1 text-sm rounded-md border border-input bg-background shadow-xs"
											>
												<option value="">{ i18n.T(ctx, "Select a model...") }</option>
												<template x-for="m in chatCurrentModels" :key="m">
													<option :value="m" x-text="m"></option>
												</template>
											</select>
										</div>
										<!-- Advanced: Temperature & Max Tokens -->
										@collapsible.Collapsible(collapsible.Props{
											Attributes: templ.Attributes{
												"x-show": "chatForm.model",
											},
										}) {
											@collapsible.Trigger(collapsible.TriggerProps{
												Class: "cursor-pointer text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1 group",
											}) {
												@icon.ChevronRight(icon.Props{Class: "size-4 transition-transform group-data-[tui-collapsible-state=open]:rotate-90"})
												{ i18n.T(ctx, "Advanced Settings") }
											}
											@collapsible.Content() {
												<div class="pt-3 space-y-4">
													<div class="flex items-center justify-between gap-4">
														<div>
															<label class="text-foreground text-sm">{ i18n.T(ctx, "Temperature") }</label>
															<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "Controls randomness. Lower = more deterministic.") }</p>
														</div>
														<div class="w-24 shrink-0">
															@input.Input(input.Props{
																Type:  input.TypeNumber,
																Class: "text-center",
																Attributes: templ.Attributes{
																	"x-model.number": "chatForm.temperature",
																	"min":            "0",
																	"max":            "2",
																	"step":           "0.1",
																},
															})
														</div>
													</div>
													<div class="flex items-center justify-between gap-4">
														<div>
															<label class="text-foreground text-sm">{ i18n.T(ctx, "Max Tokens") }</label>
															<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "Maximum tokens in the response. 0 = provider default.") }</p>
														</div>
														<div class="w-24 shrink-0">
															@input.Input(input.Props{
																Type:  input.TypeNumber,
																Class: "text-center",
																Attributes: templ.Attributes{
																	"x-model.number": "chatForm.max_tokens",
																	"min":            "0",
																	"max":            "128000",
																},
															})
														</div>
													</div>
													<div class="flex items-center justify-between gap-4">
														<div>
															<label class="text-foreground text-sm">{ i18n.T(ctx, "Max Iterations") }</label>
															<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "Maximum tool-calling loops per request. 0 = engine default.") }</p>
														</div>
														<div class="w-24 shrink-0">
															@input.Input(input.Props{
																Type:  input.TypeNumber,
																Class: "text-center",
																Attributes: templ.Attributes{
																	"x-model.number": "chatForm.max_iterations",
																	"min":            "0",
																	"max":            "50",
																},
															})
														</div>
													</div>
												</div>
											}
										}
										<!-- Save Button -->
										<div class="flex items-center justify-end gap-2 pt-2" x-show="chatForm.provider && chatForm.model">
											<span x-show="chatSaved" x-transition class="text-xs text-success">&check; { i18n.T(ctx, "Saved") }</span>
											@button.Button(button.Props{
												Type:  button.TypeButton,
												Class: "min-w-[120px]",
												Attributes: templ.Attributes{
													"@click":    "saveChatCapability()",
													":disabled": "chatSaving",
												},
											}) {
												<span x-show="!chatSaving">{ i18n.T(ctx, "Save Chat Model") }</span>
												<span x-show="chatSaving" class="flex items-center gap-2">
													<span class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-foreground"></span>
													{ i18n.T(ctx, "Saving...") }
												</span>
											}
										</div>
									</div>
									<!-- Knowledge Graph Embedding -->
									if features.KnowledgeBase(ctx) {
										<div class="border-t border-border pt-6 space-y-4">
										<div class="space-y-2">
											<h3 class="text-foreground font-medium flex items-center gap-2">
												@icon.Network(icon.Props{Class: "size-4"})
												{ i18n.T(ctx, "Knowledge Graph Embedding") }
											</h3>
											<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Choose the embedding model for knowledge graph vector search. Your configured providers are listed automatically.") }</p>
										</div>
										<!-- Provider Status -->
										<template x-if="kgProviderStatus">
											<div class="grid gap-3 grid-cols-3">
												<div class="rounded-xl border p-3">
													<div class="flex items-center gap-2 mb-1">
														<span class="size-2 rounded-full" :class="kgProviderStatus?.provider?.status === 'available' ? 'bg-success' : 'bg-destructive'"></span>
														<span class="text-xs font-medium">{ i18n.T(ctx, "LLM") }</span>
													</div>
													<p class="text-xs font-mono truncate" x-text="kgProviderStatus?.provider?.model || 'default'"></p>
												</div>
												<div class="rounded-xl border p-3">
													<div class="flex items-center gap-2 mb-1">
														<span class="size-2 rounded-full" :class="kgProviderStatus?.embedding?.status === 'available' ? 'bg-success' : 'bg-destructive'"></span>
														<span class="text-xs font-medium">{ i18n.T(ctx, "Embedding") }</span>
													</div>
													<p class="text-xs font-mono truncate" x-text="(kgProviderStatus?.embedding?.model || 'default') + ' (' + (kgProviderStatus?.embedding?.dimension || '?') + 'd)'"></p>
												</div>
												<div class="rounded-xl border p-3">
													<div class="flex items-center gap-2 mb-1">
														<span class="size-2 rounded-full" :class="kgProviderStatus?.storage?.dimension_mismatch ? 'bg-warning' : 'bg-success'"></span>
														<span class="text-xs font-medium">{ i18n.T(ctx, "Storage") }</span>
													</div>
													<p class="text-xs font-mono truncate" x-text="(kgProviderStatus?.storage?.type || '-') + ' (' + (kgProviderStatus?.storage?.dimension || '?') + 'd)'"></p>
													<p x-show="kgProviderStatus?.storage?.dimension_mismatch" class="text-[10px] text-warning mt-1">⚠ { i18n.T(ctx, "Mismatch") }</p>
												</div>
											</div>
										</template>
										<!-- Embedding Provider -->
										<div class="flex flex-col gap-2">
											<label class="text-foreground text-sm">{ i18n.T(ctx, "Embedding Provider") }</label>
											<select
												x-model="kgEmbProvider"
												@change="onKgEmbProviderChange()"
												class="w-full h-9 px-3 py-1 text-sm rounded-md border border-input bg-background shadow-xs"
											>
												<option value="">{ i18n.T(ctx, "Select a provider...") }</option>
												<template x-for="p in kgEmbProviders" :key="p.id">
													<option :value="p.id" x-text="p.name"></option>
												</template>
											</select>
										</div>
										<!-- Embedding Model -->
										<div class="flex flex-col gap-2" x-show="kgEmbProvider">
											<label class="text-foreground text-sm">{ i18n.T(ctx, "Embedding Model") }</label>
											<select
												x-model="kgEmbModel"
												class="w-full h-9 px-3 py-1 text-sm rounded-md border border-input bg-background shadow-xs"
											>
												<option value="">{ i18n.T(ctx, "Select a model...") }</option>
												<template x-for="m in kgCurrentEmbModels" :key="m">
													<option :value="m" x-text="m"></option>
												</template>
											</select>
										</div>
										<!-- Save -->
										<div class="flex items-center justify-end gap-2 pt-2" x-show="kgEmbProvider && kgEmbModel">
											<span x-show="kgSaved" x-transition class="text-xs text-success">✓ { i18n.T(ctx, "Saved") }</span>
											<span x-show="kgError" x-transition class="text-xs text-destructive" x-text="kgError"></span>
											@button.Button(button.Props{
												Type:  button.TypeButton,
												Class: "min-w-[120px]",
												Attributes: templ.Attributes{
													"@click":    "saveKgEmbedding()",
													":disabled": "kgSaving || !kgEmbModel",
												},
											}) {
												<span x-show="!kgSaving">{ i18n.T(ctx, "Save Embedding Settings") }</span>
												<span x-show="kgSaving" class="flex items-center gap-2">
													<span class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-foreground"></span>
													{ i18n.T(ctx, "Saving...") }
												</span>
											}
										</div>
										<template x-if="kgLoading">
											<div class="flex items-center gap-2 text-xs text-muted-foreground">
												<span class="animate-spin rounded-full h-3 w-3 border-b-2 border-primary"></span>
												{ i18n.T(ctx, "Loading...") }
											</div>
										</template>
									</div>
									}
								</div>
							}
							<!-- Personalization Tab -->
							@tabs.Content(tabs.ContentProps{Value: "personalization", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="space-y-4">
									<div class="flex flex-col gap-2">
										<label class="text-foreground font-medium">{ i18n.T(ctx, "Work Style") }</label>
										@selectbox.SelectBox(selectbox.Props{Class: "w-full"}) {
											@selectbox.Trigger(selectbox.TriggerProps{
												Attributes: templ.Attributes{
													"x-model": "profile.learning_style",
												},
											}) {
												<span x-text={ "profile.learning_style || '" + i18n.T(ctx, "Select a style...") + "'" }>{ i18n.T(ctx, "Select a style...") }</span>
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
												@selectbox.Item(selectbox.ItemProps{Value: "Visual"}) {
													{ i18n.T(ctx, "Visual") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Auditory"}) {
													{ i18n.T(ctx, "Auditory") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Read/Write"}) {
													{ i18n.T(ctx, "Read/Write") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Kinesthetic"}) {
													{ i18n.T(ctx, "Kinesthetic") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "Multimodal"}) {
													{ i18n.T(ctx, "Multimodal") }
												}
											}
										}
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "How you prefer to take in and process information.") }</p>
									</div>
									<div class="flex flex-col gap-2 pt-2">
										<label class="text-foreground font-medium">{ i18n.T(ctx, "Struggles") }</label>
										<textarea
											x-model="profile.struggles"
											placeholder={ i18n.T(ctx, "e.g. Algebra, focus, time management...") }
											class="w-full h-20 bg-card border border-border rounded-xl p-3 outline-none focus:ring-1 focus:ring-primary resize-none"
										></textarea>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Topics or skills you find challenging (comma separated).") }</p>
									</div>
									<div class="flex flex-col gap-2 pt-2">
										<label class="text-foreground font-medium">{ i18n.T(ctx, "Strengths") }</label>
										<textarea
											x-model="profile.strengths"
											placeholder={ i18n.T(ctx, "e.g. Critical thinking, geometry, writing...") }
											class="w-full h-20 bg-card border border-border rounded-xl p-3 outline-none focus:ring-1 focus:ring-primary resize-none"
										></textarea>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Areas where you excel or feel confident (comma separated).") }</p>
									</div>
									<div class="flex flex-col gap-2 pt-2">
										<label class="text-foreground font-medium">{ i18n.T(ctx, "Professional/Personal Goals") }</label>
										<textarea
											x-model="profile.goals"
											placeholder={ i18n.T(ctx, "e.g. Master system design, improve coding skills...") }
											class="w-full h-24 bg-card border border-border rounded-xl p-3 outline-none focus:ring-1 focus:ring-primary resize-none"
										></textarea>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "What you hope to achieve with your AI assistant.") }</p>
									</div>
									<!-- Explict Save Button -->
									<div class="flex items-center justify-end pt-2">
										@button.Button(button.Props{
											Type:  button.TypeButton,
											Class: "min-w-[120px]",
											Attributes: templ.Attributes{
												"@click":    "updateProfile()",
												":disabled": "profileLoading",
											},
										}) {
											<span x-show="!profileLoading">{ i18n.T(ctx, "Save Changes") }</span>
											<span x-show="profileLoading" class="flex items-center gap-2">
												<span class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-foreground"></span>
												{ i18n.T(ctx, "Saving...") }
											</span>
										}
									</div>
								</div>
							}
							<!-- Speech Tab -->
							@tabs.Content(tabs.ContentProps{Value: "speech", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div class="space-y-6">
									<div class="flex items-center justify-between gap-4">
										<div class="space-y-0.5">
											<div class="text-foreground font-medium">{ i18n.T(ctx, "Text-to-Speech") }</div>
											<p class="text-xs text-muted-foreground leading-tight">{ i18n.T(ctx, "Enable reading assistant messages aloud.") }</p>
										</div>
										@switchcomp.Switch(switchcomp.Props{
											Name: "textToSpeech",
											Attributes: templ.Attributes{
												"x-model":    "preferences.textToSpeechEnabled",
												"aria-label": i18n.T(ctx, "Enable Text-to-Speech"),
											},
										})
									</div>
									<div class="flex flex-col gap-2 pt-4 border-t border-border">
										<div class="text-foreground font-medium">{ i18n.T(ctx, "Voice Engine") }</div>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Choose how AI-generated speech is produced.") }</p>
										@selectbox.SelectBox(selectbox.Props{Class: "w-full"}) {
											@selectbox.Trigger(selectbox.TriggerProps{}) {
												<span>{ i18n.T(ctx, "Default Browser Voice") }</span>
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
												@selectbox.Item(selectbox.ItemProps{Value: "default", Selected: true}) {
													{ i18n.T(ctx, "Default Browser Voice") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "premium"}) {
													{ i18n.T(ctx, "Premium AI Voice (BETA)") }
												}
											}
										}
									</div>
									<!-- Hint to configure voice in Plugins tab -->
									<div class="pt-4 border-t border-border">
										<p class="text-xs text-muted-foreground">
											{ i18n.T(ctx, "To configure the AI voice model and voice, go to") }
											<button
												type="button"
												@click="showSettings = false; $nextTick(() => { $dispatch('open-tools-dialog'); })"
												class="text-primary hover:underline font-medium"
											>{ i18n.T(ctx, "Plugin Settings") }</button>.
										</p>
									</div>
								</div>
							}
							<!-- Data Tab -->
							@tabs.Content(tabs.ContentProps{Value: "data", Class: "space-y-4 animate-in fade-in duration-200"}) {
								<div
									class="flex items-center justify-between p-3 rounded-xl border border-destructive/20 bg-destructive/5 hover:bg-destructive/10 transition-colors group cursor-pointer"
									@click={ fmt.Sprintf("if(confirm('%s')) { sessions = []; showSettings = false; }", i18n.T(ctx, "Are you sure you want to clear all conversations?")) }
								>
									<div class="space-y-0.5">
										<div class="text-destructive font-medium">{ i18n.T(ctx, "Clear all conversations") }</div>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Permanently delete all thread history.") }</p>
									</div>
									@icon.Trash2(icon.Props{Class: "size-4 text-destructive"})
								</div>
								<div class="flex items-center justify-between p-3 rounded-xl border border-border hover:bg-accent transition-colors group cursor-pointer">
									<div class="space-y-0.5">
										<div class="text-foreground font-medium">{ i18n.T(ctx, "Export all data") }</div>
										<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Download a copy of your chat history.") }</p>
									</div>
									@icon.Download(icon.Props{Class: "size-4 text-muted-foreground group-hover:text-foreground"})
								</div>
							}

							<!-- Account Tab -->
							@tabs.Content(tabs.ContentProps{Value: "account", Class: "space-y-6 animate-in fade-in duration-200"}) {
								<div
									x-data="{
										acct: null,
										acctLoading: true,
										acctError: '',
										billing: null,
										billingLoading: true,
										cancelConfirm: false,
										cancelling: false,
										cancelError: '',
										cancelReason: '',
										reactivating: false,
										reactivateError: '',
										formatDate(iso) {
											if (!iso) return '—';
											try { return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); }
											catch(e) { return iso; }
										},
										cardIcon(brand) {
											const b = (brand || '').toLowerCase();
											if (b === 'visa') return '💳 Visa';
											if (b === 'mastercard') return '💳 Mastercard';
											if (b === 'amex' || b === 'american_express') return '💳 Amex';
											if (b === 'discover') return '💳 Discover';
											return '💳 Card';
										}
									}"
									x-init="
										fetch('/api/me').then(r => { if (!r.ok) throw new Error('Failed'); return r.json(); })
										.then(u => { acct = u; acctLoading = false; })
										.catch(e => { acctError = e.message; acctLoading = false; });
										fetch('/api/billing/status', { credentials: 'same-origin' })
										.then(r => r.ok ? r.json() : { status: 'none' })
										.then(d => { billing = d; billingLoading = false; })
										.catch(() => { billing = { status: 'none' }; billingLoading = false; });
									"
									class="space-y-6"
								>
									<!-- Loading state -->
									<template x-if="acctLoading">
										<div class="flex items-center justify-center py-8">
											<span class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></span>
										</div>
									</template>
									<!-- Error state -->
									<template x-if="!acctLoading && acctError">
										@alert.Alert(alert.Props{
											Variant: alert.VariantDestructive,
											Class:   "rounded-xl",
										}) {
											@icon.CircleAlert(icon.Props{Class: "size-4"})
											@alert.Description(alert.DescriptionProps{}) {
												{ i18n.T(ctx, "Failed to load account info.") }
											}
										}
									</template>
									<!-- Loaded state -->
									<template x-if="!acctLoading && acct">
										<div class="space-y-6">
											<!-- Profile section -->
											<div class="flex items-center gap-4">
												<template x-if="acct.picture">
													<img :src="acct.picture" :alt="acct.first_name" class="size-12 rounded-full ring-2 ring-border" referrerpolicy="no-referrer"/>
												</template>
												<template x-if="!acct.picture">
													<div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg ring-2 ring-border">
														<span x-text="(acct.email || '?')[0].toUpperCase()"></span>
													</div>
												</template>
												<div class="min-w-0">
													<div class="text-foreground font-medium truncate" x-text="[acct.first_name, acct.last_name].filter(Boolean).join(' ') || acct.email"></div>
													<div class="text-xs text-muted-foreground truncate" x-text="acct.email"></div>
													<div class="flex items-center gap-1.5 mt-1">
														<span class="inline-flex items-center rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success ring-1 ring-inset ring-success/20">
															{ i18n.T(ctx, "Google Verified") }
														</span>
														<span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-medium text-primary ring-1 ring-inset ring-primary/20" x-text="acct.role"></span>
													</div>
												</div>
											</div>
											<p class="text-[11px] text-muted-foreground">
												{ i18n.T(ctx, "Your profile is managed by Google.") }
												<a href="https://myaccount.google.com/personal-info" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
													{ i18n.T(ctx, "Edit on Google") } ↗
												</a>
											</p>
											<!-- ═══════════════════════════════════ -->
											<!-- Subscription & Billing section    -->
											<!-- ═══════════════════════════════════ -->
											<div class="border-t border-border pt-4 space-y-4">
												<div class="flex items-center justify-between">
													<div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Plan & Billing") }</div>
													<template x-if="billing && billing.status === 'active'">
														<span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2.5 py-0.5 text-[10px] font-semibold text-success ring-1 ring-inset ring-success/20">
															<svg class="size-2.5 fill-current" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"></circle></svg>
															{ i18n.T(ctx, "Active") }
														</span>
													</template>
													<template x-if="billing && billing.status === 'cancelled'">
														<span class="inline-flex items-center gap-1 rounded-full bg-warning/10 px-2.5 py-0.5 text-[10px] font-semibold text-warning ring-1 ring-inset ring-warning/20">
															<svg class="size-2.5 fill-current" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"></circle></svg>
															{ i18n.T(ctx, "Cancelled") }
														</span>
													</template>
													<template x-if="billing && billing.status === 'pending'">
														<span class="inline-flex items-center gap-1 rounded-full bg-warning/10 px-2.5 py-0.5 text-[10px] font-semibold text-warning ring-1 ring-inset ring-warning/20">
															<span class="animate-spin rounded-full h-2 w-2 border-b border-current"></span>
															{ i18n.T(ctx, "Processing") }
														</span>
													</template>
												</div>
												<!-- Loading -->
												<template x-if="billingLoading">
													<div class="flex items-center justify-center py-4">
														<span class="animate-spin rounded-full h-5 w-5 border-b-2 border-primary"></span>
													</div>
												</template>
												<!-- ─────── ACTIVE subscription ─────── -->
												<template x-if="!billingLoading && billing && billing.status === 'active'">
													<div class="space-y-4">
														<!-- Plan card -->
														<div class="rounded-xl border border-success/20 bg-linear-to-br from-success/5 to-transparent p-4">
															<div class="flex items-center justify-between mb-3">
																<div class="flex items-center gap-3">
																	<div class="flex items-center justify-center size-10 rounded-xl bg-success/10 ring-1 ring-success/20">
																		@icon.Crown(icon.Props{Class: "size-5 text-success"})
																	</div>
																	<div>
																		<div class="text-sm font-semibold text-foreground" x-text="billing.planName || 'Full Access'"></div>
																		<div class="text-xs text-muted-foreground">
																			<span x-text="billing.planAmount || '$5.00'"></span>
																			<span class="text-muted-foreground/60">/</span>
																			<span x-text="billing.planInterval || 'month'"></span>
																		</div>
																	</div>
																</div>
																@icon.BadgeCheck(icon.Props{Class: "size-5 text-success"})
															</div>
															<!-- Billing details grid -->
															<div class="grid grid-cols-2 gap-2.5">
																<div class="rounded-lg bg-background/80 border border-border/40 p-2.5">
																	<div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-0.5">{ i18n.T(ctx, "Member since") }</div>
																	<div class="text-xs font-medium text-foreground" x-text="formatDate(billing.paidAt)"></div>
																</div>
																<div class="rounded-lg bg-background/80 border border-border/40 p-2.5">
																	<div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-0.5">{ i18n.T(ctx, "Next billing") }</div>
																	<div class="text-xs font-medium text-foreground" x-text="formatDate(billing.nextBillingAt)"></div>
																</div>
															</div>
														</div>
														<!-- Payment method card -->
														<template x-if="billing.cardLast4">
															<div class="rounded-xl border border-border p-3">
																<div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-2">{ i18n.T(ctx, "Payment method") }</div>
																<div class="flex items-center justify-between">
																	<div class="flex items-center gap-2.5">
																		@icon.CreditCard(icon.Props{Class: "size-4 text-muted-foreground"})
																		<div>
																			<div class="text-sm font-medium text-foreground" x-text="cardIcon(billing.cardBrand) + ' •••• ' + billing.cardLast4"></div>
																		</div>
																	</div>
																	<div class="flex items-center gap-1 text-[10px] text-muted-foreground">
																		@icon.ShieldCheck(icon.Props{Class: "size-3 text-success"})
																		<span>{ i18n.T(ctx, "Secure") }</span>
																	</div>
																</div>
															</div>
														</template>
														<!-- Manage subscription -->
														<div class="pt-1">
															<template x-if="!cancelConfirm">
																<button
																	type="button"
																	@click="cancelConfirm = true"
																	class="text-xs text-muted-foreground hover:text-destructive transition-colors underline underline-offset-2 decoration-dashed"
																>
																	{ i18n.T(ctx, "Cancel subscription") }
																</button>
															</template>
															<!-- Cancel confirmation inline panel -->
															<template x-if="cancelConfirm">
																<div class="rounded-xl border border-destructive/20 bg-destructive/5 p-4 space-y-3 animate-in fade-in slide-in-from-top-1 duration-200">
																	<div class="flex items-start gap-2.5">
																		@icon.Clock(icon.Props{Class: "size-4 text-destructive shrink-0 mt-0.5"})
																		<div>
																			<p class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Cancel your subscription?") }</p>
																			<p class="text-xs text-muted-foreground mt-1">
																				{ i18n.T(ctx, "You'll keep full access until the end of your current billing period. After that, your account returns to the free tier.") }
																			</p>
																		</div>
																	</div>
																	<!-- Optional cancel reason -->
																	<div class="space-y-1">
																		<label class="text-[10px] text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Reason (optional)") }</label>
																		@selectbox.SelectBox() {
																			@selectbox.Trigger(selectbox.TriggerProps{
																				Class: "h-8 text-xs",
																				Attributes: templ.Attributes{
																					"x-model": "cancelReason",
																				},
																			}) {
																				@selectbox.Value(selectbox.ValueProps{
																					Placeholder: i18n.T(ctx, "Select a reason…"),
																				})
																			}
																			@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
																				@selectbox.Item(selectbox.ItemProps{Value: "too_expensive"}) {
																					{ i18n.T(ctx, "Too expensive") }
																				}
																				@selectbox.Item(selectbox.ItemProps{Value: "not_using"}) {
																					{ i18n.T(ctx, "Not using it enough") }
																				}
																				@selectbox.Item(selectbox.ItemProps{Value: "missing_features"}) {
																					{ i18n.T(ctx, "Missing features I need") }
																				}
																				@selectbox.Item(selectbox.ItemProps{Value: "switching"}) {
																					{ i18n.T(ctx, "Switching to another service") }
																				}
																				@selectbox.Item(selectbox.ItemProps{Value: "temporary"}) {
																					{ i18n.T(ctx, "Temporary — I'll be back") }
																				}
																				@selectbox.Item(selectbox.ItemProps{Value: "other"}) {
																					{ i18n.T(ctx, "Other") }
																				}
																			}
																		}
																	</div>
																	<template x-if="cancelError">
																		<p class="text-xs text-destructive" x-text="cancelError"></p>
																	</template>
																	<div class="flex items-center gap-2">
																		<button
																			type="button"
																			:disabled="cancelling"
																			@click="
																				cancelling = true; cancelError = '';
																				fetch('/api/billing/cancel', {
																					method: 'POST',
																					headers: { 'Content-Type': 'application/json' },
																					credentials: 'same-origin',
																					body: JSON.stringify({ reason: cancelReason })
																				})
																				.then(r => r.json().then(d => ({ ok: r.ok, data: d })))
																				.then(({ ok, data }) => {
																					if (ok) {
																						billing = { ...billing, status: 'cancelled', cancelsOn: data.cancelsOn, cancelledAt: new Date().toISOString() };
																						cancelConfirm = false;
																						cancelReason = '';
																					} else {
																						cancelError = data.error || 'Failed to cancel. Please try again.';
																					}
																					cancelling = false;
																				})
																				.catch(() => { cancelError = 'Something went wrong.'; cancelling = false; })
																			"
																			class="inline-flex items-center justify-center gap-1.5 rounded-md text-xs font-medium h-8 px-3 bg-destructive text-destructive-foreground hover:bg-destructive/90 transition-colors disabled:opacity-50"
																		>
																			<template x-if="cancelling">
																				<span class="animate-spin rounded-full h-3 w-3 border-b-2 border-destructive-foreground"></span>
																			</template>
																			{ i18n.T(ctx, "Yes, cancel") }
																		</button>
																		<button
																			type="button"
																			@click="cancelConfirm = false; cancelError = ''; cancelReason = ''"
																			class="inline-flex items-center justify-center rounded-md text-xs font-medium h-8 px-3 border border-border hover:bg-accent transition-colors"
																		>
																			{ i18n.T(ctx, "Keep subscription") }
																		</button>
																	</div>
																</div>
															</template>
														</div>
													</div>
												</template>
												<!-- ─────── CANCELLED subscription ─────── -->
												<template x-if="!billingLoading && billing && billing.status === 'cancelled'">
													<div class="space-y-4">
														<div class="rounded-xl border border-warning/20 bg-linear-to-br from-warning/5 to-transparent p-4">
															<div class="flex items-center justify-between mb-3">
																<div class="flex items-center gap-3">
																	<div class="flex items-center justify-center size-10 rounded-xl bg-warning/10 ring-1 ring-warning/20">
																		@icon.Clock(icon.Props{Class: "size-5 text-warning"})
																	</div>
																	<div>
																		<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Subscription Cancelled") }</div>
																		<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "Your access continues until the end of your billing period") }</div>
																	</div>
																</div>
															</div>
															<div class="grid grid-cols-2 gap-2.5 mb-3">
																<div class="rounded-lg bg-background/80 border border-border/40 p-2.5">
																	<div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-0.5">{ i18n.T(ctx, "Cancelled on") }</div>
																	<div class="text-xs font-medium text-foreground" x-text="formatDate(billing.cancelledAt)"></div>
																</div>
																<div class="rounded-lg bg-background/80 border border-border/40 p-2.5">
																	<div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-0.5">{ i18n.T(ctx, "Access until") }</div>
																	<div class="text-xs font-medium text-foreground" x-text="formatDate(billing.cancelsOn)"></div>
																</div>
															</div>
															<!-- Days remaining countdown -->
															<template x-if="billing.daysRemaining > 0">
																<div class="flex items-center gap-2 rounded-lg bg-warning/10 border border-warning/20 p-2 text-xs">
																	@icon.Clock(icon.Props{Class: "size-3.5 text-warning shrink-0"})
																	<span class="text-warning">
																		<span x-text="billing.daysRemaining"></span>
																		<span>{ i18n.T(ctx, "days of access remaining") }</span>
																	</span>
																</div>
															</template>
														</div>
														<!-- Reactivation CTA -->
														<div class="rounded-xl border border-primary/20 bg-primary/5 p-4 space-y-3">
															<div class="flex items-start gap-2.5">
																@icon.Sparkles(icon.Props{Class: "size-4 text-primary shrink-0 mt-0.5"})
																<div>
																	<p class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Changed your mind?") }</p>
																	<p class="text-xs text-muted-foreground mt-0.5">
																		{ i18n.T(ctx, "Reactivate before your billing period ends to keep uninterrupted access.") }
																	</p>
																</div>
															</div>
															<template x-if="reactivateError">
																<p class="text-xs text-destructive" x-text="reactivateError"></p>
															</template>
															<button
																type="button"
																:disabled="reactivating"
																@click="
																	reactivating = true; reactivateError = '';
																	fetch('/api/billing/reactivate', {
																		method: 'POST',
																		headers: { 'Content-Type': 'application/json' },
																		credentials: 'same-origin'
																	})
																	.then(r => r.json().then(d => ({ ok: r.ok, data: d })))
																	.then(({ ok, data }) => {
																		if (ok) {
																			billing = { ...billing, status: 'active', cancelledAt: null, cancelsOn: null, daysRemaining: null, planName: 'Full Access', planAmount: '$5.00', planInterval: 'month' };
																		} else {
																			if (data.code === 'billing_period_ended') {
																				reactivateError = 'Your billing period has ended. Please subscribe again.';
																				billing = { ...billing, status: 'none' };
																			} else {
																				reactivateError = data.error || 'Failed to reactivate.';
																			}
																		}
																		reactivating = false;
																	})
																	.catch(() => { reactivateError = 'Something went wrong.'; reactivating = false; })
																"
																class="w-full inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:opacity-50"
															>
																<template x-if="reactivating">
																	<span class="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-primary-foreground"></span>
																</template>
																<template x-if="!reactivating">
																	@icon.RefreshCw(icon.Props{Class: "size-4"})
																</template>
																{ i18n.T(ctx, "Reactivate Subscription") }
															</button>
														</div>
													</div>
												</template>
												<!-- ─────── PENDING payment ─────── -->
												<template x-if="!billingLoading && billing && billing.status === 'pending'">
													<div class="rounded-xl border border-warning/20 bg-warning/5 p-4 space-y-3">
														<div class="flex items-center gap-3">
															<div class="flex items-center justify-center size-10 rounded-xl bg-warning/10 ring-1 ring-warning/20">
																<span class="animate-spin rounded-full h-5 w-5 border-b-2 border-warning"></span>
															</div>
															<div>
																<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Payment Processing") }</div>
																<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "Your payment is being processed. This usually takes a few seconds.") }</div>
															</div>
														</div>
														<p class="text-[11px] text-muted-foreground">
															{ i18n.T(ctx, "If this takes more than a minute, try refreshing the page or contact support.") }
														</p>
													</div>
												</template>
												<!-- ─────── NO subscription (Free tier) ─────── -->
												<template x-if="!billingLoading && billing && billing.status === 'none'">
													<div class="space-y-4">
														<div class="rounded-xl border border-border p-4">
															<div class="flex items-center justify-between mb-3">
																<div class="flex items-center gap-3">
																	<div class="flex items-center justify-center size-10 rounded-xl bg-muted ring-1 ring-border">
																		@icon.Crown(icon.Props{Class: "size-5 text-muted-foreground"})
																	</div>
																	<div>
																		<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "Free Tier") }</div>
																		<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "Limited access") }</div>
																	</div>
																</div>
																<span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-medium text-muted-foreground ring-1 ring-inset ring-border">
																	{ i18n.T(ctx, "Free") }
																</span>
															</div>
															<!-- Upgrade CTA -->
															<div class="rounded-lg bg-primary/5 border border-primary/20 p-3 space-y-2.5">
																<div class="flex items-center gap-2">
																	@icon.Sparkles(icon.Props{Class: "size-4 text-primary"})
																	<span class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Upgrade to Full Access") }</span>
																</div>
																<p class="text-xs text-muted-foreground ps-6">
																	{ i18n.T(ctx, "Unlimited conversations, all AI models, priority support, and more for just $5/month.") }
																</p>
																if features.Demo(ctx) {
																	<button
																		type="button"
																		disabled
																		title={ i18n.T(ctx, "Payments are disabled in the demo") }
																		class="w-full inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium h-9 px-4 bg-primary text-primary-foreground opacity-50 cursor-not-allowed"
																	>
																		@icon.Sparkles(icon.Props{Class: "size-4"})
																		{ i18n.T(ctx, "Subscribe — $5/month") }
																	</button>
																} else {
																	<button
																		type="button"
																		@click="$dispatch('open-pricing-dialog')"
																		class="w-full inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
																	>
																		@icon.Sparkles(icon.Props{Class: "size-4"})
																		{ i18n.T(ctx, "Subscribe — $5/month") }
																	</button>
																}
															</div>
															<p class="text-[10px] text-muted-foreground text-center mt-2 flex items-center justify-center gap-1">
																@icon.ShieldCheck(icon.Props{Class: "size-3"})
																{ i18n.T(ctx, "Secure payment via Stripe · Cancel anytime") }
															</p>
														</div>
													</div>
												</template>
											</div>
											<!-- Security section -->
											<div class="border-t border-border pt-4 space-y-3">
												<div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "Security") }</div>
												<div class="flex items-center justify-between p-3 rounded-xl border border-border">
													<div class="flex items-center gap-3">
														<svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
															<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
															<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
															<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
														</svg>
														<div>
															<div class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Google Sign-In") }</div>
															<div class="text-[11px] text-muted-foreground" x-text="acct.email"></div>
														</div>
													</div>
													<span class="inline-flex items-center rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success ring-1 ring-inset ring-success/20">
														{ i18n.T(ctx, "Connected") }
													</span>
												</div>
												<a href="/auth/logout" class="flex items-center justify-between p-3 rounded-xl border border-border hover:bg-accent transition-colors group">
													<div class="flex items-center gap-3">
														@icon.LogOut(icon.Props{Class: "size-4 text-muted-foreground group-hover:text-foreground"})
														<div>
															<div class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Sign Out") }</div>
															<div class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "End your current session") }</div>
														</div>
													</div>
													@icon.ChevronRight(icon.Props{Class: "size-4 text-muted-foreground group-hover:text-foreground"})
												</a>
											</div>
											<!-- Danger zone -->
											<div class="border-t border-destructive/20 pt-4">
												<button
													disabled
													class="w-full text-start p-3 rounded-xl border border-destructive/20 bg-destructive/5 opacity-60 cursor-not-allowed flex items-center justify-between"
												>
													<div>
														<div class="text-sm font-medium text-destructive">{ i18n.T(ctx, "Delete Account") }</div>
														<div class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "Permanently delete your account and all data.") }</div>
													</div>
													@icon.UserX(icon.Props{Class: "size-4 text-destructive"})
												</button>
											</div>
										</div>
									</template>
								</div>
							}
						</div>
					}
				</div>
			</div>
		}
	</div>
	@profileDialog()
	@pricingDialog()
	@checkoutDialog()
}
