package nav

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/ui/i18n"
	"aicompass/frontend/components/icon"
)

// pricingDialog shows a modal with the single $5 activation offer.
// Clicking "Activate Now" closes this dialog and dispatches
// open-checkout-dialog which opens the Stripe Elements payment modal.
templ pricingDialog() {
	<div
		x-data={ activationAlpineData(ctx) }
		@open-pricing-dialog.window="checkAndOpen()"
	>
		<!-- Backdrop -->
		<div
			class="fixed inset-0 z-[60] bg-black/30 dark:bg-black/60 transition-opacity"
			x-show="open"
			x-transition:enter="ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			style="display: none;"
			aria-hidden="true"
		></div>
		<!-- Modal Container -->
		<div
			class="fixed inset-0 z-[60] flex items-center justify-center p-4"
			x-show="open"
			style="display: none;"
			@click.self="open = false"
		>
			<div
				class="relative w-full max-w-md max-h-[90vh] bg-background rounded-lg shadow-lg flex flex-col overflow-hidden border border-border"
				x-show="open"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@keydown.escape.window="open = false"
			>
				<!-- Header -->
				<div class="flex items-center justify-between p-6 pb-4 border-b border-border">
					<div class="space-y-1">
						<h2 class="text-lg font-semibold leading-none tracking-tight">{ i18n.T(ctx, "Activate Your Account") }</h2>
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "Unlock the full potential of your AI companion") }</p>
					</div>
					<button
						type="button"
						class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
						@click="open = false"
					>
						@icon.X(icon.Props{Class: "size-4"})
						<span class="sr-only">Close</span>
					</button>
				</div>
				<!-- Body -->
				<div class="flex-1 overflow-auto p-6 space-y-6">
					<!-- Checking spinner -->
					<template x-if="checking">
						<div class="flex items-center justify-center py-8">
							<span class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></span>
						</div>
					</template>
					<!-- Already activated state -->
					<template x-if="!checking && alreadyActive">
						<div class="space-y-4">
							<div class="rounded-lg border-2 border-success/30 bg-success/5 p-5 space-y-4 text-center">
								<div class="flex items-center justify-center">
									<div class="size-14 rounded-full bg-success/10 flex items-center justify-center">
										@icon.BadgeCheck(icon.Props{Class: "size-8 text-success"})
									</div>
								</div>
								<h3 class="text-lg font-bold text-foreground">{ i18n.T(ctx, "Account Already Activated") }</h3>
								<p class="text-sm text-muted-foreground">
									{ i18n.T(ctx, "You already have full access to all features. No further payment is needed.") }
								</p>
							</div>
						</div>
					</template>
					<!-- Normal plan card -->
					<template x-if="!checking && !alreadyActive">
						<div class="space-y-6">
							<div class="rounded-lg border-2 border-primary p-5 space-y-4">
								<h3 class="text-lg font-bold text-foreground" x-text="label"></h3>
								<p class="text-xs text-muted-foreground" x-text="description"></p>
								<div>
									<span class="text-3xl font-bold tracking-tight" x-text="price"></span>
									<span class="text-sm text-muted-foreground ms-1" x-text="period"></span>
								</div>
								<ul class="space-y-2">
									<template x-for="feature in features" :key="feature">
										<li class="flex items-start gap-2 text-sm">
											<svg class="size-4 text-primary shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
											<span x-text="feature"></span>
										</li>
									</template>
								</ul>
								<!-- Activate button -->
								<button
									type="button"
									@click="activate()"
									class="w-full inline-flex items-center justify-center rounded-md text-sm font-medium h-10 px-4 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
								>
									{ i18n.T(ctx, "Activate Now") }
								</button>
							</div>
							<p class="text-xs text-muted-foreground text-center">
								{ i18n.T(ctx, "Secure payment powered by Stripe. Your card details never touch our servers.") }
							</p>
						</div>
					</template>
				</div>
				<!-- Footer -->
				<div class="p-4 border-t border-border flex justify-end bg-background">
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantOutline,
						Attributes: templ.Attributes{
							"@click": "open = false",
						},
					}) {
						{ i18n.T(ctx, "Close") }
					}
				</div>
			</div>
		</div>
	</div>
}
