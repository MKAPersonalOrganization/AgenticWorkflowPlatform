package nav

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/components/label"
	"aicompass/frontend/components/selectbox"
	"aicompass/frontend/components/skeleton"
	"aicompass/frontend/components/textarea"
	"aicompass/frontend/ui/i18n"
)

// profileDialog renders the "Personalized Profile" modal. Opened by
// dispatching `open-profile-dialog` on `window` — the handler both
// triggers load() (fetches /api/profile once per session) and opens
// the templui dialog via its imperative API.
templ profileDialog() {
	<div
		x-data="{
			loading: false,
			saving: false,
			loaded: false,
			profile: {
				learning_style: '',
				struggles: '',
				strengths: '',
				goals: ''
			},
			load() {
				if (window.tui && window.tui.dialog) {
					window.tui.dialog.open('profile-dialog');
				}
				if (this.loaded) return;
				this.loading = true;
				fetch('/api/profile')
					.then(r => {
						if (!r.ok) throw new Error('Failed to load');
						return r.json();
					})
					.then(d => {
						this.profile.learning_style = d.learning_style || '';
						this.profile.struggles = (d.struggles || []).join(', ');
						this.profile.strengths = (d.strengths || []).join(', ');
						this.profile.goals = d.goals || '';
						this.loading = false;
						this.loaded = true;
					})
					.catch(e => {
						this.loading = false;
					});
			},
			save() {
				this.saving = true;
				fetch('/api/profile', {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(this.profile)
				})
				.then(r => {
					if (!r.ok) throw new Error('Failed to save');
					this.saving = false;
					if (window.tui && window.tui.dialog) {
						window.tui.dialog.close('profile-dialog');
					}
				})
				.catch(e => {
					this.saving = false;
				});
			}
		}"
		@open-profile-dialog.window="load()"
	>
		@dialog.Dialog(dialog.Props{ID: "profile-dialog"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl"}) {
				@dialog.Header(dialog.HeaderProps{}) {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "Personalized Profile") }
					}
					@dialog.Description(dialog.DescriptionProps{}) {
						{ i18n.T(ctx, "Personalize your AI companion experience") }
					}
				}
				<div class="px-6 pb-2 max-h-[60vh] overflow-y-auto">
					<!-- Loading state: skeleton placeholders match the form's section shapes -->
					<template x-if="loading">
						<div class="space-y-4">
							@skeleton.Skeleton(skeleton.Props{Class: "h-10 rounded-md"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-20 rounded-md"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-20 rounded-md"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-24 rounded-md"})
						</div>
					</template>
					<!-- Form -->
					<template x-if="!loading">
						<div class="space-y-5">
							<div class="space-y-2">
								@label.Label() {
									{ i18n.T(ctx, "Work Style") }
								}
								@selectbox.SelectBox() {
									@selectbox.Trigger(selectbox.TriggerProps{
										Attributes: templ.Attributes{
											"x-model": "profile.learning_style",
										},
									}) {
										@selectbox.Value(selectbox.ValueProps{
											Placeholder: i18n.T(ctx, "Select a style..."),
										})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Item(selectbox.ItemProps{Value: "Visual"}) {
											{ i18n.T(ctx, "Visual") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "Auditory"}) {
											{ i18n.T(ctx, "Auditory") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "Read/Write"}) {
											{ i18n.T(ctx, "Read/Write") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "Kinesthetic"}) {
											{ i18n.T(ctx, "Kinesthetic") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "Multimodal"}) {
											{ i18n.T(ctx, "Multimodal") }
										}
									}
								}
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "How you prefer to take in and process information.") }</p>
							</div>
							<div class="space-y-2">
								@label.Label() {
									{ i18n.T(ctx, "Current Struggles") }
								}
								@textarea.Textarea(textarea.Props{
									Placeholder: i18n.T(ctx, "e.g. Algebra, focus, time management..."),
									Rows:        3,
									Class:       "resize-none",
									Attributes: templ.Attributes{
										"x-model": "profile.struggles",
									},
								})
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Topics or skills you find challenging (comma separated).") }</p>
							</div>
							<div class="space-y-2">
								@label.Label() {
									{ i18n.T(ctx, "Strengths") }
								}
								@textarea.Textarea(textarea.Props{
									Placeholder: i18n.T(ctx, "e.g. Critical thinking, geometry, writing..."),
									Rows:        3,
									Class:       "resize-none",
									Attributes: templ.Attributes{
										"x-model": "profile.strengths",
									},
								})
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Areas where you excel or feel confident (comma separated).") }</p>
							</div>
							<div class="space-y-2">
								@label.Label() {
									{ i18n.T(ctx, "Professional/Personal Goals") }
								}
								@textarea.Textarea(textarea.Props{
									Placeholder: i18n.T(ctx, "e.g. Master system design, improve coding skills..."),
									Rows:        3,
									Class:       "resize-none",
									Attributes: templ.Attributes{
										"x-model": "profile.goals",
									},
								})
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "What you hope to achieve with your AI assistant.") }</p>
							</div>
						</div>
					</template>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					@dialog.Close(dialog.CloseProps{For: "profile-dialog"}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							{ i18n.T(ctx, "Cancel") }
						}
					}
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"@click":    "save()",
							":disabled": "saving || loading",
						},
					}) {
						<span x-show="!saving">{ i18n.T(ctx, "Save Changes") }</span>
						<span x-show="saving" class="flex items-center gap-2">
							<span class="size-4 rounded-full border-2 border-primary-foreground border-t-transparent animate-spin"></span>
							{ i18n.T(ctx, "Saving...") }
						</span>
					}
				}
			}
		}
	</div>
}
