package nav

import (
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/ui/i18n"
)

templ profileDialog() {
	<div x-data="{
		open: false,
		loading: false,
		saving: false,
		loaded: false,
		profile: {
			learning_style: '',
			struggles: '',
			strengths: '',
			goals: ''
		},
		load() {
			this.open = true;
			if (this.loaded) return;
			this.loading = true;
			fetch('/api/profile')
				.then(r => {
					if (!r.ok) throw new Error('Failed to load');
					return r.json();
				})
				.then(d => {
					this.profile.learning_style = d.learning_style || '';
					this.profile.struggles = (d.struggles || []).join(', ');
					this.profile.strengths = (d.strengths || []).join(', ');
					this.profile.goals = d.goals || '';
					this.loading = false;
					this.loaded = true;
				})
				.catch(e => {
					this.loading = false;
				});
		},
		save() {
			this.saving = true;
			fetch('/api/profile', {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(this.profile)
			})
			.then(r => {
				if (!r.ok) throw new Error('Failed to save');
				this.saving = false;
			})
			.catch(e => {
				this.saving = false;
			});
		},
		close() {
			this.open = false;
		}
	}"
	@open-profile-dialog.window="load()"
	>
		<!-- Backdrop -->
		<div
			class="fixed inset-0 z-[60] bg-black/30 dark:bg-black/60 transition-opacity"
			x-show="open"
			x-transition:enter="ease-out duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			style="display: none;"
			aria-hidden="true"
		></div>
		<!-- Modal Container -->
		<div
			class="fixed inset-0 z-[60] flex items-center justify-center p-4"
			x-show="open"
			style="display: none;"
			@click.self="close()"
		>
			<div
				class="relative w-full max-w-2xl max-h-[85vh] bg-background rounded-lg shadow-lg flex flex-col overflow-hidden border border-border"
				x-show="open"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@keydown.escape.window="close()"
			>
				<!-- Header -->
				<div class="flex items-center justify-between p-6 pb-4 border-b border-border">
					<div class="space-y-1">
						<h2 class="text-lg font-semibold leading-none tracking-tight">{ i18n.T(ctx, "Personalized Profile") }</h2>
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "Personalize your AI companion experience") }</p>
					</div>
					<button
						type="button"
						class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
						@click="close()"
					>
						@icon.X(icon.Props{Class: "size-4"})
						<span class="sr-only">Close</span>
					</button>
				</div>
				<!-- Body -->
				<div class="flex-1 overflow-auto p-6">
					<!-- Loading State -->
					<template x-if="loading">
						<div class="space-y-4">
							<div class="h-10 bg-muted animate-pulse rounded-md"></div>
							<div class="h-20 bg-muted animate-pulse rounded-md"></div>
							<div class="h-20 bg-muted animate-pulse rounded-md"></div>
							<div class="h-24 bg-muted animate-pulse rounded-md"></div>
						</div>
					</template>
					<!-- Form -->
					<template x-if="!loading">
						<div class="space-y-5">
							<!-- Learning Style -->
							<div class="space-y-2">
								<label class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Work Style") }</label>
								<select
									x-model="profile.learning_style"
									class="w-full h-10 px-3 rounded-md border border-input bg-background text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring"
								>
									<option value="">{ i18n.T(ctx, "Select a style...") }</option>
									<option value="Visual">{ i18n.T(ctx, "Visual") }</option>
									<option value="Auditory">{ i18n.T(ctx, "Auditory") }</option>
									<option value="Read/Write">{ i18n.T(ctx, "Read/Write") }</option>
									<option value="Kinesthetic">{ i18n.T(ctx, "Kinesthetic") }</option>
									<option value="Multimodal">{ i18n.T(ctx, "Multimodal") }</option>
								</select>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "How you prefer to take in and process information.") }</p>
							</div>
							<!-- Struggles -->
							<div class="space-y-2">
								<label class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Current Struggles") }</label>
								<textarea
									x-model="profile.struggles"
									placeholder={ i18n.T(ctx, "e.g. Algebra, focus, time management...") }
									rows="3"
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring resize-none"
								></textarea>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Topics or skills you find challenging (comma separated).") }</p>
							</div>
							<!-- Strengths -->
							<div class="space-y-2">
								<label class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Strengths") }</label>
								<textarea
									x-model="profile.strengths"
									placeholder={ i18n.T(ctx, "e.g. Critical thinking, geometry, writing...") }
									rows="3"
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring resize-none"
								></textarea>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "Areas where you excel or feel confident (comma separated).") }</p>
							</div>
							<!-- Goals -->
							<div class="space-y-2">
								<label class="text-sm font-medium text-foreground">{ i18n.T(ctx, "Professional/Personal Goals") }</label>
								<textarea
									x-model="profile.goals"
									placeholder={ i18n.T(ctx, "e.g. Master system design, improve coding skills...") }
									rows="3"
									class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-xs focus:outline-none focus:ring-2 focus:ring-ring resize-none"
								></textarea>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "What you hope to achieve with your AI assistant.") }</p>
							</div>
						</div>
					</template>
				</div>
				<!-- Footer -->
				<div class="p-4 border-t border-border flex justify-end gap-2 bg-background">
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantOutline,
						Attributes: templ.Attributes{
							"@click": "close()",
						},
					}) {
						{ i18n.T(ctx, "Cancel") }
					}
					@button.Button(button.Props{
						Type: button.TypeButton,
						Attributes: templ.Attributes{
							"@click":    "save()",
							":disabled": "saving || loading",
						},
					}) {
						<span x-show="!saving">{ i18n.T(ctx, "Save Changes") }</span>
						<span x-show="saving" class="flex items-center gap-2">
							<span class="size-4 rounded-full border-2 border-primary-foreground border-t-transparent animate-spin"></span>
							{ i18n.T(ctx, "Saving...") }
						</span>
					}
				</div>
			</div>
		</div>
	</div>
}
