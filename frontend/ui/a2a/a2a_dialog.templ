package a2acomp

import (
	"aicompass/frontend/components/alert"
	"aicompass/frontend/components/button"
	"aicompass/frontend/components/collapsible"
	"aicompass/frontend/components/dialog"
	"aicompass/frontend/components/icon"
	"aicompass/frontend/components/input"
	"aicompass/frontend/components/label"
	"aicompass/frontend/components/selectbox"
	"aicompass/frontend/ui/i18n"
)

// A2AAddDialog renders the "Add A2A Agent" modal dialog.
templ A2AAddDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "a2a-add-dialog",
	}) {
		@dialog.Content(dialog.ContentProps{
			Class: "sm:max-w-lg",
		}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					<div class="flex items-center gap-2">
						@icon.A2ALogo("size-5 text-violet-500")
						{ i18n.T(ctx, "Add A2A Agent") }
					</div>
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ i18n.T(ctx, "Connect to a remote AI agent that supports the A2A protocol.") }
				}
			}
			<div class="space-y-4 px-6 py-4">
				<!-- Agent URL -->
				<div class="space-y-1.5">
					@label.Label(label.Props{For: "a2a-url"}) {
						{ i18n.T(ctx, "Agent URL") }
						<span class="text-destructive">*</span>
					}
					@input.Input(input.Props{
						ID:          "a2a-url",
						Type:        input.TypeURL,
						Placeholder: "https://agent.example.com",
						Attributes: templ.Attributes{
							"x-model":         "newUrl",
							"@keydown.enter": "addConnector()",
						},
					})
					<p class="text-xs text-muted-foreground">
						{ i18n.T(ctx, "The base URL of the A2A-compatible agent. The agent card will be discovered at /.well-known/agent-card.json") }
					</p>
				</div>
				<!-- Display Name -->
				<div class="space-y-1.5">
					@label.Label(label.Props{For: "a2a-title"}) {
						{ i18n.T(ctx, "Display Name") }
					}
					@input.Input(input.Props{
						ID:          "a2a-title",
						Type:        input.TypeText,
						Placeholder: "e.g., Research Assistant Agent",
						Attributes: templ.Attributes{
							"x-model": "newTitle",
						},
					})
				</div>
				<!-- Advanced Options (collapsible) -->
				@collapsible.Collapsible() {
					@collapsible.Trigger(collapsible.TriggerProps{
						Class: "text-xs font-medium text-muted-foreground cursor-pointer hover:text-foreground transition-colors flex items-center gap-1 group",
					}) {
						@icon.ChevronRight(icon.Props{Class: "size-3 transition-transform group-data-[tui-collapsible-state=open]:rotate-90"})
						{ i18n.T(ctx, "Authentication") }
					}
					@collapsible.Content() {
						<div class="mt-3 space-y-3 ps-4 border-s-2 border-border">
							<div class="space-y-1">
								@label.Label(label.Props{For: "a2a-auth-type", Class: "text-xs"}) {
									{ i18n.T(ctx, "Auth Type") }
								}
								@selectbox.SelectBox(selectbox.Props{}) {
									@selectbox.Trigger(selectbox.TriggerProps{
										ID: "a2a-auth-type",
										Attributes: templ.Attributes{
											"x-model": "newAuthType",
										},
									}) {
										@selectbox.Value(selectbox.ValueProps{
											Placeholder: i18n.T(ctx, "Select auth type..."),
										})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Item(selectbox.ItemProps{Value: "none"}) {
											{ i18n.T(ctx, "None") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "bearer"}) {
											{ i18n.T(ctx, "Bearer Token") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "api_key"}) {
											{ i18n.T(ctx, "API Key") }
										}
										@selectbox.Item(selectbox.ItemProps{Value: "custom_header"}) {
											{ i18n.T(ctx, "Custom Header") }
										}
									}
								}
							</div>
							<template x-if="newAuthType !== 'none'">
								<div class="space-y-3">
									<template x-if="newAuthType === 'custom_header' || newAuthType === 'api_key'">
										<div class="space-y-1">
											@label.Label(label.Props{For: "a2a-auth-header", Class: "text-xs"}) {
												{ i18n.T(ctx, "Header Name") }
											}
											@input.Input(input.Props{
												ID:          "a2a-auth-header",
												Type:        input.TypeText,
												Placeholder: "X-API-Key",
												Class:       "text-xs",
												Attributes: templ.Attributes{
													"x-model": "newAuthHeader",
												},
											})
										</div>
									</template>
									<div class="space-y-1">
										@label.Label(label.Props{For: "a2a-auth-token", Class: "text-xs"}) {
											<template x-if="newAuthType === 'bearer'">
												<span>{ i18n.T(ctx, "Bearer Token") }</span>
											</template>
											<template x-if="newAuthType !== 'bearer'">
												<span>{ i18n.T(ctx, "Token / Secret") }</span>
											</template>
										}
										@input.Input(input.Props{
											ID:    "a2a-auth-token",
											Type:  input.TypePassword,
											Class: "text-xs",
											Attributes: templ.Attributes{
												"x-model": "newAuthToken",
											},
										})
									</div>
								</div>
							</template>
							<p class="text-xs text-muted-foreground">
								{ i18n.T(ctx, "Authentication credentials for accessing the remote agent. Used for both agent card discovery and task execution.") }
							</p>
						</div>
					}
				}
				<!-- Error display -->
				@alert.Alert(alert.Props{
					Variant: alert.VariantDestructive,
					Class:   "py-3",
					Attributes: templ.Attributes{
						"x-show":   "error",
						"x-cloak": "",
					},
				}) {
					@icon.CircleAlert(icon.Props{Class: "size-3.5"})
					@alert.Description(alert.DescriptionProps{Class: "text-xs"}) {
						<span x-text="error"></span>
					}
				}
			</div>
			@dialog.Footer(dialog.FooterProps{}) {
				@dialog.Close(dialog.CloseProps{For: "a2a-add-dialog"}) {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Class:   "h-9 px-4",
					}) {
						{ i18n.T(ctx, "Cancel") }
					}
				}
				@button.Button(button.Props{
					Class: "h-9 px-4",
					Attributes: templ.Attributes{
						"@click":    "addConnector()",
						":disabled": "addLoading || !newUrl",
					},
				}) {
					<span x-show="!addLoading" class="flex items-center gap-1.5">
						@icon.Plug(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "Connect") }
					</span>
					<span x-show="addLoading" class="flex items-center gap-1.5">
						@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin"})
						{ i18n.T(ctx, "Discovering...") }
					</span>
				}
			}
		}
	}
}
